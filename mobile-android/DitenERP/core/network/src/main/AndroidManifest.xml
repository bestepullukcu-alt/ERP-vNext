<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Cleartext is DENIED globally and permitted ONLY for the local dev gateway
      hosts (emulator loopback + localhost). Every other host, including the
      release gateway, must use TLS. This attribute is merged into the app
      manifest by the manifest merger.
    -->
    <application
        android:networkSecurityConfig="@xml/diten_network_security_config"
        tools:targetApi="24" />

</manifest>
