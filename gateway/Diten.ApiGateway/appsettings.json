{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "Diten.ApiGateway",
    "Seq": {
      "Enabled": false,
      "Url": "",
      "ApiKey": "",
      "SafeDisableWhenUrlMissing": false
    },
    "Tracing": {
      "Enabled": true,
      "OtlpExporterEnabled": false,
      "OtlpEndpoint": "",
      "DisabledReason": "OTLP exporter is disabled until local collector infrastructure is configured."
    },
    "Metrics": {
      "Enabled": true,
      "Path": "/metrics"
    },
    "Health": {
      "Path": "/health",
      "LivePath": "/health/live",
      "ReadyPath": "/health/ready"
    },
    "Correlation": {
      "HeaderName": "X-Correlation-Id",
      "MaxLength": 128
    },
    "Redaction": {
      "RedactedText": "[REDACTED]"
    }
  },
  "JwtSettings": {
    "Secret": "",
    "PreviousSecrets": [],
    "Issuer": "diten-auth-service",
    "Audience": "diten-erp"
  }
}
