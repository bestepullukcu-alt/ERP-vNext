        ScenarioIdInvalid = Localizer["ScenarioIdInvalid"].Value,
        ScenarioName = Localizer["ScenarioName"].Value,
        ScenarioStatusLabel = Localizer["ScenarioStatusLabel"].Value,
        ScenarioStatusDraft = Localizer["ScenarioStatus.Draft"].Value,
