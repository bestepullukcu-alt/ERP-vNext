@using Diten.Web.Views.SupplyChain.CapacityPlans
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CapacityPlansIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // Pack §23.2: every Capacity .cshtml states the tenant shell. Rendered as a partial view, so Razor does not apply it.
    Layout = "_LayoutTenantShell";
}

@* JSON bridge (pack §23.9) for the entry page: shared words from SharedResource, module text from
   CapacityPlansIndex.{lang}.resx. Dotted resx keys (PlanStatus.Draft) become PascalCase properties (PlanStatusDraft).
   No hard-coded fallback text anywhere. *@
<script id="capacity-index-l10n" type="application/json">
    @Json.Serialize(new
    {
        Cancel = SharedLocalizer["Cancel"].Value,
        Close = SharedLocalizer["Close"].Value,
        Copy = SharedLocalizer["Copy"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
        CapacityPlansTitle = Localizer["CapacityPlansTitle"].Value,
        PlanId = Localizer["PlanId"].Value,
        PlanName = Localizer["PlanName"].Value,
        HorizonStart = Localizer["HorizonStart"].Value,
        HorizonEnd = Localizer["HorizonEnd"].Value,
        DemandPlanId = Localizer["DemandPlanId"].Value,
        DemandPlanVersion = Localizer["DemandPlanVersion"].Value,
        SourceCapturedAt = Localizer["SourceCapturedAt"].Value,
        SourceChecksum = Localizer["SourceChecksum"].Value,
        Status = Localizer["Status"].Value,
        PlanStatusDraft = Localizer["PlanStatus.Draft"].Value,
        PlanStatusEvaluating = Localizer["PlanStatus.Evaluating"].Value,
        PlanStatusReady = Localizer["PlanStatus.Ready"].Value,
        PlanStatusApproved = Localizer["PlanStatus.Approved"].Value,
        PlanStatusArchived = Localizer["PlanStatus.Archived"].Value,
        NotProvided = Localizer["NotProvided"].Value,
        SupportReference = Localizer["SupportReference"].Value,
        CopyDone = Localizer["CopyDone"].Value,
        RequestPending = Localizer["RequestPending"].Value,
        RequiredMissing = Localizer["RequiredMissing"].Value,
        ErrInvalidRequest = Localizer["ErrInvalidRequest"].Value,
        ErrInvalidCorrelationId = Localizer["ErrInvalidCorrelationId"].Value,
        ErrUnauthenticated = Localizer["ErrUnauthenticated"].Value,
        ErrForbidden = Localizer["ErrForbidden"].Value,
        ErrUnknownCapacityPlan = Localizer["ErrUnknownCapacityPlan"].Value,
        ErrUnknownCapacityScenario = Localizer["ErrUnknownCapacityScenario"].Value,
        ErrUnknownCapacityEvaluation = Localizer["ErrUnknownCapacityEvaluation"].Value,
        ErrCapacityPlanAlreadyExists = Localizer["ErrCapacityPlanAlreadyExists"].Value,
        ErrCapacityScenarioNameConflict = Localizer["ErrCapacityScenarioNameConflict"].Value,
        ErrCapacityPlanStateConflict = Localizer["ErrCapacityPlanStateConflict"].Value,
        ErrEvaluationAlreadyActive = Localizer["ErrEvaluationAlreadyActive"].Value,
        ErrIdempotencyKeyReused = Localizer["ErrIdempotencyKeyReused"].Value,
        ErrInvalidDemandReference = Localizer["ErrInvalidDemandReference"].Value,
        ErrInvalidConstraintReference = Localizer["ErrInvalidConstraintReference"].Value,
        ErrDependencyUnavailable = Localizer["ErrDependencyUnavailable"].Value,
        ErrCommitResultUnresolved = Localizer["ErrCommitResultUnresolved"].Value,
        CapacityPlansPageDescription = Localizer["CapacityPlansPageDescription"].Value,
        NoPlanListNote = Localizer["NoPlanListNote"].Value,
        CreatePlan = Localizer["CreatePlan"].Value,
        OpenPlan = Localizer["OpenPlan"].Value,
        OpenPlanTitle = Localizer["OpenPlanTitle"].Value,
        PlanIdHelp = Localizer["PlanIdHelp"].Value,
        PlanIdInvalid = Localizer["PlanIdInvalid"].Value,
        FormTitleCreate = Localizer["FormTitleCreate"].Value,
        HorizonOrderInvalid = Localizer["HorizonOrderInvalid"].Value,
        DemandReferenceHelp = Localizer["DemandReferenceHelp"].Value,
        SourceCapturedAtHelp = Localizer["SourceCapturedAtHelp"].Value,
        RequiredFilled = Localizer["RequiredFilled"].Value,
        PlanCreated = Localizer["PlanCreated"].Value
    })
</script>
