@using Diten.Web.Views.SupplyChain.CapacityPlans
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CapacityPlanDetails> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // Pack §23.2: every Capacity .cshtml states the tenant shell. Rendered as a partial view, so Razor does not apply it.
    Layout = "_LayoutTenantShell";
}

@* Evaluate offcanvas (pack §23.6, EvaluateCapacityScenarioRequest) for the scenario loaded in the workspace.
   evaluationMode is one of the two published values; resourceRefs holds at least one non-empty value, sent in the
   order shown. The form opens with one resource row (README A8). Not a dangerous action (pack §24): no confirmation. *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEvaluate" aria-labelledby="offcanvasEvaluateLabel">
    <div class="offcanvas-header p-4">
        <div class="min-w-0">
            <h5 id="offcanvasEvaluateLabel" class="offcanvas-title mb-0">@Localizer["EvaluateTitle"]</h5>
            <small class="text-muted d-block text-break" id="evaluateScenarioName"></small>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Close"]"></button>
    </div>

    <div class="offcanvas-body border-top p-4">
        <div id="formEvaluateAlert" class="alert alert-danger d-none" role="alert" aria-live="assertive"></div>

        <form id="formEvaluate" class="pt-0" novalidate>
            @Html.AntiForgeryToken()
            <div class="row g-4">
                <div class="col-12">
                    <label for="evaluationMode" class="form-label fw-medium">@Localizer["EvaluationMode"] <span class="text-danger">*</span></label>
                    <div class="diten-field">
                        <i class="bx bx-slider-alt diten-field-icon" aria-hidden="true"></i>
                        <select id="evaluationMode" class="form-select"></select>
                    </div>
                </div>
                <div class="col-12">
                    <fieldset aria-describedby="evaluateResourceRefsHelp">
                        <legend class="form-label fw-medium fs-6 mb-1">@Localizer["ResourceRefs"] <span class="text-danger">*</span></legend>
                        <div id="evaluateResourceRefsHelp" class="form-text mt-0 mb-2">@Localizer["ResourceRefsHelp"]</div>
                        <div id="evaluateResourceRefRows" class="d-flex flex-column gap-3"></div>
                        <button type="button" class="btn btn-sm btn-label-secondary mt-3" id="btnAddResourceRef">
                            <i class="bx bx-plus me-1" aria-hidden="true"></i>@Localizer["AddRow"]
                        </button>
                    </fieldset>
                </div>
            </div>
        </form>

        @* Row template: cloned by details.js (no inline handler, no string-built user text). *@
        <template id="resourceRefRowTemplate">
            <div class="d-flex align-items-end gap-2 capacity-resource-ref-row">
                <div class="flex-grow-1">
                    <label class="form-label small mb-1 js-label-resource-ref">@Localizer["ResourceRef"] <span class="text-danger">*</span></label>
                    <div class="diten-field">
                        <i class="bx bx-cube diten-field-icon" aria-hidden="true"></i>
                        <input type="text" class="form-control js-resource-ref" dir="ltr" autocomplete="off" spellcheck="false" />
                    </div>
                </div>
                <button type="button" class="btn btn-icon btn-text-danger js-remove-row" aria-label="@Localizer["RemoveRow"]">
                    <i class="bx bx-trash" aria-hidden="true"></i>
                </button>
            </div>
        </template>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" id="btnSubmitEvaluate" class="btn btn-primary">@Localizer["Evaluate"]</button>
    </div>
</div>
