@using Diten.Web.Views.SupplyChain.CapacityPlans
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CapacityPlansIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // Pack §23.2: every Capacity .cshtml states the tenant shell. Rendered as a partial view, so Razor does not apply it.
    Layout = "_LayoutTenantShell";
}

@* Create-only offcanvas (pack §23.6, CreateCapacityPlanRequest, form_field_count 7 → GoldenReferenceSlim). No edit mode.
   No client tightening (no HTML validation attributes, no trim). index.js mirrors the schema only (mandatory =
   non-empty, horizonEnd ≥ horizonStart) and sends every value exactly as typed. Date inputs produce the schema's
   yyyy-MM-dd form; sourceCapturedAt is typed as an ISO-8601 UTC date-time and is never prefilled, so the first-open
   progress is 0/7 (README A4, A5). *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCreatePlan" aria-labelledby="offcanvasCreatePlanLabel">
    <div class="offcanvas-header p-4">
        <div class="min-w-0">
            <h5 id="offcanvasCreatePlanLabel" class="offcanvas-title mb-0">@Localizer["FormTitleCreate"]</h5>
            <small class="text-muted d-block" id="createRequiredProgress" aria-live="polite"></small>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Close"]"></button>
    </div>

    <div class="offcanvas-body border-top p-4">
        <div id="formCreatePlanAlert" class="alert alert-danger d-none" role="alert" aria-live="assertive"></div>

        <form id="formCreatePlan" class="pt-0" novalidate>
            @Html.AntiForgeryToken()
            <div class="row g-4">
                <div class="col-12">
                    <label for="planName" class="form-label fw-medium">@Localizer["PlanName"] <span class="text-danger">*</span></label>
                    <div class="diten-field">
                        <i class="bx bx-detail diten-field-icon" aria-hidden="true"></i>
                        <input type="text" id="planName" class="form-control js-create-required" autocomplete="off" />
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <label for="planHorizonStart" class="form-label fw-medium">@Localizer["HorizonStart"] <span class="text-danger">*</span></label>
                    <div class="diten-field">
                        <i class="bx bx-calendar diten-field-icon" aria-hidden="true"></i>
                        <input type="date" id="planHorizonStart" class="form-control js-create-required" dir="ltr" />
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <label for="planHorizonEnd" class="form-label fw-medium">@Localizer["HorizonEnd"] <span class="text-danger">*</span></label>
                    <div class="diten-field">
                        <i class="bx bx-calendar-check diten-field-icon" aria-hidden="true"></i>
                        <input type="date" id="planHorizonEnd" class="form-control js-create-required" dir="ltr" />
                    </div>
                </div>
                <div class="col-12">
                    <label for="planDemandPlanId" class="form-label fw-medium">@Localizer["DemandPlanId"] <span class="text-danger">*</span></label>
                    <div class="diten-field">
                        <i class="bx bx-line-chart diten-field-icon" aria-hidden="true"></i>
                        <input type="text" id="planDemandPlanId" class="form-control js-create-required" dir="ltr" autocomplete="off" spellcheck="false"
                               aria-describedby="planDemandReferenceHelp" />
                    </div>
                </div>
                <div class="col-12">
                    <label for="planDemandPlanVersion" class="form-label fw-medium">@Localizer["DemandPlanVersion"] <span class="text-danger">*</span></label>
                    <div class="diten-field">
                        <i class="bx bx-git-commit diten-field-icon" aria-hidden="true"></i>
                        <input type="text" id="planDemandPlanVersion" class="form-control js-create-required" dir="ltr" autocomplete="off" spellcheck="false"
                               aria-describedby="planDemandReferenceHelp" />
                    </div>
                </div>
                <div class="col-12">
                    <label for="planSourceCapturedAt" class="form-label fw-medium">@Localizer["SourceCapturedAt"] <span class="text-danger">*</span></label>
                    <div class="diten-field">
                        <i class="bx bx-time-five diten-field-icon" aria-hidden="true"></i>
                        <input type="text" id="planSourceCapturedAt" class="form-control js-create-required" dir="ltr" autocomplete="off" spellcheck="false"
                               aria-describedby="planSourceCapturedAtHelp" />
                    </div>
                    <div id="planSourceCapturedAtHelp" class="form-text">@Localizer["SourceCapturedAtHelp"]</div>
                </div>
                <div class="col-12">
                    <label for="planSourceChecksum" class="form-label fw-medium">@Localizer["SourceChecksum"] <span class="text-danger">*</span></label>
                    <div class="diten-field">
                        <i class="bx bx-fingerprint diten-field-icon" aria-hidden="true"></i>
                        <input type="text" id="planSourceChecksum" class="form-control js-create-required" dir="ltr" autocomplete="off" spellcheck="false"
                               aria-describedby="planDemandReferenceHelp" />
                    </div>
                    <div id="planDemandReferenceHelp" class="form-text">@Localizer["DemandReferenceHelp"]</div>
                </div>
            </div>
        </form>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" id="btnSubmitCreatePlan" class="btn btn-primary">@Localizer["CreatePlan"]</button>
    </div>
</div>
