@model Guid
@using Diten.Web.Models.SupplyChain.SandopPlans
@using Diten.Web.Views.SupplyChain.SandopPlans
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SandopPlanDetails> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    // MOD-0190 S&OP plan workspace (pack §23.4–§23.8, GoldenReferenceSlim). DRAFT overlay — not built, not writer-complete.
    ViewData["Title"] = Localizer["PlanDetailsTitle"].Value;
    Layout = "_LayoutTenantShell";
}
@if (!Perms.Has(SandopUiPermissions.Read))
{
    <partial name="_AccessDenied" model="@Localizer["PlanDetailsTitle"].Value" />
    return;
}
@{
    var permissions = SandopPagePermissions.From(Perms.Has);
}

<div id="sandop-plan-details" data-sandop-plan-id="@Model.ToString("D")">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-3">
        <div class="min-w-0">
            <h4 class="mb-1 text-break" id="planTitle">@Localizer["PlanDetailsTitle"]</h4>
            <nav aria-label="@Localizer["SandopPlansTitle"]">
                <ol class="breadcrumb mb-0 py-0">
                    <li class="breadcrumb-item"><a href="~/SupplyChain/SandopPlans">@Localizer["SandopPlansTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">@Localizer["PlanDetailsTitle"]</li>
                </ol>
            </nav>
        </div>
        @* State-gated toolbar (pack §23.7): details.js shows each button only for its key AND the server status. *@
        <div class="d-flex flex-wrap gap-2" id="planActions">
            @if (permissions.CanCapture)
            {
                <button type="button" class="btn btn-primary d-none" id="btnOpenCaptureSnapshot" aria-controls="offcanvasCaptureSnapshot">
                    <i class="bx bx-camera me-1" aria-hidden="true"></i>@Localizer["CaptureSnapshot"]
                </button>
            }
            @if (permissions.CanSignOff)
            {
                <button type="button" class="btn btn-label-primary d-none" id="btnOpenRecordSignOff" aria-controls="offcanvasRecordSignOff">
                    <i class="bx bx-check-double me-1" aria-hidden="true"></i>@Localizer["RecordSignOff"]
                </button>
            }
            <a href="~/SupplyChain/SandopPlans" class="btn btn-label-secondary border">@Localizer["BackToPlans"]</a>
        </div>
    </div>

    @* Page-level surface for safe-not-found (UNKNOWN_SANDOP_PLAN) and action/page denial. *@
    <div id="planAlert" class="alert alert-danger d-none" role="alert" tabindex="-1" aria-live="assertive"></div>

    <div id="planWorkspace" class="row g-6">
        @* ① Plan summary — skeleton / content / error are three distinct states (VIEW-001 §3.1) *@
        <div class="col-12">
            <section class="card backbone-preview-section p-4" aria-labelledby="planSummaryTitle">
                <h5 class="card-title mb-4" id="planSummaryTitle">@Localizer["PlanSummary"]</h5>
                <div id="summary-skeleton" class="backbone-skeleton" aria-hidden="true">
                    <div class="shimmer skeleton-row skeleton-row-lg"></div>
                    <div class="shimmer skeleton-row"></div>
                    <div class="shimmer skeleton-row skeleton-row-last"></div>
                </div>
                <div id="summary-error" class="text-center d-none" role="alert">
                    <i class="bx bx-error-circle fs-2 text-danger d-block mb-2" aria-hidden="true"></i>
                    <p class="mb-1 fw-medium js-section-error-message">@Localizer["SummaryErrorState"]</p>
                    <p class="mb-3 small text-muted d-none js-section-error-reference"></p>
                    <button type="button" class="btn btn-sm btn-label-primary js-retry">@Localizer["Retry"]</button>
                </div>
                <dl id="summary-content" class="row mb-0 d-none">
                    <dt class="col-sm-4 mb-3">@Localizer["PlanId"]</dt>
                    <dd class="col-sm-8 mb-3" id="summaryPlanId"></dd>
                    <dt class="col-sm-4 mb-3">@Localizer["Status"]</dt>
                    <dd class="col-sm-8 mb-3" id="summaryStatus"></dd>
                    <dt class="col-sm-4 mb-3">@Localizer["Horizon"]</dt>
                    <dd class="col-sm-8 mb-3" id="summaryHorizon"></dd>
                    <dt class="col-sm-4 mb-3">@Localizer["DemandReference"]</dt>
                    <dd class="col-sm-8 mb-3" id="summaryDemand"></dd>
                    <dt class="col-sm-4 mb-3">@Localizer["CurrentSnapshot"]</dt>
                    <dd class="col-sm-8 mb-3" id="summaryCurrentSnapshot"></dd>
                    <dt class="col-sm-4 mb-0">@Localizer["CreatedAt"]</dt>
                    <dd class="col-sm-8 mb-0" id="summaryCreatedAt"></dd>
                </dl>
            </section>
        </div>

        @* ② Snapshots — bounded client-side DataTables v2 over listSandopSnapshots (pack §23.5) *@
        <div class="col-12">
            <section class="card" aria-labelledby="snapshotsTitle">
                <h5 class="card-title p-4 mb-0" id="snapshotsTitle">@Localizer["Snapshots"]</h5>
                <div id="snapshots-skeleton" class="backbone-skeleton px-4 pb-4" aria-hidden="true">
                    <div class="shimmer skeleton-row skeleton-row-lg"></div>
                    <div class="shimmer skeleton-row"></div>
                    <div class="shimmer skeleton-row skeleton-row-last"></div>
                </div>
                <div id="snapshots-error" class="p-4 text-center d-none" role="alert">
                    <i class="bx bx-error-circle fs-2 text-danger d-block mb-2" aria-hidden="true"></i>
                    <p class="mb-1 fw-medium js-section-error-message">@Localizer["SnapshotsErrorState"]</p>
                    <p class="mb-3 small text-muted d-none js-section-error-reference"></p>
                    <button type="button" class="btn btn-sm btn-label-primary js-retry">@Localizer["Retry"]</button>
                </div>
                <div class="card-datatable table-responsive d-none" id="snapshots-table-host">
                    <table id="dt-sandop-snapshots" data-dt-standard="v2" class="datatables-sandop-snapshots table border-top">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="all">@Localizer["CapturedAt"]</th>
                                <th>@Localizer["SnapshotId"]</th>
                                <th>@Localizer["Provenance"]</th>
                                <th>@Localizer["SourceChecksum"]</th>
                                <th>@Localizer["SourceCapturedAt"]</th>
                                <th class="text-end">@Localizer["SupplyInputRefCount"]</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </section>
        </div>

        @* ③ Sign-offs — bounded client-side DataTables v2 over listSandopSignOffs (pack §23.5) *@
        <div class="col-12">
            <section class="card" aria-labelledby="signOffsTitle">
                <div class="p-4 pb-0">
                    <h5 class="card-title mb-1" id="signOffsTitle">@Localizer["SignOffs"]</h5>
                    <p class="small text-muted mb-3">@Localizer["SignOffStatusNote"]</p>
                </div>
                <div id="signoffs-skeleton" class="backbone-skeleton px-4 pb-4" aria-hidden="true">
                    <div class="shimmer skeleton-row skeleton-row-lg"></div>
                    <div class="shimmer skeleton-row"></div>
                    <div class="shimmer skeleton-row skeleton-row-last"></div>
                </div>
                <div id="signoffs-error" class="p-4 text-center d-none" role="alert">
                    <i class="bx bx-error-circle fs-2 text-danger d-block mb-2" aria-hidden="true"></i>
                    <p class="mb-1 fw-medium js-section-error-message">@Localizer["SignOffsErrorState"]</p>
                    <p class="mb-3 small text-muted d-none js-section-error-reference"></p>
                    <button type="button" class="btn btn-sm btn-label-primary js-retry">@Localizer["Retry"]</button>
                </div>
                <div class="card-datatable table-responsive d-none" id="signoffs-table-host">
                    <table id="dt-sandop-signoffs" data-dt-standard="v2" class="datatables-sandop-signoffs table border-top">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="all">@Localizer["DecidedAt"]</th>
                                <th>@Localizer["Snapshot"]</th>
                                <th>@Localizer["Role"]</th>
                                <th>@Localizer["Decision"]</th>
                                <th>@Localizer["Comment"]</th>
                                <th>@Localizer["DecidedBy"]</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </section>
        </div>
    </div>

    @if (permissions.CanCapture)
    {
        <partial name="~/Views/SupplyChain/SandopPlans/_CaptureSnapshotOffcanvas.cshtml" />
    }
    @if (permissions.CanSignOff)
    {
        <partial name="~/Views/SupplyChain/SandopPlans/_RecordSignOffOffcanvas.cshtml" />
    }
</div>

@* Display decision only (UAS-001 §4); the backend permission gate stays the authority. *@
<script id="sandop-plan-permissions" type="application/json">@Json.Serialize(new { canCapture = permissions.CanCapture, canSignOff = permissions.CanSignOff })</script>

@section Scripts {
    <partial name="~/Views/SupplyChain/SandopPlans/_DetailsL10n.cshtml" />
    <script src="~/assets/js/SupplyChain/SandopPlans/details.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/SupplyChain/SandopPlans/details.js" asp-append-version="true"></script>
}
