@using Diten.Web.Views.SupplyChain.SandopPlans
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SandopPlanDetails> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // Pack §23.2: every S&OP .cshtml states the tenant shell. Rendered as a partial view, so Razor does not apply it.
    Layout = "_LayoutTenantShell";
}

@* JSON bridge (pack §23.9) for the plan workspace: shared words from SharedResource, module text from
   SandopPlanDetails.{lang}.resx. Dotted resx keys (Status.Draft) become PascalCase properties (StatusDraft).
   No hard-coded fallback text anywhere. *@
<script id="sandop-details-l10n" type="application/json">
    @Json.Serialize(new
    {
        Cancel = SharedLocalizer["Cancel"].Value,
        Close = SharedLocalizer["Close"].Value,
        Copy = SharedLocalizer["Copy"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
        SandopPlansTitle = Localizer["SandopPlansTitle"].Value,
        PlanId = Localizer["PlanId"].Value,
        PlanName = Localizer["PlanName"].Value,
        HorizonStart = Localizer["HorizonStart"].Value,
        HorizonEnd = Localizer["HorizonEnd"].Value,
        DemandPlanId = Localizer["DemandPlanId"].Value,
        DemandPlanVersion = Localizer["DemandPlanVersion"].Value,
        Status = Localizer["Status"].Value,
        StatusDraft = Localizer["Status.Draft"].Value,
        StatusInReview = Localizer["Status.InReview"].Value,
        StatusApproved = Localizer["Status.Approved"].Value,
        StatusRejected = Localizer["Status.Rejected"].Value,
        StatusArchived = Localizer["Status.Archived"].Value,
        NotProvided = Localizer["NotProvided"].Value,
        SupportReference = Localizer["SupportReference"].Value,
        CopyDone = Localizer["CopyDone"].Value,
        RequestPending = Localizer["RequestPending"].Value,
        RequiredMissing = Localizer["RequiredMissing"].Value,
        ErrInvalidRequest = Localizer["ErrInvalidRequest"].Value,
        ErrInvalidCorrelationId = Localizer["ErrInvalidCorrelationId"].Value,
        ErrUnauthenticated = Localizer["ErrUnauthenticated"].Value,
        ErrForbidden = Localizer["ErrForbidden"].Value,
        ErrUnknownSandopPlan = Localizer["ErrUnknownSandopPlan"].Value,
        ErrSandopPlanAlreadyExists = Localizer["ErrSandopPlanAlreadyExists"].Value,
        ErrSandopPlanStateConflict = Localizer["ErrSandopPlanStateConflict"].Value,
        ErrSandopSignOffStateConflict = Localizer["ErrSandopSignOffStateConflict"].Value,
        ErrSignOffAlreadyRecorded = Localizer["ErrSignOffAlreadyRecorded"].Value,
        ErrIdempotencyKeyReused = Localizer["ErrIdempotencyKeyReused"].Value,
        ErrInvalidDemandReference = Localizer["ErrInvalidDemandReference"].Value,
        ErrInvalidSnapshotReference = Localizer["ErrInvalidSnapshotReference"].Value,
        ErrDependencyUnavailable = Localizer["ErrDependencyUnavailable"].Value,
        ErrCommitResultUnresolved = Localizer["ErrCommitResultUnresolved"].Value,
        PlanDetailsTitle = Localizer["PlanDetailsTitle"].Value,
        BackToPlans = Localizer["BackToPlans"].Value,
        PlanSummary = Localizer["PlanSummary"].Value,
        Horizon = Localizer["Horizon"].Value,
        DemandReference = Localizer["DemandReference"].Value,
        CurrentSnapshot = Localizer["CurrentSnapshot"].Value,
        CreatedAt = Localizer["CreatedAt"].Value,
        SummaryErrorState = Localizer["SummaryErrorState"].Value,
        Snapshots = Localizer["Snapshots"].Value,
        SnapshotId = Localizer["SnapshotId"].Value,
        CaptureSnapshot = Localizer["CaptureSnapshot"].Value,
        CaptureSnapshotTitle = Localizer["CaptureSnapshotTitle"].Value,
        SourceCapturedAt = Localizer["SourceCapturedAt"].Value,
        SourceCapturedAtHelp = Localizer["SourceCapturedAtHelp"].Value,
        SourceChecksum = Localizer["SourceChecksum"].Value,
        SupplyInputRefs = Localizer["SupplyInputRefs"].Value,
        SupplyInputRefsHelp = Localizer["SupplyInputRefsHelp"].Value,
        SupplyInputRefCount = Localizer["SupplyInputRefCount"].Value,
        Source = Localizer["Source"].Value,
        ResourceId = Localizer["ResourceId"].Value,
        ResourceVersion = Localizer["ResourceVersion"].Value,
        AddRow = Localizer["AddRow"].Value,
        RemoveRow = Localizer["RemoveRow"].Value,
        RowIncomplete = Localizer["RowIncomplete"].Value,
        CapturedAt = Localizer["CapturedAt"].Value,
        Provenance = Localizer["Provenance"].Value,
        CurrentMarker = Localizer["CurrentMarker"].Value,
        EmptySnapshots = Localizer["EmptySnapshots"].Value,
        SnapshotsErrorState = Localizer["SnapshotsErrorState"].Value,
        SnapshotCaptured = Localizer["SnapshotCaptured"].Value,
        SignOffs = Localizer["SignOffs"].Value,
        RecordSignOff = Localizer["RecordSignOff"].Value,
        RecordSignOffTitle = Localizer["RecordSignOffTitle"].Value,
        Snapshot = Localizer["Snapshot"].Value,
        Role = Localizer["Role"].Value,
        RoleDemandPlanning = Localizer["Role.DemandPlanning"].Value,
        RoleSupplyPlanning = Localizer["Role.SupplyPlanning"].Value,
        RoleFinance = Localizer["Role.Finance"].Value,
        RoleOperations = Localizer["Role.Operations"].Value,
        RoleExecutive = Localizer["Role.Executive"].Value,
        Decision = Localizer["Decision"].Value,
        DecisionApproved = Localizer["Decision.Approved"].Value,
        DecisionRejected = Localizer["Decision.Rejected"].Value,
        Comment = Localizer["Comment"].Value,
        CommentHelp = Localizer["CommentHelp"].Value,
        CommentTooLong = Localizer["CommentTooLong"].Value,
        DecidedBy = Localizer["DecidedBy"].Value,
        DecidedAt = Localizer["DecidedAt"].Value,
        ConfirmSignOff = Localizer["ConfirmSignOff"].Value,
        SignOffRecorded = Localizer["SignOffRecorded"].Value,
        EmptySignOffs = Localizer["EmptySignOffs"].Value,
        SignOffsErrorState = Localizer["SignOffsErrorState"].Value,
        SignOffStatusNote = Localizer["SignOffStatusNote"].Value,
        Retry = Localizer["Retry"].Value,
        SelectOption = Localizer["SelectOption"].Value
