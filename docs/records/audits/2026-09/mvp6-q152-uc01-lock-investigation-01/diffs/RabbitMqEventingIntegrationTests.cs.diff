+    private static string RequireLaneMongoConnectionString()
+    {
+        var connectionString = Environment.GetEnvironmentVariable("Eventing__MongoDb__ConnectionString");
+        if (string.IsNullOrWhiteSpace(connectionString))
+        {
+            connectionString = Environment.GetEnvironmentVariable("MongoDbSettings__ConnectionString");
+        }
+
+        if (string.IsNullOrWhiteSpace(connectionString))
+        {
+            throw new InvalidOperationException(
+                "Eventing__MongoDb__ConnectionString must point at this lane's isolated MongoDB. "
+                + "Platform eventing tests fail closed instead of falling back to operational 27017.");
+        }
+
+        var url = new MongoUrl(connectionString);
+        foreach (var server in url.Servers ?? [])
+        {
+            if (server.Port is 27017 or 27018 or 27019 or 27020 or 27021)
+            {
+                throw new InvalidOperationException(
+                    $"Eventing Mongo connection points at protected MongoDB port {server.Port}. "
+                    + "Use a lane-owned isolated MongoDB URI.");
+            }
+        }
+
+        return connectionString;
+    }
+
