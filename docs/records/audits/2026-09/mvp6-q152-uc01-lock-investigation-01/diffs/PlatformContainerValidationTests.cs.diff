+    private static string RequireLaneMongoConnectionString()
+    {
+        const string key = "DITEN_PLATFORM_TEST_MONGO_URI";
+        var connectionString = Environment.GetEnvironmentVariable(key);
+        if (string.IsNullOrWhiteSpace(connectionString))
+        {
+            throw new InvalidOperationException(
+                $"{key} must point at a lane-owned MongoDB instance. "
+                + "Platform Mongo tests fail closed instead of falling back to operational 27017.");
+        }
+
+        var url = new MongoUrl(connectionString);
+        foreach (var server in url.Servers ?? [])
+        {
+            if (server.Port is 27017 or 27018 or 27019 or 27020 or 27021)
+            {
+                throw new InvalidOperationException(
+                    $"{key} points at protected MongoDB port {server.Port}. "
+                    + "Use a lane-owned isolated MongoDB URI.");
+            }
+        }
+
+        return connectionString;
+    }
