{
  "permissions": {
    "allow": [
      "Bash(python3 .antigravity/scripts/verify_datatable_page.py . --area DevEnablement --module GoldenReferenceSlim --reference slim)",
      "Bash(python3 .antigravity/scripts/verify_datatable_page.py . --area DevEnablement --module GoldenReferenceCompact --reference compact)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(git check-ignore *)",
      "Bash(python3 .antigravity/scripts/verify_module_id.py . --check-id MOD-0023 --name \"Workflow Designer \\(Approvals / SLAs / Escalations\\)\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|PowerShell|mcp__terminal__run_in_terminal|mcp__ccd_pr__set_auto_merge",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/hooks/command_brake.py\" ] || exit 0; for p in python3 python; do \"$p\" -c \"\" </dev/null >/dev/null 2>&1 && exec \"$p\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/command_brake.py\"; done; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.antigravity/scripts/list_screen_touch_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
