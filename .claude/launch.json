{
  "version": "0.0.1",
  "autoPort": false,
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "frontend/Diten.Web/Diten.Web.csproj",
        "--no-build",
        "--urls",
        "http://0.0.0.0:5001"
      ],
      "port": 5001
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "frontend/Diten.Web/Diten.Web.csproj",
        "--no-build",
        "--urls",
        "http://localhost:5011"
      ],
      "port": 5011
    },
    {
      "name": "gateway",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
