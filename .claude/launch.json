    {
      "name": "mdm",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "services/Diten.MdmService/src/Diten.MdmService.Api/Diten.MdmService.Api.csproj",
        "--no-build",
        "--urls",
        "http://localhost:5059"
      ],
      "port": 5059
