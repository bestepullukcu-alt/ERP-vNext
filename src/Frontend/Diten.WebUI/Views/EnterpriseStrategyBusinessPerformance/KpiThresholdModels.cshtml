@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Threshold Models";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm mb-0" id="kpi-threshold-table">
            <thead>
                <tr>
                    <th>Model Code</th>
                    <th>Model Name</th>
                    <th>Metric Unit</th>
                    <th>Polarity</th>
                    <th>Interpretation</th>
                    <th>Red Floor</th>
                    <th>Amber Floor</th>
                    <th>Green Target</th>
                    <th>Green Stretch</th>
                    <th>Upper Control Limit</th>
                    <th>Status</th>
                    <th>Version</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/kpi-threshold-models.js" asp-append-version="true"></script>
}
