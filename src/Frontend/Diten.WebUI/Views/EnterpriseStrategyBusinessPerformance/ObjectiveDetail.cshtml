@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Objective Detail";
    var objectiveId = (ViewData["ObjectiveId"]?.ToString() ?? string.Empty);
}

@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Objective @objectiveId</h5>
                <div class="btn-group btn-group-sm">
                    <a href="/management-governance/enterprise-strategy-business-performance/objectives" class="btn btn-outline-secondary">Back to List</a>
                    <a href="/management-governance/enterprise-strategy-business-performance/objectives/alignment?objectiveId=@Uri.EscapeDataString(objectiveId)" class="btn btn-outline-secondary">Strategy Alignment Register</a>
                    <a href="/management-governance/delivery-execution/initiatives?parentObjectiveId=@Uri.EscapeDataString(objectiveId)" class="btn btn-outline-secondary">Open Delivery Initiatives</a>
                    <a href="/management-governance/delivery-execution/initiatives/new?parentObjectiveId=@Uri.EscapeDataString(objectiveId)" class="btn btn-outline-secondary">Create Initiative in Delivery</a>
                    <a id="objective-detail-edit" class="btn btn-primary" href="/management-governance/enterprise-strategy-business-performance/objectives/@Uri.EscapeDataString(objectiveId)/edit">Edit</a>
                </div>
            </div>
        </div>
        <ul class="nav nav-pills mb-3">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#objective-overview-tab">Overview</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#objective-performance-tab">Performance</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#objective-alignment-tab">Aligned Delivery Summary</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#objective-audit-tab">Audit / Change Log</button></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="objective-overview-tab"><div class="card"><div class="card-body" id="objective-detail-overview"></div></div></div>
            <div class="tab-pane fade" id="objective-performance-tab"><div class="card"><div class="card-body" id="objective-detail-performance"></div></div></div>
            <div class="tab-pane fade" id="objective-alignment-tab"><div class="card"><div class="card-body" id="objective-detail-alignment"></div></div></div>
            <div class="tab-pane fade" id="objective-audit-tab"><div class="card"><div class="card-body" id="objective-detail-audit"></div></div></div>
        </div>
    </div>
    <div class="col-12 col-lg-4">@await Html.PartialAsync("Components/_GovernanceSidePanel")</div>
</div>

@section Scripts {
    <script>window.objectiveDetailId = "@objectiveId";</script>
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js"></script>
    <script src="~/assets/js/pages/enterprise-strategy/objective-detail.js"></script>
}
