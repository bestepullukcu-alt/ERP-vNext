@{
    var id = (ViewData["Id"]?.ToString() ?? string.Empty);
    var label = (ViewData["Label"]?.ToString() ?? string.Empty);
    var type = (ViewData["Type"]?.ToString() ?? "text");
    var required = (ViewData["Required"]?.ToString() ?? "false");
    var placeholder = (ViewData["Placeholder"]?.ToString() ?? string.Empty);
}
<div class="mb-3">
    <label for="@id" class="form-label">@label @if (required == "true") { <span class="text-danger">*</span> }</label>
    <input id="@id" type="@type" class="form-control" placeholder="@placeholder" @(required == "true" ? "required" : null) />
</div>
