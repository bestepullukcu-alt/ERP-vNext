@model IReadOnlyList<Diten.WebUI.Models.EnterpriseStrategy.StrategyMetricSummaryCard>
@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            var trend = item.Trend ?? string.Empty;
            var trendClass = trend.TrimStart().StartsWith("+", StringComparison.Ordinal)
                ? "bg-label-success text-success"
                : trend.TrimStart().StartsWith("-", StringComparison.Ordinal)
                    ? "bg-label-warning text-warning"
                    : "bg-label-secondary text-secondary";
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-none border">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small">@item.Label</span>
                            <span class="badge @trendClass">@item.Trend</span>
                        </div>
                        <div class="h3 mb-0 fw-semibold">@item.Value</div>
                    </div>
                </div>
            </div>
        }
    </div>
}
