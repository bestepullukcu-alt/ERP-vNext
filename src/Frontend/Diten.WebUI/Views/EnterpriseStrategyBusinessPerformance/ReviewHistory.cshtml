@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Review History";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input id="history-goal" class="form-control form-control-sm w-auto" placeholder="Goal (optional)" />
        <input id="history-objective" class="form-control form-control-sm w-auto" placeholder="Objective (optional)" />
        <input id="history-period" class="form-control form-control-sm w-auto" placeholder="Period (YYYY or YYYY-Qx)" />
        <button id="history-apply" class="btn btn-sm btn-outline-secondary">Apply</button>
        <a class="btn btn-sm btn-outline-secondary ms-auto" href="/management-governance/enterprise-strategy-business-performance/reviews/calendar">Review Calendar</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Review ID</th>
                    <th>Review Date</th>
                    <th>Review Type</th>
                    <th class="text-end">Decisions</th>
                    <th class="text-end">Open Actions</th>
                    <th class="text-end">Closed Actions</th>
                    <th>Scorecard Snapshot</th>
                    <th>Cascade Snapshot</th>
                </tr>
            </thead>
            <tbody id="review-history-table"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/review-history.js" asp-append-version="true"></script>
}
