@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Strategy Alignment Register - Gap View";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections">Register</a>
        <a class="btn btn-sm btn-outline-secondary active" href="/management-governance/enterprise-strategy-business-performance/connections/gaps">Gap View</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections/lineage">Lineage View</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections/graph">Graph View</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/delivery-execution/initiatives">Aligned Initiatives</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/delivery-execution/projects">Aligned Projects</a>
    </div>
</div>

<div class="alert alert-info">
    Gap findings for Initiative and Project mappings point to delivery-owned records. Use the delivery actions in each row when you need to inspect the native record.
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-2"><div class="border rounded p-2"><div class="small text-muted">Total Gaps</div><div class="h6 mb-0" id="gap-kpi-total">0</div></div></div>
    <div class="col-6 col-md-2"><div class="border rounded p-2"><div class="small text-muted">Missing Initiative</div><div class="h6 mb-0" id="gap-kpi-missing-initiative">0</div></div></div>
    <div class="col-6 col-md-2"><div class="border rounded p-2"><div class="small text-muted">Missing Project</div><div class="h6 mb-0" id="gap-kpi-missing-project">0</div></div></div>
    <div class="col-6 col-md-2"><div class="border rounded p-2"><div class="small text-muted">Missing Target</div><div class="h6 mb-0" id="gap-kpi-missing-target">0</div></div></div>
    <div class="col-6 col-md-2"><div class="border rounded p-2"><div class="small text-muted">Missing Plan Years</div><div class="h6 mb-0" id="gap-kpi-missing-plan">0</div></div></div>
    <div class="col-6 col-md-2"><div class="border rounded p-2"><div class="small text-muted">Invalid Anchors</div><div class="h6 mb-0" id="gap-kpi-invalid-anchor">0</div></div></div>
</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input id="gap-search" class="form-control form-control-sm w-auto" placeholder="Search gaps" />
        <select id="gap-type" class="form-select form-select-sm w-auto">
            <option value="">All categories</option>
            <option value="missing-initiative">Missing initiative mapping</option>
            <option value="missing-project">Missing project mapping</option>
            <option value="missing-target">Missing target value</option>
            <option value="missing-plan-years">Missing annual plan values</option>
            <option value="invalid-year-anchors">Invalid year anchors</option>
            <option value="metric-mismatch">Metric mismatch across levels</option>
            <option value="company-scope">Company-scope inconsistency</option>
        </select>
        <button id="gap-apply" class="btn btn-sm btn-outline-secondary">Apply</button>
        <a class="btn btn-sm btn-primary ms-auto" href="/management-governance/enterprise-strategy-business-performance/connections">Edit Row</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Category</th>
                    <th>Goal</th>
                    <th>Objective</th>
                    <th>Initiative</th>
                    <th>Project</th>
                    <th>Issue</th>
                    <th class="text-end es-row-actions-col">Actions</th>
                </tr>
            </thead>
            <tbody id="gap-table-body"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/row-actions-menu.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/connections-gap.js" asp-append-version="true"></script>
}
