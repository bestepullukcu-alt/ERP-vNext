@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Planning Cycles";
    ViewData["Active"] = "cycles";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="planning-workspace planning-cycles-page es-planning-page-shell row g-3">
    <div class="col-12 mb-4">
        @await Html.PartialAsync("Components/Planning/_PlanningCycleSummaryCards")
    </div>

    <style>
        /* Responsive Modal Close Button - Permanent Placement */
        .btn-close {
            position: absolute !important;
            top: 15px !important;
            right: 15px !important;
            opacity: 1 !important;
            padding: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 30px !important;
            height: 30px !important;
            z-index: 1000 !important;
            transition: all 0.2s ease-in-out !important;
            cursor: pointer !important;
        }

        .btn-close:hover {
            transform: scale(1.1) !important;
            background-color: #f8f7f8 !important;
            color: #5a5fe0 !important;
        }

        .btn-close::before {
            content: '\ea3a' !important;
            /* Boxicons bx-x */
            font-family: 'boxicons' !important;
            font-size: 20px !important;
            color: #5d596c !important;
            display: block !important;
        }

        .dtr-modal-display .btn-close:hover::before {
            color: #5a5fe0 !important;
        }

        /* Ensure the modal content is a valid anchor for absolute positioning */
        .dtr-modal-display {
            padding: 3.5rem 2rem 2rem 2rem !important;
            position: relative !important;
            background: #fff !important;
            border-radius: 0.5rem !important;
        }

        .dtr-modal-content {
            border-radius: 0.5rem !important;
            border: none !important;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

        .modal-header {
            padding: 1.5rem 1.5rem 0.5rem 1.5rem !important;
            border-bottom: none !important;
        }

        .modal-title {
            font-weight: 600 !important;
            color: #5d596c !important;
        }
    </style>

    <div class="col-12">
        <div class="card" id="planning-cycles-card">
            @await Html.PartialAsync("Components/Planning/_WorkspaceSubtabs", new ViewDataDictionary(ViewData) { {
            "HideCardWrapper", true } })
            <div class="card-header border-bottom">
                <h5 class="card-title mb-0">Planning Cycle Register</h5>
            </div>
            <div id="filterCollapse" class="collapse">
                <div class="card-body border-bottom">
                    <div class="row g-4 align-items-end">
                        <div class="col-md-2 planning_cycle_type"></div>
                        <div class="col-md-3 planning_cycle_company"></div>
                        <div class="col-md-2 planning_cycle_owner"></div>
                        <div class="col-md-2 planning_cycle_status"></div>
                        <div class="col-md-3 d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-primary btn-apply-filter w-100">Apply</button>
                            <button type="button"
                                class="btn btn-sm btn-label-danger btn-reset-filter w-100">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("Components/Planning/_PlanningCycleStandardTable")
        </div>
    </div>
</div>



@await Html.PartialAsync("Components/Planning/_PlanningCycleOffcanvas")

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/planning-cycles.js" asp-append-version="true"></script>
}
