@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Strategy Alignment Register - Graph View";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections">Register</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections/gaps">Gap View</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections/lineage">Lineage View</a>
        <a class="btn btn-sm btn-outline-secondary active" href="/management-governance/enterprise-strategy-business-performance/connections/graph">Graph View</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Nodes</div><div class="h6 mb-0" id="graph-kpi-nodes">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Edges</div><div class="h6 mb-0" id="graph-kpi-edges">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Goal Nodes</div><div class="h6 mb-0" id="graph-kpi-goals">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Project Nodes</div><div class="h6 mb-0" id="graph-kpi-projects">0</div></div></div>
</div>

<div class="card">
    <div class="card-body">
        <div id="graph-state" class="small text-muted mb-2">Loading graph...</div>
        <div id="graph-list"></div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/connections-graph.js" asp-append-version="true"></script>
}
