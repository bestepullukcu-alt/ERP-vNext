@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Consolidation View";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input id="consolidation-goal" class="form-control form-control-sm w-auto" placeholder="Goal ID" />
        <input id="consolidation-company" class="form-control form-control-sm w-auto" placeholder="Company" />
        <button id="consolidation-apply" class="btn btn-sm btn-outline-secondary">Apply</button>
        <a class="btn btn-sm btn-outline-secondary ms-auto" href="/management-governance/enterprise-strategy-business-performance/cascade/variance">Open Variance Analysis</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Rows</div><div class="h5 mb-0" id="cons-kpi-rows">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Current Total</div><div class="h5 mb-0" id="cons-kpi-current">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Target Total</div><div class="h5 mb-0" id="cons-kpi-target">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Variance</div><div class="h5 mb-0" id="cons-kpi-variance">0</div></div></div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Goal</th>
                    <th>Objective</th>
                    <th>Company</th>
                    <th class="text-end">Contribution</th>
                    <th class="text-end">Current</th>
                    <th class="text-end">Target</th>
                    <th class="text-end">Variance</th>
                    <th class="text-end es-row-actions-col">Actions</th>
                </tr>
            </thead>
            <tbody id="consolidation-table"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/row-actions-menu.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/consolidation-view.js" asp-append-version="true"></script>
}
