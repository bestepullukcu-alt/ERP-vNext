@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Strategy Goals";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="row g-3">
    <div class="col-12">
        <div class="card goal-table-card" id="goals-register-card">
            <div class="card-header border-bottom">
                <h5 class="card-title mb-0">Strategy Goal Register</h5>
            </div>
            <div id="goalFilterCollapse" class="collapse">
                <div class="card-body border-bottom">
                    <div class="row g-4 align-items-end">
                        <div class="col-md-3 form-control-validation">
                            <label class="form-label" for="goal-filter-category">Category</label>
                            <select id="goal-filter-category" class="select2 form-select form-select-lg"><option value="">All categories</option></select>
                        </div>
                        <div class="col-md-3 form-control-validation">
                            <label class="form-label" for="goal-filter-owner">Owner</label>
                            <select id="goal-filter-owner" class="select2 form-select form-select-lg"><option value="">All owners</option></select>
                        </div>
                        <div class="col-md-2 form-control-validation">
                            <label class="form-label" for="goal-filter-status">Status</label>
                            <select id="goal-filter-status" class="select2 form-select form-select-lg"><option value="">All statuses</option></select>
                        </div>
                        <div class="col-md-2 form-control-validation">
                            <label class="form-label" for="goal-filter-priority">Priority</label>
                            <select id="goal-filter-priority" class="select2 form-select form-select-lg"><option value="">All priorities</option></select>
                        </div>
                        <div class="col-md-2 d-flex justify-content-end gap-2">
                            <button id="goal-apply-filters" type="button" class="btn btn-sm btn-primary w-100">Apply</button>
                            <button id="goal-reset-filters" type="button" class="btn btn-sm btn-label-danger w-100">Reset</button>
                        </div>
                    </div>
                    <div class="row g-4 align-items-end mt-0">
                        <div class="col-md-3 form-control-validation">
                            <label class="form-label" for="goal-filter-scope-mode">Scope Mode</label>
                            <select id="goal-filter-scope-mode" class="select2 form-select form-select-lg"><option value="">All scope modes</option></select>
                        </div>
                        <div class="col-md-3 form-control-validation">
                            <label class="form-label" for="goal-filter-company">Company</label>
                            <input id="goal-filter-company" class="form-control form-control-lg" placeholder="Company" list="goal-filter-company-list" />
                        </div>
                        <div class="col-md-3 form-control-validation">
                            <label class="form-label" for="goal-filter-scope">Entity Scope</label>
                            <input id="goal-filter-scope" class="form-control form-control-lg" placeholder="Entity Scope" />
                        </div>
                        <div class="col-md-3 form-control-validation">
                            <label class="form-label" for="goal-filter-year-range">Year Range</label>
                            <input id="goal-filter-year-range" class="form-control form-control-lg" placeholder="2027-2031" inputmode="numeric" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-datatable table-responsive">
                <table class="table border-top mb-0" id="goals-table">
                    <thead>
                        <tr id="goals-header-row"></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<datalist id="goal-filter-company-list"></datalist>
<button id="goal-columns-btn" type="button" aria-hidden="true" tabindex="-1" style="position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;"></button>
<input id="goal-import-file" type="file" accept=".csv,.xlsx" class="d-none" />
<input id="goal-import-workbook-file" type="file" accept=".xlsx" class="d-none" />

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/goals.js" asp-append-version="true"></script>
}
