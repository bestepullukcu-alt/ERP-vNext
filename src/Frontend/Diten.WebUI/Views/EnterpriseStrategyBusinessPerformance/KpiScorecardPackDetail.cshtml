@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Scorecard Pack Detail";
    var packId = ViewData["ScorecardPackId"]?.ToString() ?? string.Empty;
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body">
        <h5 class="mb-1" id="kpi-pack-name">Scorecard Pack</h5>
        <div class="small text-muted">Pack Id: <span id="kpi-pack-id">@packId</span></div>
        <div id="kpi-pack-meta" class="small mt-2"></div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm mb-0" id="kpi-pack-items-table">
            <thead>
                <tr>
                    <th>Display Order</th>
                    <th>Priority Class</th>
                    <th>KPI Template Code</th>
                    <th>KPI Template Name</th>
                    <th>Rationale</th>
                    <th class="text-end">Template Link</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/kpi-scorecard-pack-detail.js" asp-append-version="true"></script>
}
