@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Target Allocation";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input id="allocation-goal" class="form-control form-control-sm w-auto" placeholder="Goal ID" />
        <input id="allocation-metric" class="form-control form-control-sm w-auto" placeholder="Goal Metric" />
        <button id="allocation-load" class="btn btn-sm btn-outline-secondary">Load Allocation</button>
        <button id="allocation-generate" class="btn btn-sm btn-outline-secondary">Generate Even Distribution</button>
        <button id="allocation-validate" class="btn btn-sm btn-outline-secondary">Validate Total</button>
        <button id="allocation-save" class="btn btn-sm btn-primary ms-auto">Save Allocation</button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-4"><div class="border rounded p-2"><div class="small text-muted">Parent Target</div><div class="h5 mb-0" id="allocation-parent-target">0</div></div></div>
    <div class="col-6 col-md-4"><div class="border rounded p-2"><div class="small text-muted">Allocated Final Total</div><div class="h5 mb-0" id="allocation-final-total">0</div></div></div>
    <div class="col-12 col-md-4"><div class="border rounded p-2"><div class="small text-muted">Validation</div><div class="h6 mb-0" id="allocation-validation">Not checked</div></div></div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Level</th>
                    <th>Entity</th>
                    <th>Company</th>
                    <th class="text-end">Generated</th>
                    <th class="text-end">Manual</th>
                    <th class="text-end">Final</th>
                </tr>
            </thead>
            <tbody id="allocation-table"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/target-allocation.js" asp-append-version="true"></script>
}
