@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Blueprint Detail";
    var blueprintId = (ViewData["BlueprintId"]?.ToString() ?? string.Empty);
}

@await Html.PartialAsync("Components/_SubdomainShell", Model)
<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <div class="text-muted small">Blueprint Pack ID:</div>
        <code id="library-blueprint-id">@blueprintId</code>
        <a class="btn btn-sm btn-outline-secondary ms-auto" href="/management-governance/enterprise-strategy-business-performance/library/catalog">Back to Catalog</a>
        <a id="library-blueprint-instantiate-link" class="btn btn-sm btn-primary" href="/management-governance/enterprise-strategy-business-performance/library/instantiate?sourceType=BlueprintPack&sourceId=@blueprintId">Instantiate</a>
    </div>
</div>
<div class="card mb-3">
    <div class="card-body">
        <h6 id="library-blueprint-name">Loading...</h6>
        <p class="text-muted mb-1" id="library-blueprint-description"></p>
        <div class="small text-muted">
            Status: <span id="library-blueprint-status">-</span> |
            Version: <span id="library-blueprint-version">-</span>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm align-middle" id="library-blueprint-hierarchy-table">
                <thead>
                    <tr>
                        <th>Goal</th>
                        <th>Objective</th>
                        <th>Initiative</th>
                        <th>Project</th>
                        <th>Aggregation</th>
                        <th>Years</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-library-blueprint-detail.js" asp-append-version="true"></script>
}
