@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Scorecard Dashboard";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input id="scorecard-goal" class="form-control form-control-sm w-auto" placeholder="Goal" />
        <input id="scorecard-objective" class="form-control form-control-sm w-auto" placeholder="Objective" />
        <input id="scorecard-company" class="form-control form-control-sm w-auto" placeholder="Company" />
        <input id="scorecard-period" class="form-control form-control-sm w-auto" placeholder="Time period (YYYY-MM)" />
        <button id="scorecard-apply" class="btn btn-sm btn-outline-secondary">Apply</button>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/kpis">KPI Catalog</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/kpis/ownership">Metric Ownership</a>
    </div>
</div>

<div class="row g-3 mb-3" id="scorecard-kpi-strip">
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Total KPIs</div><div class="h5 mb-0" id="scorecard-total">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">On Track</div><div class="h5 mb-0" id="scorecard-ontrack">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">At Risk</div><div class="h5 mb-0" id="scorecard-risk">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Off Track</div><div class="h5 mb-0" id="scorecard-offtrack">0</div></div></div>
</div>

<div id="scorecard-state" class="small text-muted mb-2">Loading scorecard...</div>
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2" id="scorecard-cards"></div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>KPI</th>
                    <th>Goal</th>
                    <th>Objective</th>
                    <th>Company</th>
                    <th>Period</th>
                    <th class="text-end">Current</th>
                    <th class="text-end">Baseline</th>
                    <th class="text-end">Target</th>
                    <th class="text-end">Variance</th>
                    <th>Trend</th>
                    <th>Status</th>
                    <th>Origin</th>
                </tr>
            </thead>
            <tbody id="scorecard-table"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/kpi-scorecard.js" asp-append-version="true"></script>
}
