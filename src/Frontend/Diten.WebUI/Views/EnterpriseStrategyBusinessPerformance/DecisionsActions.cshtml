@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Decisions & Actions";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input id="decision-filter-review" class="form-control form-control-sm w-auto" placeholder="Review ID" />
        <select id="decision-filter-status" class="form-select form-select-sm w-auto">
            <option value="">Status</option>
            <option value="Open">Open</option>
            <option value="Completed">Completed</option>
        </select>
        <button id="decision-apply" class="btn btn-sm btn-outline-secondary">Apply</button>
        <button id="decision-create" class="btn btn-sm btn-primary ms-auto">Add Decision</button>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Decision Title</th>
                    <th>Review</th>
                    <th>Goal</th>
                    <th>Objective</th>
                    <th>KPI</th>
                    <th>Owner</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th class="text-end es-row-actions-col">Actions</th>
                </tr>
            </thead>
            <tbody id="decisions-table"></tbody>
        </table>
    </div>
</div>

<div class="modal fade es-modal" id="decisionEditorModal" tabindex="-1" aria-hidden="true" data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Decision / Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @{ ViewData["Id"] = "decision-form-error"; }
                @await Html.PartialAsync("Components/Forms/_ValidationSummary")
                <div class="row g-2">
                    <div class="col-12 col-md-6"><label class="form-label es-required" for="decision-review">Review ID</label><input id="decision-review" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label es-required" for="decision-title">Decision Title</label><input id="decision-title" class="form-control" /></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="decision-goal">Goal</label><input id="decision-goal" class="form-control" /></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="decision-objective">Objective</label><input id="decision-objective" class="form-control" /></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="decision-kpi">KPI</label><input id="decision-kpi" class="form-control" /></div>
                    <div class="col-12 col-md-4"><label class="form-label es-required" for="decision-owner">Owner</label><select id="decision-owner" class="form-select"><option value="">Select owner</option></select></div>
                    <div class="col-12 col-md-4"><label class="form-label es-required" for="decision-due-date">Due Date</label><input id="decision-due-date" type="date" class="form-control" /></div>
                    <div class="col-12 col-md-4"><label class="form-label" for="decision-status">Status</label><select id="decision-status" class="form-select"><option>Open</option><option>Completed</option></select></div>
                    <div class="col-12 col-md-6"><label class="form-label" for="decision-evidence">Evidence</label><input id="decision-evidence" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label" for="decision-rationale">Rationale</label><input id="decision-rationale" class="form-control" /></div>
                </div>
            </div>
            @{ ViewData["SaveId"] = "decision-save"; ViewData["SaveLabel"] = "Create Decision"; }
            @await Html.PartialAsync("Components/Forms/_StickyModalFooter")
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/modal-form-utils.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/row-actions-menu.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/decisions-actions.js" asp-append-version="true"></script>
}
