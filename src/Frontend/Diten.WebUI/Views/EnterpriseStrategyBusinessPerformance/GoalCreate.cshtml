@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
  ViewData["Title"] = "Create Goal";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div id="goal-create-workspace" class="goal-create-workspace">
  <div id="goalEditorModal" class="goal-workspace-shell">
    <div class="goal-workspace-header sticky-top">
      <div class="goal-workspace-title-wrap">
        <h5 class="goal-workspace-title mb-0" id="goal-modal-title">Create Strategic Goal</h5>
        <p class="goal-workspace-subtitle mb-0" id="goal-modal-subtitle">Create a draft strategic goal with governance ownership, planning horizon, company applicability, KPI targets, and traceable strategic context.</p>
      </div>
      <div class="goal-workspace-actions">
        <a id="goal-workspace-cancel" href="/management-governance/enterprise-strategy-business-performance/goals" class="btn btn-sm btn-outline-secondary">Cancel / Back</a>
        <button type="button" id="goal-step-back" class="btn btn-sm btn-outline-secondary">Back</button>
        <button type="button" id="goal-step-next" class="btn btn-sm btn-outline-primary">Next</button>
        <button type="button" id="goal-save-draft" class="btn btn-sm btn-outline-secondary d-none">Save Draft</button>
        <button type="button" id="goal-validate" class="btn btn-sm btn-outline-info d-none">Validate</button>
        <button type="button" id="goal-save" class="btn btn-sm btn-primary d-none">Create Goal</button>
      </div>
    </div>

    <div class="goal-workspace-body">
      @{
        ViewData["Id"] = "goal-form-error";
      }
      @await Html.PartialAsync("Components/Forms/_ValidationSummary")
      @await Html.PartialAsync("Components/GoalCreate/_SourceSelectionSection")
      <div id="goal-wizard-steps" class="goal-wizard-nav mb-3" role="tablist" aria-label="Create Strategic Goal Steps">
        <button type="button" class="btn goal-wizard-step-btn active" data-step="1" role="tab" aria-selected="true">1. Strategic Identity</button>
        <button type="button" class="btn goal-wizard-step-btn" data-step="2" role="tab" aria-selected="false">2. Ownership &amp; Accountability</button>
        <button type="button" class="btn goal-wizard-step-btn" data-step="3" role="tab" aria-selected="false">3. Planning &amp; Horizon</button>
        <button type="button" class="btn goal-wizard-step-btn" data-step="4" role="tab" aria-selected="false">4. Company Applicability</button>
        <button type="button" class="btn goal-wizard-step-btn" data-step="5" role="tab" aria-selected="false">5. Strategic KPI &amp; Yearly Targets</button>
        <button type="button" class="btn goal-wizard-step-btn goal-wizard-step-btn-compact" data-step="6" role="tab" aria-selected="false">6. Strategic Budget Envelope</button>
        <button type="button" class="btn goal-wizard-step-btn goal-wizard-step-btn-compact" data-step="7" role="tab" aria-selected="false">7. Governance &amp; Traceability</button>
      </div>

      <div class="goal-wizard-step-pane" data-step="1">
        @await Html.PartialAsync("Components/GoalCreate/_StrategicIdentitySection")
      </div>
      <div class="goal-wizard-step-pane d-none" data-step="2">
        @await Html.PartialAsync("Components/GoalCreate/_OwnershipAccountabilitySection")
      </div>
      <div class="goal-wizard-step-pane d-none" data-step="3">
        @await Html.PartialAsync("Components/GoalCreate/_PlanningHorizonSection")
      </div>
      <div class="goal-wizard-step-pane d-none" data-step="4">
        @await Html.PartialAsync("Components/GoalCreate/_CompanyApplicabilitySection")
      </div>
      <div class="goal-wizard-step-pane d-none" data-step="5">
        @await Html.PartialAsync("Components/GoalCreate/_StrategicKpiSection")
      </div>
      <div class="goal-wizard-step-pane d-none" data-step="6">
        @await Html.PartialAsync("Components/GoalCreate/_BudgetEnvelopeSection")
      </div>
      <div class="goal-wizard-step-pane d-none" data-step="7">
        @await Html.PartialAsync("Components/GoalCreate/_GovernanceSection")
      </div>

      <aside id="goal-readiness-panel" class="goal-readiness-panel sticky-bottom" aria-live="polite">
        <div class="goal-readiness-header">
          <div class="goal-readiness-title-wrap">
            <strong id="goal-publish-readiness-indicator" class="goal-readiness-indicator state-blocked">Goal Readiness: Blocked</strong>
            <div id="goal-publish-readiness-text" class="small text-muted">Complete the required wizard steps to create a draft strategic goal.</div>
          </div>
          <div id="goal-validation-mode-indicator" class="goal-readiness-chip">Validation mode: Wizard</div>
          <div id="goal-backend-alignment-indicator" class="goal-readiness-chip">Backend alignment: Checking...</div>
        </div>
        <div class="goal-readiness-facts">
          <span id="goal-readiness-kpi-count" class="goal-readiness-chip">KPI count: 0</span>
          <span id="goal-readiness-kpi-missing-yearly" class="goal-readiness-chip">KPI rows missing yearly targets: 0</span>
          <span id="goal-readiness-budget-enabled" class="goal-readiness-chip">Budget block: disabled</span>
          <span id="goal-readiness-governance-missing" class="goal-readiness-chip">Governance publish fields missing: 0</span>
        </div>
        <div class="goal-readiness-columns">
          <div>
            <div class="goal-readiness-subtitle">Missing required fields</div>
            <ul id="goal-readiness-missing-required" class="mb-0"></ul>
          </div>
          <div>
            <div class="goal-readiness-subtitle">Publish blockers</div>
            <ul id="goal-readiness-publish-blockers" class="mb-0"></ul>
          </div>
        </div>
        <div class="goal-readiness-legend">
          <span class="es-field-tag tag-required">Required</span>
          <span class="es-field-tag tag-optional">Optional</span>
          <span class="es-field-tag tag-derived">Derived</span>
          <span class="es-field-tag tag-system">System-managed</span>
        </div>
      </aside>
    </div>
  </div>
</div>

<div class="modal fade es-modal" id="goalSourcePickerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable goal-template-picker-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Choose Goal Template</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="goal-template-picker-context" class="goal-template-picker-context mb-3">
          <div class="goal-template-picker-context-header">
            <div>
              <div class="goal-template-picker-context-kicker">Strategy Template Context</div>
              <h6 class="goal-template-picker-context-title mb-1">Choose a template for the new strategic goal.</h6>
              <p class="goal-template-picker-context-copy mb-0">Review the current goal draft context below. Goal Template type values are loaded from the stored strategy-library templates before you apply defaults.</p>
            </div>
            <div class="goal-template-picker-context-badges">
              <span class="badge bg-label-info">Strategy library</span>
              <span class="badge bg-label-primary">Database-backed types</span>
            </div>
          </div>
          <div class="goal-template-picker-context-grid">
            <div class="goal-template-picker-context-item is-anchor">
              <div class="goal-template-picker-context-label">Current Goal</div>
              <div id="goal-template-picker-current-goal" class="goal-template-picker-context-value">New Goal draft</div>
            </div>
            <div class="goal-template-picker-context-item">
              <div class="goal-template-picker-context-label">Draft Type</div>
              <div id="goal-template-picker-current-type" class="goal-template-picker-context-value">-</div>
            </div>
            <div class="goal-template-picker-context-item">
              <div class="goal-template-picker-context-label">Entity Scope</div>
              <div id="goal-template-picker-current-scope" class="goal-template-picker-context-value">-</div>
            </div>
            <div class="goal-template-picker-context-item">
              <div class="goal-template-picker-context-label">Lifecycle</div>
              <div id="goal-template-picker-current-status" class="goal-template-picker-context-value">Draft</div>
            </div>
            <div class="goal-template-picker-context-item">
              <div class="goal-template-picker-context-label">Selected Template</div>
              <div id="goal-template-picker-current-template" class="goal-template-picker-context-value">None selected</div>
            </div>
          </div>
          <div id="goal-template-picker-context-warning" class="alert alert-warning d-none mt-3 mb-0" role="alert"></div>
        </div>
        <div class="row g-2 mb-2">
          <div class="col-12 col-xl-6">
            <input id="goal-source-picker-search" class="form-control form-control-sm" placeholder="Search by name, statement, owner, or type..." />
          </div>
          <div class="col-12 col-md-6 col-xl-3">
            <select id="goal-source-picker-type" class="form-select form-select-sm">
              <option value="">All types</option>
            </select>
          </div>
          <div class="col-12 col-md-6 col-xl-3">
            <select id="goal-source-picker-entity-scope" class="form-select form-select-sm">
              <option value="">All entity scopes</option>
            </select>
          </div>
        </div>
        <div id="goal-template-picker-helper" class="goal-inline-hint mb-2">Showing Goal Templates from the strategy library.</div>
        <div class="table-responsive goal-template-picker-table-wrap">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Template ID</th>
                <th>Goal Name</th>
                <th>Statement</th>
                <th>Type</th>
                <th>Owner</th>
                <th>Entity Scope</th>
                <th>Status</th>
                <th>Version</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="goal-source-picker-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #goal-create-workspace {
    padding-bottom: 1.25rem;
  }

  #goal-create-workspace .goal-workspace-shell {
    border: 1px solid rgba(176, 189, 230, 0.28);
    border-radius: .8rem;
    background: linear-gradient(180deg, rgba(38, 45, 73, .94) 0%, rgba(35, 42, 68, .94) 100%);
    overflow: hidden;
  }

  #goal-create-workspace .goal-workspace-header {
    top: .5rem;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .8rem;
    padding: .85rem 1rem;
    border-bottom: 1px solid rgba(176, 189, 230, 0.22);
    backdrop-filter: blur(10px);
    background: rgba(26, 33, 57, .82);
  }

  #goal-create-workspace .goal-workspace-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: .01em;
  }

  #goal-create-workspace .goal-workspace-subtitle {
    font-size: .82rem;
    color: #9eabcf;
  }

  #goal-create-workspace .goal-workspace-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    justify-content: flex-end;
  }

  #goal-create-workspace .goal-workspace-body {
    padding: .95rem;
  }

  #goal-create-workspace .goal-wizard-nav {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: .5rem;
    margin-bottom: .8rem;
  }

  #goal-create-workspace .goal-wizard-step-btn {
    border: 1px solid rgba(176, 189, 230, .28);
    border-radius: .6rem;
    color: #c9d5f5;
    text-align: left;
    font-weight: 700;
    background: rgba(176, 189, 230, .08);
    padding: .72rem .8rem;
    min-height: 4rem;
  }

  #goal-create-workspace .goal-wizard-step-btn.active {
    border-color: rgba(var(--bs-primary-rgb), .55);
    color: #edf2ff;
    background: rgba(var(--bs-primary-rgb), .18);
    box-shadow: inset 0 0 0 1px rgba(var(--bs-primary-rgb), .16);
  }

  #goal-create-workspace .goal-wizard-step-btn.is-complete {
    border-color: rgba(115, 215, 168, .34);
    background: rgba(63, 146, 104, .18);
  }

  #goal-create-workspace .goal-wizard-step-btn.is-blocked {
    border-color: rgba(255, 138, 128, .42);
    background: rgba(162, 53, 53, .18);
  }

  #goal-create-workspace .goal-wizard-step-btn-compact {
    font-size: .82rem;
  }

  #goal-create-workspace .goal-source-panel {
    border: 1px solid rgba(176, 189, 230, .28);
    border-radius: .65rem;
    background: rgba(22, 30, 52, .86);
    padding: .78rem;
    margin-bottom: .72rem;
  }

  #goalSourcePickerModal .goal-template-picker-dialog {
    width: min(96vw, 1800px);
    max-width: min(96vw, 1800px);
    height: calc(100vh - 1.5rem);
    margin: .75rem auto;
  }

  #goalSourcePickerModal .modal-content {
    height: 100%;
  }

  #goalSourcePickerModal .modal-body {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  #goalSourcePickerModal .goal-template-picker-table-wrap {
    flex: 1 1 auto;
    max-height: none;
  }

  #goalSourcePickerModal .goal-template-picker-context {
    border: 1px solid rgba(104, 120, 168, .18);
    border-radius: .9rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .18) 0%, rgba(104, 120, 168, .05) 100%),
      rgba(104, 120, 168, .06);
    padding: .9rem 1rem;
  }

  #goalSourcePickerModal .goal-template-picker-context-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .8rem;
    margin-bottom: .85rem;
    border-bottom: 1px solid rgba(104, 120, 168, .16);
  }

  #goalSourcePickerModal .goal-template-picker-context-kicker {
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #afbddf;
    margin-bottom: .2rem;
  }

  #goalSourcePickerModal .goal-template-picker-context-title {
    color: #edf2ff;
    font-weight: 700;
  }

  #goalSourcePickerModal .goal-template-picker-context-copy {
    color: #afbddf;
    max-width: 62rem;
  }

  #goalSourcePickerModal .goal-template-picker-context-badges {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    justify-content: flex-end;
  }

  #goalSourcePickerModal .goal-template-picker-context-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: .75rem;
  }

  #goalSourcePickerModal .goal-template-picker-context-item {
    min-width: 0;
    border: 1px solid rgba(104, 120, 168, .14);
    border-radius: .85rem;
    background: rgba(255, 255, 255, .38);
    padding: .8rem .85rem;
    min-height: 6rem;
  }

  #goalSourcePickerModal .goal-template-picker-context-item.is-anchor {
    background: linear-gradient(135deg, rgba(88, 99, 255, .11), rgba(104, 120, 168, .06));
  }

  #goalSourcePickerModal .goal-template-picker-context-label {
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: #afbddf;
    margin-bottom: .2rem;
  }

  #goalSourcePickerModal .goal-template-picker-context-value {
    color: #edf2ff;
    font-weight: 600;
    word-break: break-word;
    line-height: 1.4;
  }

  #goalSourcePickerModal .goal-template-picker-row {
    cursor: pointer;
  }

  #goalSourcePickerModal .goal-template-picker-row:hover,
  #goalSourcePickerModal .goal-template-picker-row:focus-visible {
    background: rgba(88, 99, 255, .06);
    outline: none;
  }

  #goal-create-workspace .goal-inline-hint {
    color: #b8c5df;
    font-size: .84rem;
  }

  @@media (max-width: 1199.98px) {
    #goalSourcePickerModal .goal-template-picker-context-header {
      flex-direction: column;
    }

    #goalSourcePickerModal .goal-template-picker-context-badges {
      justify-content: flex-start;
    }

    #goalSourcePickerModal .goal-template-picker-context-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @@media (max-width: 767.98px) {
    #goalSourcePickerModal .goal-template-picker-context-grid {
      grid-template-columns: 1fr;
    }
  }

  #goal-create-workspace .goal-source-controls {
    display: grid;
    grid-template-columns: minmax(240px, 1.3fr) minmax(200px, 1fr) minmax(200px, 1fr);
    gap: .5rem;
    align-items: end;
  }

  #goal-create-workspace .goal-source-control {
    min-width: 0;
  }

  #goal-create-workspace .goal-source-summary-card {
    margin-top: .85rem;
    border: 1px dashed rgba(176, 189, 230, .4);
    border-radius: .65rem;
    padding: .68rem .75rem;
    background: rgba(176, 189, 230, .08);
  }

  #goal-create-workspace .goal-source-summary-card.is-empty {
    color: #b4c2e4;
  }

  #goal-create-workspace .goal-source-summary-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    align-items: center;
    margin-bottom: .35rem;
  }

  #goal-create-workspace .goal-source-summary-name {
    font-weight: 600;
    color: #edf2ff;
  }

  #goal-create-workspace .goal-source-summary-note {
    color: #a7b8dd;
    font-size: .8rem;
  }

  #goal-create-workspace .goal-step-helper-banner {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    align-items: center;
    border: 1px solid rgba(176, 189, 230, .24);
    border-radius: .65rem;
    padding: .72rem .85rem;
    background: rgba(176, 189, 230, .09);
    color: #d7e2ff;
  }

  #goal-create-workspace .es-goal-section {
    border: 1px solid rgba(176, 189, 230, 0.28);
    border-radius: .65rem;
    background: rgba(39, 46, 73, .9);
    padding: .78rem;
    margin-bottom: .72rem;
  }

  #goal-create-workspace .es-goal-section > summary {
    cursor: pointer;
    font-weight: 700;
    font-size: .95rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .6rem;
  }

  #goal-create-workspace .es-goal-section-state {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: .73rem;
    line-height: 1;
    padding: .25rem .52rem;
    border: 1px solid transparent;
    color: #c9d5f5;
    background: rgba(176, 189, 230, .12);
  }

  #goal-create-workspace .es-goal-section-state.state-complete {
    color: #73d7a8;
    border-color: rgba(115, 215, 168, .38);
    background: rgba(63, 146, 104, .2);
  }

  #goal-create-workspace .es-goal-section-state.state-progress {
    color: #f4d483;
    border-color: rgba(244, 212, 131, .38);
    background: rgba(155, 121, 42, .24);
  }

  #goal-create-workspace .es-goal-section-state.state-empty {
    color: #9eabcf;
    border-color: rgba(176, 189, 230, .26);
    background: rgba(176, 189, 230, .1);
  }

  #goal-create-workspace .es-goal-section-state.state-optional {
    color: #9ec4ff;
    border-color: rgba(158, 196, 255, .35);
    background: rgba(66, 95, 165, .24);
  }

  #goal-create-workspace .es-goal-section-state.state-error {
    color: #ff9ea6;
    border-color: rgba(255, 128, 138, .5);
    background: rgba(120, 33, 43, .38);
  }

  #goal-create-workspace .es-goal-section.es-goal-section-error {
    border-color: rgba(255, 110, 122, .64);
    box-shadow: 0 0 0 .12rem rgba(255, 107, 122, .16);
  }

  #goal-create-workspace .es-field-tag {
    display: inline-flex;
    align-items: center;
    margin-left: .35rem;
    padding: .12rem .42rem;
    border-radius: 999px;
    font-size: .68rem;
    border: 1px solid rgba(176, 189, 230, .34);
    background: rgba(176, 189, 230, .12);
    color: #cad6f3;
    vertical-align: middle;
  }

  #goal-create-workspace .es-field-tag.tag-required {
    border-color: rgba(244, 212, 131, .45);
    color: #f4d483;
    background: rgba(155, 121, 42, .24);
  }

  #goal-create-workspace .es-field-tag.tag-optional {
    border-color: rgba(157, 180, 235, .4);
    color: #aec3f2;
    background: rgba(70, 93, 148, .28);
  }

  #goal-create-workspace .es-field-tag.tag-derived {
    border-color: rgba(117, 208, 188, .44);
    color: #86dfcf;
    background: rgba(40, 122, 108, .25);
  }

  #goal-create-workspace .es-field-tag.tag-system {
    border-color: rgba(158, 196, 255, .42);
    color: #b3d2ff;
    background: rgba(50, 79, 140, .3);
  }

  #goal-create-workspace #goal-allowed-horizon-summary {
    font-size: .8rem;
    padding: .25rem .5rem;
    border-radius: .35rem;
    background: rgba(109, 145, 250, .12);
    border: 1px solid rgba(143, 167, 247, .35);
    color: #dbe6ff;
  }

  #goal-create-workspace .goal-budget-wrap {
    max-height: 280px;
    overflow: auto;
  }

  #goal-create-workspace .metric-year-wrap {
    max-height: 260px;
    overflow: auto;
  }

  #goal-create-workspace .goal-workspace-actions .btn {
    min-height: 2.3rem;
    display: inline-flex;
    align-items: center;
  }

  #goal-create-workspace .goal-budget-tools {
    display: flex;
    gap: .5rem;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: .55rem;
  }

  #goal-create-workspace .goal-budget-tools .form-select {
    min-width: 200px;
  }

  #goal-create-workspace .goal-budget-actions {
    display: flex;
    gap: .35rem;
    flex-wrap: wrap;
  }

  #goal-create-workspace .goal-budget-content.is-disabled {
    opacity: .56;
    pointer-events: none;
    user-select: none;
    filter: grayscale(.12);
  }

  #goal-create-workspace #goal-budget-disabled-note {
    color: #a8b7dc;
  }

  #goal-create-workspace .goal-metric-card {
    border: 1px solid rgba(176, 189, 230, 0.24);
    border-radius: .6rem;
    padding: .72rem;
    margin-bottom: .72rem;
    background: rgba(26, 33, 57, .58);
  }

  #goal-create-workspace .goal-metric-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: .72rem;
    align-items: center;
  }

  #goal-create-workspace .goal-metric-summary-main { min-width: 0; }

  #goal-create-workspace .goal-metric-summary-name {
    font-size: .95rem;
    font-weight: 700;
    color: #edf2ff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #goal-create-workspace .goal-metric-summary-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    margin-top: .35rem;
  }

  #goal-create-workspace .goal-metric-meta-chip {
