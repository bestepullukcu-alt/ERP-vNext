@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Strategy Alignment Register - Lineage View";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections">Register</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections/gaps">Gap View</a>
        <a class="btn btn-sm btn-outline-secondary active" href="/management-governance/enterprise-strategy-business-performance/connections/lineage">Lineage View</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections/graph">Graph View</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/delivery-execution/initiatives">Aligned Initiatives</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/delivery-execution/projects">Aligned Projects</a>
        <input id="lineage-context" class="form-control form-control-sm w-auto ms-auto" placeholder="Goal/Objective/Initiative/Project or register row text" />
        <button id="lineage-load" class="btn btn-sm btn-outline-secondary">Load Context</button>
    </div>
</div>

<div class="alert alert-info">
    Downstream Initiative and Project records shown here are delivery-owned references. Use the delivery routes below each card to manage them natively.
</div>

<div id="lineage-state" class="small text-muted mb-2">Loading lineage context...</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><strong>Selected Context</strong></div>
            <div class="card-body" id="lineage-context-summary"></div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><strong>Upstream Lineage (Goal -> Objective)</strong></div>
            <div class="card-body" id="lineage-upstream"></div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><strong>Downstream Delivery References (Initiative -> Project)</strong></div>
            <div class="card-body" id="lineage-downstream"></div>
        </div>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-header"><strong>Metrics / Planning Summary</strong></div>
            <div class="card-body" id="lineage-metrics"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/connections-lineage.js" asp-append-version="true"></script>
}
