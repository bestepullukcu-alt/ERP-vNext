@model Diten.WebUI.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Metric Ownership";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <select id="kpi-ownership-owner" class="form-select form-select-sm w-auto"><option value="">Owner</option></select>
        <select id="kpi-ownership-missing" class="form-select form-select-sm w-auto">
            <option value="">Missing Owner</option>
            <option value="yes">Yes</option>
            <option value="no">No</option>
        </select>
        <select id="kpi-ownership-category" class="form-select form-select-sm w-auto"><option value="">KPI Category</option></select>
        <select id="kpi-ownership-status" class="form-select form-select-sm w-auto"><option value="">Status</option></select>
        <select id="kpi-ownership-company" class="form-select form-select-sm w-auto"><option value="">Company</option></select>
        <button id="kpi-ownership-apply" class="btn btn-sm btn-outline-secondary">Apply</button>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/kpis">KPI Catalog</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/kpis/scorecard">Scorecard Dashboard</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Total KPIs</div><div class="h5 mb-0" id="own-kpi-total">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Missing Owner</div><div class="h5 mb-0" id="own-kpi-missing">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Duplicate Owner Scope</div><div class="h5 mb-0" id="own-kpi-duplicate">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">At Risk Ownership</div><div class="h5 mb-0" id="own-kpi-risk">0</div></div></div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>KPI</th>
                    <th>Owner</th>
                    <th>Backup Owner / Steward</th>
                    <th>Reporting Frequency</th>
                    <th>Aggregation Method</th>
                    <th>Company Scope</th>
                    <th>Used By Count</th>
                    <th>Status</th>
                    <th class="text-end es-row-actions-col">Actions</th>
                </tr>
            </thead>
            <tbody id="kpi-ownership-table"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/row-actions-menu.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/kpi-ownership.js" asp-append-version="true"></script>
}
