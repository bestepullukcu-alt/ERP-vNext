@model IReadOnlyList<Diten.WebUI.Models.ManagementGovernance.RecentActivityItem>

<section class="card mg-card h-100">
    <div class="card-header">
        <h2 class="h6 mb-0">Recent Activity</h2>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="mg-empty">No recent activity.</div>
        }
        else
        {
            <ul class="list-unstyled mb-0">
            @foreach (var item in Model.Take(10))
            {
                <li class="mb-3">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-semibold small">@item.Title</div>
                            <div class="small text-muted">@item.Actor • @item.AtUtc.ToString("dd MMM HH:mm")</div>
                            <div class="small text-muted">@item.ActionType</div>
                        </div>
                        <div class="d-flex gap-1">
                            @if (item.HasAuditMarker)
                            {
                                <span class="badge bg-dark-subtle text-dark">Audit</span>
                            }
                            @if (item.HasEvidenceLink)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis">Evidence</span>
                            }
                        </div>
                    </div>
                    <a class="small" href="@item.Route">View context</a>
                </li>
            }
            </ul>
        }
    </div>
</section>
