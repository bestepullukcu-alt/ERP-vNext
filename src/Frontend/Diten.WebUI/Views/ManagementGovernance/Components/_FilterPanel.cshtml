@model Diten.WebUI.Models.ManagementGovernance.ManagementGovernancePageViewModel

<section class="card mg-card">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label for="mg-filter-status" class="form-label small text-uppercase text-muted">Status</label>
                <select id="mg-filter-status" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option>Active</option>
                    <option>Monitor</option>
                    <option>Planned</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label for="mg-filter-owner" class="form-label small text-uppercase text-muted">Owner</label>
                <select id="mg-filter-owner" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var owner in Model.Subdomains.Select(x => x.Owner).Distinct().OrderBy(x => x))
                    {
                        <option>@owner</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label for="mg-filter-risk" class="form-label small text-uppercase text-muted">Risk</label>
                <select id="mg-filter-risk" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option>High</option>
                    <option>Medium</option>
                    <option>Low</option>
                </select>
            </div>
        </div>
    </div>
</section>
