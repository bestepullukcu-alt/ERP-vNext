@model Diten.WebUI.Models.ManagementGovernance.RiskSignal

<article class="card mg-card h-100">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h3 class="h6 mb-1">@Model.Title</h3>
            <partial name="Components/_RiskBadge" model="Model.Severity" />
        </div>
        <p class="small text-muted mb-2">@Model.Description</p>
        <a class="small fw-semibold" href="@Model.Route">Open signal</a>
    </div>
</article>
