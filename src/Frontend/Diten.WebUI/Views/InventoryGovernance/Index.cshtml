@* NO-TOUCH CONSTRAINTS (Cursor Guardrails)
   - Do not change existing API routes, payloads, repositories, or MediatR pipelines.
   - Inventory Governance UI changes must be additive only (no breaking changes).
   - Do not introduce new frontend dependencies.
   - Keep changes minimal and localized to this view.
*@
@model Diten.WebUI.Models.InventoryGovernanceViewModel
@{
    var kpiMock = GetInventoryGovernanceKpiMock();
}

<div class="container-xxl flex-grow-1 container-p-y" data-testid="inventory-governance-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4" data-testid="ig-header-region">
        <div>
            <h1 class="h3 mb-1">Inventory Governance</h1>
            <div class="text-muted">Governance Dashboard</div>
        </div>
        <div class="text-end">
            <div class="text-muted small" id="ig-last-updated" data-testid="ig-last-updated">Last updated: 2026-02-01</div>
        </div>
    </div>

    <div class="card mb-4" data-testid="ig-summary-region" id="ig-summary-region">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h5 class="card-title mb-0">Executive Summary</h5>
                <small class="text-muted">Snapshot of governance signals</small>
            </div>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-testid="ig-expand-collapse" id="ig-expand-collapse">
                Collapse
            </button>
        </div>
        <div class="card-body">
            @await Html.PartialAsync("_GovernanceKpiStrip", (object)kpiMock)
            <div class="mt-4" id="ig-expanded-dashboard" data-testid="ig-expanded-dashboard">
                <div class="ig-section-title" data-testid="ig-section-exec-summary">
                    <span class="ig-section-dot ig-dot--blue"></span>
                    <span>EXECUTIVE SUMMARY</span>
                </div>
                <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-5" id="ig-exec-summary-grid"></div>
                <div class="ig-section-title mt-4" data-testid="ig-section-status-mix">
                    <span class="ig-section-dot ig-dot--green"></span>
                    <span>STATUS MIX</span>
                </div>
                <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-5" id="ig-status-mix-grid"></div>
                <div class="ig-section-title mt-4" data-testid="ig-section-diagnostic-analytics">
                    <span class="ig-section-dot ig-dot--amber"></span>
                    <span>DIAGNOSTIC ANALYTICS</span>
                </div>
                <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-5" id="ig-diagnostic-grid"></div>
            </div>
        </div>
    </div>

    <div class="card mb-4 ig-filters-card" data-testid="ig-filters-region">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="ig-filter-icon">≡</span>
                <div class="fw-semibold">Filters</div>
            </div>
            <button class="btn btn-outline-secondary btn-sm ig-reset-btn" type="button" id="ig-filters-reset" data-testid="ig-filters-reset">
                Reset
            </button>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end ig-filters-row" data-testid="ig-filters">
                <div class="col-12 col-md-6 col-lg-4 col-xl-2">
                    <label class="ig-filter-label" for="ig-filter-country">COUNTRY</label>
                    <select class="form-select" id="ig-filter-country" data-testid="ig-filter-country">
                        <option value="">All</option>
                        <option value="US">US</option>
                        <option value="TR">TR</option>
                        <option value="DE">DE</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-2">
                    <label class="ig-filter-label" for="ig-filter-seller">SELLER</label>
                    <select class="form-select" id="ig-filter-seller" data-testid="ig-filter-seller">
                        <option value="">All</option>
                        <option value="Seller A">Seller A</option>
                        <option value="Seller B">Seller B</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-2">
                    <label class="ig-filter-label" for="ig-filter-distributor">DISTRIBUTOR</label>
                    <select class="form-select" id="ig-filter-distributor" data-testid="ig-filter-distributor">
                        <option value="">All</option>
                        <option value="Distributor X">Distributor X</option>
                        <option value="Distributor Y">Distributor Y</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-2">
                    <label class="ig-filter-label" for="ig-filter-product">PRODUCT</label>
                    <select class="form-select" id="ig-filter-product" data-testid="ig-filter-product">
                        <option value="">All</option>
                        <option value="Product 1">Product 1</option>
                        <option value="Product 2">Product 2</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-1">
                    <label class="ig-filter-label" for="ig-filter-lotno">LOT NO</label>
                    <input class="form-control" id="ig-filter-lotno" data-testid="ig-filter-lotno" type="text" />
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-1">
                    <label class="ig-filter-label" for="ig-filter-status">STATUS</label>
                    <select class="form-select" id="ig-filter-status" data-testid="ig-filter-status">
                        @foreach (var option in Model.StatusOptions)
                        {
                            <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-2">
                    <label class="ig-filter-label" for="ig-filter-aging">AGING BUCKET</label>
                    <select class="form-select" id="ig-filter-aging" data-testid="ig-filter-aging">
                        @foreach (var option in Model.AgingBucketOptions)
                        {
                            <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-2">
                    <label class="ig-filter-label" for="ig-filter-period">PERIOD</label>
                    <select class="form-select" id="ig-filter-period" data-testid="ig-filter-period">
                        <option value="MTD">MTD</option>
                        <option value="QTD">QTD</option>
                        <option value="YTD">YTD</option>
                        <option value="LAST_30">Last 30 days</option>
                        <option value="LAST_90">Last 90 days</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 ig-exc-card" data-testid="ig-exception-table-region">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h5 class="card-title mb-0">Exception Queue</h5>
                <small class="text-muted">Items requiring governance decision</small>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="text-muted" id="ig-exception-count" data-testid="ig-exception-count"></span>
                <div class="d-flex align-items-center gap-1">
                    <span class="small text-muted">Rows</span>
                    <select id="ig-rows-per-page" class="form-select form-select-sm d-inline-block" style="width:auto" data-testid="ig-rows-per-page">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100" selected>100</option>
                        <option value="200">200</option>
                    </select>
                </div>
                <div class="position-relative">
                    <button type="button" id="ig-column-chooser-btn" class="btn btn-outline-secondary btn-sm" data-testid="ig-column-chooser-btn" aria-label="Choose columns">▦</button>
                    <div id="ig-column-chooser-popover" class="d-none position-absolute end-0 mt-2 bg-white border rounded shadow-sm p-3" data-testid="ig-column-chooser-popover" style="z-index: 1060;">
                        <div class="fw-semibold mb-2">Columns</div>
                        <div class="d-grid gap-1">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="status" checked />
                                <span class="form-check-label">Status</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="lotNo" checked />
                                <span class="form-check-label">Lot No</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="productName" checked />
                                <span class="form-check-label">Product Name</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="distributor" checked />
                                <span class="form-check-label">Distributor</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="stockValue" checked />
                                <span class="form-check-label">Stock Value ($)</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="qtyOnHand" checked />
                                <span class="form-check-label">Qty on Hand</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="daysToExpiry" checked />
                                <span class="form-check-label">Days to Expiry</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="riskReason" checked />
                                <span class="form-check-label">Risk Reason</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="recommendedAction" checked />
                                <span class="form-check-label">Recommended Action</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="owner" checked />
                                <span class="form-check-label">Owner</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="daysOnHand" checked />
                                <span class="form-check-label">Days on Hand</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" data-col-key="avgSales" checked />
                                <span class="form-check-label">Avg Sales</span>
                            </label>
                        </div>
                        <button type="button" class="btn btn-link px-0 mt-2" id="ig-column-chooser-reset" data-testid="ig-column-chooser-reset">Reset columns</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="ig-exc-wrap table-responsive">
                <table class="table table-hover table-striped align-middle ig-exc-table" id="ig-exception-table" data-testid="ig-exception-table">
                    <colgroup>
                        <col style="width:120px">
                        <col style="width:110px">
                        <col style="width:220px">
                        <col style="width:180px">
                        <col style="width:140px">
                        <col style="width:110px">
                        <col style="width:140px">
                        <col style="width:180px">
                        <col style="width:190px">
                        <col style="width:140px">
                        <col style="width:130px">
                        <col style="width:110px">
                        <col style="width:80px">
                        <col style="width:50px">
                    </colgroup>
                    <thead>
                        <tr>
                            <th data-col="status">Status</th>
                            <th data-col="lotNo">Lot No</th>
                            <th data-col="productName">Product Name</th>
                            <th data-col="distributor">Distributor</th>
                            <th class="ig-num" data-col="stockValue">Stock Value ($)</th>
                            <th class="ig-num" data-col="qtyOnHand">Qty on Hand</th>
                            <th class="ig-num" data-col="daysToExpiry">Days to Expiry</th>
                            <th data-col="riskReason">Risk Reason</th>
                            <th data-col="recommendedAction">Recommended Action</th>
                            <th data-col="owner">Owner</th>
                            <th class="ig-num ig-metrics-th ig-metrics-start" data-col="daysOnHand">Days on Hand</th>
                            <th class="ig-num ig-metrics-th" data-col="avgSales">Avg Sales</th>
                            <th class="ig-metrics-th ig-actions" data-col="actions">Actions</th>
                            <th class="ig-metrics-th ig-actions"> </th>
                        </tr>
                    </thead>
                    <tbody id="ig-exception-tbody">
                        @foreach (var row in Model.ExceptionRows)
                        {
                            var statusBadgeClass = row.Status switch
                            {
                                "Healthy" => "ig-pill--healthy",
                                "Monitor" => "ig-pill--monitor",
                                "AtRisk" => "ig-pill--risk",
                                "Critical" => "ig-pill--critical",
                                _ => "ig-pill--monitor"
                            };
                            var statusLabel = row.Status switch
                            {
                                "AtRisk" => "At Risk",
                                _ => row.Status
                            };
                            var asOfDate = DateTime.UtcNow.AddDays(-(row.DaysToExpiry % 90)).ToString("yyyy-MM-dd");
                            <tr data-country="@row.Country"
                                data-seller="@row.Seller"
                                data-distributor="@row.DistributorName"
                                data-product="@row.ProductName"
                                data-lotno="@row.LotNo.ToLowerInvariant()"
                                data-status="@row.Status"
                                data-aging="@row.AgingBucket"
                                data-ex-id="@row.Id"
                                data-stockvalue="@row.StockValue"
                                data-daysohand="@row.DaysOnHand"
                                data-daystoexpiry="@row.DaysToExpiry"
                                data-asof="@asOfDate">
                                <td data-col="status"><span class="ig-pill @statusBadgeClass">@statusLabel</span></td>
                                <td data-col="lotNo">@row.LotNo</td>
                                <td data-col="productName">@row.ProductName</td>
                                <td data-col="distributor">@row.DistributorName</td>
                                <td class="ig-num" data-col="stockValue" data-raw="@row.StockValue" data-format="currency" data-currency="USD">@row.StockValue.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td class="ig-num" data-col="qtyOnHand" data-raw="@row.QtyOnHand" data-format="int">@row.QtyOnHand</td>
                                <td class="ig-num" data-col="daysToExpiry" data-raw="@row.DaysToExpiry" data-format="days">@row.DaysToExpiry</td>
                                <td data-col="riskReason">@row.RiskReason</td>
                                <td data-col="recommendedAction">@row.RecommendedAction</td>
                                <td data-col="owner">@(string.IsNullOrWhiteSpace(row.OwnerName) ? "--" : row.OwnerName)</td>
                                <td class="ig-num ig-metrics-td ig-metrics-start" data-col="daysOnHand" data-raw="@row.DaysOnHand" data-format="days">
                                    <a href="javascript:void(0)" class="ig-metric-link">@row.DaysOnHand</a>
                                </td>
                                <td class="ig-num ig-metrics-td" data-col="avgSales" data-raw="@row.AvgSalesMonthly" data-format="int">
                                    <a href="javascript:void(0)" class="ig-metric-link">@row.AvgSalesMonthly</a>
                                </td>
                                <td class="ig-metrics-td ig-actions ig-actions-cell" data-col="actions">
                                    <div class="ig-actions-wrap">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary ig-kebab"
                                                data-testid="ig-row-actions-btn"
                                                aria-label="Row actions"
                                                data-ex-id="@row.Id">
                                            ⋮
                                        </button>
                                        <div class="ig-actions-menu d-none"
                                             role="menu"
                                             data-testid="ig-row-actions-menu"
                                             data-ex-id="@row.Id">
                                            <button type="button" class="dropdown-item" data-action="assign-owner">Assign owner</button>
                                            <button type="button" class="dropdown-item" data-action="create-action">Create action</button>
                                            <button type="button" class="dropdown-item" data-action="snooze">Snooze</button>
                                            <button type="button" class="dropdown-item" data-action="add-note">Add note</button>
                                        </div>
                                    </div>
                                </td>
                                <td class="ig-metrics-td ig-actions">›</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-end align-items-center gap-2 mt-2" id="ig-pager" data-testid="ig-pager">
                <button class="btn btn-outline-secondary btn-sm" id="ig-page-prev" data-testid="ig-page-prev" type="button">Prev</button>
                <span id="ig-page-status" data-testid="ig-page-status" class="small text-muted"></span>
                <button class="btn btn-outline-secondary btn-sm" id="ig-page-next" data-testid="ig-page-next" type="button">Next</button>
            </div>
        </div>
    </div>

    <div class="card mb-3 d-none" data-testid="ig-detail-drawer-region">
        <div class="card-body">
            <div class="text-muted">Detail drawer region placeholder</div>
        </div>
    </div>
</div>

<div class="modal fade" id="ig-detail-modal" tabindex="-1" aria-hidden="true" data-testid="ig-detail-modal">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable ig-plan-modal">
        <div class="modal-content" id="ig-detail-drawer" data-testid="ig-detail-drawer">
            <div class="modal-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge bg-light text-dark" id="ig-drawer-lotno" data-testid="ig-drawer-lotno">LOT-0000</span>
                        <span class="badge bg-secondary" id="ig-drawer-status" data-testid="ig-drawer-status">Status</span>
                    </div>
                    <div class="fw-semibold" id="ig-drawer-product" data-testid="ig-drawer-product">Product</div>
                    <div class="text-muted small" id="ig-drawer-meta" data-testid="ig-drawer-meta">Manufacturer • Country • Distributor</div>
                </div>
                <button type="button" class="btn-close" aria-label="Close" id="ig-drawer-close" data-testid="ig-drawer-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="card h-100" id="ig-drawer-kpi-stockvalue" data-testid="ig-drawer-kpi-stockvalue">
                            <div class="card-body">
                                <div class="text-muted small">Stock Value</div>
                                <div class="fw-semibold" data-ig-field="stockvalue">--</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card h-100" id="ig-drawer-kpi-doh" data-testid="ig-drawer-kpi-doh">
                            <div class="card-body">
                                <div class="text-muted small">Days on Hand</div>
                                <div class="fw-semibold" data-ig-field="daysohand">--</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="ig-drawer-body" data-testid="ig-drawer-body">
                    <div class="card mb-3" id="ig-monthly-planning" data-testid="ig-monthly-planning">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                <div class="fw-semibold">Monthly Planning</div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="ig-unlock-history" data-testid="ig-unlock-history">Unlock History</button>
                            </div>
                            <div class="ig-month-row" id="ig-month-grid" data-testid="ig-month-grid"></div>
                            <div class="text-muted small mt-2" id="ig-forecast-note" data-testid="ig-forecast-note">
                                Future months are automatically forecasted. Editing the active month recalibrates subsequent months.
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3" id="ig-analysis-cost" data-testid="ig-analysis-cost">
                        <div class="card-body">
                            <div class="fw-semibold mb-3">Analysis &amp; Cost</div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="text-muted" id="ig-carrying-rate-label">Monthly Carrying Cost (2.0%)</div>
                                <span id="ig-monthly-carrying-cost" data-testid="ig-monthly-carrying-cost">--</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="text-muted">Annualized Holding Cost</div>
                                <span id="ig-annualized-holding-cost" data-testid="ig-annualized-holding-cost">--</span>
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3" id="ig-plan-note-card">
                        <div class="card-body">
                            <label class="form-label" for="ig-plan-note">Plan note</label>
                            <textarea class="form-control" id="ig-plan-note" data-testid="ig-plan-note" rows="3" placeholder="Add a note (optional)"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="ig-drawer-cancel" data-testid="ig-drawer-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="ig-drawer-save" data-testid="ig-drawer-save">Save Plan</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/services/inventoryGovernanceService.js"></script>
<script src="/js/utils/igFormatters.js"></script>
<script src="/js/inventory-governance/settings.js"></script>
<script src="/js/inventory-governance/kpis.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const toggle = document.getElementById("ig-expand-collapse");
        const summary = document.getElementById("ig-summary-region");
        if (!toggle || !summary) return;

        let isSummaryExpanded = false;
        summary.classList.add("d-none");
        toggle.textContent = "Expand";
        toggle.addEventListener("click", () => {
            isSummaryExpanded = !isSummaryExpanded;
            summary.classList.toggle("d-none", !isSummaryExpanded);
            toggle.textContent = isSummaryExpanded ? "Collapse" : "Expand";
        });

        document.querySelectorAll('[data-testid="ig-kpi-cta"]').forEach((button) => {
            button.addEventListener("click", () => {
                console.log("KPI CTA clicked");
            });
        });

        const settingsApi = window.igSettings;
        const initialSettings = settingsApi?.loadSettings
            ? settingsApi.loadSettings()
            : { annualCarryingRate: 24, riskThresholdDays: 60, currency: "USD" };

        const filtersStorageKey = "inventoryGov.filters.v1";
        const defaultFilters = {
            country: "",
            seller: "",
            distributor: "",
            product: "",
            lotNo: "",
            status: "ALL",
            aging: "ALL",
            period: "MTD"
        };
        window.inventoryGovFilters = { ...defaultFilters };
        window.igState = {
            filters: window.inventoryGovFilters,
            settings: { ...initialSettings },
            allRows: [],
            filteredRows: []
        };

        const syncControlsFromState = () => {
            const setValue = (id, value) => {
                const el = document.getElementById(id);
                if (!el) return;
                el.value = value ?? "";
            };
            setValue("ig-filter-country", window.inventoryGovFilters.country);
            setValue("ig-filter-seller", window.inventoryGovFilters.seller);
            setValue("ig-filter-distributor", window.inventoryGovFilters.distributor);
            setValue("ig-filter-product", window.inventoryGovFilters.product);
            setValue("ig-filter-lotno", window.inventoryGovFilters.lotNo);
            setValue("ig-filter-status", window.inventoryGovFilters.status);
            setValue("ig-filter-aging", window.inventoryGovFilters.aging);
            setValue("ig-filter-period", window.inventoryGovFilters.period);
        };

        const persistFilters = () => {
            try {
                localStorage.setItem(filtersStorageKey, JSON.stringify(window.inventoryGovFilters));
            } catch {
                // localStorage unavailable; ignore
            }
        };

        window.igPaging = { pageSize: 100, pageIndex: 0 };
