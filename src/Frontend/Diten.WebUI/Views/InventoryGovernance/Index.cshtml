            const isFilterHidden = row.classList.contains("ig-filter-hidden");
            const isPageHidden = row.classList.contains("ig-page-hidden");
            row.classList.toggle("d-none", isFilterHidden || isPageHidden);
        };

        const getFilteredRows = () => {
            if (Array.isArray(window.igState?.filteredRows)) {
                return window.igState.filteredRows.map((row) => row.el);
