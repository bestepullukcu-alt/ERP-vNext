        const applyInventoryGovFilters = () => {
            const filters = window.inventoryGovFilters;
            window.igState.filters = filters;
            refreshAllRows();

            const matchSelect = (value, rowValue) => {
                if (!value || value === "ALL") return true;
                return value === rowValue;
            };
            const matchLot = (lot) => {
                if (!filters.lotNo) return true;
                return lot.includes(filters.lotNo.toLowerCase());
            };
            const now = new Date();
            const periodStart = (() => {
                switch (filters.period) {
                    case "QTD": {
                        const quarterStartMonth = Math.floor(now.getMonth() / 3) * 3;
                        return new Date(now.getFullYear(), quarterStartMonth, 1);
                    }
                    case "YTD":
                        return new Date(now.getFullYear(), 0, 1);
                    case "LAST_30":
                        return new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
                    case "LAST_90":
                        return new Date(now.getTime() - 90 * 24 * 60 * 60 * 1000);
                    case "MTD":
                    default:
                        return new Date(now.getFullYear(), now.getMonth(), 1);
                }
            })();
            const matchPeriod = (date) => {
                if (!date || !(date instanceof Date) || Number.isNaN(date.valueOf())) return true;
                return date >= periodStart && date <= now;
            };

            window.igState.filteredRows = window.igState.allRows.filter((row) => {
                const isMatch =
                    matchSelect(filters.country, row.country) &&
                    matchSelect(filters.seller, row.seller) &&
                    matchSelect(filters.distributor, row.distributor) &&
                    matchSelect(filters.product, row.product) &&
                    matchSelect(filters.status, row.status) &&
                    matchSelect(filters.aging, row.aging) &&
                    matchLot(row.lotNo) &&
                    matchPeriod(row.asOfDate);

                row.el.classList.toggle("ig-filter-hidden", !isMatch);
                if (isMatch) {
                    row.el.removeAttribute("data-filter-hidden");
                } else {
                    row.el.setAttribute("data-filter-hidden", "1");
                }
                return isMatch;
            });
            window.igPaging.pageIndex = 0;
            updateExceptionCount();
            applyPagination();
            document.dispatchEvent(new CustomEvent("ig:filtersChanged", {
                detail: { filters: { ...filters }, filteredRows: window.igState.filteredRows }
            }));
        };

