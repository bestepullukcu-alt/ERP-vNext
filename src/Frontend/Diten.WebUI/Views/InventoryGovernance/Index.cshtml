        const applySettings = (settings) => {
            window.igState.settings = { ...settings };
            if (settingsApi?.applySettingsToDom) {
                settingsApi.applySettingsToDom(window.igState.settings);
            }
            if (window.igSelectedExceptionId) {
                const selectedRow = document.querySelector(`#ig-exception-tbody tr[data-ex-id="${window.igSelectedExceptionId}"]`);
                const data = selectedRow?.dataset;
                const stockEl = document.querySelector('#ig-detail-drawer [data-ig-field="stockvalue"]');
                const dohEl = document.querySelector('#ig-detail-drawer [data-ig-field="daysohand"]');
                const monthlyEl = document.getElementById("ig-monthly-carrying-cost");
                const annualEl = document.getElementById("ig-annualized-holding-cost");
                if (data && (stockEl || monthlyEl || annualEl)) {
                    const formatCurrency = window.igFormatCurrency ?? ((value, currency) => value ?? "--");
                    const formatDays = window.igFormatDays ?? ((value) => value ?? "--");
                    const currency = window.igState.settings.currency || "USD";
                    const annualRate = Number(window.igState.settings.annualCarryingRate);
                    const monthlyRate = Number.isFinite(annualRate) ? (annualRate / 12) / 100 : 0;
                    const stockValueRaw = Number(data.stockvalue);
                    if (stockEl) stockEl.textContent = formatCurrency(stockValueRaw, currency);
                    if (dohEl) dohEl.textContent = formatDays(data.daysohand);
                    if (Number.isFinite(stockValueRaw)) {
                        const monthly = stockValueRaw * monthlyRate;
                        const annual = stockValueRaw * (Number.isFinite(annualRate) ? annualRate / 100 : 0);
                        if (monthlyEl) monthlyEl.textContent = formatCurrency(monthly, currency);
                        if (annualEl) annualEl.textContent = formatCurrency(annual, currency);
                    }
                }
            }
            document.dispatchEvent(new CustomEvent("ig:settingsChanged", { detail: { ...window.igState.settings } }));
        };

        syncSettingsInputs(window.igState.settings);
        applySettings(window.igState.settings);

        const settingsSaveBtn = document.getElementById("ig-settings-save");
        if (settingsSaveBtn) {
            settingsSaveBtn.addEventListener("click", () => {
                const rateInput = document.getElementById("ig-settings-carrying-rate");
                const riskInput = document.getElementById("ig-settings-risk-threshold");
                const currencySelect = document.getElementById("ig-settings-currency");
                const nextSettings = {
                    annualCarryingRate: Number(rateInput?.value),
                    riskThresholdDays: Number(riskInput?.value),
                    currency: currencySelect?.value || "USD"
                };
                const savedSettings = settingsApi?.saveSettings
                    ? settingsApi.saveSettings(nextSettings)
                    : nextSettings;
                syncSettingsInputs(savedSettings);
                applySettings(savedSettings);
                if (window.bootstrap?.Modal) {
                    const modalEl = document.getElementById("ig-settings-modal");
                    if (modalEl) window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                }
            });
        }

        const execSummaryGrid = document.getElementById("ig-exec-summary-grid");
        if (execSummaryGrid) {
            execSummaryGrid.addEventListener("click", (event) => {
                const actionCard = event.target.closest("[data-ig-action='open-settings']");
                if (!actionCard) return;
                if (settingsApi?.openModal) settingsApi.openModal();
            });
        }

        applyInventoryGovFilters();
        formatNumberCells(window.igState.settings.currency);
        updateExceptionCount();
        refreshKpis();

        if (rowsPerPageSelect) {
            rowsPerPageSelect.addEventListener("change", () => {
                window.igPaging.pageSize = Number(rowsPerPageSelect.value) || 100;
                window.igPaging.pageIndex = 0;
                applyPagination();
            });
        }
        if (pagePrevBtn) {
            pagePrevBtn.addEventListener("click", () => {
                window.igPaging.pageIndex = Math.max(0, window.igPaging.pageIndex - 1);
                applyPagination();
            });
        }
        if (pageNextBtn) {
            pageNextBtn.addEventListener("click", () => {
                window.igPaging.pageIndex += 1;
                applyPagination();
            });
        }

        const columnStorageKey = "inventoryGov.columns.v1";
        window.igColumnVisibility = {
            status: true,
            lotNo: true,
            productName: true,
            distributor: true,
            stockValue: true,
            qtyOnHand: true,
            daysToExpiry: true,
            riskReason: true,
            recommendedAction: true,
            owner: true,
            daysOnHand: true,
            avgSales: true
        };

        const columnChooserBtn = document.getElementById("ig-column-chooser-btn");
        const columnChooserPopover = document.getElementById("ig-column-chooser-popover");
        const columnChooserReset = document.getElementById("ig-column-chooser-reset");

        const applyColumnVisibility = () => {
            Object.keys(window.igColumnVisibility).forEach((key) => {
                const visible = window.igColumnVisibility[key];
                document.querySelectorAll(`#ig-exception-table [data-col="${key}"]`).forEach((cell) => {
                    cell.classList.toggle("d-none", !visible);
                });
            });
        };

        const syncColumnCheckboxes = () => {
            if (!columnChooserPopover) return;
            columnChooserPopover.querySelectorAll('input[type="checkbox"][data-col-key]').forEach((checkbox) => {
                const key = checkbox.getAttribute("data-col-key");
                if (!key) return;
                checkbox.checked = window.igColumnVisibility[key] !== false;
            });
        };

        const loadColumnPrefs = () => {
            try {
                const saved = localStorage.getItem(columnStorageKey);
                if (!saved) return;
                const parsed = JSON.parse(saved);
                if (!parsed || typeof parsed !== "object") return;
                Object.keys(window.igColumnVisibility).forEach((key) => {
                    if (typeof parsed[key] === "boolean") {
                        window.igColumnVisibility[key] = parsed[key];
                    }
                });
            } catch {
                // ignore storage errors
            }
        };

        const persistColumnPrefs = () => {
            try {
                localStorage.setItem(columnStorageKey, JSON.stringify(window.igColumnVisibility));
            } catch {
                // ignore storage errors
            }
        };

        loadColumnPrefs();
        applyColumnVisibility();
        syncColumnCheckboxes();

        if (columnChooserBtn && columnChooserPopover) {
            columnChooserBtn.addEventListener("click", (event) => {
                event.stopPropagation();
                columnChooserPopover.classList.toggle("d-none");
            });
        }

        if (columnChooserPopover) {
            columnChooserPopover.addEventListener("click", (event) => {
                event.stopPropagation();
            });
            columnChooserPopover.querySelectorAll('input[type="checkbox"][data-col-key]').forEach((checkbox) => {
                checkbox.addEventListener("change", () => {
                    const key = checkbox.getAttribute("data-col-key");
                    if (!key) return;
                    window.igColumnVisibility[key] = checkbox.checked;
                    applyColumnVisibility();
                    persistColumnPrefs();
                });
            });
        }

        if (columnChooserReset) {
            columnChooserReset.addEventListener("click", () => {
                Object.keys(window.igColumnVisibility).forEach((key) => {
                    window.igColumnVisibility[key] = true;
                });
                applyColumnVisibility();
                syncColumnCheckboxes();
                try {
                    localStorage.removeItem(columnStorageKey);
                } catch {
                    // ignore storage errors
                }
            });
        }

        document.addEventListener("click", () => {
            if (columnChooserPopover && !columnChooserPopover.classList.contains("d-none")) {
                columnChooserPopover.classList.add("d-none");
            }
        });

        const closeAllRowMenus = () => {
            document.querySelectorAll(".ig-actions-menu:not(.d-none)").forEach((menu) => {
                menu.classList.add("d-none");
                menu.closest(".ig-actions-wrap")?.classList.remove("ig-open-up");
            });
        };

        const exceptionTable = document.getElementById("ig-exception-table");
        if (exceptionTable) {
            exceptionTable.addEventListener("click", (event) => {
                const actionButton = event.target.closest(".ig-kebab");
                const actionMenu = event.target.closest(".ig-actions-menu");

                if (actionButton) {
                    event.preventDefault();
                    event.stopPropagation();
                    const wrap = actionButton.closest(".ig-actions-wrap");
                    const menu = wrap?.querySelector(".ig-actions-menu");
                    if (!menu) return;
                    const isOpen = !menu.classList.contains("d-none");
                    closeAllRowMenus();
                    menu.classList.toggle("d-none", isOpen);
                    if (!isOpen && wrap) {
                        const rect = menu.getBoundingClientRect();
                        const viewportBottom = window.innerHeight || document.documentElement.clientHeight;
                        if (rect.bottom > viewportBottom - 8) {
                            wrap.classList.add("ig-open-up");
                        } else {
                            wrap.classList.remove("ig-open-up");
                        }
                    }
                    return;
                }

                if (actionMenu) {
                    event.preventDefault();
                    event.stopPropagation();
                    closeAllRowMenus();
                }
            }, true);
        }

        document.addEventListener("click", () => {
            closeAllRowMenus();
        });

        const drawerModal = document.getElementById("ig-detail-modal");
        const drawer = document.getElementById("ig-detail-drawer");
        const drawerCloseButtons = [
            document.getElementById("ig-drawer-close"),
            document.getElementById("ig-drawer-cancel")
        ].filter(Boolean);
        const drawerSaveButton = document.getElementById("ig-drawer-save");
        const planNoteInput = document.getElementById("ig-plan-note");
        const toastEl = document.getElementById("ig-toast");
        const drawerLotNo = document.getElementById("ig-drawer-lotno");
        const drawerStatus = document.getElementById("ig-drawer-status");
        const drawerProduct = document.getElementById("ig-drawer-product");
        const drawerMeta = document.getElementById("ig-drawer-meta");
        const drawerStockValue = drawer ? drawer.querySelector('[data-ig-field="stockvalue"]') : null;
        const drawerDaysOnHand = drawer ? drawer.querySelector('[data-ig-field="daysohand"]') : null;
        const monthlyCarryingEl = document.getElementById("ig-monthly-carrying-cost");
        const annualizedHoldingEl = document.getElementById("ig-annualized-holding-cost");
        const rows = Array.from(document.querySelectorAll("#ig-exception-tbody tr"));
        window.igSelectedExceptionId = null;

        const setDrawerValue = (el, value) => {
            if (!el) return;
            el.textContent = value || "--";
        };

        const clearSelection = () => {
            rows.forEach((row) => row.classList.remove("table-active"));
            window.igSelectedExceptionId = null;
        };

        const getDrawerModalInstance = () => {
            if (!drawerModal || !window.bootstrap?.Modal) return null;
            return window.bootstrap.Modal.getOrCreateInstance(drawerModal);
        };

        const closeDrawer = () => {
            const instance = getDrawerModalInstance();
            if (instance) {
                instance.hide();
            } else {
                clearSelection();
            }
        };

        rows.forEach((row) => {
            row.addEventListener("click", () => {
                const data = row.dataset;
                rows.forEach((r) => r.classList.remove("table-active"));
                row.classList.add("table-active");
                window.igSelectedExceptionId = data.exId || null;

                const formatCurrency = window.igFormatCurrency ?? ((value, currency) => value ?? "--");
                const formatDays = window.igFormatDays ?? ((value) => value ?? "--");
                const settings = window.igState?.settings ?? { annualCarryingRate: 24, currency: "USD" };
                const currency = settings.currency || "USD";
                const annualRate = Number(settings.annualCarryingRate);
                const monthlyRate = Number.isFinite(annualRate) ? (annualRate / 12) / 100 : 0;

                setDrawerValue(drawerLotNo, data.lotno?.toUpperCase());
                setDrawerValue(drawerStatus, data.status);
                setDrawerValue(drawerProduct, data.product);
                setDrawerValue(drawerMeta, `Manufacturer • ${data.country || "--"} • ${data.distributor || "--"}`);
                setDrawerValue(drawerStockValue, formatCurrency(data.stockvalue, currency));
                setDrawerValue(drawerDaysOnHand, formatDays(data.daysohand));
                const stockValueRaw = Number(data.stockvalue);
                const currencyFormatter = window.igFormatCurrency ?? ((value, currency) => new Intl.NumberFormat(undefined, { style: "currency", currency, maximumFractionDigits: 0 }).format(value));
                if (Number.isFinite(stockValueRaw)) {
                    const monthly = stockValueRaw * monthlyRate;
                    const annual = stockValueRaw * (Number.isFinite(annualRate) ? annualRate / 100 : 0);
                    setDrawerValue(monthlyCarryingEl, currencyFormatter(monthly, currency));
                    setDrawerValue(annualizedHoldingEl, currencyFormatter(annual, currency));
                } else {
                    setDrawerValue(monthlyCarryingEl, "--");
                    setDrawerValue(annualizedHoldingEl, "--");
                }

                const instance = getDrawerModalInstance();
                if (instance) {
                    instance.show();
                }
            });
        });

        drawerCloseButtons.forEach((button) => {
            button.addEventListener("click", closeDrawer);
        });

        if (drawerModal) {
            drawerModal.addEventListener("hidden.bs.modal", () => {
                clearSelection();
            });
        }

        if (drawerSaveButton) {
            const showToast = (type, message) => {
                if (!toastEl) return;
                toastEl.classList.remove("d-none", "alert-success", "alert-danger");
                toastEl.classList.add(type === "success" ? "alert-success" : "alert-danger");
                toastEl.textContent = message;
                clearTimeout(showToast._timeoutId);
                showToast._timeoutId = setTimeout(() => {
                    toastEl.classList.add("d-none");
                }, 3000);
            };

            const buildSavePlanPayload = () => {
                const selectedRow = window.igSelectedExceptionId
                    ? document.querySelector(`#ig-exception-tbody tr[data-ex-id="${window.igSelectedExceptionId}"]`)
                    : null;
                const data = selectedRow?.dataset;
                const activeMonth = monthModel.find((month) => month.active);
                const settings = window.igState?.settings ?? { annualCarryingRate: 24 };
                const annualRate = Number(settings.annualCarryingRate);
                const carryingRateMonthly = Number.isFinite(annualRate) ? (annualRate / 12) / 100 : 0;
                const months = monthModel.map((month) => ({
                    month: month.key,
                    value: Number(month.value),
                    source: month.active ? "ACTIVE" : "AUTO"
                }));
                return {
                    exceptionId: data?.exId ?? "",
                    lotNo: data?.lotno?.toUpperCase() ?? "",
                    status: data?.status ?? "",
                    stockValue: Number(data?.stockvalue),
                    carryingRateMonthly,
                    activeMonth: activeMonth?.key ?? "",
                    activeValue: Number(activeMonth?.value),
                    months,
                    note: planNoteInput?.value?.trim() || undefined,
                    savedAtClient: new Date().toISOString()
                };
            };

            const validateSavePlanPayload = (payload) => {
                const errors = [];
                if (!payload.exceptionId) errors.push("Missing exceptionId.");
                if (!payload.lotNo) errors.push("Missing lot number.");
                if (!Array.isArray(payload.months) || payload.months.length < 1) errors.push("Months are required.");
                const activeMonths = payload.months.filter((month) => month.source === "ACTIVE");
                if (activeMonths.length !== 1) errors.push("Exactly one month must be Active.");
                if (!payload.activeMonth) errors.push("Active month is required.");
                if (!Number.isFinite(payload.activeValue) || payload.activeValue < 0) errors.push("Active value must be a non-negative number.");
                payload.months.forEach((month) => {
                    if (!Number.isFinite(month.value) || month.value < 0) {
                        errors.push(`Invalid value for ${month.month}.`);
                    }
                });
                if (!payload.months.some((month) => month.month === payload.activeMonth)) {
                    errors.push("Active month must exist in months list.");
                }
                return { ok: errors.length === 0, errors };
            };

            const onSavePlan = (payload) => {
                if (window.inventoryGovernanceService?.savePlan) {
                    return window.inventoryGovernanceService.savePlan(payload);
                }
                console.log(payload);
                return Promise.resolve({ ok: true, planId: "mock-fallback", savedAt: new Date().toISOString() });
            };

            drawerSaveButton.addEventListener("click", () => {
                const payload = buildSavePlanPayload();
                const validation = validateSavePlanPayload(payload);
                if (!validation.ok) {
                    showToast("error", validation.errors.join(" "));
                    return;
                }
                drawerSaveButton.disabled = true;
                onSavePlan(payload)
                    .then(() => {
                        showToast("success", "Plan saved (stub).");
                    })
                    .catch(() => {
                        showToast("error", "Failed to save plan.");
                    })
                    .finally(() => {
                        drawerSaveButton.disabled = false;
                    });
            });
        }

        const buildMonthModel = (startDate, count) => {
            const months = [];
            const base = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
            for (let i = 0; i < count; i += 1) {
                const date = new Date(base.getFullYear(), base.getMonth() + i, 1);
                const label = date.toLocaleString(undefined, { month: "short", year: "numeric" });
                months.push({
                    key: `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`,
                    label,
                    value: 48,
                    source: i === 0 ? "ACTIVE" : "AUTO",
                    active: i === 0
                });
            }
            return months;
        };

        const monthGrid = document.getElementById("ig-month-grid");
        let monthModel = buildMonthModel(new Date(2026, 0, 1), 12);

        const averageRecent = (values) => {
            if (!values.length) return 0;
            const sum = values.reduce((acc, value) => acc + value, 0);
            return Math.round(sum / values.length);
        };

        const onActiveValueChange = (newValue) => {
            const activeIndex = monthModel.findIndex((month) => month.active);
            if (activeIndex === -1) return;
            const parsed = Number(newValue);
            if (!Number.isFinite(parsed)) return;
            monthModel[activeIndex].value = parsed;
            monthModel[activeIndex].source = "ACTIVE";

            for (let i = activeIndex + 1; i < monthModel.length; i += 1) {
                const start = Math.max(0, i - 2);
                const windowValues = monthModel.slice(start, i + 1).map((month) => month.value);
                monthModel[i].value = averageRecent(windowValues);
                monthModel[i].source = "AUTO";
            }
        };

        const renderMonthGrid = () => {
            if (!monthGrid) return;
            monthGrid.innerHTML = monthModel.map((month) => {
                const badgeClass = month.active ? "text-primary" : "text-muted";
                const borderClass = month.active ? "border-primary bg-light" : "border";
                const valueMarkup = month.active
                    ? `<input type="number" class="form-control form-control-sm text-center" style="max-width:90px" data-testid="ig-active-month-input" value="${month.value}" />`
                    : `<div class="fw-semibold">${month.value} DoH</div>`;
                return `
                    <div class="ig-month-tile">
                        <div class="card h-100 ${borderClass} ig-month-cell" data-month-key="${month.key}">
                            <div class="card-body p-2">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="fw-semibold small">${month.label}</div>
                                    <span class="small ${badgeClass}">${month.active ? "Active" : "Auto"}</span>
                                </div>
                                <div class="text-muted small">${valueMarkup}</div>
                            </div>
                        </div>
                    </div>
                `;
            }).join("");
        };

        const setActiveMonth = (key) => {
            monthModel = monthModel.map((month) => ({
                ...month,
                active: month.key === key
            }));
            renderMonthGrid();
        };

        if (monthGrid) {
            monthGrid.addEventListener("click", (event) => {
                const target = event.target.closest("[data-month-key]");
                if (!target) return;
                if (event.target.matches('[data-testid="ig-active-month-input"]')) return;
                setActiveMonth(target.getAttribute("data-month-key"));
            });
            monthGrid.addEventListener("input", (event) => {
                if (!event.target.matches('[data-testid="ig-active-month-input"]')) return;
                event.stopPropagation();
                onActiveValueChange(event.target.value);
                renderMonthGrid();
            });
        }

        renderMonthGrid();

        const modalConfig = {
            "assign-owner": { id: "ig-modal-assign-owner", fields: ["ig-assign-owner-input"] },
            "create-action": { id: "ig-modal-create-action", fields: ["ig-create-action-title", "ig-create-action-date"] },
            "snooze": { id: "ig-modal-snooze", fields: ["ig-snooze-date"] },
            "add-note": { id: "ig-modal-add-note", fields: ["ig-add-note-text"] }
        };

        const openModal = (action) => {
            const config = modalConfig[action];
            if (!config) return null;
            const modalEl = document.getElementById(config.id);
            if (!modalEl || !window.bootstrap?.Modal) return null;
            const instance = window.bootstrap.Modal.getOrCreateInstance(modalEl);
            instance.show();
            return { config, modalEl, instance };
        };

        const buildValues = (fieldIds) => {
            const values = {};
            fieldIds.forEach((fieldId) => {
                const el = document.getElementById(fieldId);
                if (!el) return;
                values[fieldId] = el.value;
            });
            return values;
        };

        document.querySelectorAll(".ig-actions-menu .dropdown-item").forEach((item) => {
            item.addEventListener("click", (event) => {
                event.stopPropagation();
                const action = item.getAttribute("data-action");
                const menu = item.closest(".ig-actions-menu");
                const exceptionId = menu?.getAttribute("data-ex-id")
                    || item.closest("tr")?.getAttribute("data-ex-id")
                    || null;
                closeAllRowMenus();

                const modalState = openModal(action);
                if (!modalState) return;

                const { config, modalEl, instance } = modalState;
                const saveBtn = modalEl.querySelector("[data-ig-save]");
                if (!saveBtn) return;
                const handler = () => {
                    const values = buildValues(config.fields);
                    console.log({ action, exceptionId, values });
                    instance.hide();
                };
                saveBtn.addEventListener("click", handler, { once: true });
            });
        });
    });
</script>

