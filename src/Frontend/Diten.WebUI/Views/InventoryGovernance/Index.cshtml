        };

        const updateExceptionCount = () => {
            const rows = getFilteredRows();
            const countEl = document.getElementById("ig-exception-count");
            if (countEl) {
                countEl.textContent = `${rows.length} total exceptions`;
            }
        };

        const applyPagination = () => {
            const rows = Array.from(document.querySelectorAll("#ig-exception-table tbody tr"));
            const eligibleRows = getFilteredRows();
            const pageSize = window.igPaging.pageSize;
            const totalEligible = eligibleRows.length;
            const totalPages = Math.max(1, Math.ceil(totalEligible / pageSize));
            window.igPaging.pageIndex = Math.max(0, Math.min(window.igPaging.pageIndex, totalPages - 1));

            const start = window.igPaging.pageIndex * pageSize;
            const end = start + pageSize;
            eligibleRows.forEach((row, index) => {
                const isInPage = index >= start && index < end;
                row.classList.toggle("ig-page-hidden", !isInPage);
            });
            rows.forEach((row) => updateRowVisibility(row));

            if (pageStatus) {
                pageStatus.textContent = `Page ${window.igPaging.pageIndex + 1} of ${totalPages}`;
            }
            if (pagePrevBtn) pagePrevBtn.disabled = window.igPaging.pageIndex === 0;
            if (pageNextBtn) pageNextBtn.disabled = window.igPaging.pageIndex >= totalPages - 1;
