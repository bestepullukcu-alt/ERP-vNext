@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12 mb-4">
        <div class="card card-shadow border-0">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h4 class="card-title mb-1">Diten Enterprise Platform</h4>
                        <p class="text-muted mb-0 lead small">A modern .NET 8 tiered architecture with CQRS and MongoDB.
                        </p>
                    </div>
                    <div class="bg-label-primary p-2 rounded">
                        <i class="bi bi-rocket-takeoff fs-2 text-primary"></i>
                    </div>
                </div>

                <div class="alert alert-outline-primary d-flex align-items-center mb-4" role="alert">
                    <span class="badge badge-center rounded-pill bg-primary me-3"><i
                            class="bi bi-info-circle"></i></span>
                    <div class="d-flex flex-column">
                        <span class="fw-semibold">Backend Bağlantı Durumu</span>
                        <div class="d-flex align-items-center">
                            <span id="status-dot" class="status-dot me-2"></span>
                            <span id="status-text">Bağlantı kontrol ediliyor...</span>
                        </div>
                    </div>
                    <button id="ping-btn" class="btn btn-primary ms-auto">Sistemi Sorgula</button>
                </div>

                <div class="row g-4 mt-2">
                    <div class="col-md-3">
                        <div class="p-3 border rounded text-center h-100">
                            <i class="bi bi-layers fs-3 text-primary mb-2"></i>
                            <h6 class="mb-1">Tiered Architecture</h6>
                            <small class="text-muted d-block">Domain, App, Infra, Persistence</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 border rounded text-center h-100">
                            <i class="bi bi-cpu fs-3 text-info mb-2"></i>
                            <h6 class="mb-1">CQRS & MediatR</h6>
                            <small class="text-muted d-block">Business Logic separation</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 border rounded text-center h-100">
                            <i class="bi bi-database fs-3 text-warning mb-2"></i>
                            <h6 class="mb-1">MongoDB</h6>
                            <small class="text-muted d-block">NoSQL Repository Pattern</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 border rounded text-center h-100">
                            <i class="bi bi-shield-check fs-3 text-success mb-2"></i>
                            <h6 class="mb-1">RESTful V1</h6>
                            <small class="text-muted d-block">API Versioning & Decoupling</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/assets/js/pages/systemStatus.js"></script>
}

<style>
    .bg-label-primary {
        background-color: rgba(105, 108, 255, 0.16) !important;
        color: #696cff !important;
    }

    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #dee2e6;
        display: inline-block;
    }

    .status-dot.online {
        background-color: #71dd37;
        box-shadow: 0 0 8px #71dd37;
    }

    .status-dot.offline {
        background-color: #ff3e1d;
        box-shadow: 0 0 8px #ff3e1d;
    }

    .alert-outline-primary {
        border: 1px solid #696cff;
        background: transparent;
        color: #696cff;
    }
</style>
