@{
    ViewData["Title"] = "Task Report";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row g-6 mb-6">
        <div class="col-sm-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="content-left">
                            <span class="text-heading">Total Tasks</span>
                            <div class="d-flex align-items-center my-1">
                                <h4 class="mb-0 me-2" id="kpi-total-tasks">0</h4>
                            </div>
                            <small class="mb-0">All entries</small>
                        </div>
                        <div class="avatar">
                            <span class="avatar-initial rounded bg-label-primary">
                                <i class="bx bx-list-ul bx-lg"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="content-left">
                            <span class="text-heading">Completed</span>
                            <div class="d-flex align-items-center my-1">
                                <h4 class="mb-0 me-2 text-success" id="kpi-completed-tasks">0</h4>
                            </div>
                            <small class="mb-0">Done tasks</small>
                        </div>
                        <div class="avatar">
                            <span class="avatar-initial rounded bg-label-success">
                                <i class="bx bx-check-circle bx-lg"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="content-left">
                            <span class="text-heading">In Progress</span>
                            <div class="d-flex align-items-center my-1">
                                <h4 class="mb-0 me-2 text-info" id="kpi-inprogress-tasks">0</h4>
                            </div>
                            <small class="mb-0">Ongoing work</small>
                        </div>
                        <div class="avatar">
                            <span class="avatar-initial rounded bg-label-info">
                                <i class="bx bx-sync bx-lg"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="content-left">
                            <span class="text-heading">Completion Rate</span>
                            <div class="d-flex align-items-center my-1">
                                <h4 class="mb-0 me-2" id="kpi-completion-rate">0%</h4>
                            </div>
                            <small class="mb-0">Efficiency</small>
                        </div>
                        <div class="avatar">
                            <span class="avatar-initial rounded bg-label-warning">
                                <i class="bx bx-trending-up bx-lg"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-6 mb-6">
        <div class="col-md-12 col-xxl-8">
            <div class="card">
                <div class="card-header border-bottom">
                    <h5 class="card-title mb-0">Task Report</h5>
                </div>
                <div class="card-datatable table-responsive">
                    <table class="table table-hover workflow-table" id="tasksTable">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Task Name</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-12 col-xxl-4">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title m-0 me-2">Task Distribution</h5>
                </div>
                <div class="card-body">
                    <div id="taskStatusChart"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Task Details Modal -->
<div class="modal fade" id="taskDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTaskTitle">Task Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold">Title</label>
                        <p id="view-task-title" class="mb-0"></p>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Description</label>
                        <p id="view-task-description" class="mb-0"></p>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold">Status</label>
                        <div id="view-task-status"></div>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold">Created Date</label>
                        <p id="view-task-date" class="mb-0"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Status Modal -->
<div class="modal fade" id="editStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-task-id" />
                <div class="col-12">
                    <label class="form-label">Status</label>
                    <select id="edit-task-status" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btn-save-status">Save changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this task?</p>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="delete-task-id" />
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btn-confirm-delete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/task-reports/task-report.js"></script>
}
