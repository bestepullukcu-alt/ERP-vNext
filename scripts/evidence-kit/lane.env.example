# CANDIDATE — NOT ACTIVE. MVP6 evidence kit v1.2, lane parameter file (proposal mvp6-evidence-kit-proposal-03).
# Copy to the lane workspace (never into the repository), fill in, then: set -a; . ./lane.env; set +a
# This file holds NO secrets. v1.1 (D4): secrets are generated by the lane supervisor (k00_supervisor.py), held in its
# memory only, passed to children by environment, and cleared at shutdown. No file ever holds a secret value;
# env files under $EK_WORK carry placeholders @@LANE:<group>@@ only.

# --- identity of the lane -------------------------------------------------------------------------------
EK_LANE_ID=mvp6-example-lane-01            # work-package / evidence directory name
EK_DB_SUFFIX=ExampleLane01                 # DB-010: ONE fixed suffix per lane (letters+digits, ends in 2 digits; never a GUID)
EK_SLOT=7                                  # 1..9 → port block 5000+100*slot, Mongo 30994+1000*slot (k03_ports.py)

# --- repository baseline (read-only) ---------------------------------------------------------------------
EK_REPO=/Users/natig/Projects/ERP-vNext-recovery
EK_EXPECTED_HEAD=4a8d4d4b339528a88e6220fb8402e5a2c771136c
EK_EXPECTED_BRANCH=feature/mvp6-logistics
EK_OVERLAYS=./overlays.tsv                 # ordered overlay list (see templates/overlays.tsv)

# --- workspace and evidence -----------------------------------------------------------------------------
EK_WORK=/private/tmp/ek-mvp6-example-lane-01   # disposable; created by k01, removed by k11. Must be outside EK_REPO.
EK_EVIDENCE=/Users/natig/Projects/ERP-vNext-recovery/docs/records/audits/2026-09/mvp6-example-lane-01/evidence

# --- runtime --------------------------------------------------------------------------------------------
EK_DOTNET=/Users/natig/.dotnet/dotnet
EK_EXPECTED_SDK=8.0.417
EK_EXPECTED_RUNTIME=8.0.23
EK_ASPNET_ENV=Development                  # Development pulls user-secrets; k04 resolves them (values never printed)
EK_SERVICES="auth platform mdm supplychain gateway web"   # subset of service-map.tsv, in start order
EK_RESTORE_MODE=online                     # online | offline-cache (offline adds --ignore-failed-sources -p:NuGetAudit=false, recorded)

# --- fixture --------------------------------------------------------------------------------------------
EK_ACTORS=./actors.tsv                     # actor label → seeded email/tenant/expected LE (see templates/actors.tsv)
EK_OVERRIDES=./overrides.tsv               # lane security switches (see templates/overrides.tsv); v1.1 rejects literal secret values here

# --- v1.1 supervisor and secrets (D2/D4) ----------------------------------------------------------------
EK_SOCK="${TMPDIR%/}/ek-mvp6-example-lane-01.sock"   # v1.2 F7: per-user $TMPDIR (0700), never shared /tmp or /private/tmp;
                                                     # MUST be outside EK_WORK; k00 refuses a group/world-writable folder
EK_HARNESS_DIR=/Users/natig/Projects/ERP-vNext-recovery/docs/records/audits/2026-09/mvp6-example-lane-01/lane-scripts
                                                     # v1.2 F2: the only folder whose .js/.py files the supervisor may run
                                                     # (task `harness`, actor passwords only); leave empty if unused
EK_ROTATE="jwt mfa auth-platform platform-mdm-active svcid"   # secret groups generated once per lane (service-map.tsv)
