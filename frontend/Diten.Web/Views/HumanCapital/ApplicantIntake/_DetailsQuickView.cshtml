@using Diten.Web.Views.HumanCapital.ApplicantIntake
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ApplicantIntakeIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasApplicantIntakeDetails" aria-labelledby="applicantIntakeDetailsTitle">
    <div class="offcanvas-header border-bottom">
        <h5 id="applicantIntakeDetailsTitle" class="offcanvas-title">@Localizer["DetailsTitle"]</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Close"].Value"></button>
    </div>
    <div class="offcanvas-body">
        <div id="applicantIntakeDetailsEmpty" class="text-muted small">@Localizer["SelectRecord"]</div>
        <dl id="applicantIntakeDetailsList" class="row g-3 d-none">
            <dt class="col-5">@Localizer["Code"]</dt>
            <dd class="col-7" data-field="code"></dd>
            <dt class="col-5">@Localizer["DisplayName"]</dt>
            <dd class="col-7 text-break" data-field="displayName"></dd>
            <dt class="col-5">@Localizer["IntakeState"]</dt>
            <dd class="col-7" data-field="intakeState"></dd>
            <dt class="col-5">@Localizer["SourceChannelState"]</dt>
            <dd class="col-7" data-field="sourceChannelState"></dd>
            <dt class="col-5">@Localizer["ConsentPreconditionState"]</dt>
            <dd class="col-7" data-field="consentPreconditionState"></dd>
            <dt class="col-5">@Localizer["DataMinimizationState"]</dt>
            <dd class="col-7" data-field="dataMinimizationState"></dd>
            <dt class="col-5">@Localizer["DuplicateHandlingState"]</dt>
            <dd class="col-7" data-field="duplicateHandlingState"></dd>
            <dt class="col-5">@Localizer["RetentionPolicyState"]</dt>
            <dd class="col-7" data-field="retentionPolicyState"></dd>
            <dt class="col-5">@Localizer["EvidencePolicyState"]</dt>
            <dd class="col-7" data-field="evidencePolicyState"></dd>
            <dt class="col-5">@Localizer["ApplicantIdentityBoundaryState"]</dt>
            <dd class="col-7" data-field="applicantIdentityBoundaryState"></dd>
            <dt class="col-5">@Localizer["PublicUxBoundaryState"]</dt>
            <dd class="col-7" data-field="publicUxBoundaryState"></dd>
            <dt class="col-5">@Localizer["DependencyStates"]</dt>
            <dd class="col-7 text-break" data-field="dependencyStates"></dd>
            <dt class="col-5">@Localizer["SourceContractVersion"]</dt>
            <dd class="col-7" data-field="sourceContractVersion"></dd>
            <dt class="col-5">@Localizer["ApplicantIntakeVersion"]</dt>
            <dd class="col-7" data-field="applicantIntakeVersion"></dd>
            <dt class="col-5">@Localizer["LastEvaluatedAt"]</dt>
            <dd class="col-7" data-field="lastEvaluatedAt"></dd>
            <dt class="col-5">@Localizer["DeferredReason"]</dt>
            <dd class="col-7" data-field="deferredReason"></dd>
        </dl>
        <div id="applicantIntakeAuditBlock" class="border-top mt-4 pt-4 d-none">
            <h6 class="mb-3">@Localizer["AuditMetadata"]</h6>
            <dl class="row g-3 mb-0">
                <dt class="col-5">@Localizer["RetentionPolicyState"]</dt>
                <dd class="col-7" data-audit-field="retentionPolicyState"></dd>
                <dt class="col-5">@Localizer["EvidencePolicyState"]</dt>
                <dd class="col-7" data-audit-field="evidencePolicyState"></dd>
                <dt class="col-5">@Localizer["LastEvaluatedAt"]</dt>
                <dd class="col-7" data-audit-field="lastEvaluatedAt"></dd>
            </dl>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="button" class="btn btn-label-secondary" data-applicant-intake-action="evaluate" disabled>
                <i class="bx bx-check-shield me-1"></i>@Localizer["EvaluateDisabled"]
            </button>
            <button type="button" class="btn btn-label-secondary" data-applicant-intake-action="manage" disabled>
                <i class="bx bx-edit-alt me-1"></i>@Localizer["ManageDisabled"]
            </button>
        </div>
    </div>
</div>
