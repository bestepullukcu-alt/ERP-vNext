@using Diten.Web.Views.HumanCapital.ApplicantIntake
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ApplicantIntakeIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<script id="applicant-intake-l10n" type="application/json">
    @Json.Serialize(new
    {
        Actions = Localizer["Actions"].Value,
        AuditMetadata = Localizer["AuditMetadata"].Value,
        ColumnVisibility = SharedLocalizer["ColumnVisibility"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
        EvaluateDisabled = Localizer["EvaluateDisabled"].Value,
        Loading = SharedLocalizer["Loading"].Value,
        ManageDisabled = Localizer["ManageDisabled"].Value,
        NotAvailable = SharedLocalizer["NotAvailable"].Value,
        ViewDetails = SharedLocalizer["ViewDetails"].Value,
        Code = Localizer["Code"].Value,
        DisplayName = Localizer["DisplayName"].Value,
        IntakeState = Localizer["IntakeState"].Value,
        SourceChannelState = Localizer["SourceChannelState"].Value,
        ConsentPreconditionState = Localizer["ConsentPreconditionState"].Value,
        DataMinimizationState = Localizer["DataMinimizationState"].Value,
        DuplicateHandlingState = Localizer["DuplicateHandlingState"].Value,
        SourceContractVersion = Localizer["SourceContractVersion"].Value,
        LastEvaluatedAt = Localizer["LastEvaluatedAt"].Value
    })
</script>
