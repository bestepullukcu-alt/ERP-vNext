@using Diten.Web.Views.HumanCapital.SelfService
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SelfServiceIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["SelfServiceTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.self-service.manage");
    var canEvaluate = Perms.Has("hcm.self-service.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["SelfServiceTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="self-service-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-self-service" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/SelfService/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/SelfService/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/SelfService/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/SelfService/index.js" asp-append-version="true"></script>
}
