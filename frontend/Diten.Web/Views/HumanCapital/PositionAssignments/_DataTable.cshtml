@using Diten.Web.Views.HumanCapital.PositionAssignments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PositionAssignmentsIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-position-assignments" data-dt-standard="v2" class="datatables-position-assignments table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["EmployeeProjectionId"]</th>
                    <th>@Localizer["OrganizationUnitId"]</th>
                    <th>@Localizer["PositionId"]</th>
                    <th>@Localizer["AssignmentState"]</th>
                    <th>@Localizer["ReferenceValidationState"]</th>
                    <th>@Localizer["SensitiveAccessDecisionState"]</th>
                    <th>@Localizer["EffectiveFrom"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
