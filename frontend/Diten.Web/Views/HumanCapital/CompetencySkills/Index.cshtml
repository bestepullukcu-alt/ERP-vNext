@using Diten.Web.Views.HumanCapital.CompetencySkills
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CompetencySkillsIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["CompetencySkillsTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.competency-skills.manage");
    var canEvaluate = Perms.Has("hcm.competency-skills.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["CompetencySkillsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="competency-skills-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-competency-skills" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/CompetencySkills/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/CompetencySkills/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/CompetencySkills/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/CompetencySkills/index.js" asp-append-version="true"></script>
}
