@using Diten.Web.Views.HumanCapital.HeadcountBudget
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<HeadcountBudgetIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["HeadcountBudgetTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.headcount-budget.manage");
    var canEvaluate = Perms.Has("hcm.headcount-budget.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["HeadcountBudgetTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="headcount-budget-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-headcount-budget" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/HeadcountBudget/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/HeadcountBudget/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/HeadcountBudget/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/HeadcountBudget/index.js" asp-append-version="true"></script>
}
