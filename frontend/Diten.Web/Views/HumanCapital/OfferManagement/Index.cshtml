@using Diten.Web.Views.HumanCapital.OfferManagement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<OfferManagementIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["OfferManagementTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.offer-management.manage");
    var canEvaluate = Perms.Has("hcm.offer-management.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["OfferManagementTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="offer-management-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-offer-management" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/OfferManagement/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/OfferManagement/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/OfferManagement/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/OfferManagement/index.js" asp-append-version="true"></script>
}
