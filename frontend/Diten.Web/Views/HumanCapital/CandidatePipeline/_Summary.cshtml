@using Diten.Web.Views.HumanCapital.CandidatePipeline
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CandidatePipelineIndex> Localizer

<div class="row g-3 mb-3">
    <div class="col-xl-3 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="mb-1">@Localizer["TotalRecords"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["TotalRecordsDescription"]</p>
                    </div>
                    <span class="badge bg-label-primary" data-candidate-pipeline-summary="total">0</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="mb-1">@Localizer["ReadyRecords"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["ReadyRecordsDescription"]</p>
                    </div>
                    <span class="badge bg-label-success" data-candidate-pipeline-summary="ready">0</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="mb-1">@Localizer["DeferredRecords"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["DeferredRecordsDescription"]</p>
                    </div>
                    <span class="badge bg-label-info" data-candidate-pipeline-summary="deferred">0</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="mb-1">@Localizer["BlockedRecords"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["BlockedRecordsDescription"]</p>
                    </div>
                    <span class="badge bg-label-danger" data-candidate-pipeline-summary="blocked">0</span>
                </div>
            </div>
        </div>
    </div>
</div>
