@using Diten.Web.Views.HumanCapital.CandidatePipeline
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CandidatePipelineIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCandidatePipelineDetails" aria-labelledby="candidatePipelineDetailsTitle">
    <div class="offcanvas-header border-bottom">
        <h5 id="candidatePipelineDetailsTitle" class="offcanvas-title">@Localizer["DetailsTitle"]</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Close"].Value"></button>
    </div>
    <div class="offcanvas-body">
        <div id="candidatePipelineDetailsEmpty" class="text-muted small">@Localizer["SelectRecord"]</div>
        <dl id="candidatePipelineDetailsList" class="row g-3 d-none">
            <dt class="col-5">@Localizer["Code"]</dt>
            <dd class="col-7" data-field="code"></dd>
            <dt class="col-5">@Localizer["DisplayName"]</dt>
            <dd class="col-7 text-break" data-field="displayName"></dd>
            <dt class="col-5">@Localizer["PipelineReadinessState"]</dt>
            <dd class="col-7" data-field="pipelineReadinessState"></dd>
            <dt class="col-5">@Localizer["PipelineStageGovernanceState"]</dt>
            <dd class="col-7" data-field="pipelineStageGovernanceState"></dd>
            <dt class="col-5">@Localizer["InterviewSchedulingReadinessState"]</dt>
            <dd class="col-7" data-field="interviewSchedulingReadinessState"></dd>
            <dt class="col-5">@Localizer["InterviewerAssignmentReadinessState"]</dt>
            <dd class="col-7" data-field="interviewerAssignmentReadinessState"></dd>
            <dt class="col-5">@Localizer["EvaluationGovernanceState"]</dt>
            <dd class="col-7" data-field="evaluationGovernanceState"></dd>
            <dt class="col-5">@Localizer["CandidateCommunicationBoundaryState"]</dt>
            <dd class="col-7" data-field="candidateCommunicationBoundaryState"></dd>
            <dt class="col-5">@Localizer["ConsentPreconditionState"]</dt>
            <dd class="col-7" data-field="consentPreconditionState"></dd>
            <dt class="col-5">@Localizer["DataMinimizationState"]</dt>
            <dd class="col-7" data-field="dataMinimizationState"></dd>
            <dt class="col-5">@Localizer["RetentionPolicyState"]</dt>
            <dd class="col-7" data-field="retentionPolicyState"></dd>
            <dt class="col-5">@Localizer["EvidencePolicyState"]</dt>
            <dd class="col-7" data-field="evidencePolicyState"></dd>
            <dt class="col-5">@Localizer["CalendarDependencyState"]</dt>
            <dd class="col-7" data-field="calendarDependencyState"></dd>
            <dt class="col-5">@Localizer["NotificationDependencyState"]</dt>
            <dd class="col-7" data-field="notificationDependencyState"></dd>
            <dt class="col-5">@Localizer["DocumentDependencyState"]</dt>
            <dd class="col-7" data-field="documentDependencyState"></dd>
            <dt class="col-5">@Localizer["AutomatedDecisionBoundaryState"]</dt>
            <dd class="col-7" data-field="automatedDecisionBoundaryState"></dd>
            <dt class="col-5">@Localizer["DependencyStates"]</dt>
            <dd class="col-7 text-break" data-field="dependencyStates"></dd>
            <dt class="col-5">@Localizer["SourceContractVersion"]</dt>
            <dd class="col-7" data-field="sourceContractVersion"></dd>
            <dt class="col-5">@Localizer["PipelineReadinessVersion"]</dt>
            <dd class="col-7" data-field="pipelineReadinessVersion"></dd>
            <dt class="col-5">@Localizer["LastEvaluatedAt"]</dt>
            <dd class="col-7" data-field="lastEvaluatedAt"></dd>
            <dt class="col-5">@Localizer["DeferredReason"]</dt>
            <dd class="col-7" data-field="deferredReason"></dd>
        </dl>
        <div id="candidatePipelineAuditBlock" class="border-top mt-4 pt-4 d-none">
            <h6 class="mb-3">@Localizer["AuditMetadata"]</h6>
            <dl class="row g-3 mb-0">
                <dt class="col-5">@Localizer["RetentionPolicyState"]</dt>
                <dd class="col-7" data-audit-field="retentionPolicyState"></dd>
                <dt class="col-5">@Localizer["EvidencePolicyState"]</dt>
                <dd class="col-7" data-audit-field="evidencePolicyState"></dd>
                <dt class="col-5">@Localizer["LastEvaluatedAt"]</dt>
                <dd class="col-7" data-audit-field="lastEvaluatedAt"></dd>
            </dl>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="button" class="btn btn-label-secondary" data-candidate-pipeline-action="evaluate" disabled>
                <i class="bx bx-check-shield me-1"></i>@Localizer["EvaluateDisabled"]
            </button>
            <button type="button" class="btn btn-label-secondary" data-candidate-pipeline-action="manage" disabled>
                <i class="bx bx-edit-alt me-1"></i>@Localizer["ManageDisabled"]
            </button>
        </div>
    </div>
</div>
