@using Diten.Web.Views.HumanCapital.LearningTraining
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LearningTrainingIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["LearningTrainingTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.learning-training.manage");
    var canEvaluate = Perms.Has("hcm.learning-training.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["LearningTrainingTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="learning-training-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-learning-training" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/LearningTraining/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/LearningTraining/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/LearningTraining/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/LearningTraining/index.js" asp-append-version="true"></script>
}
