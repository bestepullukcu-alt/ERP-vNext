@using Diten.Web.Views.HumanCapital.HrKpiAnalytics
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<HrKpiAnalyticsIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["HrKpiAnalyticsTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.hr-kpi-analytics.manage");
    var canEvaluate = Perms.Has("hcm.hr-kpi-analytics.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["HrKpiAnalyticsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="hr-kpi-analytics-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-hr-kpi-analytics" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/HrKpiAnalytics/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/HrKpiAnalytics/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/HrKpiAnalytics/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/HrKpiAnalytics/index.js" asp-append-version="true"></script>
}
