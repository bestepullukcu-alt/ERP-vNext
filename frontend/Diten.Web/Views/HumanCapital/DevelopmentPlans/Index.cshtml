@using Diten.Web.Views.HumanCapital.DevelopmentPlans
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<DevelopmentPlansIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["DevelopmentPlansTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.development-plans.manage");
    var canEvaluate = Perms.Has("hcm.development-plans.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["DevelopmentPlansTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="development-plans-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-development-plans" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/DevelopmentPlans/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/DevelopmentPlans/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/DevelopmentPlans/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/DevelopmentPlans/index.js" asp-append-version="true"></script>
}
