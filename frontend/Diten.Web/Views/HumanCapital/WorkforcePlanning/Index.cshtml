@using Diten.Web.Views.HumanCapital.WorkforcePlanning
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WorkforcePlanningIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["WorkforcePlanningTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.workforce-planning.manage");
    var canEvaluate = Perms.Has("hcm.workforce-planning.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["WorkforcePlanningTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="workforce-planning-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-workforce-planning" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/WorkforcePlanning/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/WorkforcePlanning/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/WorkforcePlanning/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/WorkforcePlanning/index.js" asp-append-version="true"></script>
}
