@using Diten.Web.Views.HumanCapital.HrDocumentation
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<HrDocumentationIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["HrDocumentationTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.hr-documentation.manage");
    var canEvaluate = Perms.Has("hcm.hr-documentation.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["HrDocumentationTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="hr-documentation-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-hr-documentation" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/HrDocumentation/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/HrDocumentation/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/HrDocumentation/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/HrDocumentation/index.js" asp-append-version="true"></script>
}
