@using Diten.Web.Views.HumanCapital.HrCaseManagement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<HrCaseManagementIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["HrCaseManagementTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.hr-case-management.manage");
    var canEvaluate = Perms.Has("hcm.hr-case-management.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["HrCaseManagementTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="hr-case-management-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-hr-case-management" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/HrCaseManagement/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/HrCaseManagement/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/HrCaseManagement/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/HrCaseManagement/index.js" asp-append-version="true"></script>
}
