@model Diten.Web.Models.HumanCapital.EmploymentChanges.EmploymentChangesEditViewModel
@using Diten.Web.Views.HumanCapital.EmploymentChanges
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<EmploymentChangesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var title = Localizer["FormTitleCreate"].Value;
    // Readiness states offered in the form: Draft, Ready, Deferred, Blocked, NotRequired.
    // Archived is excluded (it is controlled by the delete operation server-side).
    var states = new (int Value, string Label)[]
    {
        (0, Localizer["StateDraft"].Value),
        (1, Localizer["StateReady"].Value),
        (2, Localizer["StateDeferred"].Value),
        (3, Localizer["StateBlocked"].Value),
        (4, Localizer["StateNotRequired"].Value)
    };
    Func<string, int, IHtmlContent> stateSelect = (name, selected) =>
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<select id=\"{name}\" name=\"{name}\" class=\"select2 form-select\">");
        foreach (var s in states)
        {
            var sel = s.Value == selected ? " selected" : string.Empty;
            sb.Append($"<option value=\"{s.Value}\"{sel}>{System.Net.WebUtility.HtmlEncode(s.Label)}</option>");
        }
        sb.Append("</select>");
        return Html.Raw(sb.ToString());
    };
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/HumanCapital/EmploymentChanges">@Localizer["EmploymentChangesTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/HumanCapital/EmploymentChanges" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="employmentChangesForm" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

<form id="employmentChangesForm" asp-controller="EmploymentChanges" asp-action="Create" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Main Column -->
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["IdentitySection"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Code" class="form-label fw-medium">@Localizer["Code"] <span class="text-danger">*</span></label>
                        <input asp-for="Code" class="form-control" maxlength="64" placeholder="@Localizer["CodePlaceholder"]" required />
                        <span asp-validation-for="Code" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="SourceContractVersion" class="form-label fw-medium">@Localizer["SourceContractVersion"] <span class="text-danger">*</span></label>
                        <input asp-for="SourceContractVersion" class="form-control" maxlength="32" placeholder="1.0.0" required />
                        <span asp-validation-for="SourceContractVersion" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="DisplayName" class="form-label fw-medium">@Localizer["DisplayName"] <span class="text-danger">*</span></label>
                        <input asp-for="DisplayName" class="form-control" maxlength="128" placeholder="@Localizer["DisplayNamePlaceholder"]" required />
                        <span asp-validation-for="DisplayName" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="EmploymentChangeReadinessVersion" class="form-label fw-medium">@Localizer["EmploymentChangeReadinessVersion"]</label>
                        <input asp-for="EmploymentChangeReadinessVersion" type="number" min="1" class="form-control" />
                        <span asp-validation-for="EmploymentChangeReadinessVersion" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="EmploymentChangeReadinessState" class="form-label fw-medium">@Localizer["EmploymentChangeReadinessState"]</label>
                        @stateSelect("EmploymentChangeReadinessState", Model.EmploymentChangeReadinessState)
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["WorkflowSection"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12 col-md-6">
                        <label for="ChangeLifecycleBoundaryState" class="form-label fw-medium">@Localizer["ChangeLifecycleBoundaryState"]</label>
                        @stateSelect("ChangeLifecycleBoundaryState", Model.ChangeLifecycleBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="TransferBoundaryState" class="form-label fw-medium">@Localizer["TransferBoundaryState"]</label>
                        @stateSelect("TransferBoundaryState", Model.TransferBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="PromotionBoundaryState" class="form-label fw-medium">@Localizer["PromotionBoundaryState"]</label>
                        @stateSelect("PromotionBoundaryState", Model.PromotionBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="ApprovalBoundaryState" class="form-label fw-medium">@Localizer["ApprovalBoundaryState"]</label>
                        @stateSelect("ApprovalBoundaryState", Model.ApprovalBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="PositionAssignmentBoundaryState" class="form-label fw-medium">@Localizer["PositionAssignmentBoundaryState"]</label>
                        @stateSelect("PositionAssignmentBoundaryState", Model.PositionAssignmentBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="EmployeeActionBoundaryState" class="form-label fw-medium">@Localizer["EmployeeActionBoundaryState"]</label>
                        @stateSelect("EmployeeActionBoundaryState", Model.EmployeeActionBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="ManagerActionBoundaryState" class="form-label fw-medium">@Localizer["ManagerActionBoundaryState"]</label>
                        @stateSelect("ManagerActionBoundaryState", Model.ManagerActionBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="CompensationDataBoundaryState" class="form-label fw-medium">@Localizer["CompensationDataBoundaryState"]</label>
                        @stateSelect("CompensationDataBoundaryState", Model.CompensationDataBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="BenefitsDataBoundaryState" class="form-label fw-medium">@Localizer["BenefitsDataBoundaryState"]</label>
                        @stateSelect("BenefitsDataBoundaryState", Model.BenefitsDataBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="PayrollDataBoundaryState" class="form-label fw-medium">@Localizer["PayrollDataBoundaryState"]</label>
                        @stateSelect("PayrollDataBoundaryState", Model.PayrollDataBoundaryState)
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["DeferralSection"]</h5></div>
                <div class="card-body">
                    <label asp-for="DeferredReason" class="form-label fw-medium">@Localizer["DeferredReason"]</label>
                    <textarea asp-for="DeferredReason" class="form-control" rows="3" maxlength="512"></textarea>
                </div>
            </section>
        </div>

        <!-- Sidebar Column -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["DependencySection"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label for="DocumentDependencyState" class="form-label fw-medium">@Localizer["DocumentDependencyState"]</label>
                        @stateSelect("DocumentDependencyState", Model.DocumentDependencyState)
                    </div>
                    <div class="col-12">
                        <label for="NotificationDependencyState" class="form-label fw-medium">@Localizer["NotificationDependencyState"]</label>
                        @stateSelect("NotificationDependencyState", Model.NotificationDependencyState)
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["GovernanceSection"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label for="ConsentPreconditionState" class="form-label fw-medium">@Localizer["ConsentPreconditionState"]</label>
                        @stateSelect("ConsentPreconditionState", Model.ConsentPreconditionState)
                    </div>
                    <div class="col-12">
                        <label for="DataMinimizationState" class="form-label fw-medium">@Localizer["DataMinimizationState"]</label>
                        @stateSelect("DataMinimizationState", Model.DataMinimizationState)
                    </div>
                    <div class="col-12">
                        <label for="RetentionPolicyState" class="form-label fw-medium">@Localizer["RetentionPolicyState"]</label>
                        @stateSelect("RetentionPolicyState", Model.RetentionPolicyState)
                    </div>
                    <div class="col-12">
                        <label for="EvidencePolicyState" class="form-label fw-medium">@Localizer["EvidencePolicyState"]</label>
                        @stateSelect("EvidencePolicyState", Model.EvidencePolicyState)
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>
