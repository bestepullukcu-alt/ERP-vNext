@using Diten.Web.Views.HumanCapital.HrCompliance
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<HrComplianceIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["HrComplianceTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("hcm.hr-compliance.manage");
    var canEvaluate = Perms.Has("hcm.hr-compliance.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["HrComplianceTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="hr-compliance-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-hr-compliance" data-dt-standard="v2"> *@
    <partial name="~/Views/HumanCapital/HrCompliance/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/HumanCapital/HrCompliance/_IndexL10n.cshtml" />
    <script src="~/assets/js/HumanCapital/HrCompliance/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/HumanCapital/HrCompliance/index.js" asp-append-version="true"></script>
}
