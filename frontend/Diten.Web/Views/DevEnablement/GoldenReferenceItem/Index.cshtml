@using Diten.Web.Views.DevEnablement.GoldenReferenceItem
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GoldenReferenceItemIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["GoldenReferenceItemTitle"].Value;
    Layout = "_LayoutBackbone";
}

@* ① MANDATORY: Inline Filter partial — MUST be before title according to standard *@
<partial name="~/Views/DevEnablement/GoldenReferenceItem/_Filter.cshtml" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["GoldenReferenceItemTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* ② Bulk Action Bar *@
<div id="bulkActionBar" class="card mb-4 d-none animate__animated animate__fadeInDown">
    <div class="card-body d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bx bx-check-circle text-primary icon-md"></i>
            <span id="bulkSelectedCount" class="fw-medium text-heading">0</span>
            <span class="text-muted">@SharedLocalizer["SelectedCount"]</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="btnBulkDelete" class="btn btn-label-danger">
                <i class="bx bx-trash me-1"></i> @SharedLocalizer["BulkDelete"]
            </button>
            <button type="button" id="btnClearSelection" class="btn btn-label-secondary">@SharedLocalizer["ClearSelection"]</button>
        </div>
    </div>
</div>

@* ③ DataTable Card *@
<div class="card">
    @* Standard Skeleton Loader *@
    <div id="skeleton-loader" class="p-4" style="display: none;">
        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-goldenreferenceitem" data-dt-standard="v2" class="datatables-goldenreferenceitem table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["ReferenceType"]</th>
                    <th>@Localizer["Priority"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th class="cell-fit text-end pe-3">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<partial name="~/Views/DevEnablement/GoldenReferenceItem/_DetailsQuickView.cshtml" />

@section Scripts {
    <partial name="~/Views/DevEnablement/GoldenReferenceItem/_IndexL10n.cshtml" />
    <script src="~/assets/js/DevEnablement/GoldenReferenceItem/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/DevEnablement/GoldenReferenceItem/index.js" asp-append-version="true"></script>
}
