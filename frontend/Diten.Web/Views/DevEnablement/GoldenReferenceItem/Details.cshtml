@model Diten.Web.Models.GoldenReferenceItem.GoldenReferenceItemDetailViewModel
@using Diten.Web.Views.DevEnablement.GoldenReferenceItem
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GoldenReferenceItemIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = $"{SharedLocalizer["Details"]} - {Model.Name}";
    Layout = "_LayoutBackbone";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <div class="d-flex align-items-center gap-3">
            <h4 class="mb-0 fw-bold">@Model.Name</h4>
            <span class="badge @(Model.IsActive ? "bg-label-success" : "bg-label-secondary") px-3">
                @(Model.IsActive ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])
            </span>
        </div>
        <nav aria-label="breadcrumb" class="mt-2">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item"><a asp-action="Index">@Localizer["GoldenReferenceItemTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-3">
        <a asp-action="Index" class="btn btn-label-secondary border shadow-none">
            <i class="bx bx-chevron-left me-1"></i> @SharedLocalizer["BackToList"]
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary shadow-none px-4">
            <i class="bx bx-edit me-1"></i> @SharedLocalizer["EditRecord"]
        </a>
    </div>
</div>

<div class="row g-6">
    <!-- Left Column: Primary Data -->
    <div class="col-12 col-xl-8">
        <div class="card border-0 shadow-sm mb-6">
            <div class="card-header border-bottom py-4">
                <h5 class="card-title mb-0 d-flex align-items-center">
                    <i class="bx bx-info-circle me-2 text-primary"></i> @Localizer["GeneralInformation"]
                </h5>
            </div>
            <div class="card-body py-5">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase fw-bold">@Localizer["Code"]</label>
                        <p class="mb-0 fw-medium text-heading fs-5">@Model.Code</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase fw-bold">@Localizer["Name"]</label>
                        <p class="mb-0 fw-medium text-heading fs-5">@Model.Name</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase fw-bold">@Localizer["ReferenceType"]</label>
                        <p class="mb-0 text-heading">@(Model.ReferenceType ?? SharedLocalizer["NotAvailable"].Value)</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase fw-bold">@Localizer["Priority"]</label>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-label-info">@SharedLocalizer["LevelPrefix"] @Model.Priority</span>
                        </div>
                    </div>
                    <div class="col-12 mt-5">
                        <label class="form-label text-muted small text-uppercase fw-bold">@SharedLocalizer["Description"]</label>
                        <div class="p-3 bg-light rounded-2 text-heading" style="min-height: 100px;">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? SharedLocalizer["NotAvailable"].Value : Model.Description)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Metadata & System Info -->
    <div class="col-12 col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header border-bottom py-4">
                <h6 class="card-title mb-0">@Localizer["SystemInformation"]</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="d-flex align-items-center mb-3">
                        <i class="bx bx-id-card me-2 text-muted"></i>
                        <span class="fw-medium me-2">@Localizer["IdLabel"]:</span>
                        <span class="text-muted small">@Model.Id</span>
                    </li>
                    <li class="d-flex align-items-center">
                        <i class="bx bx-calendar me-2 text-muted"></i>
                        <span class="fw-medium me-2 text-nowrap">@SharedLocalizer["Status"]:</span>
                         @if (Model.IsActive)
                        {
                            <span class="text-success fw-medium">@SharedLocalizer["Active"]</span>
                        }
                        else
                        {
                            <span class="text-secondary fw-medium">@SharedLocalizer["Passive"]</span>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
