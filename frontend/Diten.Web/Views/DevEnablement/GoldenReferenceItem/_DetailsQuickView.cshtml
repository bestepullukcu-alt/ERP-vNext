@using Diten.Web.Views.DevEnablement.GoldenReferenceItem
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GoldenReferenceItemIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="offcanvasDetailsPreviewLabel" style="width: 480px;">
    <div class="offcanvas-header border-bottom py-4">
        <div class="d-flex align-items-center">
            <div class="avatar avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                <i class="bx bx-category fs-4"></i>
            </div>
            <div>
                <h5 id="oc-title" class="offcanvas-title mb-0 fw-bold">-</h5>
                <small id="oc-subtitle" class="text-muted">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-0">
        <div class="p-4">
            <div class="bg-label-secondary rounded p-3 mb-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="d-block text-muted small fw-medium mb-1">@SharedLocalizer["Status"]</span>
                    <span id="oc-status" class="badge bg-label-secondary">-</span>
                </div>
            </div>

            <h6 class="text-uppercase text-muted fw-bold mb-3 small fs-tiny">@Localizer["GeneralInformation"]</h6>
            <dl class="row mb-4">
                <dt class="col-4 fw-medium text-heading mb-2">@Localizer["Code"]</dt>
                <dd id="oc-code" class="col-8 mb-2">-</dd>

                <dt class="col-4 fw-medium text-heading mb-2">@Localizer["Name"]</dt>
                <dd id="oc-name" class="col-8 mb-2">-</dd>

                <dt class="col-4 fw-medium text-heading mb-2">@Localizer["ReferenceType"]</dt>
                <dd id="oc-type" class="col-8 mb-2">-</dd>

                <dt class="col-4 fw-medium text-heading mb-2">@Localizer["Priority"]</dt>
                <dd id="oc-priority" class="col-8 mb-2">-</dd>
            </dl>

            <h6 class="text-uppercase text-muted fw-bold mb-2">@SharedLocalizer["Description"]</h6>
            <div id="oc-desc" class="p-3 bg-light rounded text-muted small" style="min-height: 80px;">
                -
            </div>
        </div>
    </div>

    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary flex-grow-1" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <a id="oc-btn-edit" href="#" class="btn btn-primary flex-grow-1">@SharedLocalizer["EditRecord"]</a>
    </div>
</div>
