@model Diten.Web.Models.GoldenReferenceItem.GoldenReferenceItemEditViewModel
@using Diten.Web.Views.DevEnablement.GoldenReferenceItem
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GoldenReferenceItemIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["AddNew"].Value;
    Layout = "_LayoutBackbone";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0">@Localizer["AddNew"]</h5>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item position-relative"><a asp-action="Index" class="stretched-link">@Localizer["GoldenReferenceItemTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@Localizer["AddNew"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-4">
        <a asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="formGoldenReferenceItem" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <partial name="~/Views/DevEnablement/GoldenReferenceItem/_Form.cshtml" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/DevEnablement/GoldenReferenceItem/form.js" asp-append-version="true"></script>
}
