@model Diten.Web.Models.GoldenReferenceCompact.GoldenReferenceCompactEditViewModel
@using Diten.Web.Views.DevEnablement.GoldenReferenceCompact
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GoldenReferenceCompactIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
    var action = isEdit ? "Edit" : "Create";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/GoldenReferenceCompact">@Localizer["GoldenReferenceCompactTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/GoldenReferenceCompact" class="btn btn-label-secondary">
            @SharedLocalizer["Cancel"]
        </a>
        <button type="submit" form="goldenReferenceForm" class="btn btn-primary">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>

<form id="goldenReferenceForm" asp-controller="GoldenReferenceCompact" asp-action="@action" asp-route-id="@Model.Id" method="post"
    class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Main Column (Left) -->
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IdentitySection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Code" class="form-label fw-medium">@Localizer["Code"] <span class="text-danger">*</span></label>
                            <input asp-for="Code" class="form-control" maxlength="64" placeholder="@Localizer["CodePlaceholder"]" required />
                            <span asp-validation-for="Code" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="ReferenceType" class="form-label fw-medium">@Localizer["ReferenceType"]</label>
                            <select asp-for="ReferenceType" class="select2 form-select">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                <option value="Standard">@Localizer["ReferenceTypeStandard"]</option>
                                <option value="Custom">@Localizer["ReferenceTypeCustom"]</option>
                                <option value="Pro">@Localizer["ReferenceTypePro"]</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-medium">@Localizer["Name"] <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" maxlength="200" placeholder="@Localizer["NamePlaceholder"]" required />
                            <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Category" class="form-label fw-medium">@Localizer["Category"]</label>
                            <input asp-for="Category" class="form-control" maxlength="120" placeholder="@Localizer["CategoryPlaceholder"]" />
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@SharedLocalizer["Description"]</h6>
                    <label asp-for="Description" class="form-label fw-medium">@SharedLocalizer["Description"]</label>
                    <textarea asp-for="Description" class="form-control" rows="8" placeholder="@SharedLocalizer["DescriptionPlaceholder"]"></textarea>
                </div>
            </section>
        </div>

        <!-- Sidebar Column (Right) -->
        <div class="col-12 col-lg-4">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["OwnershipSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="GroupKey" class="form-label fw-medium">@Localizer["GroupKey"]</label>
                            <input asp-for="GroupKey" class="form-control" maxlength="120" placeholder="@Localizer["GroupKeyPlaceholder"]" />
                        </div>
                        <div class="col-12">
                            <label asp-for="SourceSystem" class="form-label fw-medium">@Localizer["SourceSystem"]</label>
                            <input asp-for="SourceSystem" class="form-control" maxlength="120" placeholder="@Localizer["SourceSystemPlaceholder"]" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Owner" class="form-label fw-medium">@Localizer["Owner"]</label>
                            <input asp-for="Owner" class="form-control" maxlength="120" placeholder="@Localizer["OwnerPlaceholder"]" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Version" class="form-label fw-medium">@Localizer["Version"]</label>
                            <input asp-for="Version" class="form-control" maxlength="40" placeholder="@Localizer["VersionPlaceholder"]" />
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["LifecycleSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="EffectiveDate" class="form-label fw-medium">@Localizer["EffectiveDate"]</label>
                            <input asp-for="EffectiveDate" type="text" class="form-control flatpickr-date" placeholder="YYYY-MM-DD" />
                        </div>
                        <div class="col-12">
                            <label asp-for="ExpirationDate" class="form-label fw-medium">@Localizer["ExpirationDate"]</label>
                            <input asp-for="ExpirationDate" type="text" class="form-control flatpickr-date" placeholder="YYYY-MM-DD" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Priority" class="form-label fw-medium">@Localizer["Priority"]</label>
                            <input asp-for="Priority" type="number" class="form-control" min="0" max="100" placeholder="@Localizer["PriorityPlaceholder"]" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input type="hidden" name="IsActive" value="false" />
                                <input asp-for="IsActive" class="form-check-input" role="switch" value="true" />
                                <label asp-for="IsActive" class="form-check-label ms-2">@SharedLocalizer["Active"]</label>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

</form>
