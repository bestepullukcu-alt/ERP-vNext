@using Diten.Web.Views.DevEnablement.GoldenReferenceSlim
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GoldenReferenceSlimIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <partial name="_TableSkeleton" />

    <div class="card-datatable table-responsive">
        <table id="dt-goldenreferenceslim" data-dt-standard="v2" data-dt-data-mode="client" class="datatables-goldenreferenceslim table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th>@Localizer["Code"]</th>
                    <th class="all">@Localizer["Name"]</th>
                    <th>@Localizer["ReferenceType"]</th>
                    <th>@Localizer["Priority"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
