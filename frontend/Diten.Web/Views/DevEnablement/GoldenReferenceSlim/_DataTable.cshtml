@using Diten.Web.Views.DevEnablement.GoldenReferenceSlim
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GoldenReferenceSlimIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // The table card is a component (BL-440): the page describes it, _ListShell renders it. The page keeps its
    // own words — every header is localized HERE, the shell produces no text.
    var listShell = new DataTableListShellViewModel
    {
        TableId = "dt-goldenreferenceslim",
        DataMode = "client",
        Slug = "goldenreferenceslim",
        HasSelection = true,
        Columns =
        [
            new DataTableColumnViewModel { Header = Localizer["Code"].Value },
            new DataTableColumnViewModel { Header = Localizer["Name"].Value, CssClass = "all" },
            new DataTableColumnViewModel { Header = Localizer["ReferenceType"].Value },
            new DataTableColumnViewModel { Header = Localizer["Priority"].Value },
            new DataTableColumnViewModel { Header = SharedLocalizer["Status"].Value }
        ],
        ActionsHeader = Localizer["Actions"].Value
    };
}

<partial name="~/Views/Shared/Components/DataTable/_ListShell.cshtml" model="listShell" />
