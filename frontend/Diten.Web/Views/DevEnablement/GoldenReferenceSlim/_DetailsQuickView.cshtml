@using Diten.Web.Views.DevEnablement.GoldenReferenceSlim
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GoldenReferenceSlimIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end backbone-preview-offcanvas" tabindex="-1" id="offcanvasDetailsPreview"
    aria-labelledby="offcanvasDetailsPreviewLabel">
    <div class="offcanvas-header py-6">
        <div class="d-flex align-items-center min-w-0">
            <div class="backbone-preview-avatar d-flex align-items-center justify-content-center me-3 flex-shrink-0">
                <i class="bx bx-cube fs-4"></i>
            </div>
            <div class="min-w-0">
                <h5 id="oc-title" class="offcanvas-title mb-1 text-truncate">-</h5>
                <small id="oc-subtitle" class="text-muted d-block text-truncate">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"
            aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-0 border-top">
        <div class="p-4 d-flex flex-column gap-4">
            <section
                class="backbone-preview-section backbone-preview-status p-4 d-flex align-items-center justify-content-between">
                <span class="fw-semibold text-heading">@SharedLocalizer["Status"]</span>
                <span id="oc-status" class="badge bg-label-secondary">-</span>
            </section>

            <section class="backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["GeneralInformation"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-sm-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-purchase-tag-alt"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Code"]</div>
                                <div id="oc-code" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-file"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Name"]</div>
                                <div id="oc-name" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-cog"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ReferenceType"]</div>
                                <div id="oc-type" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-trending-up"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Priority"]</div>
                                <div class="backbone-preview-value mt-1 d-flex align-items-center gap-2">
                                    <span id="oc-priority-dot" class="backbone-priority-dot"></span>
                                    <span id="oc-priority">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-3">@SharedLocalizer["Description"]</h6>
                <div id="oc-desc" class="backbone-preview-description">-</div>
            </section>
        </div>
    </div>

    <div
        class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2 bg-white">
        <button type="button" class="btn btn-label-secondary"
            data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" id="oc-btn-edit" class="btn btn-primary" data-bs-dismiss="offcanvas">
            @SharedLocalizer["EditRecord"]
        </button>
    </div>
</div>
