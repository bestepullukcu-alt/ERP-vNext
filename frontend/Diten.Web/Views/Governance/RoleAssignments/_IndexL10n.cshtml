@using Diten.Web.Views.Governance.RoleAssignments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<RoleAssignmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@{
    // FIX-ROLEPERMS-MODULE-LABEL — module display names for the Role Permissions group headers + module filter,
    // reusing the SAME Nav.Module.{CODE} resources the sidebar and Ctrl+K localize with (NavNameLocalizer), so the
    // three surfaces read identically in all 7 languages. Discovered by PREFIX, never a hardcoded list: a future
    // self-registered module localizes here the moment it ships its Nav.Module key — no code change.
    // Keys are already in canonical form (uppercase, alphanumerics only) — the same form ModuleLabel.normalize
    // produces from a permission's raw module slug, which is what makes "work-aggregation" meet WORKAGGREGATION.
    const string NavModulePrefix = "Nav.Module.";
    // FIX-RBAC-PERM-MODULE-ATTRIBUTION — the same prefix bridge, for the SOURCE names now shown on each row
    // ("field-definitions" → "Alan Tanımları"). Nav.Page.* already localizes exactly these nouns for the sidebar,
    // so the row, the menu and Ctrl+K say the same word without a second dictionary.
    const string NavPagePrefix = "Nav.Page.";
    // ADR-001 §2 — SCREEN-SPECIFIC module names. Same prefix bridge, different question: Nav.Module.* names the
    // sidebar entry, Perm.Module.* names the permission GROUP. They differ only where a module's menu presence and
    // its permission set describe different things (today: tasks → "Görev Tanımları" vs "Görevler"). A module with
    // no Perm.Module key simply falls through to its menu name, so this map stays as short as the problem is.
    const string PermModulePrefix = "Perm.Module.";
    // WP-WEB-ROLE-PERMISSION-LABELS-01 (BL-508) — SCREEN-SPECIFIC row names. A permission's source code is not always a
    // menu page ("approvals", "weeks", "content-set"), and the row names must not be written as Nav.Page.* (those are the
    // sidebar's and Ctrl+K's, and every Nav.Page code owes page help in seven languages). Collected in their OWN map and
    // layered over the Nav.Page names in PermLabel.split, so a code both name is said this screen's way whatever order
    // GetAllStrings walks the resource file in.
    const string PermEntityPrefix = "Perm.Entity.";
    var moduleNames = new Dictionary<string, string>(StringComparer.Ordinal);
    var entityNames = new Dictionary<string, string>(StringComparer.Ordinal);
    var permModuleNames = new Dictionary<string, string>(StringComparer.Ordinal);
    var permEntityNames = new Dictionary<string, string>(StringComparer.Ordinal);
    try
    {
        foreach (var entry in SharedLocalizer.GetAllStrings(includeParentCultures: true))
        {
            if (entry.ResourceNotFound || string.IsNullOrWhiteSpace(entry.Value)) continue;

            // First win in both maps: GetAllStrings walks the culture hierarchy most-specific first.
            if (entry.Name.StartsWith(NavModulePrefix, StringComparison.Ordinal))
            {
                var code = entry.Name.Substring(NavModulePrefix.Length);
                if (code.Length > 0 && !moduleNames.ContainsKey(code)) moduleNames[code] = entry.Value;
            }
            else if (entry.Name.StartsWith(NavPagePrefix, StringComparison.Ordinal))
            {
                var code = entry.Name.Substring(NavPagePrefix.Length);
                if (code.Length > 0 && !entityNames.ContainsKey(code)) entityNames[code] = entry.Value;
            }
            else if (entry.Name.StartsWith(PermModulePrefix, StringComparison.Ordinal))
            {
                var code = entry.Name.Substring(PermModulePrefix.Length);
                if (code.Length > 0 && !permModuleNames.ContainsKey(code)) permModuleNames[code] = entry.Value;
            }
            else if (entry.Name.StartsWith(PermEntityPrefix, StringComparison.Ordinal))
            {
                var code = entry.Name.Substring(PermEntityPrefix.Length);
                if (code.Length > 0 && !permEntityNames.ContainsKey(code)) permEntityNames[code] = entry.Value;
            }
        }
    }
    catch (Exception)
    {
        // A missing or unreadable resource set must not take the whole L10n bridge down: an empty map degrades to
        // the nav names and then to the humanized code — never to a raw slug.
        moduleNames.Clear();
        entityNames.Clear();
        permModuleNames.Clear();
        permEntityNames.Clear();
    }
}

<script id="roleassignments-l10n" type="application/json">
    @Json.Serialize(new
    {
        Assign = Localizer["Assign"].Value,
        Remove = SharedLocalizer["Delete"].Value,
        BadgeBaseline = Localizer["BadgeBaseline"].Value,
        BadgeModule = Localizer["BadgeModule"].Value,
        BadgeManual = Localizer["BadgeManual"].Value,
        LockedHint = Localizer["LockedHint"].Value,
        LockedHintSystem = Localizer["LockedHintSystem"].Value,
        LockedHintModule = Localizer["LockedHintModule"].Value,
        ModuleUngrouped = Localizer["ModuleUngrouped"].Value,
        // FIX-ROLEPERMS-MODULE-LABEL — { NORMALIZEDMODULECODE: localized name } for the group headers + module
        // filter. → window.L10n.ModuleNames, consumed by ModuleLabel.buildMap. See the @{ } block above.
        ModuleNames = moduleNames,
        // ADR-001 §2 — { NORMALIZEDMODULECODE: localized name } for the permission GROUP header + module filter,
        // layered ABOVE the sidebar name in ModuleLabel.buildMap. → window.L10n.PermModuleNames.
        PermModuleNames = permModuleNames,
        // FIX-RBAC-PERM-MODULE-ATTRIBUTION — { NORMALIZEDPAGECODE: localized name } for the SOURCE name on each
        // permission row. → window.L10n.EntityNames, consumed by PermLabel.split. Discovered by prefix like
        // ModuleNames, so a source this screen has never seen still reads as words (humanized) and never as a slug.
        EntityNames = entityNames,
        // WP-WEB-ROLE-PERMISSION-LABELS-01 — { NORMALIZEDCODE: localized name } from Perm.Entity.*, read by PermLabel.split
        // BEFORE EntityNames (this screen's own row names win over the menu's). → window.L10n.PermEntityNames.
        PermEntityNames = permEntityNames,
        // FIX-RBAC-PERM-MODULE-ATTRIBUTION — { actionSuffix: localized reach } for the second pill on a chip.
        // "read-tenant-wide" is the read action at a wider REACH, not a 98th verb, and the reach is the half that
        // decides whether the grant is dangerous — so it is shown as its own token, in the user's language.
        ScopeLabels = new Dictionary<string, string>
        {
            ["tenant-wide"] = Localizer["ScopeLabel_TenantWide"].Value,
            // WP-WEB-ROLE-PERMISSION-LABELS-01 (BL-508 (1)) — the reach of the whole action `read-all`
            // (PermLabel SCOPE_ACTIONS): the same tenant-wide reach, so the same words and the same chip.
            ["all"] = Localizer["ScopeLabel_TenantWide"].Value
        },
        // WP-WEB-ROLE-PERMISSION-LABELS-01 — what a key grants beyond the verb its chip shows (PermLabel KEY_VERBS),
        // keyed by the permission KEY; shown on the chip's tooltip.
        KeyHints = new Dictionary<string, string>
        {
            ["crm.visit-plan.read-all"] = Localizer["KeyHint_CrmVisitPlanReadAll"].Value,
            ["crm.planned-visit.read-all"] = Localizer["KeyHint_CrmPlannedVisitReadAll"].Value,
            // WP-WEB-TASK-UPDATE-HINT-01 (BL-341 step 1) — everything "Update Task" grants (TasksController).
            ["platform.tasks.update"] = Localizer["KeyHint_PlatformTasksUpdate"].Value
        },
        PermissionSummary = Localizer["PermissionSummary"].Value,
        SelectedRoleTitle = Localizer["SelectedRoleTitle"].Value,
        CoverageLabel = Localizer["CoverageLabel"].Value,
        AssignedRemaining = Localizer["AssignedRemaining"].Value,
        StatTotal = Localizer["StatTotal"].Value,
        StatAssigned = Localizer["StatAssigned"].Value,
        StatBaselineLocked = Localizer["StatBaselineLocked"].Value,
        StatUnassigned = Localizer["StatUnassigned"].Value,
        ActionDistributionTitle = Localizer["ActionDistributionTitle"].Value,
        // FEAT-ROLEPERMS-ACTIONDIST-DYNAMIC — the Action Distribution panel is now built dynamically from the role's
        // distinct actions using ActionVerbs (single source with the rows), so the old fixed-category labels
        // (ActionRead/Create/Update/Delete/Archive/Export/Other) are no longer emitted. The resx keys remain for
        // history but are unreferenced in code.
        BaselineRequiredNote = Localizer["BaselineRequiredNote"].Value,
        ShowingCount = Localizer["ShowingCount"].Value,
        CountBadge = Localizer["CountBadge"].Value,
        SelectRolePrompt = Localizer["SelectRolePrompt"].Value,
        NoPermissions = Localizer["NoPermissions"].Value,
        AreYouSure = SharedLocalizer["AreYouSure"].Value,
        RecordCreated = SharedLocalizer["RecordCreated"].Value,
        RecordDeleted = SharedLocalizer["RecordDeleted"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
        // WP-ROLES-CLOSE-01 — refusal sentences, keyed from AuthService's stable codes (index.js ERROR_CODE_KEYS).
        ErrorRoleActorRequired = Localizer["ErrorRoleActorRequired"].Value,
        ErrorRoleNotFound = Localizer["ErrorRoleNotFound"].Value,
        ErrorRolePermissionNotTenantAssignable = Localizer["ErrorRolePermissionNotTenantAssignable"].Value,
        ErrorRolePermissionNotForHumanRole = Localizer["ErrorRolePermissionNotForHumanRole"].Value,
        ErrorRolePermissionGrantManaged = Localizer["ErrorRolePermissionGrantManaged"].Value,
        ErrorRolePermissionRevokeLastSteward = Localizer["ErrorRolePermissionRevokeLastSteward"].Value,
        ErrorRolePermissionAlreadyGranted = Localizer["ErrorRolePermissionAlreadyGranted"].Value,
        Cancel = SharedLocalizer["Cancel"].Value,
        Delete = SharedLocalizer["Delete"].Value,
        Reset = SharedLocalizer["Reset"].Value,
        // FIX-ROLEPERMS-ROLENAME-L10N-STICKY — system role display names keyed by role CODE (role.name), localized to
        // the UI language (used for isSystem roles; custom roles keep their stored DisplayName). → window.L10n.RoleNames.
        RoleNames = new Dictionary<string, string>
        {
            ["SuperAdmin"] = SharedLocalizer["RoleName_SuperAdmin"].Value,
            ["Admin"] = SharedLocalizer["RoleName_Admin"].Value,
            ["Viewer"] = SharedLocalizer["RoleName_Viewer"].Value,
            ["ReadOnly"] = SharedLocalizer["RoleName_ReadOnly"].Value
        },
        // FEAT-ROLEPERMS-LABEL-DERIVE — action-verb dictionary (keyed by the raw permission ACTION segment) that the
        // frontend uses to derive each Role Permissions row label from the permission KEY ("{Verb} · {Entity}"),
        // instead of the drifted stored DisplayName. Keys are the literal catalog action strings (incl. hyphenated);
        // any action not present here falls back to a humanized segment client-side.
        ActionVerbs = new Dictionary<string, string>
        {
            ["read"] = Localizer["ActionVerb_Read"].Value,
            ["view"] = Localizer["ActionVerb_View"].Value,
            ["create"] = Localizer["ActionVerb_Create"].Value,
            ["update"] = Localizer["ActionVerb_Update"].Value,
            ["edit"] = Localizer["ActionVerb_Edit"].Value,
            ["delete"] = Localizer["ActionVerb_Delete"].Value,
            ["bulk-delete"] = Localizer["ActionVerb_BulkDelete"].Value,
            ["manage"] = Localizer["ActionVerb_Manage"].Value,
            ["assign"] = Localizer["ActionVerb_Assign"].Value,
            ["revoke"] = Localizer["ActionVerb_Revoke"].Value,
            ["assign-permission"] = Localizer["ActionVerb_AssignPermission"].Value,
            ["assign-role"] = Localizer["ActionVerb_AssignRole"].Value,
            ["delegate"] = Localizer["ActionVerb_Delegate"].Value,
            ["register"] = Localizer["ActionVerb_Register"].Value,
            ["export"] = Localizer["ActionVerb_Export"].Value,
            ["import"] = Localizer["ActionVerb_Import"].Value,
            ["upload"] = Localizer["ActionVerb_Upload"].Value,
            ["list"] = Localizer["ActionVerb_List"].Value,
            ["preview"] = Localizer["ActionVerb_Preview"].Value,
            ["share"] = Localizer["ActionVerb_Share"].Value,
            ["archive"] = Localizer["ActionVerb_Archive"].Value,
            ["activate"] = Localizer["ActionVerb_Activate"].Value,
            ["reactivate"] = Localizer["ActionVerb_Reactivate"].Value,
            ["suspend"] = Localizer["ActionVerb_Suspend"].Value,
            ["deprecate"] = Localizer["ActionVerb_Deprecate"].Value,
            ["approve"] = Localizer["ActionVerb_Approve"].Value,
            ["reject"] = Localizer["ActionVerb_Reject"].Value,
            ["publish"] = Localizer["ActionVerb_Publish"].Value,
            ["submit"] = Localizer["ActionVerb_Submit"].Value,
            ["cancel"] = Localizer["ActionVerb_Cancel"].Value,
            ["validate"] = Localizer["ActionVerb_Validate"].Value,
            ["run"] = Localizer["ActionVerb_Run"].Value,
            ["execute"] = Localizer["ActionVerb_Execute"].Value,
            ["retry"] = Localizer["ActionVerb_Retry"].Value,
            ["evaluate"] = Localizer["ActionVerb_Evaluate"].Value,
            ["initialize"] = Localizer["ActionVerb_Initialize"].Value,
            ["compare"] = Localizer["ActionVerb_Compare"].Value,
            ["move"] = Localizer["ActionVerb_Move"].Value,
            ["start"] = Localizer["ActionVerb_Start"].Value,
            // FIX-ROLEPERMS-ACTION-FAMILIES — the verbs the live catalog carries more than once, plus the two the
            // Görev Merkezi surface needs (claim/complete). Measured: 97 distinct actions; translating all of them
            // would be 679 strings that go stale on the next self-registered module. This bridge covers the ones
            // that repeat; the rest humanize client-side and still read as words, never as a raw slug.
            ["claim"] = Localizer["ActionVerb_Claim"].Value,
            ["complete"] = Localizer["ActionVerb_Complete"].Value,
            ["review"] = Localizer["ActionVerb_Review"].Value,
            ["reconcile"] = Localizer["ActionVerb_Reconcile"].Value,
            ["record"] = Localizer["ActionVerb_Record"].Value,
            ["search"] = Localizer["ActionVerb_Search"].Value,
            ["verify"] = Localizer["ActionVerb_Verify"].Value,
            ["request"] = Localizer["ActionVerb_Request"].Value,
            ["change-lifecycle"] = Localizer["ActionVerb_ChangeLifecycle"].Value,
            ["read-manager-chain"] = Localizer["ActionVerb_ReadManagerChain"].Value,
            // WP-WEB-ROLE-PERMISSION-LABELS-01 (BL-508 (2)) — every remaining verb the catalog carries (measured from the Auth
            // seed + the module manifests by role-assignments-label-ledger.test.js), so no chip falls back to English.
            // Keys are the DISPLAY form PermLabel.normalizeAction gives (kebab; dots kept), never snake_case.
            ["allocate"] = Localizer["ActionVerb_Allocate"].Value,
            ["amend"] = Localizer["ActionVerb_Amend"].Value,
            ["append"] = Localizer["ActionVerb_Append"].Value,
            ["apply"] = Localizer["ActionVerb_Apply"].Value,
            ["approve-extension"] = Localizer["ActionVerb_ApproveExtension"].Value,
            ["attach-evidence"] = Localizer["ActionVerb_AttachEvidence"].Value,
            ["audit"] = Localizer["ActionVerb_Audit"].Value,
            ["audit.view"] = Localizer["ActionVerb_AuditView"].Value,
            ["block"] = Localizer["ActionVerb_Block"].Value,
            ["capture"] = Localizer["ActionVerb_Capture"].Value,
            ["change"] = Localizer["ActionVerb_Change"].Value,
            ["change-status"] = Localizer["ActionVerb_ChangeStatus"].Value,
            ["update-brand"] = Localizer["ActionVerb_UpdateBrand"].Value,
            ["commit"] = Localizer["ActionVerb_Commit"].Value,
            ["configure"] = Localizer["ActionVerb_Configure"].Value,
            ["confirm"] = Localizer["ActionVerb_Confirm"].Value,
            ["correct"] = Localizer["ActionVerb_Correct"].Value,
            ["create-draft"] = Localizer["ActionVerb_CreateDraft"].Value,
            ["deactivate"] = Localizer["ActionVerb_Deactivate"].Value,
            ["decide"] = Localizer["ActionVerb_Decide"].Value,
            ["dispatch"] = Localizer["ActionVerb_Dispatch"].Value,
            ["dispose"] = Localizer["ActionVerb_Dispose"].Value,
            ["dry-run"] = Localizer["ActionVerb_DryRun"].Value,
            ["edit-employment"] = Localizer["ActionVerb_EditEmployment"].Value,
            ["edit-legal"] = Localizer["ActionVerb_EditLegal"].Value,
            ["end"] = Localizer["ActionVerb_End"].Value,
            ["generate"] = Localizer["ActionVerb_Generate"].Value,
            ["impact.view"] = Localizer["ActionVerb_ImpactView"].Value,
            ["instantiate"] = Localizer["ActionVerb_Instantiate"].Value,
            ["invalidate"] = Localizer["ActionVerb_Invalidate"].Value,
            ["investigate"] = Localizer["ActionVerb_Investigate"].Value,
            ["link"] = Localizer["ActionVerb_Link"].Value,
            ["lookup"] = Localizer["ActionVerb_Lookup"].Value,
            ["lookup-validation"] = Localizer["ActionVerb_LookupValidation"].Value,
            ["migrate"] = Localizer["ActionVerb_Migrate"].Value,
            ["minutes-publish"] = Localizer["ActionVerb_MinutesPublish"].Value,
            ["minutes-write"] = Localizer["ActionVerb_MinutesWrite"].Value,
            ["propose"] = Localizer["ActionVerb_Propose"].Value,
            ["publish-override"] = Localizer["ActionVerb_PublishOverride"].Value,
            ["read-aggregate"] = Localizer["ActionVerb_ReadAggregate"].Value,
            ["rebase"] = Localizer["ActionVerb_Rebase"].Value,
            ["recover"] = Localizer["ActionVerb_Recover"].Value,
            ["release"] = Localizer["ActionVerb_Release"].Value,
            ["reopen"] = Localizer["ActionVerb_Reopen"].Value,
            ["replace"] = Localizer["ActionVerb_Replace"].Value,
            ["request-correction"] = Localizer["ActionVerb_RequestCorrection"].Value,
            ["request-info"] = Localizer["ActionVerb_RequestInfo"].Value,
            ["request-retirement"] = Localizer["ActionVerb_RequestRetirement"].Value,
            ["reserve"] = Localizer["ActionVerb_Reserve"].Value,
            ["resolve"] = Localizer["ActionVerb_Resolve"].Value,
            ["retire"] = Localizer["ActionVerb_Retire"].Value,
            ["rollback"] = Localizer["ActionVerb_Rollback"].Value,
            ["series-manage"] = Localizer["ActionVerb_SeriesManage"].Value,
            ["settle"] = Localizer["ActionVerb_Settle"].Value,
            ["sign"] = Localizer["ActionVerb_Sign"].Value,
            ["temporary-issue"] = Localizer["ActionVerb_TemporaryIssue"].Value,
            ["thresholds.manage"] = Localizer["ActionVerb_ThresholdsManage"].Value,
            ["transition"] = Localizer["ActionVerb_Transition"].Value,
            ["types-manage"] = Localizer["ActionVerb_TypesManage"].Value,
            ["unblock"] = Localizer["ActionVerb_Unblock"].Value,
            ["update-released"] = Localizer["ActionVerb_UpdateReleased"].Value,
            ["version.publish"] = Localizer["ActionVerb_VersionPublish"].Value,
            ["view-sensitive"] = Localizer["ActionVerb_ViewSensitive"].Value,
            ["view-status-history"] = Localizer["ActionVerb_ViewStatusHistory"].Value,
            ["withdraw"] = Localizer["ActionVerb_Withdraw"].Value,
            ["write"] = Localizer["ActionVerb_Write"].Value,
            ["write-value"] = Localizer["ActionVerb_WriteValue"].Value
        }
    })
</script>
