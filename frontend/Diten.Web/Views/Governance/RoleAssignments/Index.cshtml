@using Diten.Web.Views.Governance.RoleAssignments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<RoleAssignmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["Title"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<form id="raAntiForgery">@Html.AntiForgeryToken()</form>

<div class="card">
    <div class="card-header d-flex flex-wrap align-items-center gap-3">
        <div class="flex-grow-1" style="min-width:14rem; max-width:24rem;">
            <label for="raRoleSelect" class="form-label fw-medium mb-1">@Localizer["SelectRole"]</label>
            <select id="raRoleSelect" class="form-select">
                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
            </select>
        </div>
        <div class="flex-grow-1" style="min-width:12rem; max-width:20rem;">
            <label for="raSearch" class="form-label fw-medium mb-1">@SharedLocalizer["Search"]</label>
            <input type="search" id="raSearch" class="form-control" placeholder="@Localizer["SearchPermissions"]" />
        </div>
    </div>

    <div class="card-body">
        <div id="raAlert" class="alert alert-danger d-none" role="alert"></div>

        <div id="raEmpty" class="text-center text-muted py-6">@Localizer["SelectRolePrompt"]</div>

        <div id="raList" class="list-group list-group-flush d-none"></div>
    </div>
</div>

@* Row template — cloned by JS per permission (no inline markup generation) *@
<template id="raRowTemplate">
    <div class="list-group-item d-flex align-items-center justify-content-between gap-3 ra-row">
        <div class="min-w-0">
            <div class="d-flex align-items-center gap-2">
                <code class="ra-key text-heading"></code>
                <span class="badge ra-badge d-none"></span>
            </div>
            <small class="ra-display text-muted d-block text-truncate"></small>
        </div>
        <div class="flex-shrink-0 d-flex align-items-center gap-2">
            <i class="bx bx-lock-alt text-muted ra-lock d-none" title="@Localizer["LockedHint"]"></i>
            <button type="button" class="btn btn-sm btn-label-primary ra-assign d-none">@Localizer["Assign"]</button>
            <button type="button" class="btn btn-sm btn-label-danger ra-remove d-none">@SharedLocalizer["Delete"]</button>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="~/Views/Governance/RoleAssignments/_IndexL10n.cshtml" />
    <script src="~/assets/js/Governance/RoleAssignments/grant-state.js" asp-append-version="true"></script>
    <script src="~/assets/js/Governance/RoleAssignments/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Governance/RoleAssignments/index.js" asp-append-version="true"></script>
}
