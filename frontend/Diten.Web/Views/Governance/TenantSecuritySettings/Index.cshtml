@using Diten.Web.Views.Governance.TenantSecuritySettings
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantSecuritySettingsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0">@Localizer["Title"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-3">
        <button type="submit" form="formTenantSecurity" id="btnSaveTenantSecurity" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

<div class="alert alert-danger d-none" id="securityErrorSummary"></div>

<div id="tenantSecurityRoot">
    <form id="formTenantSecurity" novalidate>
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">@Localizer["LoginMethods"]</h6>
            </div>
            <div class="card-body row g-3">
                <div class="col-12 col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="twoFactorEnabled" name="twoFactorEnabled">
                        <label class="form-check-label" for="twoFactorEnabled">@Localizer["TwoFactorEnabled"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="mfaRequired" name="mfaRequired">
                        <label class="form-check-label" for="mfaRequired">@Localizer["MfaRequired"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="emailLoginEnabled" name="emailLoginEnabled">
                        <label class="form-check-label" for="emailLoginEnabled">@Localizer["EmailLoginEnabled"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="phoneLoginEnabled" name="phoneLoginEnabled">
                        <label class="form-check-label" for="phoneLoginEnabled">@Localizer["PhoneLoginEnabled"]</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">@Localizer["PasswordPolicy"]</h6>
            </div>
            <div class="card-body row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label" for="passwordMinLength">@Localizer["PasswordMinLength"] <span class="text-danger">*</span></label>
                    <input type="number" id="passwordMinLength" name="passwordMinLength" class="form-control" min="8" max="128" required>
                    <div class="invalid-feedback" data-valmsg-for="PasswordMinLength"></div>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="passwordExpirationDays">@Localizer["PasswordExpirationDays"]</label>
                    <input type="number" id="passwordExpirationDays" name="passwordExpirationDays" class="form-control" min="1" max="3650">
                    <div class="form-text">@Localizer["PasswordExpirationDaysHint"]</div>
                    <div class="invalid-feedback" data-valmsg-for="PasswordExpirationDays"></div>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="loginAuditRetentionDays">@Localizer["LoginAuditRetentionDays"] <span class="text-danger">*</span></label>
                    <input type="number" id="loginAuditRetentionDays" name="loginAuditRetentionDays" class="form-control" min="1" max="3650" required>
                    <div class="invalid-feedback" data-valmsg-for="LoginAuditRetentionDays"></div>
                </div>
                <div class="col-12 col-md-6 col-lg-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="passwordRequireUppercase" name="passwordRequireUppercase"><label class="form-check-label" for="passwordRequireUppercase">@Localizer["RequireUppercase"]</label></div></div>
                <div class="col-12 col-md-6 col-lg-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="passwordRequireLowercase" name="passwordRequireLowercase"><label class="form-check-label" for="passwordRequireLowercase">@Localizer["RequireLowercase"]</label></div></div>
                <div class="col-12 col-md-6 col-lg-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="passwordRequireDigit" name="passwordRequireDigit"><label class="form-check-label" for="passwordRequireDigit">@Localizer["RequireDigit"]</label></div></div>
                <div class="col-12 col-md-6 col-lg-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="passwordRequireSpecialChar" name="passwordRequireSpecialChar"><label class="form-check-label" for="passwordRequireSpecialChar">@Localizer["RequireSpecialChar"]</label></div></div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">@Localizer["SessionLockoutPolicy"]</h6>
            </div>
            <div class="card-body row g-3">
                <div class="col-12 col-md-3"><label class="form-label" for="sessionTimeoutMinutes">@Localizer["SessionTimeoutMinutes"] <span class="text-danger">*</span></label><input type="number" id="sessionTimeoutMinutes" name="sessionTimeoutMinutes" class="form-control" min="5" max="1440" required><div class="invalid-feedback" data-valmsg-for="SessionTimeoutMinutes"></div></div>
                <div class="col-12 col-md-3"><label class="form-label" for="refreshTokenLifetimeDays">@Localizer["RefreshTokenLifetimeDays"] <span class="text-danger">*</span></label><input type="number" id="refreshTokenLifetimeDays" name="refreshTokenLifetimeDays" class="form-control" min="1" max="365" required><div class="invalid-feedback" data-valmsg-for="RefreshTokenLifetimeDays"></div></div>
                <div class="col-12 col-md-3"><label class="form-label" for="maxFailedLoginAttempts">@Localizer["MaxFailedLoginAttempts"] <span class="text-danger">*</span></label><input type="number" id="maxFailedLoginAttempts" name="maxFailedLoginAttempts" class="form-control" min="1" max="20" required><div class="invalid-feedback" data-valmsg-for="MaxFailedLoginAttempts"></div></div>
                <div class="col-12 col-md-3"><label class="form-label" for="lockoutDurationMinutes">@Localizer["LockoutDurationMinutes"] <span class="text-danger">*</span></label><input type="number" id="lockoutDurationMinutes" name="lockoutDurationMinutes" class="form-control" min="1" max="1440" required><div class="invalid-feedback" data-valmsg-for="LockoutDurationMinutes"></div></div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">@Localizer["AccessRestrictions"]</h6>
            </div>
            <div class="card-body row g-3">
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="ipWhitelistEnabled" name="ipWhitelistEnabled">
                        <label class="form-check-label" for="ipWhitelistEnabled">@Localizer["IpWhitelistEnabled"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="allowedIps">@Localizer["AllowedIps"]</label>
                    <textarea id="allowedIps" name="allowedIps" class="form-control" rows="3" placeholder="192.168.0.1&#10;2001:db8::1"></textarea>
                    <div class="form-text">@Localizer["AllowedIpsHint"]</div>
                    <div class="invalid-feedback" data-valmsg-for="AllowedIps"></div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="allowedCountries">@Localizer["AllowedCountries"]</label>
                    <textarea id="allowedCountries" name="allowedCountries" class="form-control" rows="3" placeholder="TR&#10;US&#10;DE"></textarea>
                    <div class="form-text">@Localizer["AllowedCountriesHint"]</div>
                    <div class="invalid-feedback" data-valmsg-for="AllowedCountries"></div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Governance/TenantSecuritySettings/index.js" asp-append-version="true"></script>
}
