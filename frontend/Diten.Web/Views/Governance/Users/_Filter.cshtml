@using Diten.Web.Views.Governance.Users
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<UsersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@SharedLocalizer["Status"]">
                            @* Values are the SERVICE's words (GET api/users?status=Active|Inactive|Invited) — the filter runs on
                               AuthService, which refuses any other word (USERS_LIST_STATUS_INVALID). The label stays "Pasif". *@
                            <option value="Active">@SharedLocalizer["Active"]</option>
                            <option value="Inactive">@SharedLocalizer["Passive"]</option>
                            @* WP-AUTH-INVITED-LIFECYCLE-01 — the third state: invited, password never set. *@
                            <option value="Invited">@Localizer["StatusInvited"]</option>
                        </select>
                    </div>

                    @* Role filter — option VALUES are role ids (the service's roleId is a Guid), texts the role names;
                       filled from GET api/roles by index.js. *@
                    <div class="filter-chip filter-roles">
                        <select id="filterRoles" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Roles"]"></select>
                    </div>

                    @* WP-INFRA-AUTH-ACCOUNT-KIND-01 — option values are the AuthService enum NAMES (the DTO carries the
                       name as a string, never the number); labels are the tenant's own seven-language resx. *@
                    <div class="filter-chip filter-account-kind">
                        <select id="filterAccountKind" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["AccountKind"]">
                            <option value="Unknown">@Localizer["AccountKindUnknown"]</option>
                            <option value="Human">@Localizer["AccountKindHuman"]</option>
                            <option value="Service">@Localizer["AccountKindService"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
