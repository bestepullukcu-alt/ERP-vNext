@model Diten.Web.Models.Governance.UserEditViewModel
@using Diten.Web.Views.Governance.Users
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<UsersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCreateEdit" aria-labelledby="offcanvasCreateEditLabel">
    <div class="offcanvas-header p-4">
        <h5 id="offcanvasCreateEditLabel" class="offcanvas-title">-</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body border-top p-4">
        <div id="formUserAlert" class="alert alert-danger d-none" role="alert"></div>

        <form id="formUser" class="pt-0" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="userItemId" name="Id" value="" />

            <div class="row g-4">
                <div class="col-12">
                    <label for="userEmail" class="form-label fw-medium">
                        @Localizer["Email"] <span class="text-danger">*</span>
                    </label>
                    @* bx-envelope — the address the invitation is actually sent to, which is what this field IS. *@
                    <div class="diten-field">
                        <i class="bx bx-envelope diten-field-icon" aria-hidden="true"></i>
                        <input type="email" id="userEmail" name="Email" class="form-control" maxlength="256" placeholder="@Localizer["EmailPlaceholder"]" required />
                    </div>
                    <div class="form-text d-none" id="userEmailHelp">@Localizer["EmailImmutableHint"]</div>
                    <div class="invalid-feedback"></div>
                </div>

                <div class="col-12">
                    <label for="userFirstName" class="form-label fw-medium">
                        @Localizer["FirstName"] <span class="text-danger">*</span>
                    </label>
                    @* bx-user for BOTH name halves, deliberately. They are the same kind of thing — a person's name —
                       and the golden reference already pairs one glyph with two fields where that is true
                       (EffectiveDate/ExpirationDate both wear bx-calendar). Differentiating them would claim a
                       distinction that is not there. *@
                    <div class="diten-field">
                        <i class="bx bx-user diten-field-icon" aria-hidden="true"></i>
                        <input type="text" id="userFirstName" name="FirstName" class="form-control" maxlength="128" placeholder="@Localizer["FirstNamePlaceholder"]" required />
                    </div>
                    <div class="invalid-feedback"></div>
                </div>

                <div class="col-12">
                    <label for="userLastName" class="form-label fw-medium">
                        @Localizer["LastName"] <span class="text-danger">*</span>
                    </label>
                    <div class="diten-field">
                        <i class="bx bx-user diten-field-icon" aria-hidden="true"></i>
                        <input type="text" id="userLastName" name="LastName" class="form-control" maxlength="128" placeholder="@Localizer["LastNamePlaceholder"]" required />
                    </div>
                    <div class="invalid-feedback"></div>
                </div>

                @* WP-INFRA-AUTH-ACCOUNT-KIND-01 — account classification. UAS-001 shape: a caller without
                   auth.users.account-kind.manage gets NO control here (not a disabled one), and the backend refuses a
                   supplied kind CHANGE from such a caller with 403 anyway — this gate is display only.
                   WP-AUTH-USER-KIND-UPDATE-01 — the same select on create AND edit, saved by the form's own button:
                   UpdateUser carries the kind and takes it through the same writer + audit row as the quick view's
                   "Change type". On edit the empty option means "back to Unknown" (the proxy sends it as such).
                   Deliberately not a .diten-field wrapper: the offcanvas icon map pins the three typed fields. *@
                @if (Perms.Has("auth.users.account-kind.manage"))
                {
                    <div class="col-12" id="userAccountKindRow">
                        <label for="userAccountKind" class="form-label fw-medium">@Localizer["AccountKind"]</label>
                        <select id="userAccountKind" name="AccountKind" class="form-select select2-offcanvas">
                            <option value="">@Localizer["AccountKindUnknown"]</option>
                            <option value="Human">@Localizer["AccountKindHuman"]</option>
                            <option value="Service">@Localizer["AccountKindService"]</option>
                        </select>
                        @* "Leave unset…" is a create-time sentence; on edit the empty option is a choice, so the hint hides. *@
                        <div class="form-text" id="userAccountKindCreateHint">@Localizer["AccountKindCreateHint"]</div>
                    </div>
                }

                @* Invitation flow: no password field. A "set your password" link is emailed to the
                   new user; they activate the account themselves via /account/set-password.
                   Shown only on create (toggled in index.js); kept at the bottom, below Last Name. *@
                <div class="col-12" id="userInviteHint">
                    <div class="alert alert-info mb-0 py-2 px-3 small" role="alert">
                        <i class="bx bx-envelope me-1"></i>@Localizer["InviteHint"]
                    </div>
                </div>

                <div class="col-12 d-none" id="userActiveRow">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" id="userIsActive" class="form-check-input" role="switch" />
                        <label for="userIsActive" class="form-check-label ms-2">@SharedLocalizer["Active"]</label>
                    </div>
                </div>
                @* WP-AUTH-INVITED-LIFECYCLE-01 — an invited account is activated by its owner redeeming the link, never
                   from here: index.js hides the switch above for it and shows this sentence instead. AuthService refuses
                   the activation too (409 USER_INVITATION_PENDING), so the hidden switch is not the only defence. *@
                <div class="col-12 d-none" id="userInvitePendingRow">
                    <div class="form-text">@Localizer["InvitationPendingHint"]</div>
                </div>
            </div>
        </form>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" id="btnSaveUser" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>
