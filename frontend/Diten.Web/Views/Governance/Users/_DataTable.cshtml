@using Diten.Web.Views.Governance.Users
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<UsersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // The table card is a component (BL-440): the page describes it, _ListShell renders it. The page keeps its
    // own words — every header is localized HERE, the shell produces no text.
    //
    // SERVER data (BL-440 package 5): AuthService pages, sorts and filters; the JS declares the same mode.
    //
    // NO SELECTION COLUMN, deliberately (K17): AuthService has no bulk endpoint for users, so a checkbox would select
    // into nothing — the very defect this screen had (bulk JS bound to a column its markup never drew).
    var listShell = new DataTableListShellViewModel
    {
        TableId = "dt-users",
        DataMode = "server",
        Slug = "users",
        HasSelection = false,
        Columns =
        [
            new DataTableColumnViewModel { Header = Localizer["Email"].Value, CssClass = "all" },
            new DataTableColumnViewModel { Header = Localizer["FirstName"].Value },
            new DataTableColumnViewModel { Header = Localizer["LastName"].Value },
            new DataTableColumnViewModel { Header = Localizer["Roles"].Value },
            // WP-INFRA-AUTH-ACCOUNT-KIND-01 — the account FACT AuthService asserts (Unknown/Human/Service). Display only.
            new DataTableColumnViewModel { Header = Localizer["AccountKind"].Value },
            new DataTableColumnViewModel { Header = SharedLocalizer["Status"].Value }
        ],
        ActionsHeader = Localizer["Actions"].Value
    };
}

<partial name="~/Views/Shared/Components/DataTable/_ListShell.cshtml" model="listShell" />
