@using Diten.Web.Views.Governance.Users
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<UsersIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["UsersTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@*
    UAS-001 — see Governance/Roles/Index.cshtml for the reasoning. Nothing below is drawn without
    auth.users.read: no heading, no KPI cards, no "+ Add User", no empty table.

    ⚠ Display only. AuthService's [HasPermission] on /api/users remains the authority (UAS-001 §4).
*@
@if (!Perms.Has("auth.users.read"))
{
    <partial name="_AccessDenied" model="@Localizer["UsersTitle"].Value" />
    return;
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["UsersTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* KPI cards — AuthService's tenant-wide summary (data.summary of every list response, independent of the filters),
   written by index.js from the factory's onResponse. Never counted from the rows in hand: those are one page. *@
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-4 mb-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-primary"><i class="bx bx-group"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["KpiTotalUsers"]</small>
                    <h5 id="kpi-users-total" class="mb-0 font-monospace">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-success"><i class="bx bx-check-circle"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["KpiActiveUsers"]</small>
                    <h5 id="kpi-users-active" class="mb-0 font-monospace">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-secondary"><i class="bx bx-pause-circle"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["KpiPassiveUsers"]</small>
                    <h5 id="kpi-users-passive" class="mb-0 font-monospace">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-warning"><i class="bx bx-shield-x"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["KpiNoRoleUsers"]</small>
                    <h5 id="kpi-users-norole" class="mb-0 font-monospace">0</h5>
                </div>
            </div>
        </div>
    </div>
</div>

@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/Governance/Users/_Filter.cshtml" />
@* No bulk action bar: the list has no selection column (K17 — no bulk endpoint for users). *@
@* Contract markers are rendered by _DataTable.cshtml: the shared <partial name="_TableSkeleton" /> (which carries id="skeleton-loader"), <table id="dt-users" data-dt-standard="v2"> *@
<partial name="~/Views/Governance/Users/_DataTable.cshtml" />
@* Contract marker rendered by _DetailsQuickView.cshtml: id="offcanvasDetailsPreview" *@
<partial name="~/Views/Governance/Users/_DetailsQuickView.cshtml" />
<partial name="~/Views/Governance/Users/_CreateEditOffcanvas.cshtml" />

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/Governance/Users/_IndexL10n.cshtml" />
    <script src="~/assets/js/Governance/Users/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Governance/Users/index.js" asp-append-version="true"></script>
}
