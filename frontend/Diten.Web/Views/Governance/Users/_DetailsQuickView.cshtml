@using Diten.Web.Views.Governance.Users
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<UsersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms

<div class="offcanvas offcanvas-end backbone-preview-offcanvas" tabindex="-1" id="offcanvasDetailsPreview"
    aria-labelledby="offcanvasDetailsPreviewLabel">
    <div class="offcanvas-header p-4">
        <div class="d-flex align-items-center min-w-0">
            <div class="backbone-preview-avatar d-flex align-items-center justify-content-center me-3 flex-shrink-0">
                <i class="bx bx-user fs-4"></i>
            </div>
            <div class="min-w-0">
                <h5 id="oc-title" class="offcanvas-title mb-0 text-truncate">-</h5>
                <small id="oc-subtitle" class="text-muted d-block text-truncate">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-4 border-top">
        <div class="d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-3 backbone-preview-section-title">@Localizer["GeneralInformation"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-envelope"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["Email"]</div>
                                <div id="oc-email" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-user"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["FirstName"]</div>
                                <div id="oc-firstname" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-user"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["LastName"]</div>
                                <div id="oc-lastname" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-shield-quarter"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["Roles"]</div>
                                <div id="oc-roles" class="backbone-preview-value mt-1 d-flex flex-wrap gap-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-id-card"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["AccountKind"]</div>
                                <div class="mt-1 d-flex align-items-center flex-wrap gap-2">
                                    <span id="oc-accountkind" class="badge bg-label-secondary">-</span>
                                    @* WP-INFRA-AUTH-ACCOUNT-KIND-01 — "Change type" is drawn ONLY for a holder of the
                                       explicit-grant-only key (UAS-001: no disabled control for the others). The confirm
                                       goes through window.showConfirm (BL-367, one dialog body); the POST goes through
                                       /Users/api/{id}/account-kind, never to a service port. *@
                                    @if (Perms.Has("auth.users.account-kind.manage"))
                                    {
                                        <select id="oc-accountkind-select" class="form-select form-select-sm w-auto" aria-label="@Localizer["AccountKind"]">
                                            <option value="Unknown">@Localizer["AccountKindUnknown"]</option>
                                            <option value="Human">@Localizer["AccountKindHuman"]</option>
                                            <option value="Service">@Localizer["AccountKindService"]</option>
                                        </select>
                                        <button type="button" id="oc-btn-accountkind" class="btn btn-sm btn-label-primary">@Localizer["ChangeAccountKind"]</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-check-shield"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@SharedLocalizer["Status"]</div>
                                <div class="mt-1">
                                    <span id="oc-status" class="badge bg-label-secondary">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-3 backbone-preview-section-title">@Localizer["SecurityMetrics"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-history"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["LastLogin"]</div>
                                <div id="oc-lastlogin" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-error-circle"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["FailedLogins"]</div>
                                <div id="oc-failedlogins" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-shield-quarter"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["MFAStatus"]</div>
                                <div class="mt-1">
                                    <span id="oc-mfastatus" class="badge bg-label-secondary">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2 bg-white">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" id="oc-btn-edit" class="btn btn-primary" data-bs-dismiss="offcanvas">@SharedLocalizer["EditRecord"]</button>
    </div>
</div>
