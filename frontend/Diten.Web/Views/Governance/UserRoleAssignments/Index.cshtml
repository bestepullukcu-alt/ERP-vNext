@using Diten.Web.Views.Governance.UserRoleAssignments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<UserRoleAssignmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["Title"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<form id="uraAntiForgery">@Html.AntiForgeryToken()</form>

<div class="row g-4">
    @* ── LEFT: user picker + state tabs + assigned / unassigned role cards ─────────────────────── *@
    <div class="col-12 col-lg-8">
        @* User + search — one equal-width responsive grid, mirrors the RoleAssignments filter card. *@
        <div class="card mb-4">
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label for="uraUserSelect" class="form-label fw-medium mb-1">@Localizer["SelectUser"]</label>
                        <select id="uraUserSelect" class="form-select ra-select2">
                            <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="uraSearch" class="form-label fw-medium mb-1">@Localizer["SearchRolesLabel"]</label>
                        <input type="search" id="uraSearch" class="form-control" placeholder="@Localizer["SearchRoles"]" />
                    </div>
                </div>
            </div>
        </div>

        @* State filter — pill tabs. JS toggles .active + data-state. Assigned tab shows a live count. *@
        <div class="card mb-4">
            <div class="card-header p-3">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <ul class="nav nav-pills d-inline-flex gap-2 mb-0" role="tablist" aria-label="@Localizer["Title"]">
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link active small border shadow-none wc-tab-compact ura-state-tab" data-state="" aria-selected="true">@Localizer["FilterAll"]</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link small border shadow-none wc-tab-compact ura-state-tab" data-state="assigned" aria-selected="false">
                                @Localizer["FilterAssigned"] <span class="ura-tab-count" id="uraAssignedCount"></span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link small border shadow-none wc-tab-compact ura-state-tab" data-state="unassigned" aria-selected="false">@Localizer["FilterUnassigned"]</button>
                        </li>
                    </ul>
                    <span id="uraSummary" class="text-muted small ms-auto"></span>
                </div>
            </div>
        </div>

        <div id="uraAlert" class="alert alert-danger d-none" role="alert"></div>

        @* Prompt shown until a user is selected (roles are user-relative). *@
        <div id="uraEmpty" class="card">
            <div class="card-body text-center text-muted py-6">@Localizer["SelectUserPrompt"]</div>
        </div>

        @* Assigned + unassigned sections (JS fills the lists; section wrappers hide when empty). *@
        <div id="uraContent" class="d-none" aria-live="polite">
            <div id="uraAssignedSection" class="card mb-4">
                <div class="card-header p-3">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["AssignedRolesSection"]</h6>
                </div>
                <div class="card-body px-3 pb-3">
                    <div id="uraAssignedList" class="d-flex flex-column gap-2"></div>
                </div>
            </div>
            <div id="uraUnassignedSection" class="card">
                <div class="card-header p-3">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["UnassignedRolesSection"]</h6>
                </div>
                <div class="card-body px-3 pb-3">
                    <div id="uraUnassignedList" class="d-flex flex-column gap-2"></div>
                </div>
            </div>
        </div>
    </div>

    @* ── RIGHT: selected-user summary + active roles ──────────────────────────────────────────── *@
    <div class="col-12 col-lg-4">
        <div id="uraUserPanel" class="ra-role-panel d-none">
            @* 1) Selected user card *@
            <div class="card mb-4">
                <div class="card-body p-3">
                    <h6 class="text-uppercase text-heading fw-semibold mb-3">@Localizer["SelectedUserTitle"]</h6>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="avatar flex-shrink-0">
                            <span class="avatar-initial rounded-circle bg-label-primary" id="uraUserInitials"></span>
                        </span>
                        <div class="min-w-0">
                            <h5 class="mb-0 text-truncate" id="uraUserName"></h5>
                            <small class="text-muted text-truncate d-block" id="uraUserEmail"></small>
                            <small class="text-muted d-none align-items-center gap-1 mt-1 d-flex" id="uraUserLastLoginWrap">
                                <i class="bx bx-time-five"></i><span id="uraUserLastLogin"></span>
                            </small>
                        </div>
                    </div>
                    <div class="row row-cols-2 g-3">
                        <div class="col">
                            <div class="ura-stat-tile text-center">
                                <h4 class="mb-0 font-monospace" id="uraStatRoles">0</h4>
                                <small class="text-muted">@Localizer["StatAssignedRoles"]</small>
                            </div>
                        </div>
                        <div class="col">
                            <div class="ura-stat-tile text-center">
                                <h4 class="mb-0 font-monospace" id="uraStatPerms">0</h4>
                                <small class="text-muted">@Localizer["StatTotalPermissions"]</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* 2) Active roles card *@
            <div class="card mb-4">
                <div class="card-body p-3">
                    <h6 class="text-uppercase text-heading fw-semibold mb-3">@Localizer["ActiveRolesTitle"]</h6>
                    <div id="uraActiveList" class="d-flex flex-column gap-2"></div>
                    <p class="text-muted small mb-0 d-none" id="uraActiveEmpty">@Localizer["NoActiveRoles"]</p>
                </div>
            </div>

            @* 3) Multi-role note *@
            <div class="alert alert-info d-flex align-items-center mb-0 p-3" role="note">
                <i class="bx bx-info-circle fs-5 me-2"></i>
                <span>@Localizer["MultiRoleNote"]</span>
            </div>
        </div>
    </div>
</div>

@* ── Templates (cloned by JS; no inline markup generation) ────────────────────────────────────── *@
<template id="uraRoleCardTemplate">
    <div class="entity-row-card ura-role-card d-flex align-items-center gap-3">
        <span class="avatar flex-shrink-0">
            <span class="avatar-initial rounded ura-role-icon"><i class="bx bx-shield-quarter"></i></span>
        </span>
        <div class="min-w-0 flex-grow-1">
            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <span class="fw-medium text-truncate ura-role-name"></span>
                <code class="ura-role-code text-muted small"></code>
                <span class="badge bg-label-success ura-role-assigned-badge d-none">
                    <i class="bx bx-check"></i> <span class="ura-role-assigned-text"></span>
                </span>
                <span class="badge ura-role-type-badge d-none"></span>
            </div>
            <small class="text-muted d-block ura-role-desc"></small>
        </div>
        <div class="flex-shrink-0 d-flex align-items-center gap-3">
            <span class="text-muted small text-nowrap ura-role-permcount">
                <i class="bx bx-shield"></i> <span class="ura-role-permcount-text"></span>
            </span>
            <button type="button" class="btn btn-sm btn-label-primary ura-assign d-none">
                <i class="bx bx-plus me-1"></i><span class="ura-assign-text"></span>
            </button>
            <button type="button" class="btn btn-sm btn-label-danger ura-remove d-none">
                <i class="bx bx-minus me-1"></i><span class="ura-remove-text"></span>
            </button>
        </div>
    </div>
</template>

<template id="uraActiveRowTemplate">
    <div class="entity-row-card ura-active-row d-flex align-items-center gap-3">
        <span class="avatar avatar-sm flex-shrink-0">
            <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-shield-quarter"></i></span>
        </span>
        <div class="min-w-0 flex-grow-1">
            <span class="fw-medium d-block text-truncate ura-active-name"></span>
            <small class="text-muted ura-active-permcount"></small>
        </div>
        <button type="button" class="btn btn-icon btn-sm btn-text-secondary rounded-pill ura-active-remove flex-shrink-0" aria-label="@Localizer["Remove"]">
            <i class="bx bx-x"></i>
        </button>
    </div>
</template>

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="~/Views/Governance/UserRoleAssignments/_IndexL10n.cshtml" />
    <script src="~/assets/js/Governance/UserRoleAssignments/role-assign-state.js" asp-append-version="true"></script>
    <script src="~/assets/js/Governance/UserRoleAssignments/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Governance/UserRoleAssignments/index.js" asp-append-version="true"></script>
}
