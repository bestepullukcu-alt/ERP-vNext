@using Diten.Web.Views.Governance.UserRoleAssignments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<UserRoleAssignmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["Title"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<form id="uraAntiForgery">@Html.AntiForgeryToken()</form>

<div class="card">
    <div class="card-header d-flex flex-wrap align-items-center gap-3">
        <div class="flex-grow-1" style="min-width:14rem; max-width:28rem;">
            <label for="uraUserSelect" class="form-label fw-medium mb-1">@Localizer["SelectUser"]</label>
            <select id="uraUserSelect" class="form-select">
                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
            </select>
        </div>
        <div class="flex-grow-1" style="min-width:12rem; max-width:20rem;">
            <label for="uraSearch" class="form-label fw-medium mb-1">@SharedLocalizer["Search"]</label>
            <input type="search" id="uraSearch" class="form-control" placeholder="@Localizer["SearchRoles"]" />
        </div>
    </div>

    <div class="card-body">
        <div id="uraAlert" class="alert alert-danger d-none" role="alert"></div>
        <div id="uraEmpty" class="text-center text-muted py-6">@Localizer["SelectUserPrompt"]</div>
        <div id="uraList" class="list-group list-group-flush d-none"></div>
    </div>
</div>

<template id="uraRowTemplate">
    <div class="list-group-item d-flex align-items-center justify-content-between gap-3 ura-row">
        <div class="min-w-0">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-medium text-heading ura-display"></span>
                <span class="badge bg-label-success ura-assigned-badge d-none">@Localizer["Assigned"]</span>
            </div>
            <small class="ura-name text-muted d-block text-truncate"></small>
        </div>
        <div class="flex-shrink-0 d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-label-primary ura-assign d-none">@Localizer["Assign"]</button>
            <button type="button" class="btn btn-sm btn-label-danger ura-remove d-none">@SharedLocalizer["Delete"]</button>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="~/Views/Governance/UserRoleAssignments/_IndexL10n.cshtml" />
    <script src="~/assets/js/Governance/UserRoleAssignments/role-assign-state.js" asp-append-version="true"></script>
    <script src="~/assets/js/Governance/UserRoleAssignments/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Governance/UserRoleAssignments/index.js" asp-append-version="true"></script>
}
