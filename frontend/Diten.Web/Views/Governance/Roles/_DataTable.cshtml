@using Diten.Web.Views.Governance.Roles
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<RolesIndex> Localizer
@{
    // The table card is a component (BL-440): the page describes it, _ListShell renders it. The page keeps its
    // own words — every header is localized HERE, the shell produces no text.
    //
    // CLIENT data (WP-ROLES-CLOSE-01): a tenant's roles are a bounded set (pack: data_mode_max_rows 200) and
    // AuthService returns all of them in one request; the JS declares the same mode.
    //
    // NO SELECTION COLUMN, deliberately: AuthService has no bulk endpoint for roles, so a checkbox would select
    // into nothing — the defect this screen had (bulk JS bound to a column its markup never drew).
    var listShell = new DataTableListShellViewModel
    {
        TableId = "dt-roles",
        DataMode = "client",
        Slug = "roles",
        HasSelection = false,
        Columns =
        [
            new DataTableColumnViewModel { Header = Localizer["Name"].Value },
            new DataTableColumnViewModel { Header = Localizer["DisplayName"].Value, CssClass = "all" },
            new DataTableColumnViewModel { Header = Localizer["RoleType"].Value },
            new DataTableColumnViewModel { Header = Localizer["PermissionCount"].Value },
            new DataTableColumnViewModel { Header = Localizer["UserCount"].Value }
        ],
        ActionsHeader = Localizer["Actions"].Value
    };
}

<partial name="~/Views/Shared/Components/DataTable/_ListShell.cshtml" model="listShell" />
