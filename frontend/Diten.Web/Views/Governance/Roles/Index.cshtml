@using Diten.Web.Views.Governance.Roles
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<RolesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["RolesTitle"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["RolesTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* KPI cards — live counts computed client-side from the loaded roles dataset (see index.js). *@
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-4 mb-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-primary"><i class="bx bx-shield-quarter"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["KpiTotalRoles"]</small>
                    <h5 id="kpi-roles-total" class="mb-0 font-monospace">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-info"><i class="bx bx-lock-alt"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["KpiSystemRoles"]</small>
                    <h5 id="kpi-roles-system" class="mb-0 font-monospace">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-success"><i class="bx bx-user-pin"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["KpiCustomRoles"]</small>
                    <h5 id="kpi-roles-custom" class="mb-0 font-monospace">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-warning"><i class="bx bx-group"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["KpiAssignedUsers"]</small>
                    <h5 id="kpi-roles-users" class="mb-0 font-monospace">0</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Governance/Roles/_Filter.cshtml" />
<partial name="~/Views/Governance/Roles/_DataTable.cshtml" />
<partial name="~/Views/Governance/Roles/_DetailsQuickView.cshtml" />
<partial name="~/Views/Governance/Roles/_CreateEditOffcanvas.cshtml" />

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="~/Views/Governance/Roles/_IndexL10n.cshtml" />
    <script src="~/assets/js/Governance/Roles/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Governance/Roles/index.js" asp-append-version="true"></script>
}
