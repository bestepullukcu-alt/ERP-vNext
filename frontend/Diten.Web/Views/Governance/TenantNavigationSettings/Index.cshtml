@using Diten.Web.Views.Governance.TenantNavigationSettings
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantNavigationSettingsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0">@Localizer["Title"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-2">
        <button type="button" id="btnResetTenantNav" class="btn btn-label-secondary">
            <i class="bx bx-revision me-1"></i>@Localizer["ResetToDefault"]
        </button>
        <button type="button" id="btnSaveTenantNav" class="btn btn-primary">
            <i class="bx bx-save me-1"></i>@SharedLocalizer["Save"]
        </button>
    </div>
</div>

<div class="alert alert-info d-flex align-items-start mb-4 p-3" role="note">
    <i class="bx bx-info-circle me-2 mt-1"></i>
    <div>@Localizer["SidebarRefreshHint"]</div>
</div>

<div id="tenantNavAlert" class="alert alert-danger d-none" role="alert"></div>

<div id="tenantNavRoot" data-menu-url="/TenantNavigation/api/menu" data-prefs-url="/TenantNavigation/api/preferences"
     data-l-col-name="@Localizer["ColName"]" data-l-col-visibility="@Localizer["ColVisibility"]"
     data-l-visible-suffix="@Localizer["VisibleSuffix"]" data-l-hidden-group="@Localizer["HiddenGroup"]"
     data-l-rename-placeholder="@Localizer["RenamePlaceholder"]" data-l-show-hide="@Localizer["ShowHide"]"
     data-l-no-modules="@Localizer["NoModules"]">
    <div class="row g-4">
        @* ── LEFT: editor ── *@
        <div class="col-12 col-lg-8">
            <div id="tenantNavLoading" class="card mb-4">
                <div class="card-body text-center text-muted py-6">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@Localizer["Loading"]
                </div>
            </div>

            <div id="tenantNavEmpty" class="card mb-4 d-none">
                <div class="card-body text-center text-muted py-6">@Localizer["NoModules"]</div>
            </div>

            @* JS renders one collapsible card per domain group. *@
            <div id="tenantNavGroups"></div>
        </div>

        @* ── RIGHT: live preview + stats ── *@
        <div class="col-12 col-lg-4">
            <div class="tnav-sticky">
                <div class="card mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["MenuPreview"]</h6>
                            <span class="badge bg-label-primary" id="tnavPreviewCount">0</span>
                        </div>

                        <div class="tnav-preview">
                            <div class="tnav-preview-brand">
                                @await Component.InvokeAsync("TenantBrand", new { preview = true })
                            </div>
                            <div class="tnav-preview-body" id="tnavPreviewBody"></div>
                        </div>

                        <p class="text-muted small mt-3 mb-0">@Localizer["PreviewNote"]</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="card h-100">
                            <div class="card-body p-3 text-center">
                                <div class="tnav-stat-value" id="tnavStatTotal">0</div>
                                <div class="small text-muted">@Localizer["StatTotal"]</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card h-100">
                            <div class="card-body p-3 text-center">
                                <div class="tnav-stat-value text-success" id="tnavStatVisible">0</div>
                                <div class="small text-muted">@Localizer["StatVisible"]</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card h-100">
                            <div class="card-body p-3 text-center">
                                <div class="tnav-stat-value text-secondary" id="tnavStatHidden">0</div>
                                <div class="small text-muted">@Localizer["StatHidden"]</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card h-100">
                            <div class="card-body p-3 text-center">
                                <div class="tnav-stat-value text-warning" id="tnavStatChanged">0</div>
                                <div class="small text-muted">@Localizer["StatChanged"]</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Governance/TenantNavigationSettings/_IndexL10n.cshtml" />
    <script src="~/assets/vendor/libs/sortablejs/sortable.js" asp-append-version="true"></script>
    <script src="~/assets/js/Governance/TenantNavigationSettings/index.js" asp-append-version="true"></script>
}
