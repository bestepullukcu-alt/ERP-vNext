@using Diten.Web.Views.Governance.Permissions
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PermissionsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-permissions" data-dt-standard="v2" class="datatables-permissions table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input" disabled></th>
                    <th class="all">@Localizer["Key"]</th>
                    <th>@Localizer["Module"]</th>
                    <th>@Localizer["Resource"]</th>
                    <th>@Localizer["Action"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
