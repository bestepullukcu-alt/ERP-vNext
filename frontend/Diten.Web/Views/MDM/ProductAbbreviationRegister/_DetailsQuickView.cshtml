@using Diten.Web.Views.MDM.ProductAbbreviationRegister
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProductAbbreviationRegisterIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDetailsPreview"
     aria-labelledby="offcanvasDetailsPreviewLabel" style="width: 560px;">
    <div class="offcanvas-header border-bottom">
        <div>
            <h5 id="offcanvasDetailsPreviewLabel" class="offcanvas-title">@Localizer["DetailsTitle"]</h5>
            <small id="oc-subtitle" class="text-muted">-</small>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body">
        <div class="bg-label-secondary rounded p-3 mb-4">
            <span class="d-block text-muted small fw-medium mb-1">@Localizer["LifecycleStatus"]</span>
            <span id="oc-status" class="badge bg-label-secondary">-</span>
        </div>
        <dl class="row mb-4">
            <dt class="col-5">@Localizer["GlobalProduct"]</dt><dd id="oc-global-product" class="col-7">-</dd>
            <dt class="col-5">@Localizer["Abbreviation"]</dt><dd id="oc-abbreviation" class="col-7">-</dd>
            <dt class="col-5">@Localizer["Version"]</dt><dd id="oc-version" class="col-7">-</dd>
            <dt class="col-5">@Localizer["RetirementPending"]</dt><dd id="oc-retirement-pending" class="col-7">-</dd>
        </dl>
        <section id="auditEvidenceSection" class="d-none" aria-live="polite">
            <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["AuditEvidence"]</h6>
            <div id="auditEvidenceLoading" class="text-muted">@Localizer["AuditLoading"]</div>
            <div id="auditEvidenceEmpty" class="text-muted d-none">@Localizer["AuditEmpty"]</div>
            <div id="auditEvidenceList" class="d-grid gap-3"></div>
        </section>
    </div>
</div>
