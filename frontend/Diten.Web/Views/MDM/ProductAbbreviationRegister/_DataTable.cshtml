@using Diten.Web.Views.MDM.ProductAbbreviationRegister
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProductAbbreviationRegisterIndex> Localizer
@{
    // WP-MDM-ABB-LIST-01 (BL-440) — the table card is the shared component: the page describes it, _ListShell renders
    // it with the shared shaped skeleton. Every header is localized HERE; the shell produces no text.
    //
    // SERVER data: the list pages, searches and sorts on the server (the MVC proxy over MDM's one-product entry list;
    // orderBy whitelist: abbreviation, lifecycleStatus, version, retirementPending — anything else is 400). index.js
    // declares the same mode.
    //
    // NO SELECTION COLUMN, deliberately: an abbreviation is never bulk-deleted or bulk-changed (GxP — every change is its
    // own maker-checker request), so a checkbox would select into nothing.
    var listShell = new DataTableListShellViewModel
    {
        TableId = "dt-product-abbreviation-register",
        DataMode = "server",
        Slug = "product-abbreviation-register",
        HasSelection = false,
        Columns =
        [
            new DataTableColumnViewModel { Header = Localizer["GlobalProduct"].Value },
            new DataTableColumnViewModel { Header = Localizer["Abbreviation"].Value, CssClass = "all" },
            new DataTableColumnViewModel { Header = Localizer["LifecycleStatus"].Value },
            new DataTableColumnViewModel { Header = Localizer["Version"].Value },
            new DataTableColumnViewModel { Header = Localizer["RetirementPending"].Value }
        ],
        ActionsHeader = Localizer["Actions"].Value
    };
}

<partial name="~/Views/Shared/Components/DataTable/_ListShell.cshtml" model="listShell" />
