@using Diten.Web.Views.MDM.ProductAbbreviationRegister
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProductAbbreviationRegisterIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["ProductAbbreviationRegisterTitle"].Value;
    Layout = "_LayoutTenantShell";
    var permissions = User.Claims
        .Where(claim => claim.Type is "permission" or "permissions")
        .SelectMany(claim => claim.Value.Split(new[] { ',', ' ', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        .ToHashSet(StringComparer.Ordinal);
}

<div id="product-abbreviation-register"
     data-can-select-product="@permissions.Contains("mdm.global-products.read").ToString().ToLowerInvariant()"
     data-can-request="@permissions.Contains("mdm.product-abbreviations.request").ToString().ToLowerInvariant()"
     data-can-correct="@permissions.Contains("mdm.product-abbreviations.correct").ToString().ToLowerInvariant()"
     data-can-retire="@permissions.Contains("mdm.product-abbreviations.retire").ToString().ToLowerInvariant()"
     data-can-audit="@permissions.Contains("mdm.product-abbreviations.audit").ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()
    @* Golden contract marker: <partial name="_Filter" />; actual absolute include below. *@
    <partial name="~/Views/MDM/ProductAbbreviationRegister/_Filter.cshtml" />
    @if (!permissions.Contains("mdm.global-products.read"))
    {
        <div class="alert alert-info" role="status">@Localizer["SelectorPermissionRequired"]</div>
    }

    <div class="mb-3">
        <h5 class="mb-0">@Localizer["ProductAbbreviationRegisterTitle"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>

    <div id="bulkActionBar" class="card mb-4 d-none">
        <div class="card-body d-flex align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bx bx-check-circle text-primary icon-md"></i>
                <span id="bulkSelectedCount" class="fw-medium text-heading">0</span>
                <span class="text-muted">@SharedLocalizer["SelectedCount"]</span>
            </div>
            <button type="button" id="btnClearSelection" class="btn btn-label-secondary">
                @SharedLocalizer["ClearSelection"]
            </button>
        </div>
    </div>

    <partial name="~/Views/MDM/ProductAbbreviationRegister/_DataTable.cshtml" />
    @* The details partial renders id="offcanvasDetailsPreview". *@
    <partial name="~/Views/MDM/ProductAbbreviationRegister/_DetailsQuickView.cshtml" />
    @if (permissions.Contains("mdm.product-abbreviations.request") && permissions.Contains("mdm.global-products.read"))
    {
        <partial name="~/Views/MDM/ProductAbbreviationRegister/_CreateEditOffcanvas.cshtml" />
    }
</div>

@section Scripts {
    @* Golden contract marker: <partial name="_IndexL10n" />; actual absolute include below. *@
    <partial name="~/Views/MDM/ProductAbbreviationRegister/_IndexL10n.cshtml" />
    <script src="~/assets/js/MDM/ProductAbbreviationRegister/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/MDM/ProductAbbreviationRegister/index.js" asp-append-version="true"></script>
}
