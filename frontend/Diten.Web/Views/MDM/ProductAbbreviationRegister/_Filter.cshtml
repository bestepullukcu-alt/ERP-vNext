@using Diten.Web.Views.MDM.ProductAbbreviationRegister
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProductAbbreviationRegisterIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-global-product flex-grow-1">
                        <select id="filterGlobalProduct" class="form-select form-select-sm select2"
                                data-placeholder="@Localizer["SelectGlobalProduct"]"
                                aria-label="@Localizer["SelectGlobalProduct"]"></select>
                        @* WP-MDM-ABB-LIST-01 — the list component's filter fields: the product picker (a paged MDM
                           search) writes the chosen product's id and its display text here, so the applied filter and
                           the saved view carry both and a saved product is shown by name, not by id. *@
                        @* LIST-FIX3 item 2 — the controlled copy's "filters" line names the product by its label and text
                           ("Global Product: CODE — Name"); the id is the wire value only and is never described. *@
                        <input type="hidden" id="filterGlobalProductText" aria-label="@Localizer["GlobalProduct"]" />
                        <input type="hidden" id="filterGlobalProductId" data-dt-describe="false" />
                    </div>
                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
