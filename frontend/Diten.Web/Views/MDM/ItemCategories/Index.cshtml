@model IEnumerable<Diten.Web.Models.Items.ItemCategoryAdminViewModel>
@using Diten.Web.Views.MDM.ItemCategories
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ItemCategoriesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["ItemCategoriesTitle"].Value;
    Layout = "_LayoutBackbone";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" asp-append-version="true" />
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["ItemCategoriesTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<partial name="~/Views/Shared/_ItemsSecondaryNav.cshtml" />
<partial name="_Filter" />

<div id="bulkActionBar" class="card mb-4 d-none">
    <div class="card-body d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bx bx-check-circle text-primary icon-md"></i>
            <span id="bulkSelectedCount" class="fw-medium text-heading">0</span>
            <span class="text-muted" id="bulkSelectedLabel">@SharedLocalizer["SelectedCount"]</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="btnBulkDelete" class="btn btn-label-danger">
                <i class="bx bx-trash me-1"></i> @SharedLocalizer["BulkDelete"]
            </button>
            <button type="button" id="btnClearSelection" class="btn btn-label-secondary">@SharedLocalizer["ClearSelection"]</button>
        </div>
    </div>
</div>

<div class="card">
    <div id="skeleton-loader" class="p-4" style="display: none;">
        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-item-categories" data-dt-standard="v2" class="datatables-item-categories table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["ItemType"]</th>
                    <th>@Localizer["ParentCategory"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th class="cell-fit">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="offcanvasDetailsPreviewLabel" style="width: 460px;">
    <div class="offcanvas-header border-bottom">
        <div>
            <h5 id="oc-title" class="offcanvas-title mb-0">-</h5>
            <small id="oc-subtitle" class="text-muted">-</small>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body">
        <dl class="row mb-0">
            <dt class="col-5">@Localizer["Code"]</dt>
            <dd id="oc-code" class="col-7">-</dd>
            <dt class="col-5">@Localizer["Name"]</dt>
            <dd id="oc-name" class="col-7">-</dd>
            <dt class="col-5">@Localizer["ItemType"]</dt>
            <dd id="oc-itemType" class="col-7">-</dd>
            <dt class="col-5">@Localizer["ParentCategory"]</dt>
            <dd id="oc-parentCategory" class="col-7">-</dd>
            <dt class="col-5">@Localizer["Description"]</dt>
            <dd id="oc-description" class="col-7">-</dd>
        </dl>
    </div>
    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between">
        <button type="button" class="btn btn-label-secondary w-50 me-2" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" id="oc-btn-edit" class="btn btn-primary w-50">@Localizer["EditBtn"]</button>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCategoryEditor" style="width: 560px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="categoryEditorTitle">@Localizer["AddNewItemCategories"]</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body">
        <form id="categoryEditorForm" class="d-flex flex-column gap-4">
            <input type="hidden" id="CategoryId" />
            <div>
                <label class="form-label">@Localizer["Code"]</label>
                <input type="text" class="form-control" id="CategoryCode" />
            </div>
            <div>
                <label class="form-label">@Localizer["Name"]</label>
                <input type="text" class="form-control" id="CategoryName" />
            </div>
            <div>
                <label class="form-label">@Localizer["Description"]</label>
                <textarea class="form-control" id="CategoryDescription" rows="3"></textarea>
            </div>
            <div>
                <label class="form-label">@Localizer["ItemType"]</label>
                <select class="form-select select2" id="CategoryItemTypeId"></select>
            </div>
            <div>
                <label class="form-label">@Localizer["ParentCategory"]</label>
                <select class="form-select select2" id="ParentCategoryId"></select>
            </div>
            <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input" id="CategoryIsActive" checked>
                <label class="form-check-label" for="CategoryIsActive">@SharedLocalizer["Active"]</label>
            </div>
            <div class="d-flex gap-3">
                <button type="button" class="btn btn-label-secondary w-50" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary w-50">@SharedLocalizer["Save"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/vendor/libs/select2/select2.js" asp-append-version="true"></script>
    <script src="~/assets/js/MDM/ItemCategories/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/MDM/ItemCategories/index.js" asp-append-version="true"></script>
}
