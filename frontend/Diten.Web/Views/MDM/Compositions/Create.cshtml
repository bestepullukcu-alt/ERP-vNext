@model Diten.Web.Models.Compositions.CompositionEditViewModel
@using Diten.Web.Views.MDM.Compositions
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CompositionsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["CreateTitle"].Value;
    Layout = "_LayoutBackbone";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0">@Localizer["CreateTitle"]</h5>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item position-relative"><a asp-action="Index" class="stretched-link">@Localizer["CompositionsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@Localizer["CreateTitle"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-4">
        <a asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="formComposition" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <partial name="_Form" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/vendor/libs/select2/select2.js" asp-append-version="true"></script>
    <script src="~/assets/js/MDM/Compositions/form.js" asp-append-version="true"></script>
}
