@model Diten.Web.Models.Compositions.CompositionDetailsViewModel
@using Diten.Web.Views.MDM.Compositions
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Html
@inject IHtmlLocalizer<CompositionsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["CompositionDetails"].Value + " - " + Model.FormulationCode;
    Layout = "_LayoutBackbone";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">
            @Model.FormulationCode 
            <span class="badge @GetLifecycleBadgeClass(Model.LifecycleState) ms-2">@Model.LifecycleState</span>
            @if (Model.CurrentVersion != null)
            {
                <span class="badge bg-label-secondary ms-1">@Model.CurrentVersion.VersionLabel</span>
            }
        </h4>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item"><a asp-action="Index">@Localizer["CompositionsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
            </ol>
        </nav>
    </div>

    <div class="d-flex align-content-center flex-wrap gap-4">
        <a asp-action="Index" class="btn btn-label-secondary border">@SharedLocalizer["BackToList"]</a>
        
        @if (Model.CurrentVersion?.Status == "Draft")
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bx bx-edit-alt me-1"></i> @SharedLocalizer["Edit"]
            </a>
            <form asp-action="ActivateVersion" asp-route-id="@Model.Id" asp-route-versionId="@Model.CurrentVersion.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    <i class="bx bx-check-circle me-1"></i> @Localizer["ActivateVersion"]
                </button>
            </form>
        }
        else if (Model.CurrentVersion?.Status == "Active")
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bx bx-git-repo-forked me-1"></i> @Localizer["NewRevision"]
            </a>
        }
    </div>
</div>

<div class="row g-6">
    <!-- Main Info -->
    <div class="col-12 col-lg-8">
        <div class="card mb-6">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">@Localizer["GeneralInformation"]</h5>
                @if (Model.CurrentVersion != null)
                {
                    <span class="text-muted small">@Localizer["CreatedOn"]: @Model.CurrentVersion.CreatedAt.ToString("g")</span>
                }
            </div>
            <div class="card-body mt-4">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-12 fw-medium text-heading mb-1">@Localizer["FormulationCode"]:</dt>
                            <dd class="col-12 mb-4">@Model.FormulationCode</dd>
                            
                            <dt class="col-12 fw-medium text-heading mb-1">@Localizer["CompositionName"]:</dt>
                            <dd class="col-12 mb-4 text-truncate">@Model.Name</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                         <dl class="row mb-0">
                            <dt class="col-12 fw-medium text-heading mb-1">@Localizer["DosageForm"]:</dt>
                            <dd class="col-12 mb-4">@(Model.CurrentVersion?.DosageFormName ?? "-")</dd>
                            
                            <dt class="col-12 fw-medium text-heading mb-1">@Localizer["StrengthValue"]:</dt>
                            <dd class="col-12 mb-4">@(Model.CurrentVersion != null ? $"{Model.CurrentVersion.StrengthValue} {Model.CurrentVersion.StrengthUnitName}" : "-")</dd>
                        </dl>
                    </div>
                </div>
                <hr class="my-0" />
                <div class="row mt-4">
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-12 fw-medium text-heading mb-1">@Localizer["TechnicalFillAmount"]:</dt>
                            <dd class="col-12 mb-0">@(Model.CurrentVersion != null ? $"{Model.CurrentVersion.TechnicalFillAmount} {Model.CurrentVersion.TechnicalFillUnitName}" : "-")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Components -->
        <div class="card">
            <div class="card-header border-bottom">
                <h5 class="card-title mb-0">@Localizer["Components"]</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th width="50">#</th>
                            <th>@Localizer["Component"]</th>
                            <th>@Localizer["Type"]</th>
                            <th class="text-end">@Localizer["Quantity"]</th>
                            <th>@Localizer["Unit"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CurrentVersion?.Components != null && Model.CurrentVersion.Components.Any())
                        {
                            foreach (var comp in Model.CurrentVersion.Components)
                            {
                                <tr>
                                    <td>@comp.Sequence</td>
                                    <td class="fw-medium text-heading">@comp.ComponentName</td>
                                    <td>@GetComponentTypeBadge(comp.ComponentType)</td>
                                    <td class="text-end">@comp.Quantity.ToString("N4")</td>
                                    <td>@comp.UnitId</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">@SharedLocalizer["NoDataFound"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Sidebar: Version History -->
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header border-bottom d-flex align-items-center">
                <i class="bx bx-history me-2 text-primary"></i>
                <h5 class="card-title mb-0">@Localizer["RevisionHistory"]</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var version in Model.VersionHistory)
                    {
                        <a href="?versionId=@version.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(version.Id == Model.CurrentVersion?.Id ? "active bg-label-primary border-primary" : "")">
                            <div>
                                <h6 class="mb-0 @(version.Id == Model.CurrentVersion?.Id ? "text-primary" : "")">@version.VersionLabel</h6>
                                <small class="text-muted">@version.CreatedAt.ToString("d")</small>
                            </div>
                            <div class="text-end">
                                <span class="badge @GetVersionStatusBadge(version.Status)">@version.Status</span>
                                @if (version.IsCurrent)
                                {
                                    <div class="extra-small fw-bold text-primary mt-1" style="font-size: 0.65rem;">@Localizer["CURRENT"]</div>
                                }
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetLifecycleBadgeClass(string state) => state switch {
        "Draft" => "bg-label-warning",
        "Active" => "bg-label-success",
        "Obsolete" => "bg-label-danger",
        _ => "bg-label-secondary"
    };

    string GetVersionStatusBadge(string status) => status switch {
        "Draft" => "bg-label-warning",
        "Active" => "bg-label-success",
        "Superseded" => "bg-label-info",
        "Obsolete" => "bg-label-danger",
        _ => "bg-label-secondary"
    };

    IHtmlContent GetComponentTypeBadge(int type) {
        var label = type switch {
            1 => "API",
            2 => "Excipient",
            3 => "Coating",
            4 => "Solvent",
            5 => "Preservative",
            6 => "Flavor",
            _ => "Other"
        };
        var cls = type == 1 ? "bg-label-primary" : "bg-label-secondary";
        return new HtmlString($"<span class='badge {cls}'>{label}</span>");
    }
}
