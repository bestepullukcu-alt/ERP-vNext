@model Diten.Web.Models.Compositions.CompositionIndexPageViewModel
@using Diten.Web.Views.MDM.Compositions
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CompositionsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["CompositionsTitle"].Value;
    Layout = "_LayoutBackbone";
}

<partial name="_Filter" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["CompositionsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="bulkActionBar" class="card mb-4 d-none">
    <div class="card-body d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bx bx-check-circle text-primary icon-md"></i>
            <span id="bulkSelectedCount" class="fw-medium text-heading">0</span>
            <span class="text-muted" id="bulkSelectedLabel">@SharedLocalizer["SelectedCount"]</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="btnBulkDelete" class="btn btn-label-danger">
                <i class="bx bx-trash me-1"></i> @SharedLocalizer["BulkDelete"]
            </button>
            <button type="button" id="btnClearSelection" class="btn btn-label-secondary">
                @SharedLocalizer["ClearSelection"]
            </button>
        </div>
    </div>
</div>

<div class="card">
    <div id="skeleton-loader" class="p-4" style="display: none;">
        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-compositions" data-dt-standard="v2" class="datatables-compositions table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th>@Localizer["FormulationCode"]</th>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Version"]</th>
                    <th>@Localizer["DosageForm"]</th>
                    <th>@Localizer["Strength"]</th>
                    <th>@Localizer["LifecycleState"]</th>
                    <th class="cell-fit text-end">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDetailsPreview"
    aria-labelledby="offcanvasDetailsPreviewLabel" style="width: 480px;">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center">
            <div
                class="avatar avatar-md bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center me-3">
                <i class="bx bx-vial fs-4"></i>
            </div>
            <div>
                <h5 id="oc-title" class="offcanvas-title mb-0">-</h5>
                <small id="oc-subtitle" class="text-muted">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"
            aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-0">
        <div class="p-4">
            <div class="bg-label-secondary rounded p-3 mb-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="d-block text-muted small fw-medium mb-1">@SharedLocalizer["Status"]</span>
                    <span id="oc-status" class="badge bg-label-secondary">-</span>
                </div>
            </div>

            <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["IdentityCard"]</h6>
            <dl class="row mb-4">
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-barcode text-muted me-2"></i>@Localizer["FormulationCode"]</dt>
                <dd id="oc-code" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-layer text-muted me-2"></i>@Localizer["DosageForm"]</dt>
                <dd id="oc-dosageForm" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-bolt-circle text-muted me-2"></i>@Localizer["Strength"]</dt>
                <dd id="oc-strength" class="col-7 mb-2">-</dd>
            </dl>

            <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["TechnicalDetails"]</h6>
            <dl class="row mb-0">
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-copy text-muted me-2"></i>@Localizer["Version"]</dt>
                <dd id="oc-version" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-git-compare text-muted me-2"></i>@Localizer["Revision"]</dt>
                <dd id="oc-revision" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-flask text-muted me-2"></i>@Localizer["TechnicalFillAmount"]</dt>
                <dd id="oc-fillAmount" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-list-check text-muted me-2"></i>@Localizer["Components"]</dt>
                <dd id="oc-componentCount" class="col-7 mb-2">-</dd>
            </dl>
        </div>
    </div>

    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary flex-grow-1" data-bs-dismiss="offcanvas">
            @SharedLocalizer["Cancel"]
        </button>
        <a id="oc-btn-edit" href="#" class="btn btn-primary flex-grow-1">@Localizer["EditBtn"]</a>
        <button id="oc-btn-delete" type="button" class="btn btn-label-danger flex-grow-1">
            <i class="bx bx-trash me-1"></i> @SharedLocalizer["Delete"]
        </button>
    </div>
</div>

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/MDM/Compositions/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/MDM/Compositions/index.js" asp-append-version="true"></script>
}
