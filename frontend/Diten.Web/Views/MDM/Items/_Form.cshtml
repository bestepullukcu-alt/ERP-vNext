@model Diten.Web.Models.Items.ItemEditViewModel
@using Diten.Web.Views.MDM.Items
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ItemsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEditMode = Model.Id.HasValue;
}

<form asp-action="@(isEditMode ? "Edit" : "Create")" method="post" id="formItem" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="AttributeValuesJson" id="AttributeValuesJson" />
    <input type="hidden" asp-for="VariantsJson" id="VariantsJson" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-6 d-flex align-items-center" role="alert">
        <i class="bx bx-error-alt me-2"></i>
        <div>@SharedLocalizer["ValidationFailed"]</div>
    </div>

    <div class="row g-6">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0 d-flex align-items-center"><i class="bx bx-data me-2"></i>@Localizer["IdentityAndClassification"]</h5>
                </div>
                <div class="card-body">
                    <div class="row g-6">
                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label">@Localizer["Code"] <span class="text-danger">*</span></label>
                            <input asp-for="Code" class="form-control" />
                            <span asp-validation-for="Code" class="invalid-feedback"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">@Localizer["Name"] <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="invalid-feedback"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ShortDescription" class="form-label">@Localizer["ShortDescription"]</label>
                            <textarea asp-for="ShortDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ItemTypeId" class="form-label">@Localizer["ItemType"]</label>
                            <select asp-for="ItemTypeId" class="form-select select2" id="ItemTypeId">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var option in Model.ItemTypes)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label">@Localizer["Category"]</label>
                            <select asp-for="CategoryId" class="form-select select2" id="CategoryId">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var option in Model.Categories)
                                {
                                    <option value="@option.Id" data-item-type-id="@option.ItemTypeId">@option.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BaseUomId" class="form-label">@Localizer["BaseUom"]</label>
                            <select asp-for="BaseUomId" class="form-select select2">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var option in Model.BaseUoms)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="VariantModelId" class="form-label">@Localizer["VariantModel"]</label>
                            <select asp-for="VariantModelId" class="form-select select2" id="VariantModelId">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var option in Model.VariantModels)
                                {
                                    <option value="@option.Id" data-item-type-id="@option.ItemTypeId">@option.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0 d-flex align-items-center"><i class="bx bx-toggle-right me-2"></i>@Localizer["OperationalFlags"]</h5>
                </div>
                <div class="card-body">
                    <div class="row g-6">
                        <div class="col-md-6">
                            <label asp-for="TrackingPolicyId" class="form-label">@Localizer["TrackingPolicy"]</label>
                            <select asp-for="TrackingPolicyId" class="form-select select2">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var option in Model.TrackingPolicies)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LifecycleStateId" class="form-label">@Localizer["LifecycleState"]</label>
                            <select asp-for="LifecycleStateId" class="form-select select2">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var option in Model.LifecycleStates)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mb-3">
                                <input asp-for="Stockable" class="form-check-input" type="checkbox" />
                                <label asp-for="Stockable" class="form-check-label">@Localizer["Stockable"]</label>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input asp-for="Purchasable" class="form-check-input" type="checkbox" />
                                <label asp-for="Purchasable" class="form-check-label">@Localizer["Purchasable"]</label>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input asp-for="Sellable" class="form-check-input" type="checkbox" />
                                <label asp-for="Sellable" class="form-check-label">@Localizer["Sellable"]</label>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input asp-for="ServiceItem" class="form-check-input" type="checkbox" id="ServiceItem" />
                                <label asp-for="ServiceItem" class="form-check-label">@Localizer["ServiceItem"]</label>
                            </div>
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">@SharedLocalizer["Active"]</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0 d-flex align-items-center"><i class="bx bx-git-branch me-2"></i>@Localizer["TraceabilityAndAssignments"]</h5>
                </div>
                <div class="card-body">
                    <div class="row g-6">
                        <div class="col-12 col-lg-5">
                            <div class="border rounded p-4 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">@SharedLocalizer["Attributes"]</h6>
                                    <span class="badge bg-label-info" id="attributeTemplateCount">0</span>
                                </div>
                                <div id="itemAttributesEditor" class="d-flex flex-column gap-3"></div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-7">
                            <div class="border rounded p-4 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">@SharedLocalizer["Variants"]</h6>
                                    <button type="button" class="btn btn-sm btn-primary" id="btnAddVariant">@Localizer["AddVariant"]</button>
                                </div>
                                <div id="variantAxisHint" class="alert alert-label-info mb-3">@Localizer["VariantModelHint"]</div>
                                <div id="itemVariantsEditor" class="d-flex flex-column gap-3"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<script id="item-form-data" type="application/json">
    @Json.Serialize(new
    {
        itemTypes = Model.ItemTypes,
        categories = Model.Categories,
        variantModels = Model.VariantModels,
        variantTemplates = Model.VariantTemplates,
        attributeValues = Model.AttributeValues,
        variants = Model.Variants,
        l10n = new
        {
            NoAttributeTemplateSelected = Localizer["NoAttributeTemplateSelected"].Value,
            NoVariantAxisDefined = Localizer["NoVariantAxisDefined"].Value,
            NoVariantsDefined = Localizer["NoVariantsDefined"].Value,
            VariantLabel = Localizer["Variant"].Value,
            Remove = Localizer["Remove"].Value,
            Code = Localizer["Code"].Value,
            Name = Localizer["Name"].Value,
            Active = SharedLocalizer["Active"].Value
        }
    })
</script>
