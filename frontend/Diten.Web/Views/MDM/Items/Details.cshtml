@model Diten.Web.Models.Items.ItemEditViewModel
@using Diten.Web.Views.MDM.Items
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ItemsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = $"{SharedLocalizer["Details"]} - {Model.Name}";
    Layout = "_LayoutBackbone";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">@Model.Name</h4>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item"><a href="/">@Localizer["BreadcrumbHome"]</a></li>
                <li class="breadcrumb-item"><a href="javascript:void(0);">@Localizer["BreadcrumbMDM"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">@Localizer["ItemsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-4">
        <a asp-action="Index" class="btn btn-label-secondary border">@SharedLocalizer["BackToList"]</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@SharedLocalizer["EditRecord"]</a>
    </div>
</div>

<partial name="~/Views/Shared/_ItemsSecondaryNav.cshtml" />

<div class="card">
    <div class="card-body">
        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button">@SharedLocalizer["Overview"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-attributes" type="button">@SharedLocalizer["Attributes"]</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-variants" type="button">@SharedLocalizer["Variants"]</button>
            </li>
        </ul>

        <div class="tab-content p-0">
            <div class="tab-pane fade show active" id="tab-overview">
                <div class="row g-6">
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["GeneralInformation"]</h6>
                                <dl class="row mb-0">
                                    <dt class="col-5">@Localizer["Code"]</dt><dd class="col-7">@Model.Code</dd>
                                    <dt class="col-5">@Localizer["ItemType"]</dt><dd class="col-7">@Model.ItemType</dd>
                                    <dt class="col-5">@Localizer["Category"]</dt><dd class="col-7">@Model.Category</dd>
                                    <dt class="col-5">@Localizer["BaseUom"]</dt><dd class="col-7">@Model.BaseUom</dd>
                                    <dt class="col-5">@Localizer["ShortDescription"]</dt><dd class="col-7">@Model.ShortDescription</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["OperationalFlags"]</h6>
                                <dl class="row mb-0">
                                    <dt class="col-6">@Localizer["TrackingPolicy"]</dt><dd class="col-6">@Model.TrackingPolicy</dd>
                                    <dt class="col-6">@Localizer["LifecycleState"]</dt><dd class="col-6">@Model.LifecycleState</dd>
                                    <dt class="col-6">@Localizer["VariantModel"]</dt><dd class="col-6">@Model.VariantModel</dd>
                                    <dt class="col-6">@Localizer["Stockable"]</dt><dd class="col-6">@(Model.Stockable ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</dd>
                                    <dt class="col-6">@Localizer["Purchasable"]</dt><dd class="col-6">@(Model.Purchasable ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</dd>
                                    <dt class="col-6">@Localizer["Sellable"]</dt><dd class="col-6">@(Model.Sellable ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</dd>
                                    <dt class="col-6">@Localizer["ServiceItem"]</dt><dd class="col-6">@(Model.ServiceItem ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-attributes">
                <div class="table-responsive">
                    <table class="table table-borderless">
                        <thead>
                            <tr>
                                <th>@SharedLocalizer["Attributes"]</th>
                                <th>@Localizer["Value"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AttributeValues.Count == 0)
                            {
                                <tr><td colspan="2" class="text-muted">@Localizer["NoAttributesAssigned"]</td></tr>
                            }
                            else
                            {
                                @foreach (var attributeValue in Model.AttributeValues)
                                {
                                    <tr>
                                        <td>@attributeValue.AttributeName</td>
                                        <td>@attributeValue.Value</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-variants">
                <div class="table-responsive">
                    <table class="table table-borderless">
                        <thead>
                            <tr>
                                <th>@Localizer["Code"]</th>
                                <th>@Localizer["Name"]</th>
                                <th>@SharedLocalizer["Attributes"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Variants.Count == 0)
                            {
                                <tr><td colspan="3" class="text-muted">@Localizer["NoVariantsAssigned"]</td></tr>
                            }
                            else
                            {
                                @foreach (var variant in Model.Variants)
                                {
                                    <tr>
                                        <td>@variant.Code</td>
                                        <td>@variant.Name</td>
                                        <td>@string.Join(", ", variant.AttributeValues.Select(x => $"{x.AttributeName}: {x.Value}"))</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
