@using Diten.Web.Views.MDM.Items
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ItemsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm">
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-item-type">
                        <select class="form-select form-select-sm select2" id="filterItemType" data-placeholder="@Localizer["ItemType"]">
                            <option value=""></option>
                        </select>
                    </div>
                    <div class="filter-chip filter-category">
                        <select class="form-select form-select-sm select2" id="filterCategory" data-placeholder="@Localizer["Category"]">
                            <option value=""></option>
                        </select>
                    </div>
                    <div class="filter-chip filter-lifecycle">
                        <select class="form-select form-select-sm select2" id="filterLifecycleState" data-placeholder="@Localizer["LifecycleState"]">
                            <option value=""></option>
                        </select>
                    </div>
                    <div class="filter-chip filter-status">
                        <select class="form-select form-select-sm select2" id="filterStatus" data-placeholder="@SharedLocalizer["Status"]">
                            <option value=""></option>
                            <option value="true">@SharedLocalizer["Active"]</option>
                            <option value="false">@SharedLocalizer["Passive"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
