        ProductTypeFinished = Localizer["ProductTypeFinished"].Value,
        ProductTypeSemiFinished = Localizer["ProductTypeSemiFinished"].Value,
        ProductTypeService = Localizer["ProductTypeService"].Value,
        ProductTypeTechnology = Localizer["ProductTypeTechnology"].Value,
        ProductTypeUnknown = Localizer["ProductTypeUnknown"].Value,
        CapabilitySaleable = Localizer["IsSaleable"].Value,
        CapabilityPurchasable = Localizer["IsPurchasable"].Value,
        CapabilityManufacturable = Localizer["IsManufacturable"].Value,
        ProductType = Localizer["ProductType"].Value,
        Category = Localizer["Category"].Value,
        LifecycleState = Localizer["LifecycleState"].Value
    })
</script>
