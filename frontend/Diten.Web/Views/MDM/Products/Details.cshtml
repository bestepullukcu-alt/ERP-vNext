@model Diten.Web.Models.Products.ProductDetailViewModel
@using Diten.Web.Views.MDM.Products
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProductsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = $"{SharedLocalizer["Details"]} - {Model.Name}";
    Layout = "_LayoutBackbone";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">@Model.Name</h4>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item"><a href="/">@Localizer["BreadcrumbHome"]</a></li>
                <li class="breadcrumb-item"><a href="javascript:void(0);">@Localizer["BreadcrumbMDM"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">@Localizer["ProductsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-4">
        <a asp-action="Index" class="btn btn-label-secondary border">@SharedLocalizer["BackToList"]</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@SharedLocalizer["EditRecord"]</a>
    </div>
</div>

<partial name="~/Views/Shared/_ItemsSecondaryNav.cshtml" />

<div class="row g-6">
    <div class="col-12 col-lg-7">
        <div class="card h-100 border">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["GeneralInformation"]</h6>
                <dl class="row mb-0">
                    <dt class="col-5">@Localizer["Code"]</dt><dd class="col-7">@Model.Code</dd>
                    <dt class="col-5">@Localizer["Name"]</dt><dd class="col-7">@Model.Name</dd>
                    <dt class="col-5">@Localizer["ShortName"]</dt><dd class="col-7">@(string.IsNullOrWhiteSpace(Model.ShortName) ? "-" : Model.ShortName)</dd>
                    <dt class="col-5">@Localizer["ProductType"]</dt><dd class="col-7" id="productTypeText" data-type="@Model.ProductType">-</dd>
                    <dt class="col-5">@Localizer["Category"]</dt><dd class="col-7">@Model.CategoryName</dd>
                    <dt class="col-5">@Localizer["LifecycleState"]</dt><dd class="col-7">@Model.LifecycleStateName</dd>
                    <dt class="col-5">@SharedLocalizer["CreatedDate"]</dt><dd class="col-7">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-5">
        <div class="card h-100 border">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["Capabilities"]</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><i class="bx bx-check-circle text-success me-2"></i>@Localizer["IsSaleable"]: @(Model.IsSaleable ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</li>
                    <li class="mb-2"><i class="bx bx-check-circle text-success me-2"></i>@Localizer["IsPurchasable"]: @(Model.IsPurchasable ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</li>
                    <li><i class="bx bx-check-circle text-success me-2"></i>@Localizer["IsManufacturable"]: @(Model.IsManufacturable ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card border">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["Description"]</h6>
                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</p>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const map = {
        1: '@Localizer["ProductTypeFinished"].Value',
        2: '@Localizer["ProductTypeSemiFinished"].Value',
        3: '@Localizer["ProductTypeService"].Value',
        4: '@Localizer["ProductTypeTechnology"].Value'
    };
    const el = document.getElementById('productTypeText');
    if (!el) return;
    const type = parseInt(el.getAttribute('data-type') || '0', 10);
    el.textContent = map[type] || '@Localizer["ProductTypeUnknown"].Value';
})();
</script>
