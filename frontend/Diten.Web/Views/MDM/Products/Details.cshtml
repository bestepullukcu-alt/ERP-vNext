@model Diten.Web.Models.Products.ProductDetailViewModel
@using Diten.Web.Views.MDM.Products
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProductsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = $"{SharedLocalizer["Details"]} - {Model.Name}";
    Layout = "_LayoutBackbone";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">@Model.Name</h4>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item"><a href="/">@Localizer["BreadcrumbHome"]</a></li>
                <li class="breadcrumb-item"><a href="javascript:void(0);">@Localizer["BreadcrumbMDM"]</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">@Localizer["ProductsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-4">
        <a asp-action="Index" class="btn btn-label-secondary border">@SharedLocalizer["BackToList"]</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@SharedLocalizer["EditRecord"]</a>
    </div>
</div>

<div class="row g-6">
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header border-bottom">
                <h5 class="card-title mb-0 d-flex align-items-center">
                    <i class="bx bx-detail me-2"></i>@Localizer["Overview"]
                </h5>
            </div>
            <div class="card-body mt-4">
                <dl class="row mb-0">
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["Code"]</dt>
                    <dd class="col-12 mb-4">@Model.Code</dd>
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["ShortName"]</dt>
                    <dd class="col-12 mb-4">@(string.IsNullOrWhiteSpace(Model.ShortName) ? "-" : Model.ShortName)</dd>
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["ProductType"]</dt>
                    <dd class="col-12 mb-4">@Model.ProductTypeName</dd>
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["Category"]</dt>
                    <dd class="col-12 mb-4">@Model.CategoryName</dd>
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["Description"]</dt>
                    <dd class="col-12 mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header border-bottom">
                <h5 class="card-title mb-0 d-flex align-items-center">
                    <i class="bx bx-toggle-right me-2"></i>@Localizer["CommercialFlags"]
                </h5>
            </div>
            <div class="card-body mt-4">
                <dl class="row mb-0">
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["IsSaleable"]</dt>
                    <dd class="col-12 mb-4">@(Model.IsSaleable ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</dd>
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["IsPurchasable"]</dt>
                    <dd class="col-12 mb-4">@(Model.IsPurchasable ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</dd>
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["IsManufacturable"]</dt>
                    <dd class="col-12 mb-0">@(Model.IsManufacturable ? SharedLocalizer["Active"] : SharedLocalizer["Passive"])</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <partial name="_LifecyclePanel" model="Model" />
    </div>

    <div class="col-12">
        <partial name="_RelatedModules" model="Model" />
    </div>
</div>
