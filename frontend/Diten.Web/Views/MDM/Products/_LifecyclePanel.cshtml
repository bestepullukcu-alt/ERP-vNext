@model Diten.Web.Models.Products.ProductDetailViewModel
@using Diten.Web.Views.MDM.Products
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProductsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card h-100">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-0 d-flex align-items-center">
            <i class="bx bx-git-branch me-2"></i>@Localizer["Lifecycle"]
        </h5>
    </div>
    <div class="card-body mt-4">
        <div class="bg-label-secondary rounded p-3 mb-4">
            <span class="d-block text-muted small fw-medium mb-1">@Localizer["CurrentLifecycle"]</span>
            <span class="badge @Model.LifecycleBadgeClass">@Model.LifecycleStateName</span>
        </div>

        @if (Model.AvailableTransitions.Count == 0)
        {
            <div class="alert alert-label-secondary mb-0">
                <i class="bx bx-lock-alt me-2"></i>@Localizer["NoLifecycleTransitions"]
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var transition in Model.AvailableTransitions)
                {
                    <form asp-action="ChangeLifecycle" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="lifecycleStateId" value="@transition.LifecycleStateId" />
                        <button type="submit" class="btn @transition.ButtonClass w-100">@transition.Name</button>
                    </form>
                }
            </div>
        }
    </div>
</div>
