@model Diten.Web.Models.Products.ProductDetailViewModel
@using Diten.Web.Views.MDM.Products
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProductsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-0 d-flex align-items-center">
            <i class="bx bx-link-alt me-2"></i>@Localizer["RelatedModules"]
        </h5>
    </div>
    <div class="card-body mt-4">
        <div class="row g-6">
            <div class="col-12 col-md-4">
                <div class="border rounded p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="mb-0">@Localizer["RelatedSku"]</h6>
                        <span class="badge bg-label-secondary">0</span>
                    </div>
                    <p class="text-muted mb-0">@Localizer["NoRelatedSku"]</p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="border rounded p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="mb-0">@Localizer["RelatedComposition"]</h6>
                        <span class="badge bg-label-secondary">0</span>
                    </div>
                    <p class="text-muted mb-0">@Localizer["NoRelatedComposition"]</p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="border rounded p-4 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="mb-0">@Localizer["RelatedPackaging"]</h6>
                        <span class="badge bg-label-secondary">0</span>
                    </div>
                    <p class="text-muted mb-0">@Localizer["NoRelatedPackaging"]</p>
                </div>
            </div>
        </div>
    </div>
</div>
