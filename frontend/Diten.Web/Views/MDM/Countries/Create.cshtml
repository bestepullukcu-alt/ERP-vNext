@model Diten.Web.Models.CreateCountryViewModel
@using Diten.Web.Views.MDM.Countries
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CountriesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEditMode = Model != null && Model.Id.HasValue;
    ViewData["Title"] = isEditMode ? Localizer["EditCountry"].Value : Localizer["AddNewCountry"].Value;
    Layout = "_LayoutBackbone";
}

<div
    class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">@(isEditMode ? Localizer["EditCountry"] : Localizer["AddNewCountry"])</h4>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item">
                    <a href="/">@Localizer["BreadcrumbHome"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="javascript:void(0);">@Localizer["BreadcrumbMDM"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-action="Index">@Localizer["CountriesTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@(isEditMode ? Localizer["EditCountry"] :
                    Localizer["AddNewCountry"])</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-4">
        <a asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="formCreateCountry" class="btn btn-primary">@(isEditMode ?
            SharedLocalizer["Update"] : SharedLocalizer["Save"])</button>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <form asp-action="@(isEditMode ? "Edit" : "Create")" method="post" id="formCreateCountry" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-6 d-flex align-items-center"
                role="alert">
                <i class="bx bx-error-alt me-2"></i>
                <div>
                    <ul class="mb-0">
                        <li asp-validation-summary="ModelOnly"></li>
                    </ul>
                </div>
            </div>

            <div class="row g-6">
                <div class="col-12 col-lg-6">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title mb-0 d-flex align-items-center"><i
                                    class="bx bx-info-circle me-2"></i>@Localizer["GeneralInformation"]</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-6">
                                <label asp-for="Name" class="form-label">@Localizer["Name"] <span
                                        class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="invalid-feedback"></span>
                            </div>
                            <div class="row g-6">
                                <div class="col-md-4">
                                    <label asp-for="Iso2Code" class="form-label">@Localizer["Iso2Code"] <span
                                            class="text-danger">*</span></label>
                                    <input asp-for="Iso2Code" class="form-control text-uppercase" maxlength="2"
                                        inputmode="text" required />
                                    <span asp-validation-for="Iso2Code" class="invalid-feedback"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Iso3Code" class="form-label">@Localizer["Iso3Code"] <span
                                            class="text-danger">*</span></label>
                                    <input asp-for="Iso3Code" class="form-control text-uppercase" maxlength="3"
                                        inputmode="text" required />
                                    <span asp-validation-for="Iso3Code" class="invalid-feedback"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="PhoneCode" class="form-label">@Localizer["PhoneCode"]</label>
                                    <input asp-for="PhoneCode" class="form-control" placeholder="+90" />
                                    <span asp-validation-for="PhoneCode" class="invalid-feedback"></span>
                                </div>
                            </div>

                            @if (isEditMode)
                            {
                                <div class="mt-6">
                                    <label class="form-label d-block">@SharedLocalizer["Status"]</label>
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                        <label class="form-check-label" for="IsActive">@SharedLocalizer["Active"]</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
