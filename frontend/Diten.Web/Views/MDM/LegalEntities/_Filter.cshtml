@using Diten.Web.Views.MDM.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<!-- Inline Collapsible Filter Panel (mounted under DataTable toolbar via JS) -->
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
	        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm">
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-company-type"></div>
                    <div class="filter-chip filter-status"></div>

	                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary"
                            id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger"
                            id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
