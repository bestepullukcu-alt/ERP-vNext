@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResource> SharedLocalizer

<div class="card mb-4 text-center">
    <div class="card-body py-5">
        <div class="mb-4">
            <i class="bx bx-folder-open text-muted" style="font-size: 5rem;"></i>
        </div>
        <h5 class="card-title mb-2">@SharedLocalizer["SubRecords"].Value</h5>
        <p class="card-text text-muted mb-4">
            @SharedLocalizer["NoRecordsFound"].Value
            <br />
            @SharedLocalizer["ComingSoon"].Value
        </p>
        <button type="button" class="btn btn-primary btn-sm" disabled>
            <span class="tf-icons bx bx-plus me-1"></span>Yeni Ekle
        </button>
    </div>
</div>
