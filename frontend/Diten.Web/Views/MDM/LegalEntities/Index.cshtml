@model IEnumerable<Diten.Web.Models.LegalEntityViewModel>
@using Diten.Web.Views.MDM.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@using Microsoft.AspNetCore.Localization
@using System.Globalization
@{
    ViewData["Title"] = Localizer["LegalEntitiesTitle"].Value;
    Layout = "_LayoutBackbone";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var culture = requestCulture?.RequestCulture.Culture.Name ?? CultureInfo.CurrentCulture.Name;
}

<partial name="_Filter" />



<!-- Page Header -->
<div
    class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">@Localizer["LegalEntitiesTitle"]</h4>
        <p class="mb-0">@Localizer["PageDescription"]</p>
    </div>
</div>

<!-- Bulk Action Bar (Shown when rows are selected) -->
<div id="bulkActionBar" class="card mb-4 d-none">
    <div class="card-body d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bx bx-check-circle text-primary icon-md"></i>
            <span id="bulkSelectedCount" class="fw-medium text-heading">0</span>
            <span class="text-muted" id="bulkSelectedLabel">@SharedLocalizer["SelectedCount"]</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="btnBulkDelete" class="btn btn-label-danger">
                <i class="bx bx-trash me-1"></i> @SharedLocalizer["BulkDelete"]
            </button>
            <button type="button" id="btnClearSelection" class="btn btn-label-secondary">
                @SharedLocalizer["ClearSelection"]
            </button>
        </div>
    </div>
</div>

<!-- Legal Entities List Table -->
<div class="card">
    <!-- Skeleton Loader (Shimmer) -->
    <div id="skeleton-loader" class="p-4" style="display: none;">
        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>
    <div class="card-datatable table-responsive">
        <table id="dt-legal-entities" data-dt-standard="v2" class="datatables-legal-entities table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th>@SharedLocalizer["Title"]</th>
                    <th>@SharedLocalizer["TaxNumber"]</th>
                    <th>@Localizer["TaxOffice"]</th>
                    <th>@Localizer["Email"]</th>
                    <th>@Localizer["Phone"]</th>
                    <th>@Localizer["CompanyType"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th class="cell-fit">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Alternative Details Offcanvas Preview -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDetailsPreview"
    aria-labelledby="offcanvasDetailsPreviewLabel" style="width: 480px;">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center">
            <div
                class="avatar avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                <i class="bx bx-buildings fs-4"></i>
            </div>
            <div>
                <h5 id="oc-title" class="offcanvas-title mb-0">-</h5>
                <small id="oc-subtitle" class="text-muted">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"
            aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-0">
        <!-- Condensed Quick View Content -->
        <div class="p-4">
            <!-- Contact Box -->
            <div class="bg-label-secondary rounded p-3 mb-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="d-block text-muted small fw-medium mb-1">@SharedLocalizer["TaxNumber"]</span>
                    <span id="oc-taxnumber" class="fw-bold text-heading">-</span>
                </div>
                <div>
                    <span class="d-block text-muted small fw-medium mb-1">@SharedLocalizer["Status"]</span>
                    <span id="oc-status" class="badge bg-label-secondary">-</span>
                </div>
            </div>

            <!-- Details List -->
            <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["GeneralInformation"]</h6>
            <dl class="row mb-4">
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-buildings text-muted me-2"></i>@Localizer["CompanyType"]</dt>
                <dd id="oc-company-type" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-layer text-muted me-2"></i>@Localizer["Sector"]</dt>
                <dd id="oc-sector" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-user-pin text-muted me-2"></i>@Localizer["OrganizationRole"]</dt>
                <dd id="oc-org-role" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-briefcase text-muted me-2"></i>@Localizer["ContactPerson"]</dt>
                <dd id="oc-contact" class="col-7 mb-2">-</dd>
            </dl>

            <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["Communication"]</h6>
            <dl class="row mb-4">
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-phone text-muted me-2"></i>@Localizer["Phone"]</dt>
                <dd id="oc-phone" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-envelope text-muted me-2"></i>@Localizer["Email"]</dt>
                <dd id="oc-email" class="col-7 mb-2 text-primary">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-globe text-muted me-2"></i>@Localizer["Website"]</dt>
                <dd id="oc-website" class="col-7 mb-2 text-primary">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-map-pin text-muted me-2"></i>@Localizer["Address"]</dt>
                <dd id="oc-address" class="col-7 mb-2">-</dd>
            </dl>

            <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["FinancialRegistration"]</h6>
            <dl class="row mb-0">
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-building-house text-muted me-2"></i>@Localizer["TaxOffice"]</dt>
                <dd id="oc-taxoffice" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-globe text-muted me-2"></i>@Localizer["TaxJurisdiction"]</dt>
                <dd id="oc-jurisdiction" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-money text-muted me-2"></i>@Localizer["PrimaryCurrency"]</dt>
                <dd id="oc-currency" class="col-7 mb-2">-</dd>
            </dl>
        </div>
    </div>
    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between">
        <button type="button" class="btn btn-label-secondary w-50 me-2"
            data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <a id="oc-btn-edit" href="#" class="btn btn-primary w-50">@Localizer["EditBtn"]</a>
    </div>
</div>

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/MDM/LegalEntities/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/MDM/LegalEntities/index.js" asp-append-version="true"></script>
}
