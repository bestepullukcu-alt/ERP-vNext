@model IEnumerable<Diten.Web.Models.LegalEntityViewModel>
@using Diten.Web.Views.MDM.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@using Microsoft.AspNetCore.Localization
@using System.Globalization
@{
    ViewData["Title"] = Localizer["LegalEntitiesTitle"].Value;
    Layout = "_LayoutBackbone";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var culture = requestCulture?.RequestCulture.Culture.Name ?? CultureInfo.CurrentCulture.Name;
}

<partial name="_Filter" />



<!-- Page Header -->
<div
    class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">@Localizer["LegalEntitiesTitle"]</h4>
        <p class="mb-0">@Localizer["PageDescription"]</p>
    </div>
</div>

<!-- Bulk Action Bar (Shown when rows are selected) -->
<div id="bulkActionBar" class="card mb-4 d-none">
    <div class="card-body d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bx bx-check-circle text-primary icon-md"></i>
            <span id="bulkSelectedCount" class="fw-medium text-heading">0</span>
            <span class="text-muted" id="bulkSelectedLabel">@SharedLocalizer["SelectedCount"]</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="btnBulkDelete" class="btn btn-label-danger">
                <i class="bx bx-trash me-1"></i> @SharedLocalizer["BulkDelete"]
            </button>
            <button type="button" id="btnClearSelection" class="btn btn-label-secondary">
                @SharedLocalizer["ClearSelection"]
            </button>
        </div>
    </div>
</div>

<!-- Legal Entities List Table -->
<div class="card">
    <!-- Skeleton Loader (Shimmer) -->
    <div id="skeleton-loader" class="p-4" style="display: none;">
        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>
    <div class="card-datatable table-responsive">
        <table id="dt-legal-entities" data-dt-standard="v2" class="datatables-legal-entities table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th>@SharedLocalizer["Title"]</th>
                    <th>@SharedLocalizer["TaxNumber"]</th>
                    <th>@Localizer["TaxOffice"]</th>
                    <th>@Localizer["Email"]</th>
                    <th>@Localizer["Phone"]</th>
                    <th>@Localizer["CompanyType"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th class="cell-fit">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Alternative Details Offcanvas Preview -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDetailsPreview"
    aria-labelledby="offcanvasDetailsPreviewLabel" style="width: 480px;">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center">
            <div
                class="avatar avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                <i class="bx bx-buildings fs-4"></i>
            </div>
            <div>
                <h5 id="oc-title" class="offcanvas-title mb-0">-</h5>
                <small id="oc-subtitle" class="text-muted">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"
            aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-0">
        <!-- Condensed Quick View Content -->
        <div class="p-4">
            <!-- Contact Box -->
            <div class="bg-label-secondary rounded p-3 mb-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="d-block text-muted small fw-medium mb-1">@SharedLocalizer["TaxNumber"]</span>
                    <span id="oc-taxnumber" class="fw-bold text-heading">-</span>
                </div>
                <div>
                    <span class="d-block text-muted small fw-medium mb-1">@SharedLocalizer["Status"]</span>
                    <span id="oc-status" class="badge bg-label-secondary">-</span>
                </div>
            </div>

            <!-- Details List -->
            <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["GeneralInformation"]</h6>
            <dl class="row mb-4">
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-buildings text-muted me-2"></i>@Localizer["CompanyType"]</dt>
                <dd id="oc-company-type" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-layer text-muted me-2"></i>@Localizer["Sector"]</dt>
                <dd id="oc-sector" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-user-pin text-muted me-2"></i>@Localizer["OrganizationRole"]</dt>
                <dd id="oc-org-role" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-briefcase text-muted me-2"></i>@Localizer["ContactPerson"]</dt>
                <dd id="oc-contact" class="col-7 mb-2">-</dd>
            </dl>

            <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["Communication"]</h6>
            <dl class="row mb-4">
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-phone text-muted me-2"></i>@Localizer["Phone"]</dt>
                <dd id="oc-phone" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-envelope text-muted me-2"></i>@Localizer["Email"]</dt>
                <dd id="oc-email" class="col-7 mb-2 text-primary">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-globe text-muted me-2"></i>@Localizer["Website"]</dt>
                <dd id="oc-website" class="col-7 mb-2 text-primary">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-map-pin text-muted me-2"></i>@Localizer["Address"]</dt>
                <dd id="oc-address" class="col-7 mb-2">-</dd>
            </dl>

            <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["FinancialRegistration"]</h6>
            <dl class="row mb-0">
                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-building-house text-muted me-2"></i>@Localizer["TaxOffice"]</dt>
                <dd id="oc-taxoffice" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-globe text-muted me-2"></i>@Localizer["TaxJurisdiction"]</dt>
                <dd id="oc-jurisdiction" class="col-7 mb-2">-</dd>

                <dt class="col-5 fw-medium text-heading mb-2"><i
                        class="bx bx-money text-muted me-2"></i>@Localizer["PrimaryCurrency"]</dt>
                <dd id="oc-currency" class="col-7 mb-2">-</dd>
            </dl>
        </div>
    </div>
    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between">
        <button type="button" class="btn btn-label-secondary w-50 me-2"
            data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <a id="oc-btn-edit" href="#" class="btn btn-primary w-50">@Localizer["EditBtn"]</a>
    </div>
</div>

@section Styles {
        <style>
            /* Inline Filter Bar (LegalEntities) */
            #inlineFilterHost .dt-filter-bar {
                row-gap: .5rem;
            }

        @@media (max-width: 575.98px) {
                /* Apply/Reset becomes a clean second row */
                #inlineFilterHost .dt-filter-bar .ms-auto {
                    width: 100%;
                    margin-left: 0 !important;
                    justify-content: space-between;
                }

                #inlineFilterHost .dt-filter-bar .ms-auto .btn {
                    flex: 1 1 0;
                }
            }

	            #inlineFilterHost .dt-filter-bar .filter-chip .select2-container {
	                inline-size: auto !important;
	                width: auto !important;
	                min-inline-size: 180px;
	                min-width: 180px;
	            }

            #inlineFilterHost .dt-filter-bar .filter-chip .select2-selection--single {
                height: 34px;
                border-radius: 999px;
                border: 1px solid rgba(var(--bs-secondary-rgb), .25);
                background: rgba(var(--bs-secondary-rgb), .10);
                transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
            }

            #inlineFilterHost .dt-filter-bar .filter-chip .select2-selection--single .select2-selection__rendered {
                line-height: 32px;
                padding-left: .75rem;
                padding-right: 2.25rem;
                font-weight: 500;
                color: var(--bs-heading-color);
                display: flex;
                align-items: center;
                white-space: nowrap;
            }

            #inlineFilterHost .dt-filter-bar .filter-chip .select2-selection--single .select2-selection__arrow {
                height: 34px;
                right: .5rem;
            }

            #inlineFilterHost .dt-filter-trigger-badge {
                font-size: .75rem;
                line-height: 1;
                padding: .2rem .4rem;
                position: relative;
                top: -1px;
            }

            #inlineFilterHost .dt-filter-bar .filter-chip .select2-container--default.select2-container--open .select2-selection--single,
            #inlineFilterHost .dt-filter-bar .filter-chip .select2-container--default .select2-selection--single:focus {
                border-color: rgba(var(--bs-primary-rgb), .55);
                border-width: 1px !important;
                box-shadow: none !important;
                background: rgba(var(--bs-primary-rgb), .06);
            }

            #inlineFilterHost .select2-dropdown {
                border-radius: .5rem;
                overflow: hidden;
            }

            #inlineFilterHost .select2-search--dropdown {
                padding: .5rem;
            }

            #inlineFilterHost .select2-search--dropdown .select2-search__field {
                height: 34px;
                padding: .375rem .75rem;
                border-radius: .5rem;
            }

            #inlineFilterHost .select2-results__option {
                padding: .5rem .75rem;
            }

            /* Toolbar stability + z-index fixes (LegalEntities) */
            .dt-layout-end {
                align-items: center !important;
            }

            /* Prevent global core.css hover translateY on buttons (no layout shift) */
            .dt-layout-end .btn:hover,
            .dt-layout-end .btn:focus,
            .dt-layout-end .btn:active,
            #inlineFilterHost .btn:hover,
            #inlineFilterHost .btn:focus,
            #inlineFilterHost .btn:active {
                transform: none !important;
            }

            .dt-layout-end .dt-buttons {
                display: inline-flex;
                align-items: center;
                overflow: visible !important;
            }

            .dt-layout-end .dt-buttons.btn-group {
                overflow: visible !important;
            }

            /* Controlled responsive toolbar wrapping (LegalEntities) */
        @@media (max-width: 991.98px) {
                .dt-layout-end {
                    row-gap: .5rem;
                    column-gap: .75rem;
                }
            }

        @@media (max-width: 575.98px) {
                /* Keep search + action groups stable; primary action goes to its own row (intentional) */
                .dt-layout-end .dt-search {
                    flex: 1 1 100%;
                    order: 1;
                }

                .dt-layout-end .dt-buttons-actions {
                    order: 2;
                }

                .dt-layout-end .dt-buttons-primary {
                    order: 3;
                    flex: 1 1 100%;
                    display: flex;
                    justify-content: flex-end;
                }

                .dt-layout-end .dt-buttons-primary .add-new {
                    white-space: nowrap;
                }
            }

            /* Ensure badge stacking isn't covered by adjacent buttons in a btn-group */
            .dt-layout-end .dt-buttons > .btn {
                z-index: 1;
            }

            .dt-layout-end .dt-buttons > .dt-save-filter-btn {
                z-index: 2;
            }

            .dt-layout-end .dt-buttons > .dt-filter-btn {
                z-index: 3;
            }

            .dt-layout-end .dt-buttons > .dt-colvis-btn {
                z-index: 4;
            }

            .dt-save-filter-btn {
                display: inline-flex;
                align-items: center;
                white-space: nowrap;
            }

            .dt-button-collection {
                z-index: 2000;
            }

            .dt-colvis-btn .badge {
                z-index: 10;
                pointer-events: none;
            }

            .dt-filter-btn .badge {
                z-index: 10;
                pointer-events: none;
            }
        </style>
}

@section Scripts {
        <script>
            window.L10n = window.L10n || {};
            window.L10n.Active = @Json.Serialize(SharedLocalizer["Active"].Value);
            window.L10n.Passive = @Json.Serialize(SharedLocalizer["Passive"].Value);
            window.L10n.Unknown = @Json.Serialize(SharedLocalizer["Unknown"].Value);
            window.L10n.Actions = @Json.Serialize(Localizer["Actions"].Value);
            window.L10n.Edit = @Json.Serialize(Localizer["EditBtn"].Value);
            window.L10n.ViewDetails = @Json.Serialize(SharedLocalizer["ViewDetails"].Value);
            window.L10n.QuickView = @Json.Serialize(Localizer["QuickView"].Value);
            window.L10n.Search = @Json.Serialize(SharedLocalizer["Search"].Value);
            window.L10n.Export = @Json.Serialize(SharedLocalizer["Export"].Value);
            window.L10n.Import = @Json.Serialize(SharedLocalizer["Import"].Value);
            window.L10n.ComingSoon = @Json.Serialize(SharedLocalizer["ComingSoon"].Value);
            window.L10n.Print = @Json.Serialize(SharedLocalizer["Print"].Value);
            window.L10n.ShowAll = @Json.Serialize(SharedLocalizer["ShowAll"].Value);
            window.L10n.AddNewCompany = @Json.Serialize(Localizer["AddNewCompany"].Value);
            window.L10n.CompanyType = @Json.Serialize(Localizer["CompanyType"].Value);
            window.L10n.LimitedLiability = @Json.Serialize(Localizer["LimitedLiability"].Value);
            window.L10n.Corporation = @Json.Serialize(Localizer["Corporation"].Value);
            window.L10n.SoleProprietorship = @Json.Serialize(Localizer["SoleProprietorship"].Value);
            window.L10n.SelectStatus = @Json.Serialize(SharedLocalizer["SelectStatus"].Value);
            window.L10n.Status = @Json.Serialize(SharedLocalizer["Status"].Value);
            window.L10n.Filter = @Json.Serialize(SharedLocalizer["Filter"].Value);
            window.L10n.Apply = @Json.Serialize(SharedLocalizer["Apply"].Value);
            window.L10n.Reset = @Json.Serialize(SharedLocalizer["Reset"].Value);
            window.L10n.SaveView = @Json.Serialize(SharedLocalizer["SaveView"].Value);
            window.L10n.ColumnVisibility = @Json.Serialize(SharedLocalizer["ColumnVisibility"].Value);
            window.L10n.PDF = @Json.Serialize(SharedLocalizer["PDF"].Value);
            window.L10n.Copy = @Json.Serialize(SharedLocalizer["Copy"].Value);
            window.L10n.DtNoRecords = @Json.Serialize(SharedLocalizer["DtNoRecords"].Value);
            window.L10n.DtInfo = @Json.Serialize(SharedLocalizer["DtInfo"].Value);
            window.L10n.DtInfoEmpty = @Json.Serialize(SharedLocalizer["DtInfoEmpty"].Value);
            window.L10n.DtInfoFiltered = @Json.Serialize(SharedLocalizer["DtInfoFiltered"].Value);
            window.L10n.DtZeroRecords = @Json.Serialize(SharedLocalizer["DtZeroRecords"].Value);
            window.L10n.DtEmptyTable = @Json.Serialize(SharedLocalizer["DtEmptyTable"].Value);
            window.L10n.BulkDelete = @Json.Serialize(SharedLocalizer["BulkDelete"].Value);
            window.L10n.BulkDeleteConfirm = @Json.Serialize(SharedLocalizer["BulkDeleteConfirm"].Value);
            window.L10n.BulkDeleteSuccess = @Json.Serialize(SharedLocalizer["BulkDeleteSuccess"].Value);
            window.L10n.ClearSelection = @Json.Serialize(SharedLocalizer["ClearSelection"].Value);
            window.L10n.SelectedCount = @Json.Serialize(SharedLocalizer["SelectedCount"].Value);
            window.L10n.AreYouSure = @Json.Serialize(SharedLocalizer["AreYouSure"].Value);
            window.L10n.Cancel = @Json.Serialize(SharedLocalizer["Cancel"].Value);
        </script>
        <script src="~/assets/js/MDM/LegalEntities/index.js" asp-append-version="true"></script>
}
