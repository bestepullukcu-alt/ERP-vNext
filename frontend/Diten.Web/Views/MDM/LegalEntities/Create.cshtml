@model Diten.Web.Models.CreateLegalEntityViewModel
@using Diten.Web.Views.MDM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntities> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["AddNewCompany"].Value;
    Layout = "_LayoutBackbone";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">@Localizer["AddNewCompany"]</h4>
        <p class="mb-0">@Localizer["AddNewCompanyDescription"]</p>
        <nav aria-label="breadcrumb" class="mt-2 text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item">
                    <a href="/">@Localizer["BreadcrumbHome"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="javascript:void(0);">@Localizer["BreadcrumbMDM"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-action="Index">@Localizer["LegalEntitiesTitle"]</a>
                </li>
                <li class="breadcrumb-item active">@Localizer["AddNewCompany"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-4 mt-4 mt-md-0">
        <a asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="formCreateLegalEntity" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-lg-10 mx-auto">

        <form asp-action="Create" method="post" id="formCreateLegalEntity">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <div class="row g-4">
                <!-- Left Column -->
                <div class="col-12 col-md-6">
                    <!-- Card 1: Company & General Information -->
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center border-bottom">
                            <h5 class="mb-0 border-0 p-0 text-primary"><i class="bx bx-buildings me-2"></i>General
                                Information</h5>
                        </div>
                        <div class="card-body pt-4">
                            <div class="mb-3">
                                <label asp-for="Title" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                    m.Title) <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control" placeholder="e.g. ACME Corp." />
                                <span asp-validation-for="Title" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="CompanyType" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                    m.CompanyType)</label>
                                <select asp-for="CompanyType" class="form-select select2">
                                    <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                    <option value="LimitedLiability">Limited Liability</option>
                                    <option value="Corporation">Corporation</option>
                                    <option value="SoleProprietorship">Sole Proprietorship</option>
                                </select>
                                <span asp-validation-for="CompanyType" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Sector" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                    m.Sector)</label>
                                <input asp-for="Sector" class="form-control" placeholder="e.g. Technology" />
                                <span asp-validation-for="Sector" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="OrganizationRole" class="form-label text-heading">@Html.DisplayNameFor(m
                                    => m.OrganizationRole)</label>
                                <input asp-for="OrganizationRole" class="form-control"
                                    placeholder="e.g. Vendor, Customer" />
                                <span asp-validation-for="OrganizationRole" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ContactPerson" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                    m.ContactPerson)</label>
                                <input asp-for="ContactPerson" class="form-control" placeholder="John Doe" />
                                <span asp-validation-for="ContactPerson" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ParentLegalEntityId"
                                    class="form-label text-heading">@Html.DisplayNameFor(m =>
                                    m.ParentLegalEntityId)</label>
                                <select asp-for="ParentLegalEntityId" class="form-select select2">
                                    <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                    <!-- Options will be populated via AJAX -->
                                </select>
                                <span asp-validation-for="ParentLegalEntityId" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="LogoUrl" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                    m.LogoUrl)</label>
                                <input asp-for="LogoUrl" class="form-control"
                                    placeholder="https://example.com/logo.png" />
                                <span asp-validation-for="LogoUrl" class="invalid-feedback d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Communication & Localization -->
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center border-bottom">
                            <h5 class="mb-0 border-0 p-0 text-primary"><i
                                    class="bx bx-phone-call me-2"></i>Communication</h5>
                        </div>
                        <div class="card-body pt-4">
                            <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Phone" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.Phone)</label>
                                    <div class="input-group input-group-merge">
                                        <span class="input-group-text"><i class="bx bx-phone"></i></span>
                                        <input asp-for="Phone" class="form-control phone-mask"
                                            placeholder="+1 (123) 456-7890" dir="ltr" />
                                    </div>
                                    <span asp-validation-for="Phone" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.Email)</label>
                                    <div class="input-group input-group-merge">
                                        <span class="input-group-text"><i class="bx bx-envelope"></i></span>
                                        <input asp-for="Email" class="form-control" placeholder="contact@example.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Website" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                    m.Website)</label>
                                <div class="input-group input-group-merge">
                                    <span class="input-group-text"><i class="bx bx-globe"></i></span>
                                    <input asp-for="Website" class="form-control" placeholder="https://example.com" />
                                </div>
                                <span asp-validation-for="Website" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Address" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                    m.Address)</label>
                                <textarea asp-for="Address" class="form-control" rows="3"
                                    placeholder="Enter full primary address"></textarea>
                                <span asp-validation-for="Address" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DefaultCommunicationLanguage"
                                        class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.DefaultCommunicationLanguage)</label>
                                    <select asp-for="DefaultCommunicationLanguage" class="form-select select2">
                                        <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                        <option value="en">English</option>
                                        <option value="tr">Turkish</option>
                                    </select>
                                    <span asp-validation-for="DefaultCommunicationLanguage"
                                        class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DefaultTimeZone"
                                        class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.DefaultTimeZone)</label>
                                    <select asp-for="DefaultTimeZone" class="form-select select2">
                                        <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                        <option value="UTC">UTC</option>
                                        <option value="Europe/Istanbul">Europe/Istanbul</option>
                                    </select>
                                    <span asp-validation-for="DefaultTimeZone" class="invalid-feedback d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="col-12 col-md-6">
                    <!-- Card 3: Financial & Legal & Registration -->
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center border-bottom">
                            <h5 class="mb-0 border-0 p-0 text-primary"><i class="bx bx-calculator me-2"></i>Financial &
                                Registration</h5>
                        </div>
                        <div class="card-body pt-4">
                            <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="TaxOffice" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.TaxOffice) <span class="text-danger">*</span></label>
                                    <input asp-for="TaxOffice" class="form-control" placeholder="e.g. Maslak V.D." />
                                    <span asp-validation-for="TaxOffice" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="TaxNumber" class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.TaxNumber) <span class="text-danger">*</span></label>
                                    <input asp-for="TaxNumber" class="form-control" placeholder="Required" />
                                    <span asp-validation-for="TaxNumber" class="invalid-feedback d-block"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="TaxJurisdiction" class="form-label text-heading">@Html.DisplayNameFor(m
                                    => m.TaxJurisdiction)</label>
                                <input asp-for="TaxJurisdiction" class="form-control" placeholder="e.g. TR, US" />
                                <span asp-validation-for="TaxJurisdiction" class="invalid-feedback d-block"></span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PrimaryCurrency"
                                        class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.PrimaryCurrency)</label>
                                    <select asp-for="PrimaryCurrency" class="form-select select2">
                                        <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                        <option value="USD">USD ($)</option>
                                        <option value="EUR">EUR (€)</option>
                                        <option value="TRY">TRY (₺)</option>
                                    </select>
                                    <span asp-validation-for="PrimaryCurrency" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FiscalYearStart"
                                        class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.FiscalYearStart)</label>
                                    <input asp-for="FiscalYearStart" class="form-control"
                                        placeholder="e.g. January 1st" />
                                    <span asp-validation-for="FiscalYearStart" class="invalid-feedback d-block"></span>
                                </div>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="RegistrationDate"
                                        class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.RegistrationDate)</label>
                                    <div class="input-group input-group-merge">
                                        <span class="input-group-text"><i class="bx bx-calendar"></i></span>
                                        <input asp-for="RegistrationDate" type="text"
                                            class="form-control flatpickr-date" placeholder="YYYY-MM-DD" />
                                    </div>
                                    <span asp-validation-for="RegistrationDate" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="EffectiveFromDate"
                                        class="form-label text-heading">@Html.DisplayNameFor(m =>
                                        m.EffectiveFromDate)</label>
                                    <div class="input-group input-group-merge">
                                        <span class="input-group-text"><i class="bx bx-calendar-event"></i></span>
                                        <input asp-for="EffectiveFromDate" type="text"
                                            class="form-control flatpickr-date" placeholder="YYYY-MM-DD" />
                                    </div>
                                    <span asp-validation-for="EffectiveFromDate"
                                        class="invalid-feedback d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/vendor/libs/select2/select2.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />

    <script src="~/assets/js/MDM/LegalEntities/create.js" asp-append-version="true"></script>
}
