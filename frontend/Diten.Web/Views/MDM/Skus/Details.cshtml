@model Diten.Web.Models.Skus.SkuApiDetailViewModel
@using Diten.Web.Views.MDM.Skus
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SkusIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Details"].Value + " - " + (Model.Code ?? "-");
    Layout = "_LayoutBackbone";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">@Model.Code</h4>

        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item"><a asp-action="Index">@Localizer["SkusTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
            </ol>
        </nav>
    </div>

    <div class="d-flex align-content-center flex-wrap gap-4">
        <a asp-action="Index" class="btn btn-label-secondary border">@SharedLocalizer["BackToList"]</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@SharedLocalizer["EditRecord"]</a>
    </div>
</div>

<div class="row g-6">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-header border-bottom">
                <h5 class="card-title mb-0 d-flex align-items-center">
                    <i class="bx bx-info-circle me-2 text-primary"></i>@Localizer["Details"]
                </h5>
            </div>
            <div class="card-body mt-4">
                <dl class="row mb-0">
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["SkuCode"]:</dt>
                    <dd class="col-12 mb-4">@Model.Code</dd>

                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["Barcode"]:</dt>
                    <dd class="col-12 mb-4">@(Model.Barcode ?? "-")</dd>

                    <dt class="col-12 fw-medium text-heading mb-1">@SharedLocalizer["Status"]:</dt>
                    <dd class="col-12 mb-0">
                         <span class="badge bg-label-primary">@Model.LifecycleStateName</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-header border-bottom">
                <h5 class="card-title mb-0 d-flex align-items-center">
                    <i class="bx bx-link me-2 text-primary"></i>Linked Information
                </h5>
            </div>
            <div class="card-body mt-4">
                <dl class="row mb-0">
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["Product"]:</dt>
                    <dd class="col-12 mb-4">
                        <span class="fw-bold">@Model.ProductName</span><br/>
                        <small class="text-muted">@Model.ProductCode</small>
                    </dd>

                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["Composition"]:</dt>
                    <dd class="col-12 mb-0">
                        <span class="fw-bold">@Model.CompositionName</span><br/>
                        <small class="text-muted">@Model.CompositionCode (@Model.CompositionVersionLabel)</small>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-header border-bottom">
                <h5 class="card-title mb-0 d-flex align-items-center">
                    <i class="bx bx-package me-2 text-primary"></i>@Localizer["Packaging"]
                </h5>
            </div>
            <div class="card-body mt-4">
                <dl class="row mb-0">
                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["PackagingForm"]:</dt>
                    <dd class="col-12 mb-4">@Model.PackagingForm</dd>

                    <dt class="col-12 fw-medium text-heading mb-1">@Localizer["PackagingQuantity"]:</dt>
                    <dd class="col-12 mb-0">@Model.PackagingQuantity</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
