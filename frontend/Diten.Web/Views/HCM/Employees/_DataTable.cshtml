@using Diten.Web.Views.HCM.Employees
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<EmployeeMasterIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-employees" data-dt-standard="v2" class="datatables-employees table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th>@Localizer["EmployeeNumber"]</th>
                    <th class="all">@Localizer["DisplayName"]</th>
                    <th>@Localizer["WorkerType"]</th>
                    <th>@Localizer["EmploymentType"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th>@Localizer["SensitivityLevel"]</th>
                    <th>@Localizer["LegalEntity"]</th>
                    <th>@Localizer["HireDate"]</th>
                    <th>@Localizer["UpdatedAt"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
