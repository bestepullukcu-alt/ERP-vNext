@using Diten.Web.Views.Inventory.StockLedger
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<StockLedgerIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@*
    S-1 filters = the contract's /balance parameters (pack §4/§8, BG-04: no free-text search, no sort).
    Product / SKU: W-UI-01 Model A selectors, searched on the server (/StockMovements/lookups/products|skus).
    Warehouse / location: LOCATION v1 (BG-10 — empty and labelled "unavailable" until the route exists).
    Lot: typed (no lot master yet, BG-02). Stock status: the contract enum, one value (the contract takes one).
*@
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    <div class="filter-chip filter-product">
                        <select id="filterItemId" class="form-select form-select-sm" data-placeholder="@Localizer["FilterProduct"]" aria-label="@Localizer["FilterProduct"]">
                            <option value=""></option>
                        </select>
                    </div>

                    <div class="filter-chip filter-sku">
                        <select id="filterSku" class="form-select form-select-sm" data-placeholder="@Localizer["FilterSku"]" aria-label="@Localizer["FilterSku"]">
                            <option value=""></option>
                        </select>
                    </div>

                    <div class="filter-chip filter-warehouse">
                        <select id="filterWarehouseId" class="form-select form-select-sm select2" data-placeholder="@Localizer["FilterWarehouse"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    <div class="filter-chip filter-location">
                        <select id="filterLocationId" class="form-select form-select-sm select2" data-placeholder="@Localizer["FilterLocation"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    <div class="filter-chip filter-lot">
                        <input id="filterLotId" type="text" class="form-control form-control-sm" maxlength="40" placeholder="@Localizer["FilterLot"]" aria-label="@Localizer["FilterLot"]" />
                    </div>

                    <div class="filter-chip filter-status">
                        <select id="filterStockStatus" class="form-select form-select-sm select2" data-placeholder="@Localizer["FilterStockStatus"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="AVAILABLE">@Localizer["StatusAVAILABLE"]</option>
                            <option value="QUALITY_INSPECTION">@Localizer["StatusQUALITY_INSPECTION"]</option>
                            <option value="QUARANTINE">@Localizer["StatusQUARANTINE"]</option>
                            <option value="BLOCKED">@Localizer["StatusBLOCKED"]</option>
                            <option value="IN_TRANSIT">@Localizer["StatusIN_TRANSIT"]</option>
                            <option value="DAMAGED">@Localizer["StatusDAMAGED"]</option>
                            <option value="EXPIRED">@Localizer["StatusEXPIRED"]</option>
                        </select>
                    </div>

                    <small id="stockledger-picker-unavailable" class="text-muted d-none"></small>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
