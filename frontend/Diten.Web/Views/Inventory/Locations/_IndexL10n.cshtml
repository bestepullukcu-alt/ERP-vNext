@using Diten.Web.Views.Inventory.Locations
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LocationsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@*
    The location screens' shared vocabulary for the browser (list, form, status dialog, bulk bins, error sentences):
    rendered on L-2 AND on L-1, so both screens speak with one set of words. No hardcoded fallback text in the JS.
*@
<script id="locations-l10n" type="application/json">
    @Json.Serialize(new
    {
        Actions = Localizer["Actions"].Value,
        AddNewLocation = Localizer["AddNewLocation"].Value,
        Cancel = SharedLocalizer["Cancel"].Value,
        Close = SharedLocalizer["Close"].Value,
        Unknown = SharedLocalizer["Unknown"].Value,
        Filter = SharedLocalizer["Filter"].Value,
        Apply = SharedLocalizer["Apply"].Value,
        Reset = SharedLocalizer["Reset"].Value,
        ShowAll = SharedLocalizer["ShowAll"].Value,
        Search = SharedLocalizer["Search"].Value,
        SaveView = SharedLocalizer["SaveView"].Value,
        ColumnVisibility = SharedLocalizer["ColumnVisibility"].Value,
        RecordSaved = SharedLocalizer["RecordSaved"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
        DtNoRecords = SharedLocalizer["DtNoRecords"].Value,
        DtInfo = SharedLocalizer["DtInfo"].Value,
        DtInfoEmpty = SharedLocalizer["DtInfoEmpty"].Value,
        DtInfoFiltered = SharedLocalizer["DtInfoFiltered"].Value,
        DtZeroRecords = SharedLocalizer["DtZeroRecords"].Value,
        DtEmptyTable = SharedLocalizer["DtEmptyTable"].Value,
        Searching = Localizer["Searching"].Value,
        NoResults = Localizer["NoResults"].Value,
        TypeSite = Localizer["TypeSite"].Value,
        TypeWarehouse = Localizer["TypeWarehouse"].Value,
        TypeStorageLocation = Localizer["TypeStorageLocation"].Value,
        TypeZone = Localizer["TypeZone"].Value,
        TypeBin = Localizer["TypeBin"].Value,
        StatusActive = Localizer["StatusActive"].Value,
        StatusInactive = Localizer["StatusInactive"].Value,
        StatusArchived = Localizer["StatusArchived"].Value,
        ModeInternal = Localizer["ModeInternal"].Value,
        ModeExternal = Localizer["ModeExternal"].Value,
        StockableYes = Localizer["StockableYes"].Value,
        StockableNo = Localizer["StockableNo"].Value,
        ActionEdit = Localizer["ActionEdit"].Value,
        ActionAddChild = Localizer["ActionAddChild"].Value,
        ActionActivate = Localizer["ActionActivate"].Value,
        ActionDeactivate = Localizer["ActionDeactivate"].Value,
        ActionArchive = Localizer["ActionArchive"].Value,
        ActionHistory = Localizer["ActionHistory"].Value,
        ActionViewStock = Localizer["ActionViewStock"].Value,
        ActionBulkBins = Localizer["ActionBulkBins"].Value,
        FormTitleCreate = Localizer["FormTitleCreate"].Value,
        FormTitleEdit = Localizer["FormTitleEdit"].Value,
        FormTitleChild = Localizer["FormTitleChild"].Value,
        HintZoneOptional = Localizer["HintZoneOptional"].Value,
        OrgUnitsUnavailable = Localizer["OrgUnitsUnavailable"].Value,
        ValidationRequired = Localizer["ValidationRequired"].Value,
        ValidationCodeFormat = Localizer["ValidationCodeFormat"].Value,
        ValidationNameLength = Localizer["ValidationNameLength"].Value,
        ValidationCostCenterFormat = Localizer["ValidationCostCenterFormat"].Value,
        NoChanges = Localizer["NoChanges"].Value,
        ReloadLabel = Localizer["ReloadLabel"].Value,
        ErrorDetails = Localizer["ErrorDetails"].Value,
        ReferenceLabel = Localizer["ReferenceLabel"].Value,
        ConfirmActivateTitle = Localizer["ConfirmActivateTitle"].Value,
        ConfirmActivateText = Localizer["ConfirmActivateText"].Value,
        ConfirmDeactivateTitle = Localizer["ConfirmDeactivateTitle"].Value,
        ConfirmDeactivateText = Localizer["ConfirmDeactivateText"].Value,
        ConfirmArchiveTitle = Localizer["ConfirmArchiveTitle"].Value,
        ConfirmArchiveText = Localizer["ConfirmArchiveText"].Value,
        BulkCount = Localizer["BulkCount"].Value,
        BulkPreviewSummary = Localizer["BulkPreviewSummary"].Value,
        BulkSkipped = Localizer["BulkSkipped"].Value,
        BulkCreateButton = Localizer["BulkCreateButton"].Value,
        BulkNothingToCreate = Localizer["BulkNothingToCreate"].Value,
        BulkResult = Localizer["BulkResult"].Value,
