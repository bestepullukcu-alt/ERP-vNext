@model Diten.Web.Models.DemandIdeas.DemandIdeaDetailViewModel
@{
    ViewData["Title"] = "Demand Detail";
}
<div class="container-xxl flex-grow-1 container-p-y" data-testid="demand-detail">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Demand &amp; Ideas</a></li>
            <li class="breadcrumb-item active">@Model.Id</li>
        </ol>
    </nav>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">@Model.Title</h1>
            <p class="text-muted mb-0">@Model.Classification · @Model.RequestType</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Capture", new { id = Model.Id })" class="btn btn-primary btn-sm">Edit in Capture</a>
            <a href="@Url.Action("Capture", new { id = Model.Id, mode = "view" })" class="btn btn-outline-secondary btn-sm">View capture</a>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Back to list</a>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card shadow-sm border rounded-3 mb-3">
                <div class="card-header fw-semibold">Summary</div>
                <div class="card-body">
                    <p>@Model.Description</p>
                    <hr />
                    <div class="row g-3 small">
                        <div class="col-md-4"><span class="text-muted d-block">Priority</span><span class="badge rounded-pill bg-label-warning">@Model.Priority</span></div>
                        <div class="col-md-4"><span class="text-muted d-block">Status</span><span class="badge rounded-pill @(Model.Status == "Transferred" ? "bg-label-primary text-primary" : "bg-label-secondary")">@Model.Status</span></div>
                        <div class="col-md-4"><span class="text-muted d-block">Business unit</span>@Model.BusinessUnit</div>
                        <div class="col-md-4"><span class="text-muted d-block">Owner</span>@Model.OwnerName</div>
                        <div class="col-md-4"><span class="text-muted d-block">Sponsor</span>@Model.SponsorName</div>
                        <div class="col-md-4"><span class="text-muted d-block">Submitted</span>@(Model.SubmittedAt?.ToString("d") ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            @if (Model.ShowTransferSection)
            {
                <div class="card shadow-sm border rounded-3 border-primary border-opacity-25">
                    <div class="card-header d-flex align-items-center gap-2"><i class="bx bx-export text-primary"></i><span class="fw-semibold">Transfer Information</span></div>
                    <div class="card-body small d-grid gap-2">
                        @if (!string.IsNullOrEmpty(Model.TransferStatus))
                        {
                            <div><span class="text-muted d-block">Transfer status</span><span class="badge bg-label-primary text-primary">@Model.TransferStatus</span></div>
                        }
                        <div><span class="text-muted d-block">Target type</span>@(Model.TransferTargetType ?? "—")</div>
                        <div><span class="text-muted d-block">Target ID</span>@(Model.TransferTargetId ?? "—")</div>
                        <div><span class="text-muted d-block">Transfer date</span>@(Model.TransferDate?.ToString("d") ?? "—")</div>
                        <div><span class="text-muted d-block">Transferred by</span>@(Model.TransferredBy ?? "—")</div>
                        @if (!string.IsNullOrEmpty(Model.LinkedRecordUrl))
                        {
                            <a href="@Model.LinkedRecordUrl" class="btn btn-sm btn-outline-primary mt-2">Open linked record</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
