@using Diten.Web.Views.MasterDataManagement.Lskus
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LskusIndex> Localizer

<div id="inlineFilterHost" class="px-3 pt-0 pb-3">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="card card-body">
            <label class="form-label" for="lskuSearch">@Localizer["Search"]</label>
            <input id="lskuSearch" class="form-control" type="search" />
            <div class="mt-3 d-flex gap-2">
                <button id="btnFilterApply" type="button" class="btn btn-primary">@Localizer["Apply"]</button>
                <button id="btnFilterReset" type="button" class="btn btn-label-secondary">@Localizer["Reset"]</button>
            </div>
        </div>
    </div>
</div>
