@using Diten.Web.Views.MasterDataManagement.Lskus
@model Diten.Web.Models.Lskus.CreateLskuViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LskusIndex> Localizer
