@using Diten.Web.Views.MasterDataManagement.StockBehaviour
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<StockBehaviourText> Stock
@* MOD-0290-FU04 S5b (BL-600) — the unit / storage-condition labels by stable code and the list words, in the reader's
   language, for a page other than the stock forms (the item form). The stock forms carry the same keys in
   #stock-behaviour-l10n (StockBehaviourText.ScriptKeys). *@
<script id="reference-option-labels" type="application/json">@Json.Serialize(StockBehaviourText.OptionKeys.ToDictionary(key => key, key => Stock[key].Value))</script>
