@model string
@using Diten.Web.Views.MasterDataManagement.StockBehaviour
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<StockBehaviourText> Stock
@*
    MOD-0290-FU04 S5 (O-12) — the "Stock behaviour" card of a quick view, one markup for the three levels (the model is
    the level: gsku · fg · lsku). Values with their source ("from GSKU"), stockable and — when not — what is missing,
    and a lock marker on each field an approved record holds (O-8). Filled by StockBehaviour/stock-behaviour.js from
    the detail's stockBehaviour. Each level's _StockBehaviourSection.cshtml includes it; the level's quick view draws
    that only for a user with the level's stock-edit key (UAS-001).
*@
@{
    var level = Model;
    // O-3: an LSKU's units and storage are its GSKU's, always — said statically (MDM sends no source for them).
    var lskuFromGsku = level == "lsku";

    void Field(string field, string icon, string label, bool alwaysFromGsku = false)
    {
        <div class="col-12">
            <div class="backbone-preview-field">
                <i class="bx @icon"></i>
                <div class="min-w-0 flex-grow-1">
                    <div class="backbone-preview-label">
                        @Stock[label]
                        @if (alwaysFromGsku)
                        {
                            <span class="badge bg-label-info ms-1">@Stock["SourceGsku"]</span>
                        }
                        else
                        {
                            <span class="badge bg-label-info ms-1 d-none" data-sb-source="@field">@Stock["SourceGsku"]</span>
                        }
                        <i class="bx bx-lock-alt ms-1 d-none" data-sb-lock="@field" role="img"
                           aria-label="@Stock["LockedReason"]" title="@Stock["LockedReason"]"></i>
                    </div>
                    <div class="backbone-preview-value mt-1 text-break" data-sb-value="@field">-</div>
                </div>
            </div>
        </div>
    }
}

<section id="sb-section" class="card backbone-preview-section p-4 mt-4" data-sb-level="@level" aria-labelledby="sb-section-title">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
        <h6 id="sb-section-title" class="text-uppercase text-heading fw-semibold mb-0 backbone-preview-section-title">@Stock["SectionTitle"]</h6>
        <button type="button" id="sb-edit" class="btn btn-sm btn-label-primary d-none">
            <i class="bx bx-edit me-1"></i>@Stock["Edit"]
        </button>
    </div>
    <div class="row g-4">
        @{ Field("baseUomCode", "bx-ruler", "BaseUom"); }
        @{ Field("uomConversions", "bx-transfer", "UomConversions", lskuFromGsku); }
        @{ Field("shelfLifeDays", "bx-time-five", "ShelfLife"); }
        @{ Field("retestDays", "bx-test-tube", "RetestDays"); }
        @{ Field("minRemainingShelfLifeDays", "bx-hourglass", "MinRemainingShelfLife"); }
        @{ Field("storageConditionCodes", "bx-cabinet", "StorageConditions", lskuFromGsku); }
        @{ Field("lotControlled", "bx-layer", "LotControlled"); }
        @if (level != "gsku")
        {
            Field("serialControlled", "bx-barcode", "SerialControlled");
        }
        @if (level == "fg")
        {
            Field("gtin", "bx-barcode-reader", "Gtin");
        }
        @{ Field("stockable", "bx-package", "Stockable"); }
        <div class="col-12 d-none" data-sb-missing-row>
            <div class="alert alert-warning mb-0" role="status">
                <div>@Stock["NotStockableBecause"]</div>
                <div class="d-flex flex-wrap gap-1 mt-2" data-sb-missing></div>
            </div>
        </div>
    </div>
</section>
