@using Diten.Web.Views.MasterDataManagement.Gskus
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GskusIndex> Localizer
@{
    // The table card is the shared component (BL-440): the page describes it, _ListShell renders it, with the shared
    // shaped skeleton. Every header is localized HERE; the shell produces no text.
    //
    // SERVER data (FIX3 B17): MDM pages, searches, filters and sorts (orderBy whitelist: canonicalCode, packQuantity,
    // lifecycleStatus); index.js declares the same mode.
    //
    // NO SELECTION COLUMN, deliberately: GSKU identities are never bulk-deleted or bulk-changed (GxP — every identity
    // change is its own maker-checker request), so a checkbox would select into nothing.
    var listShell = new DataTableListShellViewModel
    {
        TableId = "dt-gskus",
        DataMode = "server",
        Slug = "gskus",
        HasSelection = false,
        Columns =
        [
            new DataTableColumnViewModel { Header = Localizer["CanonicalCode"].Value, CssClass = "all" },
            new DataTableColumnViewModel { Header = Localizer["GlobalProduct"].Value },
            new DataTableColumnViewModel { Header = Localizer["RevisionIdentifier"].Value },
            new DataTableColumnViewModel { Header = Localizer["PackQuantity"].Value },
            new DataTableColumnViewModel { Header = Localizer["LifecycleStatus"].Value }
        ],
        ActionsHeader = Localizer["Actions"].Value
    };
}

<partial name="~/Views/Shared/Components/DataTable/_ListShell.cshtml" model="listShell" />
