@using Diten.Web.Views.MasterDataManagement.Gskus
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GskusIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-end gap-3">
                    <div class="flex-grow-1">
                        <label for="filterGskuSearch" class="form-label">@Localizer["GskuSearch"]</label>
                        <input id="filterGskuSearch" type="search" class="form-control form-control-sm"
                               maxlength="200" placeholder="@Localizer["GskuSearchPlaceholder"]" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
