@using Diten.Web.Views.MasterDataManagement.ProductLegalEntityScopes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProductLegalEntityScopesIndex> Localizer
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
<div id="inlineFilterHost" class="px-3 pt-0 pb-3">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="card card-body">
            <label class="form-label" for="productScopeSearch">@SharedLocalizer["Search"]</label>
            <input id="productScopeSearch" class="form-control" type="search" />
            <div class="mt-3 d-flex gap-2">
                <button id="btnFilterApply" type="button" class="btn btn-primary">@SharedLocalizer["Apply"]</button>
                <button id="btnFilterReset" type="button" class="btn btn-label-secondary">@SharedLocalizer["Reset"]</button>
            </div>
        </div>
    </div>
</div>
