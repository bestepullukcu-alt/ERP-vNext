@model Diten.Web.Models.Items.ItemFormViewModel
@using Diten.Web.Views.MasterDataManagement.Items
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ItemsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["DetailsTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* UAS-001: without mdm.items.read nothing of the record is drawn (ItemsController.Details answers 403 with this face). *@
@if (!Diten.Web.Security.PermissionClaims.HasPermission(User, "mdm.items.read"))
{
    <partial name="_AccessDenied" model="@Localizer["ItemsTitle"].Value" />
    return;
}

@*
    The record is read by index.js from the proxy (api/{id}) and written into the [data-item-field] slots; the action
    buttons are drawn ONLY from the item's server-owned availableActions. Sections and their order match _Form.cshtml
    (compact contract: Identity · Stock behaviour).
*@
<div id="itemDetails" data-item-id="@Model?.Id">
    <form id="itemLifecycleToken" class="d-none" data-no-tracker>
        @Html.AntiForgeryToken()
    </form>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h5 class="mb-0"><span data-item-field="name">-</span></h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/MasterDataManagement/Items">@Localizer["ItemsTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@Localizer["DetailsTitle"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a href="/MasterDataManagement/Items" class="btn btn-label-secondary">@SharedLocalizer["Back"]</a>
            <div class="d-flex flex-wrap gap-2" id="itemDetailActions"></div>
        </div>
    </div>

    <div id="itemDetailsAlert" class="alert alert-danger d-none" role="alert"></div>

    <div class="row g-4">
        <div class="col-12 d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IdentitySection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-purchase-tag-alt"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["CanonicalCode"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="canonicalCode">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-category"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["MaterialType"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="materialType">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-check-shield"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["LifecycleStatus"]</div>
                                <div class="mt-1" data-item-field="lifecycleStatus">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-align-left"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Description"]</div>
                                <div class="backbone-preview-description mt-1" data-item-field="description">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-git-branch"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Version"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="version">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar-plus"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["CreatedAt"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="createdAt">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar-edit"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["UpdatedAt"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="updatedAt">-</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["StockBehaviourSection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-ruler"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["BaseUomCode"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="baseUomCode">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-8">
                        <div class="backbone-preview-field">
                            <i class="bx bx-snowflake"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["StorageConditionCodes"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="storageConditionCodes">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ShelfLifeDays"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="shelfLifeDays">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-test-tube"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["RetestDays"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="retestDays">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="backbone-preview-field">
                            <i class="bx bx-hourglass"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["MinRemainingShelfLifeDays"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="minRemainingShelfLifeDays">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-barcode"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["LotControlled"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="lotControlled">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-package"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Stockable"]</div>
                                <div class="backbone-preview-value mt-1" data-item-field="stockable">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-label mb-2">@Localizer["UomConversions"]</div>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>@Localizer["ConversionFrom"]</th>
                                        <th>@Localizer["ConversionTo"]</th>
                                        <th>@Localizer["ConversionNumerator"]</th>
                                        <th>@Localizer["ConversionDenominator"]</th>
                                    </tr>
                                </thead>
                                <tbody id="itemDetailConversions"></tbody>
                            </table>
                        </div>
                        <p class="text-muted small mb-0" id="itemDetailConversionsEmpty">@Localizer["NoConversions"]</p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/MasterDataManagement/Items/_IndexL10n.cshtml" />
    <script src="~/assets/js/MasterDataManagement/Items/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/MasterDataManagement/Items/index.js" asp-append-version="true"></script>
}
