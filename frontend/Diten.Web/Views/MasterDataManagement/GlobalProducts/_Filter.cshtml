@using Diten.Web.Views.MasterDataManagement.GlobalProducts
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GlobalProductsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-lifecycle-status">
                        <select id="filterLifecycleStatus" class="form-select form-select-sm select2" data-placeholder="@Localizer["LifecycleStatus"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="Draft">@Localizer["LifecycleDraft"]</option>
                            <option value="PendingIdentityApproval">@Localizer["LifecyclePendingIdentityApproval"]</option>
                            <option value="IdentityApproved">@Localizer["LifecycleIdentityApproved"]</option>
                            <option value="Retired">@Localizer["LifecycleRetired"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
