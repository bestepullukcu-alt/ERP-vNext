@using Diten.Web.Views.MasterDataManagement.GlobalProducts
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GlobalProductsIndex> Localizer
@{
    // The table card is the shared component (BL-440, WP-MDM-GP-LIST-01): the page describes it, _ListShell renders it,
    // with the shared shaped skeleton. Every header is localized HERE; the shell produces no text.
    //
    // SERVER data: MDM pages, searches, filters and sorts (orderBy whitelist: globalProductName, canonicalCode,
    // lifecycleStatus); index.js declares the same mode. MOD-0290-FU05: the Brand column is not sortable (the whitelist
    // does not change) and stands last, so the saved views' column indexes keep their meaning.
    //
    // NO SELECTION COLUMN, deliberately: Global Product identities are never bulk-deleted or bulk-changed (GxP — every
    // identity change is its own maker-checker request), so a checkbox would select into nothing.
    var listShell = new DataTableListShellViewModel
    {
        TableId = "dt-globalproducts",
        DataMode = "server",
        Slug = "globalproducts",
        HasSelection = false,
        Columns =
        [
            new DataTableColumnViewModel { Header = Localizer["CanonicalCode"].Value },
            new DataTableColumnViewModel { Header = Localizer["GlobalProductName"].Value, CssClass = "all" },
            new DataTableColumnViewModel { Header = Localizer["LifecycleStatus"].Value },
            new DataTableColumnViewModel { Header = Localizer["Brand"].Value }
        ],
        ActionsHeader = Localizer["Actions"].Value
    };
}

<partial name="~/Views/Shared/Components/DataTable/_ListShell.cshtml" model="listShell" />
