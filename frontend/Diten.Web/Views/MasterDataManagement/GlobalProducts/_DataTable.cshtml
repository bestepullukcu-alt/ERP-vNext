@using Diten.Web.Views.MasterDataManagement.GlobalProducts
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GlobalProductsIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-globalproducts" data-dt-standard="v2" class="datatables-globalproducts table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["CanonicalCode"]</th>
                    <th class="all">@Localizer["GlobalProductName"]</th>
                    <th>@Localizer["LifecycleStatus"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
