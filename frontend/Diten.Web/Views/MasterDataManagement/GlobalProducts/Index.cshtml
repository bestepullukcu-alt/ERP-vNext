@using Diten.Web.Views.MasterDataManagement.GlobalProducts
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GlobalProductsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Permissions
@{
    ViewData["Title"] = Localizer["GlobalProductsTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canCreate = Permissions.Has("mdm.global-products.create");
    var canSubmit = Permissions.Has("mdm.global-products.submit");
    var canRetire = Permissions.Has("mdm.global-products.retire");
}

@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/MasterDataManagement/GlobalProducts/_Filter.cshtml" />

<div class="mb-3"
     data-can-create="@canCreate.ToString().ToLowerInvariant()"
     data-can-submit="@canSubmit.ToString().ToLowerInvariant()"
     data-can-retire="@canRetire.ToString().ToLowerInvariant()">
    <h5 class="mb-0">@Localizer["GlobalProductsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@if (canSubmit || canRetire)
{
    <form id="globalProductLifecycleToken" class="d-none" data-no-tracker>
        @Html.AntiForgeryToken()
    </form>
}

<partial name="~/Views/MasterDataManagement/GlobalProducts/_DataTable.cshtml" />
@* Contract marker rendered by the partial: id="offcanvasDetailsPreview" *@
<partial name="~/Views/MasterDataManagement/GlobalProducts/_DetailsQuickView.cshtml" />
<partial name="~/Views/MasterDataManagement/GlobalProducts/_CreateEditOffcanvas.cshtml" />

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/MasterDataManagement/GlobalProducts/_IndexL10n.cshtml" />
    <script src="~/assets/js/MasterDataManagement/GlobalProducts/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/MasterDataManagement/GlobalProducts/index.js" asp-append-version="true"></script>
}
