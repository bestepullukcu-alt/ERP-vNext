@model Diten.Web.Models.PPM.PpmListPageViewModel

<div id="inlineFilterHost" class="px-3">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-lifecycle">
                        <select id="filterLifecycle" class="form-select form-select-sm select2" multiple="multiple"
                                data-placeholder="@ViewData["LifecycleText"]">
                            @foreach (var state in Model.LifecycleStates)
                            {
                                <option value="@state">@state</option>
                            }
                        </select>
                    </div>
                    @if (Model.ShowsReferenceability)
                    {
                    <div class="filter-chip filter-referenceability">
                        <select id="filterReferenceability" class="form-select form-select-sm select2"
                                data-placeholder="@ViewData["ReferenceabilityText"]">
                            <option value="">@ViewData["ShowAllText"]</option>
                            <option value="true">@ViewData["ReferenceableText"]</option>
                            <option value="false">@ViewData["NotReferenceableText"]</option>
                        </select>
                    </div>
                    }
                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@ViewData["ApplyText"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@ViewData["ResetText"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
