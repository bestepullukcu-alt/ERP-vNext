@using Diten.Web.Views.PPM.Initiatives
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<InitiativesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
<script id="ppm-l10n" type="application/json">
@Json.Serialize(new {
    AddNew = Localizer["AddNewInitiative"].Value, EditTitle = Localizer["EditInitiative"].Value,
    Loading = Localizer["InitiativesLoadingState"].Value, Empty = Localizer["InitiativesEmptyState"].Value,
    Error = Localizer["InitiativesErrorState"].Value, Referenceable = Localizer["Referenceable"].Value,
    NotReferenceable = Localizer["NotReferenceable"].Value,
    States = new { Proposed = Localizer["LifecycleProposed"].Value, Active = Localizer["LifecycleActive"].Value,
