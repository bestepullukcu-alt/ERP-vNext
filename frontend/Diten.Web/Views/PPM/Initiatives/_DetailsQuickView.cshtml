@using Diten.Web.Views.PPM.Initiatives
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<InitiativesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
<div class="offcanvas offcanvas-end backbone-preview-offcanvas" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="offcanvasDetailsPreviewLabel">
 <div class="offcanvas-header p-4"><div class="d-flex align-items-center min-w-0"><div class="backbone-preview-avatar d-flex align-items-center justify-content-center me-3"><i class="bx bx-bulb fs-4"></i></div><div class="min-w-0"><h5 id="oc-title" class="offcanvas-title mb-0 text-truncate">-</h5><small id="oc-subtitle" class="text-muted">-</small></div></div><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button></div>
 <div class="offcanvas-body p-4 border-top"><div class="d-flex flex-column gap-4"><section class="card backbone-preview-section p-4"><div class="row g-4">
  <div class="col-6"><div class="backbone-preview-label">@Localizer["InitiativeType"]</div><div id="oc-type" class="backbone-preview-value mt-1">-</div></div><div class="col-6"><div class="backbone-preview-label">@Localizer["Priority"]</div><div id="oc-priority" class="backbone-preview-value mt-1">-</div></div>
  <div class="col-12"><div class="backbone-preview-label">@Localizer["LifecycleState"]</div><span id="oc-lifecycle" class="badge bg-label-secondary mt-1">-</span></div><div class="col-6"><div class="backbone-preview-label">@Localizer["PlannedStartDate"]</div><div id="oc-start" class="mt-1">-</div></div><div class="col-6"><div class="backbone-preview-label">@Localizer["PlannedEndDate"]</div><div id="oc-end" class="mt-1">-</div></div>
 </div></section><section class="card backbone-preview-section p-4"><div class="backbone-preview-label">@Localizer["Description"]</div><div id="oc-description" class="backbone-preview-description mt-2">-</div></section><section id="oc-links-section" class="card backbone-preview-section p-4 d-none"><div class="backbone-preview-label">@Localizer["RelatedRecords"]</div><div id="oc-links" class="list-group list-group-flush mt-2"></div></section></div></div>
 <div class="offcanvas-footer border-top p-4 d-flex justify-content-between gap-2"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button><div id="oc-actions" class="d-flex flex-wrap justify-content-end gap-2"></div></div>
</div>
