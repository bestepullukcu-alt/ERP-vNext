@using Diten.Web.Views.DocumentManagement.Reconciliation
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReconciliationIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["DeviationsTitle"].Value;
    Layout = "_LayoutTenantShell";
    var baselineReleaseId = (Guid)(ViewData["BaselineReleaseId"] ?? Guid.Empty);
    var canManage = Perms.Has("platform.document-management.qms-baselines.publish");
}

@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/DocumentManagement/Reconciliation/_DeviationsFilter.cshtml" />

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-3">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-1">@Localizer["DeviationsTitle"]</h5>
        <p class="mb-0 text-muted">@Localizer["DeviationsDescription"]</p>
        <nav aria-label="breadcrumb" class="text-muted mt-1">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item"><a href="/DocumentManagementReconciliation">@Localizer["ReconciliationTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@Localizer["DeviationsTitle"]</li>
            </ol>
        </nav>
    </div>
    <a href="/DocumentManagementReconciliation" class="btn btn-label-secondary border">
        <i class="icon-base bx bx-arrow-back me-1"></i>@SharedLocalizer["BackToList"]
    </a>
</div>

<partial name="~/Views/DocumentManagement/Reconciliation/_DeviationsDataTable.cshtml" />

@* ── Resolve / Accept comment modal ── *@
<div class="modal fade" id="commentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="commentModalTitle">@Localizer["Resolve"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="commentDeviationId" />
                <input type="hidden" id="commentAction" />
                <label class="form-label" for="commentText">@Localizer["CommentLabel"]</label>
                <textarea class="form-control" id="commentText" rows="3"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="btnCommentConfirm">@Localizer["Confirm"]</button>
            </div>
        </div>
    </div>
</div>

@* ── Deviation details modal ── *@
<div class="modal fade" id="deviationDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["DeviationsTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-0" id="deviationDetailsBody"></dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/DocumentManagement/Reconciliation/_IndexL10n.cshtml" />
    <script>
        window.ReconciliationContext = {
            baselineReleaseId: '@baselineReleaseId',
            canManage: @Json.Serialize(canManage)
        };
    </script>
    <script src="~/assets/js/DocumentManagement/Reconciliation/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/DocumentManagement/Reconciliation/deviations.js" asp-append-version="true"></script>
}
