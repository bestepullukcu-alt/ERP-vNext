@using Diten.Web.Views.DocumentManagement.Reconciliation
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReconciliationIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["ReconciliationTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("platform.document-management.qms-baselines.publish");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["ReconciliationTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div class="reconciliation-index">
    @* ── Control card: baseline / provider / scope + run actions ── *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label class="form-label" for="reconBaseline">@Localizer["Baseline"]</label>
                    <select class="form-select select2-recon" id="reconBaseline" data-placeholder="@Localizer["SelectBaseline"]"></select>
                </div>
                <div class="col-6 col-lg-3">
                    <label class="form-label" for="reconProvider">@Localizer["Provider"]</label>
                    <select class="form-select select2-recon" id="reconProvider">
                        <option value="InHouse" selected>@Localizer["ProviderInHouse"]</option>
                        <option value="GoogleDrive" disabled>@Localizer["ProviderGoogleDrive"] — @Localizer["ProviderNotAvailable"]</option>
                    </select>
                </div>
                <div class="col-6 col-lg-3">
                    <label class="form-label" for="reconScope">@Localizer["Scope"]</label>
                    <select class="form-select select2-recon" id="reconScope">
                        <option value="DefinitionToInstance" selected>@Localizer["ScopeDefinitionToInstance"]</option>
                        <option value="DefinitionToProvider">@Localizer["ScopeDefinitionToProvider"]</option>
                        <option value="InstanceToProvider">@Localizer["ScopeInstanceToProvider"]</option>
                    </select>
                </div>
                <div class="col-12 col-lg-2 d-grid gap-2">
                    <button type="button" class="btn btn-primary" id="btnDryRun" disabled>
                        <i class="icon-base bx bx-play-circle me-1"></i>@Localizer["DryRun"]
                    </button>
                    @if (canManage)
                    {
                        <button type="button" class="btn btn-label-warning" id="btnApplyFindings" disabled>
                            <i class="icon-base bx bx-check-double me-1"></i>@Localizer["ApplyFindings"]
                        </button>
                    }
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3" id="baselineLinks">
                <a href="javascript:void(0);" class="btn btn-sm btn-label-secondary disabled" id="lnkDeviations">
                    <i class="icon-base bx bx-error-circle me-1"></i>@Localizer["OpenDeviations"]
                </a>
                <a href="javascript:void(0);" class="btn btn-sm btn-label-secondary disabled" id="lnkEvidence">
                    <i class="icon-base bx bx-folder-open me-1"></i>@Localizer["OpenEvidence"]
                </a>
            </div>
        </div>
    </div>

    @* ── Qualification readiness panel ── *@
    <div class="card mb-4 d-none" id="readinessCard">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h6 class="mb-0 d-flex align-items-center">
                    <i class="icon-base bx bx-shield-quarter me-2 text-primary"></i>@Localizer["ReadinessTitle"]
                </h6>
                <span class="badge bg-label-secondary" id="readinessBadge">-</span>
            </div>
            <div class="row g-3" id="readinessMetrics"></div>
            <div class="mt-3 d-none" id="readinessReasonsWrap">
                <span class="d-block text-muted small fw-medium mb-1">@Localizer["Reasons"]</span>
                <ul class="mb-0 ps-3" id="readinessReasons"></ul>
            </div>
        </div>
    </div>

    @* ── Summary cards (all 10 counts) ── *@
    <div class="card mb-4 d-none" id="summaryCard">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h6 class="mb-0">@Localizer["SummaryTitle"]</h6>
                <span class="badge bg-label-info d-none" id="summaryModeBadge">-</span>
            </div>
            <div class="row g-3" id="summaryMetrics"></div>
        </div>
    </div>

    @* ── Detected deviations preview ── *@
    <div class="card d-none" id="deviationsPreviewCard">
        <div class="card-body p-4">
            <h6 class="mb-3">@Localizer["DetectedDeviations"]</h6>
            <div id="deviationsPreview"></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/DocumentManagement/Reconciliation/_IndexL10n.cshtml" />
    <script>
        window.ReconciliationPerms = { canManage: @Json.Serialize(canManage) };
    </script>
    <script src="~/assets/js/DocumentManagement/Reconciliation/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/DocumentManagement/Reconciliation/index.js" asp-append-version="true"></script>
}
