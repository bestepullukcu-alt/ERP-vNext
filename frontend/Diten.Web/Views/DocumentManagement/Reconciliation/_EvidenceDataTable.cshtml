@using Diten.Web.Views.DocumentManagement.Reconciliation
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReconciliationIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-evidence" data-dt-standard="v2" class="datatables-evidence table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["RegisterFolderId"]</th>
                    <th>@Localizer["FullPath"]</th>
                    <th>@Localizer["PlatformProvider"]</th>
                    <th>@Localizer["PlatformFolderId"]</th>
                    <th>@Localizer["ProvisioningStatus"]</th>
                    <th>@Localizer["PermissionsApplied"]</th>
                    <th>@Localizer["QaVerified"]</th>
                    <th>@Localizer["DeviationStatusColumn"]</th>
                    <th>@Localizer["LastReadBackAt"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["RowActions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
