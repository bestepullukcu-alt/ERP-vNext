@using Diten.Web.Views.DocumentManagement.QmsBaselines
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<QmsBaselinesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-qmsbaselines" data-dt-standard="v2" class="datatables-qmsbaselines table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["BaselineId"]</th>
                    <th class="all">@Localizer["Version"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th>@Localizer["DefinitionCount"]</th>
                    <th>@Localizer["CreatedAt"]</th>
                    <th>@Localizer["PublishedAt"]</th>
                    <th>@Localizer["SnapshotHash"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
