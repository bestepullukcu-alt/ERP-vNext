@using Diten.Web.Views.DocumentManagement.AccessMatrix
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AccessMatrixIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = SharedLocalizer["Details"].Value;
    Layout = "_LayoutTenantShell";
    var id = (Guid)(ViewData["AccessPolicyId"] ?? Guid.Empty);
    var canManage = Perms.Has("platform.document-management.access.manage");
}

<div class="access-matrix-details" data-access-policy-id="@id">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
        <div class="d-flex flex-column justify-content-center">
            <h4 class="mb-1" id="detailTitle">@SharedLocalizer["Details"]</h4>
            <span class="text-muted small" id="detailSubtitle"></span>
            <nav aria-label="breadcrumb" class="text-muted mt-1">
                <ol class="breadcrumb mb-0 py-0">
                    <li class="breadcrumb-item"><a href="/DocumentManagementAccessMatrix">@Localizer["AccessMatrixTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-2">
            @if (canManage)
            {
                <a href="/DocumentManagementAccessMatrix/Edit/@id" class="btn btn-label-primary border">
                    <i class="icon-base bx bx-edit me-1"></i>@SharedLocalizer["Edit"]
                </a>
            }
            <a href="/DocumentManagementAccessMatrix" class="btn btn-label-secondary border">
                <i class="icon-base bx bx-arrow-back me-1"></i>@SharedLocalizer["BackToList"]
            </a>
        </div>
    </div>

    <div class="row g-6">
        <div class="col-12 col-lg-6">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-target-lock me-2"></i>@Localizer["TargetSection"]
                </h5>
                <dl class="row mb-0" id="targetDetailList"></dl>
            </section>
        </div>

        <div class="col-12 col-lg-6">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-user me-2"></i>@Localizer["PrincipalSection"]
                </h5>
                <dl class="row mb-0" id="principalDetailList"></dl>
            </section>
        </div>

        <div class="col-12 col-lg-6">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-key me-2"></i>@Localizer["PermissionsSection"]
                </h5>
                <dl class="row mb-0" id="permissionsDetailList"></dl>
            </section>
        </div>

        <div class="col-12 col-lg-6">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-calendar me-2"></i>@Localizer["ValiditySection"]
                </h5>
                <dl class="row mb-0" id="validityDetailList"></dl>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/DocumentManagement/AccessMatrix/_IndexL10n.cshtml" />
    <script src="~/assets/js/DocumentManagement/AccessMatrix/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/DocumentManagement/AccessMatrix/index.js" asp-append-version="true"></script>
}
