@using Diten.Web.Views.DocumentManagement.RepositoryAssessments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<RepositoryAssessmentsIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-repositoryassessments" data-dt-standard="v2" class="datatables-repositoryassessments table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["RepositoryName"]</th>
                    <th>@Localizer["RepositoryType"]</th>
                    <th>@Localizer["AssessmentStatus"]</th>
                    <th>@Localizer["RepositoryOwner"]</th>
                    <th>@Localizer["RepositoryLocation"]</th>
                    <th>@Localizer["LocationType"]</th>
                    <th>@Localizer["ApprovedAt"]</th>
                    <th>@Localizer["ValidUntil"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
