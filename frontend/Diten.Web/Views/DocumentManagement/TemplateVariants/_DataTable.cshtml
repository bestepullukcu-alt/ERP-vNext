@using Diten.Web.Views.DocumentManagement.TemplateVariants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TemplateVariantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-templatevariants" data-dt-standard="v2" class="datatables-templatevariants table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th class="all">@Localizer["Variant"]</th>
                    <th>@Localizer["DerivedMaster"]</th>
                    <th>@Localizer["LastRebased"]</th>
                    <th>@Localizer["DriftStatus"]</th>
                    <th>@Localizer["Scope"]</th>
                    <th>@Localizer["Owner"]</th>
                    <th>@Localizer["Approval"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
