@using Diten.Web.Views.DocumentManagement.TemplateMasters
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TemplateMastersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Details"].Value;
    Layout = "_LayoutTenantShell";
    var id = (Guid)(ViewData["TemplateMasterId"] ?? Guid.Empty);
}

<div class="template-masters-details" data-template-master-id="@id">

    @* ── Golden compact detail header: title + breadcrumb + actions ── *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
        <div class="d-flex flex-column justify-content-center">
            <h4 class="mb-1" id="detailTitle">@SharedLocalizer["Details"]</h4>
            <span class="text-muted small" id="detailSubtitle"></span>
            <nav aria-label="breadcrumb" class="text-muted mt-1">
                <ol class="breadcrumb mb-0 py-0">
                    <li class="breadcrumb-item"><a href="/DocumentManagementTemplateMasters">@Localizer["TemplateMastersTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-2">
            <a href="/DocumentManagementTemplateMasters" class="btn btn-label-secondary border">
                <i class="icon-base bx bx-arrow-back me-1"></i>@SharedLocalizer["BackToList"]
            </a>
        </div>
    </div>

    <div class="row g-6">

        @* ── Card 1: Metadata ── *@
        <div class="col-12 col-lg-6">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-id-card me-2"></i>@Localizer["MasterMetadataSection"]
                </h5>
                <dl class="row mb-0" id="masterMetadataDetailList"></dl>
            </section>
        </div>

        @* ── Card 2: Binding ── *@
        <div class="col-12 col-lg-6">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-link me-2"></i>@Localizer["Binding"]
                </h5>
                <dl class="row mb-0" id="masterBindingDetailList"></dl>
            </section>
        </div>

        @* ── Card 3: Classification ── *@
        <div class="col-12 col-lg-6">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-category me-2"></i>@Localizer["Classification"]
                </h5>
                <dl class="row mb-0" id="masterClassificationDetailList"></dl>
            </section>
        </div>

        @* ── Card 4: Owner ── *@
        <div class="col-12 col-lg-6">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-user me-2"></i>@Localizer["Owner"]
                </h5>
                <dl class="row mb-0" id="masterOwnerDetailList"></dl>
            </section>
        </div>

        @* ── Version history (golden compact DataTable surface) ── *@
        <div class="col-12">
            <h5 class="mb-3 d-flex align-items-center">
                <i class="icon-base bx bx-history me-2"></i>@Localizer["VersionHistory"]
            </h5>
            <section class="card">
                <div id="skeleton-loader" class="backbone-skeleton p-4">
                    <div class="shimmer skeleton-row skeleton-row-lg"></div>
                    <div class="shimmer skeleton-row"></div>
                    <div class="shimmer skeleton-row"></div>
                    <div class="shimmer skeleton-row"></div>
                    <div class="shimmer skeleton-row skeleton-row-last"></div>
                </div>

                <div class="card-datatable table-responsive">
                    <table id="versionHistoryTable" data-dt-standard="v2" class="datatables-version-history table border-top">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="all">@Localizer["Version"]</th>
                                <th>@Localizer["File"]</th>
                                <th>@Localizer["FileSize"]</th>
                                <th>@Localizer["PublishedBy"]</th>
                                <th>@Localizer["PublishedAt"]</th>
                                <th>@Localizer["ChangeSummary"]</th>
                            </tr>
                        </thead>
                        <tbody id="versionHistoryBody"></tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/DocumentManagement/TemplateMasters/_IndexL10n.cshtml" />
    <script src="~/assets/js/DocumentManagement/TemplateMasters/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/DocumentManagement/TemplateMasters/index.js" asp-append-version="true"></script>
}
