@using Diten.Web.Views.DocumentManagement.TemplateMasters
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TemplateMastersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Edit"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h5 class="mb-0">@SharedLocalizer["Edit"]</h5>
        <p class="mb-0 text-muted">@Localizer["TemplateMastersTitle"]</p>
    </div>
    <a href="/DocumentManagementTemplateMasters" class="btn btn-label-secondary">
        <i class="icon-base bx bx-arrow-back me-1"></i>@SharedLocalizer["Back"]
    </a>
</div>

<div class="card">
    <div class="card-body">
        <p class="mb-0 text-muted">@Localizer["MetadataEditDeferred"]</p>
    </div>
</div>
