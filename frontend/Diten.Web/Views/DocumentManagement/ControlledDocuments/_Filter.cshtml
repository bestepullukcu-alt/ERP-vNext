@using Diten.Web.Views.DocumentManagement.ControlledDocuments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ControlledDocumentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Filter Chip: Document Type (Multi-select) *@
                    <div class="filter-chip filter-type">
                        <select id="filterType" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["DocumentType"]">
                            <option value="SOP">@Localizer["TypeSop"]</option>
                            <option value="WORK_INSTRUCTION">@Localizer["TypeWorkInstruction"]</option>
                            <option value="POLICY">@Localizer["TypePolicy"]</option>
                            <option value="FORM">@Localizer["TypeForm"]</option>
                            <option value="TEMPLATE">@Localizer["TypeTemplate"]</option>
                            <option value="OTHER">@Localizer["TypeOther"]</option>
                        </select>
                    </div>

                    @* Filter Chip: Status (Multi-select) *@
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@SharedLocalizer["Status"]">
                            <option value="ACTIVE">@Localizer["StatusActive"]</option>
                            <option value="ARCHIVED">@Localizer["StatusArchived"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
