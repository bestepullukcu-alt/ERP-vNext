@using Diten.Web.Views.DocumentManagement.ControlledDocuments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ControlledDocumentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = SharedLocalizer["Details"].Value;
    Layout = "_LayoutTenantShell";
    var documentId = ViewData["DocumentId"]?.ToString();
    var canViewMasterRegister = Perms.Has("platform.document-management.master-register.view");
}

<div class="controlleddocuments-details">

    @* ── Golden compact detail header: title + breadcrumb + actions ── *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
        <div class="d-flex flex-column justify-content-center">
            <h4 class="mb-1" id="detailTitle">@SharedLocalizer["Details"]</h4>
            <nav aria-label="breadcrumb" class="text-muted">
                <ol class="breadcrumb mb-0 py-0">
                    <li class="breadcrumb-item"><a href="/DocumentManagementControlledDocuments">@Localizer["ControlledDocumentsTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-2">
            <a href="/DocumentManagementControlledDocuments" class="btn btn-label-secondary border">@SharedLocalizer["BackToList"]</a>
            <a href="/DocumentManagementControlledDocuments/VersionHistory/@documentId" class="btn btn-label-primary">
                <i class="icon-base bx bx-history me-1"></i>@Localizer["VersionHistory"]
            </a>
            <a href="/DocumentManagementControlledDocuments/Edit/@documentId" class="btn btn-primary">
                <i class="icon-base bx bx-edit me-1"></i>@Localizer["EditMetadata"]
            </a>
        </div>
    </div>

    <div class="row g-6">

        @* ── Card 1: Identity ── *@
        <div class="col-12 col-md-6 col-lg-4">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-id-card me-2"></i>@Localizer["SectionIdentity"]
                </h5>
                <dl class="row mb-0" id="detailIdentity"></dl>
            </section>
        </div>

        @if (canViewMasterRegister)
        {
            <div class="col-12">
                <section class="card backbone-preview-section p-4" id="masterRegisterCard" aria-live="polite">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div>
                            <h5 class="card-title mb-1" id="mr_card_title">
                                <i class="icon-base bx bx-book-content me-2"></i>@Localizer["MasterRegister"]
                            </h5>
                            <p class="text-muted mb-0">@Localizer["LinkedMasterRegister"]</p>
                        </div>
                        <div id="masterRegisterActions"></div>
                    </div>
                    <div class="alert alert-secondary mt-3 mb-0" id="masterRegisterState" role="status">
                        @Localizer["Loading"]
                    </div>
                    <dl class="row mt-4 mb-0 d-none" id="masterRegisterDetails"></dl>
                </section>
            </div>
        }

        @* ── Card 2: Classification ── *@
        <div class="col-12 col-md-6 col-lg-4">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-category me-2"></i>@Localizer["SectionClassification"]
                </h5>
                <dl class="row mb-0" id="detailClassification"></dl>
            </section>
        </div>

        @* ── Card 3: Lifecycle ── *@
        <div class="col-12 col-md-6 col-lg-4">
            <section class="card backbone-preview-section h-100 p-4">
                <h5 class="card-title mb-4 d-flex align-items-center">
                    <i class="icon-base bx bx-calendar me-2"></i>@Localizer["SectionLifecycle"]
                </h5>
                <dl class="row mb-0" id="detailLifecycle"></dl>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/DocumentManagement/ControlledDocuments/_IndexL10n.cshtml" />
    <script>window.ControlledDocumentContext = { documentId: '@documentId', canViewMasterRegister: @Json.Serialize(canViewMasterRegister) };</script>
    <script src="~/assets/js/DocumentManagement/ControlledDocuments/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/DocumentManagement/ControlledDocuments/detail.js" asp-append-version="true"></script>
}
