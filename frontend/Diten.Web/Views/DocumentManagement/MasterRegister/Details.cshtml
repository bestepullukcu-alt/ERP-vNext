                        <select class="form-select" id="copyType" required>
                            <option value="DigitalEffectiveCopy">@Localizer["CopyTypeDigitalEffectiveCopy"]</option>
                            <option value="DigitalControlledCopy">@Localizer["CopyTypeDigitalControlledCopy"]</option>
                            <option value="PrintedControlledCopy">@Localizer["CopyTypePrintedControlledCopy"]</option>
                            <option value="TrainingCopy">@Localizer["CopyTypeTrainingCopy"]</option>
                            <option value="ReferenceCopy">@Localizer["CopyTypeReferenceCopy"]</option>
                            <option value="ExternalSharedCopy">@Localizer["CopyTypeExternalSharedCopy"]</option>
