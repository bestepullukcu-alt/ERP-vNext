@using Diten.Web.Views.DocumentManagement.MasterRegister
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Security.Claims
@inject IHtmlLocalizer<MasterRegisterIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["DocumentMasterRegisterDetails"].Value;
    Layout = "_LayoutTenantShell";
    var id = (Guid)(ViewData["MasterRegisterEntryId"] ?? Guid.Empty);
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? User.FindFirst("sub")?.Value ?? string.Empty;
    var currentUserDisplayName = User.Identity?.Name ?? User.FindFirst(ClaimTypes.Email)?.Value ?? currentUserId;
    var canManage = Perms.Has("platform.document-management.master-register.manage");
    var canLinkControlledDocument = Perms.Has("platform.document-management.master-register.link")
        && Perms.Has("platform.document-management.master-register.registration.reconcile");
    var canViewControlledDocument = Perms.Has("platform.document-management.controlled-documents.view");

    // MOD-0029-FU25 — UX guards only; the FU07/FU08 backends ([HasPermission]) stay authoritative. Keys are the
    // EXACT seeded ones: note the lifecycle keys live under master-register.lifecycle.*, and the backend has no
    // separate mark-effective/supersede/retire key — every transition is gated by lifecycle.manage.
    var canViewIdentifiers = Perms.Has("platform.document-management.identifiers.view");
    var canAllocate = Perms.Has("platform.document-management.identifiers.allocate");
    var canReserve = Perms.Has("platform.document-management.identifiers.reserve");
    var canCancelAllocation = Perms.Has("platform.document-management.identifiers.cancel");
    var canViewLifecycle = Perms.Has("platform.document-management.master-register.lifecycle.view");
    var canManageLifecycle = Perms.Has("platform.document-management.master-register.lifecycle.manage");

    // MOD-0029-FU26 — approval (FU09) and release gate (FU10) keys. Note the real seeded names: they live under
    // master-register.approval.* / master-register.release-gate.* (singular "release-gate"), and there is NO separate
    // reject key — the backend gates both record and reject on approval.evidence.record.
    var canViewApproval = Perms.Has("platform.document-management.master-register.approval.view");
    var canRecordApprovalEvidence = Perms.Has("platform.document-management.master-register.approval.evidence.record");
    var canViewGates = Perms.Has("platform.document-management.master-register.release-gate.view");
    var canEvaluateGates = Perms.Has("platform.document-management.master-register.release-gate.evaluate");
    var canRecordGateEvidence = Perms.Has("platform.document-management.master-register.release-gate.evidence.record");

    // MOD-0029-FU27 — training (FU11) keys. Real seeded names sit under master-register.training.* and there are only
    // THREE: view (read), manage (resolve / assign / restrict) and verify (complete / effectiveness). There is no
    // separate assign/complete/effectiveness/restrict key.
    var canViewTraining = Perms.Has("platform.document-management.master-register.training.view");
    var canManageTraining = Perms.Has("platform.document-management.master-register.training.manage");
    var canVerifyTraining = Perms.Has("platform.document-management.master-register.training.verify");

    // MOD-0029-FU28 — repository assessment (FU16) and controlled copy (FU17) keys. Real seeded names: repository
    // assessments sit directly under document-management (they are tenant-global master data), while controlled
    // copies sit under master-register.controlled-copy.*. Three keys each; there is no separate issue/withdraw key.
    var canViewRepository = Perms.Has("platform.document-management.repository-assessment.view");
    var canManageRepository = Perms.Has("platform.document-management.repository-assessment.manage");
    var canApproveRepository = Perms.Has("platform.document-management.repository-assessment.approve");
    var canViewCopies = Perms.Has("platform.document-management.master-register.controlled-copy.view");
    var canManageCopies = Perms.Has("platform.document-management.master-register.controlled-copy.manage");
    var canReconcileCopies = Perms.Has("platform.document-management.master-register.controlled-copy.reconcile");
    var canOpenRepositoryTab = canViewRepository || canViewCopies;

    // MOD-0029-FU29 — Retention (FU15), Signatures (FU23) and Quality Events (FU22) keys. Real seeded names: retention
    // and legal-hold/disposition sit directly under document-management (tenant-global master data); signatures sit
    // under document-management.signatures.*; quality events fan out to quality-events/deviations/capa. These are the
    // EXACT AuthService-seeded keys (platform-scoped, SuperAdmin-only) — no unseeded key is invented.
    var canViewRetention = Perms.Has("platform.document-management.retention.view");
    var canManageRetention = Perms.Has("platform.document-management.retention.manage");
    var canViewLegalHold = Perms.Has("platform.document-management.legal-hold.view");
    var canViewSignatures = Perms.Has("platform.document-management.signatures.view");
    var canVerifySignatures = Perms.Has("platform.document-management.signatures.verify");
    var canViewQualityEvents = Perms.Has("platform.document-management.quality-events.view");
    var canViewDeviations = Perms.Has("platform.document-management.deviations.view");
    var canViewCapa = Perms.Has("platform.document-management.capa.view");
    var canOpenQualityTab = canViewQualityEvents || canViewDeviations || canViewCapa;
}

<div class="master-register-details"
     data-master-register-id="@id"
     data-current-user-id="@currentUserId"
     data-current-user-display-name="@currentUserDisplayName">

    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-3 gap-3">
        <div>
            <h5 class="mb-0" id="detailTitle">@Localizer["DocumentMasterRegisterDetails"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/DocumentManagementMasterRegister">@Localizer["DocumentMasterRegisterTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@Localizer["DocumentMasterRegisterDetails"]</li>
                </ol>
            </nav>
            <span class="text-muted small" id="detailSubtitle"></span>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <a href="/DocumentManagementMasterRegister" class="btn btn-label-secondary">
                <i class="icon-base bx bx-arrow-back me-1"></i>@SharedLocalizer["Back"]
            </a>
            @if (canManage)
            {
                <a href="/DocumentManagementMasterRegister/Edit/@id" class="btn btn-primary">
                    <i class="icon-base bx bx-edit me-1"></i>@SharedLocalizer["Edit"]
                </a>
            }
        </div>
    </div>

    <div id="detailAlert" class="alert alert-danger d-none" role="alert"></div>

    <div class="card mb-4">
        <div class="card-header p-3">
            <div class="nav-align-top">
                <ul class="nav nav-pills d-inline-flex gap-2 flex-wrap" role="tablist">
        <li class="nav-item mb-1 mb-sm-0" role="presentation">
            <button class="nav-link active small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" role="tab" aria-selected="true">
                <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-detail me-1 wc-tab-icon"></i>@Localizer["TabGeneral"]</span>
                <i class="icon-base bx bx-detail d-sm-none wc-tab-icon"></i>
            </button>
        </li>
        @if (canViewIdentifiers)
        {
            <li class="nav-item mb-1 mb-sm-0" role="presentation">
                <button class="nav-link small border shadow-none wc-tab-compact" id="tabBtn-identifiers" data-bs-toggle="tab" data-bs-target="#tab-identifiers" type="button" role="tab" aria-selected="false">
                    <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-barcode me-1 wc-tab-icon"></i>@Localizer["IdentifiersTabTitle"]</span>
                    <i class="icon-base bx bx-barcode d-sm-none wc-tab-icon"></i>
                </button>
            </li>
        }
        @if (canViewLifecycle)
        {
            <li class="nav-item mb-1 mb-sm-0" role="presentation">
                <button class="nav-link small border shadow-none wc-tab-compact" id="tabBtn-lifecycle" data-bs-toggle="tab" data-bs-target="#tab-lifecycle" type="button" role="tab" aria-selected="false">
                    <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-refresh me-1 wc-tab-icon"></i>@Localizer["LifecycleTabTitle"]</span>
                    <i class="icon-base bx bx-refresh d-sm-none wc-tab-icon"></i>
                </button>
            </li>
        }
        @if (canViewApproval)
        {
            <li class="nav-item mb-1 mb-sm-0" role="presentation">
                <button class="nav-link small border shadow-none wc-tab-compact" id="tabBtn-approval" data-bs-toggle="tab" data-bs-target="#tab-approval" type="button" role="tab" aria-selected="false">
                    <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-check-shield me-1 wc-tab-icon"></i>@Localizer["ApprovalTabTitle"]</span>
                    <i class="icon-base bx bx-check-shield d-sm-none wc-tab-icon"></i>
                </button>
            </li>
        }
        @if (canViewGates)
        {
            <li class="nav-item mb-1 mb-sm-0" role="presentation">
                <button class="nav-link small border shadow-none wc-tab-compact" id="tabBtn-gates" data-bs-toggle="tab" data-bs-target="#tab-gates" type="button" role="tab" aria-selected="false">
                    <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-log-in-circle me-1 wc-tab-icon"></i>@Localizer["ReleaseGatesTabTitle"]</span>
                    <i class="icon-base bx bx-log-in-circle d-sm-none wc-tab-icon"></i>
                </button>
            </li>
        }
        @if (canViewTraining)
        {
            <li class="nav-item mb-1 mb-sm-0" role="presentation">
                <button class="nav-link small border shadow-none wc-tab-compact" id="tabBtn-training" data-bs-toggle="tab" data-bs-target="#tab-training" type="button" role="tab" aria-selected="false">
                    <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-book-reader me-1 wc-tab-icon"></i>@Localizer["TrainingTabTitle"]</span>
                    <i class="icon-base bx bx-book-reader d-sm-none wc-tab-icon"></i>
                </button>
            </li>
        }
        @if (canOpenRepositoryTab)
        {
            <li class="nav-item mb-1 mb-sm-0" role="presentation">
                <button class="nav-link small border shadow-none wc-tab-compact" id="tabBtn-repository" data-bs-toggle="tab" data-bs-target="#tab-repository" type="button" role="tab" aria-selected="false">
                    <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-folder-open me-1 wc-tab-icon"></i>@Localizer["RepositoryTabTitle"]</span>
                    <i class="icon-base bx bx-folder-open d-sm-none wc-tab-icon"></i>
                </button>
            </li>
        }
        @if (canViewRetention)
        {
            <li class="nav-item mb-1 mb-sm-0" role="presentation">
                <button class="nav-link small border shadow-none wc-tab-compact" id="tabBtn-retention" data-bs-toggle="tab" data-bs-target="#tab-retention" type="button" role="tab" aria-selected="false">
                    <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-archive me-1 wc-tab-icon"></i>@Localizer["RetentionTabTitle"]</span>
                    <i class="icon-base bx bx-archive d-sm-none wc-tab-icon"></i>
                </button>
            </li>
        }
        @if (canViewSignatures)
        {
            <li class="nav-item mb-1 mb-sm-0" role="presentation">
                <button class="nav-link small border shadow-none wc-tab-compact" id="tabBtn-signatures" data-bs-toggle="tab" data-bs-target="#tab-signatures" type="button" role="tab" aria-selected="false">
                    <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-pen me-1 wc-tab-icon"></i>@Localizer["SignaturesTabTitle"]</span>
                    <i class="icon-base bx bx-pen d-sm-none wc-tab-icon"></i>
                </button>
            </li>
        }
        @if (canOpenQualityTab)
        {
            <li class="nav-item mb-1 mb-sm-0" role="presentation">
                <button class="nav-link small border shadow-none wc-tab-compact" id="tabBtn-quality" data-bs-toggle="tab" data-bs-target="#tab-quality" type="button" role="tab" aria-selected="false">
                    <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-error-circle me-1 wc-tab-icon"></i>@Localizer["QualityEventsTabTitle"]</span>
                    <i class="icon-base bx bx-error-circle d-sm-none wc-tab-icon"></i>
                </button>
            </li>
        }
                </ul>
            </div>
        </div>
    </div>

    <div class="tab-content p-0">
        <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
            <div class="row g-4">
                <div class="col-12 col-lg-8 d-flex flex-column gap-4">
                    <section class="card backbone-preview-section p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Identification"]</h6>
                        <div class="row g-4" id="detailIdentificationList"></div>
                    </section>

                    <section class="card backbone-preview-section p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Classification"]</h6>
                        <div class="row g-4" id="detailClassificationList"></div>
                    </section>

                    <section class="card backbone-preview-section p-4" id="controlledDocumentRelationshipCard">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                            <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["LinkedControlledDocument"]</h6>
                            <div class="d-flex flex-wrap gap-2" id="controlledDocumentActions"></div>
                        </div>
                        <div class="alert alert-danger d-none mt-3 mb-0" id="controlledDocumentAlert" role="alert"></div>
                        <div id="controlledDocumentRelationship">
                            <div class="text-muted">@Localizer["ControlledDocumentLoading"]</div>
                        </div>
                    </section>
                </div>

                <aside class="col-12 col-lg-4 d-flex flex-column gap-4">
                    <section class="card backbone-preview-section p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Ownership"]</h6>
                        <div class="row g-4" id="detailOwnershipList"></div>
                    </section>

                    <section class="card backbone-preview-section p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["GovernanceMetadata"]</h6>
                        <div class="row g-4" id="detailGovernanceList"></div>
                    </section>

                    <section class="card backbone-preview-section p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Flags"]</h6>
                        <div class="row g-4" id="detailFlagsList"></div>
                    </section>

                    <section class="card backbone-preview-section p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Provenance"]</h6>
                        <div class="row g-4" id="detailProvenanceList"></div>
                    </section>
                </aside>
            </div>
        </div>

        @* ── MOD-0029-FU25 — Identifiers (FU07). Lazy-loaded on first tab activation. ── *@
        @if (canViewIdentifiers)
        {
            <div class="tab-pane fade" id="tab-identifiers" role="tabpanel" data-tab-key="identifiers">
                <div id="identifiersAlert" class="alert alert-danger d-none" role="alert"></div>

                <div class="alert alert-info alert-dismissible fade show d-flex align-items-start" role="alert">
                    <i class="icon-base bx bx-info-circle me-2 mt-1"></i>
                    <span>@Localizer["IdentifierNeverReusedNote"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@SharedLocalizer["Close"]"></button>
                </div>

                <div class="card">
                    <div id="identifierLedgerSkeleton" class="backbone-skeleton p-4">
                        <div class="shimmer skeleton-row skeleton-row-lg"></div>
                        <div class="shimmer skeleton-row"></div>
                        <div class="shimmer skeleton-row"></div>
                        <div class="shimmer skeleton-row"></div>
                        <div class="shimmer skeleton-row skeleton-row-last"></div>
                    </div>

                    <div class="card-datatable table-responsive">
                        <table id="identifierLedgerTable" data-dt-standard="v2" class="datatables-identifier-ledger table border-top">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>@Localizer["IdentifierType"]</th>
                                    <th class="all">@Localizer["IdentifierValue"]</th>
                                    <th>@Localizer["AllocationStatus"]</th>
                                    <th>@Localizer["AllocationSource"]</th>
                                    <th>@Localizer["AllocationReasonLabel"]</th>
                                    <th>@Localizer["AllocatedAt"]</th>
                                    <th>@Localizer["AllocatedBy"]</th>
                                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody id="identifierLedgerBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @* ── MOD-0029-FU25 — Lifecycle (FU08 / FU08A). Lazy-loaded on first tab activation. ── *@
        @if (canViewLifecycle)
        {
            <div class="tab-pane fade" id="tab-lifecycle" role="tabpanel" data-tab-key="lifecycle">
                <div id="lifecycleAlert" class="alert alert-danger d-none" role="alert"></div>
                <div id="lifecycleWarnings" class="alert alert-warning d-none" role="alert"></div>

                <div class="card mb-4" id="lifecycleStateSummary">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-4">
                            <span class="text-muted small">@Localizer["AvailableTransitions"]:</span>
                            <div id="lifecycleAllowedTargets" class="d-flex flex-wrap justify-content-end gap-2">
                                <span class="text-muted small">@SharedLocalizer["Loading"]</span>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-xl-row align-items-start align-items-xl-center justify-content-between gap-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar bg-primary-subtle text-primary rounded d-flex align-items-center justify-content-center">
                                    <i class="icon-base bx bx-revision fs-3"></i>
                                </div>
                                <div>
                                    <small class="text-muted text-uppercase d-block mb-1">@Localizer["CurrentLifecycleStatus"]</small>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <div id="lifecycleCurrentStatus">@SharedLocalizer["Loading"]</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-3 gap-md-4">
                                <div>
                                    <small class="text-muted text-uppercase d-block mb-1">@Localizer["OperationalUseAllowed"]</small>
                                    <div class="fw-medium" id="lifecycleOperationalUse">@SharedLocalizer["Loading"]</div>
                                </div>
                                <div class="border-start d-none d-md-block align-self-stretch"></div>
                                <div>
                                    <small class="text-muted text-uppercase d-block mb-1">@Localizer["LastTransition"]</small>
                                    <div class="fw-medium" id="lifecycleLastTransition">@SharedLocalizer["Loading"]</div>
                                </div>
                                <div class="border-start d-none d-md-block align-self-stretch"></div>
                                <div>
                                    <small class="text-muted text-uppercase d-block mb-1">@Localizer["TransitionedBy"]</small>
                                    <div class="fw-medium text-truncate" id="lifecycleTransitionedBy">@SharedLocalizer["Loading"]</div>
                                </div>
                                <div class="border-start d-none d-md-block align-self-stretch"></div>
                                <div>
                                    <small class="text-muted text-uppercase d-block mb-1">@Localizer["LastTransitionReason"]</small>
                                    <div class="fw-medium text-break" id="lifecycleLastTransitionReason">@SharedLocalizer["Loading"]</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <section class="card">
                    <div id="lifecycleHistorySkeleton" class="backbone-skeleton p-4">
                        <div class="shimmer skeleton-row skeleton-row-lg"></div>
                        <div class="shimmer skeleton-row"></div>
                        <div class="shimmer skeleton-row"></div>
                        <div class="shimmer skeleton-row skeleton-row-last"></div>
                    </div>

                    <div class="card-datatable table-responsive">
                        <table id="lifecycleHistoryTable" data-dt-standard="v2"
                               class="datatables-lifecycle-history table border-top">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>@Localizer["FromStatus"]</th>
                                    <th>@Localizer["ToStatus"]</th>
                                    <th>@Localizer["TransitionedAt"]</th>
                                    <th>@Localizer["TransitionedBy"]</th>
                                    <th>@Localizer["TransitionReason"]</th>
                                    <th>@Localizer["TransitionComment"]</th>
                                    <th>@Localizer["EvidenceReference"]</th>
                                </tr>
                            </thead>
                            <tbody id="lifecycleHistoryBody"></tbody>
                        </table>
                    </div>
                </section>
            </div>
        }

        @* ── MOD-0029-FU26 — Approval route, segregation & evidence (FU09). Lazy-loaded. ── *@
        @if (canViewApproval)
        {
            <div class="tab-pane fade" id="tab-approval" role="tabpanel" data-tab-key="approval">
                <div id="approvalAlert" class="alert alert-danger d-none" role="alert"></div>

                <div class="row g-4 mb-4" id="approvalSummaryCards"></div>

                <div id="approvalSegregationAlert" class="alert d-none" role="alert"></div>

                <div id="approvalBlockingAlert"
                     class="alert alert-warning alert-dismissible d-none mb-4"
                     role="alert">
                    <strong class="d-block mb-2">
                        <i class="icon-base bx bx-error-circle me-2"></i>@Localizer["BlockingIssues"]
                    </strong>
                    <div id="approvalBlockingList"></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"
                            aria-label="@SharedLocalizer["Close"]"></button>
                </div>

                <div id="approvalRequirementsFilterHost" class="dt-inline-filter-host">
                    <div class="collapse" id="approvalRequirementsFilterCollapse">
                        <div class="pt-0 pb-3">
                            <form class="m-0" id="approvalRequirementsFilterForm" data-no-tracker>
                                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                                    <div class="filter-chip filter-reference-type">
                                        <select id="approvalFilterType" class="form-select form-select-sm select2"
                                                multiple="multiple" data-placeholder="@Localizer["RequirementType"]"></select>
                                    </div>
                                    <div class="filter-chip filter-priority">
                                        <select id="approvalFilterMandatory" class="form-select form-select-sm select2"
                                                data-placeholder="@Localizer["Mandatory"]">
                                            <option value="">@SharedLocalizer["ShowAll"]</option>
                                            <option value="true">@Localizer["Mandatory"]</option>
                                            <option value="false">@Localizer["Optional"]</option>
                                        </select>
                                    </div>
                                    <div class="filter-chip filter-status">
                                        <select id="approvalFilterStatus" class="form-select form-select-sm select2"
                                                multiple="multiple" data-placeholder="@SharedLocalizer["Status"]"></select>
                                    </div>
                                    <div class="ms-auto d-flex gap-3">
                                        <button type="button" class="btn btn-sm btn-primary" id="btnApprovalFilterApply">
                                            @SharedLocalizer["Apply"]
                                        </button>
                                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnApprovalFilterReset">
                                            @SharedLocalizer["Reset"]
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <section class="card">
                    <div id="approvalRequirementsSkeleton" class="backbone-skeleton p-4">
                        <div class="shimmer skeleton-row skeleton-row-lg"></div>
                        <div class="shimmer skeleton-row"></div>
                        <div class="shimmer skeleton-row"></div>
                        <div class="shimmer skeleton-row skeleton-row-last"></div>
                    </div>
                    <div class="card-datatable table-responsive">
                        <table class="datatables-approval-requirements table border-top"
                               data-dt-standard="v2" id="approvalRequirementsTable">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>@Localizer["RequirementRole"]</th>
                                    <th>@Localizer["RequirementType"]</th>
                                    <th>@Localizer["Mandatory"]</th>
                                    <th>@Localizer["SourceRule"]</th>
                                    <th>@SharedLocalizer["Status"]</th>
                                    <th>@Localizer["CompletedBy"]</th>
