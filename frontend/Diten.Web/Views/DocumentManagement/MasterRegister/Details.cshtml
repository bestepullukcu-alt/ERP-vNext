@if (canManageCopies || canReconcileCopies)
{
    @* One modal drives withdraw / reconcile / mark-missing / mark-obsolete / plan-complete / finding-resolve: they
       differ only in which evidence or reason field the backend requires. *@
    <div class="modal fade" id="copyActionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" id="copyActionForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="copyActionTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3" id="copyActionNote"></div>
                    <input type="hidden" id="copyActionMode" />
                    <input type="hidden" id="copyActionTargetId" />
                    <div class="mb-3">
                        <label class="form-label" for="copyActionLabel">@Localizer["ControlledCopy"]</label>
                        <input class="form-control" id="copyActionLabel" readonly disabled />
                    </div>
                    <div class="mb-3" id="copyActionEvidenceWrapper">
                        <label class="form-label" for="copyActionEvidence">@Localizer["EvidenceReference"] <span class="text-danger" id="copyActionEvidenceRequiredMark">*</span></label>
                        <input class="form-control" id="copyActionEvidence" maxlength="256" />
                        <div class="form-text">@Localizer["EvidenceReferenceHint"]</div>
                    </div>
                    <div class="mb-3 d-none" id="copyActionReasonWrapper">
                        <label class="form-label" for="copyActionReason">@Localizer["ObsoleteReason"] <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="copyActionReason" rows="2" maxlength="1000"></textarea>
                    </div>
                    <div class="mb-3 d-none" id="copyActionLocationWrapper">
                        <label class="form-label" for="copyActionLocation">@Localizer["CopyLocation"]</label>
                        <input class="form-control" id="copyActionLocation" maxlength="256" />
                    </div>
                    <div class="mb-3 d-none" id="copyActionCommentWrapper">
                        <label class="form-label" for="copyActionComment">@Localizer["EvidenceComment"]</label>
                        <textarea class="form-control" id="copyActionComment" rows="2" maxlength="1000"></textarea>
                    </div>
                    <div class="mb-0 d-none" id="copyActionDeviationWrapper">
                        <label class="form-label" for="copyActionDeviation">@Localizer["DeviationReference"]</label>
                        <input class="form-control" id="copyActionDeviation" maxlength="256" />
                        <div class="form-text">@Localizer["DeviationReferenceHint"]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary" id="copyActionSubmit"></button>
                </div>
            </form>
        </div>
    </div>
}

@if (canLinkControlledDocument && canViewControlledDocument)
