@if (canManageCopies)
{
    <div class="modal fade" id="registerCopyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" id="registerCopyForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["RegisterCopy"]</h5>
