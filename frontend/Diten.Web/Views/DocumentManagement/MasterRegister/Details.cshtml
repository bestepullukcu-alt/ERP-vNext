                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="repositoryDecisionTitle">@Localizer["ApproveRepository"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3" id="repositoryDecisionNote"></div>
                    <input type="hidden" id="repositoryDecisionAssessmentId" />
                    <input type="hidden" id="repositoryDecisionMode" />
                    <div class="mb-3">
                        <label class="form-label" for="repositoryDecisionLabel">@Localizer["RepositoryAssessment"]</label>
                        <input class="form-control" id="repositoryDecisionLabel" readonly disabled />
                    </div>
                    <div class="mb-3" id="repositoryApproveFields">
                        <label class="form-label" for="repositoryApprovedByRole">@Localizer["ApprovedByRole"] <span class="text-danger">*</span></label>
                        <select class="form-select" id="repositoryApprovedByRole">
                            <option value="GQD">@Localizer["ApprovalRoleGQD"]</option>
                            <option value="GQDDeputy">@Localizer["ApprovalRoleGQDDeputy"]</option>
                            <option value="ITCSVOwner">@Localizer["ApprovalRoleITCSVOwner"]</option>
                        </select>
                        <div class="form-text">@Localizer["RepositoryApproverRoleHint"]</div>
                        <label class="form-label mt-3" for="repositoryValidUntil">@Localizer["ValidUntil"]</label>
                        <input class="form-control" id="repositoryValidUntil" type="date" />
                    </div>
                    <div class="mb-0 d-none" id="repositoryRejectFields">
                        <label class="form-label" for="repositoryRejectionReason">@Localizer["RejectionReason"] <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="repositoryRejectionReason" rows="3" maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary" id="repositoryDecisionSubmit">@Localizer["ApproveRepository"]</button>
                </div>
            </form>
        </div>
    </div>
}

