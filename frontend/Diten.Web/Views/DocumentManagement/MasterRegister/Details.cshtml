                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["RegisterCopy"]</button>
                </div>
            </form>
        </div>
    </div>
