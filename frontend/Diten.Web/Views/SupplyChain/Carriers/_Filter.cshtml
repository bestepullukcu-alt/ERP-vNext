@using Diten.Web.Views.SupplyChain.Carriers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CarriersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost" class="px-3">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    @* R-2 (SHIPMENT-BUNDLE 3.2.0): the company is a REQUIRED scope, not an optional filter. The
                       service takes exactly one X-Legal-Entity-Id per call, so there is no "show all" option to
                       offer — a combined view would mean one call per company. Populated from
                       /SupplyChain/api/legal-entities and auto-selected when the tenant has exactly one. *@
                    <div class="filter-chip filter-legal-entity">
                        <select id="filterLegalEntity" class="form-select form-select-sm select2"
                                data-placeholder="@SharedLocalizer["LegalEntity"]" required></select>
                    </div>
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2"
                                data-placeholder="@SharedLocalizer["Status"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="Active">@Localizer["StatusActive"]</option>
                            <option value="Suspended">@Localizer["StatusSuspended"]</option>
                            <option value="Retired">@Localizer["StatusRetired"]</option>
                        </select>
                    </div>
                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
