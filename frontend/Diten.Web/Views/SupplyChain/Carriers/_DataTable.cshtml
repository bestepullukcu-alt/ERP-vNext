@using Diten.Web.Views.SupplyChain.Carriers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CarriersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="carriersSkeleton" class="backbone-skeleton p-4" aria-hidden="true">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>
    <div class="card-datatable table-responsive">
        <table id="dt-carriers" data-dt-standard="v2" class="datatables-carriers table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["CarrierCode"]</th>
                    <th class="all">@Localizer["DisplayName"]</th>
                    <th>@Localizer["SupportedModes"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
