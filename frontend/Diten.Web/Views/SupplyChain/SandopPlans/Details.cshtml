@using Diten.Web.Models.SupplyChain.SandopPlans
@using Diten.Web.Views.SupplyChain.SandopPlans
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SandopPlansIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    // MOD-0190 plan workspace (UI-SCOPE-0190 §3): header from getSandopPlan, snapshots and sign-offs (client-side tables),
    // Capture snapshot and Record sign-off. Status is server-owned; the page never changes it (O-03).
    ViewData["Title"] = Localizer["WorkspaceTitle"].Value;
    Layout = "_LayoutTenantShell";
    var sandopPlanId = (Guid)ViewBag.SandopPlanId;
}
@if (!Perms.Has(SandopUiPermissions.Read))
{
    <partial name="_AccessDenied" model="@Localizer["WorkspaceTitle"].Value" />
    return;
}
@{
    var permissions = SandopPagePermissions.From(Perms.Has);
}
<div id="sandop-plan-details" data-plan-id="@sandopPlanId.ToString("D")" data-legal-entity-id="@ViewBag.LegalEntityId">
    <div id="workspaceHeader" class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-3">
        <div>
            <h4 class="mb-1" id="planName">@SharedLocalizer["Loading"]</h4>
            <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 py-0"><li class="breadcrumb-item"><a asp-action="Index">@Localizer["SandopPlansTitle"]</a></li><li class="breadcrumb-item active text-primary">@Localizer["WorkspaceTitle"]</li></ol></nav>
        </div>
        <a asp-action="Index" class="btn btn-label-secondary border">@SharedLocalizer["BackToList"]</a>
    </div>
    <div id="workspaceAlert" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
    <div id="workspaceSkeleton" class="backbone-skeleton p-4" style="display:block" aria-hidden="true"><div class="shimmer skeleton-row skeleton-row-lg"></div><div class="shimmer skeleton-row"></div><div class="shimmer skeleton-row"></div><div class="shimmer skeleton-row skeleton-row-last"></div></div>
    <div id="workspaceSurface" class="row g-6" hidden inert aria-hidden="true">
        <div class="col-12">
            <section class="card backbone-preview-section p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                    <h5 class="card-title mb-0">@Localizer["WorkspaceTitle"]</h5>
                    <div class="d-flex flex-wrap gap-2" id="workspaceActions">
                        @if (permissions.CanCapture)
                        {
                            <button type="button" id="btnCaptureSnapshot" class="btn btn-primary" hidden>@Localizer["CaptureSnapshot"]</button>
                        }
                        @if (permissions.CanSignOff)
                        {
                            <button type="button" id="btnRecordSignOff" class="btn btn-label-primary" hidden>@Localizer["RecordSignOff"]</button>
                        }
                    </div>
                </div>
                <dl class="row mb-0">
                    <dt class="col-sm-4 col-lg-2 mb-3">@Localizer["PlanId"]</dt><dd id="detailPlanId" class="col-sm-8 col-lg-4 mb-3"></dd>
                    <dt class="col-sm-4 col-lg-2 mb-3">@SharedLocalizer["Status"]</dt><dd id="detailStatus" class="col-sm-8 col-lg-4 mb-3"></dd>
                    <dt class="col-sm-4 col-lg-2 mb-3">@Localizer["HorizonStart"]</dt><dd id="detailHorizonStart" class="col-sm-8 col-lg-4 mb-3"></dd>
                    <dt class="col-sm-4 col-lg-2 mb-3">@Localizer["HorizonEnd"]</dt><dd id="detailHorizonEnd" class="col-sm-8 col-lg-4 mb-3"></dd>
                    <dt class="col-sm-4 col-lg-2 mb-3">@Localizer["DemandPlanId"]</dt><dd id="detailDemandPlanId" class="col-sm-8 col-lg-4 mb-3"></dd>
                    <dt class="col-sm-4 col-lg-2 mb-3">@Localizer["DemandPlanVersion"]</dt><dd id="detailDemandPlanVersion" class="col-sm-8 col-lg-4 mb-3"></dd>
                    <dt class="col-sm-4 col-lg-2 mb-3">@Localizer["CurrentSnapshot"]</dt><dd id="detailCurrentSnapshot" class="col-sm-8 col-lg-4 mb-3"></dd>
                    <dt class="col-sm-4 col-lg-2 mb-3">@Localizer["CreatedAt"]</dt><dd id="detailCreated" class="col-sm-8 col-lg-4 mb-3"></dd>
                </dl>
            </section>
        </div>
        <div class="col-12">
            <section class="card backbone-preview-section p-4">
                <h5 class="card-title mb-4">@Localizer["SnapshotsHeader"]</h5>
                <div id="snapshotsError" class="alert alert-warning d-none" role="status"></div>
                @* Pack §23.5: bounded DataTables v2 profile (client-side; empty text from EmptyState via language.emptyTable). *@
                <div class="card-datatable table-responsive" id="snapshotsTableHost">
                    <table id="dt-sandop-snapshots" data-dt-standard="v2" class="table border-top">
                        <thead><tr><th>@Localizer["CapturedAt"]</th><th>@Localizer["SnapshotProvenance"]</th><th>@Localizer["SourceCapturedAt"]</th><th>@Localizer["SourceChecksum"]</th><th>@Localizer["SupplyInputRefsCount"]</th><th>@Localizer["CurrentSnapshot"]</th></tr></thead>
                    </table>
                </div>
            </section>
        </div>
        <div class="col-12">
            <section class="card backbone-preview-section p-4">
                <h5 class="card-title mb-4">@Localizer["SignOffsHeader"]</h5>
                <div id="signOffsError" class="alert alert-warning d-none" role="status"></div>
                <div class="card-datatable table-responsive" id="signOffsTableHost">
                    <table id="dt-sandop-signoffs" data-dt-standard="v2" class="table border-top">
                        <thead><tr><th>@Localizer["SignOffSnapshot"]</th><th>@Localizer["SignOffRole"]</th><th>@Localizer["SignOffDecision"]</th><th>@Localizer["SignOffComment"]</th><th>@Localizer["DecidedBy"]</th><th>@Localizer["DecidedAt"]</th></tr></thead>
                    </table>
                </div>
            </section>
        </div>
    </div>
    <div id="workspaceDenied" hidden><partial name="_AccessDenied" model="@Localizer["WorkspaceTitle"].Value" /></div>
    @if (permissions.CanCapture)
    {
        <partial name="~/Views/SupplyChain/SandopPlans/_CaptureSnapshotOffcanvas.cshtml" />
    }
    @if (permissions.CanSignOff)
    {
        <partial name="~/Views/SupplyChain/SandopPlans/_SignOffOffcanvas.cshtml" />
    }
    @* The anti-forgery token for the workspace mutations (each offcanvas form also carries one). *@
    @Html.AntiForgeryToken()
</div>
@* Display decision only (UAS-001 §4); the backend [SandopPermission] stays the authority. *@
<script id="sandop-plans-permissions" type="application/json">@Json.Serialize(new { canCreate = permissions.CanCreate, canCapture = permissions.CanCapture, canSignOff = permissions.CanSignOff })</script>
@section Scripts {
    <partial name="~/Views/SupplyChain/SandopPlans/_IndexL10n.cshtml" />
    <script src="~/assets/js/SupplyChain/SandopPlans/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/SupplyChain/SandopPlans/details.js" asp-append-version="true"></script>
}
