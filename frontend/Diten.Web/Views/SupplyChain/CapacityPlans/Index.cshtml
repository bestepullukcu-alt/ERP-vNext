@using Diten.Web.Models.SupplyChain.CapacityPlans
@using Diten.Web.Views.SupplyChain.CapacityPlans
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CapacityPlansIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    // MOD-0192 Capacity entry page (UI-SCOPE-0192 §3, option A): Create plan + Open plan by ID. No list of any kind — the
    // contract has none (F192-LIST, O-01).
    ViewData["Title"] = Localizer["CapacityPlansTitle"].Value;
    Layout = "_LayoutTenantShell";
}
@* UAS-001: without read, only the shared denial surface inside the shell — no title, form, skeleton, button or redirect. *@
@if (!Perms.Has(CapacityUiPermissions.Read))
{
    <partial name="_AccessDenied" model="@Localizer["CapacityPlansTitle"].Value" />
    return;
}
@{
    var permissions = CapacityPagePermissions.From(Perms.Has);
}

<div id="capacity-plans-entry">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-3">
        <div>
            <h4 class="mb-1">@Localizer["CapacityPlansTitle"]</h4>
            <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
        </div>
        @if (permissions.CanCreate)
        {
            <button type="button" id="btnCreatePlan" class="btn btn-primary" disabled>
                <i class="bx bx-plus me-1" aria-hidden="true"></i>@Localizer["CreatePlan"]
            </button>
        }
    </div>

    <div id="entryAlert" class="alert alert-danger d-none" role="alert" aria-live="assertive"></div>

    <div id="entrySkeleton" class="backbone-skeleton p-4" style="display:block" aria-hidden="true"><div class="shimmer skeleton-row skeleton-row-lg"></div><div class="shimmer skeleton-row skeleton-row-last"></div></div>

    <section id="entrySurface" class="card backbone-preview-section p-4" hidden inert aria-hidden="true">
        <h5 class="card-title mb-4">@Localizer["OpenPlan"]</h5>
        @* A lookup, not data entry: the shared required-fields tracker opts out (it would sit inside the ID row). *@
        <form id="formOpenPlan" class="row g-4" novalidate data-no-tracker>
            <div class="col-12 col-md-4">
                <label for="scopeLegalEntity" class="form-label fw-medium">@SharedLocalizer["LegalEntity"] <span class="text-danger">*</span></label>
                <select id="scopeLegalEntity" class="form-select"></select>
            </div>
            <div class="col-12 col-md-8">
                <label for="openPlanId" class="form-label fw-medium">@Localizer["PlanId"] <span class="text-danger">*</span></label>
                <div class="d-flex gap-2">
                    <div class="diten-field flex-grow-1">
                        <i class="bx bx-hash diten-field-icon" aria-hidden="true"></i>
                        <input type="text" id="openPlanId" class="form-control" dir="ltr" autocomplete="off" spellcheck="false" aria-describedby="openPlanIdHelp" />
                    </div>
                    <button type="submit" id="btnOpenPlan" class="btn btn-label-primary text-nowrap">@Localizer["OpenPlan"]</button>
                </div>
                <div id="openPlanIdHelp" class="form-text">@Localizer["PlanIdHelp"]</div>
                <div class="invalid-feedback d-block" data-for="openPlanId"></div>
            </div>
        </form>
    </section>
</div>

@if (permissions.CanCreate)
{
    <partial name="~/Views/SupplyChain/CapacityPlans/_CreateEditOffcanvas.cshtml" />
}

@* Display decision only (UAS-001 §4); the backend [CapacityPermission] stays the authority. *@
<script id="capacity-plans-permissions" type="application/json">@Json.Serialize(new { canCreate = permissions.CanCreate, canCreateScenario = permissions.CanCreateScenario, canEvaluate = permissions.CanEvaluate })</script>

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/SupplyChain/CapacityPlans/_IndexL10n.cshtml" />
    <script src="~/assets/js/SupplyChain/CapacityPlans/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/SupplyChain/CapacityPlans/index.js" asp-append-version="true"></script>
}
