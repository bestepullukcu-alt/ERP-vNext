@using Diten.Web.Views.SupplyChain.Loads
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LoadsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@* Partial view: no Layout. The page owns the skeleton (id loadsSkeleton): the shared .backbone-skeleton is display:none and
   DtDefaults fades #skeleton-loader on its own (R-4a, measured). *@
<div class="card">
    <div id="loadsSkeleton" class="backbone-skeleton p-4" aria-hidden="true">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>
    <div class="card-datatable table-responsive">
        <table id="dt-loads" data-dt-standard="v2" class="datatables-loads table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["LoadNumber"]</th>
                    <th>@Localizer["CarrierId"]</th>
                    <th>@Localizer["ShipmentIds"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
