@using Diten.Web.Views.SupplyChain.Returns
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReturnsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    // MOD-0186 r10 §35.5 (DL-4): the return details page, a declared difference from the Slim file set (manifest page
    // RETURN_DETAILS). Skeleton, empty and error are three states; no edit button; no GUID is a label (RB-24).
    ViewData["Title"] = Localizer["ReturnDetails"].Value;
    Layout = "_LayoutTenantShell";
    var returnId = (Guid)ViewBag.ReturnId;
    // UAS-001 (VER F-7, F-8): the quarantine column and the customer row are drawn only with their keys.
    var canReadHolds = Perms.Has(Diten.Web.Controllers.SupplyChainReturnsController.QuarantineHoldsRead);
    var canReadCustomers = Perms.Has(Diten.Web.Controllers.SupplyChainReturnsController.CrmAccountRead);
}
@if (!Perms.Has("supplychain.returns.read"))
{
    <partial name="_AccessDenied" model="@Localizer["ReturnDetails"].Value" />
    return;
}
<div id="return-details" data-return-id="@returnId.ToString("D")" data-legal-entity-id="@ViewBag.LegalEntityId"
     data-can-read-holds="@(canReadHolds ? "true" : "false")">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-3">
        <div><h4 class="mb-1"><bdi dir="ltr" id="detailRmaNumber">@Localizer["Loading"]</bdi></h4><nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 py-0"><li class="breadcrumb-item"><a asp-action="Index">@Localizer["ReturnsTitle"]</a></li><li class="breadcrumb-item active text-primary">@Localizer["ReturnDetails"]</li></ol></nav></div>
        <a asp-action="Index" class="btn btn-label-secondary border">@Localizer["BackToList"]</a>
    </div>
    @* State 1 — skeleton until the first load ends *@
    <div id="returnDetailsSkeleton" class="backbone-skeleton p-4" aria-hidden="true"><div class="shimmer skeleton-row skeleton-row-lg"></div><div class="shimmer skeleton-row"></div><div class="shimmer skeleton-row skeleton-row-last"></div></div>
    @* State 3 — error (a 404 is "not found", anything else the error text with a support reference) *@
    <div id="returnDetailsError" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
    @* State 2 — the cards *@
    <div id="returnDetailsCards" class="row g-6" hidden>
        <div class="col-12 col-lg-6"><section class="card backbone-preview-section h-100 p-4"><h5 class="card-title mb-4">@Localizer["ReturnSummary"]</h5><dl class="row mb-0">
            <dt class="col-5 mb-3">@SharedLocalizer["Status"]</dt><dd id="detailStatus" class="col-7 mb-3"></dd>
            <dt class="col-5 mb-3">@Localizer["ShipmentNumber"]</dt><dd id="detailShipment" class="col-7 mb-3"></dd>
            @if (canReadCustomers) {<dt class="col-5 mb-3">@Localizer["ReturnCustomer"]</dt><dd id="detailCustomer" class="col-7 mb-3"></dd>}
            <dt class="col-5 mb-3">@Localizer["ReasonCode"]</dt><dd id="detailReason" class="col-7 mb-3"></dd>
            <dt class="col-5 mb-3">@Localizer["CreatedAt"]</dt><dd id="detailCreated" class="col-7 mb-3"></dd>
        </dl></section></div>
        <div class="col-12"><section class="card backbone-preview-section p-4"><h5 class="card-title mb-4">@Localizer["ReturnLines"]</h5><div class="table-responsive"><table class="table"><thead><tr>
            <th>@Localizer["LineNumber"]</th><th>@Localizer["ProductSku"]</th><th>@Localizer["LotNumber"]</th><th class="text-end">@Localizer["ReturnQuantity"]</th><th>@Localizer["UomId"]</th><th>@Localizer["InventoryPosting"]</th>@if (canReadHolds) {<th>@Localizer["QuarantineRecords"]</th>}
        </tr></thead><tbody id="detailLines"></tbody></table></div>
        <div id="detailOtherHolds" class="small mt-3 d-none"><span class="text-muted">@Localizer["OtherHolds"]:</span> <span id="detailOtherHoldsList"></span></div>
        <div id="detailHoldsError" class="small text-danger mt-3 d-none">@Localizer["HoldsUnavailable"]</div>
        </section></div>
    </div>
</div>
@section Scripts {
    <partial name="~/Views/SupplyChain/Returns/_IndexL10n.cshtml" />
    <script src="~/assets/js/SupplyChain/Returns/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/SupplyChain/Returns/details.js" asp-append-version="true"></script>
}
