@using Diten.Web.Views.SupplyChain.Returns
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReturnsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // Partial view: no Layout. A Layout here renders a second complete tenant shell (Q64b D-02); Index.cshtml states it.
}

@* Inline collapse filter (pack §32.5): exactly the two published query parameters, nothing else (RU-02). *@
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Filter Chip: Status (single select; ShowAll omits the parameter — RU-SCR-05 keeps multi-select out) *@
                    @* R-2 (SHIPMENT-BUNDLE 3.2.0): a REQUIRED scope, not an optional filter. The service takes
                       exactly one X-Legal-Entity-Id per call, so there is no "show all" to offer. *@
                    <div class="filter-chip filter-legal-entity">
                        <select id="filterLegalEntity" class="form-select form-select-sm select2"
                                data-placeholder="@SharedLocalizer["LegalEntity"]" required></select>
                    </div>
                    <div class="filter-chip filter-status">
                        <label for="filterStatus" class="visually-hidden">@SharedLocalizer["Status"]</label>
                        <select id="filterStatus" class="form-select form-select-sm select2" data-placeholder="@SharedLocalizer["Status"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="Requested">@Localizer["StatusRequested"]</option>
                            <option value="Authorized">@Localizer["StatusAuthorized"]</option>
                            <option value="Rejected">@Localizer["StatusRejected"]</option>
                            <option value="InTransit">@Localizer["StatusInTransit"]</option>
                            <option value="Received">@Localizer["StatusReceived"]</option>
                            <option value="Dispositioned">@Localizer["StatusDispositioned"]</option>
                            <option value="Closed">@Localizer["StatusClosed"]</option>
                            <option value="Cancelled">@Localizer["StatusCancelled"]</option>
                        </select>
                    </div>

                    @* Filter Chip: Shipment ID (UUID text, not a lookup) *@
                    <div class="filter-chip filter-shipment-id">
                        <label for="filterShipmentId" class="visually-hidden">@Localizer["ShipmentId"]</label>
                        <input type="text" id="filterShipmentId" class="form-control form-control-sm" dir="ltr" autocomplete="off" spellcheck="false"
                               placeholder="@Localizer["ShipmentId"]" aria-describedby="filterShipmentIdHelp" />
                        <span id="filterShipmentIdHelp" class="visually-hidden">@Localizer["ShipmentIdHelp"]</span>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
