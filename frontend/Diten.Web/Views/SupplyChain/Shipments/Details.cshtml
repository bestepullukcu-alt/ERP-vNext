@using Diten.Web.Views.SupplyChain.Shipments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ShipmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["ShipmentDetails"].Value;
    Layout = "_LayoutTenantShell";
    var shipmentId = (Guid)ViewBag.ShipmentId;
}
@if (!Perms.Has("supplychain.shipments.read"))
{
    <partial name="_AccessDenied" model="@Localizer["ShipmentDetails"].Value" />
    return;
}
<div id="shipment-details" data-shipment-id="@shipmentId.ToString("D")">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-3">
        <div><h4 class="mb-1" id="shipmentNumber">@Localizer["Loading"]</h4><nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 py-0"><li class="breadcrumb-item"><a asp-action="Index">@Localizer["ShipmentsTitle"]</a></li><li class="breadcrumb-item active text-primary">@Localizer["ShipmentDetails"]</li></ol></nav></div>
        <a asp-action="Index" class="btn btn-label-secondary border">@SharedLocalizer["BackToList"]</a>
    </div>
    <div id="detailsAlert" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
    @* Q371: until the first load ends the page draws the shared skeleton, never cards with empty values that read as real ones. details.js hides it (display, UI-PM-05) and reveals the cards only with data. *@<div id="shipmentDetailsSkeleton" class="backbone-skeleton p-4" style="display:block" aria-hidden="true"><div class="shimmer skeleton-row skeleton-row-lg"></div><div class="shimmer skeleton-row"></div><div class="shimmer skeleton-row"></div><div class="shimmer skeleton-row skeleton-row-last"></div></div><div class="row g-6" hidden inert aria-hidden="true">
        <div class="col-12 col-lg-6"><section class="card backbone-preview-section h-100 p-4"><h5 class="card-title mb-4">@Localizer["ShipmentSummary"]</h5><dl class="row mb-0"><dt class="col-5 mb-3">@Localizer["Status"]</dt><dd id="detailStatus" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["SourceDocumentId"]</dt><dd id="detailSource" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["WarehouseReferenceId"]</dt><dd id="detailWarehouse" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["ShipToReference"]</dt><dd id="detailShipTo" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["LifecycleRoot"]</dt><dd id="detailRoot" class="col-7 mb-3"></dd></dl></section></div>
        <div class="col-12 col-lg-6"><section class="card backbone-preview-section h-100 p-4"><h5 class="card-title mb-4">@Localizer["ScheduleAndAssignment"]</h5><dl class="row mb-0"><dt class="col-5 mb-3">@Localizer["PlannedShipAt"]</dt><dd id="detailPlannedShip" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["PlannedDeliverAt"]</dt><dd id="detailPlannedDeliver" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["CarrierId"]</dt><dd id="detailCarrier" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["LoadId"]</dt><dd id="detailLoad" class="col-7 mb-3"></dd></dl></section></div>
        <div class="col-12"><section class="card backbone-preview-section p-4"><h5 class="card-title mb-4">@Localizer["ShipmentLines"]</h5><div class="table-responsive"><table class="table"><thead><tr><th>@Localizer["LineNumber"]</th><th>@Localizer["ItemId"]</th><th>@Localizer["SkuId"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["UomId"]</th><th>@Localizer["InventoryReferenceId"]</th></tr></thead><tbody id="detailLines"></tbody></table></div></section></div>
        <div class="col-12"><section class="card backbone-preview-section p-4"><h5 class="card-title mb-4">@Localizer["ProofOfDelivery"]</h5><div id="podEmpty" class="text-muted">@Localizer["Unavailable"]</div><dl id="podDetails" class="row mb-0 d-none"><dt class="col-5 mb-3">@Localizer["RecipientName"]</dt><dd id="podRecipient" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["ReceivedAt"]</dt><dd id="podReceived" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["EvidenceReferenceIds"]</dt><dd id="podEvidence" class="col-7 mb-3"></dd><dt class="col-5 mb-3">@Localizer["Note"]</dt><dd id="podNote" class="col-7 mb-3"></dd></dl></section></div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-4" id="shipmentActions" hidden inert aria-hidden="true"></div>
    <partial name="~/Views/SupplyChain/Shipments/_TransitionOffcanvas.cshtml" />
    <partial name="~/Views/SupplyChain/Shipments/_PodOffcanvas.cshtml" />
</div>
<script id="shipment-permissions" type="application/json">@Json.Serialize(new { canDispatch = Perms.Has("supplychain.shipments.dispatch"), canCancel = Perms.Has("supplychain.shipments.cancel"), canCapturePod = Perms.Has("supplychain.shipments.pod.capture") })</script>
<partial name="~/Views/SupplyChain/Shipments/_IndexL10n.cshtml" />
@section Scripts {
    <script src="~/assets/js/SupplyChain/Shipments/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/SupplyChain/Shipments/details.js" asp-append-version="true"></script>
}
