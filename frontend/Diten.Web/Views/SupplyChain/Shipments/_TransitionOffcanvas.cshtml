@using Diten.Web.Views.SupplyChain.Shipments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ShipmentsIndex> Localizer
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasTransition" aria-labelledby="transitionTitle"><div class="offcanvas-header border-bottom"><h5 id="transitionTitle">@Localizer["Transition"]</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@Localizer["Cancel"]"></button></div><div class="offcanvas-body"><form id="formTransition" novalidate>@Html.AntiForgeryToken()<div id="transitionAlert" class="alert alert-danger d-none" role="alert"></div><label class="form-label" for="targetStatus">@Localizer["TargetStatus"]</label><select id="targetStatus" class="form-select mb-3" required></select><label class="form-label" for="occurredAt">@Localizer["OccurredAt"]</label><input id="occurredAt" type="datetime-local" class="form-control" aria-describedby="occurredAtZone" required /><div id="occurredAtZone" class="form-text mb-3"></div><label class="form-label" for="reasonCode">@Localizer["ReasonCode"]</label><input id="reasonCode" class="form-control mb-3" /><label class="form-label" for="transitionNote">@Localizer["Note"]</label><textarea id="transitionNote" class="form-control mb-1" maxlength="1000" aria-describedby="transitionNoteCounter" data-note-counter="transitionNoteCounter"></textarea><div id="transitionNoteCounter" class="form-text text-end mb-3" aria-live="polite">0 / 1000</div><button type="submit" class="btn btn-primary w-100">@Localizer["ConfirmAction"]</button></form></div></div>
