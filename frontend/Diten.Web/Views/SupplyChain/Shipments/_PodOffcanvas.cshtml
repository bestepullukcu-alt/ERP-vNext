@using Diten.Web.Views.SupplyChain.Shipments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ShipmentsIndex> Localizer
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasPod" aria-labelledby="podTitle"><div class="offcanvas-header border-bottom"><h5 id="podTitle">@Localizer["CapturePod"]</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@Localizer["Cancel"]"></button></div><div class="offcanvas-body"><form id="formPod" novalidate>@Html.AntiForgeryToken()<div id="podAlert" class="alert alert-danger d-none" role="alert"></div><label class="form-label" for="recipientName">@Localizer["RecipientName"]</label><input id="recipientName" class="form-control mb-3" required /><label class="form-label" for="receivedAt">@Localizer["ReceivedAt"]</label><input id="receivedAt" type="datetime-local" class="form-control" aria-describedby="receivedAtZone" required /><div id="receivedAtZone" class="form-text mb-3"></div><label class="form-label" for="evidenceReferenceIds">@Localizer["EvidenceReferenceIds"]</label><textarea id="evidenceReferenceIds" class="form-control mb-3" required aria-describedby="evidenceHelp"></textarea><div id="evidenceHelp" class="form-text mb-3">@Localizer["EvidenceHelp"]</div><label class="form-label" for="podNoteInput">@Localizer["Note"]</label><textarea id="podNoteInput" class="form-control mb-1" maxlength="1000" aria-describedby="podNoteInputCounter" data-note-counter="podNoteInputCounter"></textarea><div id="podNoteInputCounter" class="form-text text-end mb-3" aria-live="polite">0 / 1000</div><button type="submit" class="btn btn-primary w-100">@Localizer["ConfirmAction"]</button></form></div></div>
