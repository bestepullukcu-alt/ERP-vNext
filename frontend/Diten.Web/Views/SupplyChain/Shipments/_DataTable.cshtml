@using Diten.Web.Views.SupplyChain.Shipments
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ShipmentsIndex> Localizer
@{
    // MOD-0183 r9 §24.3 Golden Compact list (DL-4): SERVER data — the MVC adapter (api) pages, searches and sorts through
    // queryShipments 3.5.0 and answers { data: { items, total, filteredTotal } }; index.js declares the same mode. No
    // selection column: the contract has no delete or bulk operation (declared exceptions, SB-14). No GUID column (SB-9).
    var listShell = new DataTableListShellViewModel
    {
        TableId = "shipmentsTable",
        DataMode = "server",
        Slug = "shipments",
        HasSelection = false,
        Columns =
        [
            new DataTableColumnViewModel { Header = Localizer["ShipmentNumber"].Value, CssClass = "all" },
            new DataTableColumnViewModel { Header = Localizer["SourceDocumentId"].Value },
            new DataTableColumnViewModel { Header = Localizer["Customer"].Value },
            new DataTableColumnViewModel { Header = Localizer["Warehouse"].Value },
            new DataTableColumnViewModel { Header = Localizer["Status"].Value },
            new DataTableColumnViewModel { Header = Localizer["PlannedShipAt"].Value },
            new DataTableColumnViewModel { Header = Localizer["PlannedDeliverAt"].Value }
        ],
        ActionsHeader = Localizer["ActionsHeader"].Value
    };
}

<partial name="~/Views/Shared/Components/DataTable/_ListShell.cshtml" model="listShell" />
