@using Diten.Web.Views.SupplyChain.Shipments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ShipmentsIndex> Localizer
<div id="inlineFilterHost" class="px-3"><div id="inlineFilterCollapse" class="collapse show"><div class="pt-0 pb-3"><div class="card"><div class="card-body py-3"><div class="row g-3 align-items-end"><div class="col-12 col-md-4"><label for="filterStatus" class="form-label">@Localizer["Status"]</label><select id="filterStatus" class="form-select form-select-sm"><option value="">@Localizer["AllStatuses"]</option><option>Draft</option><option>Planned</option><option>Dispatched</option><option>InTransit</option><option>Delivered</option><option>Exception</option><option>Closed</option><option>Cancelled</option></select></div><div class="col-12 col-md-5"><label for="filterSourceDocumentId" class="form-label">@Localizer["SourceDocumentId"]</label><input id="filterSourceDocumentId" class="form-control form-control-sm" /></div><div class="col-12 col-md-3 d-flex gap-2"><button type="button" id="btnFilterApply" class="btn btn-sm btn-primary">@Localizer["ApplyFilter"]</button><button type="button" id="btnFilterReset" class="btn btn-sm btn-label-secondary">@Localizer["ResetFilter"]</button></div></div></div></div></div></div></div>
