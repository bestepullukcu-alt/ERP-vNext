@using Diten.Web.Views.SupplyChain.Shipments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ShipmentsIndex> Localizer
@* MOD-0183 r9 §24.3: status as Select2 (localized names, the contract's English values), source document as text, company
   from the shared selector above the list (it is the scope, not a filter). *@
<div id="inlineFilterHost" class="dt-inline-filter-host">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" data-placeholder="@Localizer["Status"]">
                            <option value="">@Localizer["AllStatuses"]</option>
                            <option value="Draft">@Localizer["StatusDraft"]</option>
                            <option value="Planned">@Localizer["StatusPlanned"]</option>
                            <option value="Dispatched">@Localizer["StatusDispatched"]</option>
                            <option value="InTransit">@Localizer["StatusInTransit"]</option>
                            <option value="Delivered">@Localizer["StatusDelivered"]</option>
                            <option value="Exception">@Localizer["StatusException"]</option>
                            <option value="Closed">@Localizer["StatusClosed"]</option>
                            <option value="Cancelled">@Localizer["StatusCancelled"]</option>
                        </select>
                    </div>
                    <div class="filter-chip filter-source">
                        <input id="filterSourceDocumentId" class="form-control form-control-sm" placeholder="@Localizer["SourceDocumentId"]" aria-label="@Localizer["SourceDocumentId"]" />
                    </div>
                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@Localizer["ApplyFilter"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@Localizer["ResetFilter"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
