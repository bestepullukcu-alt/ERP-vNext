@model Diten.Web.Models.SupplyChain.Shipments.CreateShipmentViewModel
@using Diten.Web.Views.SupplyChain.Shipments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ShipmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    // MOD-0183 r9 §24.1 (SB-1): the sender is the company of the session, from the shared company selector of slice A. It is
    // shown read-only here and rides the query, never the body (R-2).
    var company = Diten.Web.Models.Inventory.CompanySelection.TokenLegalEntity(User)
        ?? Diten.Web.Models.Inventory.CompanySelection.SelectedCompany(Context.Request, User);
    // §24.1 (SB-3): without crm.account.read the customer field is disabled with a localized reason and no CRM request is made.
    var canReadCustomers = Perms.Has("crm.account.read");
}
@* MOD-0183 r9 §24.2 Golden Compact form: 5 header + 5 per line = 10 fields (form_field_count: 10). sourceModule, sourceType,
   lineNumber, uomId and inventoryReferenceId are not user inputs; shipToReference is the chosen account's address (OD-183-4). *@
<form id="formShipment" data-company-id="@company?.ToString("D")" data-customers-enabled="@(canReadCustomers ? "true" : "false")" novalidate>
    @Html.AntiForgeryToken()
    <div id="formShipmentAlert" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
    <div class="row g-4">
        <div class="col-12 col-lg-6"><section class="card h-100"><div class="card-body p-4"><h6 class="card-section-title mb-4"><i class="bx bx-link" aria-hidden="true"></i>@Localizer["SourceAndDestination"]</h6><div class="row g-3">
            <div class="col-12"><span class="form-label d-block">@Localizer["SenderCompany"]</span><p id="senderCompany" class="mb-0 fw-medium" aria-live="polite">@Localizer["Loading"]</p></div>
            <div class="col-12"><label class="form-label" for="sourceDocumentId">@Localizer["SourceDocumentId"] *</label><div class="diten-field"><i class="bx bx-file diten-field-icon" aria-hidden="true"></i><input id="sourceDocumentId" class="form-control" maxlength="200" required /></div></div>
            <div class="col-12"><label class="form-label" for="warehouseReferenceId">@Localizer["Warehouse"] *</label><select id="warehouseReferenceId" class="form-select" data-placeholder="@Localizer["WarehouseSelect"]" required></select></div>
            <div class="col-12"><label class="form-label" for="customerRef">@Localizer["Customer"] *</label><select id="customerRef" class="form-select" data-placeholder="@Localizer["CustomerSelect"]" aria-describedby="customerHelp" required disabled="@(!canReadCustomers)"></select>
                <div id="customerHelp" class="form-text @(canReadCustomers ? "" : "text-danger")">@(canReadCustomers ? Localizer["CustomerHelp"] : Localizer["CustomerNoAccess"])</div></div>
            <div class="col-12"><span class="form-label d-block">@Localizer["CustomerAddress"]</span><address id="customerAddress" class="mb-0 text-body-secondary" aria-live="polite">—</address></div>
        </div></div></section></div>
        <div class="col-12 col-lg-6"><section class="card h-100"><div class="card-body p-4"><h6 class="card-section-title mb-4"><i class="bx bx-calendar" aria-hidden="true"></i>@Localizer["Schedule"]</h6><div class="row g-3">
            <div class="col-12"><label class="form-label" for="plannedShipAt">@Localizer["PlannedShipAt"] *</label><div class="diten-field"><i class="bx bx-calendar diten-field-icon" aria-hidden="true"></i><input id="plannedShipAt" class="form-control flatpickr-date flatpickr-date-time" required /></div></div>
            <div class="col-12"><label class="form-label" for="plannedDeliverAt">@Localizer["PlannedDeliverAt"]</label><div class="diten-field"><i class="bx bx-calendar-check diten-field-icon" aria-hidden="true"></i><input id="plannedDeliverAt" class="form-control flatpickr-date flatpickr-date-time" /></div></div>
        </div></div></section></div>
        <div class="col-12"><section class="card"><div class="card-body p-4"><div class="d-flex justify-content-between align-items-center mb-4"><h6 class="card-section-title mb-0"><i class="bx bx-list-ul" aria-hidden="true"></i>@Localizer["ShipmentLines"]</h6><button type="button" id="btnAddLine" class="btn btn-sm btn-label-primary">@Localizer["AddLine"]</button></div><div id="shipmentLines" class="vstack gap-3"></div></div></section></div>
    </div>
</form>
<template id="shipmentLineTemplate"><div class="shipment-line border rounded p-3"><div class="row g-3">
    <div class="col-12 col-md-1"><span class="form-label d-block">@Localizer["LineNumber"]</span><span class="badge bg-label-secondary" data-line-number>1</span></div>
    <div class="col-12 col-md-5"><label class="form-label" data-field-label="sku">@Localizer["ProductSku"] *</label><select data-field="sku" class="form-select" data-placeholder="@Localizer["ProductSelect"]" required></select></div>
    <div class="col-12 col-md-3"><label class="form-label" data-field-label="lotId">@Localizer["LotId"]</label><select data-field="lotId" class="form-select" data-placeholder="@Localizer["LotSelect"]" disabled></select><div class="form-text" data-lot-help>@Localizer["ProductFirst"]</div></div>
    <div class="col-12 col-md-3"><label class="form-label" data-field-label="quantity">@Localizer["Quantity"] *</label><div class="input-group"><input data-field="quantity" inputmode="decimal" class="form-control" required /><span class="input-group-text" data-uom title="@Localizer["UomId"]">—</span></div></div>
    <div class="col-12 col-md-6"><label class="form-label" data-field-label="fromLocationId">@Localizer["FromLocationId"] *</label><select data-field="fromLocationId" class="form-select" data-placeholder="@Localizer["LocationSelect"]" required disabled></select><div class="form-text" data-location-help>@Localizer["WarehouseFirst"]</div></div>
    <div class="col-12 col-md-6 d-none" data-fefo><label class="form-label" data-field-label="fefoBypassReason">@Localizer["FefoBypassReason"] *</label><textarea data-field="fefoBypassReason" class="form-control" rows="2" maxlength="1000"></textarea></div>
    <div class="col-12 text-end"><button type="button" class="btn btn-sm btn-label-danger remove-line">@Localizer["RemoveLine"]</button></div>
</div></div></template>
