@model Diten.Web.Models.SupplyChain.Shipments.CreateShipmentViewModel
@using Diten.Web.Views.SupplyChain.Shipments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ShipmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
<form id="formShipment" novalidate>
    @Html.AntiForgeryToken()
    <div id="formShipmentAlert" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
    <div class="row g-4">
        <div class="col-12 col-lg-6"><section class="card h-100"><div class="card-body p-4"><h6 class="card-section-title mb-4"><i class="bx bx-link" aria-hidden="true"></i>@Localizer["SourceAndDestination"]</h6><div class="row g-3">
            @* R-2: the company is chosen here and rides the query — never the body, which the service refuses scope in — so this select is not model-bound. *@
            <div class="col-12 col-md-6"><label class="form-label" for="formLegalEntity">@SharedLocalizer["LegalEntity"] *</label><div class="diten-field"><i class="bx bx-buildings diten-field-icon" aria-hidden="true"></i><select id="formLegalEntity" class="form-select" required></select></div></div>
            <div class="col-12 col-md-6"><label class="form-label" for="sourceModule">@Localizer["SourceModule"] *</label><div class="diten-field"><i class="bx bx-grid-alt diten-field-icon" aria-hidden="true"></i><input id="sourceModule" class="form-control" required /></div></div>
            <div class="col-12 col-md-6"><label class="form-label" for="sourceType">@Localizer["SourceType"] *</label><div class="diten-field"><i class="bx bx-category diten-field-icon" aria-hidden="true"></i><input id="sourceType" class="form-control" required /></div></div>
            <div class="col-12"><label class="form-label" for="sourceDocumentId">@Localizer["SourceDocumentId"] *</label><div class="diten-field"><i class="bx bx-file diten-field-icon" aria-hidden="true"></i><input id="sourceDocumentId" class="form-control" required /></div></div>
            <div class="col-12 col-md-6"><label class="form-label" for="warehouseReferenceId">@Localizer["WarehouseReferenceId"] *</label><div class="diten-field"><i class="bx bx-building-house diten-field-icon" aria-hidden="true"></i><input id="warehouseReferenceId" class="form-control" required /></div></div>
            <div class="col-12 col-md-6"><label class="form-label" for="shipToReference">@Localizer["ShipToReference"] *</label><div class="diten-field"><i class="bx bx-map-pin diten-field-icon" aria-hidden="true"></i><input id="shipToReference" class="form-control" required /></div></div>
        </div></div></section></div>
        <div class="col-12 col-lg-6"><section class="card h-100"><div class="card-body p-4"><h6 class="card-section-title mb-4"><i class="bx bx-calendar" aria-hidden="true"></i>@Localizer["Schedule"]</h6><div class="row g-3">
            <div class="col-12"><label class="form-label" for="plannedShipAt">@Localizer["PlannedShipAt"] *</label><div class="diten-field"><i class="bx bx-calendar diten-field-icon" aria-hidden="true"></i><input id="plannedShipAt" class="form-control flatpickr-date-time" required /></div></div>
            <div class="col-12"><label class="form-label" for="plannedDeliverAt">@Localizer["PlannedDeliverAt"]</label><div class="diten-field"><i class="bx bx-calendar-check diten-field-icon" aria-hidden="true"></i><input id="plannedDeliverAt" class="form-control flatpickr-date-time" /></div></div>
        </div></div></section></div>
        <div class="col-12"><section class="card"><div class="card-body p-4"><div class="d-flex justify-content-between align-items-center mb-4"><h6 class="card-section-title mb-0"><i class="bx bx-list-ul" aria-hidden="true"></i>@Localizer["ShipmentLines"]</h6><button type="button" id="btnAddLine" class="btn btn-sm btn-label-primary">@Localizer["AddLine"]</button></div><div id="shipmentLines" class="vstack gap-3"></div></div></section></div>
    </div>
</form>
<template id="shipmentLineTemplate"><div class="shipment-line border rounded p-3"><div class="row g-3"><div class="col-12 col-md-2"><label class="form-label" data-field-label="lineNumber">@Localizer["LineNumber"] *</label><div class="diten-field"><i class="bx bx-hash diten-field-icon" aria-hidden="true"></i><input data-field="lineNumber" class="form-control" required /></div></div><div class="col-12 col-md-2"><label class="form-label" data-field-label="itemId">@Localizer["ItemId"] *</label><div class="diten-field"><i class="bx bx-cube diten-field-icon" aria-hidden="true"></i><input data-field="itemId" class="form-control" required /></div></div><div class="col-12 col-md-2"><label class="form-label" data-field-label="skuId">@Localizer["SkuId"] *</label><div class="diten-field"><i class="bx bx-barcode diten-field-icon" aria-hidden="true"></i><input data-field="skuId" class="form-control" required /></div></div><div class="col-12 col-md-2"><label class="form-label" data-field-label="quantity">@Localizer["Quantity"] *</label><div class="diten-field"><i class="bx bx-calculator diten-field-icon" aria-hidden="true"></i><input data-field="quantity" inputmode="decimal" class="form-control" required /></div></div><div class="col-12 col-md-2"><label class="form-label" data-field-label="uomId">@Localizer["UomId"] *</label><div class="diten-field"><i class="bx bx-ruler diten-field-icon" aria-hidden="true"></i><input data-field="uomId" class="form-control" required /></div></div><div class="col-12 col-md-2"><label class="form-label" data-field-label="inventoryReferenceId">@Localizer["InventoryReferenceId"]</label><div class="diten-field"><i class="bx bx-package diten-field-icon" aria-hidden="true"></i><input data-field="inventoryReferenceId" class="form-control" /></div></div><div class="col-12 text-end"><button type="button" class="btn btn-sm btn-label-danger remove-line">@Localizer["RemoveLine"]</button></div></div></div></template>
