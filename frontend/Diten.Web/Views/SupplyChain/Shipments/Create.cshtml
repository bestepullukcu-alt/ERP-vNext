@using Diten.Web.Views.SupplyChain.Shipments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ShipmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["CreateShipment"].Value;
    Layout = "_LayoutTenantShell";
}
@if (!Perms.Has("supplychain.shipments.create"))
{
    <partial name="_AccessDenied" model="@Localizer["CreateShipment"].Value" />
    return;
}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-3">
    <div><h5 class="mb-0">@Localizer["CreateShipment"]</h5><nav aria-label="breadcrumb"><ol class="breadcrumb mb-0 py-0"><li class="breadcrumb-item"><a asp-action="Index">@Localizer["ShipmentsTitle"]</a></li><li class="breadcrumb-item active text-primary">@Localizer["CreateShipment"]</li></ol></nav></div>
    <div class="d-flex gap-2"><a asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a><button type="submit" form="formShipment" class="btn btn-primary" id="btnSaveShipment">@SharedLocalizer["Save"]</button></div>
</div>
<partial name="~/Views/SupplyChain/Shipments/_Form.cshtml" />
<partial name="~/Views/SupplyChain/Shipments/_IndexL10n.cshtml" />
@section Styles { <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" asp-append-version="true" /> }
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js" asp-append-version="true"></script>
    <script src="~/assets/js/shared/diten-datefield.js" asp-append-version="true"></script>
    <script src="~/assets/js/SupplyChain/Shipments/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/SupplyChain/Shipments/create.js" asp-append-version="true"></script>
}
