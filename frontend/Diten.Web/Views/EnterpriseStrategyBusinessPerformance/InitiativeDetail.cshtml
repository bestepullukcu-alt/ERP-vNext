@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Initiative Detail";
    var initiativeId = (ViewData["InitiativeId"]?.ToString() ?? string.Empty);
}

@await Html.PartialAsync("~/Views/EnterpriseStrategyBusinessPerformance/Components/_SubdomainShell.cshtml", Model)

<div class="initiative-detail-shell">
    <div class="card mb-3 initiative-detail-header-card">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <div class="small text-muted text-uppercase">Delivery Initiative</div>
                <h4 class="mb-1" id="initiative-detail-title">Initiative @initiativeId</h4>
                <div id="initiative-detail-subtitle" class="text-muted">Loading initiative detail...</div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-outline-secondary" href="/management-governance/delivery-execution/initiatives">Back to List</a>
                <a class="btn btn-sm btn-primary" id="initiative-detail-edit-btn" href="/management-governance/delivery-execution/initiatives/@Uri.EscapeDataString(initiativeId)/edit">Edit Initiative</a>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="card mb-3">
                <div class="card-header"><strong>Strategy Anchor</strong></div>
                <div class="card-body" id="initiative-detail-anchor"></div>
            </div>
            <div class="card mb-3">
                <div class="card-header"><strong>Ownership &amp; Delivery Window</strong></div>
                <div class="card-body" id="initiative-detail-ownership"></div>
            </div>
            <div class="card mb-3">
                <div class="card-header"><strong>Contribution Plan</strong></div>
                <div class="card-body">
                    <div id="initiative-detail-contribution-summary" class="mb-3"></div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th>Period Start</th>
                                    <th>Period End</th>
                                    <th>Planned</th>
                                    <th>Forecast</th>
                                    <th>Actual</th>
                                    <th>Commentary</th>
                                </tr>
                            </thead>
                            <tbody id="initiative-detail-contribution-plan"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header"><strong>Finance &amp; Governance</strong></div>
                <div class="card-body" id="initiative-detail-governance"></div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card mb-3">
                <div class="card-header"><strong>Readiness</strong></div>
                <div class="card-body" id="initiative-detail-readiness"></div>
            </div>
            <div class="card">
                <div class="card-header"><strong>Deferred Downstream Context</strong></div>
                <div class="card-body" id="initiative-detail-downstream"></div>
            </div>
        </div>
    </div>
</div>

<style>
    .initiative-detail-shell .initiative-detail-header-card {
        border: 1px solid rgba(176, 189, 230, 0.18);
        background: linear-gradient(180deg, rgba(38, 45, 73, .94) 0%, rgba(35, 42, 68, .94) 100%);
    }

    .initiative-detail-shell .initiative-detail-stat {
        border: 1px solid rgba(176, 189, 230, .18);
        border-radius: .75rem;
        background: rgba(19, 27, 47, .55);
        padding: .8rem;
    }

    .initiative-detail-shell .initiative-detail-stat-label {
        font-size: .74rem;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #95a5cb;
        margin-bottom: .3rem;
    }

    .initiative-detail-shell .initiative-detail-stat-value {
        color: #edf2ff;
        font-weight: 700;
    }

    .initiative-detail-shell .initiative-detail-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        border: 1px solid rgba(176, 189, 230, .24);
        background: rgba(176, 189, 230, .08);
        color: #d9e5ff;
        font-size: .76rem;
        font-weight: 600;
        padding: .3rem .65rem;
        margin-right: .4rem;
        margin-bottom: .4rem;
    }
</style>

@section Scripts {
    <script>window.initiativeDetailId = "@initiativeId";</script>
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/initiative-detail.js" asp-append-version="true"></script>
}
