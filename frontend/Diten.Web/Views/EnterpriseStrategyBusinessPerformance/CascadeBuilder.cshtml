@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Cascade Builder";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input id="cascade-goal" class="form-control form-control-sm w-auto" placeholder="Goal ID" />
        <input id="cascade-metric" class="form-control form-control-sm w-auto" placeholder="Goal Metric" />
        <input id="cascade-company" class="form-control form-control-sm w-auto" placeholder="Company (optional)" />
        <button id="cascade-apply" class="btn btn-sm btn-outline-secondary">Load Cascade</button>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/cascade/target-allocation">Target Allocation</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/cascade/consolidation">Consolidation View</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/cascade/variance">Variance Analysis</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Parent Target</div><div class="h5 mb-0" id="cascade-parent-target">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Allocated Total</div><div class="h5 mb-0" id="cascade-allocated-total">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Coverage Complete</div><div class="h5 mb-0" id="cascade-coverage-complete">0</div></div></div>
    <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Coverage Warnings</div><div class="h5 mb-0" id="cascade-coverage-warning">0</div></div></div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div id="cascade-state" class="small text-muted">Loading cascade snapshot...</div>
        <div class="small mt-1"><strong>Goal:</strong> <span id="cascade-goal-name">-</span> | <strong>Metric:</strong> <span id="cascade-goal-metric">-</span></div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Objective</th>
                    <th class="text-end">Contribution Weight</th>
                    <th class="text-end">Allocated Target</th>
                    <th>Coverage</th>
                    <th>Company</th>
                    <th>Warning</th>
                </tr>
            </thead>
            <tbody id="cascade-table"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/cascade-builder.js" asp-append-version="true"></script>
}
