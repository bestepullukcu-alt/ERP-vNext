@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Review Pack";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input id="review-pack-id" class="form-control form-control-sm w-auto" placeholder="Review ID (e.g. rev-2026-q2)" />
        <button id="review-pack-load" class="btn btn-sm btn-outline-secondary">Load Pack</button>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/reviews/calendar">Review Calendar</a>
        <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/reviews/decisions">Decisions & Actions</a>
    </div>
</div>

<div id="review-pack-state" class="small text-muted mb-2">Loading review pack...</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><strong>Review Summary</strong></div>
            <div class="card-body" id="review-pack-summary"></div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><strong>Cascade / Consolidation Highlights</strong></div>
            <div class="card-body" id="review-pack-cascade"></div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><strong>Variance Highlights</strong></div>
            <div class="card-body" id="review-pack-variance"></div>
        </div>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-header"><strong>Decisions Required</strong></div>
            <div class="card-body" id="review-pack-decisions"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/review-pack.js" asp-append-version="true"></script>
}
