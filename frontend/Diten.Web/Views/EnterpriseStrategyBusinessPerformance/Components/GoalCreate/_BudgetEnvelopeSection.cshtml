<details id="goal-sec-budget" class="es-goal-section" open>
  <summary><span>6. Strategic Budget Envelope</span><span id="goal-sec-budget-state" class="es-goal-section-state state-optional">Optional</span></summary>
  <div class="goal-step-helper-banner mb-3 mt-2">
    <span class="badge bg-label-warning">Optional Guardrail</span>
    <span>Use this as top-down strategic budget guidance only. Do not model project or execution cost details here.</span>
  </div>
  <div class="form-check form-switch mb-2">
    <input class="form-check-input" type="checkbox" role="switch" id="goal-budget-enabled" aria-controls="goal-budget-content">
    <label class="form-check-label" for="goal-budget-enabled">Enable Strategic Budget Envelope</label>
  </div>
  <div id="goal-budget-disabled-note" class="small text-muted mb-2">
    Budget envelope is optional. Enable this block when financial planning is needed for the goal.
  </div>
  <input type="hidden" id="goal-yearly-budget-anchor" />
  <div id="goal-budget-content" class="goal-budget-content">
  <div class="goal-budget-tools">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <label for="goal-budget-helper-column" class="form-label small text-muted mb-0">Quick-fill column</label>
      <select id="goal-budget-helper-column" class="form-select form-select-sm">
        <option value="revenueTarget">Revenue Target</option>
        <option value="ebitdaTarget">EBITDA Target</option>
        <option value="capexEnvelope">Capex Envelope</option>
        <option value="opexEnvelope">Opex Envelope</option>
        <option value="savingsTarget">Savings Target</option>
        <option value="fundingPoolEnvelope">Funding Pool</option>
      </select>
    </div>
    <div class="goal-budget-actions">
      <button type="button" class="btn btn-sm btn-outline-secondary" id="goal-budget-fill-column">Fill flat</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="goal-budget-interpolate">Interpolate</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="goal-budget-copy-down">Copy down</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="goal-budget-clear-column">Clear</button>
    </div>
  </div>
  <div class="table-responsive goal-budget-wrap">
    <table class="table table-sm table-bordered metric-year-table goal-budget-year-table mb-0" id="goal-budget-year-table">
      <thead>
      <tr>
        <th>Year</th>
        <th>Revenue Target</th>
        <th>EBITDA Target</th>
        <th>Capex Envelope</th>
        <th>Opex Envelope</th>
        <th>Savings Target</th>
        <th>Funding Pool</th>
        <th>Commentary</th>
      </tr>
      </thead>
      <tbody id="goal-budget-year-rows"></tbody>
    </table>
  </div>
  </div>
</details>
