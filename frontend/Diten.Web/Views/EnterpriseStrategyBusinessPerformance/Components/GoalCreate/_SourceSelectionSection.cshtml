<div id="goal-creation-mode" class="goal-source-panel">
  <div class="goal-source-controls">
    <div class="goal-source-control">
      <label class="form-label small mb-1" for="goal-creation-mode-select">Creation mode</label>
      <select id="goal-creation-mode-select" class="form-select form-select-sm">
        <option value="Blank">Blank</option>
        <option value="Template">From Goal Template</option>
      </select>
    </div>
    <div class="goal-source-control">
      <button type="button" id="goal-browse-source" class="btn btn-sm btn-outline-primary w-100">Browse catalog...</button>
    </div>
    <div class="goal-source-control">
      <button type="button" id="goal-clear-source" class="btn btn-sm btn-outline-secondary w-100">Clear selected source</button>
    </div>
  </div>
  <div id="goal-source-summary" class="goal-source-summary-card is-empty">
    <div class="goal-source-summary-name">Blank Goal create</div>
    <div class="goal-source-summary-note">Start directly in the governed wizard, or choose a Goal Template to prefill the draft.</div>
  </div>
</div>
