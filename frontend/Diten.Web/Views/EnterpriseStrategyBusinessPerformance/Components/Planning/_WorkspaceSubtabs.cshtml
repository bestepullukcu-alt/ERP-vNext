@{
    var active = (ViewData["Active"]?.ToString() ?? "cycles").Trim().ToLowerInvariant();
    var hideCardWrapper = (ViewData["HideCardWrapper"] as bool?) ?? false;
}

@if (hideCardWrapper)
{
    <div class="px-4 pt-3">
        <ul class="nav nav-pills esbp-planning-subtabs mb-3">
            <li class="nav-item">
                <a class="nav-link @(active == "cycles" ? "active" : "")" href="/management-governance/enterprise-strategy-business-performance/planning/cycles">Planning Cycles</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(active == "periods" ? "active" : "")" href="/management-governance/enterprise-strategy-business-performance/planning/strategy-periods">Strategy Periods</a>
            </li>
        </ul>
    </div>
}
else
{
    <div class="card esbp-toolbar-card es-planning-subtabs-card">
        <div class="card-body py-3">
            <ul class="nav nav-pills esbp-planning-subtabs mb-0">
                <li class="nav-item">
                    <a class="nav-link @(active == "cycles" ? "active" : "")" href="/management-governance/enterprise-strategy-business-performance/planning/cycles">Planning Cycles</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(active == "periods" ? "active" : "")" href="/management-governance/enterprise-strategy-business-performance/planning/strategy-periods">Strategy Periods</a>
                </li>
            </ul>
        </div>
    </div>
}
