<div class="row g-4 mb-4">
    <div class="col-lg-3 col-sm-6">
        <div class="card card-border-shadow-primary h-100 cursor-pointer planning-filter-card" data-filter-status="all">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="avatar me-4">
                        <span class="avatar-initial rounded bg-label-primary"><i class="icon-base bx bx-calendar icon-lg"></i></span>
                    </div>
                    <h4 class="mb-0 planning-stat-value" id="planning-cycle-total">0</h4>
                </div>
                <p class="mb-2">Total Planning Cycles</p>
                <p class="mb-0">
                    <span class="text-body-secondary">All cycles</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card card-border-shadow-success h-100 cursor-pointer planning-filter-card" data-filter-status="Active">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="avatar me-4">
                        <span class="avatar-initial rounded bg-label-success"><i class="icon-base bx bx-check-circle icon-lg"></i></span>
                    </div>
                    <h4 class="mb-0 planning-stat-value" id="planning-cycle-active">0</h4>
                </div>
                <p class="mb-2">Active Planning Cycles</p>
                <p class="mb-0">
                    <span class="text-body-secondary">Currently active</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card card-border-shadow-warning h-100 cursor-pointer planning-filter-card" data-filter-status="Draft">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="avatar me-4">
                        <span class="avatar-initial rounded bg-label-warning"><i class="icon-base bx bx-edit icon-lg"></i></span>
                    </div>
                    <h4 class="mb-0 planning-stat-value" id="planning-cycle-draft">0</h4>
                </div>
                <p class="mb-2">Draft Planning Cycles</p>
                <p class="mb-0">
                    <span class="text-body-secondary">In preparation</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card card-border-shadow-secondary h-100 cursor-pointer planning-filter-card" data-filter-status="Archived">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="avatar me-4">
                        <span class="avatar-initial rounded bg-label-secondary"><i class="icon-base bx bx-archive icon-lg"></i></span>
                    </div>
                    <h4 class="mb-0 planning-stat-value" id="planning-cycle-archived">0</h4>
                </div>
                <p class="mb-2">Archived Planning Cycles</p>
                <p class="mb-0">
                    <span class="text-body-secondary">Past cycles</span>
                </p>
            </div>
        </div>
    </div>
</div>
