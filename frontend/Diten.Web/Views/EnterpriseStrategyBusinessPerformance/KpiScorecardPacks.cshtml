@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Scorecard Packs";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex gap-2 align-items-center">
        <input id="kpi-pack-search" class="form-control form-control-sm w-auto" placeholder="Search packs" />
        <button id="kpi-pack-apply" class="btn btn-sm btn-outline-secondary">Apply</button>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm mb-0" id="kpi-pack-table">
            <thead>
                <tr>
                    <th>Pack Code</th>
                    <th>Pack Name</th>
                    <th>Pack Level</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Version</th>
                    <th>Publish Date</th>
                    <th>Default Owner Role</th>
                    <th>KPI Count</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/kpi-scorecard-packs.js" asp-append-version="true"></script>
}
