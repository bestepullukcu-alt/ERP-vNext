@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "KPI Template Detail";
    var templateId = ViewData["KpiTemplateId"]?.ToString() ?? string.Empty;
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-1" id="kpi-template-name">Template</h5>
            <div class="text-muted small">Template Id: <span id="kpi-template-id">@templateId</span></div>
        </div>
        <div class="d-flex gap-2">
            <button id="kpi-template-instantiate" class="btn btn-sm btn-primary">Instantiate to KPI Catalog</button>
            <a class="btn btn-sm btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/kpis/library">Back to Catalog</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0" id="kpi-template-fields"></dl>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/kpi-template-detail.js" asp-append-version="true"></script>
}
