@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Strategy Period Detail";
    ViewData["Active"] = "periods";
    var periodId = (ViewData["StrategyPeriodId"]?.ToString() ?? string.Empty);
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="planning-workspace strategy-period-detail-page es-planning-page-shell row g-3">
    <div class="col-12">
        <div class="card mb-6">
            <div class="card-widget-separator-wrapper">
                <div class="card-body card-widget-separator">
                    <div class="row gy-4 gy-sm-1">
                        <div class="col-sm-6 col-lg-3">
                            <div class="d-flex justify-content-between align-items-center card-widget-1 border-end pb-4 pb-sm-0">
                                <div>
                                    <h4 class="mb-0" id="pc-widget-goals">0</h4>
                                    <p class="mb-0">Goals</p>
                                </div>
                                <div class="avatar me-sm-6">
                                    <span class="avatar-initial rounded bg-label-secondary text-heading">
                                        <i class="icon-base bx bx-target-lock icon-26px"></i>
                                    </span>
                                </div>
                            </div>
                            <hr class="d-none d-sm-block d-lg-none me-6">
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="d-flex justify-content-between align-items-center card-widget-2 border-end pb-4 pb-sm-0">
                                <div>
                                    <h4 class="mb-0" id="pc-widget-objectives">0</h4>
                                    <p class="mb-0">Objectives</p>
                                </div>
                                <div class="avatar me-sm-6">
                                    <span class="avatar-initial rounded bg-label-secondary text-heading">
                                        <i class="icon-base bx bx-bullseye icon-26px"></i>
                                    </span>
                                </div>
                            </div>
                            <hr class="d-none d-sm-block d-lg-none me-6">
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="d-flex justify-content-between align-items-center card-widget-3 border-end pb-4 pb-sm-0">
                                <div>
                                    <h4 class="mb-0" id="pc-widget-initiatives">0</h4>
                                    <p class="mb-0">Initiatives</p>
                                </div>
                                <div class="avatar me-sm-6">
                                    <span class="avatar-initial rounded bg-label-secondary text-heading">
                                        <i class="icon-base bx bx-rocket icon-26px"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="d-flex justify-content-between align-items-center card-widget-4 pb-4 pb-sm-0">
                                <div>
                                    <h4 class="mb-0" id="pc-widget-metrics">0</h4>
                                    <p class="mb-0">Performance Metrics</p>
                                </div>
                                <div class="avatar">
                                    <span class="avatar-initial rounded bg-label-secondary text-heading">
                                        <i class="icon-base bx bx-line-chart icon-26px"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="card es-detail-main-card mb-6">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-start gap-4 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar avatar-md">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="icon-base bx bx-calendar icon-28px"></i>
                        </span>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h4 class="es-detail-title mb-0 text-heading">Strategy Period</h4>
                            <span id="strategy-period-status-badge" class="es-status-pill is-info">Loading...</span>
                        </div>
                        <p class="mb-0 small text-muted">Governed master-data detail for scope, cadence, and downstream assignment readiness.</p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="/management-governance/enterprise-strategy-business-performance/planning/strategy-periods" class="btn btn-label-secondary btn-sm">
                        <i class="bx bx-left-arrow-alt me-1"></i> Back
                    </a>
                    <div class="btn-group es-action-cluster">
                        <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bx bx-cog me-1"></i> Actions
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" id="strategy-period-detail-edit" href="javascript:void(0);"><i class="bx bx-edit me-2"></i> Edit Period</a></li>
                            <li><a class="dropdown-item" id="strategy-period-detail-activate" href="javascript:void(0);"><i class="bx bx-check-circle me-2"></i> Activate</a></li>
                            <li id="strategy-period-detail-divider"><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" id="strategy-period-detail-archive" href="javascript:void(0);"><i class="bx bx-archive-in me-2"></i> Archive / Delete</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div id="strategy-period-detail-metadata" class="text-muted small">
                <!-- Data injected via strategy-period-detail.js -->
                <div class="p-4 text-center">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2">Loading core metadata...</span>
                </div>
            </div>
        </div>

    </div>

    <div class="col-12 col-xl-4 d-flex">
        @await Html.PartialAsync(
            "Components/Planning/_GovernancePanel",
            viewData: new ViewDataDictionary(ViewData) { ["IsSoon"] = true })
    </div>
</div>

@await Html.PartialAsync("Components/Planning/_StrategyPeriodOffcanvas")

@section Scripts {
    <script>window.strategyPeriodDetailId = "@periodId";</script>
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/strategy-initiatives-api.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/strategy-period-detail.js" asp-append-version="true"></script>
}
