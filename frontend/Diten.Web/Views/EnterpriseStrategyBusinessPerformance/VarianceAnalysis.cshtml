@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Variance Analysis";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input id="variance-goal" class="form-control form-control-sm w-auto" placeholder="Goal" />
        <input id="variance-objective" class="form-control form-control-sm w-auto" placeholder="Objective" />
        <input id="variance-company" class="form-control form-control-sm w-auto" placeholder="Company" />
        <input id="variance-period" class="form-control form-control-sm w-auto" placeholder="Time Period" />
        <input id="variance-kpi" class="form-control form-control-sm w-auto" placeholder="KPI / Metric" />
        <button id="variance-apply" class="btn btn-sm btn-outline-secondary">Apply</button>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Goal</th>
                    <th>Objective</th>
                    <th>KPI</th>
                    <th>Company</th>
                    <th>Period</th>
                    <th class="text-end">Target</th>
                    <th class="text-end">Current</th>
                    <th class="text-end">Variance</th>
                    <th class="text-end">Variance %</th>
                    <th>Trend</th>
                    <th>Status</th>
                    <th class="text-end es-row-actions-col">Actions</th>
                </tr>
            </thead>
            <tbody id="variance-table"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/row-actions-menu.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/variance-analysis.js" asp-append-version="true"></script>
}
