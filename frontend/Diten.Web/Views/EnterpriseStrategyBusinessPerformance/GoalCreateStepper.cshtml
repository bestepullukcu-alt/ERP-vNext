@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Create Goal Wizard";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div id="goal-create-stepper-page" class="goal-create-stepper-page">
    <div id="wizard-goal-create-stepper" class="bs-stepper vertical mt-2 linear">
                <div class="bs-stepper-header border-end">
                    <div class="step active" data-target="#goal-step-identity">
                        <button type="button" class="step-trigger" aria-selected="true">
                            <span class="bs-stepper-circle"><i class="icon-base bx bx-bullseye icon-md"></i></span>
                            <span class="bs-stepper-label">
                                <span class="bs-stepper-title">Goal Identity</span>
                                <span class="bs-stepper-subtitle">Title / Statement</span>
                            </span>
                        </button>
                    </div>
                    <div class="line"></div>
                    <div class="step" data-target="#goal-step-ownership">
                        <button type="button" class="step-trigger" aria-selected="false" disabled="disabled">
                            <span class="bs-stepper-circle"><i class="icon-base bx bx-briefcase-alt icon-md"></i></span>
                            <span class="bs-stepper-label">
                                <span class="bs-stepper-title">Ownership &amp; Accountability</span>
                                <span class="bs-stepper-subtitle">Company / Position</span>
                            </span>
                        </button>
                    </div>
                    <div class="line"></div>
                    <div class="step" data-target="#goal-step-strategy">
                        <button type="button" class="step-trigger" aria-selected="false" disabled="disabled">
                            <span class="bs-stepper-circle"><i class="icon-base bx bx-calendar icon-md"></i></span>
                            <span class="bs-stepper-label">
                                <span class="bs-stepper-title">Planning &amp; Horizon</span>
                                <span class="bs-stepper-subtitle">Period / Dates</span>
                            </span>
                        </button>
                    </div>
                    <div class="line"></div>
                    <div class="step" data-target="#goal-step-kpi">
                        <button type="button" class="step-trigger" aria-selected="false" disabled="disabled">
                            <span class="bs-stepper-circle"><i class="icon-base bx bx-buildings icon-md"></i></span>
                            <span class="bs-stepper-label">
                                <span class="bs-stepper-title">Company Applicability</span>
                                <span class="bs-stepper-subtitle">Scope / Companies</span>
                            </span>
                        </button>
                    </div>
                    <div class="line"></div>
                    <div class="step" data-target="#goal-step-scope">
                        <button type="button" class="step-trigger" aria-selected="false" disabled="disabled">
                            <span class="bs-stepper-circle"><i class="icon-base bx bx-line-chart icon-md"></i></span>
                            <span class="bs-stepper-label">
                                <span class="bs-stepper-title">Strategic KPI &amp; Yearly Targets</span>
                                <span class="bs-stepper-subtitle">Metrics / Targets</span>
                            </span>
                        </button>
                    </div>
                    <div class="line"></div>
                    <div class="step" data-target="#goal-step-budget">
                        <button type="button" class="step-trigger" aria-selected="false" disabled="disabled">
                            <span class="bs-stepper-circle"><i class="icon-base bx bx-shield-quarter icon-md"></i></span>
                            <span class="bs-stepper-label">
                                <span class="bs-stepper-title">Strategic Budget Envelope</span>
                                <span class="bs-stepper-subtitle">Yearly Budget Plan</span>
                            </span>
                        </button>
                    </div>
                    <div class="line"></div>
                    <div class="step" data-target="#goal-step-governance">
                        <button type="button" class="step-trigger" aria-selected="false" disabled="disabled">
                            <span class="bs-stepper-circle"><i class="icon-base bx bx-git-branch icon-md"></i></span>
                            <span class="bs-stepper-label">
                                <span class="bs-stepper-title">Governance &amp; Traceability</span>
                                <span class="bs-stepper-subtitle">Decision / Evidence</span>
                            </span>
                        </button>
                    </div>
                </div>

                <div class="bs-stepper-content">
                    <form id="wizard-goal-create-stepper-form" onsubmit="return false">
                        <div id="goal-stepper-validation-alert-host" class="mb-4 d-none"></div>
                        <div id="goal-step-identity" class="content active dstepper-block">
                            <div class="row g-4">
                                <div class="col-md-8">
                                    <label class="form-label" for="goalCreationMode">Creation Mode</label>
                                    <select id="goalCreationMode" class="form-select">
                                        <option value="blank" selected>Blank Goal</option>
                                        <option value="template">From Goal Template</option>
                                    </select>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button type="button" id="goalBrowseCatalog" class="btn btn-outline-primary w-100">Browse Catalog</button>
                                </div>
                                <div class="col-12 d-none" id="goal-template-summary-card-wrap">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="card h-100 border-primary border-opacity-25 shadow-sm">
                                                <div class="position-relative rounded-top-3 bg-label-primary d-flex align-items-center justify-content-center" style="min-height:88px;">
                                                    <i class="icon-base bx bx-book-content text-primary" style="font-size:1.9rem;"></i>
                                                    <button type="button"
                                                            id="goal-template-summary-clear"
                                                            class="btn btn-icon btn-text-secondary rounded-pill position-absolute top-0 end-0 mt-2 me-2"
                                                            aria-label="Remove template">
                                                        <i class="icon-base bx bx-x icon-md"></i>
                                                    </button>
                                                </div>
                                                <div class="card-body py-3">
                                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                                        <span class="badge bg-label-primary">Goal Template</span>
                                                        <span class="badge bg-label-secondary" id="goal-template-summary-version">Version -</span>
                                                    </div>
                                                    <div class="badge bg-label-secondary mb-2" id="goal-template-summary-category">-</div>
                                                    <h6 class="card-title mb-1" id="goal-template-summary-title">Template title</h6>
                                                    <p class="card-text mb-1 text-body" id="goal-template-summary-name">Template name</p>
                                                    <div class="small text-muted mb-1" id="goal-template-summary-id">Template ID: -</div>
                                                    <p class="card-text small text-muted mb-0" id="goal-template-summary-note">Values prefilled from the selected Goal Template; adjust before save.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="goal-id">Goal ID</label>
                                    <input id="goal-id" class="form-control" readonly disabled autocomplete="off" placeholder="Assigned on save">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-name">Goal Title</label>
                                    <input id="goal-name" class="form-control" maxlength="200" placeholder="Increase operating resilience">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="goal-priority">Priority</label>
                                    <select id="goal-priority" class="form-select">
                                        <option value="">Select...</option>
                                        <option>Critical</option>
                                        <option>High</option>
                                        <option selected>Medium</option>
                                        <option>Low</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="goalLifecycle">Status / Lifecycle State</label>
                                    <select id="goalLifecycle" class="form-select" disabled>
                                        <option value="Draft" selected>Draft</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="goal-category">Goal Type</label>
                                    <select id="goal-category" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="goal-strategic-theme">Strategic Theme / Pillar</label>
                                    <select id="goal-strategic-theme" class="form-select">
                                        <option value="">Select strategic theme...</option>
                                        <option>Operational Excellence</option>
                                        <option>Financial Discipline</option>
                                        <option>Digital Acceleration</option>
                                        <option>Sustainability</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="goal-statement">Goal Statement</label>
                                    <textarea id="goal-statement" class="form-control" rows="6" maxlength="4000" placeholder="Describe the intended strategic outcome the goal should deliver, not the execution plan used to achieve it."></textarea>
                                    <div class="form-text">Describe the intended strategic outcome the goal should deliver, not the execution plan used to achieve it.</div>
                                </div>
                                <div class="col-12 d-flex justify-content-between">
                                    <button class="btn btn-label-secondary btn-prev" disabled><i class="icon-base bx bx-left-arrow-alt scaleX-n1-rtl icon-sm me-sm-2 me-0"></i><span class="align-middle d-sm-inline-block d-none">Previous</span></button>
                                    <button class="btn btn-primary btn-next"><span class="align-middle d-sm-inline-block d-none me-sm-2">Next</span><i class="icon-base bx bx-right-arrow-alt icon-sm scaleX-n1-rtl"></i></button>
                                </div>
                            </div>
                        </div>

                        <div id="goal-step-ownership" class="content">
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <label class="form-label" for="goal-owner-company">
                                        Owner Company / Org
                                        <i class="icon-base bx bx-info-circle text-muted ms-1"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="Selecting the owner company or org filters the valid accountable positions."></i>
                                    </label>
                                    <select id="goal-owner-company" class="form-select">
                                        <option value="">Select owner company / org...</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="goal-owner-role">Owner Position</label>
                                    <select id="goal-owner-role" class="form-select">
                                        <option value="">Select position...</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="goal-owner-person">
                                        Current Owner Person
                                        <i class="icon-base bx bx-info-circle text-muted ms-1"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="Current Owner Person resolves automatically from the active incumbent when one exists."></i>
                                    </label>
                                    <select id="goal-owner-person" class="form-select">
                                        <option value="">Select current owner person...</option>
                                    </select>
                                    <div id="goal-owner-person-hint" class="form-text">Current Owner Person resolves automatically from the active incumbent when one exists.</div>
                                </div>
                                <div class="col-12">
                                    <hr class="my-0">
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="goal-owner-accountable-display">Accountable Ownership Summary</label>
                                    <textarea id="goal-owner-accountable-display" class="form-control" rows="3" readonly>-</textarea>
                                    <div class="form-text">Displays Company / Org -> Position -> Current Owner Person.</div>
                                </div>
                                <input id="goal-owner" type="hidden" value="">
                                <div class="col-12 d-flex justify-content-between">
                                    <button class="btn btn-label-secondary btn-prev"><i class="icon-base bx bx-left-arrow-alt scaleX-n1-rtl icon-sm me-sm-2 me-0"></i><span class="align-middle d-sm-inline-block d-none">Previous</span></button>
                                    <button class="btn btn-primary btn-next"><span class="align-middle d-sm-inline-block d-none me-sm-2">Next</span><i class="icon-base bx bx-right-arrow-alt scaleX-n1-rtl icon-sm"></i></button>
                                </div>
                            </div>
                        </div>

                        <div id="goal-step-strategy" class="content">
                            <div class="row g-4">
                                <div class="col-12">
                                    <label class="form-label" for="goal-strategy-period">
                                        Strategy Period
                                        <i class="icon-base bx bx-info-circle text-muted ms-1"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="Select an Active Strategy Period to set Goal planning dates. Draft and Archived periods are shown for reference only."></i>
                                    </label>
                                    <select id="goal-strategy-period" class="form-select" data-placeholder="Select strategy period (Active only)">
                                        <option value="">Select strategy period (Active only)...</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-planning-start-year">Start Date</label>
                                    <input id="goal-planning-start-year" type="date" class="form-control">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-planning-end-year">End Date</label>
                                    <input id="goal-planning-end-year" type="date" class="form-control">
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="goal-planning-scope-preview">Related Entity Scope Summary</label>
                                    <input id="goal-planning-scope-preview" class="form-control" readonly value="Company applicability will define the strategic scope summary.">
                                    <div class="form-text">Applicability selections in the next step will update this governance preview automatically.</div>
                                </div>
                                <div class="col-12 d-flex justify-content-between">
                                    <button class="btn btn-label-secondary btn-prev"><i class="icon-base bx bx-left-arrow-alt scaleX-n1-rtl icon-sm me-sm-2 me-0"></i><span class="align-middle d-sm-inline-block d-none">Previous</span></button>
                                    <button class="btn btn-primary btn-next"><span class="align-middle d-sm-inline-block d-none me-sm-2">Next</span><i class="icon-base bx bx-right-arrow-alt scaleX-n1-rtl icon-sm"></i></button>
                                </div>
                            </div>
                        </div>

                        <div id="goal-step-kpi" class="content">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-scope-mode">
                                        Applicability Mode
                                        <i class="icon-base bx bx-info-circle text-muted ms-1"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="Enterprise or selected-company applicability only."></i>
                                    </label>
                                    <select id="goal-scope-mode" class="form-select">
                                        <option value="">Select...</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-none">
                                    <label class="form-label" for="goal-primary-company">Primary Company</label>
                                    <select id="goal-primary-company" class="form-select">
                                        <option value="">Select company...</option>
                                    </select>
                                    <div id="goal-primary-company-hint" class="form-text">Primary Company is not a controlling field at Goal level.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-applies-to-all-companies">
                                        Applies to all companies?
                                        <i class="icon-base bx bx-info-circle text-muted ms-1"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="Derived from Applicability Mode to avoid duplicating scope logic."></i>
                                    </label>
                                    <div class="form-check mt-2">
                                        <input id="goal-applies-to-all-companies" class="form-check-input" type="checkbox" disabled>
                                        <label class="form-check-label" for="goal-applies-to-all-companies">Enterprise-wide applicability</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="goal-applicable-companies">
                                        Applicable Companies
                                        <i class="icon-base bx bx-info-circle text-muted ms-1"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="All companies are selected automatically for Enterprise applicability."></i>
                                    </label>
                                    <select id="goal-applicable-companies" class="form-select select2" multiple data-placeholder="Search and select applicable companies..."></select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-business-unit">Business Unit / Function</label>
                                    <input id="goal-business-unit" class="form-control" maxlength="200" placeholder="Optional business unit or function scope">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-region">Region / Geography</label>
                                    <input id="goal-region" class="form-control" maxlength="200" placeholder="Optional regional or geographic scope">
                                </div>
                                <div class="col-12">
                                    <input id="goal-entity-scope" type="hidden">
                                    <label class="form-label" for="goal-related-entity-scope-summary">Related Entity Scope Summary</label>
                                    <input id="goal-related-entity-scope-summary" type="hidden">
                                    <div class="card shadow-none bg-label-secondary">
                                        <div class="card-body">
                                            <p id="goal-related-entity-scope-summary-display" class="card-text mb-0">Derived from applicability selections, business unit or function, region, and strategic scope metadata.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 d-flex justify-content-between">
                                    <button class="btn btn-label-secondary btn-prev"><i class="icon-base bx bx-left-arrow-alt scaleX-n1-rtl icon-sm me-sm-2 me-0"></i><span class="align-middle d-sm-inline-block d-none">Previous</span></button>
                                    <button class="btn btn-primary btn-next"><span class="align-middle d-sm-inline-block d-none me-sm-2">Next</span><i class="icon-base bx bx-right-arrow-alt icon-sm scaleX-n1-rtl"></i></button>
                                </div>
                            </div>
                        </div>

                        <div id="goal-step-scope" class="content">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="card-datatable table-responsive">
                                        <table id="goal-kpi-table" class="goal-kpi-table table border-top">
                                            <thead>
                                                <tr>
                                                    <th></th>
                                                    <th>Goal Metric Type</th>
                                                    <th>Metric</th>
                                                    <th>Unit of Measure</th>
                                                    <th>Year</th>
                                                    <th>Planning Horizon</th>
                                                    <th class="cell-fit">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-12 d-flex justify-content-between">
                                    <button class="btn btn-label-secondary btn-prev"><i class="icon-base bx bx-left-arrow-alt scaleX-n1-rtl icon-sm me-sm-2 me-0"></i><span class="align-middle d-sm-inline-block d-none">Previous</span></button>
                                    <button class="btn btn-primary btn-next"><span class="align-middle d-sm-inline-block d-none me-sm-2">Next</span><i class="icon-base bx bx-right-arrow-alt icon-sm scaleX-n1-rtl"></i></button>
                                </div>
                            </div>
                        </div>

                        <div id="goal-step-budget" class="content">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="goal-step-helper-banner mb-3">
                                        <span class="badge bg-label-warning">Optional Guardrail</span>
                                        <span>Use this as top-down strategic budget guidance only. Do not model project or execution cost details here.</span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" id="goal-budget-enabled" aria-controls="goal-budget-content">
                                        <label class="form-check-label" for="goal-budget-enabled">Enable Strategic Budget Envelope</label>
                                    </div>
                                    <div id="goal-budget-disabled-note" class="small text-muted mb-2">
                                        Budget envelope is optional. Enable this block when financial planning is needed for the goal.
                                    </div>
                                    <input type="hidden" id="goal-yearly-budget-anchor" />
                                </div>
                                <div class="col-12">
                                    <div id="goal-budget-content" class="goal-budget-content">
                                        <div class="goal-budget-tools d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <label for="goal-budget-helper-column" class="form-label small text-muted mb-0">Quick-fill column</label>
                                                <select id="goal-budget-helper-column" class="form-select form-select-sm">
                                                    <option value="revenueTarget">Revenue Target</option>
                                                    <option value="ebitdaTarget">EBITDA Target</option>
                                                    <option value="capexEnvelope">Capex Envelope</option>
                                                    <option value="opexEnvelope">Opex Envelope</option>
                                                    <option value="savingsTarget">Savings Target</option>
                                                    <option value="fundingPoolEnvelope">Funding Pool</option>
                                                </select>
                                            </div>
                                            <div class="goal-budget-actions d-flex gap-2 flex-wrap">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" id="goal-budget-fill-column">Fill flat</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" id="goal-budget-interpolate">Interpolate</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" id="goal-budget-copy-down">Copy down</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" id="goal-budget-clear-column">Clear</button>
                                            </div>
                                        </div>
                                        <div class="table-responsive goal-budget-wrap">
                                            <table class="table table-sm table-bordered metric-year-table goal-budget-year-table mb-0" id="goal-budget-year-table">
                                                <thead>
                                                    <tr>
                                                        <th>Year</th>
                                                        <th>Revenue Target</th>
                                                        <th>EBITDA Target</th>
                                                        <th>Capex Envelope</th>
                                                        <th>Opex Envelope</th>
                                                        <th>Savings Target</th>
                                                        <th>Funding Pool</th>
                                                        <th>Commentary</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="goal-budget-year-rows"></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 d-flex justify-content-between">
                                    <button class="btn btn-label-secondary btn-prev"><i class="icon-base bx bx-left-arrow-alt scaleX-n1-rtl icon-sm me-sm-2 me-0"></i><span class="align-middle d-sm-inline-block d-none">Previous</span></button>
                                    <button class="btn btn-primary btn-next"><span class="align-middle d-sm-inline-block d-none me-sm-2">Next</span><i class="icon-base bx bx-right-arrow-alt icon-sm scaleX-n1-rtl"></i></button>
                                </div>
                            </div>
                        </div>

                        <div id="goal-step-governance" class="content">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="goal-step-helper-banner mb-3">
                                        <span class="badge bg-label-info">Governance Ready</span>
                                        <span>Capture the decision reference, evidence link, and traceability markers needed to keep the draft audit-ready from the start.</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-change-log-ref">Change Log Ref <span class="es-field-tag tag-required">Required for publish</span></label>
                                    <input id="goal-change-log-ref" class="form-control" maxlength="100" placeholder="Change log reference">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-decision-reference">Decision Reference <span class="es-field-tag tag-required">Required for publish</span></label>
                                    <input id="goal-decision-reference" class="form-control" maxlength="200" placeholder="Decision reference">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-evidence-reference">Evidence Link</label>
                                    <input id="goal-evidence-reference" class="form-control" placeholder="https://">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="goal-version">Version <span class="es-field-tag tag-system">System-managed</span></label>
                                    <input id="goal-version" class="form-control bg-light" readonly disabled tabindex="-1" title="Version is assigned by the system" value="0">
                                </div>
                                <div class="col-12 d-flex justify-content-between">
