@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Planning Cycle & Strategy Period";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div class="row g-3">
    <div class="col-12">
        <div class="card mb-3 esbp-toolbar-card">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <label for="planning-cycle-filter" class="form-label mb-0">Planning Cycle</label>
                    <select id="planning-cycle-filter" class="form-select form-select-sm" style="min-width:260px;">
                        <option value="">All cycles</option>
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <button id="planning-create-cycle" class="btn btn-primary btn-sm esbp-create-btn" type="button">Create Cycle</button>
                    <button id="planning-create-period" class="btn btn-outline-primary btn-sm" type="button">Create Strategy Period</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <div class="card esbp-table-card h-100">
            <div class="card-header"><strong>Planning Cycles</strong></div>
            <div class="table-responsive">
                <table class="table mb-0" id="planning-cycles-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th>Effective</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-7">
        <div class="card esbp-table-card h-100">
            <div class="card-header"><strong>Strategy Periods</strong></div>
            <div class="table-responsive">
                <table class="table mb-0" id="strategy-periods-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Cycle</th>
                            <th>Scope</th>
                            <th>Review</th>
                            <th>Status</th>
                            <th>Default</th>
                            <th>Window</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade es-modal" id="planningCycleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Planning Cycle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-12 col-md-6"><label class="form-label">Code</label><input id="planning-cycle-code" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">Name</label><input id="planning-cycle-name" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">Type</label><select id="planning-cycle-type" class="form-select"><option value="">Select</option></select></div>
                    <div class="col-12 col-md-6"><label class="form-label">Status</label><select id="planning-cycle-status" class="form-select"><option value="">Select</option></select></div>
                    <div class="col-12"><label class="form-label">Owner Id</label><input id="planning-cycle-owner" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">Effective From</label><input id="planning-cycle-effective-from" type="date" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">Effective To</label><input id="planning-cycle-effective-to" type="date" class="form-control" /></div>
                    <div class="col-12"><label class="form-label">Description</label><textarea id="planning-cycle-description" class="form-control" rows="2"></textarea></div>
                </div>
            </div>
            <div class="modal-footer sticky-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="planning-cycle-save" class="btn btn-primary">Create</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade es-modal" id="strategyPeriodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Strategy Period</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-12 col-md-6"><label class="form-label">Code</label><input id="strategy-period-code" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">Name</label><input id="strategy-period-name" class="form-control" /></div>
                    <div class="col-12"><label class="form-label">Planning Cycle</label><select id="strategy-period-cycle" class="form-select"><option value="">Select</option></select></div>
                    <div class="col-12 col-md-6"><label class="form-label">Company Id</label><input id="strategy-period-company" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">Business Unit Id</label><input id="strategy-period-bu" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">Region Id</label><input id="strategy-period-region" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">Review Cadence</label><select id="strategy-period-review" class="form-select"><option value="">Select</option></select></div>
                    <div class="col-12 col-md-6"><label class="form-label">Start Date</label><input id="strategy-period-start" type="date" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">End Date</label><input id="strategy-period-end" type="date" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label class="form-label">Status</label><select id="strategy-period-status" class="form-select"><option value="">Select</option></select></div>
                    <div class="col-12 col-md-6"><label class="form-label">Scenario Type</label><select id="strategy-period-scenario" class="form-select"><option value="">None</option></select></div>
                    <div class="col-12 col-md-6"><label class="form-label">Version Label</label><input id="strategy-period-version" class="form-control" /></div>
                    <div class="col-12 col-md-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="strategy-period-default" />
                            <label class="form-check-label" for="strategy-period-default">Default For Scope</label>
                        </div>
                    </div>
                    <div class="col-12"><label class="form-label">Notes</label><textarea id="strategy-period-notes" class="form-control" rows="2"></textarea></div>
                </div>
            </div>
            <div class="modal-footer sticky-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="strategy-period-save" class="btn btn-primary">Create</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/enterprise-strategy/strategy-apis.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/enterprise-strategy/planning.js" asp-append-version="true"></script>
}
