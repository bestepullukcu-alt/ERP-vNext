@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Create Objective";
}
@await Html.PartialAsync("Components/_SubdomainShell", Model)

<div id="objective-create-workspace" class="goal-create-workspace">
    <div class="goal-workspace-shell objective-workspace-shell">
        <div class="goal-workspace-header sticky-top">
            <div class="goal-workspace-title-wrap">
                <h5 class="goal-workspace-title mb-0" id="objective-modal-title">Create Objective</h5>
                <p class="goal-workspace-subtitle mb-0" id="objective-modal-subtitle">Create a draft strategic objective linked to a parent goal and measurable outcome.</p>
            </div>
            <div class="goal-workspace-actions">
                <a href="/management-governance/enterprise-strategy-business-performance/objectives" class="btn btn-sm btn-outline-secondary">Cancel / Back</a>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="objective-step-back">Back</button>
                <button type="button" class="btn btn-sm btn-outline-primary" id="objective-step-next">Next</button>
                <button type="button" class="btn btn-sm btn-primary d-none" id="objective-save">Create Objective</button>
            </div>
        </div>

        <div class="goal-workspace-body">
            @{
                ViewData["Id"] = "objective-form-error";
            }
            @await Html.PartialAsync("Components/Forms/_ValidationSummary")

            <div id="objective-wizard-steps" class="objective-wizard-nav mb-3" role="tablist" aria-label="Create Objective Steps">
                <button type="button" class="btn objective-wizard-step-btn active" data-step="1" role="tab" aria-selected="true">1. Identity &amp; Strategy Anchor</button>
                <button type="button" class="btn objective-wizard-step-btn" data-step="2" role="tab" aria-selected="false">2. Ownership</button>
                <button type="button" class="btn objective-wizard-step-btn" data-step="3" role="tab" aria-selected="false">3. Planning &amp; Scope</button>
                <button type="button" class="btn objective-wizard-step-btn" data-step="4" role="tab" aria-selected="false">4. Performance</button>
            </div>

            <section class="es-goal-section objective-wizard-step-pane" data-step="1">
                @{
                    ViewData["Title"] = "Identity & Strategy Anchor";
                    ViewData["Subtitle"] = "Define the strategic identity and lock the Objective to a Parent Goal before planning work begins.";
                }
                @await Html.PartialAsync("Components/Forms/_SectionHeader")
                <div class="objective-helper-banner mb-3">
                    <span class="badge bg-label-info">Anchor Rule</span>
                    <span>Objective must be linked to a Parent Goal before planning begins. Strategy context is inherited from that Goal, and compatible templates load only after the anchor is chosen.</span>
                </div>
                <div class="row g-3 es-form-grid">
                    <div class="col-12">
                        <label for="objective-parent-goal" class="form-label es-required">Parent Goal</label>
                        <select id="objective-parent-goal" class="form-select select2" required>
                            <option value="">Select parent goal</option>
                        </select>
                        <div id="objective-parent-goal-help" class="es-field-help mt-1">Select the Parent Goal first so this Objective can inherit strategy period, horizon, theme, scope defaults, and compatible template context.</div>
                    </div>
                    <div class="col-12">
                        <div id="objective-parent-goal-context" class="objective-performance-card initiative-derived-context-card is-empty">
                            <div class="objective-performance-card-header">
                                <div>
                                    <h6 class="objective-performance-card-title mb-1">Derived Strategy Context</h6>
                                    <p id="objective-parent-goal-context-helper" class="objective-performance-card-copy mb-0">Select Parent Goal first to load inherited Strategy Period, horizon, theme, scope defaults, and available Goal context.</p>
                                </div>
                                <span class="es-status-pill is-info">Derived</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-xl-4">
                                    <label for="objective-parent-context-period" class="form-label">Parent Strategy Period <span class="badge bg-label-info ms-1">Derived</span></label>
                                    <input id="objective-parent-context-period" class="form-control bg-light" readonly tabindex="-1" value="-" />
                                </div>
                                <div class="col-12 col-xl-4">
                                    <label for="objective-parent-context-horizon" class="form-label">Goal Horizon <span class="badge bg-label-info ms-1">Derived</span></label>
                                    <input id="objective-parent-context-horizon" class="form-control bg-light" readonly tabindex="-1" value="-" />
                                </div>
                                <div class="col-12 col-xl-4">
                                    <label for="objective-parent-context-type" class="form-label">Goal Theme / Goal Type <span class="badge bg-label-info ms-1">Derived</span></label>
                                    <input id="objective-parent-context-type" class="form-control bg-light" readonly tabindex="-1" value="-" />
                                </div>
                                <div class="col-12 col-xl-8">
                                    <label for="objective-parent-context-scope" class="form-label">Scope Defaults <span class="badge bg-label-info ms-1">Derived</span></label>
                                    <input id="objective-parent-context-scope" class="form-control bg-light" readonly tabindex="-1" value="-" />
                                </div>
                                <div class="col-12 col-xl-4">
                                    <label for="objective-parent-context-kpi" class="form-label">KPI / Governance Defaults <span class="badge bg-label-info ms-1">Derived</span></label>
                                    <input id="objective-parent-context-kpi" class="form-control bg-light" readonly tabindex="-1" value="-" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div id="objective-creation-mode" class="goal-source-panel">
                            <div class="goal-source-controls">
                                <div class="goal-source-control initiative-source-control-select">
                                    <label for="objective-creation-mode-select" class="form-label mb-1">Creation Mode</label>
                                    <select id="objective-creation-mode-select" class="form-select form-select-sm">
                                        <option value="Blank">Blank</option>
                                        <option value="Template">From Objective Template</option>
                                        <option value="GoalTemplate">From Goal + Objective Template</option>
                                    </select>
                                </div>
                                <div class="goal-source-control initiative-source-control-action">
                                    <label class="form-label d-block mb-1">&nbsp;</label>
                                    <button type="button" id="objective-browse-source" class="btn btn-sm btn-outline-primary w-100">Browse template...</button>
                                </div>
                                <div class="goal-source-control initiative-source-control-action">
                                    <label class="form-label d-block mb-1">&nbsp;</label>
                                    <button type="button" id="objective-clear-source" class="btn btn-sm btn-outline-secondary w-100">Clear template</button>
                                </div>
                            </div>
                            <div id="objective-creation-mode-help" class="es-field-help mt-2 d-none">Blank starts without template defaults, but the Objective still must be anchored to a Parent Goal.</div>
                            <div id="objective-browse-source-help" class="es-field-help mt-2">Select Parent Goal first so the system can derive strategy period, horizon, and compatible Objective templates.</div>
                            <div id="objective-source-summary" class="goal-source-summary-card is-empty mt-2">
                                <div class="goal-source-summary-name">Blank Objective create</div>
                                <div class="goal-source-summary-note">Blank starts without template defaults, but the Objective still must be anchored to a Parent Goal before progression or save.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <label for="objective-id" class="form-label">Objective ID / Code</label>
                        <input id="objective-id" class="form-control bg-light" readonly autocomplete="off" placeholder="Assigned on first save" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label for="objective-status-readonly" class="form-label">Objective Code State</label>
                        <input id="objective-status-readonly" class="form-control bg-light" value="Draft" readonly disabled tabindex="-1" />
                        <input id="objective-status" type="hidden" value="Draft" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="objective-name" class="form-label es-required">Objective Name</label>
                        <input id="objective-name" class="form-control" required />
                        <div class="es-field-help mt-1">Use a strategic objective name that teams can align to and report against.</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="objective-type" class="form-label es-required">Objective Type</label>
                        <select id="objective-type" class="form-select select2" required>
                            <option value="">Select type</option>
                        </select>
                        <div id="objective-type-help" class="es-field-help mt-1">Objective must be anchored to a Parent Goal first so compatible Objective Type values can be derived.</div>
                    </div>
                    <div class="col-12 col-md-8">
                        <label for="objective-statement" class="form-label es-required">Objective Statement</label>
                        <textarea id="objective-statement" class="form-control" rows="3" required placeholder="Describe the measurable strategic outcome this objective should deliver."></textarea>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="objective-priority" class="form-label es-required">Priority</label>
                        <select id="objective-priority" class="form-select select2" required>
                            <option value="">Select priority</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-8">
                        <label for="objective-strategic-theme" class="form-label es-required">Strategic Theme / Pillar * <span id="objective-strategic-theme-badge" class="badge bg-label-info ms-1">Inherited</span></label>
                        <select id="objective-strategic-theme" class="form-select select2">
                            <option value="">Select strategic theme</option>
                        </select>
                        <div id="objective-strategic-theme-help" class="es-field-help mt-1">Strategic Theme / Pillar defaults from Parent Goal and can only be overridden deliberately.</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="objective-inline-toggle">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="objective-theme-override" />
                                <label class="form-check-label" for="objective-theme-override">Override inherited theme</label>
                            </div>
                            <div class="es-field-help">Use only when the objective intentionally diverges from the parent goal pillar.</div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="es-goal-section objective-wizard-step-pane d-none" data-step="2">
                @{
                    ViewData["Title"] = "Ownership";
                    ViewData["Subtitle"] = "Set governance-first ownership using company / org context, accountable position, and current incumbent.";
                }
                @await Html.PartialAsync("Components/Forms/_SectionHeader")
                <div class="objective-helper-banner mb-3">
                    <span class="badge bg-label-primary">Post-Save Governance</span>
                    <span>Executive sponsor, co-owners, approvals, review ownership, and versioning are managed after save.</span>
                </div>
                <div class="row g-3 es-form-grid">
                    <div class="col-12 col-md-6">
                        <label for="objective-owner-company" class="form-label es-required">Owner Company / Org</label>
                        <select id="objective-owner-company" class="form-select select2" required>
                            <option value="">Select owner company / org</option>
                        </select>
                        <div id="objective-owner-company-help" class="es-field-help">Company / org defines the accountability context for this objective.</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="objective-owner-position" class="form-label es-required">Owner Position</label>
                        <select id="objective-owner-position" class="form-select select2" required disabled>
                            <option value="">Select owner company / org first</option>
                        </select>
                        <div id="objective-owner-position-help" class="es-field-help">Owner Position defines the accountable governance seat.</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="objective-current-owner-person-display" class="form-label">Current Owner Person</label>
                        <input id="objective-current-owner-person-display" class="form-control bg-light" readonly tabindex="-1" placeholder="Auto-filled from selected position" />
                        <input id="objective-current-owner-person" type="hidden" />
                        <div id="objective-current-owner-person-help" class="es-field-help">Current Owner Person is resolved automatically from the active incumbent.</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="objective-accountability-summary" class="form-label">Accountability Summary</label>
                        <input id="objective-accountability-summary" class="form-control bg-light" readonly tabindex="-1" value="-" />
                    </div>
                </div>
            </section>

            <section class="es-goal-section objective-wizard-step-pane d-none" data-step="3">
                @{
                    ViewData["Title"] = "Planning & Scope";
                    ViewData["Subtitle"] = "Use inherited strategy period and planning horizon, then narrow scope only when needed.";
                }
                @await Html.PartialAsync("Components/Forms/_SectionHeader")
                <div class="objective-helper-banner mb-3">
                    <span class="badge bg-label-info">Inherited Horizon</span>
                    <span>Start Date and End Date default to the Parent Goal horizon. You may narrow inside that range, but not extend beyond it.</span>
                </div>
                <div class="row g-3 es-form-grid">
                    <div class="col-12">
                        <label for="objective-planning-cycle" class="form-label">Strategy Period <span class="badge bg-label-info ms-1">Inherited</span></label>
                        <select id="objective-planning-cycle" class="form-select select2" required disabled>
                            <option value="">Select parent goal first</option>
                        </select>
                        <div class="objective-inherited-context mt-2">
                            <div id="objective-planning-context-helper" class="es-field-help mb-1">Strategy Period is inherited from Parent Goal.</div>
                            <div id="objective-allowed-horizon-helper" class="es-field-help mb-0">Allowed horizon: select Parent Goal first.</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="objective-horizon-start-date" class="form-label es-required">Start Date</label>
                        <input id="objective-horizon-start-date" type="date" class="form-control" required min="1900-01-01" max="2100-12-31" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="objective-horizon-end-date" class="form-label es-required">End Date</label>
                        <input id="objective-horizon-end-date" type="date" class="form-control" required min="1900-01-01" max="2100-12-31" />
                    </div>
                    <div class="col-12">
                        <div class="objective-scope-toggle">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="objective-inherit-company-scope" />
                                <label class="form-check-label" for="objective-inherit-company-scope">Unlock inherited scope</label>
                            </div>
                            <span id="objective-scope-inherited-badge" class="badge bg-label-info">Inherited / Locked</span>
                        </div>
                        <div class="es-field-help">Scope fields remain inherited and locked until you explicitly unlock them.</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="objective-primary-company" class="form-label">Primary Company</label>
                        <select id="objective-primary-company" class="form-select select2">
                            <option value="">Select primary company</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-8">
                        <label for="objective-applicable-companies" class="form-label">Applicable Companies</label>
                        <select id="objective-applicable-companies" class="form-select d-none" multiple></select>
                        <div id="objective-applicable-companies-picker" class="es-company-multi-select" data-placeholder="Search and select applicable companies...">
                            <button type="button"
                                    id="objective-applicable-companies-toggle"
                                    class="form-select es-company-multi-select-toggle"
                                    aria-haspopup="listbox"
                                    aria-expanded="false"
                                    aria-controls="objective-applicable-companies-panel">
                                <span id="objective-applicable-companies-display" class="es-company-multi-select-display">Search and select applicable companies...</span>
                            </button>
                            <div id="objective-applicable-companies-panel" class="es-company-multi-select-panel d-none" role="dialog" aria-label="Applicable Companies">
                                <div class="es-company-multi-select-toolbar">
                                    <button type="button" id="objective-applicable-companies-select-all" class="btn btn-sm btn-outline-secondary">Select all</button>
                                    <button type="button" id="objective-applicable-companies-clear-all" class="btn btn-sm btn-outline-secondary">Clear all</button>
                                </div>
                                <div class="es-company-multi-select-search-wrap">
                                    <input id="objective-applicable-companies-search"
                                           class="form-control form-control-sm es-company-multi-select-search"
                                           type="text"
                                           placeholder="Search companies..."
                                           autocomplete="off" />
                                </div>
                                <div id="objective-applicable-companies-options"
                                     class="es-company-multi-select-options"
                                     role="listbox"
                                     aria-multiselectable="true"
                                     tabindex="0"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="objective-business-unit" class="form-label">Business Unit / Function</label>
                        <select id="objective-business-unit" class="form-select select2">
                            <option value="">Select business unit</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="objective-region" class="form-label">Region / Geography</label>
                        <select id="objective-region" class="form-select select2">
                            <option value="">Select region</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label for="objective-entity-scope-summary" class="form-label">Entity Scope Summary</label>
                        <input id="objective-entity-scope-summary" class="form-control" readonly />
                    </div>
                </div>
                <div class="objective-helper-banner objective-helper-banner-muted mt-3">
                    <span class="badge bg-label-primary">Next Step</span>
                    <span>Set Target Plan Granularity and enter target rows in Step 4: Performance.</span>
                </div>
            </section>

            <section class="es-goal-section objective-wizard-step-pane d-none" data-step="4">
                @{
                    ViewData["Title"] = "Performance";
                    ViewData["Subtitle"] = "Define KPI structure, the objective target plan by period, and planning readiness inside the current wizard.";
                }
                @await Html.PartialAsync("Components/Forms/_SectionHeader")
                <div class="objective-performance-stack">
                    <section class="objective-performance-card">
                        <div class="objective-performance-card-header">
                            <div>
                                <h6 class="objective-performance-card-title mb-1">KPI Definition</h6>
                                <p class="objective-performance-card-copy mb-0">Keep the KPI setup aligned to the Goal lineage and use it as the accountable basis for target planning.</p>
                            </div>
                        </div>
                        <div class="objective-helper-banner mb-3" id="objective-parent-metric-summary">
                            <span class="badge bg-label-primary">Goal Lineage</span>
                            <span>Select a parent goal and KPI to review inherited performance context.</span>
                        </div>
                        <div id="objective-parent-goal-kpi-context-panel" class="objective-helper-banner objective-helper-banner-muted mb-3">
                            <span class="badge bg-label-info">Inherited</span>
                            <span>Parent Goal KPI context is shown here as read-only reference while Objective KPI fields remain locally editable.</span>
                        </div>
                        <div class="row g-3 es-form-grid mb-3">
                            <div class="col-12 col-xl-7">
                                <div class="objective-helper-banner objective-helper-banner-muted h-100 align-items-start">
                                    <span class="badge bg-label-primary">Parent Goal KPI Context</span>
                                    <div id="objective-parent-goal-kpi-context-fields" class="w-100 mt-2">Select a Parent Goal to load Goal KPI context.</div>
                                </div>
                            </div>
                            <div class="col-12 col-xl-5">
                                <div class="objective-helper-banner objective-helper-banner-muted h-100 align-items-start">
                                    <span class="badge bg-label-warning">Goal vs Objective</span>
                                    <div id="objective-kpi-alignment-context" class="w-100 mt-2">Goal and Objective KPI alignment details appear here after a Parent Goal and Objective KPI are selected.</div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 es-form-grid">
                            <div class="col-12 col-md-6">
                                <label for="objective-primary-kpi" class="form-label es-required">Primary KPI / Metric <span class="badge bg-label-warning ms-1">Objective Local</span></label>
                                <select id="objective-primary-kpi" class="form-select select2" required>
                                    <option value="">Select primary KPI / metric</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label for="objective-kpi-uom" class="form-label">Unit of Measure <span class="badge bg-label-success ms-1">Derived</span></label>
                                <select id="objective-kpi-uom" class="form-select select2">
                                    <option value="">Select unit</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label for="objective-direction" class="form-label">Direction of Good Performance <span class="badge bg-label-success ms-1">Derived</span></label>
                                <select id="objective-direction" class="form-select select2">
                                    <option value="">Select direction</option>
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="objective-performance-card">
                        <div class="objective-performance-card-header">
                            <div>
                                <h6 class="objective-performance-card-title mb-1">Objective Target Plan</h6>
                                <p class="objective-performance-card-copy mb-0">Generate defined-period target rows from the inherited Strategy Period and keep the accountable target commitment inside this wizard.</p>
                            </div>
                            <span id="objective-target-plan-status-chip" class="es-status-pill is-info">Plan: Not generated</span>
                        </div>
                        <div class="objective-helper-banner objective-helper-banner-muted mb-3">
                            <span class="badge bg-label-warning">Planning Layer</span>
                            <span>Objective target rows auto-generate after first save once KPI and Strategy Period exist. Initiative and project alignment is managed later in Strategy Alignment Register.</span>
                        </div>
                        <div id="objective-parent-goal-target-context-panel" class="objective-helper-banner objective-helper-banner-muted mb-3">
                            <span class="badge bg-label-primary">Parent Goal Target Context</span>
                            <span>Goal target rows are shown as read-only reference only. Objective target rows remain the editable commitment layer.</span>
                        </div>
                        <div class="row g-3 es-form-grid mb-3">
                            <div class="col-12 col-md-4">
                                <label for="objective-target-plan-strategy-period" class="form-label">Strategy Period <span class="badge bg-label-info ms-1">Inherited</span></label>
                                <input id="objective-target-plan-strategy-period" class="form-control bg-light" readonly tabindex="-1" />
                                <div class="es-field-help">Defines the allowed planning horizon for Objective targets.</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label for="objective-target-plan-granularity" class="form-label es-required">Target Plan Granularity <span class="badge bg-label-warning ms-1">Objective Local</span></label>
                                <select id="objective-target-plan-granularity" class="form-select select2">
                                    <option value="Yearly">Yearly</option>
                                    <option value="Quarterly">Quarterly</option>
                                    <option value="Monthly">Monthly</option>
                                    <option value="TotalStrategyPeriod">Total Strategy Period</option>
                                </select>
                                <div class="es-field-help">Defines how target commitments are phased within the selected Strategy Period.</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label for="objective-reporting-frequency" class="form-label">Reporting Frequency <span class="badge bg-label-success ms-1">Derived / Local</span></label>
                                <select id="objective-reporting-frequency" class="form-select select2">
                                    <option value="">Select frequency</option>
                                </select>
                                <div class="es-field-help">Defines how progress is measured/reviewed. Does not generate planning rows.</div>
                            </div>
                        </div>
                        <div class="row g-3 es-form-grid mb-3">
                            <div class="col-12 col-xl-6">
                                <div class="objective-helper-banner objective-helper-banner-muted h-100 align-items-start">
                                    <span class="badge bg-label-primary">Goal Target Reference</span>
                                    <div id="objective-parent-goal-target-context-fields" class="w-100 mt-2">Select a Parent Goal to review Goal target cadence, horizon, and target summary.</div>
                                </div>
                            </div>
                            <div class="col-12 col-xl-6">
                                <div class="objective-helper-banner objective-helper-banner-muted h-100 align-items-start">
                                    <span class="badge bg-label-warning">Alignment Comparison</span>
                                    <div id="objective-target-plan-comparison" class="w-100 mt-2">Goal and Objective KPI/target comparisons appear here to help users plan safely inside the Goal horizon.</div>
                                </div>
                            </div>
                        </div>
                        <div id="objective-target-plan-governance-warning" class="objective-helper-banner objective-helper-banner-muted mb-3 d-none">
