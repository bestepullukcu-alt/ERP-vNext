@model string?
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.Views.Quarantine.Quarantine> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@inject HttpClient Http
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = Localizer["Quarantine.Details.Title"].Value;
    Layout = "_LayoutTenantShell";
}

@*
    MOD-0175 Q5 — Karantina Kaydı Detayı (QUARANTINEDETAILS, pack §11.3). One same-origin call (/Quarantine/data/hold/{id}: the
    hold + ETag + active decision + names + settings); details.js fills the sections. Sections are the mockup's: header, facts,
    "Kalite bilgileri", "Karar geçmişi" (signature chips = MOD-0022 signature ids), "Stok hareketleri", plus the new "İş akışı" box
    (§21.3 #10: Durumu yenile / Kararı geri çek / Yeniden uygula) and "İncelemeye al". WP-0174-ITEM: the analysis note is edited
    in place ("Notu düzenle" → updateHold PATCH with the page ETag, FU-0175-Q5-01) — drawn only for quarantine.holds.review.
    UAS-001 — nothing without quarantine.holds.read; every button only for a holder of its key.
*@
@if (!Perms.Has("quarantine.holds.read"))
{
    <partial name="_AccessDenied" model="@Localizer["Quarantine.Details.Title"].Value" />
    return;
}

@{
    var company = await Diten.Web.Models.Inventory.CompanySelection.ResolveAsync(
        Http, Configuration["GatewayUrl"] ?? string.Empty, Context.Request, User, Context.RequestAborted);
    company.Label = Localizer["Quarantine.Common.Company.Label"].Value;
    company.Placeholder = Localizer["Quarantine.Common.Company.Placeholder"].Value;
    company.SelectHint = Localizer["Quarantine.Common.Company.Required"].Value;
    company.UnavailableText = Localizer["Quarantine.Common.Company.Unavailable"].Value;
}

<partial name="~/Views/Quarantine/_Header.cshtml" model="@("QUARANTINEDETAILS")" />
<partial name="~/Views/Inventory/Shared/_CompanySelector.cshtml" model="company" />

@if (company.Ready && Model is not null)
{
    <div id="qr-details" data-hold-id="@Model">
        <div class="alert alert-danger d-none" id="qr-page-error" role="alert"></div>
        <div class="card mb-4">
            <div class="card-body d-flex flex-column flex-lg-row justify-content-between gap-3">
                <div>
                    <h5 class="mb-1 d-flex flex-wrap align-items-center gap-2">
                        <span id="qr-d-name">…</span><span id="qr-d-stock"></span><span id="qr-d-state"></span>
                    </h5>
                    <div class="text-muted small font-monospace" id="qr-d-sub"></div>
                </div>
                <div class="d-flex flex-wrap align-items-start gap-2">
                    <a class="btn btn-sm btn-label-secondary" href="/Quarantine"><i class="bx bx-arrow-back me-1"></i>@Localizer["Quarantine.Details.BackToQueue"]</a>
                    <a class="btn btn-sm btn-label-primary d-none" id="qr-d-lot"><i class="bx bx-link-external me-1"></i>@Localizer["Quarantine.Details.GoToLot"]</a>
                    @if (Perms.Has("quarantine.holds.review"))
                    {
                        <button type="button" class="btn btn-sm btn-label-info d-none" id="qr-d-review"><i class="bx bx-search-alt me-1"></i>@Localizer["Quarantine.Details.StartReview"]</button>
                    }
                    @if (Perms.Has("quarantine.decisions.create"))
                    {
                        <a class="btn btn-sm btn-primary d-none" id="qr-d-decide" href="/Quarantine/Decide/@Model"><i class="bx bx-check-shield me-1"></i>@Localizer["Quarantine.Action.Decide"]</a>
                    }
                </div>
            </div>
        </div>

        <div class="alert alert-warning d-none d-flex gap-2" id="qr-d-late" role="status"><i class="bx bx-time-five mt-1"></i><span></span></div>

        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row g-3" id="qr-d-facts">
                            <div class="col-6 col-md-4"><small class="text-muted d-block">@Localizer["Quarantine.Details.Fact.Lot"]</small><span class="fw-medium" data-f="lot">—</span></div>
                            <div class="col-6 col-md-4"><small class="text-muted d-block">@Localizer["Quarantine.Details.Fact.Expiry"]</small><span class="fw-medium" data-f="expiry">—</span></div>
                            <div class="col-6 col-md-4"><small class="text-muted d-block">@Localizer["Quarantine.Details.Fact.Quantity"]</small><span class="fw-medium" data-f="quantity">—</span></div>
                            <div class="col-6 col-md-4"><small class="text-muted d-block">@Localizer["Quarantine.Details.Fact.Where"]</small><span class="fw-medium" data-f="where">—</span></div>
                            <div class="col-6 col-md-4"><small class="text-muted d-block">@Localizer["Quarantine.Details.Fact.Wait"]</small><span class="fw-medium" data-f="wait">—</span></div>
                            <div class="col-6 col-md-4"><small class="text-muted d-block">@Localizer["Quarantine.Details.Fact.Source"]</small><span class="fw-medium" data-f="source">—</span></div>
                            <div class="col-6 col-md-4"><small class="text-muted d-block">@Localizer["Quarantine.Details.Fact.CreatedBy"]</small><span class="fw-medium" data-f="createdBy">—</span></div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><h6 class="mb-0"><i class="bx bx-test-tube me-1"></i>@Localizer["Quarantine.Details.Quality.Title"]</h6></div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6"><small class="text-muted d-block">@Localizer["Quarantine.Details.Quality.Coa"]</small><span class="font-monospace" data-f="coa">—</span></div>
                            <div class="col-12 col-md-6"><small class="text-muted d-block">@Localizer["Quarantine.Details.Quality.LotStatus"]</small><span data-f="lotStatus">—</span></div>
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted d-block">@Localizer["Quarantine.Details.Quality.Note"]</small>
                                    @if (Perms.Has("quarantine.holds.review"))
                                    {
                                        <button type="button" class="btn btn-sm btn-text-primary d-none" id="qr-d-note-edit"><i class="bx bx-edit-alt me-1"></i>@Localizer["Quarantine.Details.Quality.EditNote"]</button>
                                    }
                                </div>
                                <div class="border rounded p-2 bg-lighter" data-f="note">—</div>
                                @if (Perms.Has("quarantine.holds.review"))
                                {
                                    <div class="small text-muted mt-1 d-none" id="qr-d-note-locked"><i class="bx bx-lock-alt me-1"></i>@Localizer["Quarantine.Details.Quality.NoteLocked"]</div>
                                    <div class="d-none" id="qr-d-note-editor">
                                        <textarea class="form-control" id="qr-d-note-input" rows="4" maxlength="2000" aria-label="@Localizer["Quarantine.Details.Quality.Note"]"></textarea>
                                        <div class="d-flex justify-content-end gap-2 mt-2">
                                            <button type="button" class="btn btn-sm btn-label-secondary" id="qr-d-note-cancel">@Localizer["Quarantine.Common.Cancel"]</button>
                                            <button type="button" class="btn btn-sm btn-primary" id="qr-d-note-save">@Localizer["Quarantine.Common.Save"]</button>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="col-12">
                                <small class="text-muted d-block">@Localizer["Quarantine.Details.Quality.Attachments"]</small>
                                <div class="d-flex flex-wrap gap-2" data-f="attachments">—</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bx bx-transfer-alt me-1"></i>@Localizer["Quarantine.Details.Moves.Title"]</h6>
                        <small class="text-muted">@Localizer["Quarantine.Details.Moves.Subtitle"]</small>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0" id="qr-d-moves">
                            <thead>
                                <tr>
                                    <th>@Localizer["Quarantine.Col.MoveNo"]</th>
                                    <th>@Localizer["Quarantine.Col.Date"]</th>
                                    <th>@Localizer["Quarantine.Col.MoveType"]</th>
                                    <th>@Localizer["Quarantine.Col.StatusChange"]</th>
                                    <th class="text-end">@Localizer["Quarantine.Col.Quantity"]</th>
                                    <th>@Localizer["Quarantine.Col.User"]</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card mb-4 border border-primary border-opacity-25" id="qr-wf">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0"><i class="bx bx-git-branch me-1"></i>@Localizer["Quarantine.Workflow.Box"]</h6>
                        <span id="qr-wf-state"></span>
                    </div>
                    <div class="card-body">
                        <div id="qr-wf-body" class="small"></div>
                        <div class="d-flex flex-wrap gap-2 mt-3" id="qr-wf-actions">
                            <button type="button" class="btn btn-sm btn-label-primary d-none" id="qr-wf-refresh"><i class="bx bx-refresh me-1"></i>@Localizer["Quarantine.Workflow.Refresh"]</button>
                            @if (Perms.Has("quarantine.decisions.create"))
                            {
                                <a class="btn btn-sm btn-primary d-none" id="qr-wf-submit"><i class="bx bx-send me-1"></i>@Localizer["Quarantine.Workflow.SubmitLink"]</a>
                            }
                            @if (Perms.Has("quarantine.decisions.withdraw"))
                            {
                                <button type="button" class="btn btn-sm btn-label-danger d-none" id="qr-wf-withdraw"><i class="bx bx-undo me-1"></i>@Localizer["Quarantine.Workflow.Withdraw"]</button>
                            }
                            @if (Perms.Has("quarantine.decisions.apply"))
                            {
                                <button type="button" class="btn btn-sm btn-warning d-none" id="qr-wf-reapply"><i class="bx bx-redo me-1"></i>@Localizer["Quarantine.Workflow.Reapply"]</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><h6 class="mb-0"><i class="bx bx-history me-1"></i>@Localizer["Quarantine.Details.History.Title"]</h6></div>
                    <div class="card-body">
                        <ul class="timeline mb-0" id="qr-d-history"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <form id="qr-antiforgery" class="d-none">@Html.AntiForgeryToken()</form>
}

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="~/Views/Quarantine/_QuarantineActions.cshtml" />
    <partial name="~/Views/Quarantine/_QuarantineL10n.cshtml" />
    @if (company.Ready && Model is not null)
    {
        <script src="~/assets/js/shared/premium-modal.js" asp-append-version="true"></script>
        <script src="~/assets/js/Quarantine/details.js" asp-append-version="true"></script>
    }
}
