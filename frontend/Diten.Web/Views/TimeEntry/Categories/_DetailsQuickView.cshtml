@using Diten.Web.Views.TimeEntry.Categories
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CategoriesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end backbone-preview-offcanvas" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="oc-title">
    <div class="offcanvas-header p-4">
        <div class="d-flex align-items-center min-w-0">
            <div class="backbone-preview-avatar d-flex align-items-center justify-content-center me-3 flex-shrink-0">
                <i class="bx bx-purchase-tag fs-4"></i>
            </div>
            <div class="min-w-0">
                <h5 id="oc-title" class="offcanvas-title mb-0 text-truncate">-</h5>
                <small id="oc-subtitle" class="text-muted d-block text-truncate">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body flex-grow-1 p-4 border-top">
        <section class="card backbone-preview-section p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-3 backbone-preview-section-title">@Localizer["GeneralInformation"]</h6>
            <div class="row g-4">
                <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-hash"></i><div class="min-w-0 flex-grow-1"><div class="backbone-preview-label">@Localizer["Code"]</div><div id="oc-code" class="backbone-preview-value mt-1">-</div></div></div></div>
                <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-text"></i><div class="min-w-0 flex-grow-1"><div class="backbone-preview-label">@Localizer["Label"]</div><div id="oc-label" class="backbone-preview-value mt-1">-</div></div></div></div>
                <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-briefcase"></i><div class="min-w-0 flex-grow-1"><div class="backbone-preview-label">@Localizer["CountsAsWork"]</div><div id="oc-counts" class="backbone-preview-value mt-1">-</div></div></div></div>
                <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-check-circle"></i><div class="min-w-0 flex-grow-1"><div class="backbone-preview-label">@SharedLocalizer["Status"]</div><div id="oc-status" class="badge mt-1">-</div></div></div></div>
                <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-align-left"></i><div class="min-w-0 flex-grow-1"><div class="backbone-preview-label">@SharedLocalizer["Description"]</div><div id="oc-desc" class="backbone-preview-value mt-1">-</div></div></div></div>
            </div>
        </section>
    </div>
    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-primary" id="oc-btn-edit">@SharedLocalizer["EditRecord"]</button>
    </div>
</div>
