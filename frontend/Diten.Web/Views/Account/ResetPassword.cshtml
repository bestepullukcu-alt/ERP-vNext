@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    Layout = null;
    var isForcedChange = ViewBag.IsForcedChange is true;
    ViewData["Title"] = isForcedChange ? SharedLocalizer["ChangePassword.Title"] : SharedLocalizer["ResetPassword.Title"];
}

<!DOCTYPE html>
<html lang="en" class="layout-wide customizer-hide" dir="ltr" data-skin="default" data-assets-path="@Url.Content("~/assets/")" data-template="vertical-menu-template" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"] - Di10</title>
    <link rel="icon" type="image/x-icon" href="~/assets/img/favicon/favicon.ico" />
    <link rel="stylesheet" href="~/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/theme-default.css" />
    <link rel="stylesheet" href="~/assets/css/demo.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/pages/page-auth.css" />
    <script src="~/assets/vendor/js/helpers.js"></script>
    <script src="~/assets/js/config.js"></script>
    <script>
        window.ResetPasswordConfig = {
            isForcedChange: @Json.Serialize(isForcedChange),
            email: @Json.Serialize((string)(ViewBag.Email ?? string.Empty)),
            token: @Json.Serialize((string)(ViewBag.Token ?? string.Empty))
        };
        window.L10n = {
            ErrorTitle: "@SharedLocalizer["Login.ErrorTitle"]",
            Required: "@SharedLocalizer["ResetPassword.Required"]",
            Mismatch: "@SharedLocalizer["ResetPassword.Mismatch"]",
            SuccessTitle: "@SharedLocalizer["ResetPassword.SuccessTitle"]",
            SuccessMessage: "@SharedLocalizer["ResetPassword.SuccessMessage"]",
            Loading: "@SharedLocalizer["Login.Loading"]"
        };
    </script>
</head>
<body>
    <div class="container-xxl">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner">
                <div class="card px-sm-6 px-0">
                    <div class="card-body">
                        <div class="app-brand justify-content-center" style="height: 60px !important; min-height: 60px !important; margin-bottom: 25px;">
                            <a href="/platform/login" class="app-brand-link gap-2" style="height: 60px !important;">
                                <span class="app-brand-logo demo">
                                    <img src="~/assets/img/branding/platform-logo-light.png" alt="Di10 Enterprise Solutions" style="height:60px;width:auto;" />
                                </span>
                            </a>
                        </div>
                        <h4 class="mb-1">@(isForcedChange ? SharedLocalizer["ChangePassword.Title"] : SharedLocalizer["ResetPassword.Title"])</h4>
                        <p class="mb-6"><span class="fw-medium">@(isForcedChange ? SharedLocalizer["ChangePassword.Subtitle"] : SharedLocalizer["ResetPassword.Subtitle"])</span></p>
                        <form id="resetPasswordForm" class="mb-6">
                            <input type="hidden" id="email" value="@ViewBag.Email" />
                            <input type="hidden" id="token" value="@ViewBag.Token" />
                            @if (isForcedChange)
                            {
                                <div class="mb-6">
                                    <label class="form-label" for="currentPassword">@SharedLocalizer["CurrentPassword"]</label>
                                    <div class="input-group input-group-merge form-password-toggle">
                                        <input type="password" id="currentPassword" class="form-control" autocomplete="current-password" />
                                        <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                                    </div>
                                </div>
                            }
                            <div class="mb-6">
                                <label class="form-label" for="newPassword">@SharedLocalizer["NewPassword"]</label>
                                <div class="input-group input-group-merge form-password-toggle">
                                    <input type="password" id="newPassword" class="form-control" autocomplete="new-password" />
                                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                                </div>
                            </div>
                            <div class="mb-6">
                                <label class="form-label" for="confirmPassword">@SharedLocalizer["ConfirmPassword"]</label>
                                <div class="input-group input-group-merge form-password-toggle">
                                    <input type="password" id="confirmPassword" class="form-control" autocomplete="new-password" />
                                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                                </div>
                            </div>
                            <button class="btn btn-primary d-grid w-100 mb-6" type="submit">@SharedLocalizer["SetNewPassword"]</button>
                            <div class="text-center">
                                <a href="/platform/login">
                                    <i class="icon-base bx bx-chevron-left scaleX-n1-rtl me-1 align-top"></i>
                                    @SharedLocalizer["BackToLogin"]
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/assets/vendor/js/bootstrap.js"></script>
    <script src="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/assets/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/assets/js/main.js"></script>
    <script src="~/assets/js/Account/reset-password.js"></script>
</body>
</html>
