@model Diten.Web.Models.Commercial.PricingPageViewModel
@using Diten.Web.Views.Commercial.Pricing
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PricingIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* W6-WEB-b — the inline collapse filter of the standard (Save View keeps it): selling company (MDM), country and currency
   (from the rows shown), kind and the status badge. The option texts are written by index.js (loadOptions). *@
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-company">
                        <select id="filterLegalEntity" class="form-select form-select-sm select2" data-placeholder="@Localizer["CompanyLabel"]"><option value=""></option></select>
                    </div>
                    <div class="filter-chip filter-country">
                        <select id="filterCountry" class="form-select form-select-sm select2" data-placeholder="@Localizer["CountryLabel"]"><option value=""></option></select>
                    </div>
                    <div class="filter-chip filter-currency">
                        <select id="filterCurrency" class="form-select form-select-sm select2" data-placeholder="@Localizer["CurrencyLabel"]"><option value=""></option></select>
                    </div>
                    <div class="filter-chip filter-kind">
                        <select id="filterKind" class="form-select form-select-sm select2" data-placeholder="@Localizer["KindLabel"]"><option value=""></option></select>
                    </div>
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" data-placeholder="@Localizer["StatusLabel"]"><option value=""></option></select>
                    </div>
                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
