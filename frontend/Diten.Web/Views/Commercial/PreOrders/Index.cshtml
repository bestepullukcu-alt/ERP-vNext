@model Diten.Web.Models.Commercial.PreOrderPageViewModel
@using Diten.Web.Views.Commercial.PreOrders
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PreOrdersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutTenantShell";
    Context.Items["NavActivePath"] = "/Commercial/PreOrders";
}

@*
    WP-VW-W6 · W6-WEB-a — B: the pre-orders (mockup W6 B) on the Golden Compact LIST STANDARD: the inline filter (period ·
    status · rep · pharmacy · depot · product · country · "Onayımı bekleyenler") → the list header → the server-mode table
    (the CRM pages the orders newest first; no sort, so no order or total across currencies — AC-UI-2) → the quick view
    (lines, totals, timeline; the depot's answer for sales operations only — D9). The standard primary button "New
    pre-order" exists only with commercial.pre-orders.create. UAS-001: without a read key NOTHING but the notice.
*@
@if (!Model.CanRead)
{
    <partial name="_AccessDenied" model="@Localizer["PageTitle"].Value" />
    return;
}

@* ① Inline Filter partial *@
@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/Commercial/PreOrders/_Filter.cshtml" model="Model" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["PageTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="po-root" class="d-none"
     data-screen="list"
     data-can-create="@Model.CanCreate.ToString().ToLowerInvariant()"
     data-can-export="@Model.CanExport.ToString().ToLowerInvariant()"
     data-can-approve="@Model.CanApprove.ToString().ToLowerInvariant()"
     data-can-depot-response="@Model.CanRecordDepotResponse.ToString().ToLowerInvariant()"
     data-sees-team="@Model.SeesTeam.ToString().ToLowerInvariant()"></div>

@* Contract markers are rendered by _DataTable.cshtml: the shared <partial name="_TableSkeleton" /> (which carries id="skeleton-loader"), <table id="dt-preorders" data-dt-standard="v2"> *@
<partial name="~/Views/Commercial/PreOrders/_DataTable.cshtml" model="Model" />

@* ④ Quick view — the standard offcanvas: the order, read once per open *@
<div class="offcanvas offcanvas-end po-drawer" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="oc-title">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center">
            <div class="avatar avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                <i class="bx bx-cart-alt fs-4"></i>
            </div>
            <div>
                <h5 id="oc-title" class="offcanvas-title mb-0">@Localizer["DrawerTitle"]</h5>
                <small id="oc-subtitle" class="text-muted d-block">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@Localizer["CloseButton"]"></button>
    </div>
    <div class="offcanvas-body flex-grow-1 p-0">
        <div class="d-flex flex-column" id="oc-details-list"></div>
        @if (Model.CanRecordDepotResponse)
        {
            @* D9 — the depot's answer, recorded by sales operations only (the CRM checks the same key); drawn for a transmitted order *@
            <form id="po-depot-form" class="px-4 py-3 border-top d-none" novalidate>
                <h6 class="mb-2">@Localizer["DepotResponseTitle"]</h6>
                <div class="btn-group mb-3" role="group" aria-label="@Localizer["DepotResponseTitle"]">
                    <input type="radio" class="btn-check" name="po-dr-status" id="po-dr-delivered" value="delivered" autocomplete="off" />
                    <label class="btn btn-sm btn-outline-primary" for="po-dr-delivered">@Localizer["DR_delivered"]</label>
                    <input type="radio" class="btn-check" name="po-dr-status" id="po-dr-partial" value="partial" autocomplete="off" />
                    <label class="btn btn-sm btn-outline-primary" for="po-dr-partial">@Localizer["DR_partial"]</label>
                </div>
                <div id="po-dr-lines" class="d-none mb-3"></div>
                <label class="form-label" for="po-dr-note">@Localizer["DepotResponseNote"]</label>
                <div class="diten-field"><i class="bx bx-note diten-field-icon" aria-hidden="true"></i><textarea class="form-control" id="po-dr-note" rows="2" maxlength="500"></textarea></div>
                <div class="alert alert-danger d-none mt-2 mb-0 py-2" id="po-dr-alert" role="alert"></div>
            </form>
        }
    </div>
    <div class="offcanvas-footer border-top p-4 d-flex flex-wrap justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary flex-grow-1" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <a id="oc-btn-document" href="#" class="btn btn-label-primary flex-grow-1 d-none"><i class="bx bx-file me-1"></i>@Localizer["OpenDocument"]</a>
        <a id="oc-btn-approve" href="#" class="btn btn-label-warning flex-grow-1 d-none">@Localizer["OpenApproval"]</a>
        @if (Model.CanRecordDepotResponse)
        {
            <button type="button" id="po-dr-save" class="btn btn-primary flex-grow-1 d-none" data-dt-primary="chord">@Localizer["DepotResponseSave"]</button>
        }
        <a id="oc-btn-edit" href="#" class="btn btn-primary flex-grow-1 d-none"></a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/js/Commercial/PreOrders/preorders.css" asp-append-version="true" />
}

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/Commercial/PreOrders/_IndexL10n.cshtml" />
    <script src="~/assets/js/Commercial/PreOrders/index.l10n.js" asp-append-version="true"></script>
    <partial name="~/Views/Commercial/_CommercialRulesL10n.cshtml" />
    <script src="~/assets/js/shared/diten-datefield.js" asp-append-version="true"></script>
    <script src="~/assets/js/Commercial/PreOrders/preorders-core.js" asp-append-version="true"></script>
    <script src="~/assets/js/Commercial/PreOrders/preorders-ui.js" asp-append-version="true"></script>
    <script src="~/assets/js/Commercial/PreOrders/index.js" asp-append-version="true"></script>
}
