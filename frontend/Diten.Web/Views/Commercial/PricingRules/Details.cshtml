@model Diten.Web.Models.Commercial.PricingPageViewModel
@using Diten.Web.Views.Commercial.Pricing
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PricingIndex> Localizer
@{
    ViewData["Title"] = Localizer["RuleDetailsTitle"].Value;
    ViewData["PageCode"] = PricingIndex.RuleListHelpCode; // UXH-001 — COM-PRICINGRULE-LIST
    Layout = "_LayoutTenantShell";
    Context.Items["NavActivePath"] = "/Commercial/Pricing";
}

@*
    WP-VW-W6 · W6-WEB-b — one rule: its key (company · product · validity · how specific), its soft / hard limits, its
    versions, its approval and the actions it lets the caller take (PricingCore.ruleActions): edit / discard a draft,
    submit it, approve or return it (FOUR EYES — never for the one who prepared it), revise or retire an active rule (a new
    version draft that the second person approves). UAS-001: without commercial.pricing-rules.read NOTHING but the notice.
*@
@if (!Model.Allowed)
{
    <partial name="_AccessDenied" model="@Localizer["RuleDetailsTitle"].Value" />
    return;
}

<partial name="~/Views/Commercial/Pricing/_PricingHeader.cshtml" model="Model" />
<div id="pr-pane">
    <div id="pr-detail-root" data-id="@Model.Id"
         data-can-update="@Model.CanUpdateRule.ToString().ToLowerInvariant()" data-can-submit="@Model.CanSubmitRule.ToString().ToLowerInvariant()"
         data-can-publish="@Model.CanPublishRule.ToString().ToLowerInvariant()">
        <div class="alert alert-danger d-none" id="pr-alert" role="alert"></div>
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
            <div>
                <h6 class="mb-1" id="pr-title">@Localizer["RuleDetailsTitle"]</h6>
                <span id="pr-badge"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/Commercial/Pricing/Rules" class="btn btn-label-secondary">@Localizer["BackToList"]</a>
                <a href="#" class="btn btn-label-primary d-none" id="pr-edit"><i class="bx bx-edit-alt me-1"></i>@Localizer["EditDraft"]</a>
                <a href="#" class="btn btn-label-primary d-none" id="pr-revise"><i class="bx bx-revision me-1"></i>@Localizer["Revise"]</a>
                <button type="button" class="btn btn-label-warning d-none" id="pr-retire"><i class="bx bx-archive me-1"></i>@Localizer["Retire"]</button>
                <button type="button" class="btn btn-label-danger d-none" id="pr-discard"><i class="bx bx-trash me-1"></i>@Localizer["DiscardDraft"]</button>
                <button type="button" class="btn btn-primary d-none" id="pr-submit"><i class="bx bx-send me-1"></i>@Localizer["SubmitForApproval"]</button>
            </div>
        </div>

        <section class="card mb-3">
            <div class="card-body">
                <h6 class="card-section-title mb-3"><i class="bx bx-key"></i>@Localizer["RuleKeySection"]</h6>
                <div id="pr-facts"></div>
            </div>
        </section>

        <section class="card mb-3">
            <div class="card-body">
                <h6 class="card-section-title mb-3"><i class="bx bx-slider-alt"></i>@Localizer["LimitsSection"]</h6>
                <div id="pr-limits"></div>
            </div>
        </section>

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <div class="card h-100"><div class="card-body">
                    <div class="card-section-title mb-3"><i class="bx bx-check-shield"></i>@Localizer["ApprovalTitle"]</div>
                    <div id="pr-approval"></div>
                    <div class="mt-3" id="pr-decision"></div>
                </div></div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card h-100"><div class="card-body">
                    <div class="card-section-title mb-3"><i class="bx bx-git-branch"></i>@Localizer["VersionsTitle"]</div>
                    <div id="pr-versions"></div>
                </div></div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Commercial/PreOrders/_ReasonModal.cshtml" />

@section Styles {
    <link rel="stylesheet" href="~/assets/js/Commercial/Pricing/pricing.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="~/Views/Commercial/PricingRules/_IndexL10n.cshtml" />
    <script src="~/assets/js/Commercial/PricingRules/index.l10n.js" asp-append-version="true"></script>
    <partial name="~/Views/Commercial/Pricing/_PricingScripts.cshtml" />
    <script src="~/assets/js/Commercial/Pricing/pricing-ui.js" asp-append-version="true"></script>
    <script src="~/assets/js/Commercial/PricingRules/details.js" asp-append-version="true"></script>
}
