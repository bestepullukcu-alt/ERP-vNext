@model Diten.Web.Models.Commercial.PricingPageViewModel
@using Diten.Web.Views.Commercial.Pricing
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PricingIndex> Localizer
@{
    ViewData["Title"] = Localizer["FxEditTitle"].Value;
    ViewData["PageCode"] = PricingIndex.FxHelpCode; // UXH-001 — COM-FXRATE-LIST
    Layout = "_LayoutTenantShell";
    Context.Items["NavActivePath"] = "/Commercial/Pricing";
}

@* W6-WEB-b — a correction of one FX rate (commercial.fx-rates.update). UAS-001: without the key NOTHING but the notice. *@
@if (!Model.Allowed)
{
    <partial name="_AccessDenied" model="@Localizer["FxEditTitle"].Value" />
    return;
}

<partial name="~/Views/Commercial/Pricing/_PricingHeader.cshtml" model="Model" />
<div id="pr-pane">
    <h6 class="mb-3">@Localizer["FxEditTitle"]</h6>
    <partial name="~/Views/Commercial/FxRates/_Form.cshtml" model="Model" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/assets/js/Commercial/Pricing/pricing.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <partial name="~/Views/Commercial/FxRates/_IndexL10n.cshtml" />
    <script src="~/assets/js/Commercial/FxRates/index.l10n.js" asp-append-version="true"></script>
    <partial name="~/Views/Commercial/Pricing/_PricingScripts.cshtml" />
    <script src="~/assets/js/Commercial/Pricing/pricing-ui.js" asp-append-version="true"></script>
    <script src="~/assets/js/Commercial/FxRates/form.js" asp-append-version="true"></script>
}
