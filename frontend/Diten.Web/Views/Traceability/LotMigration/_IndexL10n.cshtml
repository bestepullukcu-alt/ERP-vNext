@using Diten.Web.Views.Traceability.LotMigration
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LotMigrationIndex> Localizer
@*
    The page script's vocabulary (pack §11.6 LotMigrationIndex): exactly TraceL10nKeys.LotMigration, key → value in the
    reader's language. The script reads the same dotted names (window.TraceL10n); a missing one is reported by
    index.l10n.js, never replaced by hardcoded text.
*@
<script id="lotmigration-l10n" type="application/json">@Json.Serialize(Diten.Web.Models.Traceability.TraceL10nKeys.LotMigration.Distinct().ToDictionary(k => k, k => Localizer[k].Value))</script>
