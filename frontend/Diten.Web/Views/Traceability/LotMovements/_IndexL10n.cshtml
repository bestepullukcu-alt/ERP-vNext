@using Diten.Web.Views.Traceability.LotMovements
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LotMovementsIndex> Localizer
@*
    The page script's vocabulary (pack §11.6): exactly TraceL10nKeys.LotMovements, key → value in the reader's language. The script
    reads the same dotted names (window.TraceL10n); a missing one is reported by index.l10n.js, never replaced by hardcoded text.
*@
<script id="lotmovements-l10n" type="application/json">@Json.Serialize(Diten.Web.Models.Traceability.TraceL10nKeys.LotMovements.Distinct().ToDictionary(k => k, k => Localizer[k].Value))</script>
