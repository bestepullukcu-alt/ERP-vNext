@using Diten.Web.Views.Traceability.Serials
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SerialsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@* Seri Gezgini filters (pack §11.3): serial no = the list's search box; product; lot (dependent on the product); status. *@
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-product">
                        <select id="filterItemId" class="form-select form-select-sm" data-placeholder="@Localizer["Filter.Product"]" aria-label="@Localizer["Filter.Product"]">
                            <option value=""></option>
                        </select>
                    </div>
                    <div class="filter-chip filter-lot">
                        <select id="filterLotId" class="form-select form-select-sm select2" data-placeholder="@Localizer["Filter.Lot"]" aria-label="@Localizer["Filter.Lot"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" data-placeholder="@Localizer["Filter.Status"]" aria-label="@Localizer["Filter.Status"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            @foreach (var status in Diten.Web.Models.Traceability.TraceListAdapter.SerialStatuses)
                            {
                                <option value="@status">@Localizer["Serial.Status." + status]</option>
                            }
                        </select>
                    </div>
                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
