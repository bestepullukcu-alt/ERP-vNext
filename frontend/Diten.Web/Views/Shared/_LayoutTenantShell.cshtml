@using System.Security.Claims
@using System.Text.Json
@using Diten.Web.Security
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    var currentUser = User?.Identity?.IsAuthenticated == true
        ? new
        {
            id = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? User.FindFirst("sub")?.Value,
            email = User.FindFirst(ClaimTypes.Email)?.Value ?? User.FindFirst("email")?.Value,
            firstName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? string.Empty,
            lastName = User.FindFirst(ClaimTypes.Surname)?.Value ?? string.Empty,
            roles = User.FindAll(ClaimTypes.Role)
                .Select(claim => claim.Value)
                .Concat(User.FindAll("role").Select(claim => claim.Value))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            tenantId = User.FindFirst("tenant_id")?.Value ?? User.FindFirst("tenantId")?.Value,
            actorType = User.FindFirst("actor_type")?.Value
        }
        : null;
    var currentUserJson = JsonSerializer.Serialize(currentUser);
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName;
    var layoutDirection = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase) ? "rtl" : "ltr";
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var canAccessHcmEmployeeDraft = PermissionClaims.HasPermission(User, "mod0251.employee.create_draft");
}
<!DOCTYPE html>

<html lang="@currentCulture" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="@layoutDirection" data-skin="default"
    data-assets-path="/assets/" data-template="vertical-menu-template" data-bs-theme="light" data-semidark-menu="false"
    data-shell="tenant"
    @* BL-294/nav — main.js is a STATIC asset with no access to the resx, so the Ctrl+K palette's
       "could not load" text is handed to it here, already localized in the request's culture. *@
    data-nav-load-failed="@SharedLocalizer["NavigationLoadFailed"]"
    data-nav-load-failed-hint="@SharedLocalizer["NavigationLoadFailedHint"]">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>@ViewData["Title"] - Di10</title>

    <!-- Favicon (tenant branding, falls back to platform default) -->
    @await Component.InvokeAsync("TenantFavicon")

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
        rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet" href="~/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="~/assets/vendor/fonts/fontawesome.css" />
    <link rel="stylesheet" href="~/assets/vendor/fonts/flag-icons.css" />

    <link rel="stylesheet" href="~/assets/vendor/css/core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/demo.css" asp-append-version="true" />

    <!-- Vendor CSS (Global essentials only) -->
    <link rel="stylesheet" href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/typeahead-js/typeahead.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/notyf/notyf.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/animate-css/animate.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/pickr/pickr-themes.css" />

    <!-- DataTables Vendor CSS -->
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-colreorder-bs5/colReorder.dataTables.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />
    @* MOD-0220 fix — flatpickr for culture-aware date pickers on tenant forms (Legal Entity wizard, Organization). *@
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />

    <!-- Custom CSS (Loaded last to override vendors) -->
    <link rel="stylesheet" href="~/assets/css/backbone-custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Helpers -->
    <script src="~/assets/vendor/js/helpers.js"></script>
    <script src="~/assets/vendor/libs/pickr/pickr.js"></script>
    <script src="~/assets/vendor/js/template-customizer.js"></script>
    <script>
        // Dev (localhost): the gateway is reachable directly on :5000, so call it. Deployment (real host):
        // IIS reverse-proxies /api/* to the internal gateway on the same origin (the gateway port is not
        // publicly exposed), so use an empty (same-origin) base.
        window.ApiBaseUrl = (window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1")
            ? window.location.protocol + "//" + window.location.hostname + ":5000"
            : window.location.origin;
        window.API = {
            mdm: window.ApiBaseUrl,
            deven: window.ApiBaseUrl,
            auth: window.ApiBaseUrl,
            platform: window.ApiBaseUrl
        };
        window.CurrentLanguage = "@currentCulture";
        window.CurrentUser = @Html.Raw(currentUserJson);
        window.CurrentShell = "tenant";
    </script>
    <script>
        (function () {
            try {
                // Pre-render state normalization to prevent FOUC (Flash of Unstyled Content)
                var template = "vertical-menu-template";
                var themeKey = "templateCustomizer-" + template + "--Theme";
                var layoutKey = "templateCustomizer-" + template + "--LayoutCollapsed";
                
                var storedTheme = window.localStorage.getItem(themeKey);
                var isCollapsed = window.localStorage.getItem(layoutKey) === "true";

                if (storedTheme) {
                    var resolvedTheme = storedTheme === "system"
                        ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
                        : storedTheme;
                    document.documentElement.setAttribute("data-bs-theme", resolvedTheme);
                }

                if (isCollapsed) {
                    document.documentElement.classList.add("layout-menu-collapsed");
                }
            } catch (_) { }
        })();
    </script>
    <script src="~/assets/js/config.js" asp-append-version="true"></script>

    @* Build window.L10n via JSON serialization, NOT inline "@("@")Value" — Razor's HTML encoder turns non-Latin
       characters (Cyrillic / Arabic / CJK) into &#xNNNN; entities, which then render literally when the shared
       required-fields tracker writes them via textContent. JSON emits \uXXXX escapes that the JS parser decodes
       back to the real characters, so every language shows correctly. *@
    @{
        var l10nBridge = new System.Collections.Generic.Dictionary<string, string>
        {
            ["RequiredProgressText"] = SharedLocalizer["RequiredStatus"].Value,
            ["ValidationErrorsText"] = SharedLocalizer["ValidationErrors"].Value,
            ["LoginErrorTitle"] = SharedLocalizer["Login.ErrorTitle"].Value,
            ["LoginErrorRequired"] = SharedLocalizer["Login.ErrorRequired"].Value,
            ["LoginSubmit"] = SharedLocalizer["Login.Submit"].Value,
            ["User"] = SharedLocalizer["User"].Value,
            ["AreYouSure"] = SharedLocalizer["AreYouSure"].Value
        };
    }
    <script>
        window.L10n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(l10nBridge));

        // Template normalization
        window.L10n.RequiredProgressText = window.L10n.RequiredProgressText.replace("{{0}}", "{0}").replace("{{1}}", "{1}");
        window.L10n.ValidationErrorsText = window.L10n.ValidationErrorsText.replace("{{0}}", "{0}");

        // ShellAccessFilter enforces auth redirects server-side.
    </script>
    <style>
        /* Prevent Flash of Unstyled Content (FOUC) and layout shifts */
        .layout-menu:not(.initialized) .menu-inner { opacity: 0; }
        .menu-vertical .menu-header { transition: none !important; }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('layout-menu')?.classList.add('initialized');
        });
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <!-- Menu (Sidebar) -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    @* FIX-SHELL-BRANDING — tenant logo varsa sadece logo, yoksa default ikon + "Di10". *@
                    @await Component.InvokeAsync("TenantBrand")
                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="icon-base bx bx-chevron-left"></i>
                    </a>
                </div>

                <div class="menu-inner-shadow"></div>

                <ul class="menu-inner py-1">
                    @* BL-060 — the hand-written "Workspace" (Çalışma Alanı) header that used to open this list was
                       REMOVED. Measured: it printed the SharedResource key `Workspace` = "Çalışma Alanı", the exact
                       same text the dynamic menu prints for the Workspace domain (`Nav.Domain.WORKSPACE`), so the
                       sidebar showed the section title twice and the two looked like two separate sections. After
                       the four document-management duplicates below were deleted, the only item left under it was
                       Reconciliation — a DOCUMENT-MANAGEMENT page, not a workspace one — so the header was not just
                       duplicated, it was mislabelling its own content. It was not re-pointed at
                       `Nav.Domain.DOCUMENTMANAGEMENT` either: that would only move the collision (the dynamic menu
                       already prints "Doküman Yönetimi" for the catalogue pages). The single remaining hand-written
                       document link renders headerless until it is catalogued, which is what it actually is — a
                       stray entry, not a section. The `Workspace` resx key is left in place (harmless, still used
                       by the dynamic domain map's sibling keys). *@
                    @* WC-1b — the Task Center (Görev Merkezi) is rendered DATA-DRIVEN by the DynamicModuleMenu
                       below, from the `work-aggregation` module catalog entry (page WORKCENTER → /WorkCenterNext,
                       gated on platform.work-aggregation.inbox.view) — same migration Access Governance and
                       Tenant Settings went through, so the sidebar shows exactly ONE Görev Merkezi link.
                       The LEGACY /WorkCenter link was also removed from the menu by explicit decision
                       (2026-07-25): the page, controller and views remain FROZEN and reachable by direct URL for
                       comparison/rollback — only its navigation entry is gone. Its `WorkCenterMenu` /
                       `WorkCenterNextMenu` resx keys are intentionally left in place (harmless).
                       This "Workspace" header still labels the Document Management items below. *@

                    @* FEAT-BASELINE-MODULES-S2 — Security Settings (/TenantSecurity) and Menu Settings (/TenantNavigation)
                       are now rendered DATA-DRIVEN by the DynamicModuleMenu below (the `tenant-settings` BASELINE module,
                       "Settings" domain — same routes + same platform.tenant-security.manage per-item gate). The Work
                       Center block above stays hardcoded (Phase B / MOD-0024 will self-register it, entitlement-gated). *@
                    @*
                       ══ LEGACY-NAV — HAND-WRITTEN LINKS, NOT CATALOGUE-DRIVEN ═══════════════════════════════
                       Everything from here to the LEGACY-NAV-END marker is typed by hand. It does NOT come from
                       the module catalogue and the DynamicModuleMenu below knows nothing about it.

                       WHY THIS MARKER EXISTS. When the dynamic menu produced ZERO groups for an entire session,
                       the sidebar still looked populated — these six links were the only thing in it — so the
                       outage read as "some modules are missing" when the truth was "none of them rendered". A
                       hand-written link that is indistinguishable from a catalogue link masks the next outage the
                       same way.

                       FOUR OF THESE WERE DUPLICATES AND ARE NOW DELETED (BL-060, 2026-08-10). Once BL-059 let the
                       platform system tenant past the entitlement gate, the catalogue started serving these four
                       routes itself and the sidebar showed each of them TWICE. Measured against
                       platform_module_page_descriptors before deleting — every one of them nav-visible and Active:
                         /DocumentManagementControlledDocuments → CONTROLLED_DOCUMENTS
                         /DocumentManagementTemplateMasters     → TEMPLATE_MASTERS
                         /DocumentManagementTemplateVariants    → TEMPLATE_VARIANTS
                         /DocumentManagementAccessMatrix        → ACCESS_MATRIX
                       Their @if (Perms.Has(...)) guards went with them — the catalogue carries the same per-page
                       RequiredPermission, so no gate was lost. Their resx label keys (ControlledDocuments,
                       TemplateMasters, TemplateVariants, AccessMatrix) are left in place, harmless.

                       TWO REMAIN AND ARE STILL HAND-WRITTEN — see the removal condition on each below. This fence
                       therefore STAYS: there is still hand-written content behind it, and that is exactly what the
                       marker is for.
                       ═══════════════════════════════════════════════════════════════════════════════════════
                    *@
                    @* MOD-0028-FU10 — Reconciliation, Evidence & Deviations (TenantShell). FE-B UX guard: shown only
                       with the QMS baseline view permission; backend (FU09 Layer 1) is authoritative.

                       BL-060 — STILL HAND-WRITTEN, and the last document-management link that is. The other four
                       were deleted because the catalogue serves them; this one is not in the catalogue at all:
                       DocumentManagementManifestProvider declares no page for /DocumentManagementReconciliation, so
                       deleting this <li> would remove Mutabakat from the sidebar entirely (the route keeps working,
                       nobody can find it). Owner: the document-management module owner, via the manifest.
                       REMOVAL CONDITION (measurable, not a TODO): delete this block once
                         rg -n "DocumentManagementReconciliation" \
                           services/Diten.Platform/src/Diten.Platform.Application/Features/DocumentManagement/SelfRegistration/DocumentManagementManifestProvider.cs
                       returns a page with IsNavigationVisible: true, AND that page is observed in the tenant
                       sidebar under the Doküman Yönetimi group. Manifest alone is not enough — measure the menu. *@
                    @if (Perms.Has("platform.document-management.qms-baselines.view"))
                    {
                        <li class="menu-item @(activeController == "DocumentManagementReconciliation" ? "active" : "")">
                            <a href="/DocumentManagementReconciliation" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-git-compare"></i>
                                <div>@SharedLocalizer["Reconciliation"]</div>
                            </a>
                        </li>
                    }

                    @* FIX-CLEANUP-BATCH — Access Governance AND Tenant Settings (Security Settings /TenantSecurity +
                       Menu Settings /TenantNavigation) are now rendered DATA-DRIVEN by the DynamicModuleMenu below
                       (ACCESS-GOVERNANCE + TENANT-SETTINGS baseline modules, both permission-gated per descriptor).
                       The hardcoded Tenant Settings bridge <li>s were removed to stop the menu showing them twice. *@
                    @* BL-060 — STILL HAND-WRITTEN. Employee Drafts is not a duplicate: HCM has NO module row in the
                       module catalogue at all (no manifest, therefore no page descriptor and no domain group), so
                       this header + link are the only way the page is reachable from the sidebar. Owner: the HCM
                       module owner — NOT this layout, and not the document-management manifest.
                       REMOVAL CONDITION (measurable, not a TODO): delete this whole @if block once
                         rg -rn "HCM/Employees/Create" --glob "*ManifestProvider.cs" services/
                       returns a nav-visible page, AND that page is observed in the tenant sidebar under an HCM
                       domain group. Until then, deleting it hides a working page from every user. *@
                    @if (canAccessHcmEmployeeDraft)
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">@SharedLocalizer["HumanCapitalManagement"]</span>
                        </li>
                        <li class="menu-item @(currentPath.StartsWith("/HCM/Employees", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a href="/HCM/Employees/Create" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-id-card"></i>
                                <div>@SharedLocalizer["EmployeeDraftsMenu"]</div>
                            </a>
                        </li>
                    @* ══ LEGACY-NAV-END ═══════════════════════════════════════════════════════════════════ *@
                    }

                    @* MOD-0285 — dynamic "Modules" section (AUGMENT). Self-registered/entitled modules whose page
                       descriptors are navigation-visible render here automatically — no hand-edited <li> above.
                       Server-side ViewComponent (HttpOnly token, no client flash); best-effort: empty if the
                       navigation endpoint is unreachable, leaving the hardcoded sections above intact. *@
                    @await Component.InvokeAsync("DynamicModuleMenu")
                </ul>
            </aside>
            <!-- / Menu -->


            <!-- Layout container -->
            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme"
