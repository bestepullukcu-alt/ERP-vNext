    var canReadLearningTraining = Perms.Has("hcm.learning-training.read");
    var canReadSuccession = Perms.Has("hcm.succession.read");
    var canReadWorkforcePlanning = Perms.Has("hcm.workforce-planning.read");
    var canReadHeadcountBudget = Perms.Has("hcm.headcount-budget.read");
    var canReadHrKpiAnalytics = Perms.Has("hcm.hr-kpi-analytics.read");
    var canReadHrDocumentation = Perms.Has("hcm.hr-documentation.read");
    var canReadTimeAttendanceLeave = Perms.Has("hcm.time-attendance-leave.read");
