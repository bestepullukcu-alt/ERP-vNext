@using System.Security.Claims
@using System.Text.Json
@using Diten.Web.Security
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    var currentUser = User?.Identity?.IsAuthenticated == true
        ? new
        {
            id = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? User.FindFirst("sub")?.Value,
            email = User.FindFirst(ClaimTypes.Email)?.Value ?? User.FindFirst("email")?.Value,
            firstName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? string.Empty,
            lastName = User.FindFirst(ClaimTypes.Surname)?.Value ?? string.Empty,
            roles = User.FindAll(ClaimTypes.Role)
                .Select(claim => claim.Value)
                .Concat(User.FindAll("role").Select(claim => claim.Value))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            tenantId = User.FindFirst("tenant_id")?.Value ?? User.FindFirst("tenantId")?.Value,
            actorType = User.FindFirst("actor_type")?.Value
        }
        : null;
    var currentUserJson = JsonSerializer.Serialize(currentUser);
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName;
    var layoutDirection = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase) ? "rtl" : "ltr";
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var canReadReferenceData = PermissionClaims.HasPermission(User, "Platform.BusinessReferenceData.Read");
    var canReadOrganizationDirectory = Perms.Has("platform.organization-units.read")
        || Perms.Has("platform.positions.read")
        || Perms.Has("platform.position-assignments.read");
    var canReadHrisSources = Perms.Has("platform.hris-sources.read");
    var canReadTimeAttendanceProviders = Perms.Has("platform.time-attendance-providers.read");
    var canReadPayrollIntegrationGovernance = Perms.Has("platform.payroll-integration-governance.read");
    var canReadPayrollSources = Perms.Has("platform.payroll-sources.read");
    var canReadEmployeeProjections = Perms.Has("hcm.employee-projections.read");
    var canReadSensitiveAccess = Perms.Has("hcm.sensitive-access.read");
    var canReadPositionAssignments = Perms.Has("hcm.position-assignments.read");
    var canReadOffboardingCases = Perms.Has("hcm.offboarding.read");
    var canReadApplicantIntake = Perms.Has("hcm.applicant-intake.read");
    var canReadCandidatePipeline = Perms.Has("hcm.candidate-pipeline.read");
    var canReadOfferManagement = Perms.Has("hcm.offer-management.read");
    var canReadEmployeeOnboarding = Perms.Has("hcm.employee-onboarding.read");
    var canReadEmploymentChanges = Perms.Has("hcm.employment-changes.read");
