                                </a>
                                <ul class="dropdown-menu dropdown-menu-end wc-lang-menu">
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-1" href="?culture=en"
                                            data-language="en"><span
                                                class="fi fi-gb fis rounded-circle wc-lang-flag"></span><span>English</span></a>
                                    </li>
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-1" href="?culture=fr"
                                            data-language="fr"><span
                                                class="fi fi-fr fis rounded-circle wc-lang-flag"></span><span>Français</span></a>
                                    </li>
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-1" href="?culture=es"
                                            data-language="es"><span
                                                class="fi fi-es fis rounded-circle wc-lang-flag"></span><span>Español</span></a>
                                    </li>
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-1" href="?culture=zh"
