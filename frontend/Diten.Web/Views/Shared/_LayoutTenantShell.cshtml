@using System.Security.Claims
@using System.Text.Json
@using Diten.Web.Security
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    var currentUser = User?.Identity?.IsAuthenticated == true
        ? new
        {
            id = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? User.FindFirst("sub")?.Value,
            email = User.FindFirst(ClaimTypes.Email)?.Value ?? User.FindFirst("email")?.Value,
            firstName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? string.Empty,
            lastName = User.FindFirst(ClaimTypes.Surname)?.Value ?? string.Empty,
            roles = User.FindAll(ClaimTypes.Role)
                .Select(claim => claim.Value)
                .Concat(User.FindAll("role").Select(claim => claim.Value))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            tenantId = User.FindFirst("tenant_id")?.Value ?? User.FindFirst("tenantId")?.Value,
            actorType = User.FindFirst("actor_type")?.Value
        }
        : null;
    var currentUserJson = JsonSerializer.Serialize(currentUser);
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName;
    var layoutDirection = string.Equals(currentCulture, "ar", StringComparison.OrdinalIgnoreCase) ? "rtl" : "ltr";
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var canReadReferenceData = PermissionClaims.HasPermission(User, "Platform.BusinessReferenceData.Read");
}
<!DOCTYPE html>

<html lang="@currentCulture" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="@layoutDirection" data-skin="default"
    data-assets-path="/assets/" data-template="vertical-menu-template" data-bs-theme="light" data-semidark-menu="false"
    data-shell="tenant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>@ViewData["Title"] - Di10</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/assets/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
        rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet" href="~/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="~/assets/vendor/fonts/fontawesome.css" />
    <link rel="stylesheet" href="~/assets/vendor/fonts/flag-icons.css" />

    <link rel="stylesheet" href="~/assets/vendor/css/core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/demo.css" asp-append-version="true" />

    <!-- Vendor CSS (Global essentials only) -->
    <link rel="stylesheet" href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/typeahead-js/typeahead.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/notyf/notyf.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/animate-css/animate.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/pickr/pickr-themes.css" />

    <!-- DataTables Vendor CSS -->
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-colreorder-bs5/colReorder.dataTables.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />

    <!-- Custom CSS (Loaded last to override vendors) -->
    <link rel="stylesheet" href="~/assets/css/backbone-custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Helpers -->
    <script src="~/assets/vendor/js/helpers.js"></script>
    <script src="~/assets/vendor/libs/pickr/pickr.js"></script>
    <script src="~/assets/vendor/js/template-customizer.js"></script>
    <script>
        window.ApiBaseUrl = window.location.protocol + "//" + window.location.hostname + ":5000";
        window.API = {
            mdm: window.ApiBaseUrl,
            deven: window.ApiBaseUrl,
            auth: window.ApiBaseUrl,
            platform: window.ApiBaseUrl
        };
        window.CurrentLanguage = "@currentCulture";
        window.CurrentUser = @Html.Raw(currentUserJson);
        window.CurrentShell = "tenant";
    </script>
    <script>
        (function () {
            try {
                // Pre-render state normalization to prevent FOUC (Flash of Unstyled Content)
                var template = "vertical-menu-template";
                var themeKey = "templateCustomizer-" + template + "--Theme";
                var layoutKey = "templateCustomizer-" + template + "--LayoutCollapsed";
                
                var storedTheme = window.localStorage.getItem(themeKey);
                var isCollapsed = window.localStorage.getItem(layoutKey) === "true";

                if (storedTheme) {
                    var resolvedTheme = storedTheme === "system"
                        ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
                        : storedTheme;
                    document.documentElement.setAttribute("data-bs-theme", resolvedTheme);
                }

                if (isCollapsed) {
                    document.documentElement.classList.add("layout-menu-collapsed");
                }
            } catch (_) { }
        })();
    </script>
    <script src="~/assets/js/config.js" asp-append-version="true"></script>

    <script>
        window.L10n = {
            RequiredProgressText: "@SharedLocalizer["RequiredStatus"].Value",
            ValidationErrorsText: "@SharedLocalizer["ValidationErrors"].Value",
            LoginErrorTitle: "@SharedLocalizer["Login.ErrorTitle"].Value",
            LoginErrorRequired: "@SharedLocalizer["Login.ErrorRequired"].Value",
            LoginSubmit: "@SharedLocalizer["Login.Submit"].Value",
            User: "@SharedLocalizer["User"].Value",
            AreYouSure: "@SharedLocalizer["AreYouSure"].Value"
        };

        // Template normalization
        window.L10n.RequiredProgressText = window.L10n.RequiredProgressText.replace("{{0}}", "{0}").replace("{{1}}", "{1}");
        window.L10n.ValidationErrorsText = window.L10n.ValidationErrorsText.replace("{{0}}", "{0}");

        // ShellAccessFilter enforces auth redirects server-side.
    </script>
    <style>
        /* Prevent Flash of Unstyled Content (FOUC) and layout shifts */
        .layout-menu:not(.initialized) .menu-inner { opacity: 0; }
        .menu-vertical .menu-header { transition: none !important; }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('layout-menu')?.classList.add('initialized');
        });
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <!-- Menu (Sidebar) -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a href="/" class="app-brand-link">
                        <span class="app-brand-logo demo">
                            <i class="bx bx-buildings text-primary fs-2"></i>
                        </span>
                        <span class="app-brand-text demo menu-text fw-bold ms-2">Di10</span>
                    </a>
                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="icon-base bx bx-chevron-left"></i>
                    </a>
                </div>

                <div class="menu-inner-shadow"></div>

                <ul class="menu-inner py-1">
                    <!-- Workspace Section -->
                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">@SharedLocalizer["Workspace"]</span>
                    </li>
                    <li class="menu-item @(activeController == "WorkCenter" ? "active" : "")">
                        <a href="/WorkCenter" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-briefcase-alt-2"></i>
                            <div>@SharedLocalizer["WorkCenterMenu"]</div>
                        </a>
                    </li>
                    @if (canReadReferenceData)
                    {
                        <li class="menu-item @(currentPath.StartsWith("/Platform/ReferenceData", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <a href="/Platform/ReferenceData" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-data"></i>
                                <div>@SharedLocalizer["ReferenceDataMenu"]</div>
                            </a>
                        </li>
                    }

                    <!-- Developer Sandbox -->
                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">@SharedLocalizer["DeveloperSandbox"]</span>
                    </li>
                    @if (Perms.Has("goldenslim.records.read"))
                    {
                        <li class="menu-item @(activeController == "GoldenReferenceSlim" ? "active" : "")">
                            <a href="/GoldenReferenceSlim" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-star"></i>
                                <div>@SharedLocalizer["GoldenSlim"]</div>
                            </a>
                        </li>
                    }
                    <li class="menu-item @(activeController == "GoldenReferenceCompact" ? "active" : "")">
                        <a href="/GoldenReferenceCompact" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-collection"></i>
                            <div>@SharedLocalizer["GoldenCompact"]</div>
                        </a>
                    </li>

                    @* S-NAV (MOD-0018-FU9) — Access Governance (FE-C). FE-B UX guard: a link shows only
                       when the user holds the matching read/assign permission; backend is authoritative. *@
                    @if (Perms.Has("auth.users.read") || Perms.Has("auth.roles.read")
                         || Perms.Has("auth.roles.assign-permission") || Perms.Has("auth.users.assign-role"))
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">@SharedLocalizer["AccessGovernance"]</span>
                        </li>
                        @if (Perms.Has("auth.users.read"))
                        {
                            <li class="menu-item @(activeController == "Users" ? "active" : "")">
                                <a href="/Users" class="menu-link">
                                    <i class="menu-icon tf-icons bx bx-user"></i>
                                    <div>@SharedLocalizer["UsersMenu"]</div>
                                </a>
                            </li>
                        }
                        @if (Perms.Has("auth.roles.read"))
                        {
                            <li class="menu-item @(activeController == "Roles" ? "active" : "")">
                                <a href="/Roles" class="menu-link">
                                    <i class="menu-icon tf-icons bx bx-shield-quarter"></i>
                                    <div>@SharedLocalizer["RolesMenu"]</div>
                                </a>
                            </li>
                            <li class="menu-item @(activeController == "Permissions" ? "active" : "")">
                                <a href="/Permissions" class="menu-link">
                                    <i class="menu-icon tf-icons bx bx-key"></i>
                                    <div>@SharedLocalizer["PermissionsMenu"]</div>
                                </a>
                            </li>
                        }
                        @if (Perms.Has("auth.roles.assign-permission"))
                        {
                            <li class="menu-item @(activeController == "RoleAssignments" ? "active" : "")">
                                <a href="/RoleAssignments" class="menu-link">
                                    <i class="menu-icon tf-icons bx bx-link"></i>
                                    <div>@SharedLocalizer["RolePermissionAssignmentMenu"]</div>
                                </a>
                            </li>
                        }
                        @if (Perms.Has("auth.users.assign-role"))
                        {
                            <li class="menu-item @(activeController == "UserRoleAssignments" ? "active" : "")">
                                <a href="/UserRoleAssignments" class="menu-link">
                                    <i class="menu-icon tf-icons bx bx-user-plus"></i>
                                    <div>@SharedLocalizer["UserRoleAssignmentMenu"]</div>
                                </a>
                            </li>
                        }
                    }

                    @* MOD-0220 — Master Data (tenant-side). Legal Entities feed the Organization Units form. *@
                    @if (Perms.Has("mdm.legal-entities.read"))
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">@SharedLocalizer["MasterData"]</span>
                        </li>
                        <li class="menu-item @(activeController == "LegalEntities" ? "active" : "")">
                            <a href="/LegalEntities" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-buildings"></i>
                                <div>@SharedLocalizer["LegalEntities"]</div>
                            </a>
                        </li>
                    }

                    @* MOD-0288 — Organization, Person & Position Directory (relocated to the tenant shell).
                       Each item is gated by its backend .read permission (UX-only show/hide; [HasPermission]
                       remains authoritative). *@
                    @if (Perms.Has("platform.organization-units.read") || Perms.Has("platform.positions.read") || Perms.Has("platform.position-assignments.read"))
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">@SharedLocalizer["Organization"]</span>
                        </li>
                        @if (Perms.Has("platform.organization-units.read"))
                        {
                            <li class="menu-item @(activeController == "OrganizationUnits" ? "active" : "")">
                                <a href="/OrganizationUnits" class="menu-link">
                                    <i class="menu-icon tf-icons bx bx-sitemap"></i>
                                    <div>@SharedLocalizer["OrganizationUnits"]</div>
                                </a>
                            </li>
                        }
                        @if (Perms.Has("platform.positions.read"))
                        {
                            <li class="menu-item @(activeController == "Positions" ? "active" : "")">
                                <a href="/Positions" class="menu-link">
                                    <i class="menu-icon tf-icons bx bx-id-card"></i>
                                    <div>@SharedLocalizer["Positions"]</div>
                                </a>
                            </li>
                        }
                        @if (Perms.Has("platform.position-assignments.read"))
                        {
                            <li class="menu-item @(activeController == "PositionAssignments" ? "active" : "")">
                                <a href="/PositionAssignments" class="menu-link">
                                    <i class="menu-icon tf-icons bx bx-user-pin"></i>
                                    <div>@SharedLocalizer["PositionAssignments"]</div>
                                </a>
                            </li>
                        }
                    }

                    @* MOD-0285 — dynamic "Modules" section (AUGMENT). Self-registered/entitled modules whose page
                       descriptors are navigation-visible render here automatically — no hand-edited <li> above.
                       Server-side ViewComponent (HttpOnly token, no client flash); best-effort: empty if the
                       navigation endpoint is unreachable, leaving the hardcoded sections above intact. *@
                    @await Component.InvokeAsync("DynamicModuleMenu")
                </ul>
            </aside>
            <!-- / Menu -->


            <!-- Layout container -->
            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme"
                    id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                            <i class="icon-base bx bx-menu icon-md"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
                        <!-- Search -->
                        <div class="navbar-nav align-items-center">
                            <div class="nav-item navbar-search-wrapper mb-0">
                                <a class="nav-item nav-link search-toggler px-0" href="javascript:void(0);">
                                    <span class="d-inline-block text-body-secondary fw-normal" id="autocomplete"></span>
                                </a>
                            </div>
                        </div>
                        <!-- /Search -->

                        <ul class="navbar-nav flex-row align-items-center ms-md-auto">
