                            <div>Tenant Management</div>
                        </a>
                    </li>
                    <li class="menu-item @(activeController == "SubscriptionPlans" ? "active" : "")">
                        <a href="/Platform/SubscriptionPlans" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-credit-card"></i>
                            <div>@SharedLocalizer["SubscriptionPlans"]</div>
                        </a>
                    </li>
                    <li class="menu-item @(activeController == "SubscriptionFeatures" ? "active" : "")">
                        <a href="/Platform/SubscriptionFeatures" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-package"></i>
                            <div>@SharedLocalizer["SubscriptionFeatures"]</div>
                        </a>
                    </li>
                    <li class="menu-item @(activeController == "ModuleCatalog" ? "active" : "")">
                        <a href="/Platform/ModuleCatalog" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-grid-alt"></i>
                            <div>@SharedLocalizer["ModuleCatalog"]</div>
                        </a>
                    </li>
                    <li class="menu-item @(activeController == "DomainManagement" ? "active" : "")">
                        <a href="/Platform/DomainManagement" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-category"></i>
                            <div>@SharedLocalizer["DomainManagement"]</div>
                        </a>
                    </li>
                    <li class="menu-item @(activeController == "ServiceManagement" ? "active" : "")">
                        <a href="/Platform/ServiceManagement" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-server"></i>
                            <div>@SharedLocalizer["ServiceManagement"]</div>
                        </a>
                    </li>
                    <li class="menu-item @(activeController == "InterfaceRegistry" ? "active" : "")">
                        <a href="/Platform/InterfaceRegistry" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-git-branch"></i>
                            <div>@SharedLocalizer["InterfaceRegistry"]</div>
                        </a>
                    </li>
                    <li class="menu-item @(activeController == "Administrators" ? "active" : "")">
                        <a href="/Platform/Administrators" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-user-check"></i>
                            <div>@SharedLocalizer["PlatformAdministrators"]</div>
                        </a>
                    </li>
                    <li class="menu-item @(currentPath.StartsWith("/Platform/AuditLog", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        <a href="/Platform/AuditLog" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-history"></i>
                            <div>@AuditLogLocalizer["AuditLog.Title"]</div>
                        </a>
                    </li>
                    <li class="menu-item @(currentPath.StartsWith("/Platform/AuditRetention", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        <a href="/Platform/AuditRetention" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-shield-quarter"></i>
                            <div>@AuditRetentionLocalizer["AuditRetention.Title"]</div>
                        </a>
                    </li>
                    @* S-NAV (MOD-0018-FU9) — FE-E self effective access *@
                    <li class="menu-item @(currentPath.StartsWith("/Platform/SelfAccess", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        <a href="/Platform/SelfAccess" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-user-check"></i>
                            <div>@SharedLocalizer["SelfAccessMenu"]</div>
                        </a>
                    </li>
                </ul>
            </aside>

            <div class="menu-mobile-toggler d-xl-none rounded-1">
                <a href="javascript:void(0);"
                    class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1">
                    <i class="icon-base bx bx-menu"></i>
                    <i class="icon-base bx bx-chevron-right"></i>
                </a>
            </div>

            <!-- Layout container -->
            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme"
                    id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                            <i class="icon-base bx bx-menu icon-md"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
                        <!-- Search -->
                        <div class="navbar-nav flex-row align-items-center">
                            <div class="nav-item navbar-search-wrapper mb-0">
                                <a class="nav-item nav-link search-toggler px-0" href="javascript:void(0);">
                                    <span class="d-inline-block text-body-secondary fw-normal" id="autocomplete"></span>
                                </a>
                            </div>
                            <span class="badge bg-label-primary text-uppercase platform-admin-shell-badge">@SharedLocalizer["Admin"]</span>
                        </div>
                        <!-- /Search -->

                        <ul class="navbar-nav flex-row align-items-center ms-md-auto gap-2">
                            <!-- Language -->
                            <li class="nav-item dropdown-language dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);"
                                    data-bs-toggle="dropdown">
                                    <i class="icon-base bx bx-globe icon-md"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end wc-lang-menu">
                                    <li><a class="dropdown-item d-flex align-items-center" href="?culture=en"
                                            data-language="en"><span
                                                class="fi fi-gb fis rounded-circle wc-lang-flag me-3"></span>English</a>
                                    </li>
                                    <li><a class="dropdown-item d-flex align-items-center" href="?culture=tr"
                                            data-language="tr"><span
                                                class="fi fi-tr fis rounded-circle wc-lang-flag me-3"></span>Türkçe</a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Style Switcher -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow" id="nav-theme" href="javascript:void(0);"
                                    data-bs-toggle="dropdown">
                                    <i class="icon-base bx bx-sun icon-md theme-icon-active"></i>
                                    <span class="d-none ms-2" id="nav-theme-text">Toggle theme</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="nav-theme-text">
                                    <li>
                                        <button type="button" class="dropdown-item d-flex align-items-center active"
                                            data-bs-theme-value="light">
                                            <i class="icon-base bx bx-sun icon-md me-3"
                                                data-icon="sun"></i>@SharedLocalizer["Light"]
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item d-flex align-items-center"
                                            data-bs-theme-value="dark">
                                            <i class="icon-base bx bx-moon icon-md me-3"
                                                data-icon="moon"></i>@SharedLocalizer["Dark"]
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item d-flex align-items-center"
                                            data-bs-theme-value="system">
                                            <i class="icon-base bx bx-desktop icon-md me-3"
                                                data-icon="desktop"></i>System
                                        </button>
                                    </li>
                                </ul>
                            </li>



                            <!-- User -->
                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);"
                                    data-bs-toggle="dropdown">
                                    <div class="avatar avatar-online">
                                        <span class="avatar-initial rounded-circle bg-label-primary fw-semibold"
                                            data-platform-account-avatar>@currentUserInitials</span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="/Platform/Account/Profile">
                                            <div class="d-flex">
                                                <div class="flex-shrink-0 me-3">
                                                    <div class="avatar avatar-online">
                                                        <span
                                                            class="avatar-initial rounded-circle bg-label-primary fw-semibold"
                                                            data-platform-account-avatar>@currentUserInitials</span>
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-0" id="navbar-user-name">@(currentUserDisplayName ?? "User")</h6>
                                                    <small class="text-body-secondary"
                                                        id="navbar-user-role">@currentUserRoleLabel</small>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider my-1"></div>
                                    </li>
                                    <li>
