                    <a href="/Platform/Tenants" class="app-brand-link">
                        <span class="app-brand-logo demo platform-admin-brand-icon">
                            <img class="platform-brand-icon platform-brand-icon-light"
                                src="~/assets/img/branding/platform-icon-light.png" alt="Diten icon"
                                asp-append-version="true" />
                            <img class="platform-brand-icon platform-brand-icon-dark"
                                src="~/assets/img/branding/platform-icon-dark.png" alt="Diten icon"
                                asp-append-version="true" />
                        </span>
                        <span class="platform-admin-brand-logo ms-2">
                            <img class="platform-brand-logo platform-brand-logo-light"
                                src="~/assets/img/branding/platform-logo-light.png" alt="Di10 Enterprise Solutions"
                                asp-append-version="true" />
                            <img class="platform-brand-logo platform-brand-logo-dark"
                                src="~/assets/img/branding/platform-logo-dark.png" alt="Di10 Enterprise Solutions"
                                asp-append-version="true" />
                        </span>
                    </a>
                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="icon-base bx bx-chevron-left"></i>
                    </a>
                </div>

                <div class="menu-inner-shadow"></div>

                <ul class="menu-inner py-1">
                    <!-- Platform Administration -->
                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">@SharedLocalizer["PlatformAdministration"]</span>
                    </li>
                    <li class="menu-item @(activeController == "Tenants" ? "active" : "")">
                        <a href="/Platform/Tenants" class="menu-link">
