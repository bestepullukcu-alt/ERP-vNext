                    <!-- Footer -->
                    <footer class="content-footer footer bg-footer-theme">
                        <div
                            class="container-xxl d-flex flex-wrap justify-content-between py-2 flex-md-row flex-column">
                            <div class="mb-2 mb-md-0">
                                © 2026 | <span class="fw-medium">Di10 ERP — Admin Console</span>
                            </div>
                        </div>
                    </footer>
                </div>
            </div>
        </div>
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>

    <!-- Core JS -->
    <script src="~/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/assets/vendor/js/bootstrap.js"></script>
    <script src="~/assets/vendor/libs/@@algolia/autocomplete-js.js"></script>
    <script src="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/assets/vendor/js/menu.js"></script>
    <script src="~/assets/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/assets/vendor/libs/select2/select2.js"></script>
    <script src="~/assets/vendor/libs/notyf/notyf.js"></script>

    <!-- DataTable Vendor -->
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/datatables-buttons/buttons.colVis.js"></script>
    <script src="~/assets/vendor/libs/datatables-colreorder-bs5/dataTables.colReorder.min.js"></script>
    <script src="~/assets/js/dt-defaults.js" asp-append-version="true"></script>
    <script src="~/assets/js/diten-datatable.js" asp-append-version="true"></script>
    <script src="~/assets/js/personalization-client.js" asp-append-version="true"></script>

    <!-- Main JS -->
    <script src="~/assets/js/main.js"></script>

    <script src="~/assets/js/custom/required-fields-tracker.js" asp-append-version="true"></script>

    <partial name="/Views/Shared/_GlobalConfirmation.cshtml" />
    <partial name="/Views/Shared/_GlobalNotification.cshtml" />

    <script>
        window.BackboneShellTempData = {
            successMessage: @Json.Serialize(TempData["SuccessMessage"]?.ToString()),
            errorMessage: @Json.Serialize(TempData["ErrorMessage"]?.ToString())
        };
    </script>
    <script src="~/assets/js/backbone-shell.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
