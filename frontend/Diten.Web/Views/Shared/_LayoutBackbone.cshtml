@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
<!DOCTYPE html>

<html lang="en" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr" data-skin="default"
    data-assets-path="/assets/" data-template="vertical-menu-template" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>@ViewData["Title"] - Di10</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/assets/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
        rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet" href="~/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="~/assets/vendor/fonts/fontawesome.css" />
    <link rel="stylesheet" href="~/assets/vendor/fonts/flag-icons.css" />

    <link rel="stylesheet" href="~/assets/vendor/css/core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/demo.css" asp-append-version="true" />

    <!-- Vendor CSS (Global essentials only) -->
    <link rel="stylesheet" href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/typeahead-js/typeahead.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/notyf/notyf.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/animate-css/animate.css" />

    <!-- DataTables Vendor CSS -->
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />

    <!-- Custom CSS (Loaded last to override vendors) -->
    <link rel="stylesheet" href="~/assets/css/backbone-custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Helpers -->
    <script src="~/assets/vendor/js/helpers.js"></script>
    <script src="~/assets/vendor/js/template-customizer.js"></script>
    <script src="~/assets/js/config.js"></script>

    <script>
        window.ApiBaseUrl = window.location.protocol + "//" + window.location.hostname + ":5000";

        // Global Localization for Features
        window.L10n = {
            RequiredProgressText: "@SharedLocalizer["RequiredStatus"].Value",
            ValidationErrorsText: "@SharedLocalizer["ValidationErrors"].Value",
            LoginErrorTitle: "@SharedLocalizer["Login.ErrorTitle"].Value",
            LoginErrorRequired: "@SharedLocalizer["Login.ErrorRequired"].Value",
            LoginSubmit: "@SharedLocalizer["Login.Submit"].Value"
        };

        // Template normalization
        window.L10n.RequiredProgressText = window.L10n.RequiredProgressText.replace("{{0}}", "{0}").replace("{{1}}", "{1}");
        window.L10n.ValidationErrorsText = window.L10n.ValidationErrorsText.replace("{{0}}", "{0}");

        // Token Validation
        (function checkAuth() {
            const hasToken = document.cookie.split(';').some((item) => item.trim().startsWith('access_token='));
            if (!hasToken && !window.location.pathname.startsWith('/account/')) {
                window.location.href = "/account/login?returnUrl=" + encodeURIComponent(window.location.pathname);
            }
        })();
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <!-- Menu (Sidebar) -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a href="/" class="app-brand-link">
                        <span class="app-brand-text demo menu-text fw-bold ms-2">Di10</span>
                    </a>
                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="bx bx-chevron-left icon-base"></i>
                    </a>
                </div>

                <div class="menu-inner-shadow"></div>

                <ul class="menu-inner py-1">
                    <!-- MDM -->
                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">@SharedLocalizer["MDM"]</span>
                    </li>
                    <li class="menu-item active">
                        <a href="/LegalEntities" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-building"></i>
                            <div>@SharedLocalizer["LegalEntities"]</div>
                        </a>
                    </li>
                    <!-- THEME SANDBOX (TEST PAGES) -->
                    <li class="menu-header small text-uppercase mt-4">
                        <span class="menu-header-text">Theme Sandbox</span>
                    </li>
                    <li class="menu-item bg-label-warning rounded mx-2">
                        <a href="/ThemeSandbox/UserList" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-test-tube text-warning"></i>
                            <div class="text-warning">User List (Table)</div>
                        </a>
                    </li>
                    <li class="menu-item bg-label-warning rounded mx-2 mt-1">
                        <a href="/ThemeSandbox/ProductAdd" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-test-tube text-warning"></i>
                            <div class="text-warning">Product Add (Forms)</div>
                        </a>
                    </li>
                    <li class="menu-item bg-label-warning rounded mx-2 mt-1">
                        <a href="/ThemeSandbox/Analytics" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-test-tube text-warning"></i>
                            <div class="text-warning">Analytics (Grid)</div>
                        </a>
                    </li>
                </ul>
            </aside>

            <!-- Layout container -->
            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme"
                    id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                            <i class="bx bx-menu icon-md"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
                        <ul class="navbar-nav flex-row align-items-center ms-md-auto">
                            <!-- Language -->
                            <li class="nav-item dropdown-language dropdown me-2 me-xl-0">
                                <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);"
                                    data-bs-toggle="dropdown">
                                    <i class="bx bx-globe icon-md"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="?culture=en"
                                            data-language="en"><span>English</span></a></li>
                                    <li><a class="dropdown-item" href="?culture=tr"
                                            data-language="tr"><span>Türkçe</span></a></li>
                                    <li><a class="dropdown-item" href="?culture=es"
                                            data-language="es"><span>Español</span></a></li>
                                    <li><a class="dropdown-item" href="?culture=ru"
                                            data-language="ru"><span>Русский</span></a></li>
                                    <li><a class="dropdown-item" href="?culture=uk"
                                            data-language="uk"><span>Українська</span></a></li>
                                    <li><a class="dropdown-item" href="?culture=ka"
                                            data-language="ka"><span>ქართული</span></a></li>
                                    <li><a class="dropdown-item" href="?culture=kk"
                                            data-language="kk"><span>Қазақша</span></a></li>
                                    <li><a class="dropdown-item" href="?culture=uz"
                                            data-language="uz"><span>O'zbekcha</span></a></li>
                                </ul>
                            </li>

                            <!-- Style Switcher -->
                            <li class="nav-item dropdown me-2 me-xl-0">
                                <a class="nav-link dropdown-toggle hide-arrow" id="nav-theme" href="javascript:void(0);"
                                    data-bs-toggle="dropdown">
                                    <i class="bx bx-sun icon-md theme-icon-active"></i>
                                    <span class="d-none ms-2" id="nav-theme-text">Toggle theme</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="nav-theme-text">
                                    <li>
                                        <button type="button" class="dropdown-item d-flex align-items-center active"
                                            data-bs-theme-value="light">
                                            <i class="bx bx-sun me-3"></i><span>@SharedLocalizer["Light"]</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item d-flex align-items-center"
                                            data-bs-theme-value="dark">
                                            <i class="bx bx-moon me-3"></i><span>@SharedLocalizer["Dark"]</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item d-flex align-items-center"
                                            data-bs-theme-value="system">
                                            <i class="bx bx-desktop me-3"></i><span>Sistem</span>
                                        </button>
                                    </li>
                                </ul>
                            </li>

                            <!-- User -->
                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);"
                                    data-bs-toggle="dropdown">
                                    <div class="avatar avatar-online">
                                        <img src="~/assets/img/avatars/1.png" class="rounded-circle" />
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <div class="dropdown-item">
                                            <div class="d-flex">
                                                <div class="flex-shrink-0 me-3">
                                                    <div class="avatar avatar-online">
                                                        <img src="~/assets/img/avatars/1.png" class="rounded-circle" />
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <span class="fw-medium d-block" id="navbar-user-name">User</span>
                                                    <small class="text-muted" id="navbar-user-role">Role</small>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                    <li><a class="dropdown-item" href="javascript:void(0);"><i
                                                class="bx bx-user me-2"></i>@SharedLocalizer["MyProfile"]</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);"><i
                                                class="bx bx-cog me-2"></i>@SharedLocalizer["Settings"]</a></li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                    <li><a class="dropdown-item" href="/account/logout"><i
                                                class="bx bx-power-off me-2"></i>@SharedLocalizer["LogOut"]</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>

                <!-- Content wrapper -->
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        @RenderBody()
                    </div>

                    <!-- Footer -->
                    <footer class="content-footer footer bg-footer-theme">
                        <div
                            class="container-xxl d-flex flex-wrap justify-content-between py-2 flex-md-row flex-column">
                            <div class="mb-2 mb-md-0">
                                © 2026 | Di10 ERP
                            </div>
                        </div>
                    </footer>
                </div>
            </div>
        </div>
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>

    <!-- Core JS -->
    <script src="~/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/assets/vendor/js/bootstrap.js"></script>
    <script src="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/assets/vendor/js/menu.js"></script>
    <script src="~/assets/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/assets/vendor/libs/select2/select2.js"></script>

    <!-- DataTable Vendor -->
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/datatables-buttons/buttons.colVis.js"></script>
    <script src="~/assets/js/dt-defaults.js"></script>

    <!-- Main JS -->
    <script src="~/assets/js/main.js"></script>

    <script>
        // Set User Display Info
        (function initDisplay() {
            const user = JSON.parse(localStorage.getItem('user') || '{}');
            if (user && user.firstName) {
                document.getElementById('navbar-user-name').textContent = user.firstName + ' ' + user.lastName;
                document.getElementById('navbar-user-role').textContent = (user.roles && user.roles.length > 0) ? user.roles[0] : 'User';
            }
        })();

        // Language Persistence
        document.querySelectorAll('.dropdown-language .dropdown-item').forEach(item => {
            item.addEventListener('click', function () {
                var lang = this.getAttribute('data-language');
                if (lang) {
                    document.cookie = ".AspNetCore.Culture=c=" + lang + "|uic=" + lang + ";path=/;max-age=31536000";
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
