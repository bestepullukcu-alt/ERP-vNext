@model Diten.Web.ViewModels.Shared.StatCardModel
@* FEAT-ROLEPERMS-REDESIGN — reusable stat card. Theme-only (avatar + bg-label utility + var-driven .stat-card);
   the value is a live slot JS updates by id. Render inside a Bootstrap grid column. *@
<div class="card h-100 stat-card">
    <div class="card-body p-3 d-flex align-items-center gap-3">
        <span class="avatar avatar-sm flex-shrink-0">
            <span class="avatar-initial rounded bg-label-@Model.Tone"><i class="bx @Model.Icon"></i></span>
        </span>
        <div class="min-w-0">
            <h5 class="mb-0 stat-card-value font-monospace" id="@Model.ValueId">@Model.Value</h5>
            <small class="text-muted d-block text-truncate">@Model.Label</small>
        </div>
    </div>
</div>
