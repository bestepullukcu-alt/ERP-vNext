@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="card mb-4">
    <div class="card-header p-3">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="nav-align-top">
                <ul class="nav nav-pills d-inline-flex flex-wrap gap-2" role="tablist">
                    <li class="nav-item mb-1 mb-sm-0" role="presentation">
                        <a class="nav-link small border shadow-none wc-tab-compact @(controller == "Items" ? "active" : "")" href="/Items">
                            <span class="d-inline-flex align-items-center">
                                <i class="bx bx-package me-1 wc-tab-icon"></i>@SharedLocalizer["ItemMaster"]
                            </span>
                        </a>
                    </li>
                    <li class="nav-item mb-1 mb-sm-0" role="presentation">
                        <a class="nav-link small border shadow-none wc-tab-compact @(controller == "ItemCategories" ? "active" : "")" href="/ItemCategories">
                            <span class="d-inline-flex align-items-center">
                                <i class="bx bx-category-alt me-1 wc-tab-icon"></i>@SharedLocalizer["CategoryManagement"]
                            </span>
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link small border shadow-none wc-tab-compact @(controller == "ItemVariantModels" ? "active" : "")" href="/ItemVariantModels">
                            <span class="d-inline-flex align-items-center">
                                <i class="bx bx-slider-alt me-1 wc-tab-icon"></i>@SharedLocalizer["VariantManagement"]
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
