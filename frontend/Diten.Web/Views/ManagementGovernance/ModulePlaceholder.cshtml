@using Diten.Web.Config
@model Diten.Web.Models.ManagementGovernance.ManagementGovernancePageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    var moduleId = Context.Request.RouteValues["moduleId"]?.ToString() ?? string.Empty;
    var module = ManagementGovernanceRegistry.ModulesById.TryGetValue(moduleId, out var m) ? m : null;
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/management-governance.css" />
}

<partial name="Components/_DomainHeader" model="Model" />

@if (module == null)
{
    <div class="alert alert-warning">Module was not found in registry.</div>
}
else if (module.Implemented)
{
    <section class="card mg-card">
        <div class="card-body">
            <h2 class="h5 mb-2">@module.Name</h2>
            <p class="text-muted">This module is implemented. Use the direct workspace route:</p>
            <a class="btn btn-primary btn-sm" href="@module.Route">Open Module Workspace</a>
        </div>
    </section>
}
else
{
    <partial name="Components/_PlaceholderModuleState" model="module" />
}

@section Scripts {
    <script src="~/assets/js/pages/management-governance/mg-page.js"></script>
}
