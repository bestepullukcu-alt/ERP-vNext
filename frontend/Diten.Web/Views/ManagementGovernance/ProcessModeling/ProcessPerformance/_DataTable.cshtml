@using Diten.Web.Views.ManagementGovernance.ProcessModeling.ProcessPerformance
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProcessPerformanceIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
<div class="card"><div id="skeleton-loader" class="backbone-skeleton p-4" aria-hidden="true"><div class="shimmer skeleton-row skeleton-row-lg"></div><div class="shimmer skeleton-row"></div></div>
<div class="card-datatable table-responsive"><table id="dt-process-performance" data-dt-standard="v2" class="datatables-process-performance table border-top"><thead><tr>
<th></th><th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input" disabled aria-label="@SharedLocalizer["SelectAll"]"></th>
<th>@Localizer["ProcessModel"]</th><th>@Localizer["ProcessVersion"]</th><th>@Localizer["MetricReference"]</th><th>@Localizer["ReferenceStatus"]</th><th class="cell-fit text-end pe-3">@SharedLocalizer["Actions"]</th>
</tr></thead></table></div></div>
