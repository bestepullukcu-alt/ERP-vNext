@using Diten.Web.Views.ManagementGovernance.ProcessModeling.ProcessPerformance
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProcessPerformanceIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
<div id="inlineFilterHost"><div class="collapse" id="inlineFilterCollapse"><div class="pt-0 pb-3">
    <form class="m-0" id="filterForm" data-no-tracker><div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
        <div class="filter-chip"><select id="filterReferenceStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["ReferenceStatus"]">
            <option value="active">@Localizer["StateActive"]</option><option value="disabled">@Localizer["StateDisabled"]</option>
            <option value="missing">@Localizer["StateMissing"]</option><option value="unavailable">@Localizer["StateUnavailable"]</option>
        </select></div>
        <div class="ms-auto d-flex gap-3"><button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button><button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button></div>
    </div></form>
</div></div></div>
