@model Diten.Web.Models.ManagementGovernance.ProcessModeling.ProcessModelingEditorViewModel
@using Diten.Web.Models.ManagementGovernance.ProcessModeling
@using Diten.Web.Views.ManagementGovernance.ProcessModeling
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProcessModelingEditor> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "_LayoutTenantShell";
    var readOnly = !Model.GatewayReady;
}

<div class="d-flex justify-content-between align-items-center mb-3 row-gap-4 flex-wrap">
    <div>
        <h5 class="mb-0">@Localizer["Title"]</h5>
        <nav aria-label="@Localizer["BreadcrumbLabel"]">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/management-governance/process-modeling/models">@Localizer["Models"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer["Editor"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2 flex-wrap" aria-label="@Localizer["LifecycleActions"]">
        @if (Model.Permissions.Contains(ProcessModelingFrontendPermissions.RequestReview))
        { <button type="button" class="btn btn-label-primary" data-model-action="request-review" disabled="@readOnly">@Localizer["RequestReview"]</button> }
        @if (Model.Permissions.Contains(ProcessModelingFrontendPermissions.ReturnToDraft))
        { <button type="button" class="btn btn-label-secondary" data-model-action="return-to-draft" disabled="@readOnly">@Localizer["ReturnToDraft"]</button> }
        @if (Model.Permissions.Contains(ProcessModelingFrontendPermissions.Publish))
        { <button type="button" class="btn btn-primary" data-model-action="publish" disabled="@readOnly">@Localizer["Publish"]</button> }
        @if (Model.Permissions.Contains(ProcessModelingFrontendPermissions.Retire))
        { <button type="button" class="btn btn-label-danger" data-model-action="retire" disabled="@readOnly">@Localizer["Retire"]</button> }
        @if (Model.Permissions.Contains(ProcessModelingFrontendPermissions.CreateRevision))
        { <button type="button" class="btn btn-label-info" data-model-action="create-revision" disabled="@readOnly">@Localizer["CreateRevision"]</button> }
    </div>
</div>

<div id="processModelEditor"
     class="process-modeling-editor"
     data-model-id="@Model.ProcessModelId"
     data-gateway-ready="@Model.GatewayReady.ToString().ToLowerInvariant()"
     data-read-only="@readOnly.ToString().ToLowerInvariant()">
    <div class="alert alert-warning" role="status" data-editor-state="gateway-not-ready">
        @Localizer["GatewayNotReady"]
    </div>
    <div class="card mb-4">
        <div class="card-header"><h6 class="mb-0">@Localizer["VersionSummary"]</h6></div>
        <div class="card-body" aria-live="polite"><span class="text-muted">@Localizer["NoAuthoritativeVersion"]</span></div>
    </div>
    <div class="card mb-4">
        <div class="card-header p-3">
            <nav class="nav nav-pills d-inline-flex gap-2 flex-wrap" aria-label="@Localizer["WorkspaceTabs"]">
                <button class="nav-link active wc-tab-compact" type="button" data-bs-toggle="pill" data-bs-target="#modelGraph"><i class="bx bx-git-branch me-1" aria-hidden="true"></i>@Localizer["Graph"]</button>
                <button class="nav-link wc-tab-compact" type="button" data-bs-toggle="pill" data-bs-target="#modelActivities"><i class="bx bx-list-check me-1" aria-hidden="true"></i>@Localizer["Activities"]</button>
                <button class="nav-link wc-tab-compact" type="button" data-bs-toggle="pill" data-bs-target="#modelControls"><i class="bx bx-shield me-1" aria-hidden="true"></i>@Localizer["ControlPoints"]</button>
            </nav>
        </div>
        <div class="card-body tab-content">
            <section id="modelGraph" class="tab-pane fade show active" tabindex="0" aria-label="@Localizer["Graph"]"><p class="text-muted mb-0">@Localizer["NoAuthoritativeGraph"]</p></section>
            <section id="modelActivities" class="tab-pane fade" tabindex="0" aria-label="@Localizer["Activities"]"><p class="text-muted mb-0">@Localizer["NoAuthoritativeActivities"]</p></section>
            <section id="modelControls" class="tab-pane fade" tabindex="0" aria-label="@Localizer["ControlPoints"]"><p class="text-muted mb-0">@Localizer["NoAuthoritativeControls"]</p></section>
        </div>
    </div>
</div>

<script id="process-modeling-editor-l10n" type="application/json">
    @Json.Serialize(new
    {
        Loading = Localizer["Loading"].Value,
        GatewayNotReady = Localizer["GatewayNotReady"].Value,
        Error401 = Localizer["Error401"].Value,
        Error403 = Localizer["Error403"].Value,
        Error404 = Localizer["Error404"].Value,
        Error409 = Localizer["Error409"].Value,
        Error503 = Localizer["Error503"].Value
    })
</script>

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/management-governance/process-modeling.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/assets/js/pages/management-governance/process-modeling/editor.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/management-governance/process-modeling/editor.js" asp-append-version="true"></script>
}
