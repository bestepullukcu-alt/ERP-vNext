@model Diten.Web.Models.ManagementGovernance.ProcessModeling.PerformanceImprovement.PerformanceImprovementIndexViewModel
@using Diten.Web.Models.ManagementGovernance.ProcessModeling.PerformanceImprovement
@using Diten.Web.Views.ManagementGovernance.ProcessModeling.PerformanceImprovement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PerformanceImprovementIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "_LayoutTenantShell";
}

<partial name="~/Views/ManagementGovernance/ProcessModeling/PerformanceImprovement/_Filter.cshtml" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["Title"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@if (!Model.GatewayReady)
{
    <div class="alert alert-warning" role="status" data-improvement-state="default-off">@Localizer["GatewayNotReady"]</div>
}

<div id="performanceImprovementStatus" class="alert d-none" role="status" aria-live="polite"
     data-improvement-state="idle"></div>

<partial name="~/Views/ManagementGovernance/ProcessModeling/PerformanceImprovement/_DataTable.cshtml" />

<div id="performanceImprovementContext" class="d-none"
     data-mode="index"
     data-ready="@Model.GatewayReady.ToString().ToLowerInvariant()"
     data-read="@Model.Permissions.Contains(PerformanceImprovementFrontendPermissions.Read).ToString().ToLowerInvariant()"></div>

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/management-governance/process-modeling/performance-improvement.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="~/Views/ManagementGovernance/ProcessModeling/PerformanceImprovement/_IndexL10n.cshtml" />
    <script src="~/assets/js/pages/management-governance/process-modeling/performance-improvement/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/pages/management-governance/process-modeling/performance-improvement/index.js" asp-append-version="true"></script>
}
