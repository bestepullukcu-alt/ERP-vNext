@using Diten.Web.Views.ManagementGovernance.ProcessModeling.PerformanceImprovement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PerformanceImprovementIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-lifecycle">
                        <select id="filterLifecycle" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Lifecycle"]">
                            <option value="Open">@Localizer["StateOpen"]</option>
                            <option value="Qualified">@Localizer["StateQualified"]</option>
                            <option value="Closed">@Localizer["StateClosed"]</option>
                        </select>
                    </div>
                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
