@model Diten.Web.Models.ManagementGovernance.ManagementGovernancePageViewModel
@{
    ViewData["Title"] = "Work Queue";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/management-governance.css" />
}

<partial name="Components/_DomainHeader" model="Model" />
<div class="mb-3">
    <partial name="Components/_FilterPanel" model="Model" />
</div>

<section class="card mg-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0">Unified Governance Queue</h2>
        <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
            <button type="button" class="btn btn-outline-secondary active" data-mg-queue-mode="table">Table</button>
            <button type="button" class="btn btn-outline-secondary" data-mg-queue-mode="kanban">Kanban</button>
        </div>
    </div>
    <div class="card-body">
        <div class="mb-2 d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-primary" data-permission="CanApprove" @(Model.Permissions.CanApprove ? "" : "disabled")>Bulk approve</button>
            <button class="btn btn-sm btn-outline-secondary" data-permission="CanAssign" @(Model.Permissions.CanAssign ? "" : "disabled")>Bulk assign</button>
            <button class="btn btn-sm btn-outline-secondary" data-permission="CanEscalate" @(Model.Permissions.CanEscalate ? "" : "disabled")>Bulk escalate</button>
        </div>
        <div id="mg-queue-table" class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Priority</th>
                        <th>Risk</th>
                        <th>Assignee</th>
                        <th>Status</th>
                        <th>Due</th>
                        <th>Source</th>
                        <th>Governance Marks</th>
                        <th>Audit / Evidence</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.WorkQueue)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Title</div>
                            <div class="small text-muted">@item.Type</div>
                        </td>
                        <td><partial name="Components/_StatusBadge" model="item.Priority" /></td>
                        <td><partial name="Components/_RiskBadge" model="item.RiskLevel" /></td>
                        <td>@item.Assignee</td>
                        <td><partial name="Components/_StatusBadge" model="item.Status" /></td>
                        <td>@item.DueAtUtc.ToString("dd MMM yyyy")</td>
                        <td><a href="@item.SourceModuleRoute">Open module</a></td>
                        <td>
                            @if (item.HasAuditTrail)
                            {
                                <span class="badge bg-dark-subtle text-dark">Audit</span>
                            }
                            @if (item.RequiresEvidence)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis">Evidence</span>
                            }
                        </td>
                        <td class="small">
                            @if (Model.Permissions.CanViewAuditTrail && item.HasAuditTrail)
                            {
                                <a href="/management-governance/recent-activity">Audit trail</a>
                            }
                            @if (Model.Permissions.CanViewEvidence && item.RequiresEvidence)
                            {
                                <span> • </span><a href="/management-governance/search?q=evidence">Evidence</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div id="mg-queue-kanban" class="d-none">
            <div class="row g-3">
                @foreach (var status in new[] { "Open", "In Progress", "Closed" })
                {
                    <div class="col-12 col-lg-4">
                        <div class="mg-kanban-col">
                            <div class="fw-semibold mb-2">@status</div>
                            @foreach (var item in Model.WorkQueue.Where(x => x.Status == status).Take(8))
                            {
                                <div class="mg-kanban-item">
                                    <div class="small fw-semibold">@item.Title</div>
                                    <div class="small text-muted">@item.Assignee</div>
                                    <a class="small" href="@item.SourceModuleRoute">Open</a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/pages/management-governance/mg-data-adapter.js"></script>
    <script src="~/assets/js/pages/management-governance/mg-page.js"></script>
}
