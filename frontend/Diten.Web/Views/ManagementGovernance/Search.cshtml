@model Diten.Web.Models.ManagementGovernance.ManagementGovernancePageViewModel
@{
    ViewData["Title"] = "Governance Search";
    var query = Context.Request.Query["q"].ToString();
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/pages/management-governance.css" />
}

<partial name="Components/_DomainHeader" model="Model" />
<partial name="Components/_SearchBar" model="query" />

<div class="row g-3 mt-1">
    <div class="col-12 col-xl-4">
        <section class="card mg-card h-100">
            <div class="card-header"><h2 class="h6 mb-0">Recent Searches</h2></div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-secondary">stage gate</button>
                    <button class="btn btn-sm btn-outline-secondary">risk evidence</button>
                    <button class="btn btn-sm btn-outline-secondary">portfolio variance</button>
                </div>
            </div>
        </section>
    </div>
    <div class="col-12 col-xl-8">
        <section class="card mg-card h-100">
            <div class="card-header"><h2 class="h6 mb-0">Grouped Results</h2></div>
            <div class="card-body">
                <div id="mg-search-results">
                    <div class="mg-empty">Type to search subdomains, modules, and governance objects.</div>
                </div>
                <div class="small text-muted mt-3">
                    No-results suggestion: try module owner, subdomain name, or action type.
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/pages/management-governance/mg-data-adapter.js"></script>
    <script>
        window.mgSearchSource = {
            subdomains: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Subdomains.Select(x => x.Name).ToList())),
            modules: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Subdomains.SelectMany(x => x.Modules).Select(x => x.Name).ToList()))
        };
    </script>
    <script src="~/assets/js/pages/management-governance/mg-page.js"></script>
}
