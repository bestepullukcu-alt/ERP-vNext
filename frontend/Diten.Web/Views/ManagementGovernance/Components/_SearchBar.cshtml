@model string

<div class="card mg-card">
    <div class="card-body">
        <div class="input-group">
            <span class="input-group-text">Search</span>
            <input id="mg-search-input" type="text" class="form-control" value="@Model" placeholder="Search subdomains, modules, queue items..." />
            <button id="mg-search-button" class="btn btn-primary" type="button">Go</button>
        </div>
    </div>
</div>
