@model IReadOnlyList<Diten.Web.Models.ManagementGovernance.ModuleSummary>

<section class="card mg-card h-100">
    <div class="card-header">
        <h2 class="h6 mb-0">Dependency Map</h2>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="mg-empty">No dependencies to display.</div>
        }
        else
        {
            <ul class="list-unstyled mb-0">
            @foreach (var module in Model.Take(8))
            {
                <li class="mb-2">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <div class="fw-semibold small">@module.Name</div>
                            <div class="text-muted small">@string.Join(", ", module.Tags.Take(2))</div>
                        </div>
                        <partial name="Components/_RiskBadge" model="module.RiskLevel" />
                    </div>
                </li>
            }
            </ul>
        }
    </div>
</section>
