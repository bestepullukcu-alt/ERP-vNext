@model Diten.Web.Models.ManagementGovernance.SubdomainSummary

<article class="card mg-card h-100">
    <div class="card-body d-flex flex-column gap-2">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h3 class="h6 mb-0">@Model.Name</h3>
            <partial name="Components/_StatusBadge" model="Model.Status" />
        </div>
        <p class="text-muted small mb-0">@Model.Description</p>
        <div class="small">
            <span class="text-muted">Owner:</span> @Model.Owner
        </div>
        <div class="small">
            <span class="text-muted">Pending:</span> @Model.PendingItemsCount
        </div>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <partial name="Components/_RiskBadge" model="Model.RiskLevel" />
            <a href="@Model.Route" class="btn btn-sm btn-outline-primary">Open</a>
        </div>
    </div>
</article>
