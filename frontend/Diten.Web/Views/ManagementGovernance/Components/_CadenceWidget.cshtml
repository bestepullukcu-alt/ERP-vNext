@model IReadOnlyList<Diten.Web.Models.ManagementGovernance.GovernanceEvent>

<section class="card mg-card h-100">
    <div class="card-header">
        <h2 class="h6 mb-0">Upcoming Cadence</h2>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="mg-empty">No upcoming events.</div>
        }
        else
        {
            <ul class="list-unstyled mb-0">
            @foreach (var ev in Model.OrderBy(x => x.StartUtc).Take(6))
            {
                <li class="mb-3">
                    <div class="fw-semibold">@ev.Title</div>
                    <div class="small text-muted">@ev.StartUtc.ToString("ddd, dd MMM HH:mm") • @ev.Forum</div>
                    <a class="small" href="@ev.Route">Open</a>
                </li>
            }
            </ul>
        }
    </div>
</section>
