@model string
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.Views.Expiry.Expiry> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@*
    Breadcrumb "Son Kullanma / FEFO / {sayfa}" (pack §9) + the F4 pages as links (the mockup's sidebar group; each is its own manifest
    page). MODEL: the active page code. A page the user may not open is not offered (UAS-001).
*@
@{
    var tabs = new (string Code, string Url, string Icon, string Key, string Permission)[]
    {
        ("EXPIRYDASHBOARD", "/Expiry", "bx-bar-chart-alt-2", "Expiry.Tabs.Dashboard", "expiry.dashboard.read"),
        ("EXPIRYAPPROACHING", "/Expiry/Approaching", "bx-calendar-exclamation", "Expiry.Tabs.Approaching", "expiry.dashboard.read"),
        ("EXPIREDSTOCK", "/Expiry/Expired", "bx-calendar-x", "Expiry.Tabs.Expired", "expiry.dashboard.read"),
        ("FEFOORDER", "/Expiry/FefoOrder", "bx-sort-up", "Expiry.Tabs.FefoOrder", "expiry.fefo-order.read")
    };
    var active = tabs.FirstOrDefault(t => t.Code == Model);
}
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item text-muted">@Localizer["Expiry.Common.Crumb.Root"]</li>
        <li class="breadcrumb-item active text-primary" aria-current="page">@(active.Key is null ? ViewData["Title"] : Localizer[active.Key].Value)</li>
    </ol>
</nav>
<ul class="nav nav-pills flex-wrap gap-2 mb-4" role="tablist" id="ex-tabs">
    @foreach (var tab in tabs.Where(t => Perms.Has(t.Permission)))
    {
        var on = tab.Code == Model;
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 @(on ? "active" : "shadow-sm")" style="@(on ? null : "background-color: var(--bs-paper-bg)")" href="@tab.Url" @(on ? "aria-current=page" : "")>
                <i class="bx @tab.Icon"></i><span>@Localizer[tab.Key]</span>
            </a>
        </li>
    }
</ul>
