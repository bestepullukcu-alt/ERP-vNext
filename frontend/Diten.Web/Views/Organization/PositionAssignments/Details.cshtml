@using Diten.Web.Views.Organization.PositionAssignments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PositionAssignmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var assignmentId = ViewData["AssignmentId"]?.ToString() ?? string.Empty;
    ViewData["Title"] = Localizer["DetailsTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* MOD-0288 — Position Assignment read-only Details. Mirrors the Legal Entity / Position Details reference: static
   title + breadcrumb, Back + Actions-dropdown + Edit header, derived-status + cancelled badges inside the Basic
   card header, and read-only `card backbone-preview-section` cards laid out as a col-lg-8 main column + col-lg-4
   sidebar. Position / User names resolved client-side. No archive endpoint — the only action is Delete. *@
<div class="position-assignment-details" id="a-details-page" data-a-id="@assignmentId">
    @Html.AntiForgeryToken()
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@Localizer["DetailsTitle"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/PositionAssignments">@Localizer["PositionAssignmentsTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary" id="aDetailBreadcrumb">@Localizer["Details"]</li>
                </ol>
            </nav>
        </div>
        @* Button order: Back → Actions ▼ → Edit *@
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="/PositionAssignments" class="btn btn-label-secondary">@SharedLocalizer["Back"]</a>
            <div class="dropdown d-none" id="a-detail-action-wrap">
                <button type="button" class="btn btn-label-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bx bx-cog me-1"></i>@Localizer["Actions"]
                </button>
                <ul class="dropdown-menu dropdown-menu-end" id="a-detail-actions"></ul>
            </div>
            <a href="#" id="a-detail-edit" class="btn btn-primary">@Localizer["Edit"]</a>
        </div>
    </div>

    <div id="a-details-alert" class="alert alert-danger d-none" role="alert"></div>

    <div class="row g-4">
        @* Main column *@
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                @* Section title on the left, derived-status + cancelled badges on the right. *@
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["SectionBasic"]</h6>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <span id="a-detail-status" class="badge bg-label-secondary"></span>
                        <span id="aDetailCancelledBadge"></span>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-briefcase"></i><div><div class="backbone-preview-label">@Localizer["Position"]</div><div class="backbone-preview-value mt-1" id="aDetailPosition">-</div></div></div></div>
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-user"></i><div><div class="backbone-preview-label">@Localizer["User"]</div><div class="backbone-preview-value mt-1" id="aDetailUser">-</div></div></div></div>
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-category"></i><div><div class="backbone-preview-label">@Localizer["AssignmentType"]</div><div class="backbone-preview-value mt-1" id="aDetailType">-</div></div></div></div>
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-calendar-event"></i><div><div class="backbone-preview-label">@Localizer["EffectiveFrom"]</div><div class="backbone-preview-value mt-1" id="aDetailEffectiveFrom">-</div></div></div></div>
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-calendar-x"></i><div><div class="backbone-preview-label">@Localizer["EffectiveTo"]</div><div class="backbone-preview-value mt-1" id="aDetailEffectiveTo">-</div></div></div></div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Notes"]</h6>
                <div class="backbone-preview-value" id="aDetailNotes">-</div>
            </section>
        </div>

        @* Sidebar column *@
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionAdvanced"]</h6>
                <div class="row g-4">
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-pie-chart-alt-2"></i><div><div class="backbone-preview-label">@Localizer["AllocationPercent"]</div><div class="backbone-preview-value mt-1" id="aDetailAllocation">-</div></div></div></div>
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-info-circle"></i><div><div class="backbone-preview-label">@Localizer["Reason"]</div><div class="backbone-preview-value mt-1" id="aDetailReason">-</div></div></div></div>
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-x-circle"></i><div><div class="backbone-preview-label">@Localizer["IsCancelled"]</div><div class="backbone-preview-value mt-1" id="aDetailCancelled">-</div></div></div></div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionSystem"]</h6>
                <div class="row g-4">
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-calendar-plus"></i><div><div class="backbone-preview-label">@Localizer["CreatedAt"]</div><div class="backbone-preview-value mt-1" id="aDetailCreatedAt">-</div></div></div></div>
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-calendar-edit"></i><div><div class="backbone-preview-label">@Localizer["UpdatedAt"]</div><div class="backbone-preview-value mt-1" id="aDetailUpdatedAt">-</div></div></div></div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="_DetailsL10n" />
    <script src="~/assets/js/Organization/PositionAssignments/details.js" asp-append-version="true"></script>
}
