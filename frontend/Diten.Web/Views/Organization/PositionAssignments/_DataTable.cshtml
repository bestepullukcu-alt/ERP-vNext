@using Diten.Web.Views.Organization.PositionAssignments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PositionAssignmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="p-4" style="display: none;">
        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-position-assignments" data-dt-standard="v2" class="datatables-position-assignments table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Position"]</th>
                    <th class="all">@Localizer["User"]</th>
                    <th>@Localizer["EffectiveFrom"]</th>
                    <th>@Localizer["EffectiveTo"]</th>
                    <th>@Localizer["StatusLabel"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
