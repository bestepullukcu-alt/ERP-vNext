@using System.Globalization
@using System.Text.Json
@using Diten.Web.Views.Organization.PositionAssignments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PositionAssignmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    static string ToFlatpickr(string net) =>
        net.Replace("dd", "\x01").Replace("d", "\x02")
           .Replace("MM", "\x03").Replace("M", "\x04")
           .Replace("yyyy", "Y").Replace("yy", "y")
           .Replace("\x01", "d").Replace("\x02", "j").Replace("\x03", "m").Replace("\x04", "n");

    var payload = new
    {
        RequiredField = Localizer["RequiredField"].Value,
        DateFormat = ToFlatpickr(CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern),
        // The only 409 create/update returns is the one-primary-per-position conflict → show this localized message.
        OnePrimaryError = Localizer["OnePrimaryError"].Value,
        RecordCreated = SharedLocalizer["RecordCreated"].Value,
        RecordUpdated = SharedLocalizer["RecordUpdated"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value
    };
}
<script id="assignment-form-l10n" type="application/json">
@Html.Raw(JsonSerializer.Serialize(payload))
</script>
