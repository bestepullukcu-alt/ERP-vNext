@using Diten.Web.Views.Organization.OrganizationUnits
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<OrganizationUnitsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var orgUnitId = ViewData["OrgUnitId"]?.ToString() ?? string.Empty;
    ViewData["Title"] = Localizer["DetailsTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* MOD-0288 — Org Unit read-only Details. Mirrors the Legal Entity Details reference: static title + breadcrumb,
   Back + Edit + Actions-dropdown header, status badges under the breadcrumb, and read-only
   `card backbone-preview-section` cards laid out as a col-lg-8 main column + col-lg-4 sidebar. Values are fetched
   by id and populated client-side by details.js. *@
<div class="organization-unit-details" id="ou-details-page" data-ou-id="@orgUnitId">
    @Html.AntiForgeryToken()
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@Localizer["DetailsTitle"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/OrganizationUnits">@Localizer["OrganizationUnitsTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary" id="ouDetailBreadcrumb">@Localizer["Details"]</li>
                </ol>
            </nav>
        </div>
        @* Button order: Back → Actions ▼ → Edit *@
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="/OrganizationUnits" class="btn btn-label-secondary">@SharedLocalizer["Back"]</a>
            @* Lifecycle actions (Archive / Delete) live in this dropdown; JS fills the menu and reveals the wrapper. *@
            <div class="dropdown d-none" id="ou-detail-action-wrap">
                <button type="button" class="btn btn-label-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bx bx-cog me-1"></i>@Localizer["Actions"]
                </button>
                <ul class="dropdown-menu dropdown-menu-end" id="ou-detail-actions"></ul>
            </div>
            <a href="#" id="ou-detail-edit" class="btn btn-primary">@Localizer["Edit"]</a>
        </div>
    </div>

    <div id="ou-details-alert" class="alert alert-danger d-none" role="alert"></div>

    <div class="row g-4">
        @* Main column *@
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                @* Section title on the left, status badges on the right — inside the Basic card. *@
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["SectionBasic"]</h6>
                    <div class="d-flex align-items-center gap-2">
                        <span id="ouDetailStatusBadge"></span>
                        <span id="ouDetailArchivedBadge"></span>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-purchase-tag-alt"></i><div><div class="backbone-preview-label">@Localizer["Code"]</div><div class="backbone-preview-value mt-1" id="ouDetailCode">-</div></div></div></div>
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-sitemap"></i><div><div class="backbone-preview-label">@Localizer["Name"]</div><div class="backbone-preview-value mt-1" id="ouDetailName">-</div></div></div></div>
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-category"></i><div><div class="backbone-preview-label">@Localizer["OrgUnitType"]</div><div class="backbone-preview-value mt-1" id="ouDetailType">-</div></div></div></div>
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-buildings"></i><div><div class="backbone-preview-label">@Localizer["LegalEntity"]</div><div class="backbone-preview-value mt-1" id="ouDetailLegalEntity">-</div></div></div></div>
                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-network-chart"></i><div><div class="backbone-preview-label">@Localizer["ParentOrgUnit"]</div><div class="backbone-preview-value mt-1" id="ouDetailParent">-</div></div></div></div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Description"]</h6>
                <div class="backbone-preview-value" id="ouDetailDescription">-</div>
            </section>
        </div>

        @* Sidebar column *@
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionAdvanced"]</h6>
                <div class="row g-4">
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-user-voice"></i><div><div class="backbone-preview-label">@Localizer["ManagerPosition"]</div><div class="backbone-preview-value mt-1" id="ouDetailManager">-</div></div></div></div>
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-calendar-event"></i><div><div class="backbone-preview-label">@Localizer["EffectiveFrom"]</div><div class="backbone-preview-value mt-1" id="ouDetailEffectiveFrom">-</div></div></div></div>
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-calendar-x"></i><div><div class="backbone-preview-label">@Localizer["EffectiveTo"]</div><div class="backbone-preview-value mt-1" id="ouDetailEffectiveTo">-</div></div></div></div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionSystem"]</h6>
                <div class="row g-4">
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-archive"></i><div><div class="backbone-preview-label">@Localizer["Archived"]</div><div class="backbone-preview-value mt-1" id="ouDetailArchived">-</div></div></div></div>
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-calendar-plus"></i><div><div class="backbone-preview-label">@Localizer["CreatedAt"]</div><div class="backbone-preview-value mt-1" id="ouDetailCreatedAt">-</div></div></div></div>
                    <div class="col-12"><div class="backbone-preview-field"><i class="bx bx-calendar-edit"></i><div><div class="backbone-preview-label">@Localizer["UpdatedAt"]</div><div class="backbone-preview-value mt-1" id="ouDetailUpdatedAt">-</div></div></div></div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="_DetailsL10n" />
    <script src="~/assets/js/Organization/OrganizationUnits/details.js" asp-append-version="true"></script>
}
