@using Diten.Web.Views.Organization.OrganizationUnits
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<OrganizationUnitsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    @* MOD-0288-FU03 — one filter per reporting line. A lone administrative filter beside an
                       unfiltered functional line is the same unlabelled asymmetry FU02 §21.1 refuses. Neither
                       select defaults to the other's value. *@
                    <div class="filter-chip filter-functional-parent">
                        <select id="filterFunctionalParent" class="form-select form-select-sm select2" data-placeholder="@Localizer["FunctionalParentLabel"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    <div class="filter-chip filter-administrative-parent">
                        <select id="filterAdministrativeParent" class="form-select form-select-sm select2" data-placeholder="@Localizer["AdministrativeParentLabel"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    <div class="filter-chip filter-archived">
                        <select id="filterArchived" class="form-select form-select-sm select2" data-placeholder="@Localizer["Archived"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="false">@Localizer["StatusActive"]</option>
                            <option value="true">@Localizer["StatusArchived"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" id="btnFilterApply" class="btn btn-sm btn-primary">@SharedLocalizer["Apply"]</button>
                        <button type="reset" id="btnFilterReset" class="btn btn-sm btn-label-danger">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
