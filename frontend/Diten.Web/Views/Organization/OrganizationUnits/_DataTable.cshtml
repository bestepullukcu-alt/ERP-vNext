@using Diten.Web.Views.Organization.OrganizationUnits
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<OrganizationUnitsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <partial name="_TableSkeleton" />
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-organizationunits" data-dt-standard="v2" class="datatables-organization-units table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th class="all">@Localizer["Name"]</th>
                    <th>@Localizer["LegalEntity"]</th>
                    <th>@Localizer["FunctionalParentLabel"]</th>
                    <th>@Localizer["Archived"]</th>
                    @* MOD-0288-FU03 §5 — the administrative line is an OPTIONAL column: present in the column
                       chooser, hidden by default. ⚠ It is APPENDED after Archived rather than placed beside the
                       functional parent, because a saved view stores column visibility BY INDEX — inserting a
                       column at position 5 would silently re-point every saved view's flags onto the wrong
                       columns. Same reasoning as the enum append in §4. *@
                    <th>@Localizer["AdministrativeParentLabel"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
