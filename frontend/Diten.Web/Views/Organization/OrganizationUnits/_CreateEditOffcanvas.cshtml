@using Diten.Web.Views.Organization.OrganizationUnits
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<OrganizationUnitsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCreateEdit" aria-labelledby="offcanvasCreateEditLabel">
    <div class="offcanvas-header p-4">
        <h5 id="offcanvasCreateEditLabel" class="offcanvas-title">-</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body border-top p-4">
        @* Server-side validation errors (from gateway) *@
        <div id="formOrganizationUnitAlert" class="alert alert-danger d-none" role="alert"></div>

        <form id="formOrganizationUnit" class="pt-0" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="orgUnitItemId" name="Id" value="" />

            <div class="row g-4">
                <div class="col-12">
                    <label for="orgUnitCode" class="form-label fw-medium">
                        @Localizer["Code"] <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="orgUnitCode" name="Code" class="form-control" minlength="2" maxlength="80"
                           pattern="^[A-Z0-9]+(-[A-Z0-9]+)*$" placeholder="@Localizer["CodePlaceholder"]" required />
                    <div id="orgUnitCodePreview" class="form-text mt-1 text-muted d-none">
                        @Localizer["FinalCodePreview"]: <span class="fw-bold text-primary"></span>
                    </div>
                    <div class="invalid-feedback">@Localizer["InvalidCode"]</div>
                </div>

                <div class="col-12">
                    <label for="orgUnitName" class="form-label fw-medium">
                        @Localizer["Name"] <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="orgUnitName" name="Name" class="form-control" maxlength="200"
                           placeholder="@Localizer["NamePlaceholder"]" required />
                    <div class="invalid-feedback">@Localizer["RequiredField"]</div>
                </div>

                <div class="col-12">
                    <label for="orgUnitLegalEntity" class="form-label fw-medium">
                        @Localizer["LegalEntity"] <span class="text-danger">*</span>
                    </label>
                    @* MOD-0288 #1 — searchable select2 of referenceable Legal Entities ("Code — Name"); the GUID is
                       stored as the option value and never typed. No manual-GUID fallback. *@
                    <select id="orgUnitLegalEntity" name="LegalEntityId" class="form-select" required>
                        <option value="">@Localizer["SelectLegalEntity"]</option>
                    </select>
                    <div class="invalid-feedback">@Localizer["RequiredField"]</div>
                </div>

                <div class="col-12">
                    <label for="orgUnitParent" class="form-label fw-medium">@Localizer["ParentOrgUnit"]</label>
                    <select id="orgUnitParent" name="ParentOrganizationUnitId" class="form-select">
                        <option value="">@Localizer["NoParent"]</option>
                    </select>
                </div>
            </div>
        </form>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">
            @SharedLocalizer["Cancel"]
        </button>
        <button type="button" id="btnSaveOrgUnit" class="btn btn-primary">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>
