@using System.Globalization
@using System.Text.Json
@using Diten.Web.Views.Organization.Positions
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PositionsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // Map the request culture's .NET short-date pattern to flatpickr tokens (stored value stays ISO Y-m-d).
    // WCN-FIX-04 — one conversion for every view (FlatpickrDateFormat: drops the bidi marks Arabic's pattern carries).

    var payload = new
    {
        RequiredField = Localizer["RequiredField"].Value,
        // MOD-0040-FU02 DL-2 — the record-code answers, shown instead of the service's English errors[] (pack §11).
        RecordCodeImmutable = Localizer["RecordCodeImmutable"].Value,
        RecordCodeSystemAssigned = Localizer["RecordCodeSystemAssigned"].Value,
        RecordCodeCollision = Localizer["RecordCodeCollision"].Value,
        RecordCodeShortCodeChanged = Localizer["RecordCodeShortCodeChanged"].Value,
        RecordCodeShortCodeMissing = Localizer["RecordCodeShortCodeMissing"].Value,
        RecordCodeLegalEntityNotFound = Localizer["RecordCodeLegalEntityNotFound"].Value,
        RecordCodeLegalEntityNotEligible = Localizer["RecordCodeLegalEntityNotEligible"].Value,
        RecordCodeLegalEntityReadPermissionMissing = Localizer["RecordCodeLegalEntityReadPermissionMissing"].Value,
        RecordCodePermissionMissing = Localizer["RecordCodePermissionMissing"].Value,
        RecordCodeTenantNotActive = Localizer["RecordCodeTenantNotActive"].Value,
        RecordCodeUnavailable = Localizer["RecordCodeUnavailable"].Value,
        RecordCodeLegalEntitySourceUnavailable = Localizer["RecordCodeLegalEntitySourceUnavailable"].Value,
        RecordCodeForbidden = Localizer["RecordCodeForbidden"].Value,
        // WCN-FIX-04 — a typed date the shared guard refused: the save stops and says why (SharedResource, 7 languages).
        DateNotRecognized = SharedLocalizer["DateNotRecognized"].Value,
        DateFormat = Diten.Web.Services.Localization.FlatpickrDateFormat.ForCurrentCulture(),
        RecordCreated = SharedLocalizer["RecordCreated"].Value,
        RecordUpdated = SharedLocalizer["RecordUpdated"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value
    };
}
<script id="position-form-l10n" type="application/json">
@Html.Raw(JsonSerializer.Serialize(payload))
</script>
