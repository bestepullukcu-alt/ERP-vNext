@using Diten.Web.Views.Warehouse.PutawayTasks
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PutawayTasksIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // The table card is a component (BL-440): the page describes it, _ListShell renders it. Every header is localized HERE.
    //
    // SERVER data through the proxy profile (pack §11.2): /Warehouse/PutawayTasks/api translates paging, search and filters for
    // listPutawayTasks. The selection column feeds the bulk "Ata" bar, which only a supervisor gets (Index.cshtml). Status and the
    // integration flag are two columns (§8.15, AC-46): the status comes from the confirmed quantity, the flag is its own badge.
    var listShell = new DataTableListShellViewModel
    {
        TableId = "dt-putawaytasks",
        DataMode = "server",
        Slug = "putawaytasks",
        HasSelection = true,
        Columns =
        [
            new DataTableColumnViewModel { Header = Localizer["ColNumber"].Value, CssClass = "all" },
            new DataTableColumnViewModel { Header = Localizer["ColStatus"].Value },
            new DataTableColumnViewModel { Header = Localizer["ColFlag"].Value },
            new DataTableColumnViewModel { Header = Localizer["ColProduct"].Value },
            new DataTableColumnViewModel { Header = Localizer["ColLot"].Value },
            new DataTableColumnViewModel { Header = Localizer["ColFrom"].Value },
            new DataTableColumnViewModel { Header = Localizer["ColTo"].Value },
            new DataTableColumnViewModel { Header = Localizer["ColQuantity"].Value },
            new DataTableColumnViewModel { Header = Localizer["ColAssignee"].Value },
            new DataTableColumnViewModel { Header = Localizer["ColPriority"].Value }
        ],
        ActionsHeader = Localizer["Actions"].Value
    };
}

<partial name="~/Views/Shared/Components/DataTable/_ListShell.cshtml" model="listShell" />
