@model Diten.Web.Models.Warehouse.OutboundShipmentFormViewModel
@using Diten.Web.Views.Warehouse.OutboundShipments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<OutboundShipmentsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
}
@*
    MOD-0178 DL-6 — the Compact outbound form (pack §9: ≥ 12 fields → compact). Create: depo, Staging (only when the warehouse has several), sipariş
    ref., alıcı (ad, ülke, şehir, posta kodu, adres 1, adres 2), not + satırlar (ürün, SKU, miktar, birim, sipariş satırı, lot değişimi, gerekçe) and
    "Tahsisi önizle" (§8.17 step 7 — not a reservation). Edit: the header only (order ref, ship-to, note) — the lines and the allocation never change.
    form.js sends the JSON body to the same-origin proxy; the service decides every rule (FEFO, Item resolution, base unit, mixing).
*@
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/Warehouse/OutboundShipments">@Localizer["OutboundShipmentsTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="@(isEdit && Model.Id is not null ? $"/Warehouse/OutboundShipments/Details/{Model.Id}" : "/Warehouse/OutboundShipments")" class="btn btn-label-secondary wh-touch">
            @SharedLocalizer["Cancel"]
        </a>
        <button type="submit" form="outboundForm" class="btn btn-primary wh-touch" id="btnSaveOutbound">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>

<form id="outboundForm" method="post" class="needs-validation" novalidate data-form-mode="@(isEdit ? "edit" : "create")" data-outbound-id="@Model.Id">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div id="outbound-form-alert" class="alert alert-danger d-none" role="alert"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-buildings"></i>@Localizer["SectionWarehouse"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="WarehouseId" class="form-label fw-medium">@Localizer["FieldWarehouse"] <span class="text-danger">*</span></label>
                            <select asp-for="WarehouseId" class="form-select" data-placeholder="@Localizer["FieldWarehouse"]" required disabled="@isEdit">
                                <option value=""></option>
                            </select>
                            <div class="invalid-feedback d-block" id="WarehouseIdError"></div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="StagingLocationId" class="form-label fw-medium">@Localizer["FieldStaging"]</label>
                            <select asp-for="StagingLocationId" class="form-select" data-placeholder="@Localizer["FieldStaging"]" disabled="@isEdit">
                                <option value=""></option>
                            </select>
                            <small class="text-muted">@Localizer["FieldStagingHint"]</small>
                            <div class="invalid-feedback d-block" id="StagingLocationIdError"></div>
                        </div>
                        @* FU01 §8.6 (D-3): the order reference is free text in v1, alone in its .diten-field — no "pick from an order" button, hint or empty picker *@
                        <div class="col-12">
                            <label asp-for="OrderRef" class="form-label fw-medium">@Localizer["FieldOrderRef"]</label>
                            <div class="diten-field">
                                <i class="bx bx-receipt diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="OrderRef" class="form-control" maxlength="100" autocomplete="off" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            @*
                MOD-0178-FU01 DL-1 (pack §8.2, D-1): the lines are a DataTable v2 table in CLIENT mode — its source is the page's in-memory line array
                (unsaved lines are not on the server), at most 100 rows (WMS-BUNDLE lines maxItems 100). No export / print / bulk / filter / page size:
                meaningless for unsaved lines (G-FU01-01, Q-8). Create adds and edits a line in the side panel (_LineOffcanvas); Edit draws the same table
                READ-ONLY (no toolbar, no row menu) from the saved outbound — the lines and their allocation never change (§8.17).
            *@
            <section class="card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <h6 class="card-section-title mb-0"><i class="bx bx-list-ol"></i>@Localizer["SectionLines"]</h6>
                        @if (!isEdit)
                        {
                            <div class="d-flex flex-wrap gap-2" id="outbound-lines-toolbar">
                                <button type="button" class="btn btn-label-secondary wh-touch" id="btnAddLine" aria-describedby="outbound-lines-limit"><i class="bx bx-plus me-1"></i>@Localizer["LineAdd"]</button>
                                <button type="button" class="btn btn-label-primary wh-touch" id="btnPreview"><i class="bx bx-search-alt me-1"></i>@Localizer["Warehouse.Outbound.Action.Preview"]</button>
                            </div>
                        }
                    </div>
                    @if (isEdit)
                    {
                        <p class="text-muted mb-3">@Localizer["LinesLockedHint"]</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-2">@Localizer["PreviewNotReservation"]</p>
                        <small class="d-block text-warning mb-2 d-none" id="outbound-lines-limit">@Localizer["LineLimitReached"]</small>
                    }
                    <div class="table-responsive">
                        <table id="outbound-lines-table" data-dt-standard="v2" data-dt-data-mode="client" class="table table-sm border-top mb-0" data-readonly="@(isEdit ? "true" : "false")">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["LineOrderLine"]</th>
                                    <th scope="col">@Localizer["LineProduct"]</th>
                                    <th scope="col">@Localizer["LineSku"]</th>
                                    <th scope="col" class="text-end">@Localizer["LineQuantity"]</th>
                                    <th scope="col">@Localizer["LinesTable.Lot"]</th>
                                    <th scope="col" class="text-end">@(isEdit ? Localizer["AllocQuantity"] : Localizer["LinesTable.Allocatable"])</th>
                                    <th scope="col">@(isEdit ? Localizer["AllocRelease"] : Localizer["LinesTable.Status"])</th>
                                    @if (!isEdit)
                                    {
                                        <th scope="col" class="cell-fit text-end">@Localizer["Actions"]</th>
                                    }
                                </tr>
                            </thead>
                            <tbody id="outbound-lines-body"></tbody>
                        </table>
                    </div>
                    <div class="invalid-feedback d-block" id="LinesError"></div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-user-pin"></i>@Localizer["SectionShipTo"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ShipToName" class="form-label fw-medium">@Localizer["FieldShipToName"] <span class="text-danger">*</span></label>
                            <input asp-for="ShipToName" class="form-control" maxlength="200" autocomplete="off" required />
                        </div>
                        <div class="col-12 col-md-6 col-lg-12">
                            <label asp-for="ShipToCountry" class="form-label fw-medium">@Localizer["FieldCountry"] <span class="text-danger">*</span></label>
                            <input asp-for="ShipToCountry" class="form-control" maxlength="200" autocomplete="off" required />
                        </div>
                        <div class="col-12 col-md-6 col-lg-12">
                            <label asp-for="ShipToCity" class="form-label fw-medium">@Localizer["FieldCity"]</label>
                            <input asp-for="ShipToCity" class="form-control" maxlength="200" autocomplete="off" />
                        </div>
                        <div class="col-12">
                            <label asp-for="ShipToPostalCode" class="form-label fw-medium">@Localizer["FieldPostalCode"]</label>
                            <input asp-for="ShipToPostalCode" class="form-control" maxlength="200" autocomplete="off" />
                        </div>
                        <div class="col-12">
                            <label asp-for="ShipToLine1" class="form-label fw-medium">@Localizer["FieldLine1"]</label>
                            <input asp-for="ShipToLine1" class="form-control" maxlength="200" autocomplete="off" />
                        </div>
                        <div class="col-12">
                            <label asp-for="ShipToLine2" class="form-label fw-medium">@Localizer["FieldLine2"]</label>
                            <input asp-for="ShipToLine2" class="form-control" maxlength="200" autocomplete="off" />
                        </div>
                    </div>
                    <div class="invalid-feedback d-block" id="ShipToError"></div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-note"></i>@Localizer["SectionNote"]</h6>
                    <label asp-for="Note" class="form-label fw-medium">@Localizer["FieldNote"]</label>
                    <textarea asp-for="Note" class="form-control" rows="4" maxlength="1000"></textarea>
                </div>
            </section>
        </div>
    </div>
</form>

@if (!isEdit)
{
    <partial name="~/Views/Warehouse/OutboundShipments/_LineOffcanvas.cshtml" />
}
