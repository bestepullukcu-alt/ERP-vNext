@using Diten.Web.Views.Warehouse.WarehouseActivity
@using Diten.Web.Models.Warehouse
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WarehouseActivityIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@*
    Filters = the listWarehouseActivity parameters (WMS draft §9): the date range (mandatory at the service, at most 31 days — empty here = the last
    7 days, the proxy fills it), the source (task / outbound / movement) and the warehouse (LOCATION master).
*@
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    <div class="filter-chip filter-from">
                        <input id="filterFrom" type="date" class="form-control form-control-sm" aria-label="@Localizer["FilterFrom"]" title="@Localizer["FilterFrom"]" />
                    </div>

                    <div class="filter-chip filter-to">
                        <input id="filterTo" type="date" class="form-control form-control-sm" aria-label="@Localizer["FilterTo"]" title="@Localizer["FilterTo"]" />
                    </div>

                    <div class="filter-chip filter-source">
                        <select id="filterSource" class="form-select form-select-sm" data-placeholder="@Localizer["FilterSource"]" aria-label="@Localizer["FilterSource"]">
                            <option value=""></option>
                            @foreach (var source in WarehouseVocabulary.ActivitySources)
                            {
                                <option value="@source">@Localizer["Warehouse.Activity.Source." + source]</option>
                            }
                        </select>
                    </div>

                    <div class="filter-chip filter-warehouse">
                        <select id="filterWarehouse" class="form-select form-select-sm" data-placeholder="@Localizer["FilterWarehouse"]" aria-label="@Localizer["FilterWarehouse"]">
                            <option value=""></option>
                        </select>
                    </div>

                    <small class="text-muted" id="activity-range-hint">@Localizer["RangeHint"]</small>
                    <small id="activity-picker-unavailable" class="text-muted d-none"></small>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
