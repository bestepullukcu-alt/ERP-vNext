@using Diten.Web.Views.Warehouse.WarehouseLocationRoles
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WarehouseLocationRolesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@* Filters = the listLocationRoles parameters: warehouse (LOCATION master) and role (the contract's WarehouseRole enum). *@
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    <div class="filter-chip filter-warehouse">
                        <select id="filterWarehouse" class="form-select form-select-sm" data-placeholder="@Localizer["FilterWarehouse"]" aria-label="@Localizer["FilterWarehouse"]">
                            <option value=""></option>
                        </select>
                    </div>

                    <div class="filter-chip filter-role">
                        <select id="filterRole" class="form-select form-select-sm select2" data-placeholder="@Localizer["FilterRole"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="Receiving">@Localizer["Warehouse.Role.Receiving"]</option>
                            <option value="Staging">@Localizer["Warehouse.Role.Staging"]</option>
                        </select>
                    </div>

                    <small id="roles-picker-unavailable" class="text-muted d-none"></small>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
