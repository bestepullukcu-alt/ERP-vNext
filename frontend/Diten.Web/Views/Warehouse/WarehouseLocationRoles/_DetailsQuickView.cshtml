@using Diten.Web.Views.Warehouse.WarehouseLocationRoles
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WarehouseLocationRolesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@* QuickView: the node, its roles, its own accepted storage conditions and the set in force (inherited from an ancestor: "üst düğümden"). *@
<div class="offcanvas offcanvas-end backbone-preview-offcanvas" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="offcanvasDetailsPreviewLabel">
    <div class="offcanvas-header p-4">
        <div class="d-flex align-items-center min-w-0">
            <div class="backbone-preview-avatar d-flex align-items-center justify-content-center me-3 flex-shrink-0">
                <i class="bx bx-map-pin fs-4"></i>
            </div>
            <div class="min-w-0">
                <h5 id="offcanvasDetailsPreviewLabel" class="offcanvas-title mb-0 text-truncate">-</h5>
                <small id="oc-subtitle" class="text-muted d-block text-truncate">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-4 border-top">
        <div class="d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                <dl class="row g-3 mb-0">
                    <dt class="col-5 text-muted fw-normal">@Localizer["ColWarehouse"]</dt><dd class="col-7 mb-0" id="oc-warehouse">-</dd>
                    <dt class="col-5 text-muted fw-normal">@Localizer["ColRoles"]</dt><dd class="col-7 mb-0" id="oc-roles">-</dd>
                    <dt class="col-5 text-muted fw-normal">@Localizer["FieldConditions"]</dt><dd class="col-7 mb-0" id="oc-accepted">-</dd>
                    <dt class="col-5 text-muted fw-normal">@Localizer["ColConditions"]</dt><dd class="col-7 mb-0" id="oc-effective">-</dd>
                    <dt class="col-5 text-muted fw-normal">@Localizer["ColNote"]</dt><dd class="col-7 mb-0 text-break" id="oc-note">-</dd>
                </dl>
            </section>
        </div>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2 bg-white">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" id="oc-btn-edit" class="btn btn-primary d-none" data-bs-dismiss="offcanvas">@Localizer["Warehouse.Action.EditRole"]</button>
    </div>
</div>
