@using Diten.Web.Views.TalentEcosystem.IndustrySkillPassport
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<IndustrySkillPassportIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["IndustrySkillPassportTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.industry-skill-passport.manage");
    var canEvaluate = Perms.Has("tep.industry-skill-passport.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["IndustrySkillPassportTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="industry-skill-passport-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-industry-skill-passport" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/IndustrySkillPassport/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/IndustrySkillPassport/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/IndustrySkillPassport/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/IndustrySkillPassport/index.js" asp-append-version="true"></script>
}
