@using Diten.Web.Views.TalentEcosystem.TepShellMetadata
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TepShellMetadataIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<script id="tep-shell-metadata-l10n" type="application/json">
    @Json.Serialize(new
    {
        Actions = Localizer["Actions"].Value,
        ColumnVisibility = SharedLocalizer["ColumnVisibility"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
        Export = SharedLocalizer["Export"].Value,
        Loading = SharedLocalizer["Loading"].Value,
        ManageDisabled = Localizer["ManageDisabled"].Value,
        NotAvailable = SharedLocalizer["NotAvailable"].Value,
        ViewDetails = SharedLocalizer["ViewDetails"].Value,
        Code = Localizer["Code"].Value,
        DisplayName = Localizer["DisplayName"].Value,
        ShellState = Localizer["ShellState"].Value,
        HcmFoundationState = Localizer["HcmFoundationState"].Value,
        PrivacyLegalState = Localizer["PrivacyLegalState"].Value,
        ConsentBoundaryState = Localizer["ConsentBoundaryState"].Value,
        VisibilityBoundaryState = Localizer["VisibilityBoundaryState"].Value,
        ShellVersion = Localizer["ShellVersion"].Value
    })
</script>
