@using Diten.Web.Views.TalentEcosystem.TepShellMetadata
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TepShellMetadataIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-tep-shell-metadata" data-dt-standard="v2" class="datatables-tep-shell-metadata table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["DisplayName"]</th>
                    <th>@Localizer["ShellState"]</th>
                    <th>@Localizer["HcmFoundationState"]</th>
                    <th>@Localizer["PrivacyLegalState"]</th>
                    <th>@Localizer["ConsentBoundaryState"]</th>
                    <th>@Localizer["VisibilityBoundaryState"]</th>
                    <th>@Localizer["ShellVersion"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
