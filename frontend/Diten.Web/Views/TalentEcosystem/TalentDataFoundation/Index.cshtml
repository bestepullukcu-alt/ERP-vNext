@using Diten.Web.Views.TalentEcosystem.TalentDataFoundation
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TalentDataFoundationIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["TalentDataFoundationTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.talent-data-foundation.manage");
    var canEvaluate = Perms.Has("tep.talent-data-foundation.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["TalentDataFoundationTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="talent-data-foundation-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-talent-data-foundation" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/TalentDataFoundation/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/TalentDataFoundation/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/TalentDataFoundation/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/TalentDataFoundation/index.js" asp-append-version="true"></script>
}
