@using Diten.Web.Views.TalentEcosystem.IndustrySuccessionPool
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<IndustrySuccessionPoolIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["IndustrySuccessionPoolTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.industry-succession-pool.manage");
    var canEvaluate = Perms.Has("tep.industry-succession-pool.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["IndustrySuccessionPoolTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="industry-succession-pool-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-industry-succession-pool" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/IndustrySuccessionPool/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/IndustrySuccessionPool/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/IndustrySuccessionPool/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/IndustrySuccessionPool/index.js" asp-append-version="true"></script>
}
