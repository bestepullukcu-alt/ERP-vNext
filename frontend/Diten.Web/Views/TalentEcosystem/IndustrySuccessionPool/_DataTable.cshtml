@using Diten.Web.Views.TalentEcosystem.IndustrySuccessionPool
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<IndustrySuccessionPoolIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-industry-succession-pool" data-dt-standard="v2" class="datatables-industry-succession-pool table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th class="all">@Localizer["DisplayName"]</th>
                    <th>@Localizer["IndustrySuccessionPoolReadinessState"]</th>
                    <th>@Localizer["PoolCatalogBoundaryState"]</th>
                    <th>@Localizer["TalentDataSourceDependencyState"]</th>
                    <th>@Localizer["VisibilityControlBoundaryState"]</th>
                    <th>@Localizer["AutomatedDecisionBoundaryState"]</th>
                    <th>@Localizer["SourceContractVersion"]</th>
                    <th>@Localizer["LastEvaluatedAt"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
