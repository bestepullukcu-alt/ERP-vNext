@using Diten.Web.Views.TalentEcosystem.AssociationOperations
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AssociationOperationsIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["AssociationOperationsTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.association-operations.manage");
    var canEvaluate = Perms.Has("tep.association-operations.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["AssociationOperationsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="association-operations-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-association-operations" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/AssociationOperations/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/AssociationOperations/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/AssociationOperations/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/AssociationOperations/index.js" asp-append-version="true"></script>
}
