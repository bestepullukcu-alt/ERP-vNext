@using Diten.Web.Views.TalentEcosystem.EarlyWarningSignals
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<EarlyWarningSignalsIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["EarlyWarningSignalsTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.early-warning-signals.manage");
    var canEvaluate = Perms.Has("tep.early-warning-signals.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["EarlyWarningSignalsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="early-warning-signals-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-early-warning-signals" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/EarlyWarningSignals/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/EarlyWarningSignals/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/EarlyWarningSignals/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/EarlyWarningSignals/index.js" asp-append-version="true"></script>
}
