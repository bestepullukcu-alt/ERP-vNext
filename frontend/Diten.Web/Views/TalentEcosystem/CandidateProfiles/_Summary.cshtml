@using Diten.Web.Views.TalentEcosystem.CandidateProfiles
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CandidateProfilesIndex> Localizer

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-primary">
                        <i class="bx bx-id-card"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["IdentityBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["IdentityBoundaryDescription"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-info">
                        <i class="bx bx-user-badge"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["ProfileBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["ProfileBoundaryDescription"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-warning">
                        <i class="bx bx-lock-alt"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["PolicyBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["PolicyBoundaryDescription"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
