@using Diten.Web.Views.TalentEcosystem.ConsentVisibilityPolicies
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ConsentVisibilityPoliciesIndex> Localizer

<div class="row g-3 mb-3">
    <div class="col-xl-4 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="mb-1">@Localizer["RestrictedBoundary"]</h6>
                <p class="mb-0 text-muted small">@Localizer["RestrictedBoundaryDescription"]</p>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="mb-1">@Localizer["ReadonlyBoundary"]</h6>
                <p class="mb-0 text-muted small">@Localizer["ReadonlyBoundaryDescription"]</p>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-12">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="mb-1">@Localizer["AuditBoundary"]</h6>
                <p class="mb-0 text-muted small">@Localizer["AuditBoundaryDescription"]</p>
            </div>
        </div>
    </div>
</div>
