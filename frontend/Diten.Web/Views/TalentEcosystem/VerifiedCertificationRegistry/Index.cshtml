@using Diten.Web.Views.TalentEcosystem.VerifiedCertificationRegistry
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VerifiedCertificationRegistryIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["VerifiedCertificationRegistryTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.verified-certification-registry.manage");
    var canEvaluate = Perms.Has("tep.verified-certification-registry.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["VerifiedCertificationRegistryTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="verified-certification-registry-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-verified-certification-registry" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/VerifiedCertificationRegistry/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/VerifiedCertificationRegistry/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/VerifiedCertificationRegistry/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/VerifiedCertificationRegistry/index.js" asp-append-version="true"></script>
}
