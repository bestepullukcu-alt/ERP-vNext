@using Diten.Web.Views.TalentEcosystem.TalentSupplyDemandForecasting
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TalentSupplyDemandForecastingIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["TalentSupplyDemandForecastingTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.talent-supply-demand-forecasting.manage");
    var canEvaluate = Perms.Has("tep.talent-supply-demand-forecasting.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["TalentSupplyDemandForecastingTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="talent-supply-demand-forecasting-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-talent-supply-demand-forecasting" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/TalentSupplyDemandForecasting/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/TalentSupplyDemandForecasting/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/TalentSupplyDemandForecasting/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/TalentSupplyDemandForecasting/index.js" asp-append-version="true"></script>
}
