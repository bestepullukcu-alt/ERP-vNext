@using Diten.Web.Views.TalentEcosystem.TrustLevels
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TrustLevelsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<script id="trust-levels-l10n" type="application/json">
    @Json.Serialize(new
    {
        Actions = Localizer["Actions"].Value,
        AuditMetadata = Localizer["AuditMetadata"].Value,
        ColumnVisibility = SharedLocalizer["ColumnVisibility"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
        EvaluateDisabled = Localizer["EvaluateDisabled"].Value,
        Export = SharedLocalizer["Export"].Value,
        Loading = SharedLocalizer["Loading"].Value,
        ManageDisabled = Localizer["ManageDisabled"].Value,
        NotAvailable = SharedLocalizer["NotAvailable"].Value,
        ViewDetails = SharedLocalizer["ViewDetails"].Value,
        Code = Localizer["Code"].Value,
        DisplayName = Localizer["DisplayName"].Value,
        TrustLevelPolicyState = Localizer["TrustLevelPolicyState"].Value,
        TrustValidationState = Localizer["TrustValidationState"].Value,
        MultiSignatureRequirementState = Localizer["MultiSignatureRequirementState"].Value,
        ActivationState = Localizer["ActivationState"].Value,
        TrustPolicyVersion = Localizer["TrustPolicyVersion"].Value
    })
</script>
