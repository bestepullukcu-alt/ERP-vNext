@using Diten.Web.Views.TalentEcosystem.ProfessionalReputationLedger
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ProfessionalReputationLedgerIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["ProfessionalReputationLedgerTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.professional-reputation-ledger.manage");
    var canEvaluate = Perms.Has("tep.professional-reputation-ledger.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["ProfessionalReputationLedgerTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="professional-reputation-ledger-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-professional-reputation-ledger" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/ProfessionalReputationLedger/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/ProfessionalReputationLedger/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/ProfessionalReputationLedger/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/ProfessionalReputationLedger/index.js" asp-append-version="true"></script>
}
