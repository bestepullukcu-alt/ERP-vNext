@using Diten.Web.Views.TalentEcosystem.AssociationMemberships
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AssociationMembershipsIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-association-memberships" data-dt-standard="v2" class="datatables-association-memberships table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["DisplayName"]</th>
                    <th>@Localizer["AssociationMembershipState"]</th>
                    <th>@Localizer["MemberCompanyState"]</th>
                    <th>@Localizer["PolicyEvaluationState"]</th>
                    <th>@Localizer["VisibilityApprovalState"]</th>
                    <th>@Localizer["AssociationActivationState"]</th>
                    <th>@Localizer["RegistryVersion"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
