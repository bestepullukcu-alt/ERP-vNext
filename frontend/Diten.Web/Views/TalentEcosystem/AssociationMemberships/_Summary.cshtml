@using Diten.Web.Views.TalentEcosystem.AssociationMemberships
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AssociationMembershipsIndex> Localizer

<div class="row g-3 mb-3">
    <div class="col-xl-4 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="mb-1">@Localizer["RegistryBoundary"]</h6>
                <p class="mb-0 text-muted small">@Localizer["RegistryBoundaryDescription"]</p>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="mb-1">@Localizer["ReadonlyBoundary"]</h6>
                <p class="mb-0 text-muted small">@Localizer["ReadonlyBoundaryDescription"]</p>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-12">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="mb-1">@Localizer["PolicyBoundary"]</h6>
                <p class="mb-0 text-muted small">@Localizer["PolicyBoundaryDescription"]</p>
            </div>
        </div>
    </div>
</div>
