@using Diten.Web.Views.TalentEcosystem.CandidateDisputes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CandidateDisputesIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-candidate-disputes" data-dt-standard="v2" class="datatables-candidate-disputes table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["DisplayName"]</th>
                    <th>@Localizer["DisputeReadinessState"]</th>
                    <th>@Localizer["ResponseBoundaryState"]</th>
                    <th>@Localizer["DisputeReviewState"]</th>
                    <th>@Localizer["ConsentPreconditionState"]</th>
                    <th>@Localizer["DisputeReadinessVersion"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
