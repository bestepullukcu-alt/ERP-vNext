@using Diten.Web.Views.TalentEcosystem.CandidateDisputes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CandidateDisputesIndex> Localizer

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-primary">
                        <i class="bx bx-message-square-detail"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["ReadinessBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["ReadinessBoundaryDescription"]</p>
                        <div class="fw-semibold mt-2" data-summary-field="total">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-info">
                        <i class="bx bx-check-shield"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["ReviewBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["ReviewBoundaryDescription"]</p>
                        <div class="fw-semibold mt-2" data-summary-field="ready">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-warning">
                        <i class="bx bx-time-five"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["DeferredBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["DeferredBoundaryDescription"]</p>
                        <div class="fw-semibold mt-2" data-summary-field="deferred">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
