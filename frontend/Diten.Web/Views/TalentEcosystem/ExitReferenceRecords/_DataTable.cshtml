@using Diten.Web.Views.TalentEcosystem.ExitReferenceRecords
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ExitReferenceRecordsIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-exit-reference-records" data-dt-standard="v2" class="datatables-exit-reference-records table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["DisplayName"]</th>
                    <th>@Localizer["ReferenceRecordState"]</th>
                    <th>@Localizer["ReferenceSharingState"]</th>
                    <th>@Localizer["ConsentPreconditionState"]</th>
                    <th>@Localizer["VisibilityApprovalState"]</th>
                    <th>@Localizer["ReferenceRecordVersion"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
