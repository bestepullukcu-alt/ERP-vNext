@using Diten.Web.Views.TalentEcosystem.CandidateCareerPassport
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CandidateCareerPassportIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["CandidateCareerPassportTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.candidate-career-passport.manage");
    var canEvaluate = Perms.Has("tep.candidate-career-passport.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["CandidateCareerPassportTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="candidate-career-passport-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-candidate-career-passport" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/CandidateCareerPassport/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/CandidateCareerPassport/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/CandidateCareerPassport/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/CandidateCareerPassport/index.js" asp-append-version="true"></script>
}
