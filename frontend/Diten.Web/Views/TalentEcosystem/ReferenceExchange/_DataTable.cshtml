@using Diten.Web.Views.TalentEcosystem.ReferenceExchange
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReferenceExchangeIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-reference-exchange" data-dt-standard="v2" class="datatables-reference-exchange table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["DisplayName"]</th>
                    <th>@Localizer["ExchangeReadinessState"]</th>
                    <th>@Localizer["ExchangeAvailabilityState"]</th>
                    <th>@Localizer["ParticipantEligibilityState"]</th>
                    <th>@Localizer["ConsentPreconditionState"]</th>
                    <th>@Localizer["ReferenceExchangeVersion"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
