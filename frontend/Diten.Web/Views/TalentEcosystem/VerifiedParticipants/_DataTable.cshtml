@using Diten.Web.Views.TalentEcosystem.VerifiedParticipants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VerifiedParticipantsIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-verified-participants" data-dt-standard="v2" class="datatables-verified-participants table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["DisplayName"]</th>
                    <th>@Localizer["VerificationState"]</th>
                    <th>@Localizer["AccessState"]</th>
                    <th>@Localizer["PolicyEvaluationState"]</th>
                    <th>@Localizer["VisibilityApprovalState"]</th>
                    <th>@Localizer["VerifiedCompanyAccessState"]</th>
                    <th>@Localizer["VerificationVersion"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
