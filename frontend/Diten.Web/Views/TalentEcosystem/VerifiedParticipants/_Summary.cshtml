@using Diten.Web.Views.TalentEcosystem.VerifiedParticipants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VerifiedParticipantsIndex> Localizer

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-primary">
                        <i class="bx bx-user-check"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["VerificationBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["VerificationBoundaryDescription"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-info">
                        <i class="bx bx-buildings"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["AccessBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["AccessBoundaryDescription"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-warning">
                        <i class="bx bx-shield-quarter"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["PolicyBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["PolicyBoundaryDescription"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
