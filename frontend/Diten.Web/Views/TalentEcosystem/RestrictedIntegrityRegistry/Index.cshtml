@using Diten.Web.Views.TalentEcosystem.RestrictedIntegrityRegistry
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<RestrictedIntegrityRegistryIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["RestrictedIntegrityRegistryTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.restricted-integrity-registry.manage");
    var canEvaluate = Perms.Has("tep.restricted-integrity-registry.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["RestrictedIntegrityRegistryTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="restricted-integrity-registry-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-restricted-integrity-registry" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/RestrictedIntegrityRegistry/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/RestrictedIntegrityRegistry/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/RestrictedIntegrityRegistry/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/RestrictedIntegrityRegistry/index.js" asp-append-version="true"></script>
}
