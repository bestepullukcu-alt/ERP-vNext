@using Diten.Web.Views.TalentEcosystem.PayBenchmarking
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PayBenchmarkingIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["PayBenchmarkingTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.salary-benchmarking.manage");
    var canEvaluate = Perms.Has("tep.salary-benchmarking.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["PayBenchmarkingTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="salary-benchmarking-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-salary-benchmarking" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/PayBenchmarking/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/PayBenchmarking/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/PayBenchmarking/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/PayBenchmarking/index.js" asp-append-version="true"></script>
}
