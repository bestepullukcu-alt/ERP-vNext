@using Diten.Web.Views.TalentEcosystem.IndustryTalentPool
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<IndustryTalentPoolIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["IndustryTalentPoolTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.industry-talent-pool.manage");
    var canEvaluate = Perms.Has("tep.industry-talent-pool.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["IndustryTalentPoolTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="industry-talent-pool-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-industry-talent-pool" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/IndustryTalentPool/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/IndustryTalentPool/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/IndustryTalentPool/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/IndustryTalentPool/index.js" asp-append-version="true"></script>
}
