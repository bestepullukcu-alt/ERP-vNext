@using Diten.Web.Views.TalentEcosystem.TalentDevelopmentNetwork
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TalentDevelopmentNetworkIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["TalentDevelopmentNetworkTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.talent-development-network.manage");
    var canEvaluate = Perms.Has("tep.talent-development-network.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["TalentDevelopmentNetworkTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="talent-development-network-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-talent-development-network" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/TalentDevelopmentNetwork/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/TalentDevelopmentNetwork/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/TalentDevelopmentNetwork/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/TalentDevelopmentNetwork/index.js" asp-append-version="true"></script>
}
