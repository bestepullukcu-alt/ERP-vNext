@using Diten.Web.Views.TalentEcosystem.WorkforceAnalytics
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WorkforceAnalyticsIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["WorkforceAnalyticsTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("tep.workforce-analytics.manage");
    var canEvaluate = Perms.Has("tep.workforce-analytics.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["WorkforceAnalyticsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="workforce-analytics-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-workforce-analytics" data-dt-standard="v2"> *@
    <partial name="~/Views/TalentEcosystem/WorkforceAnalytics/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/TalentEcosystem/WorkforceAnalytics/_IndexL10n.cshtml" />
    <script src="~/assets/js/TalentEcosystem/WorkforceAnalytics/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/TalentEcosystem/WorkforceAnalytics/index.js" asp-append-version="true"></script>
}
