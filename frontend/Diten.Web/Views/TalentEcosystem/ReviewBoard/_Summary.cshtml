@using Diten.Web.Views.TalentEcosystem.ReviewBoard
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReviewBoardIndex> Localizer

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-primary">
                        <i class="bx bx-clipboard"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["CaseBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["CaseBoundaryDescription"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-warning">
                        <i class="bx bx-check-shield"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["DecisionBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["DecisionBoundaryDescription"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-label-info">
                        <i class="bx bx-shield-quarter"></i>
                    </span>
                    <div>
                        <h6 class="mb-1">@Localizer["GovernanceBoundary"]</h6>
                        <p class="mb-0 text-muted small">@Localizer["GovernanceBoundaryDescription"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
