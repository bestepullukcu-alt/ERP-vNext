@model Diten.Web.Models.Procurement.InvoiceMatch.InvoiceMatchEditViewModel
@using Diten.Web.Views.Procurement.InvoiceMatch
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<InvoiceMatchIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
    var action = isEdit ? "Edit" : "Create";
    var lines = (Model.Lines is { Count: > 0 }) ? Model.Lines : [new Diten.Web.Models.Procurement.InvoiceMatch.InvoiceLineInput()];
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/InvoiceMatch">@Localizer["InvoiceMatchTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/InvoiceMatch" class="btn btn-label-secondary">
            @SharedLocalizer["Cancel"]
        </a>
        <button type="submit" form="invoiceMatchForm" class="btn btn-primary">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>

<form id="invoiceMatchForm" asp-controller="InvoiceMatch" asp-action="@action" asp-route-id="@Model.InvoiceId" method="post"
    class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InvoiceId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Main Column (Left) -->
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-receipt"></i>@Localizer["InvoiceSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="SupplierId" class="form-label fw-medium">@Localizer["SupplierId"] <span class="text-danger">*</span></label>
                            <div class="diten-field">
                                <i class="bx bx-store diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="SupplierId" class="form-control" maxlength="120" placeholder="@Localizer["SupplierIdPlaceholder"]" required />
                            </div>
                            <span asp-validation-for="SupplierId" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="PoId" class="form-label fw-medium">@Localizer["PoId"] <span class="text-danger">*</span></label>
                            <div class="diten-field">
                                <i class="bx bx-cart diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="PoId" class="form-control" maxlength="120" placeholder="@Localizer["PoIdPlaceholder"]" required />
                            </div>
                            <span asp-validation-for="PoId" class="text-danger small mt-1"></span>
                            <span class="text-muted small mt-1 d-block">@Localizer["PoIdHint"]</span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="InvoiceNumber" class="form-label fw-medium">@Localizer["InvoiceNumber"] <span class="text-danger">*</span></label>
                            <div class="diten-field">
                                <i class="bx bx-hash diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="InvoiceNumber" class="form-control" maxlength="120" placeholder="@Localizer["InvoiceNumberPlaceholder"]" required />
                            </div>
                            <span asp-validation-for="InvoiceNumber" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Currency" class="form-label fw-medium">@Localizer["Currency"] <span class="text-danger">*</span></label>
                            <div class="diten-field">
                                <i class="bx bx-dollar-circle diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="Currency" class="form-control" maxlength="3" placeholder="@Localizer["CurrencyPlaceholder"]" required />
                            </div>
                            <span asp-validation-for="Currency" class="text-danger small mt-1"></span>
                            <span class="text-muted small mt-1 d-block">@Localizer["CurrencyHint"]</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h6 class="card-section-title mb-0"><i class="bx bx-list-ul"></i>@Localizer["LinesSection"]</h6>
                        <button type="button" class="btn btn-sm btn-label-primary" id="btnAddLine">
                            <i class="bx bx-plus me-1"></i>@Localizer["AddLine"]
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0" id="invoiceLinesTable">
                            <thead>
                                <tr>
                                    <th>@Localizer["LineItemId"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineQuantity"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineUnitPrice"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineAmount"]</th>
                                    <th>@Localizer["LinePoLineId"]</th>
                                    <th class="cell-fit"></th>
                                </tr>
                            </thead>
                            <tbody id="invoiceLinesBody" data-line-prefix="Lines">
                                @for (var i = 0; i < lines.Count; i++)
                                {
                                    <tr class="invoice-line-row">
                                        <td>
                                            <input asp-for="Lines[i].ItemId" class="form-control form-control-sm invoice-line-input" data-line-field="ItemId" placeholder="@Localizer["LineItemIdPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].Quantity" class="form-control form-control-sm invoice-line-input" data-line-field="Quantity" inputmode="decimal" pattern="^-?\d+(\.\d+)?$" placeholder="@Localizer["LineQuantityPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].UnitPrice" class="form-control form-control-sm invoice-line-input" data-line-field="UnitPrice" inputmode="decimal" pattern="^-?\d+(\.\d+)?$" placeholder="@Localizer["LineUnitPricePlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].LineAmount" class="form-control form-control-sm invoice-line-input" data-line-field="LineAmount" inputmode="decimal" pattern="^-?\d+(\.\d+)?$" placeholder="@Localizer["LineAmountPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].PoLineId" class="form-control form-control-sm invoice-line-input" data-line-field="PoLineId" placeholder="@Localizer["LinePoLineIdPlaceholder"]" />
                                        </td>
                                        <td class="cell-fit">
                                            <button type="button" class="btn btn-icon btn-sm btn-label-danger invoice-line-remove" title="@SharedLocalizer["Delete"]">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-2 mb-0">@Localizer["LinesHint"]</p>
                </div>
            </section>
        </div>

        <!-- Sidebar Column (Right) -->
        <div class="col-12 col-lg-4">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-server"></i>@Localizer["IntegrationSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="SourceSystem" class="form-label fw-medium">@Localizer["SourceSystem"]</label>
                            <div class="diten-field">
                                <i class="bx bx-data diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="SourceSystem" class="form-control" maxlength="120" placeholder="@Localizer["SourceSystemPlaceholder"]" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="ExternalRef" class="form-label fw-medium">@Localizer["ExternalRef"]</label>
                            <div class="diten-field">
                                <i class="bx bx-link diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="ExternalRef" class="form-control" maxlength="120" placeholder="@Localizer["ExternalRefPlaceholder"]" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

</form>
