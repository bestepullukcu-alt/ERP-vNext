@model Diten.Web.Models.Procurement.Grn.GrnEditViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.Views.Procurement.Grn.GrnIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = SharedLocalizer["Details"].Value;
    Layout = "_LayoutTenantShell";

    var status = Model.Status ?? "Draft";
    var statusClass = status switch
    {
        "Draft" => "bg-label-secondary",
        "Posted" => "bg-label-success",
        "Reversed" => "bg-label-danger",
        _ => "bg-label-primary"
    };
    var statusText = status switch
    {
        "Draft" => Localizer["StatusDraft"].Value,
        "Posted" => Localizer["StatusPosted"].Value,
        "Reversed" => Localizer["StatusReversed"].Value,
        _ => status
    };

    // Reverse is the only lifecycle action (ASSUMPTION-GRN-02): a Posted receipt is corrected by an INVENTORY
    // REVERSAL, never by an edit (DEC-INV-07 append-only). UAS-001: no button without the reverse permission.
    var canReverse = Perms.Has("procurement.grn.reverse") && status == "Posted";
}

<div class="grn-details" data-grn-id="@Model.GrnId">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h5 class="mb-0">@SharedLocalizer["Details"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/Grn">@Localizer["GrnTitle"]</a>
                    </li>
                    <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Grn" class="btn btn-label-secondary">
                @SharedLocalizer["Back"]
            </a>
            @if (canReverse)
            {
                <button type="button" class="btn btn-danger" id="btnReverseGrn">
                    <i class="bx bx-undo me-1"></i>@Localizer["ActionReverse"]
                </button>
            }
        </div>
    </div>

    <div class="row g-4">
    <!-- Main Column (Left) -->
    <div class="col-12 col-lg-8 d-flex flex-column gap-4">
        <section class="card backbone-preview-section p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ReceiptSection"]</h6>
            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <div class="backbone-preview-field">
                        <i class="bx bx-package"></i>
                        <div>
                            <div class="backbone-preview-label">@Localizer["GrnId"]</div>
                            <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.GrnId) ? "-" : Model.GrnId)</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="backbone-preview-field">
                        <i class="bx bx-check-shield"></i>
                        <div>
                            <div class="backbone-preview-label">@SharedLocalizer["Status"]</div>
                            <div class="mt-1"><span class="badge @statusClass">@statusText</span></div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="backbone-preview-field">
                        <i class="bx bx-receipt"></i>
                        <div>
                            <div class="backbone-preview-label">@Localizer["PoId"]</div>
                            <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.PoId) ? "-" : Model.PoId)</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="backbone-preview-field">
                        <i class="bx bx-calendar"></i>
                        <div>
                            <div class="backbone-preview-label">@Localizer["ReceivedAt"]</div>
                            <div class="backbone-preview-value mt-1">@(Model.ReceivedAt.HasValue ? Model.ReceivedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-")</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="card backbone-preview-section p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["LinesSection"]</h6>
            @if (Model.Lines is { Count: > 0 })
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["LinePoLineId"]</th>
                                <th>@Localizer["LineQuantity"]</th>
                                <th>@Localizer["LineInventoryTransactionId"]</th>
                                <th>@Localizer["LineLotId"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(line.PoLineId) ? "-" : line.PoLineId)</td>
                                    <td>@(string.IsNullOrWhiteSpace(line.Quantity) ? "-" : line.Quantity)</td>
                                    <td class="text-break"><code>@(string.IsNullOrWhiteSpace(line.InventoryTransactionId) ? "-" : line.InventoryTransactionId)</code></td>
                                    <td class="text-break">@(string.IsNullOrWhiteSpace(line.LotId) ? "-" : line.LotId)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted small mt-2 mb-0">@Localizer["InventoryRefHint"]</p>
            }
            else
            {
                <p class="text-muted mb-0">@SharedLocalizer["NotAvailable"]</p>
            }
        </section>
    </div>

    <!-- Sidebar Column (Right) -->
    <div class="col-12 col-lg-4 d-flex flex-column gap-4">
        <section class="card backbone-preview-section p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IntegrationSection"]</h6>
            <div class="row g-4">
                <div class="col-12">
                    <div class="backbone-preview-field">
                        <i class="bx bx-data"></i>
                        <div>
                            <div class="backbone-preview-label">@Localizer["SourceSystem"]</div>
                            <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.SourceSystem) ? "-" : Model.SourceSystem)</div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="backbone-preview-field">
                        <i class="bx bx-link"></i>
                        <div>
                            <div class="backbone-preview-label">@Localizer["ExternalRef"]</div>
                            <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.ExternalRef) ? "-" : Model.ExternalRef)</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    </div>
</div>

@section Scripts {
    <script id="grn-details-l10n" type="application/json">
        @Json.Serialize(new
        {
            ActionReverse = Localizer["ActionReverse"].Value,
            ConfirmReverse = Localizer["ConfirmReverse"].Value,
            ReverseSuccess = Localizer["ReverseSuccess"].Value,
            AreYouSure = SharedLocalizer["AreYouSure"].Value,
            RecordSaved = SharedLocalizer["RecordSaved"].Value,
            ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
            NotAvailable = SharedLocalizer["NotAvailable"].Value
        })
    </script>
    <script src="~/assets/js/Procurement/Grn/details.js" asp-append-version="true"></script>
}
