@model Diten.Web.Models.Procurement.Grn.GrnEditViewModel
@using Diten.Web.Views.Procurement.Grn
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<GrnIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
    var action = isEdit ? "Edit" : "Create";
    var lines = (Model.Lines is { Count: > 0 }) ? Model.Lines : [new Diten.Web.Models.Procurement.Grn.GrnLineInput()];
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/Grn">@Localizer["GrnTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/Grn" class="btn btn-label-secondary">
            @SharedLocalizer["Cancel"]
        </a>
        <button type="submit" form="grnForm" class="btn btn-primary">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>

<form id="grnForm" asp-controller="Grn" asp-action="@action" asp-route-id="@Model.GrnId" method="post"
    class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="GrnId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Main Column (Left) -->
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-package"></i>@Localizer["ReceiptSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="WarehouseId" class="form-label fw-medium">@Localizer["WarehouseId"] <span class="text-danger">*</span></label>
                            <div class="diten-field">
                                <i class="bx bx-buildings diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="WarehouseId" class="form-control" maxlength="120" placeholder="@Localizer["WarehouseIdPlaceholder"]" required />
                            </div>
                            <span asp-validation-for="WarehouseId" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="LocationId" class="form-label fw-medium">@Localizer["LocationId"]</label>
                            <div class="diten-field">
                                <i class="bx bx-map-pin diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="LocationId" class="form-control" maxlength="120" placeholder="@Localizer["LocationIdPlaceholder"]" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="PoId" class="form-label fw-medium">@Localizer["PoId"]</label>
                            <div class="diten-field">
                                <i class="bx bx-receipt diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="PoId" class="form-control" maxlength="120" placeholder="@Localizer["PoIdPlaceholder"]" />
                            </div>
                            <span class="text-muted small mt-1 d-block">@Localizer["PoIdHint"]</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h6 class="card-section-title mb-0"><i class="bx bx-list-ul"></i>@Localizer["LinesSection"]</h6>
                        <button type="button" class="btn btn-sm btn-label-primary" id="btnAddLine">
                            <i class="bx bx-plus me-1"></i>@Localizer["AddLine"]
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0" id="grnLinesTable">
                            <thead>
                                <tr>
                                    <th>@Localizer["LineItemId"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineSkuId"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineSkuLevel"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineLotNumber"]</th>
                                    <th>@Localizer["LineSerialIds"]</th>
                                    <th>@Localizer["LineQuantity"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineUomId"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineToStockStatus"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LinePoLineId"]</th>
                                    <th class="cell-fit"></th>
                                </tr>
                            </thead>
                            <tbody id="grnLinesBody" data-line-prefix="Lines">
                                @for (var i = 0; i < lines.Count; i++)
                                {
                                    <tr class="grn-line-row">
                                        <td>
                                            <input asp-for="Lines[i].ItemId" class="form-control form-control-sm grn-line-input" data-line-field="ItemId" placeholder="@Localizer["LineItemIdPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].SkuId" class="form-control form-control-sm grn-line-input" data-line-field="SkuId" placeholder="@Localizer["LineSkuIdPlaceholder"]" />
                                        </td>
                                        <td>
                                            <select asp-for="Lines[i].SkuLevel" class="form-select form-select-sm grn-line-input" data-line-field="SkuLevel">
                                                <option value="">@Localizer["SelectPlaceholder"]</option>
                                                <option value="Gsku">@Localizer["SkuLevelGsku"]</option>
                                                <option value="Lsku">@Localizer["SkuLevelLsku"]</option>
                                                <option value="FinishedGood">@Localizer["SkuLevelFinishedGood"]</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].LotNumber" class="form-control form-control-sm grn-line-input" data-line-field="LotNumber" placeholder="@Localizer["LineLotNumberPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].SerialIds" class="form-control form-control-sm grn-line-input" data-line-field="SerialIds" placeholder="@Localizer["LineSerialIdsPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].Quantity" class="form-control form-control-sm grn-line-input" data-line-field="Quantity" inputmode="decimal" pattern="^-?\d+(\.\d+)?$" placeholder="@Localizer["LineQuantityPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].UomId" class="form-control form-control-sm grn-line-input" data-line-field="UomId" placeholder="@Localizer["LineUomIdPlaceholder"]" />
                                        </td>
                                        <td>
                                            <select asp-for="Lines[i].ToStockStatus" class="form-select form-select-sm grn-line-input" data-line-field="ToStockStatus">
                                                <option value="">@Localizer["SelectPlaceholder"]</option>
                                                <option value="AVAILABLE">@Localizer["StockAvailable"]</option>
                                                <option value="QUALITY_INSPECTION">@Localizer["StockQualityInspection"]</option>
                                                <option value="QUARANTINE">@Localizer["StockQuarantine"]</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].PoLineId" class="form-control form-control-sm grn-line-input" data-line-field="PoLineId" placeholder="@Localizer["LinePoLineIdPlaceholder"]" />
                                        </td>
                                        <td class="cell-fit">
                                            <button type="button" class="btn btn-icon btn-sm btn-label-danger grn-line-remove" title="@SharedLocalizer["Delete"]">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-2 mb-0">@Localizer["LinesHint"]</p>
                </div>
            </section>
        </div>

        <!-- Sidebar Column (Right) -->
        <div class="col-12 col-lg-4">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-server"></i>@Localizer["IntegrationSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="SourceSystem" class="form-label fw-medium">@Localizer["SourceSystem"]</label>
                            <div class="diten-field">
                                <i class="bx bx-data diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="SourceSystem" class="form-control" maxlength="120" placeholder="@Localizer["SourceSystemPlaceholder"]" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="ExternalRef" class="form-label fw-medium">@Localizer["ExternalRef"]</label>
                            <div class="diten-field">
                                <i class="bx bx-link diten-field-icon" aria-hidden="true"></i>
                                <input asp-for="ExternalRef" class="form-control" maxlength="120" placeholder="@Localizer["ExternalRefPlaceholder"]" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

</form>
