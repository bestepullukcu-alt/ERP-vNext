@model Diten.Web.Models.Procurement.PurchaseOrders.PurchaseOrdersEditViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.Views.Procurement.PurchaseOrders.PurchaseOrdersIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = SharedLocalizer["Details"].Value;
    Layout = "_LayoutTenantShell";

    var status = Model.Status ?? "Draft";
    var statusClass = status switch
    {
        "Draft" => "bg-label-secondary",
        "Approved" => "bg-label-success",
        "PartiallyReceived" => "bg-label-warning",
        "Received" => "bg-label-primary",
        "Closed" => "bg-label-dark",
        "Cancelled" => "bg-label-danger",
        _ => "bg-label-primary"
    };
    var statusText = status switch
    {
        "Draft" => Localizer["StatusDraft"].Value,
        "Approved" => Localizer["StatusApproved"].Value,
        "PartiallyReceived" => Localizer["StatusPartiallyReceived"].Value,
        "Received" => Localizer["StatusReceived"].Value,
        "Closed" => Localizer["StatusClosed"].Value,
        "Cancelled" => Localizer["StatusCancelled"].Value,
        _ => status
    };

    var canApprove = Perms.Has("procurement.purchase-orders.approve") && status == "Draft";
}

<div class="purchase-order-details" data-po-id="@Model.PoId">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h5 class="mb-0">@SharedLocalizer["Details"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/PurchaseOrders">@Localizer["PurchaseOrdersTitle"]</a>
                    </li>
                    <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/PurchaseOrders" class="btn btn-label-secondary">
                @SharedLocalizer["Back"]
            </a>
            @if (canApprove)
            {
                <button type="button" class="btn btn-success" id="btnApprovePo">
                    <i class="bx bx-check-double me-1"></i>@Localizer["ActionApprove"]
                </button>
            }
        </div>
    </div>

    <div class="row g-4">
    <!-- Main Column (Left) — LinesSection (matches _Form order) -->
    <div class="col-12 col-lg-8 d-flex flex-column gap-4">
        <section class="card backbone-preview-section p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["LinesSection"]</h6>
            @if (Model.Lines is { Count: > 0 })
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["LineItemId"]</th>
                                <th>@Localizer["LineSkuId"]</th>
                                <th>@Localizer["LineQuantity"]</th>
                                <th>@Localizer["LineUomId"]</th>
                                <th class="text-end">@Localizer["LineUnitPrice"]</th>
                                <th class="text-end">@Localizer["LineAmount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td class="text-break">@(string.IsNullOrWhiteSpace(line.ItemId) ? "-" : line.ItemId)</td>
                                    <td class="text-break">@(string.IsNullOrWhiteSpace(line.SkuId) ? "-" : line.SkuId)</td>
                                    <td>@(string.IsNullOrWhiteSpace(line.Quantity) ? "-" : line.Quantity)</td>
                                    <td>@(string.IsNullOrWhiteSpace(line.UomId) ? "-" : line.UomId)</td>
                                    <td class="text-end">@(string.IsNullOrWhiteSpace(line.UnitPrice) ? "-" : line.UnitPrice)</td>
                                    <td class="text-end">@(string.IsNullOrWhiteSpace(line.LineAmount) ? "-" : line.LineAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">@SharedLocalizer["NotAvailable"]</p>
            }
        </section>
    </div>

    <!-- Sidebar Column (Right) — PurchaseOrderSection + IntegrationSection (matches _Form order) -->
    <div class="col-12 col-lg-4 d-flex flex-column gap-4">
        <section class="card backbone-preview-section p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["PurchaseOrderSection"]</h6>
            <div class="d-flex flex-column gap-4">
                <div class="backbone-preview-field">
                    <i class="bx bx-purchase-tag-alt"></i>
                    <div>
                        <div class="backbone-preview-label">@Localizer["PoId"]</div>
                        <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.PoId) ? "-" : Model.PoId)</div>
                    </div>
                </div>
                <div class="backbone-preview-field">
                    <i class="bx bx-check-shield"></i>
                    <div>
                        <div class="backbone-preview-label">@SharedLocalizer["Status"]</div>
                        <div class="mt-1"><span class="badge @statusClass">@statusText</span></div>
                    </div>
                </div>
                <div class="backbone-preview-field">
                    <i class="bx bx-store"></i>
                    <div>
                        <div class="backbone-preview-label">@Localizer["SupplierId"]</div>
                        <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.SupplierId) ? "-" : Model.SupplierId)</div>
                    </div>
                </div>
                <div class="backbone-preview-field">
                    <i class="bx bx-purchase-tag"></i>
                    <div>
                        <div class="backbone-preview-label">@Localizer["RequisitionRef"]</div>
                        <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.RequisitionId) ? "-" : Model.RequisitionId)</div>
                    </div>
                </div>
                <div class="backbone-preview-field">
                    <i class="bx bx-dollar-circle"></i>
                    <div>
                        <div class="backbone-preview-label">@Localizer["TotalAmount"]</div>
                        <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.TotalAmount) ? "-" : Model.TotalAmount) @Model.Currency</div>
                    </div>
                </div>
                <div class="backbone-preview-field">
                    <i class="bx bx-money"></i>
                    <div>
                        <div class="backbone-preview-label">@Localizer["Currency"]</div>
                        <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.Currency) ? "-" : Model.Currency)</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="card backbone-preview-section p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IntegrationSection"]</h6>
            <div class="d-flex flex-column gap-4">
                <div class="backbone-preview-field">
                    <i class="bx bx-server"></i>
                    <div>
                        <div class="backbone-preview-label">@Localizer["SourceSystem"]</div>
                        <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.SourceSystem) ? "-" : Model.SourceSystem)</div>
                    </div>
                </div>
                <div class="backbone-preview-field">
                    <i class="bx bx-link"></i>
                    <div>
                        <div class="backbone-preview-label">@Localizer["ExternalRef"]</div>
                        <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.ExternalRef) ? "-" : Model.ExternalRef)</div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    </div>
</div>

@section Scripts {
    <script id="purchase-order-details-l10n" type="application/json">
        @Json.Serialize(new
        {
            ActionApprove = Localizer["ActionApprove"].Value,
            ConfirmApprove = Localizer["ConfirmApprove"].Value,
            ApproveSuccess = Localizer["ApproveSuccess"].Value,
            AreYouSure = SharedLocalizer["AreYouSure"].Value,
            RecordSaved = SharedLocalizer["RecordSaved"].Value,
            ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
            NotAvailable = SharedLocalizer["NotAvailable"].Value
        })
    </script>
    <script src="~/assets/js/Procurement/PurchaseOrders/details.js" asp-append-version="true"></script>
}
