@model Diten.Web.Models.Procurement.Requisitions.RequisitionsEditViewModel
@using Diten.Web.Views.Procurement.Requisitions
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<RequisitionsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
    var action = isEdit ? "Edit" : "Create";
    var lines = (Model.Lines is { Count: > 0 }) ? Model.Lines : [new Diten.Web.Models.Procurement.Requisitions.RequisitionLineInput()];
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/Requisitions">@Localizer["RequisitionsTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/Requisitions" class="btn btn-label-secondary">
            @SharedLocalizer["Cancel"]
        </a>
        <button type="submit" form="requisitionForm" class="btn btn-primary">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>

<form id="requisitionForm" asp-controller="Requisitions" asp-action="@action" asp-route-id="@Model.RequisitionId" method="post"
    class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RequisitionId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Main Column (Left) -->
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h6 class="card-section-title mb-0"><i class="bx bx-list-ul"></i>@Localizer["LinesSection"]</h6>
                        <button type="button" class="btn btn-sm btn-label-primary" id="btnAddLine">
                            <i class="bx bx-plus me-1"></i>@Localizer["AddLine"]
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0" id="requisitionLinesTable">
                            <thead>
                                <tr>
                                    <th>@Localizer["LineItemId"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineSkuId"]</th>
                                    <th>@Localizer["LineQuantity"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineUomId"] <span class="text-danger">*</span></th>
                                    <th>@Localizer["LineNeedBy"]</th>
                                    <th class="cell-fit"></th>
                                </tr>
                            </thead>
                            <tbody id="requisitionLinesBody" data-line-prefix="Lines">
                                @for (var i = 0; i < lines.Count; i++)
                                {
                                    <tr class="requisition-line-row">
                                        <td>
                                            <input asp-for="Lines[i].ItemId" class="form-control form-control-sm requisition-line-input" data-line-field="ItemId" placeholder="@Localizer["LineItemIdPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].SkuId" class="form-control form-control-sm requisition-line-input" data-line-field="SkuId" placeholder="@Localizer["LineSkuIdPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].Quantity" class="form-control form-control-sm requisition-line-input" data-line-field="Quantity" inputmode="decimal" pattern="^-?\d+(\.\d+)?$" placeholder="@Localizer["LineQuantityPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].UomId" class="form-control form-control-sm requisition-line-input" data-line-field="UomId" placeholder="@Localizer["LineUomIdPlaceholder"]" />
                                        </td>
                                        <td>
                                            <input asp-for="Lines[i].NeedBy" type="date" class="form-control form-control-sm requisition-line-input" data-line-field="NeedBy" />
                                        </td>
                                        <td class="cell-fit">
                                            <button type="button" class="btn btn-icon btn-sm btn-label-danger requisition-line-remove" title="@SharedLocalizer["Delete"]">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-2 mb-0">@Localizer["LinesHint"]</p>
                </div>
            </section>
        </div>

        <!-- Sidebar Column (Right) -->
        <div class="col-12 col-lg-4">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-file"></i>@Localizer["RequisitionSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Justification" class="form-label fw-medium">@Localizer["Justification"]</label>
                            <div class="diten-field">
                                <i class="bx bx-note diten-field-icon" aria-hidden="true"></i>
                                <textarea asp-for="Justification" class="form-control" rows="4" maxlength="1000" placeholder="@Localizer["JustificationPlaceholder"]"></textarea>
                            </div>
                            <span class="text-muted small mt-1 d-block">@Localizer["JustificationHint"]</span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

</form>
