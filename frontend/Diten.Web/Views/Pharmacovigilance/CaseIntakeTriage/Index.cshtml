@using Diten.Web.Views.Pharmacovigilance.CaseIntakeTriage
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CaseIntakeTriageIndex> Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h5 class="mb-1">@Localizer["PageTitle"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>
    <a href="/Pharmacovigilance/CaseIntakeTriage/Create" class="btn btn-primary">
        <i class="icon-base bx bx-plus me-1"></i>@Localizer["CreateAction"]
    </a>
</div>

<div id="pvg-list-alert" class="alert alert-danger d-none" role="alert"></div>

<partial name="~/Views/Pharmacovigilance/CaseIntakeTriage/_Filter.cshtml" />
<partial name="~/Views/Pharmacovigilance/CaseIntakeTriage/_DataTable.cshtml" />

@section Scripts {
    <partial name="~/Views/Pharmacovigilance/CaseIntakeTriage/_IndexL10n.cshtml" />
    <script src="~/assets/js/Pharmacovigilance/CaseIntakeTriage/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Pharmacovigilance/CaseIntakeTriage/index.js" asp-append-version="true"></script>
}
