@using Diten.Web.Views.Pharmacovigilance.CaseIntakeTriage
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CaseIntakeTriageIndex> Localizer
@{
    ViewData["Title"] = Localizer["DetailTitle"].Value;
    Layout = "_LayoutTenantShell";
    var intakeDraftId = ViewData["IntakeDraftId"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h5 class="mb-1">@Localizer["DetailTitle"]</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-style1 mb-0">
                <li class="breadcrumb-item">
                    <a href="/Pharmacovigilance/CaseIntakeTriage">@Localizer["PageTitle"]</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer["DetailTitle"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a href="/Pharmacovigilance/CaseIntakeTriage" class="btn btn-label-secondary">
            <i class="icon-base bx bx-arrow-back me-1"></i>@Localizer["BackToList"]
        </a>
        <a href="/Pharmacovigilance/CaseIntakeTriage/Edit/@intakeDraftId" class="btn btn-primary">
            <i class="icon-base bx bx-edit me-1"></i>@Localizer["Edit"]
        </a>
    </div>
</div>

<div id="pvg-detail-alert" class="alert alert-danger d-none" role="alert"></div>
<div id="pvg-detail-status" class="visually-hidden" aria-live="polite">@Localizer["Loading"]</div>

<div class="row g-4" data-intake-draft-id="@intakeDraftId" id="pvg-case-intake-detail">
    <div class="col-12 col-xl-4">
        <section class="card h-100">
            <div class="card-body p-4">
                <h6 class="mb-3">@Localizer["SourceSection"]</h6>
                <dl class="row mb-0">
                    <dt class="col-5">@Localizer["IntakeDraftId"]</dt>
                    <dd class="col-7 text-break" id="pvgDetailId">@intakeDraftId</dd>
                    <dt class="col-5">@Localizer["Status"]</dt>
                    <dd class="col-7" id="pvgDetailStatus" aria-live="polite">@Localizer["Loading"]</dd>
                </dl>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-4">
        <section class="card h-100">
            <div class="card-body p-4">
                <h6 class="mb-3">@Localizer["SubjectEventSection"]</h6>
                <form id="pvg-triage-form" data-pvg-command-form>
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label" for="TriageOutcome">@Localizer["TriageOutcome"] <span class="text-danger">*</span></label>
                        <select class="form-select" id="TriageOutcome" name="TriageOutcome" required>
                            <option value="">@Localizer["SelectPlaceholder"]</option>
                            <option value="Triaged">@Localizer["OutcomeTriaged"]</option>
                            <option value="Rejected">@Localizer["OutcomeRejected"]</option>
                            <option value="Duplicate">@Localizer["OutcomeDuplicate"]</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="TriageReasonCode">@Localizer["TriageReasonCode"]</label>
                        <input class="form-control" id="TriageReasonCode" name="TriageReasonCode" maxlength="80" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="TriageReason">@Localizer["TriageReason"]</label>
                        <textarea class="form-control" id="TriageReason" name="TriageReason" rows="3" maxlength="1000"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="icon-base bx bx-check-circle me-1"></i>@Localizer["SubmitTriage"]
                    </button>
                </form>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-4">
        <section class="card h-100">
            <div class="card-body p-4">
                <h6 class="mb-3">@Localizer["WorkflowSection"]</h6>
                <form id="pvg-route-form" data-pvg-command-form>
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label" for="RouteTargetQueue">@Localizer["RouteTargetQueue"] <span class="text-danger">*</span></label>
                        <select class="form-select" id="RouteTargetQueue" name="RouteTargetQueue" required>
                            <option value="">@Localizer["SelectPlaceholder"]</option>
                            <option value="PV_SAFETY_REVIEW">@Localizer["QueueSafetyReview"]</option>
                            <option value="PV_MEDICAL_REVIEW">@Localizer["QueueMedicalReview"]</option>
                            <option value="PV_INTAKE_FOLLOWUP">@Localizer["QueueIntakeFollowup"]</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="icon-base bx bx-send me-1"></i>@Localizer["SubmitRoute"]
                    </button>
                </form>
            </div>
        </section>
    </div>

    <div class="col-12">
        <section class="card">
            <div class="card-body p-4">
                <h6 class="mb-3">@Localizer["EvidenceSection"]</h6>
                <p class="mb-0 text-muted">@Localizer["EvidenceHelp"]</p>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Pharmacovigilance/CaseIntakeTriage/_IndexL10n.cshtml" />
    <script src="~/assets/js/Pharmacovigilance/CaseIntakeTriage/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Pharmacovigilance/CaseIntakeTriage/details.js" asp-append-version="true"></script>
}
