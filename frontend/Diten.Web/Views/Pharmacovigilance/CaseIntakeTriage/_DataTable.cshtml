@using Diten.Web.Views.Pharmacovigilance.CaseIntakeTriage
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CaseIntakeTriageIndex> Localizer

@* DATA MODE: server — the list component pages in the API: the browser sends start and length, the MVC proxy maps them
   to pageNumber and pageSize (at most 100) and answers { data: { items, total, filteredTotal } }. Declared on the
   <table> (data-dt-data-mode) per the golden template. No select-all column and no bulk bar on purpose: a case intake
   is never bulk-deleted (OD-PVG-10). *@
<div class="card">
    @* The shared, shaped placeholder (renders id="skeleton-loader" data-table-skeleton). It is visible from the first
       paint and hides the table beside it until dt-defaults.js REMOVES it on the first draw. *@
    <partial name="_TableSkeleton" />

    <div class="card-datatable table-responsive">
        <table id="dt-pvg-case-intake-triage" data-dt-standard="v2" data-dt-data-mode="server" class="datatables-pvg-case-intake-triage table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["IntakeDraftId"]</th>
                    <th>@Localizer["Status"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
