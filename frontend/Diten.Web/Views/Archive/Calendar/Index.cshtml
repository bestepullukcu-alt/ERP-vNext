                @Html.Partial("~/Views/Calendar/_CalendarTopButtons.cshtml")
            </div>
            <div class="px-3 pt-2" style="height:72vh !important;overflow-y:auto;">
                @Html.Partial("~/Views/Calendar/_CalendarTabs.cshtml")
            </div>


        </div>

        <div class="col app-calendar-content">
            <div class="card shadow-none border-0">
                <div class="card-body pb-0">
                    <!-- FullCalendar -->
                    <div id="calendar"></div>
                </div>
            </div>
            <div class="app-overlay"></div>
            @Html.Partial("~/Views/Calendar/_OldAddCalendar.cshtml")

        </div>




     </div>
</div>







