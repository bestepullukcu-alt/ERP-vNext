.modal-close-btn {
    position: absolute;
    top: 14px;
    right: 18px;
    background: transparent;
    border: none;
    padding: 6px;
    line-height: 1;
    cursor: pointer;
    z-index: 10;
}

.modal-close-btn i {
    font-size: 26px;
    color: #6c757d;
    transition: color 0.2s ease, transform 0.15s ease;
}

.modal-close-btn:hover i {
    color: #000;
    transform: scale(1.1);
}
.modal-content {
    position: relative; /* CLOSE BUTTON'ın referansı burası olmalı */
}
#editUser .modal-content {
    overflow: visible !important;
}

#editUser .modal-body {
    overflow: visible !important;
}

.select2-container {
    z-index: 999999 !important;
}
.nav-link.disabled {
    pointer-events: none;
    opacity: 0.5;
}
#schedule {
    overflow: visible !important;
}

/* Modal gövdesi popupları kesmesin */
#editUser .modal-dialog,
#editUser .modal-content,
#editUser .modal-body {
    overflow: visible !important;
}
#editUser #schedule {
    overflow: visible !important;
}
/* Schedule list scroll sadece kendi içinde olsun */
#scheduleList {
    max-height: 600px;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 4px;
    position: relative;
}

/* Modern scroll görünümü */
#scheduleList::-webkit-scrollbar {
    width: 6px;
}

#scheduleList::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
}

#scheduleList::-webkit-scrollbar-thumb {
    background: #c5c5c5;
    border-radius: 10px;
}

#scheduleList::-webkit-scrollbar-thumb:hover {
    background: #a5a5a5;
}
.schedule-item {
    margin-left: -2px !important;
    margin-right: -2px !important;
    width: calc(100% + 4px);
}
/* Flatpickr popup modalların üstünde olsun */
.flatpickr-calendar {
    z-index: 9999999  !important;
}

/* Select2 dropdown da modalların üstünde olsun */
.select2-container .select2-dropdown {
    z-index: 9999999  !important;
}
.flatpickr-calendar animate static arrowBottom arrowLeft open {
    z-index: 9999999  !important;
}
.fc-scrollgrid-section-header {
    background-color: transparent !important;
}
.fc-scrollgrid-section-header {
    background-color: transparent !important;
}
.fc-scrollgrid-section-header thead tr {
    background-color: transparent !important;
}
.fc-col-header th {
    background-color: transparent !important;
}
.fc-col-header, 
.fc-col-header thead,
.fc-col-header th {
    background-color: transparent !important;
}
.ct-badge-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
.ct-badge-wrapper .badge {
    max-width: 100%;
    white-space: normal;  /* Uzun metinler 2 satıra bölünsün */
    word-break: break-word;
}

    .floating-timer {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 240px;
        background: #fff;
        border-radius: 12px;
        padding: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.25);
        z-index: 99999;
        cursor: pointer;
    }

        .floating-timer .ft-task-name {
            font-size: 14px;
            font-weight: 600;
        }

        .floating-timer .ft-timer {
            font-size: 26px;
            font-weight: bold;
            color: #f39c12;
        }

        .floating-timer .ft-stop-btn {
            width: 100%;
            margin-top: 10px;
        }
.task-title {
    white-space: normal !important;
    word-break: break-word;   /* satır taşarsa otomatik böler */
    display: block;
}
    /* Name + Description hücresindeki truncate'ı kapatma */




</style>


