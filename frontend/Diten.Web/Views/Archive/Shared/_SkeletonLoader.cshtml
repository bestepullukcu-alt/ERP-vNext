@* MOD-0013: Skeleton Loader - Shimmer effect while DataTable loads *@
<style>
    .skeleton-container {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 5;
        background: var(--bs-body-bg, #fff);
        padding: 1.5rem;
    }

    .skeleton-row {
        display: flex;
        gap: 1rem;
        margin-bottom: 0.75rem;
        align-items: center;
    }

    .skeleton-cell {
        height: 14px;
        border-radius: 4px;
        background: linear-gradient(90deg, #e9eaec 25%, #f2f3f3 50%, #e9eaec 75%);
        background-size: 200% 100%;
        animation: skeleton-shimmer 1.5s ease-in-out infinite;
    }

    [data-bs-theme=dark] .skeleton-cell {
        background: linear-gradient(90deg, #3d3e5b 25%, #4e4f6c 50%, #3d3e5b 75%);
        background-size: 200% 100%;
    }

    .skeleton-cell.w-20 {
        flex: 0 0 20%;
    }

    .skeleton-cell.w-15 {
        flex: 0 0 15%;
    }

    .skeleton-cell.w-10 {
        flex: 0 0 10%;
    }

    .skeleton-cell.w-25 {
        flex: 0 0 25%;
    }

    .skeleton-header {
        height: 18px;
        margin-bottom: 1rem;
        opacity: 0.7;
    }

    @@keyframes skeleton-shimmer {
        0% {
            background-position: -200% 0;
        }

        100% {
            background-position: 200% 0;
        }
    }
</style>

<div id="skeleton-loader" class="skeleton-container">
    @* Header row *@
    <div class="skeleton-row skeleton-header">
        <div class="skeleton-cell w-20"></div>
        <div class="skeleton-cell w-15"></div>
        <div class="skeleton-cell w-15"></div>
        <div class="skeleton-cell w-25"></div>
        <div class="skeleton-cell w-10"></div>
        <div class="skeleton-cell w-10"></div>
    </div>
    @* Data rows *@
    @for (int i = 0; i < 6; i++)
    {
        <div class="skeleton-row">
            <div class="skeleton-cell w-20"></div>
            <div class="skeleton-cell w-15"></div>
            <div class="skeleton-cell w-15"></div>
            <div class="skeleton-cell w-25"></div>
            <div class="skeleton-cell w-10"></div>
            <div class="skeleton-cell w-10"></div>
        </div>
    }
</div>

<script>
    // Auto-hide skeleton when DataTable finishes loading
    $(document).ready(function () {
        $(document).on('init.dt', function () {
            $('#skeleton-loader').fadeOut(300);
        });
    });
</script>
