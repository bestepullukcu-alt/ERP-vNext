    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-0">Lcppv Monthly Reconcialition</h5>
        <small class="text-muted">
            Local Contact Person for Diten.Web Monthly Reconcialition
        </small>
        <div class="d-flex justify-content-between align-items-center row pt-4 gap-md-0 g-6">
            <div class="col-md-4 lcppv_company"></div>
            <div class="col-md-4 lcppv_country"></div>
            <div class="col-md-4 lcppv_status"></div>
        </div>
