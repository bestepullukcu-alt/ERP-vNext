<div class="row g-6">
    <div class="col-sm-12">
        <label class="form-label" for="summary-editor">Summary</label>
        <div id="summary-toolbar">
            <span class="ql-formats">
                <select class="ql-font"></select>
                <select class="ql-size"></select>
            </span>
            <span class="ql-formats">
                <button class="ql-bold"></button>
                <button class="ql-italic"></button>
                <button class="ql-underline"></button>
                <button class="ql-strike"></button>
            </span>
            <span class="ql-formats">
                <select class="ql-color"></select>
                <select class="ql-background"></select>
            </span>
            <span class="ql-formats">
                <button class="ql-script" value="sub"></button>
                <button class="ql-script" value="super"></button>
            </span>
            <span class="ql-formats">
                <button class="ql-header" value="1"></button>
                <button class="ql-header" value="2"></button>
                <button class="ql-blockquote"></button>
                <button class="ql-code-block"></button>
            </span>
        </div>
        <div id="summary-editor">
        </div>
    </div>
    <div class="col-sm-12">
        <label class="form-label" for="txt-literature-source">Literature Source (Source Name)</label>
        <input type="text" id="txt-literature-source" class="form-control" placeholder="e.g., JAMA, The Lancet, ClinicalTrials.gov" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-article">Article (Author List)</label>
        <input type="text" id="txt-article" class="form-control" placeholder="Enter author names (e.g., Smith J, Doe A, et al.)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-article-source">Article (Source List)</label>
        <input type="text" id="txt-article-source" class="form-control" placeholder="Enter source names (e.g., PubMed, Embase, Google Scholar)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-article-reference">Article (Article Reference List)</label>
        <input type="text" id="txt-article-reference" class="form-control" placeholder="Enter reference details (e.g., Smith et al., 2023, NEJM)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-literature-article-citation">Literature Article Citation</label>
        <input type="text" id="txt-literature-article-citation" class="form-control" placeholder="Enter full article citation (e.g., Smith J, Doe A. The effects of X. Journal of Medicine. 2020; 35(2): 123–130)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-reporter">Reporter</label>
        <input type="text" id="txt-reporter" class="form-control" placeholder="Reporter (e.g., physician, patient, journalist)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="ddl-patient">Patient</label>
        <select id="ddl-patient" name="Patient" class="select2 form-select form-select-lg form-control" data-allow-clear="true"></select>
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-study-subject-number">Study Subject (Subject Number)</label>
        <input type="text" id="txt-study-subject-number" class="form-control" placeholder="Enter subject number (e.g., 001-1234)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="ddl-study-subject-race">Study Subject (Subject Race)</label>
        <select id="ddl-study-subject-race" name="StudySubjectRace" class="select2 form-select form-select-lg form-control" data-allow-clear="true"></select>
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-study-subject-site">Study Subject (Subject Study Site)</label>
        <input type="text" id="txt-study-subject-site" class="form-control" placeholder="Enter study site name (e.g., Site 102 - Boston Clinic)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-study-subject-arm">Study Subject (Subject Arm)</label>
        <input type="text" id="txt-study-subject-arm" class="form-control" placeholder="Enter study arm name (e.g., Treatment Group A)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-product-description">Product Description</label>
        <input type="text" id="txt-product-description" class="form-control" placeholder="Enter product description (e.g., Oral tablet for pain relief with 500mg paracetamol)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="txt-adverse-reaction">Adverse Reaction</label>
        <input type="text" id="txt-adverse-reaction" class="form-control" placeholder="Enter adverse reaction (e.g., Nausea, headache, or dizziness)" />
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="ddl-source-information">Source of Information</label>
        <select id="ddl-source-information" name="SourceInformation" class="select2 form-select form-select-lg form-control" data-allow-clear="true"></select>
    </div>
    <div class="col-sm-6 d-flex align-items-center">
        <input class="form-check-input me-2" type="checkbox" id="chcSubmissionRequired">
        <label class="form-check-label mb-0" for="chcSubmissionRequired">Submission required</label>
    </div>
    <div class="col-sm-6">
        <label class="form-label" for="dt-submission-due">Due Date</label>
        <input type="text" class="form-control" placeholder="DD,Month, YYYY" name="dateSubmissionDue"
               id="dt-submission-due" />
    </div>
    <div class="col-12 d-flex justify-content-between">
        <button class="btn btn-primary btn-prev">
            <i class="icon-base bx bx-left-arrow-alt scaleX-n1-rtl icon-sm ms-sm-n2 me-sm-2"></i>
            <span class="align-middle d-sm-inline-block d-none">Previous</span>
        </button>
        <button class="btn btn-primary btn-next">
            <span class="align-middle d-sm-inline-block d-none me-sm-2">Next</span>
            <i class="icon-base bx bx-right-arrow-alt scaleX-n1-rtl icon-sm me-sm-n2"></i>
        </button>
    </div>
</div>

