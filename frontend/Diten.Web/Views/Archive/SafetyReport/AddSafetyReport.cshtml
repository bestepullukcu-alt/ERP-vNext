@{
    ViewData["Title"] = "Safety Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link rel="stylesheet" href="~/assets/vendor/libs/bs-stepper/bs-stepper.css" />
}
<div class="row">
    <div class="col-12">
        <h5>Safety Reporting</h5>
    </div>

    <!-- Modern Icons Wizard -->
    <div class="col-12 mb-6">
        <small class="fw-medium">Please report any safety-related incidents promptly to ensure a secure environment for all</small>
        <div  class="bs-stepper wizard-icons wizard-modern wizard-modern-icons-example mt-2">
            <div class="bs-stepper-header">
                <div class="step" data-target="#case-intake-tracking">
                    <button type="button" class="step-trigger">
                        <span class="bs-stepper-icon">
                            <svg viewBox="0 0 54 54">
                                <use xlink:href="../../assets/svg/icons/form-wizard-account.svg#wizardAccount"></use>
                            </svg>
                        </span>
                        <span class="bs-stepper-label">Case Intake & Tracking Register</span>
                    </button>
                </div>
                <div class="line">
                    <i class="icon-base bx bx-right-arrow-alt icon-md scaleX-n1-rtl"></i>
                </div>
                <div class="step" data-target="#literature-case-tracking">
                    <button type="button" class="step-trigger">
                        <span class="bs-stepper-icon">
                            <svg viewBox="0 0 58 54">
                                <use xlink:href="../../assets/svg/icons/form-wizard-personal.svg#wizardPersonal"></use>
                            </svg>
                        </span>
                        <span class="bs-stepper-label">Literature Case Tracking & Assessment</span>
                    </button>
                </div>
                <div class="line">
                    <i class="icon-base bx bx-right-arrow-alt icon-md scaleX-n1-rtl"></i>
                </div>
                <div class="step" data-target="#safety-submission">
                    <button type="button" class="step-trigger">
                        <span class="bs-stepper-icon">
                            <svg viewBox="0 0 54 54">
                                <use xlink:href="../../assets/svg/icons/form-wizard-address.svg#wizardAddress"></use>
                            </svg>
                        </span>
                        <span class="bs-stepper-label">Safety Submission Tracker</span>
                    </button>
                </div>
                <div class="line">
                    <i class="icon-base bx bx-right-arrow-alt icon-md scaleX-n1-rtl"></i>
                </div>
                <div class="step" data-target="#integrated-case-management">
                    <button type="button" class="step-trigger">
                        <span class="bs-stepper-icon">
                            <svg viewBox="0 0 54 54">
                                <use xlink:href="../../assets/svg/icons/form-wizard-social-link.svg#wizardSocialLink"></use>
                            </svg>
                        </span>
                        <span class="bs-stepper-label" style="white-space:normal;">Integrated Case Management & Assessment</span>
                    </button>
                </div>
                
                
            </div>

            <div class="row">
            <div class="col-8 bs-stepper-content">
              <form id="createSafetyReportForm" onSubmit="return false">

                    <!-- Case Intake & Tracking Register -->
                    <div id="case-intake-tracking" class="content">
                        <div class="content-header mb-4">
                            <h6 class="mb-0">Case Intake & Tracking Register</h6>
                            <small>Track the lifecycle of each case from submission to closure in a structured way.</small>
                        </div>
                        @Html.Partial("_CaseIntake")
                    </div>
                    <!-- Literature Case Tracking & Assessment -->
                    <div id="literature-case-tracking" class="content">
                        <div class="content-header mb-4">
                            <h6 class="mb-0">Literature Case Tracking & Assessment</h6>
                            <small>Ensure timely identification, documentation, and evaluation of literature-derived cases.</small>
                        </div>
                        @Html.Partial("_LiteratureCase")

                    </div>
                    <!-- Safety Submission Tracker -->
                    <div id="safety-submission" class="content">
                        <div class="content-header mb-4">
                            <h6 class="mb-0">Safety Submission Tracker</h6>
                            <small>Monitor the status and timelines of all safety-related regulatory submissions.</small>
                        </div>
                        @Html.Partial("_SafetySubmission")
                    </div>
                    <!-- Integrated Case Management & Assessment -->
                    <div id="integrated-case-management" class="content">
                        <div class="content-header mb-4">
                            <h6 class="mb-0">Integrated Case Management & Assessment</h6>
                            <small>Ensure consistency and compliance through centralized case handling and evaluation.</small>
                        </div>
                        @Html.Partial("_IntegratedAssessment")
                    </div>
                    </form>
            </div>
            
            <div class="col-4">
                <div class="card mb-6">
                    <div class="card-header">
                        <h5 class="card-title m-0">
                            <i class="icon-base bx bx-file icon-md"></i>
                            Attachment
                            <input type="file" id="fileInput" style="display: none;" />
                            <a href="javascript:;" class="btn btn-icon text-end" style="float:right;" id="uploadIcon">
                                <i class="icon-base bx bx-plus icon-md"></i>
                            </a>
                        </h5>

                    </div>
                    <div id="uploadItems" class="card-body">
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>
    <!-- /Modern Icons Wizard -->


</div>
@section Scripts {

    <script src="@Url.Content("~/assets/vendor/libs/bs-stepper/bs-stepper.js")"></script>
    <script src="@Url.Content("~/assets/js/form-wizard-icons.js")"></script>
    <script src="@Url.Content("~/assets/js/Archive/SafetyReport/langLoader.js")"></script>
    <script src="@Url.Content("~/assets/js/Archive/SafetyReport/SafetyReportDatePicker.js")"></script>
    <script src="@Url.Content("~/assets/js/Archive/SafetyReport/AddSafetyReport.js")"></script>



}
