<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="UpdateActiveIngredient"
     aria-labelledby="UpdateActiveIngredientLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="UpdateActiveIngredientLabel" class="offcanvas-title">Edit Ingredient</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="update-active-ingredient pt-0" id="updateActiveIngredientForm" onsubmit="return false" data-id="">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-active-ingredient">Active Ingredient</label>
                <textarea id="update-active-ingredient" name="updateActiveIngredientName" class="form-control"
                          rows="2"
                          placeholder="active ingredient"></textarea>
            </div>
            <button type="submit" class="btn btn-primary me-3 data-submit">Update</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>
