<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="AddActiveIngredient"
     aria-labelledby="ActiveIngredientLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="ActiveIngredientLabel" class="offcanvas-title">Add New Ingredient</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="add-active-ingredient pt-0" id="addActiveIngredientForm" onsubmit="return false">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-active-ingredient">Active Ingredient</label>
                <textarea id="add-active-ingredient" name="activeIngredientName" class="form-control"
                          rows="2"
                          placeholder="active ingredient"></textarea>
            </div>
            <button type="submit" class="btn btn-primary me-3 data-submit">Add</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>

