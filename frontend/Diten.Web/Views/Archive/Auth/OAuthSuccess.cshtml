@{
    ViewData["Title"] = "Account Linked";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .misc-wrapper {
            text-align: center;
            padding: 60px 20px;
        }

            .misc-wrapper img {
                max-width: 100%;
                height: auto;
            }

        .success-code {
            font-size: 6rem;
            line-height: 6rem;
            color: #28a745;
        }
    </style>
</head>
<body class="bg-light">

    <div class="container-xxl container-p-y">
        <div class="misc-wrapper">
            <h1 class="success-code">✔</h1>
            <h4 id="messageText" class="mb-2">Account successfully linked!</h4>
            <p class="mb-4">Your email account was successfully connected. You can return to the emails.</p>
            <button class="btn btn-primary" id="backToHome">Back to Email</button>
            <div class="mt-5">
                <img src="https://cdn-icons-png.flaticon.com/512/2921/2921222.png"
                     alt="Success illustration"
                     width="300"
                     class="img-fluid" />
            </div>
        </div>
    </div>


    @Html.Partial("~/Views/Shared/_AppToast.cshtml")


    <script>
        const queryParams = new URLSearchParams(window.location.search);
        const accessToken = queryParams.get("accessToken");
        const message = queryParams.get("message");
        const domain = window.location.hostname;
        const authToken = localStorage.getItem("token");



        document.getElementById("messageText").innerText = decodeURIComponent(message || "Account successfully linked!");

        document.getElementById("backToHome").addEventListener("click", () => {
            if (accessToken) {

                console.log("Auth Token:", authToken);

                fetch(`http://${domain}:5050/api/PvUser/Email/gmail/save-mails`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${authToken}`
                    },
                    body: JSON.stringify({ accessToken })
                }).then(response => response.json())
                    .then(data => {
                        const isSuccess = data.errors === null || data.errors === undefined;

                        if (isSuccess) {
                            // Gerekirse burada başka işlemler yap (örneğin başarılı toast)
                            window.location.href = "/Email/Index"; // ya da istediğin başka bir sayfa
                        } else {
                            const errorMessage = data.errors?.join('<br>') || 'An error occurred while saving emails.';
                            showToast(errorMessage, "error");
                        }
                    })
                    .catch(error => {
                        console.error(error);
                        showToast('An error occurred while sending the request.', "error");
                    });







            } else {
                showToast("Access token bulunamadı.", "error");
            }
        });
    </script>

    <script>
        function showToast(message, type = 'success') {
            const toastEl = document.getElementById('appToast');
            const toastBody = toastEl.querySelector('.toast-body');
            const toastHeader = toastEl.querySelector('#appToastHeader');

            if (!toastEl || !toastBody || !toastHeader) return;

            toastBody.innerHTML = message;

            toastEl.classList.remove('bg-success', 'bg-danger', 'bg-warning', 'bg-info');

            switch (type) {
                case 'success':
                    toastEl.classList.add('bg-success');
                    toastHeader.textContent = 'Successfull';
                    break;
                case 'error':
                    toastEl.classList.add('bg-danger');
                    toastHeader.textContent = 'Error';
                    break;
                case 'warning':
                    toastEl.classList.add('bg-warning');
                    toastHeader.textContent = 'Warning';
                    break;
                case 'info':
                    toastEl.classList.add('bg-info');
                    toastHeader.textContent = 'Information';
                    break;
            }

            const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
            toast.show();
        }

    </script>
</body>
</html>
