@{
    ViewData["Title"] = "Folder Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <h3>Document Library</h3>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/DocumentationSystem">Root</a></li>
            <li class="breadcrumb-item"><a href="/DocumentationSystem">Documentation System</a></li>
        </ol>
    </nav>
</div>

<!-- Folders -->
<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center w-100">
            <h5 class="card-title mb-0">Folders</h5>
            <button class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#CreateFolder"> <i class="icon-base bx bx-plus"></i> Create Folder</button>
        </div>
    </div>
    <div class="card-body">
        <div id="folder-empty" class="text-center text-muted my-5">
            <div><i class="bx bx-plus" style="font-size:48px;"></i></div>
            <p class="mb-1 fw-bold">No folders found</p>
            <p>This folder is empty. Upload your first document to get started.</p>
        </div>

        <div id="folder-list" class="row">
            <!-- folder-card'lar buraya gelecek -->
        </div>
    </div>
    <!-- ✅ Pagination Butonları Buraya -->
    <div class="card-footer border-0">
        <div class="d-flex justify-content-between align-items-center">
            <small id="page-info" class="text-muted ms-3"></small>
            <div class="d-flex justify-content-end gap-2 pe-3" id="pagination-controls">
                <button class="btn btn-light text-secondary border d-flex align-items-center gap-1" id="prev-btn">
                    <i class='bx bx-chevron-left'></i> Previous
                </button>
                <button class="btn btn-light text-secondary border d-flex align-items-center gap-1" id="next-btn">
                    Next <i class='bx bx-chevron-right'></i>
                </button>
            </div>
        </div>
    </div>



    @Html.Partial("_CreateFolder")
    @Html.Partial("_MoveDocument")
    @Html.Partial("_EditFolder")
    @Html.Partial("_VersionHistory")
    @Html.Partial("_ShareDocument")
</div>



<!-- Documents Table -->
<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center w-100">
            <h5 class="card-title mb-0">Documents</h5>
            <a id="uploadDocumentBtn" class="btn btn-primary">
                <i class="fa fa-upload" aria-hidden="true"></i> Upload Document
            </a>
        </div>
    </div>
    <div class="card-datatable text-nowrap">
        <table class="datatables-basic table table-bordered table-responsive">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Size</th>
                    <th>Folder</th>
                    <th>Created</th>
                    <th>Modified</th>
                    <th>Status</th>
                    <th class="d-flex align-items-center">Action</th>
                </tr>
            </thead>
            <tbody id="documentsContainer"></tbody>
        </table>
    </div>

    <div class="card-footer border-0">
        <div class="d-flex justify-content-between align-items-center">
            <small id="file-page-info" class="text-muted ms-3">
            </small>
            <div class="d-flex justify-content-end gap-2 pe-3" id="pagination-controls">
                <button class="btn btn-light text-secondary border d-flex align-items-center gap-1" id="file-prev-btn">
                    <i class='bx bx-chevron-left'></i> Previous
                </button>
                <button class="btn btn-light text-secondary border d-flex align-items-center gap-1" id="file-next-btn">
                    Next <i class='bx bx-chevron-right'></i>
                </button>
            </div>
        </div>
    </div>

</div>



<!-- Modals ve Toast -->
@Html.Partial("~/Views/Shared/_DeleteConfirmModal.cshtml")
@Html.Partial("~/Views/Shared/_AppToast.cshtml")

@section Scripts {
    <script src="~/assets/js/Archive/DocumentationSystem/FolderDetail.js"></script>
}
