<!-- Version History Modal -->
<div class="modal fade" id="VersionHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold">
                    Version History: <span id="version-doc-name"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-3">
                <div id="version-list"><!-- kartlar JS ile gelecek --></div>
            </div>
        </div>
    </div>
</div>

<!-- Version card template (Bootstrap-only styling) -->
<script type="text/template" id="version-card-template">
    <div class="border rounded-3 p-3 mb-3 bg-white">
      <!-- Üst şerit: açık gri panel + ince kenarlık -->
      <div class="d-flex align-items-center justify-content-between p-3">
        <div class="d-flex align-items-center gap-3">
          <span class="badge bg-light text-black">v{{version}}</span>
          <span class="text-muted small">{{size}}</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-light btn-sm text-secondary border-0 preview-btn">
              <i class="fa fa-eye fa-sm me-1"></i> Preview
            </button>
            <button class="btn btn-light btn-sm text-secondary border-0 download-btn">
              <i class="fa fa-download fa-sm me-1"></i> Download
            </button>
            <button class="btn btn-light btn-sm text-secondary border-0" disabled title="Restore endpoint tanımlı değil">
              <i class="fa fa-rotate-left fa-sm me-1"></i> Restore
            </button>
          </div>
      </div>

      <!-- Meta bilgileri -->
        <div class="px-3 pb-2 pt-2">
          <div class="d-flex align-items-center mb-1">
            <i class="fa-regular fa-user fa-sm me-2 text-secondary"></i>
            <small>Uploaded by {{uploadedBy}}</small>
          </div>
          <div class="d-flex align-items-center mb-1">
            <i class="fa-regular fa-calendar fa-sm me-2 text-secondary"></i>
            <small>{{uploadedDate}}</small>
          </div>
          <div class="d-flex align-items-center mb-1">
            <i class="fa-regular fa-comment-alt fa-sm me-2 text-secondary"></i>
            <small>{{description}}</small>
          </div>
        </div>
    </div>
</script>
