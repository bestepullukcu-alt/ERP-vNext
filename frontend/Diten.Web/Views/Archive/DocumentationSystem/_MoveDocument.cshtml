<div class="modal fade" id="MoveDocumentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Move Document: <span id="move-doc-name"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="moveDocumentForm" onsubmit="handleMoveSubmit(event)">
                <div class="modal-body">
                    <input type="hidden" id="move-doc-id">
                    <input type="hidden" id="selected-folder-id">
                    <input type="hidden" id="selected-folder-path">

                    <label class="form-label mb-2">Select Destination Folder</label>
                    <div id="folderTree" class="folder-tree p-2 border rounded" style="max-height: 300px; overflow-y: auto;"></div>

                    <div class="current-folder mt-4 bg-light p-2 rounded d-flex align-items-center">
                        <i class="fa fa-home me-2"></i>
                        <span id="current-folder-path">Current Folder</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-arrow-right-to-file me-1"></i> Move
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Tree görünümü */
    #folderTree {
        --indent: 18px;
        --line: #d9dde5;
        --row-h: 28px;
        font-size: 14px;
        max-height: 300px;
        overflow-y: auto;
    }

    .tree, .tree ul {
        margin: 0;
        padding-left: calc(var(--indent) + 10px);
        position: relative;
    }

        .tree ul::before {
            content: "";
            position: absolute;
            left: 9px;
            top: 0;
            bottom: 0;
            border-left: 1px solid var(--line);
        }

        .tree li {
            list-style: none;
            position: relative;
            min-height: var(--row-h);
            line-height: var(--row-h);
            padding-left: 6px;
            white-space: nowrap;
        }

            .tree li::before {
                content: "";
                position: absolute;
                left: 9px;
                top: calc(var(--row-h)/2);
                width: 12px;
                border-top: 1px solid var(--line);
            }

    .tree-row {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0 6px;
        border-radius: 6px;
    }

        .tree-row:hover {
            background: #f6f7fb;
        }

        .tree-row.selected {
            background: #eef3ff;
            outline: 1px solid #d7e2ff;
        }

    .tree-toggle {
        width: 16px;
        height: 16px;
        border: 1px solid var(--line);
        border-radius: 3px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        line-height: 1;
        user-select: none;
        cursor: pointer;
        background: #fff;
    }

        .tree-toggle.disabled {
            opacity: .35;
            cursor: default;
        }

    .tree i.fa-folder, .tree i.fa-folder-open, .tree i.fa-file {
        width: 16px;
        text-align: center;
    }

    .tree input[type="radio"] {
        margin: 0 2px 0 0;
        vertical-align: middle;
    }
</style>
