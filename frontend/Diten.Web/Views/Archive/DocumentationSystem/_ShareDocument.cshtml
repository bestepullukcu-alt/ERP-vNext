<div class="modal fade" id="ShareDocumentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold">
                    Share Documents: <span id="share-doc-name"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-3">

                <!-- Tabs -->
                <ul class="nav nav-tabs" id="shareTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-link-tab" data-bs-toggle="tab" data-bs-target="#tab-link" type="button" role="tab">
                            Share Link
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-email-tab" data-bs-toggle="tab" data-bs-target="#tab-email" type="button" role="tab">
                            Send Email
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-internal-tab" data-bs-toggle="tab" data-bs-target="#tab-internal" type="button" role="tab">
                            Internal Users
                        </button>
                    </li>
                </ul>

                <div class="tab-content pt-3">

                    <!-- Share Link -->
                    <div class="tab-pane fade show active" id="tab-link" role="tabpanel" aria-labelledby="tab-link-tab">
                        <form id="shareLinkForm" onsubmit="return false">
                            <input type="hidden" id="share-doc-id" />

                            <div class="mb-3">
                                <label class="form-label" for="share-link-url">Share Link</label>
                                <div class="input-group">
                                    <input type="text" id="share-link-url" class="form-control" placeholder="https://dms.company.com/share/abc123" readonly>
                                    <button type="button" class="btn btn-outline-secondary" id="btn-copy-link" title="Copy">
                                        <i class="fa fa-clipboard"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="share-access-level">Access Level</label>
                                <input type="text" id="share-access-level" class="form-control" value="View Only" disabled />
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="share-expiry-date">Expiry Date (Optional)</label>
                                    <input type="date" id="share-expiry-date" class="form-control" placeholder="dd.mm.yyyy">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="share-password">Password Protection (Optional)</label>
                                    <input type="password" id="share-password" class="form-control" placeholder="Enter Password">
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary" id="btn-share-link">
                                    <i class="fa fa-paper-plane me-1"></i> Share Document
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Send Email -->
                    <div class="tab-pane fade" id="tab-email" role="tabpanel" aria-labelledby="tab-email-tab">
                        <form id="shareEmailForm" onsubmit="return false">
                            <input type="hidden" id="share-email-doc-id" />

                            <div class="mb-3">
                                <label class="form-label" for="share-email-input">Recipients</label>
                                <div class="input-group">
                                    <input type="email" id="share-email-input" class="form-control" placeholder="Enter Email Address">
                                    <button type="button" class="btn btn-outline-secondary" id="btn-add-email">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                                <div id="share-email-selected" class="mt-2 d-flex flex-wrap gap-2">
                                    <!-- added chips by JS -->
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="share-email-message">Message (Optional)</label>
                                <textarea id="share-email-message" class="form-control" rows="3" placeholder="Add a personal message..."></textarea>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary" id="btn-share-email">
                                    <i class="fa fa-paper-plane me-1"></i> Share Document
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Internal Users -->
                    <div class="tab-pane fade" id="tab-internal" role="tabpanel" aria-labelledby="tab-internal-tab">
                        <form id="shareInternalForm" onsubmit="return false">
                            <input type="hidden" id="share-internal-doc-id" />

                            <div class="mb-3">
                                <label class="form-label">Select Users</label>
                                <select id="share-internal-users"
                                        multiple
                                        class="selectpicker w-100"
                                        data-style="btn-default"
                                        data-actions-box="true"
                                        data-size="10"
                                        data-selected-text-format="count > 2">
                                    <!-- options JS ile doldurulacak -->
                                </select>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary" id="btn-share-internal">
                                    <i class="fa fa-paper-plane me-1"></i> Share Document
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
