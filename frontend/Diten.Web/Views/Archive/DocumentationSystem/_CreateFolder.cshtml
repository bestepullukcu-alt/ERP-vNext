<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="CreateFolder"
     aria-labelledby="CreateFolderLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="CreateFolderLabel" class="offcanvas-title">Create New Folder</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="create-folder pt-0" id="createFolderForm" onsubmit="return false">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="create-folder-name">Folder Name</label>
                <input type="text"
                       class="form-control"
                       id="create-folder-name"
                       placeholder="enter folder name"
                       name="FolderName"
                       aria-label="FolderName" />
            </div>


            <div class="mb-6 form-control-validation">
                <label class="form-label" for="create-folder-description">Description</label>
                <textarea id="create-folder-description" class="form-control"
                          rows="2"
                          placeholder="enter folder description"></textarea>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="create-folder-visibility">Visibility</label>
                <select id="create-folder-visibility" name="visibility" class="select2 form-select form-select-lg" data-allow-clear="true">

                    <option value="private" selected>Private - Only you can access</option>
                    <option value="restricted">Restricted - Specific users only</option>
                    <option value="public">Public - Everyone can access</option>

                </select>
            </div>

            <div class="mb-6 form-control-validation" id="user-permission-container" style="display: none;">
                <label class="form-label">User Permission</label>
                <select id="create-user-permission" name="create-user-permission"
                        multiple
                        class="selectpicker w-100"
                        data-style="btn-default"
                        data-actions-box="true"
                        data-size="10"
                        data-selected-text-format="count > 2">
                </select>
            </div>

            <button type="submit" class="btn btn-primary me-3 data-submit">Create</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas" data-i18n="Cancel">Cancel</button>




        </form>
    </div>
</div>

