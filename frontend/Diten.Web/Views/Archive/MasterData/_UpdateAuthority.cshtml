<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="UpdateAuthority"
     aria-labelledby="UpdateAuthorityLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="UpdateAuthorityLabel" class="offcanvas-title" data-i18n="EditAuthority">Edit Authorities</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="update-authority pt-0" id="updateAuthorityForm" onsubmit="return false" data-id="">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-authority-name" data-i18n="InstitutionName">Institution Name</label>
                <input type="text"
                       class="form-control"
                       id="update-authority-name"
                       placeholder="institution name"
                       name="updateAuthorityName"
                       aria-label="Authority" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-ddlCountry" data-i18n="country">Country</label>
                <select id="update-ddlCountry" name="updateAuthorityCountry" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-txt-address" data-i18n="Address">Address</label>
                <textarea id="update-txt-address" class="form-control"
                          rows="2"
                          placeholder="123 Elm Street,Springfield,IL 62704"></textarea>
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-txt-website" data-i18n="Website">Website</label>
                <input type="text"
                       id="update-txt-website"
                       class="form-control"
                       placeholder="www.company.com"
                       aria-label="update website"
                       name="updateAuthorityWebsite" />
            </div>
            <button type="submit" class="btn btn-primary me-3 data-submit" data-i18n="Update">Update</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas" data-i18n="Cancel">Cancel</button>




        </form>
    </div>
</div>


