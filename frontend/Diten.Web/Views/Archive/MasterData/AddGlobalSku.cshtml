@{
    ViewData["Title"] = "Global Sku";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link rel="stylesheet" href="~/assets/vendor/libs/bs-stepper/bs-stepper.css" />
    <style>
        .hidden-column {
            display: none;
        }
    </style>

}
<div class="col-12 mb-6">
    <div class="bs-stepper wizard-icons wizard-icons-example mt-2">
        <div class="bs-stepper-header">
            <div class="step" data-target="#account-details">
                <button type="button" class="step-trigger">
                    <span class="bs-stepper-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zM4 12c0-.899.156-1.762.431-2.569L6 11l2 2v2l2 2 1 1v1.931C7.061 19.436 4 16.072 4 12zm14.33 4.873C17.677 16.347 16.687 16 16 16v-1a2 2 0 0 0-2-2h-4v-3a2 2 0 0 0 2-2V7h1a2 2 0 0 0 2-2v-.411C17.928 5.778 20 8.65 20 12a7.947 7.947 0 0 1-1.67 4.873z"></path></svg>
                    </span>
                    <span class="bs-stepper-label">Global Sku</span>
                </button>
            </div>
            <div class="line">
                <i class="icon-base bx bx-right-arrow-alt icon-md scaleX-n1-rtl"></i>
            </div>
            <div class="step" data-target="#review-submit">
                <button type="button" class="step-trigger">
                    <span class="bs-stepper-icon">
                        
                            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="currentColor"><path d="M8.999 20.133a4.969 4.969 0 0 0 3.536-1.465l7.134-7.133a5.007 5.007 0 0 0-.001-7.072C18.723 3.52 17.467 3 16.132 3s-2.591.52-3.534 1.464l-7.134 7.134a5.009 5.009 0 0 0 0 7.072 4.97 4.97 0 0 0 3.535 1.463zm5.013-14.255A2.979 2.979 0 0 1 16.132 5c.802 0 1.556.313 2.122.878a3.004 3.004 0 0 1 .001 4.243l-2.893 2.892L11.12 8.77l2.892-2.892zm-7.134 7.134 2.828-2.828 4.242 4.243-2.827 2.827c-1.133 1.133-3.11 1.132-4.243.001a3.005 3.005 0 0 1 0-4.243z"></path></svg>
                       
                    </span>
                    <span class="bs-stepper-label">Composition</span>
                </button>
            </div>
        </div>
        <div class="bs-stepper-content">
            <form id="createSkuForm" onSubmit="return false">
                <!-- Account Details -->
                <div id="account-details" class="content">
                    <div class="content-header mb-4">
                        <h6 class="mb-0">Add New Sku (Stock Keeping Unit)</h6>
                        <small>Enter the details of the new pharmaceutical product.</small>
                    </div>
                    <div class="row g-6">
                        <div class="col-sm-4">
                            <label class="form-label" for="add-ddlGlobalBrand">Global Brand</label>
                            <select id="add-ddlGlobalBrand" name="globalSkuBrand" class="select2 form-select form-select-lg" data-allow-clear="true"></select>

                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="globalSkuName">Global Sku</label>
                            <input type="text" id="globalSkuName" name="globalSkuName" class="form-control" placeholder="Paracetamol-500mg-Tablet" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="add-ddlCompany">Company</label>
                            <select id="add-ddlCompany" name="globalSkuCompany" class="select2 form-select form-select-lg" data-allow-clear="true"></select>

                        </div>

                        <div class="col-sm-4">
                            <label class="form-label" for="add-ddlProductionSite">Production Site</label>
                            <select id="add-ddlProductionSite" name="globalSkuProductionSite" class="select2 form-select form-select-lg" data-allow-clear="true"></select>

                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="add-ddlPackagingSite">Packaging Site</label>
                            <select id="add-ddlPackagingSite" name="globalSkuPackagingSite" class="select2 form-select form-select-lg" data-allow-clear="true"></select>

                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="add-ddlBatchReleaseSite">Batch Release Site</label>
                            <select id="add-ddlBatchReleaseSite" name="globalSkuBatchReleaseSite" class="select2 form-select form-select-lg" data-allow-clear="true"></select>

                        </div>
                        <hr class="my-4 mt-8" />
                        <div class="col-12">
                            <div class="mb-3 pb-2">
                                <h5 class="fw-bold mb-0" data-i18n="PackagingForm">Packaging Form</h5>
                            </div>
                            <div class="card-datatable table-responsive">
                                <table class="packagingForm-table table border-top">
                                    <thead>
                                        <tr>
                                            <th></th>
@*                                             <th data-i18n="type" class="hidden-column">TypeId</th>
 *@                                            <th data-i18n="type">Type</th>
@*                                             <th data-i18n="type" class="hidden-column">FormId</th>
 *@                                            <th data-i18n="name">Name</th>
                                            <th data-i18n="dosage">Dosage</th>
                                            <th class="cell-fit" data-i18n="action">Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>

                        </div>
                        <div class="col-12 d-flex justify-content-between">
                            <button class="btn btn-label-secondary btn-prev" onclick="window.location.href='/master-data/global-sku';">
                                <i class="icon-base bx bx-left-arrow-alt scaleX-n1-rtl icon-sm ms-sm-n2 me-sm-2"></i>
                                <span class="align-middle d-sm-inline-block d-none">Cancel</span>
                            </button>
                            <button id="nextBtn" class="btn btn-primary btn-next">
                                <span class="align-middle d-sm-inline-block d-none me-sm-2">Next</span>
                                <i class="icon-base bx bx-right-arrow-alt icon-sm scaleX-n1-rtl me-sm-n2"></i>
                            </button>
                        </div>
                    </div>



                </div>
                <!-- Review -->
                <div id="review-submit" class="content">
                    <div id="cardsContainer" class="row">
                        
                       
                    </div>


                    <div class="col-12 d-flex justify-content-between">
                        <button class="btn btn-label-secondary btn-prev">
                            <i class="icon-base bx bx-left-arrow-alt scaleX-n1-rtl icon-sm ms-sm-n2 me-sm-2"></i>
                            <span class="align-middle d-sm-inline-block d-none">Previous</span>
                        </button>
                        <button id="submitButton" class="btn btn-primary btn-submit">Submit</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@Html.Partial("~/Views/Shared/_DeleteConfirmModal.cshtml")
@Html.Partial("~/Views/Shared/_AppToast.cshtml")
@Html.Partial("_AddPackagingForm")
@Html.Partial("_UpdatePackagingForm")
@Html.Partial("_AddActiveIngredient")

@section Scripts {

    <script src="@Url.Content("~/assets/vendor/libs/bs-stepper/bs-stepper.js")"></script>
    <script src="@Url.Content("~/assets/js/form-wizard-icons.js")"></script>
    <script src="@Url.Content("~/assets/js/Archive/langLoader.js")"></script>
    <script src="@Url.Content("~/assets/js/Archive/MasterData/AddGlobalSku.js")"></script>


}