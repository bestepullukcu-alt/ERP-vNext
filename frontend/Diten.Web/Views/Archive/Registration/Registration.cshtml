@{
    ViewData["Title"] = "Marketing Authorization Overview";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-0">Marketing Authorization Overview</h5>
        <small class="text-muted">
            Overview of product approvals and related regulatory information by country or region.
        </small>
        <div class="d-flex justify-content-between align-items-center row pt-4 gap-md-0 g-6">
            <div class="col-md-4 ma_company"></div>
            <div class="col-md-4 ma_country"></div>
            <div class="col-md-4 ma_status"></div>
        </div>
    </div>
    <!-- Offcanvas to add new global brand -->
    @Html.Partial("_RegistrationTable")
</div>
@Html.Partial("~/Views/Shared/_DeleteConfirmModal.cshtml")
@Html.Partial("~/Views/Shared/_AppToast.cshtml")
@section Scripts {

    <script src="@Url.Content("~/assets/js/Archive/Registration/Registration.js")"></script>
}
