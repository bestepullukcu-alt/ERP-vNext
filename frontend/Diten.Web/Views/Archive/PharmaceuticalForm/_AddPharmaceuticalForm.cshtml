<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="AddPharmaceuticalForm"
     aria-labelledby="AddPharmaceuticalFormLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="AddPharmaceuticalFormLabel" class="offcanvas-title">Add New Form</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="add-pharmaceutical-form pt-0" id="addPharmaceuticalFormForm" onsubmit="return false">
            
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-pharmaceutical-form-type">Type</label>
                <select id="add-pharmaceutical-form-type" name="pharmaceuticalFormType" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-pharmaceutical-form-name">Pharmaceutical Form Name</label>
                <input type="text"
                       class="form-control"
                       id="add-pharmaceutical-form-name"
                       placeholder="add name"
                       name="pharmaceuticalFormName"
                       aria-label="PharmaceuticalForm" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-pharmaceutical-form-abbrevation">Abbrevation</label>
                <input type="text"
                       id="add-pharmaceutical-form-abbrevation"
                       class="form-control"
                       placeholder="add abbrevation"
                       aria-label="add abbrevation"
                       name="pharmaceuticalFormAbbrevation" />
            </div>

            
            <button type="submit" class="btn btn-primary me-3 data-submit">Add</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>

