<div id="addNewTaskView" class="row col-12 col-lg-12 order-0 order-md-1 hidden">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="card-title mb-0">Add a new task</h5>
            <small class="text-muted">Enter the required fields to create a task.</small>
        </div>
        <div>
            <button type="button" onclick="CancelTaskView();" class="btn btn-label-secondary me-2">Cancel</button>
            <button type="button" onclick="saveTask();" class="btn btn-primary">Save</button>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card mb-6">
            <div class="card-body pt-3">
                <div class="row">
                    <div class="col-md-6 mb-6 form-control-validation">
                        <label class="form-label" for="txtTaskName">Task Name</label>
                        <input type="text" id="txtTaskName" name="TaskName" class="form-control" placeholder="task name" />
                    </div>
                    <div class="col-md-6 mb-6 form-control-validation">
                        <label class="form-label" for="ddlTaskStatus">Status</label>
                        <select id="ddlTaskStatus" name="ddlTaskStatus" class="select2 form-select form-select-lg form-control" data-allow-clear="true"></select>

                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-6 form-control-validation">
                        <label for="dtStartDate" class="form-label">Start Date</label>
                        <input type="text"
                               class="form-control"
                               placeholder="......./...../...."
                               name="dtStartDate"
                               id="dtStartDate" />
                    </div>
                    <div class="col-md-6 mb-6 form-control-validation">
                        <label for="dtEndDate" class="form-label">End Date</label>
                        <input type="text"
                               class="form-control"
                               placeholder="......./...../...."
                               name="dtEndDate"
                               id="dtEndDate" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-6 form-control-validation">
                        <label class="form-label" for="ddlPriority">Priority</label>
                        <select id="ddlPriority" name="ddlPriority" class="select2 form-select form-select-lg form-control" data-allow-clear="true"></select>
                    </div>
                    <div class="col-md-6 mb-6 form-control-validation">
                        <label class="form-label" for="ddlAssignedTo">Assigned To</label>
                        <select id="ddlAssignedTo" name="ddlAssignedTo" class="select2 form-select form-select-lg form-control" data-allow-clear="true"></select>

                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-6 form-control-validation">
                        <label class="form-label" for="ddlParentTask">Parent Task</label>
                        <select id="ddlParentTask" name="ddlParentTask" class="select2 form-select form-select-lg form-control" data-allow-clear="true"></select>
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-center">
                        <input class="form-check-input me-2" type="checkbox" id="chcIsGroup">
                        <label class="form-check-label mb-0" for="chcIsGroup"> is group </label>
                    </div>
                </div>

                <div class="mb-6 form-control-validation">
                    <label class="form-label" for="txtDescription">Description (Optional)</label>
                    <div id="txtDescriptionToolBar">
                        <span class="ql-formats">
                            <select class="ql-font"></select>
                            <select class="ql-size"></select>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-bold"></button>
                            <button class="ql-italic"></button>
                            <button class="ql-underline"></button>
                            <button class="ql-strike"></button>
                        </span>
                        <span class="ql-formats">
                            <select class="ql-color"></select>
                            <select class="ql-background"></select>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-script" value="sub"></button>
                            <button class="ql-script" value="super"></button>
                        </span>
                        <span class="ql-formats">
                            <button class="ql-header" value="1"></button>
                            <button class="ql-header" value="2"></button>
                            <button class="ql-blockquote"></button>
                            <button class="ql-code-block"></button>
                        </span>
                    </div>
                    <div id="txtDescription">
                    </div>

                </div>


            </div>

        </div>


        <div class="card mb-6">
            <div class="card-header">
                <h5 class="card-title m-0">Comment</h5>
            </div>
            <div class="card-body">
                <div class="d-flex mb-2">
                    <div class="avatar avatar-sm me-2">
                        <span id="avatarInitials" class="avatar-initial rounded-circle text-uppercase"></span>
                    </div>

                    <!-- Input + Button -->
                    <div class="w-100">
                        <input type="text" id="txtReply" name="txtReply" class="form-control mb-2" placeholder="Type a reply / comment" />
                        <button id="btnComment" type="button" class="btn btn-sm btn-primary">Comment</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-6" style="background-color: transparent; box-shadow: none;">
           
                    <h5 class="card-header">Activity</h5>
                    <div class="card-body pt-1">
                     <ul class="timeline mb-0" id="timelineList">
                        
                      </ul>
                    </div>
                  </div>

    </div>

    <div class="col-12 col-lg-4">
        <div class="card mb-6">
            <div class="card-header">
                <h5 class="card-title m-0">
                    <i class="icon-base bx bx-file icon-md"></i>
                    Attachment
                    <input type="file" id="fileTaskInput" style="display: none;" />
                    <a href="javascript:;" class="btn btn-icon text-end" style="float:right;" id="uploadTaskIcon">
                        <i class="icon-base bx bx-plus icon-md"></i>
                    </a>
                </h5>

            </div>
            <div id="uploadTaskItems" class="card-body">
            </div>
        </div>
    </div>


</div>