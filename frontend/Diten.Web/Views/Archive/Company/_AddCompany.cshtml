<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="AddCompany"
     aria-labelledby="AddCompanyLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="AddCompanyLabel" class="offcanvas-title" data-i18n="AddCompany">Add Company</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="add-company pt-0" id="addCompanyForm" onsubmit="return false">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-company-name" data-i18n="CompanyName">Company Name</label>
                <input type="text"
                       class="form-control"
                       id="add-company-name"
                       placeholder="add name"
                       name="companyName"
                       aria-label="Company" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-company-abbrevation" data-i18n="Abbrevation">Abbrevation</label>
                <input type="text"
                       id="add-company-abbrevation"
                       class="form-control"
                       placeholder="add abbrevation"
                       aria-label="add abbrevation"
                       name="companyAbbrevation" />
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-company-country" data-i18n="country">Country</label>
                <select id="add-company-country" name="companyCountry" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-company-address" data-i18n="Address">Address</label>
                <textarea id="add-company-address" class="form-control"
                          rows="2"
                          placeholder="address"></textarea>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-company-phone" data-i18n="Phone">Phone</label>
                <input type="text"
                       id="add-company-phone"
                       class="form-control phone-mask"
                       placeholder="+(123) 456-7890"
                       aria-label="+(123) 456-7890"
                       name="companyPhone" />
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-company-email" data-i18n="Email">Email</label>
                <input type="text"
                       id="add-company-email"
                       class="form-control"
                       placeholder="john.doe@example.com"
                       aria-label="john.doe@example.com"
                       name="companyEmail" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-company-website" data-i18n="Website">Website</label>
                <input type="text"
                       id="add-company-website"
                       class="form-control"
                       placeholder="add abbrevation"
                       aria-label="add abbrevation"
                       name="companyWebsite" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-ParentCompany">Parent Company</label>
                <select id="add-ParentCompany" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            <div class="mb-6 form-control-validation">
                <input class="form-check-input" type="checkbox" id="chcIsGroup">
                <label class="form-check-label" for="chcIsGroup"> is group </label>
                <small class="form-text text-muted d-block">Check this box if this company will act as a parent and have other companies linked under it.</small>

            </div>
                <button type="submit" class="btn btn-primary me-3 data-submit" data-i18n="Add">Add</button>
                <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas" data-i18n="Cancel">Cancel</button>



           
        </form>
    </div>
</div>
