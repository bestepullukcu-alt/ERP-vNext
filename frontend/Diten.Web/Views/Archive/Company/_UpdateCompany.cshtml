<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="UpdateCompany"
     aria-labelledby="UpdateCompanyLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="UpdateCompanyLabel" class="offcanvas-title" data-i18n="EditCompany">Edit Company</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="update-company pt-0" id="updateCompanyForm" onsubmit="return false" data-id="">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-company-name" data-i18n="CompanyName">Company Name</label>
                <input type="text"
                       class="form-control"
                       id="update-company-name"
                       placeholder="update name"
                       name="updateCompanyName"
                       aria-label="Company" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-company-abbrevation" data-i18n="Abbrevation">Abbrevation</label>
                <input type="text"
                       id="update-company-abbrevation"
                       class="form-control"
                       placeholder="update abbrevation"
                       aria-label="update abbrevation"
                       name="updateCompanyAbbrevation" />
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-company-country" data-i18n="country">Country</label>
                <select id="update-company-country" name="updateCompanyCountry" class="select2 form-select"></select>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-company-address" data-i18n="Address">Address</label>
                <textarea id="update-company-address" class="form-control"
                          rows="2"
                          placeholder="address"></textarea>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-company-phone" data-i18n="Phone">Phone</label>
                <input type="text"
                       id="update-company-phone"
                       class="form-control phone-mask"
                       placeholder="+(123) 456-7890"
                       aria-label="+(123) 456-7890"
                       name="updateCompanyPhone" />
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-company-email" data-i18n="Email">Email</label>
                <input type="text"
                       id="update-company-email"
                       class="form-control"
                       placeholder="john.doe@example.com"
                       aria-label="john.doe@example.com"
                       name="updateCompanyEmail" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-company-website" data-i18n="Website">Website</label>
                <input type="text"
                       id="update-company-website"
                       class="form-control"
                       placeholder="update website"
                       aria-label="update website"
                       name="updateCompanyWebsite" />
            </div>
            
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-ParentCompany">Parent Company</label>
                <select id="update-ParentCompany" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            <div class="mb-6 form-control-validation">
                <input class="form-check-input" disabled type="checkbox" id="updateChcIsGroup">
                <label class="form-check-label" for="updateChcIsGroup"> is group </label>
                <small class="form-text text-muted d-block">Check this box if this company will act as a parent and have other companies linked under it.</small>

            </div>

            <button type="submit" class="btn btn-primary me-3 data-submit" data-i18n="Update">Update</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas" data-i18n="Cancel">Cancel</button>
        </form>
    </div>
</div>
