<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="offcanvasUpdateTeamMember"
     aria-labelledby="offcanvasUpdateTeamMemberLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasUpdateTeamMemberLabel" class="offcanvas-title">Edit Team Member</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="update-team-member pt-0" id="updateTeamMember" onsubmit="return false" data-id="">

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-team-member">Team Member</label>
                <select id="update-team-member" name="teamMember" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

            <div class="mb-6 form-control-validation">
                <label for="updateddlRoles" class="form-label">Role</label>
                <select id="updateddlRoles" name="ddlRoles"
                        multiple
                        class="selectpicker w-100"
                        data-style="btn-default"
                        data-actions-box="true" data-size="10">
                </select>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-skills">Skills (comma-separated)</label>
                <textarea id="update-skills" name="skills" class="form-control"
                          rows="2"
                          placeholder="e.g., Python, GMP Certified, Phase 3 Experienced"></textarea>
            </div>


            <button type="submit" class="btn btn-primary me-3 data-submit-update">Update</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>

