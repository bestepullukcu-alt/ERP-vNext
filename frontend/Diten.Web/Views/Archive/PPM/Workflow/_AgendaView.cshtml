<div id="agendaFormContainer" class="card mb-4">
    <div class="card-header d-flex align-items-center justify-content-between">
        <div>
            <h5 class="card-title mb-0">Agenda</h5>
            <small class="text-muted">
                List the topics or discussion points to be covered in this meeting.
            </small>
        </div>
        <div>
            <button id="btnCreateAgenda" type="button" class="btn btn-primary">
                Add Item
            </button>
        </div>

    </div>
    <div class="card-body">
        <form class="agenda-detail pt-0" id="agendaDetail" onsubmit="return false">

            <!-- TEMPLATE (Hidden) -->
            <template id="agenda-item-template" class="d-none">
                <div class="agenda-item row g-3 align-items-start mb-4">

                    <!-- Soldaki numara -->
                    <div class="col-md-1 d-flex justify-content-center mt-12 align-items-center">
                        <span class="agenda-number badge bg-primary rounded-pill"
                              style="font-size: 16px; padding: 10px 14px;">1</span>
                    </div>

                    <!-- Sağdaki giriş alanları -->
                    <div class="col-md-10">
                        <div class="row mb-4">
                         
                         <div class="col-md-6">
                            <input type="text" class="form-control agenda-title"
                                   placeholder="Enter Agenda Item">
                        </div>
                            <div class="col-md-6">

                                <select multiple class="agenda-attendees w-100"
                                        data-style="btn-default" data-actions-box="true"
                                        data-size="10" data-live-search="true">
                                </select>
                            </div>
                        </div>
                      

                        

                        <div class="row mb-4">
                            <div class="col-md-3">
                                 <input type="text" class="form-control agenda-start-date"/>
                            </div>
                            <div class="col-md-3">

                                <select class="form-select form-select-lg agenda-start-time" data-allow-clear="true"></select>
                            </div>
                            <div class="col-md-3">
                                <input type="text" class="form-control agenda-end-date"/>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select form-select-lg agenda-end-time" data-allow-clear="true"></select>

                            </div>
                        </div>

                    </div>

                    <!-- Sil Butonu -->
                    <div class="col-md-1 d-flex justify-content-end mt-12 align-items-center" style="height: 100%;">
                        <button class="btn btn-link text-danger btn-remove-agenda">
                            <i class="bx bx-trash fs-4"></i>
                        </button>
                    </div>
                </div>
            </template>

            <div id="agendaDetailView"></div>
            
            
        </form>
    </div>
</div>

