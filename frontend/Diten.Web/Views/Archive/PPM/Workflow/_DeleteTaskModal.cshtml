<style>
    /* Modal genel zemin */
    .custom-danger-modal .modal-content {
        background: rgba(255, 0, 0, 0.08); /* Hafif transparan kırmızı */
        border: 1px solid rgba(255, 0, 0, 0.25);
        backdrop-filter: blur(4px); /* Modern cam efekti */
    }

    /* Header */
    .custom-danger-modal .modal-header {
        background: rgba(220, 53, 69, 0.85) !important; /* Bootstrap danger rengi transparan */
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* Footer */
    .custom-danger-modal .modal-footer {
        background: rgba(220, 53, 69, 0.15) !important;
        border-top: 1px solid rgba(220, 53, 69, 0.2);
    }

    /* Alert */
    .custom-danger-modal .alert-danger {
        background: rgba(220, 53, 69, 0.20) !important;
        border-color: rgba(220, 53, 69, 0.40) !important;
    }

    /* List item */
    .custom-danger-modal .list-group-item {
        background: rgba(255, 0, 0, 0.05);
        border-color: rgba(220, 53, 69, 0.25);
    }

        .custom-danger-modal .list-group-item:hover {
            background: rgba(255, 0, 0, 0.12);
        }

    /* Buton: Evet Sil */
    .custom-danger-modal #confirmTaskDelete {
        background: rgba(220, 53, 69, 0.9);
        border: none;
    }

        .custom-danger-modal #confirmTaskDelete:hover {
            background: rgba(220, 53, 69, 1);
        }

</style>


<div class="modal fade" id="deleteTaskModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0">

            <div class="modal-header text-white"  style="background:#ffe0db">
                <h5 class="modal-title" style="color:red">
                    <i class="icon-base bx bx-error"></i>
                    Warning! This action cannot be undone.
                </h5>
</div>
            <div class="modal-body" style="background:#ffe0db">

                <p style="color:red">When this task is deleted, all of the tasks listed below will also be deleted:</p>

                    <hr style="color:red">

                    <div id="deleteTaskList"
                         class="list-group"
                         style="max-height: 250px; overflow-y: auto;">
                    </div>

            </div>

            <div class="modal-footer"  style="background:#ffe0db">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="confirmTaskDelete" class="btn btn-danger">
                    <i class="bx bx-trash"></i> Yes, delete
                </button>
            </div>

        </div>
    </div>
</div>

