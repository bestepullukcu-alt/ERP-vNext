<div class="card mb-4">
     <div class="card-header">
        <h5 id="titleGeneralh5" class="card-title mb-0">Survey List</h5>
        <small id="subTitleGeneral" class="text-muted">
            Enter the basic information for your new initiatives.
        </small>

    </div>
    <div class="card-body">
    <form class="general-new-record pt-0" id="generalNewRecord" onsubmit="return false">
        <div class="row g-3">
            <div class="col-md-6 form-control-validation">
                <label class="form-label" for="txt-name">Name</label>
                <input type="text" class="form-control" placeholder="Enter name" name="txtName" id="txt-name" />
            </div>
            <div class="col-md-6 form-control-validation">
                <label class="form-label" for="txt-code">ID</label>
                <input type="text" class="form-control" placeholder="INIT-.####" name="txtCode" id="txt-code" />
            </div>
            <div class="col-12 form-control-validation">
                <label class="form-label" for="txt-description">Description</label>
                <textarea id="txt-description" name="txtDescription" class="form-control" rows="5" placeholder="description"></textarea>
            </div>

<div class="p-3 rounded border bg-light">
  <!-- Alert tam satırda -->
  <div class="alert alert-secondary mb-3 d-flex align-items-center" role="alert">
  <span class="alert-icon rounded-circle me-2">
    <i class="icon-base bx bx-error fs-4"></i>
  </span>
  <span>These fields are auto-filled based on your initial selection.</span>
</div>

  <!-- Dropdownlar yan yana -->
  <div class="row">
    <div class="col-md-6 form-control-validation">
                <label class="form-label" style="color:#6c757d9e;" for="txt-record-type">Record Type</label>
                <input type="text" class="form-control" disabled placeholder="Enter name" name="txtRecordType" id="txt-record-type" />
            </div>

   <div class="col-md-6 form-control-validation">
                <label class="form-label" style="color:#6c757d9e;"  for="txt-category">Category</label>
                <input type="text" class="form-control" disabled placeholder="Enter name" name="txtCategory" id="txt-category" />
            </div>
  </div>
</div>

<div class="col-md-6 form-control-validation">
                <label for="dtStartDate" class="form-label">Start Date</label>
                <input type="text"
                       class="form-control"
                       placeholder="DD,Month, YYYY"
                       name="dateStart"
                       id="dtStartDate" />
            </div>
            <div class="col-md-6 form-control-validation">
                <label for="dtEndDate" class="form-label">End Date</label>
                <input type="text"
                       class="form-control"
                       placeholder="DD,Month, YYYY"
                       name="dateEnd"
                       id="dtEndDate" />
            </div>

            <!-- ✅ 1 satırda 2 kolon -->
            <div class="col-md-6 form-control-validation">
                <label class="form-label" for="ddl-status">Status</label>
                <select id="ddl-status" name="ddlStatus" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

            <div class="col-md-6 form-control-validation">
                <label class="form-label" for="ddl-priority">Priority</label>
                <select id="ddl-priority" name="ddlPriority" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

        </div>
    </form>
    </div>
</div>

