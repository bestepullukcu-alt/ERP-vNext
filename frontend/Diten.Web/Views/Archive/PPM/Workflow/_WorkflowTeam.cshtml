<div class="card mb-6">
    <div class="card-widget-separator-wrapper">
        <div class="card-body card-widget-separator">
            <div class="row gy-4 gy-sm-1">
                <div class="col-sm-6 col-lg-4">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 border-end pb-4 pb-sm-0">
                        <div>
                            <p class="mb-1">Total Team Resource</p>
                            <h4 class="text-primary mb-1" id="teamTotalResource">0</h4>
                            <p class="mb-0"><span class="me-2" id="teamActiveCount">0 active</span></p>
                        </div>
                        <button type="button" class="btn btn-icon btn-label-primary me-lg-6">
                            <span class="icon-base bx bx-data icon-md"></span>
                        </button>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6">
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="d-flex justify-content-between align-items-start card-widget-2 border-end pb-4 pb-sm-0">
                        <div>
                            <p class="mb-1">Average Allocation</p>
                            <h4 class="text-primary mb-1" id="teamAvgAllocation">0%</h4>
                            <p class="mb-0"><span class="me-2">Team utilization</span></p>
                        </div>
                        <button type="button" class="btn btn-icon btn-label-primary me-lg-6">
                            <span class="icon-base bx bx-check icon-md"></span>
                        </button>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none">
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-1">Total Hours</p>
                            <h4 class="text-primary mb-1" id="teamTotalHours">0</h4>
                            <p class="mb-0"><span class="me-2">Planned hours</span></p>
                        </div>
                        <button type="button" class="btn btn-icon btn-label-primary">
                            <span class="icon-base bx bx-chart icon-md"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-0">Teams</h5>
        <small class="text-muted">
            Manage team members and resource allocation
        </small>
    </div>

   @Html.Partial("~/Views/PPM/Workflow/_WorkflowTeamTable.cshtml")

   
</div>

 
