<div id="subTaskFormContainer" class="card mb-4">
    <div class="card-header d-flex align-items-center justify-content-between">
        <div>
            <h5 class="card-title mb-0">Task Work Breakdown Structure</h5>
            <small class="text-muted">
                Define smaller, actionable steps required to complete the main task.
            </small>
        </div>
        <div>
            <button id="btnCreateSubTask" type="button" class="btn btn-label-primary">
                Create Sub Task
            </button>
        </div>

    </div>
    <div class="card-body">
        <form class="sub-task-detail pt-0" id="subTaskDetail" onsubmit="return false">
            <div class="row mb-4">
                <div class="col-md-6 form-control-validation">
                    <label class="form-label" for="txt-sub-task-name">Name</label>
                    <input type="text" class="form-control" placeholder="e.g., Final Regulatory Submission" name="txtSubTaskName" id="txt-sub-task-name" />
                </div>
                <div class="col-md-6 form-control-validation opacity-50">
                    <label class="form-label" for="txt-sub-intiatives">Intiatives</label>
                    <input disabled type="text" class="form-control" placeholder="INIT-.####" name="txtSubIntiatives" id="txt-sub-intiatives" />
                </div>
                </div>
                <div class="col-12 mb-4 form-control-validation">
                    <label class="form-label" for="txt-sub-task-description">Description</label>
                <textarea id="txt-sub-task-description" name="txtSubTaskDescription" class="form-control" rows="3" placeholder="e.g., Prepare and compile the complete Phase 3 Clinical Trial data package and submit the electronic dossier (eCTD) to the FDA via the regulatory portal. Ensure all documentation complies with CFR 21 Part 11 standards.
Input"></textarea>
                </div>

                <div class="row mb-4">
                <!-- ✅ 1 satırda 2 kolon -->
                <div class="col-md-6 form-control-validation">
                    <label class="form-label" for="ddl-sub-task-assignee">Assignee</label>
                    <select id="ddl-sub-task-assignee" name="ddlSubTaskAssignee" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                </div>

                <div class="col-md-6 form-control-validation">
                    <label class="form-label" for="ddl-sub-task-category">Category</label>
                    <select id="ddl-sub-task-category" name="ddlSubTaskCategory" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                </div>

            </div>

                            <div class="row mb-4">
                <!-- ✅ 1 satırda 2 kolon -->
                <div class="col-md-6 form-control-validation">
                    <label class="form-label" for="ddl-sub-task-status">Status</label>
                    <select id="ddl-sub-task-status" name="ddlSubTaskStatus" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                </div>

                <div class="col-md-6 form-control-validation">
                    <label class="form-label" for="ddl-sub-task-priority">Priority</label>
                    <select id="ddl-sub-task-priority" name="ddlTaskPriority" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                </div>

            </div>


                <div class="row mb-4">
                <div class="col-md-4 form-control-validation">
                    <label for="dtSubTaskStartDate" class="form-label">Start Date</label>
                    <input type="text"
                           class="form-control"
                           placeholder="DD,Month, YYYY"
                           name="dtSubTaskStartDate"
                           id="dtSubTaskStartDate" />
                </div>
                <div class="col-md-4 form-control-validation">
                    <label for="dtSubTaskDueDate" class="form-label">Due Date</label>
                    <input type="text"
                           class="form-control"
                           placeholder="DD,Month, YYYY"
                           name="dtSubTaskDueDate"
                           id="dtSubTaskDueDate" />
                </div>

                <div class="col-md-4 form-control-validation">
                    <label class="form-label" for="txt-sub-task-estimated-hour">Estimated Hour</label>
                    <input type="number"
                           class="form-control"
                           id="txt-sub-task-estimated-hour"
                           placeholder="Enter estimated hour in minutes"
                           name="txtSubTaskEstimatedHour"
                           min="0" />
                </div>
                </div>

                <hr class="my-4">
                <div id="subTasksContainer">

                </div>
        </form>
    </div>
</div>

