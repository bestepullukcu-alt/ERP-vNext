<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="offcanvasCreateWorkflow"
     aria-labelledby="offcanvasCreateWorkflowLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasCreateWorkflowLabel" class="offcanvas-title">Add New Record</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="create-workflow pt-0" id="create-workflow" onsubmit="return false">

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-record-type">Record Type</label>
                <select id="add-record-type" name="recordType" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-category">Category</label>
                <select id="add-category" name="category" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>



            <button type="submit" class="btn btn-primary me-3 data-submit">Continue</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>

