<div class="col-xl-12">
    <div class="nav-align-top">
        <ul class="nav nav-pills mb-4" role="tablist">
            <li class="nav-item">
                <button type="button"
                        class="nav-link active"
                        role="tab"
                        data-bs-toggle="tab"
                        data-bs-target="#taskDetailForm"
                        aria-controls="taskDetailForm"
                        aria-selected="true">
                    Details
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link"
                        role="tab"
                        data-bs-toggle="tab"
                        data-bs-target="#taskSubTaskForm"
                        aria-controls="taskSubTaskForm"
                        aria-selected="false">
                    Sub-Task
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link"
                        role="tab"
                        data-bs-toggle="tab"
                        data-bs-target="#taskDependenciesForm"
                        aria-controls="taskDependenciesForm"
                        aria-selected="false">
                    Dependencies
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link"
                        role="tab"
                        data-bs-toggle="tab"
                        data-bs-target="#taskChecklistForm"
                        aria-controls="taskChecklistForm"
                        aria-selected="false">
                    Checklist
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link"
                        role="tab"
                        data-bs-toggle="tab"
                        data-bs-target="#taskAgendaForm"
                        aria-controls="taskAgendaForm"
                        aria-selected="false">
                    Agenda
                </button>
            </li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="taskDetailForm" role="tabpanel">
                @Html.Partial("~/Views/PPM/MyWorkflow/_TaskDetailView.cshtml")
                @Html.Partial("~/Views/PPM/MyWorkflow/_MeetingDetailView.cshtml")
            </div>
            <div class="tab-pane fade" id="taskSubTaskForm" role="tabpanel">
                @Html.Partial("~/Views/PPM/Workflow/_SubTaskDetailView.cshtml")
            </div>
            <div class="tab-pane fade" id="taskDependenciesForm" role="tabpanel">
                @Html.Partial("~/Views/PPM/Workflow/_TaskDependenciesView.cshtml")
            </div>
            <div class="tab-pane fade" id="taskChecklistForm" role="tabpanel">
                @Html.Partial("~/Views/PPM/Workflow/_ChecklistTaskView.cshtml")

            </div>
            <div class="tab-pane fade" id="taskAgendaForm" role="tabpanel">
                @Html.Partial("~/Views/PPM/Workflow/_AgendaView.cshtml")
            </div>
        </div>
    </div>
</div>

