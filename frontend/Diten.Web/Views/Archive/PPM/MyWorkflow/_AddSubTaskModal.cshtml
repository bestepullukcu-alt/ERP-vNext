<div class="modal fade" id="addSubTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user">
        <div class="modal-content">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-6">
                    <h4 id="hSubTaskNameModal" class="mb-2">Task Work Breakdown Structure</h4>
                    <p id="pSubTaskDescriptionModal">Define smaller, actionable steps required to complete the main task.</p>
                </div>
                <form id="createSubTaskFormModal" class="row g-6" onsubmit="return false">
                    <div class="col-12 col-md-6 form-control-validation">
                        <label class="form-label" for="mSubName">Name</label>
                        <input type="text"
                               id="m-sub-name"
                               name="mSubName"
                               class="form-control"
                               placeholder="e.g., Final Regulatory Submission"
                                />
                    </div>
                    <div class="col-12 col-md-6 opacity-50">
                        <label class="form-label" for="mWorkFlow">Workflow</label>
                        <input type="text"
                               id="m-workflow"
                               name="mWorkFlow"
                               class="form-control"
                               placeholder="INIT-.####"
                              disabled />
                    </div>
                    <div class="col-12 form-control-validation">
                        <label class="form-label" for="m-description">Description</label>
                        <textarea id="m-description" name="mDescription" class="form-control" rows="3" placeholder="e.g., Prepare and compile the complete Phase 3 Clinical Trial data package and submit the electronic dossier (eCTD) to the FDA via the regulatory portal. Ensure all documentation complies with CFR 21 Part 11 standards.Input"></textarea>
                    </div>
                    <div class="col-12 col-md-6 form-control-validation">
                    <label class="form-label" for="m-sub-task-assignee">Assignee</label>
                    <select id="m-sub-task-assignee" name="mSubTaskAssignee" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                    </div>
                    <div class="col-12 col-md-6 form-control-validation">
                    <label class="form-label" for="m-sub-task-category">Category</label>
                    <select id="m-sub-task-category" name="mSubTaskCategory" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                    </div>
                    <div class="col-12 col-md-6 form-control-validation">
                    <label class="form-label" for="m-sub-task-status">Status</label>
                    <select id="m-sub-task-status" name="mSubTaskStatus" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                    </div>
                    <div class="col-12 col-md-6 form-control-validation">
                    <label class="form-label" for="m-sub-task-priority">Priority</label>
                    <select id="m-sub-task-priority" name="mTaskPriority" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                    </div>
                    <div class="col-12 col-md-4 form-control-validation">
                        <label for="mSubTaskStartDate" class="form-label">Start Date</label>
                        <input type="text"
                               class="form-control"
                               placeholder="DD,Month, YYYY"
                               name="mSubTaskStartDate"
                               id="mSubTaskStartDate" />
                    </div>
                    <div class="col-12 col-md-4 form-control-validation">
                        <label for="mSubTaskDueDate" class="form-label">Due Date</label>
                        <input type="text"
                               class="form-control"
                               placeholder="DD,Month, YYYY"
                               name="mSubTaskDueDate"
                               id="mSubTaskDueDate" />
                    </div>
                    <div class="col-12 col-md-4 form-control-validation">
                        <label class="form-label" for="m-sub-task-estimated-hour">Estimated Duration (in minutes)</label>
                        <input type="number"
                               class="form-control"
                               id="m-sub-task-estimated-hour"
                               placeholder="Enter estimated hour in minutes"
                               name="mSubTaskEstimatedHour"
                               min="0" />
                    </div>
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-primary me-sm-3 me-1 data-submit-add-subtask">Submit</button>
                        <button type="reset"
                                class="btn btn-label-secondary"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

