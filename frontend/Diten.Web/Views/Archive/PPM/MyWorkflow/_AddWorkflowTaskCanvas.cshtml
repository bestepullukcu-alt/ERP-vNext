<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="offcanvasCreateTask"
     aria-labelledby="offcanvasCreateTaskLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasCreateTaskLabel" class="offcanvas-title">Add New Task</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="create-task pt-0" id="createTask" onsubmit="return false">

            <div class="mb-4 form-control-validation">
                <label class="form-label" for="add-task-name">Name</label>
                <input type="text"
                       class="form-control"
                       id="add-task-name"
                       placeholder="e.g., Final Regulatory Submission"
                       name="taskName"
                       aria-label="Task Name" />
            </div>


            <div class="mb-4 form-control-validation">
                <label class="form-label" for="add-task-type">Type</label>
                <select id="add-task-type" name="taskType" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

            <div class="mb-4 form-control-validation">
                <label class="form-label" for="add-task-category">Category</label>
                <select id="add-task-category" name="taskCategory" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            <div class="mb-4 form-control-validation">
                <label class="form-label" for="add-task-description">Description</label>
                <textarea id="add-task-description" name="taskDescription" class="form-control"
                          rows="2"
                          placeholder="Enter task description"></textarea>
            </div>

            <div class="mb-4 form-control-validation">
                <label class="form-label" for="add-task-workflow">Workflow</label>
                <select id="add-task-workflow" name="taskWorkflow" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>


            <div class="task-fields">

                <div class="mb-4 form-control-validation">
                    <label class="form-label" for="add-task-assignee">Assignee</label>
                    <select id="add-task-assignee" name="taskAssignee" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                </div>

                <div class="mb-4 form-control-validation">
                    <label class="form-label" for="add-task-status">Status</label>
                    <select id="add-task-status" name="taskStatus" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                </div>

                <div class="mb-4 form-control-validation">
                    <label class="form-label" for="add-task-priority">Priority</label>
                    <select id="add-task-priority" name="taskPriority" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                </div>
                <div class="mb-4 form-control-validation">
                    <label class="form-label" for="add-task-due-date">Due Date</label>
                    <input type="text"
                           class="form-control"
                           id="add-task-due-date"
                           name="taskDueDate"
                           placeholder="Due Date" />
                </div>

                <div class="mb-4 form-control-validation">
                    <label class="form-label" for="add-task-estimated-hour">Estimated Hour</label>
                    <input type="number"
                           class="form-control"
                           id="add-task-estimated-hour"
                           placeholder="Enter estimated hour in minutes"
                           name="taskEstimatedHour"
                           min="0" />
                </div>


            </div>


            <div class="meeting-fields">

                <div class="mb-4 form-control-validation">
                    <label for="add-meeting-attendees" class="form-label">Attendees</label>
                    <select id="add-meeting-attendees" name="meetingAttendees"
                            multiple
                            class="form-select form-select-lg select2"
        data-allow-clear="true">
                    </select>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 form-control-validation">
                        <label class="form-label" for="add-meeting-start-date">Start Date</label>
                        <input type="text"
                               class="form-control"
                               id="add-meeting-start-date"
                               name="meetingStartDate"
                               placeholder="Start Date" />
                    </div>
                    <div class="col-md-6 form-control-validation">
                        <label class="form-label" for="add-meeting-start-time">Start Time</label>
                        <select id="add-meeting-start-time" name="meetingStartTime" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                    </div>

                </div>

                <div class="row mb-4">
                    <div class="col-md-6 form-control-validation">
                        <label class="form-label" for="add-meeting-end-date">End Date</label>
                        <input type="text"
                               class="form-control"
                               id="add-meeting-end-date"
                               name="meetingEndDate"
                               placeholder="End Date" />
                    </div>
                    <div class="col-md-6 form-control-validation">
                        <label class="form-label" for="add-meeting-end-time">End Time</label>
                        <select id="add-meeting-end-time" name="meetingEndTime" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
                    </div>

                </div>

            </div>


            <button type="submit" class="btn btn-primary me-3 data-submit-add">Create</button>
            <button  class="btn btn-label-primary me-3 data-full-form">Full Form</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>

