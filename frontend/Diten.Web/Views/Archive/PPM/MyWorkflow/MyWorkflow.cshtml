@{
    ViewData["Title"] = "Task Overview";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .col-dates {
        min-width: 180px !important;
        width: 200px !important;
    }
</style>
<div id="normalFormContainer">

<div class="card mb-6">
    <div class="card-widget-separator-wrapper">
        <div class="card-body card-widget-separator">
            <div class="row gy-4 gy-sm-1">
                <div class="col-sm-6 col-lg-6">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 border-end pb-4 pb-sm-0">
                        <div>
                            <p class="mb-1">Total Task</p>
                            <h4 class="text-primary mb-1" id="totalTaskCount">0</h4>
                            <p class="mb-0"><span class="me-2" id="inProgressCount">0 in progress</span></p>
                        </div>
                        <button type="button" class="btn btn-icon btn-label-primary me-lg-6">
                            <span class="icon-base bx bx-check icon-md"></span>
                        </button>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6">
                </div>
                <div class="col-sm-6 col-lg-6">
                    <div class="d-flex justify-content-between align-items-start card-widget-2 border-end pb-4 pb-sm-0">
                        <div>
                            <p class="mb-1">Completed Task</p>
                            <h4 class="text-primary mb-1" id="completedTaskCount">0</h4>
                            <p class="mb-0"><span class="me-2" id="completionRate">0% completion rate</span></p>
                        </div>
                        <button type="button" class="btn btn-icon btn-label-success me-lg-6">
                            <span class="icon-base bx bx-check icon-md"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-0">Task Overview</h5>
        <small class="text-muted">
            Detailed view of all tasks with their current status and dependencies
        </small>
    </div>

    @Html.Partial("~/Views/PPM/MyWorkflow/_TaskListTable.cshtml")


</div>
</div>


<div id="fullFormContainer" class="d-none">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-4">
        <div class="d-flex align-items-center">
            <!-- Back butonu -->
            <button type="button" class="btn btn-label-secondary me-3" id="btnBackToNormal"><i class='bx bx-left-arrow-alt'></i>  Back To Task Overview</button>

            <div class="d-flex flex-column justify-content-center">
                <h4 id="hdrTask" class="mb-1">New Task </h4>
                <p id="pTask" class="mb-0">Add a new task to your workspace and assign it to a initiatives and group </p>
            </div>
        </div>

        <!-- Sağ taraf: Cancel + Create -->
        <div class="d-flex align-items-center">
            <button type="button" id="btnCancelTask" class="btn btn-label-secondary me-2">Cancel</button>
            <button type="button" id="btnCreateTask" class="btn btn-label-primary">Create Task</button>
        </div>
    </div>
    <hr class="my-4">
    @Html.Partial("~/Views/PPM/MyWorkflow/_CreateTaskFullForm.cshtml")
</div>


    @Html.Partial("~/Views/PPM/MyWorkflow/_AddWorkflowTaskCanvas.cshtml")
@Html.Partial("~/Views/PPM/MyWorkflow/_FilterCanvas.cshtml")
@Html.Partial("~/Views/PPM/MyWorkflow/_AddSubTaskModal.cshtml")


@Html.Partial("~/Views/Shared/_AppToast.cshtml")
@Html.Partial("~/Views/Shared/_DeleteConfirmModal.cshtml")
@Html.Partial("~/Views/PPM/Workflow/_DeleteTaskModal.cshtml")


@section Scripts {

    <script src="@Url.Content("~/assets/js/Archive/PPM/MyWorkflow/TaskOverview.js")"></script>
    <script src="@Url.Content("~/assets/js/Archive/PPM/MyWorkflow/TaskOverviewSubTask.js")"></script>
}
