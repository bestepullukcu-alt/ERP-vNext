@{
    ViewData["Title"] = "Role";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div class="card mb-12">

    <div class="card-header">

        <h5 class="card-tile mb-0">Edit Role</h5>


    </div>

    <div class="card-body">
        <!-- Add Product -->
        <form id="updateRoleForm" class="row g-6" onsubmit="return false" data-id="">
            <div class="col-12 form-control-validation">
                <label class="form-label" for="updateRoleName">Role Name</label>
                <input type="text"
                       id="updateRoleName"
                       name="updateRoleName"
                       class="form-control"
                       placeholder="Enter a role name"
                       tabindex="-1" />
            </div>
            <div class="col-12">
                <!-- Permission table -->
                <div class="table-responsive">
                    <table class="table table-flush-spacing mb-0 border-top">
                        <thead>
                            <tr>
                                <th>MENU GROUP</th>
                                <th>PAGE NAME</th>
                                <th>
                                    <div class="d-flex justify-content-end">
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" id="selectAll" />
                                            <label class="form-check-label" for="selectAll"> Select All </label>
                                        </div>
                                    </div>
                                </th>

                            </tr>
                        </thead>
                        <tbody id="permissionsTableBodyupdate">
                        </tbody>
                    </table>
                </div>
                <!-- Permission table -->
            </div>
            <div class="col-12 text-end">
                <button type="reset"
                        class="btn btn-label-secondary"
                        aria-label="Close" onclick="window.location.href = '/UserManagement/Role';">
                    Cancel
                </button>

                <button type="submit" class="btn btn-primary me-sm-3 me-1">Update</button>
            </div>
        </form>
    </div>


</div>

@section Scripts {

    <script src="@Url.Content("~/assets/js/Archive/UserManagement/UpdateRole.js")"></script>

}
