@{
    ViewData["Title"] = "User List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-0" data-i18n="User List">User List</h5>
        <div class="d-flex justify-content-between align-items-center row pt-4 gap-md-0 g-6">
            <div class="col-md-4">
                <label class="form-label" for="ddlCompany" data-i18n="company">Company</label>
                <select id="ddlCompany" name="userCompany" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            <div class="col-md-4"></div>
            <div class="col-md-4"></div>
        </div>

    </div>
    <!-- Offcanvas to add new global brand -->
    @Html.Partial("_UserTable")
    @Html.Partial("_AddUser")

</div>
@Html.Partial("~/Views/Shared/_DeleteConfirmModal.cshtml")
@Html.Partial("~/Views/Shared/_AppToast.cshtml")

@section Scripts {

    <script src="@Url.Content("~/assets/js/Archive/UserList/user-list.js")"></script>


}
