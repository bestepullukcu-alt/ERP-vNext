<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="offcanvasCreateSurveyType"
     aria-labelledby="offcanvasCreateSurveyTypeLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasCreateSurveyTypeLabel" class="offcanvas-title">Add New Survey Type</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="create-survey-type pt-0" id="createSurveyType" onsubmit="return false">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-name">Name</label>
                <input type="text"
                       class="form-control"
                       id="add-name"
                       placeholder="add name"
                       name="surveyTypeName"
                       aria-label="Survey Type" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-description">Description</label>
                <textarea id="add-description" name="surveyTypeDescription" class="form-control"
                          rows="2"
                          placeholder="description (optional)"></textarea>
            </div>
            <button type="submit" class="btn btn-primary me-3 data-submit">Create</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>

