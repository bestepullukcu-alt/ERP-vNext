@{
    ViewData["Title"] = "Survey Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-1">Survey Schedule</h5>
        <small class="text-muted">
            Manage survey tming, distribution, and reminders.
        </small>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-4">

        <button id="btnSchedule" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Schedule Survey
        </button>
    </div>

     @Html.Partial("~/Views/Survey/SurveySchedule/_CreateSurveySchedule.cshtml")
     @Html.Partial("~/Views/Survey/SurveySchedule/_UpdateSurveySchedule.cshtml")

</div>

<div id="templateContainer" class="row mb-12 g-6">

</div>

@Html.Partial("~/Views/Survey/SurveySchedule/_SettingsModal.cshtml")

@Html.Partial("~/Views/Shared/_AppToast.cshtml")
@Html.Partial("~/Views/Shared/_DeleteConfirmModal.cshtml")


@section Scripts {

    <script src="@Url.Content("~/assets/js/Archive/Survey/SurveySchedule/SurveySchedule.js")"></script>
}