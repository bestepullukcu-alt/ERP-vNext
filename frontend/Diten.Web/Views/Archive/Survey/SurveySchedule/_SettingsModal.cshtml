<div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="settingsModalLabel">Survey Settings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="settings-row mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Email Reminders</span>
                        <button class="btn btn-label-primary toggle-setting" data-setting="emailReminders">Enabled</button>
                    </div>
                    <small class="text-muted">Send reminder emails to participants</small>
                </div>

                <div class="settings-row mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">SMS Reminders</span>
                        <button class="btn btn-label-secondary toggle-setting" data-setting="smsReminders">Disabled</button>
                    </div>
                    <small class="text-muted">Send SMS reminders to participants</small>
                </div>

                <div class="settings-row mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Auto Start</span>
                        <button class="btn btn-label-secondary toggle-setting" data-setting="autoStart">Disabled</button>
                    </div>
                    <small class="text-muted">Automatically start survey on scheduled date</small>
                </div>

                <div class="settings-row mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Require Complete Response</span>
                        <button class="btn btn-label-secondary toggle-setting" data-setting="requireCompleteResponse">Disabled</button>
                    </div>
                    <small class="text-muted">Require all questions to be answered</small>
                </div>

                <div class="settings-row mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Anonymous Responses</span>
                        <button class="btn btn-label-secondary toggle-setting" data-setting="anonymousResponses">Disabled</button>
                    </div>
                    <small class="text-muted">Allow all questions to be answered</small>
                </div>

                <div class="settings-row mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Show Progress Bar</span>
                        <button class="btn btn-label-primary toggle-setting" data-setting="showProgressBar">Enabled</button>
                    </div>
                    <small class="text-muted">Display progress indicator to participants</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveSettingsBtn">Save Settings</button>
            </div>
        </div>
    </div>
</div>
