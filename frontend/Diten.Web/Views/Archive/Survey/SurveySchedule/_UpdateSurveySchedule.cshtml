<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="offcanvasUpdateSchedule"
     aria-labelledby="offcanvasUpdateSchedule">
    <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasUpdateScheduleLabel" class="offcanvas-title">Survey Schedule</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="update-schedule-form pt-0" id="updateScheduleForm" onsubmit="return false">
           
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-ddl-survey">Survey</label>
                <select id="update-ddl-survey" name="surveyName" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-target-auidence">Target Auidence</label>
                <select id="update-target-auidence" name="targetAuidence" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            
            <div class="mb-6 form-control-validation">
                <label for="updatedtStartDate" class="form-label">Start Date</label>
                <input type="text"
                       class="form-control"
                       placeholder="DD,Month, YYYY"
                       name="dateStart"
                       id="updatedtStartDate" />
            </div>
            <div class="mb-6 form-control-validation">
                <label for="updatedtEndDate" class="form-label">End Date</label>
                <input type="text"
                       class="form-control"
                       placeholder="DD,Month, YYYY"
                       name="dateEnd"
                       id="updatedtEndDate" />
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-target-response">Target Response Count</label>
                <input type="number"
                       class="form-control"
                       id="update-target-response"
                       placeholder="250"
                       name="targetResponse"
                       min="0" />
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-remainder-schedule">Remainder Schedule (days before end)</label>
                <input type="text"
                       class="form-control"
                       id="update-remainder-schedule"
                       placeholder="eg. 7,3,1"
                       name="remainderSchedule"
                       aria-label="Remainder Schedule" />
            </div>



            <button type="submit" class="btn btn-primary me-3 data-submit">Edit Schedule</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>
