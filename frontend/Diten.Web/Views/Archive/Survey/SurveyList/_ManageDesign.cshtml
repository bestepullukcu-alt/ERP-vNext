<div class="row g-3">
  <form class="manage-survey-list pt-0" id="manageSurveyList" onsubmit="return false">
    <div class="row g-3">
      <div class="col-12 form-control-validation">
        <label class="form-label" for="txt-survey-name">Survey Name</label>
        <input type="text" class="form-control" placeholder="Enter survey name" name="txtSurveyName" id="txt-survey-name" />
      </div>

      <div class="col-12 form-control-validation">
        <label class="form-label" for="txt-description">Description</label>
        <textarea id="txt-description" name="txtDescription" class="form-control" rows="2" placeholder="description (optional)"></textarea>
      </div>

      <!-- ✅ 1 satırda 2 kolon -->
      <div class="col-md-6 form-control-validation">
        <label class="form-label" for="ddl-survey-type">Type</label>
        <select id="ddl-survey-type" name="ddlSurveyType" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
      </div>

      <div class="col-md-6 form-control-validation">
        <label class="form-label" for="ddl-target-auidence">Target Audience</label>
        <select id="ddl-target-auidence" name="ddlTargetAuidence" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
      </div>

      <div class="col-md-6 form-control-validation">
        <label class="form-label" for="ddl-language">Language</label>
        <select id="ddl-language" name="ddlLanguage" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
      </div>

      <div class="col-md-6 form-control-validation">
        <label class="form-label" for="txt-duration">Duration (minutes)</label>
        <input type="number" class="form-control" id="txt-duration" placeholder="Enter duration in minutes" name="duration" min="0" />
      </div>

      <!-- ✅ Butonlar sağda yan yana -->
      <div class="col-12 d-flex justify-content-end gap-2 mt-3">
        <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" id="btnSaveSurvey" class="btn btn-primary data-submit">Create</button>
      </div>
    </div>
  </form>
</div>

