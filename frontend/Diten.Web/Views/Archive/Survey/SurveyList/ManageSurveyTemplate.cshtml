@{
    ViewData["Title"] = "Survey Template";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<style>
  /* Supporting text zaten Bootstrap small ile geliyor */
  
  /* Extra small: supporting text’ten daha küçük */
  .extra-small {
    font-size: 0.7rem; /* supporting text 0.875rem civarında, bunu daha küçük yapıyoruz */
  }
</style>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="javascript:void(0);" id="surveyListLink">Survey List</a>
        </li>
        <li class="breadcrumb-item">
            <a href="javascript:void(0);" id="surveyNameBreadcrumb">Manage Survey</a>
        </li>
    </ol>
</nav>


<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-1">Survey Template</h5>
        <small class="text-muted">
            Choose from professionally designed survey templates.
        </small>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-4">

        <button id="startBlankBtn" class="btn btn-label-secondary">
            <i class="bx bx-file me-1"></i> Start from Blank
        </button>
    </div>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-6">
     <input type="text" style="background-color: white;"
                       class="form-control"
                       id="template-search-txt"
                       placeholder="Search"
                       name="surveyListName"
                       aria-label="Survey Template" />
</div>



<div id="templateContainer" class="row mb-12 g-6">

</div>

@section Scripts {

    <script src="@Url.Content("~/assets/js/Archive/Survey/SurveyList/ManageSurveyTemplate.js")"></script>
}
