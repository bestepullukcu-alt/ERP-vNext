@{
    ViewData["Title"] = "Survey List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .dataTables_wrapper .dataTables_filter {
        float: right;
        text-align: right;
    }

    .survey-desc {
        display: block;
        white-space: normal !important;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
</style>



<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-0">Survey List</h5>
        <small class="text-muted">
            Create new surveys from templates or manage existing ones.
        </small>

    </div>

    @Html.Partial("~/Views/Survey/SurveyList/_SurveyListTable.cshtml")

    <!-- Offcanvas to add new survey list -->
    @Html.Partial("~/Views/Survey/SurveyList/_CreateSurveyList.cshtml")

</div>

@Html.Partial("~/Views/Shared/_AppToast.cshtml")
@Html.Partial("~/Views/Shared/_DeleteConfirmModal.cshtml")



@section Scripts {

    <script src="@Url.Content("~/assets/js/Archive/Survey/SurveyList/Surveylist.js")"></script>
}
