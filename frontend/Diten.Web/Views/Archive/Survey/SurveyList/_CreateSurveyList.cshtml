<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="offcanvasCreateSurveyList"
     aria-labelledby="offcanvasCreateSurveyListLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasCreateSurveyListLabel" class="offcanvas-title">Add New Survey</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="create-survey-list pt-0" id="createSurveyList" onsubmit="return false">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-name">Name</label>
                <input type="text"
                       class="form-control"
                       id="add-name"
                       placeholder="add name"
                       name="surveyListName"
                       aria-label="Survey Type" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-description">Description</label>
                <textarea id="add-description" name="description" class="form-control"
                          rows="2"
                          placeholder="description (optional)"></textarea>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-survey-type">Type</label>
                <select id="add-survey-type" name="surveyType" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-target-auidence">Target Auidence</label>
                <select id="add-target-auidence" name="targetAuidence" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-language">Language</label>
                <select id="add-language" name="language" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>

            <div class="mb-6 form-control-validation">
                <label class="form-label" for="add-duration">Duration (minutes)</label>
                <input type="number"
                       class="form-control"
                       id="add-duration"
                       placeholder="Enter duration in minutes"
                       name="duration"
                       min="0" />
            </div>

            <button type="submit" class="btn btn-primary me-3 data-submit">Create</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>
