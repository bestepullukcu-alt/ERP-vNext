<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="updateGlobalBrand"
     aria-labelledby="updateGlobalBrandLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasUpdateGlobalBrandLabel" class="offcanvas-title">Edit Brand</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="update-globalBrand pt-0" id="updateGlobalBrandForm" onsubmit="return false" data-brand-id="">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-globalbrand-name">Global Brand Name</label>
                <input type="text"
                       class="form-control"
                       id="update-globalbrand-name"
                       placeholder="name"
                       name="updateGlobalBrandName"
                       aria-label="Global Brand" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-globalbrand-abbrevation">Abbrevation</label>
                <input type="text"
                       id="update-globalbrand-abbrevation"
                       class="form-control"
                       placeholder="abbrevation"
                       aria-label="abbrevation"
                       name="updateGlobalBrandAbbrevation" />
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-Company">Company</label>
                <select id="update-Company" name="updateCompany" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            <button type="submit" class="btn btn-primary me-3 data-submit">Update</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
        </form>
    </div>
</div>
