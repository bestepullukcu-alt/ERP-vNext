<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="UpdateCategory"
     aria-labelledby="UpdateCategoryLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="UpdateCategoryLabel" class="offcanvas-title" data-i18n="EditCategory">Edit Category</h5>
        <button type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
    </div>
    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
        <form class="update-category pt-0" id="updateCategoryForm" onsubmit="return false" data-id="">
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-menu">Menu</label>
                <select id="update-menu" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-page">Page</label>
                <select id="update-page" class="select2 form-select form-select-lg" data-allow-clear="true"></select>
            </div>
            <div class="mb-6 form-control-validation">
                <label class="form-label" for="update-category-name" data-i18n="CategoryName">Category Name</label>
                <input type="text"
                       class="form-control"
                       id="update-category-name"
                       placeholder="update name"
                       name="updateCategoryName"
                       aria-label="Category" />
            </div>
            <div class="mb-6 form-control-validation">
                <input class="form-check-input" type="checkbox" id="updateChcIsActive">
                <label class="form-check-label" for="updateChcIsActive"> is active </label>
            </div>

            <button type="submit" class="btn btn-primary me-3 data-submit" data-i18n="Update">Update</button>
            <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas" data-i18n="Cancel">Cancel</button>
        </form>
    </div>
</div>
