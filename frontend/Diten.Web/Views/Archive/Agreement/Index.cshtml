@{
    ViewData["Title"] = "Agreements";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-0">Agreements</h5>
    </div>

    <!-- Tek satır toolbar -->
    <div class="px-3 py-3 agreements-toolbar d-flex align-items-center justify-content-between">
        <div>
            <select id="pageSize" class="form-select form-select-sm" style="width:70px;">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <input id="searchUser" class="form-control" placeholder="Search" aria-label="Search" style="width:250px;" />
            <a id="btnAddAgreement" class="btn btn-primary">+ Add </a>
        </div>
    </div>

    <!-- Tablo -->
    <div class="px-3">
        <div class="card-datatable text-nowrap">
            <table class="datatables-basic table table-bordered table-responsive">
                <thead>
                    <tr>
                        <th></th>
                        <th>AGGREMENTS</th>
                        <th>TYPE</th>
                        <th>STATUS</th>
                        <th>PARTIES</th>
                        <th>START DATE</th>
                        <th>END DATE</th>
                        <th>VALUE</th>
                        <th>COUNTRY</th>
                        <th>LAST MODIFIED</th>
                        <th class="d-flex align-items-center">ACTIONS</th>
                    </tr>
                </thead>
                <tbody id="documentsContainer"></tbody>
            </table>
        </div>
    </div>

    <!-- Footer -->
    <div class="card-footer border-0">
        <div class="d-flex justify-content-between align-items-center">
            <small id="file-page-info" class="text-muted ms-3">Showing 0 to 0 of 0 entries</small>
            <div class="d-flex justify-content-end gap-2 pe-3" id="pagination-controls">
                <button class="btn btn-light text-secondary border d-flex align-items-center gap-1" id="file-prev-btn">
                    <i class='bx bx-chevron-left'></i>
                </button>
                <button class="btn btn-light text-secondary border d-flex align-items-center gap-1" id="file-next-btn">
                    <i class='bx bx-chevron-right'></i>
                </button>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Shared/_DeleteConfirmModal.cshtml")
@Html.Partial("~/Views/Shared/_AppToast.cshtml")

@section Scripts {
    <script src="@Url.Content("~/assets/js/Archive/Agreement/Agreement.js")"></script>
}
