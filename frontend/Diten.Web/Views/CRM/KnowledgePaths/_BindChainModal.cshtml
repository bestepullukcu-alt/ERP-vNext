@using Diten.Web.Views.CRM.KnowledgePaths
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgePathStudio> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* WP-KP-UI-1 — simple bind-chain modal (chain + country + language → bind-chain). The guided legacy wizard is KP-UI-2. *@
<div class="modal fade" id="kpBindModal" tabindex="-1" aria-labelledby="kpBindTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kpBindTitle">@Localizer["BindTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-1" id="kpBindPathName"></p>
                <p class="mb-3">@Localizer["BindIntro"]</p>
                <div id="kpBindAlert" class="alert alert-danger d-none" role="alert"></div>
                <div class="mb-3">
                    <label class="form-label" for="kpBindChain">@Localizer["FieldChain"] <span class="text-danger" aria-hidden="true">*</span></label>
                    <select id="kpBindChain" class="form-select" required></select>
                    <small class="text-muted d-none" id="kpBindNoChain">@Localizer["BindNoChain"]</small>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="kpBindCountry">@Localizer["FieldCountry"] <span class="text-danger" aria-hidden="true">*</span></label>
                        <select id="kpBindCountry" class="form-select" required></select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="kpBindLanguage">@Localizer["FieldLanguage"] <span class="text-danger" aria-hidden="true">*</span></label>
                        <select id="kpBindLanguage" class="form-select" required disabled></select>
                    </div>
                </div>
                <small class="text-muted d-block mt-3"><i class="bx bx-lock-alt me-1" aria-hidden="true"></i>@Localizer["IdentityNote"]</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="kpBindSubmit" disabled>@Localizer["BindSubmit"]</button>
            </div>
        </div>
    </div>
</div>
