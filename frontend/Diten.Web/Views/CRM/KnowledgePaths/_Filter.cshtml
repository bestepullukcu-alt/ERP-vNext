@using Diten.Web.Views.CRM.KnowledgePaths
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgePathStudio> StudioLocalizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost" class="dt-inline-filter-host">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="knowledgePathFilterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Product (multi-select) *@
                    <div class="filter-chip">
                        <select id="filterProduct" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@StudioLocalizer["FilterProduct"]"></select>
                    </div>
                    @* Country (single-select, names) *@
                    <div class="filter-chip">
                        <select id="filterCountry" class="form-select form-select-sm select2" data-placeholder="@StudioLocalizer["FilterCountry"]"><option value="">@SharedLocalizer["ShowAll"]</option></select>
                    </div>
                    @* Language (single-select, native names) *@
                    <div class="filter-chip">
                        <select id="filterLanguage" class="form-select form-select-sm select2" data-placeholder="@StudioLocalizer["FilterLanguage"]"><option value="">@SharedLocalizer["ShowAll"]</option></select>
                    </div>
                    @* Status (multi-select, labels) *@
                    <div class="filter-chip">
                        <select id="filterStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@StudioLocalizer["FilterStatus"]"></select>
                    </div>
                    @* Only unapproved legacy paths (single-select) *@
                    <div class="filter-chip">
                        <select id="filterLegacy" class="form-select form-select-sm select2" data-placeholder="@StudioLocalizer["FilterLegacyOnly"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="legacy">@StudioLocalizer["FilterLegacyOnly"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
