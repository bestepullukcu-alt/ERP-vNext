@using Diten.Web.Views.CRM.KnowledgePaths
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgePathStudio> Localizer
@{
    ViewData["Title"] = Localizer["ReviewerTitle"].Value;
    Layout = "_LayoutTenantShell";
    var pathId = ViewData["PathId"] as string ?? string.Empty;
    var revisionId = ViewData["RevisionId"] as string ?? string.Empty;
}

@* WP-KP-UI-2 — the reviewer view of ONE frozen revision (/CRM/KnowledgePaths/{pathId}/Review/{revisionId}; the Work
   Center link of KP-2's DisplayContext). Pages arrive with KP-UI-3, so the reviewer reads the frozen COMPOSITION:
   left the branches / steps with open-note counts, centre the selected step (contents + claim blocks with the
   path-language text and qualifier), right the read-only evidence of the clicked claim (Claims v2 cards) and the
   decision panel. One channel (K1): the decision is the MOD-0023 task the Work Center shows. The submitter never gets
   the decision panel (person-based SoD; CRM answers 403 anyway). *@
<div class="kp-studio kp-review" id="kpReviewRoot" data-path-id="@pathId" data-revision-id="@revisionId">
    <div class="d-flex flex-wrap align-items-start gap-3 mb-3">
        <a href="/CRM/KnowledgePaths/@pathId" class="btn btn-icon btn-label-secondary" title="@Localizer["BackToWorkspace"]" aria-label="@Localizer["BackToWorkspace"]">
            <i class="bx bx-arrow-back" aria-hidden="true"></i>
        </a>
        <div class="flex-grow-1">
            <h5 class="mb-0" id="rvTitle">…</h5>
            <small class="text-muted d-block" id="rvSub"></small>
            <small class="text-muted d-block" id="rvContext"></small>
        </div>
    </div>

    <div id="rvAlert" class="alert alert-danger d-none" role="alert"></div>
    <p class="small text-muted"><i class="bx bx-info-circle me-1" aria-hidden="true"></i>@Localizer["ReviewerHint"]</p>

    <div class="row g-4">
        <nav class="col-12 col-lg-3" aria-label="@Localizer["ReviewerComposition"]">
            <h6 class="mb-2">@Localizer["ReviewerComposition"]</h6>
            <div id="rvTree" class="d-grid gap-3"></div>
        </nav>

        <section class="col-12 col-lg-5" aria-labelledby="rvStepTitle">
            <div class="card shadow-none border mb-4">
                <div class="card-header py-3">
                    <h6 class="mb-0" id="rvStepTitle"></h6>
                    <small class="text-muted" id="rvStepSub"></small>
                </div>
                <ul class="list-group list-group-flush" id="rvItems" aria-live="polite"></ul>
            </div>

            <div class="card shadow-none border">
                <div class="card-header py-3">
                    <h6 class="mb-0">@Localizer["NotesTitle"]</h6>
                    <small class="text-muted">@Localizer["NotesIntro"]</small>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled d-grid gap-3 mb-3" id="rvNotes" aria-live="polite"></ul>
                    <div class="border-top pt-3">
                        <label class="form-label small" for="rvNoteTarget">@Localizer["NoteTarget"]</label>
                        <select class="form-select form-select-sm mb-2" id="rvNoteTarget"></select>
                        <label class="form-label small visually-hidden" for="rvNoteText">@Localizer["NotePlaceholder"]</label>
                        <textarea class="form-control mb-2" id="rvNoteText" rows="2" maxlength="2000" placeholder="@Localizer["NotePlaceholder"]"></textarea>
                        <div class="invalid-feedback d-block d-none" id="rvNoteError" role="alert"></div>
                        <button type="button" class="btn btn-sm btn-label-primary" id="rvNoteAdd"><i class="bx bx-pin me-1" aria-hidden="true"></i>@Localizer["NoteAdd"]</button>
                    </div>
                </div>
            </div>
        </section>

        <aside class="col-12 col-lg-4">
            <div class="card shadow-none border mb-4">
                <div class="card-header py-3"><h6 class="mb-0" id="rvDecisionTitle">@Localizer["DecisionTitle"]</h6></div>
                <div class="card-body">
                    <div id="rvDecisionNote" class="alert alert-secondary small d-none" role="status"></div>
                    <div id="rvDecisionForm" class="d-none">
                        <label class="form-label small" for="rvDecisionComment">@Localizer["DecisionCommentLabel"]</label>
                        <textarea class="form-control mb-2" id="rvDecisionComment" rows="3" maxlength="2000" placeholder="@Localizer["DecisionCommentPlaceholder"]" aria-describedby="rvDecisionError"></textarea>
                        <div class="invalid-feedback d-block d-none" id="rvDecisionError" role="alert"></div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-success" id="rvApprove"><i class="bx bx-check me-1" aria-hidden="true"></i>@Localizer["DecisionApprove"]</button>
                            <button type="button" class="btn btn-label-danger" id="rvReject"><i class="bx bx-x me-1" aria-hidden="true"></i>@Localizer["DecisionReject"]</button>
                        </div>
                    </div>
                    <div id="rvDecisionDone" class="alert alert-success small d-none mt-2" role="status"></div>
                    <small class="text-muted d-block mt-3"><i class="bx bx-transfer-alt me-1" aria-hidden="true"></i>@Localizer["SingleChannelNote"]</small>
                </div>
            </div>

            <div class="card shadow-none border claims-form-scope">
                <div class="card-header py-3">
                    <h6 class="mb-0" id="rvEvidenceTitle">@Localizer["EvidenceTitle"]</h6>
                </div>
                <div class="card-body d-grid gap-2" id="rvEvidence" aria-live="polite">
                    <p class="small text-muted mb-0">@Localizer["EvidencePick"]</p>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/css/claims-form.css" asp-append-version="true" />
    <style>
        .kp-review .kp-tree-step { text-align: start; }
        .kp-review .kp-tree-step.active { background: rgba(var(--bs-primary-rgb), .08); border-color: var(--bs-primary); }
        .kp-review .kp-block { cursor: pointer; }
        .kp-review .kp-block:focus-visible, .kp-review .kp-block.active { outline: 2px solid var(--bs-primary); outline-offset: -2px; }
        .kp-review .kp-claim-text { color: var(--bs-body-color); }
        .kp-review .kp-note.is-resolved { opacity: .7; }
        .kp-review .kp-quote { border-inline-start: 3px solid var(--bs-primary-border-subtle); padding-inline-start: .6rem; font-style: italic; }
    </style>
}

@section Scripts {
    <partial name="~/Views/CRM/KnowledgePaths/_StudioL10n.cshtml" />
    @* The read-only evidence cards are the Claims v2 ones (claim-evidence.js card(); its own string bridge). *@
    <partial name="~/Views/CRM/Claims/_FormL10n.cshtml" />
    <script src="~/assets/js/CRM/Claims/claim-evidence.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/KnowledgePaths/studio-common.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/KnowledgePaths/review.js" asp-append-version="true"></script>
}
