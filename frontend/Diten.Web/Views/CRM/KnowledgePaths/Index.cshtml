@using Diten.Web.Views.CRM.KnowledgePaths
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgePathsIndex> Localizer
@{
    ViewData["Title"] = Localizer["KnowledgePathsTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/CRM/KnowledgePaths/_Filter.cshtml" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["KnowledgePathsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* The primary "Create Path" action is rendered inside the DataTable toolbar (.add-new) by index.js — Golden pattern. *@
@* Contract markers rendered by _DataTable: skeleton-loader + data-dt-standard=v2 *@
<partial name="~/Views/CRM/KnowledgePaths/_DataTable.cshtml" />

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/KnowledgePaths/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/KnowledgePaths/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/KnowledgePaths/index.js" asp-append-version="true"></script>
}
