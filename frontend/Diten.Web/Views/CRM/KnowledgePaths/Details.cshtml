@model Diten.Web.Models.CRM.KnowledgePathPageViewModel
@using Diten.Web.Views.CRM.KnowledgePaths
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgePathsIndex> Localizer
@{
    ViewData["Title"] = Localizer["PathDetail"].Value;
    Layout = "_LayoutTenantShell";
    var p = Model.Path;
    string Show(object? value) =>
        value is null || (value is string s && string.IsNullOrWhiteSpace(s)) ? "-" : value.ToString()!;
    string ResolutionBadge(string status) => status switch
    {
        "unresolved" => "bg-label-danger",
        "resolved-latest" => "bg-label-info",
        _ => "bg-label-success"
    };
}

<div id="knowledgePathDetailsPage" class="knowledge-path-details"
     data-path-id="@p.PathId" data-archived="@p.IsArchived.ToString().ToLowerInvariant()"
     data-published="@p.IsStepSetFrozen.ToString().ToLowerInvariant()">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@p.PathName</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/CRM/KnowledgePaths">@Localizer["KnowledgePathsTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@p.PathCode @@ @p.PathVersion</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="/CRM/KnowledgePaths" class="btn btn-label-secondary">@Localizer["BackToList"]</a>
            @if (Model.CanManage && !p.IsArchived && !p.IsStepSetFrozen)
            {
                <a href="/CRM/KnowledgePaths/Edit/@p.PathId" class="btn btn-primary">@Localizer["EditPath"]</a>
            }
            @if (Model.CanPublish && !p.IsArchived && !p.IsStepSetFrozen)
            {
                <button type="button" id="publishPath" class="btn btn-label-success">@Localizer["Publish"]</button>
            }
            @if (Model.CanManage && p.IsStepSetFrozen && !p.IsArchived)
            {
                <button type="button" id="newVersionPath" class="btn btn-label-primary">@Localizer["NewVersion"]</button>
            }
            @if (Model.CanManage && !p.IsArchived)
            {
                <button type="button" id="archivePath" class="btn btn-label-warning" data-name="@p.PathName">@Localizer["ArchivePath"]</button>
            }
        </div>
    </div>

    @if (p.IsArchived)
    {
        <div class="alert alert-warning"><i class="bx bx-archive me-1"></i>@Localizer["ArchivedPathReadOnly"]</div>
    }
    else if (p.IsStepSetFrozen)
    {
        <div class="alert alert-info"><i class="bx bx-lock-alt me-1"></i>@Localizer["FrozenStepsHelp"]</div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IdentitySection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-purchase-tag-alt"></i><div>
                            <div class="backbone-preview-label">@Localizer["PathCode"]</div>
                            <div class="backbone-preview-value mt-1">@p.PathCode</div></div></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-git-branch"></i><div>
                            <div class="backbone-preview-label">@Localizer["PathVersion"]</div>
                            <div class="backbone-preview-value mt-1">@p.PathVersion</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-target-lock"></i><div>
                            <div class="backbone-preview-label">@Localizer["Objective"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@Show(p.Objective)</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-note"></i><div>
                            <div class="backbone-preview-label">@Localizer["Description"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@Show(p.Description)</div></div></div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ClassificationSection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-category"></i><div>
                            <div class="backbone-preview-label">@Localizer["SubjectId"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@(string.IsNullOrEmpty(p.SubjectName) ? Show(p.SubjectId) : p.SubjectName)</div></div></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-sitemap"></i><div>
                            <div class="backbone-preview-label">@Localizer["TopicId"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@(string.IsNullOrEmpty(p.TopicName) ? Show(p.TopicId) : p.TopicName)</div></div></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-user-detail"></i><div>
                            <div class="backbone-preview-label">@Localizer["AudienceProfileId"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@(string.IsNullOrEmpty(p.AudienceProfileName) ? Show(p.AudienceProfileId) : p.AudienceProfileName)</div></div></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-globe"></i><div>
                            <div class="backbone-preview-label">@Localizer["LanguageCode"]</div>
                            <div class="backbone-preview-value mt-1">@Show(p.LanguageCode)</div></div></div>
                    </div>
                </div>
            </section>

        </div>

        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SchedulingSection"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-check-shield"></i><div>
                            <div class="backbone-preview-label">@Localizer["PathStatus"]</div>
                            <div class="mt-1"><span class="badge bg-label-primary">@p.PathStatus</span></div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-data"></i><div>
                            <div class="backbone-preview-label">@Localizer["Source"]</div>
                            <div class="backbone-preview-value mt-1">@Show(p.Source)</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-calendar-event"></i><div>
                            <div class="backbone-preview-label">@Localizer["EffectiveFrom"]</div>
                            <div class="backbone-preview-value mt-1">@p.EffectiveFrom.ToString("yyyy-MM-dd")</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-calendar-x"></i><div>
                            <div class="backbone-preview-label">@Localizer["EffectiveTo"]</div>
                            <div class="backbone-preview-value mt-1">@(p.EffectiveTo?.ToString("yyyy-MM-dd") ?? "-")</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-list-ol"></i><div>
                            <div class="backbone-preview-label">@Localizer["ActiveStepCount"]</div>
                            <div class="backbone-preview-value mt-1">@p.ActiveStepCount (@Localizer["RequiredStepCount"]: @p.RequiredStepCount)</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-time"></i><div>
                            <div class="backbone-preview-label">@Localizer["UpdatedAt"]</div>
                            <div class="backbone-preview-value mt-1">@(p.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-archive"></i><div>
                            <div class="backbone-preview-label">@Localizer["Archived"]</div>
                            <div class="mt-1">
                                @if (p.IsArchived) { <span class="badge bg-label-warning">@Localizer["Yes"]</span> }
                                else { <span class="badge bg-label-success">@Localizer["No"]</span> }
                            </div></div></div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    @* Steps — full-width row below the 8-4 identity/classification/scheduling block. *@
    <div class="row g-4 mt-4">
        <div class="col-12">
            <section class="card backbone-preview-section p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["StepsSection"]</h6>
                    @if (p.Steps.Any(s => s.IsArchived))
                    {
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="showArchivedSteps">
                            <label class="form-check-label" for="showArchivedSteps">@Localizer["ShowArchived"]</label>
                        </div>
                    }
                </div>
                @if (p.Steps.Count == 0)
                {
                    <div class="text-muted">@Localizer["NoSteps"]</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @* Active steps first, then archived (hidden by default; revealed by the Show-archived switch). *@
                        @foreach (var s in p.Steps.Where(x => !x.IsArchived).OrderBy(x => x.StepOrder)
                                    .Concat(p.Steps.Where(x => x.IsArchived).OrderBy(x => x.StepOrder)))
                        {
                            <article class="inbox-row p-3 @(s.IsArchived ? "kp-step-archived d-none opacity-75" : "")" style="cursor:default;">
                                <div class="inbox-row__main">
                                    <div class="inbox-row__line inbox-row__line--primary d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge inbox-row__type inbox-row__badge-outline inbox-row__badge--type-default flex-shrink-0">@s.StepType</span>
                                        <span class="badge inbox-row__status @ResolutionBadge(s.ContentResolutionStatus) flex-shrink-0">@s.ContentResolutionStatus</span>
                                        @if (!string.IsNullOrEmpty(s.VersionPinPolicy))
                                        {
                                            <span class="badge inbox-row__badge-outline inbox-row__badge--role-approver flex-shrink-0">@s.VersionPinPolicy</span>
                                        }
                                        @if (s.IsCrossSubjectStep) { <span class="badge bg-label-secondary flex-shrink-0">@Localizer["CrossSubject"]</span> }
                                        @if (s.IsCrossLanguageStep) { <span class="badge bg-label-secondary flex-shrink-0">@Localizer["CrossLanguage"]</span> }
                                        @if (s.IsArchived) { <span class="badge bg-label-warning flex-shrink-0">@Localizer["Archived"]</span> }
                                        <h5 class="inbox-row__title mb-0 text-truncate">@s.StepTitle</h5>
                                    </div>
                                    <div class="inbox-row__line inbox-row__line--secondary text-muted">
                                        <span class="inbox-row__required-arrow">→</span>
                                        <span class="inbox-row__required-text">@s.StepCode</span>
                                        <span class="inbox-row__meta-separator">•</span>
                                        <span>@(string.IsNullOrEmpty(s.CompletionRule) ? s.StepType : s.CompletionRule)</span>
                                    </div>
                                    <div class="inbox-row__line inbox-row__line--tertiary text-muted">
                                        <span class="inbox-row__meta-item"><i class="bx bx-hash inbox-row__calendar-icon"></i><span>#@s.StepOrder</span></span>
                                        @if (s.IsRequired)
                                        {
                                            <span class="inbox-row__meta-separator">•</span>
                                            <span class="badge inbox-row__priority">@Localizer["IsRequired"]</span>
                                        }
                                        @if (s.BranchConditions.Count > 0)
                                        {
                                            <span class="inbox-row__meta-separator">•</span>
                                            <span class="badge bg-label-secondary">@Localizer["BranchConditions"]: @s.BranchConditions.Count</span>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/CRM/KnowledgePaths/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/KnowledgePaths/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/KnowledgePaths/details.js" asp-append-version="true"></script>
}
