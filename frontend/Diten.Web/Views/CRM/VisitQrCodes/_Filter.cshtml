@model Diten.Web.Models.CRM.VisitQrCodesViewModel
@using Diten.Web.Views.CRM.VisitQrCodes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitQrCodesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* W3E-FIX (U-1) — the inline collapse filter of the standard. Each chip is ONE value (the CRM list filters on one region /
   type / city / QR status), so the chips are single selects with "show all"; the name search is the toolbar's. *@
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @if (Model.CanReadAccounts)
                    {
                        @* Filter Chip: Region — the territory node (its subtree), from the Accounts territory lookups *@
                        <div class="filter-chip filter-region">
                            <select id="filterRegion" class="form-select form-select-sm select2" data-placeholder="@Localizer["FilterRegion"]">
                                <option value="">@SharedLocalizer["ShowAll"]</option>
                            </select>
                        </div>
                    }

                    @* Filter Chip: Institution type (the BRD account-type set, in the reader's language) *@
                    <div class="filter-chip filter-type">
                        <select id="filterType" class="form-select form-select-sm select2" data-placeholder="@Localizer["FilterType"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    @* Filter Chip: City (the BRD city set) *@
                    <div class="filter-chip filter-city">
                        <select id="filterCity" class="form-select form-select-sm select2" data-placeholder="@Localizer["ColCity"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    @* Filter Chip: QR status *@
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" data-placeholder="@Localizer["ColStatus"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="none">@Localizer["StatusOpt_none"]</option>
                            <option value="active">@Localizer["StatusOpt_active"]</option>
                            <option value="revoked">@Localizer["StatusOpt_revoked"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
