@model Diten.Web.Models.CRM.VisitQrCodesViewModel
@using Diten.Web.Views.CRM.VisitQrCodes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitQrIndex> Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@*
    WP-VW-W3E (W3E-WEB-a, Q5) — the institution QR codes: filters (region = territory node, type, city, QR status, name
    search), the server-paged list (43K institutions never leave the CRM), "↳ parent" and "parent code applies" in the row,
    multi-select → "Generate for selected (those without a code)" (bulk-issue) and "Print selected (label sheet)", the result
    strip, the empty state. Every call is a same-origin proxy under /CRM/VisitQrCodes/api/*. UAS-001: without
    crm.visit-qr.read NOTHING but the notice; without .manage no selection and no print.
*@
@if (!Model.CanRead)
{
    <partial name="_AccessDenied" model="@Localizer["PageTitle"].Value" />
    return;
}

<div class="vq-scope vq-page" id="vq-list-root"
     data-api-base="/CRM/VisitQrCodes/api"
     data-print-base="/CRM/VisitQrCodes"
     data-can-manage="@Model.CanManage.ToString().ToLowerInvariant()"
     data-can-read-accounts="@Model.CanReadAccounts.ToString().ToLowerInvariant()">
    <div>
        <div class="vq-crumb">@Localizer["Crumb"]</div>
        <h4 class="vq-title" style="margin-top:4px">@Localizer["PageTitle"]</h4>
        <div class="vq-intro">@Localizer["Intro"]</div>
    </div>

    <div class="vq-result d-none" id="vq-result" role="status">
        <i class="bx bx-check-circle"></i><span class="vq-result-text" id="vq-result-text"></span>
        <a href="#" id="vq-result-print">@Localizer["PrintLabelsLink"]</a>
        <button type="button" class="vq-x" id="vq-result-close" aria-label="@Localizer["CloseButton"]"><i class="bx bx-x"></i></button>
    </div>
    <div class="vq-callout vq-callout-danger d-none" id="vq-list-error" role="alert"><i class="bx bx-error-circle"></i><span class="vq-grow" id="vq-list-error-text"></span></div>

    <div class="vq-card">
        <div class="vq-filters-title">@Localizer["FiltersTitle"]</div>
        <div class="vq-filters">
            @if (Model.CanReadAccounts)
            {
                <select class="vq-select" id="vq-f-region" aria-label="@Localizer["AllRegions"]"><option value="">@Localizer["AllRegions"]</option></select>
            }
            <select class="vq-select" id="vq-f-type" aria-label="@Localizer["AllTypes"]"><option value="">@Localizer["AllTypes"]</option></select>
            <select class="vq-select" id="vq-f-city" aria-label="@Localizer["AllCities"]"><option value="">@Localizer["AllCities"]</option></select>
            <select class="vq-select" id="vq-f-status" aria-label="@Localizer["AllStatuses"]">
                <option value="">@Localizer["AllStatuses"]</option>
                <option value="none">@Localizer["StatusOpt_none"]</option>
                <option value="active">@Localizer["StatusOpt_active"]</option>
                <option value="revoked">@Localizer["StatusOpt_revoked"]</option>
            </select>
        </div>
        <div class="vq-toolbar">
            <div class="vq-search"><i class="bx bx-search"></i><input type="search" class="vq-input" id="vq-f-search" placeholder="@Localizer["SearchPlaceholder"]" aria-label="@Localizer["SearchPlaceholder"]" /></div>
            <div class="vq-grow"></div>
            @if (Model.CanManage)
            {
                <div class="vq-selbar d-none" id="vq-selbar">
                    <span class="vq-selcount" id="vq-selcount"></span>
                    <button type="button" class="vq-btn vq-btn-p vq-btn-sm" id="vq-bulk-generate"><i class="bx bx-plus"></i>@Localizer["BulkGenerate"]</button>
                    <button type="button" class="vq-btn vq-btn-o vq-btn-sm" id="vq-bulk-print"><i class="bx bx-printer"></i>@Localizer["BulkPrint"]</button>
                </div>
            }
            <span class="vq-count-label" id="vq-count"></span>
        </div>
        <div class="vq-grid-wrap">
            <div class="vq-grid" role="table" aria-label="@Localizer["PageTitle"]">
                <div class="vq-row vq-row-head" role="row">
                    @if (Model.CanManage)
                    {
                        <input type="checkbox" id="vq-select-all" aria-label="@Localizer["SelectAll"]" />
                    }
                    else
                    {
                        <span></span>
                    }
                    <span role="columnheader">@Localizer["ColInstitution"]</span><span role="columnheader">@Localizer["ColType"]</span><span role="columnheader">@Localizer["ColCity"]</span>
                    <span role="columnheader">@Localizer["ColStatus"]</span><span role="columnheader">@Localizer["ColVersion"]</span><span role="columnheader">@Localizer["ColLastScan"]</span>
                    <span role="columnheader">@Localizer["ColRecent"]</span><span role="columnheader">@Localizer["ColActions"]</span>
                </div>
                <div id="vq-rows"><div class="vq-skel"><i class="bx bx-loader-alt bx-spin"></i></div></div>
                <div class="vq-empty d-none" id="vq-empty">
                    <div class="vq-empty-icon"><i class="bx bx-filter-alt"></i></div>
                    <div class="vq-empty-title">@Localizer["EmptyTitle"]</div>
                    <button type="button" class="vq-btn vq-btn-o vq-btn-sm" id="vq-clear">@Localizer["ClearFilters"]</button>
                </div>
            </div>
        </div>
        <div class="vq-pager d-none" id="vq-pager">
            <span id="vq-page-info"></span>
            <button type="button" class="vq-btn vq-btn-s vq-btn-sm" id="vq-prev"><i class="bx bx-chevron-left vq-flip"></i>@Localizer["PrevPage"]</button>
            <button type="button" class="vq-btn vq-btn-s vq-btn-sm" id="vq-next">@Localizer["NextPage"]<i class="bx bx-chevron-right vq-flip"></i></button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/js/CRM/VisitQrCodes/visit-qr.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.VisitQrL10n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            VisitQrIndex.ScriptKeys.ToDictionary(k => k, k => Localizer[k].Value)));
    </script>
    <script src="~/assets/js/CRM/VisitPlanning/format.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitQrCodes/qr-core.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitQrCodes/qr-codes.js" asp-append-version="true"></script>
}
