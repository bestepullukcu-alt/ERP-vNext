@using Diten.Web.Views.CRM.KnowledgeConcepts
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgeConceptsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* Tab 1 inline filter host. A second Golden filter host on the same page stays unstyled unless it carries
   dt-inline-filter-host — every chip rule is scoped to #inlineFilterHost plus that twin class. *@
<div id="typesFilterHost" class="dt-inline-filter-host">
    <div class="collapse" id="typesFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="typesFilterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    <div class="filter-chip">
                        <select id="filterTypesSubjectId" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["SubjectId"]"></select>
                    </div>
                    <div class="filter-chip">
                        <select id="filterTypesStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Status"]"></select>
                    </div>
                    <div class="filter-chip">
                        <select id="filterTypesArchived" class="form-select form-select-sm select2" data-placeholder="@Localizer["IncludeArchived"]">
                            <option value="true">@Localizer["IncludeArchived"]</option>
                            <option value="false">@Localizer["Active"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" data-concept-apply="concept-types">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" data-concept-reset="concept-types">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
