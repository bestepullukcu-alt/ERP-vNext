@using Diten.Web.Views.CRM.KnowledgeConcepts
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgeConceptsIndex> Localizer
@{
    ViewData["Title"] = Localizer["CreateTemplate"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@Localizer["CreateTemplate"]</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/CRM/KnowledgeConcepts">@Localizer["ConceptsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@Localizer["CreateTemplate"]</li>
            </ol>
        </nav>
    </div>
    @* SCMM-09-UI-refine-fix (Not 5): the required-fields tracker sits in the right action group (Golden Compact
       layout, Organization/Positions/Form), immediately before Save — not beside the title. *@
    <div class="d-flex align-items-center gap-2">
        <a href="/CRM/KnowledgeConcepts" class="btn btn-label-secondary">@Localizer["Cancel"]</a>
        <span id="conceptTemplateRequiredTracker" class="d-flex align-items-center"></span>
        <button type="submit" form="conceptTemplateForm" id="btnSaveConceptTemplate" class="btn btn-primary">@Localizer["Save"]</button>
    </div>
</div>

<partial name="~/Views/CRM/KnowledgeConcepts/_TemplateForm.cshtml" />

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
}

@section Scripts {
    <partial name="~/Views/CRM/KnowledgeConcepts/_TemplateFormL10n.cshtml" />
    <script src="~/assets/vendor/libs/sortablejs/sortable.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/KnowledgeConcepts/template-form.js" asp-append-version="true"></script>
}
