@using Diten.Web.Views.CRM.KnowledgeConcepts
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgeConceptsIndex> Localizer
@{
    // SCMM-10-UI-refine (Not 5): the Chain Template create/edit body, Golden Compact vertical layout (Claims/Node
    // pattern). The branch/step builder + Subject/Status pickers are driven by template-form.js; field ids match the
    // former Slim offcanvas so the ported builder logic is unchanged. Moderator = select2 tags, ForWhom = audience
    // multi-select2 (Not 6).
}

<div id="conceptTemplateFormAlert" class="alert alert-danger d-none" role="alert"></div>
<div id="conceptTemplateFrozenNote" class="alert alert-warning d-none" role="status">@Localizer["PublishedSequenceFrozen"]</div>

<form id="conceptTemplateForm" class="needs-validation" novalidate
      data-required-tracker-target="#conceptTemplateRequiredTracker"
      data-required-tracker-wrapper-class="d-flex align-items-center"
      data-required-tracker-badge-class="badge bg-label-danger d-flex align-items-center">
    <input type="hidden" id="templateFormId" />
    <input type="hidden" id="tplOrderedConceptTypes" />

    @* WP-CT-FE-8: 2 columns (Task Create pattern, 8/4) — left = identity (paired fields) + the branch diagram (FE-3/4,
       wider now); right = type palette (next to the diagram, short drag distance) → side-panel tabs (FE-5) → reference
       fields + publish (FE-6). Stacks below lg. Blocks were only moved: every id / class hook is unchanged, so
       template-form.js load / submit / spine derivation / drag are untouched. *@
    @* WP-CT-FE-6: read-only band (published template) — filled by template-form.js with "New version". *@
    <div id="tplReadOnlyBand" class="d-none mb-3"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IdentitySection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label for="tplSubjectId" class="form-label fw-medium">@Localizer["SubjectId"] <span class="text-danger">*</span></label>
                            <select id="tplSubjectId" class="form-select tpl-select2" data-placeholder="@Localizer["SelectOption"]" required></select>
                            <div class="form-text">@Localizer["NodePickerSubjectFirst"]</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="tplChainCode" class="form-label fw-medium">@Localizer["ChainCode"] <span class="text-danger">*</span></label>
                            <input type="text" id="tplChainCode" class="form-control" maxlength="120" required />
                            <div class="form-text" id="tplChainCodeHint">@Localizer["ImmutableAfterCreate"]</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="tplChainName" class="form-label fw-medium">@Localizer["ChainName"] <span class="text-danger">*</span></label>
                            <input type="text" id="tplChainName" class="form-control" maxlength="240" required />
                        </div>
                        @* SCMM-10-MOD-C: Moderator + ForWhom are TEMPLATE-level (delivery identity), not step-level.
                           Moderator = content-moderator-role published value (who presents the chain); ForWhom =
                           AudienceProfile refs (the chain's target audience). Both optional. *@
                        <div class="col-12 col-md-6">
                            <label for="tplModeratorRoleType" class="form-label fw-medium">@Localizer["Moderator"]</label>
                            <select id="tplModeratorRoleType" class="form-select tpl-select2" data-placeholder="@Localizer["ModeratorPlaceholder"]"></select>
                            <div class="form-text">@Localizer["ModeratorHint"]</div>
                        </div>
                        <div class="col-12">
                            <label for="tplForWhom" class="form-label fw-medium">@Localizer["ForWhom"]</label>
                            <select id="tplForWhom" class="form-select tpl-select2" multiple data-placeholder="@Localizer["ForWhomPlaceholder"]"></select>
                            <div class="form-text">@Localizer["ForWhomHint"]</div>
                        </div>
                        <div class="col-12">
                            <label for="tplDescription" class="form-label fw-medium">@Localizer["Description"]</label>
                            <textarea id="tplDescription" class="form-control" rows="3" maxlength="2000"></textarea>
                        </div>
                    </div>
                </div>
            </section>

            @* SCMM-10 (③) branched builder — each branch is an ordered step list; the OrderedConceptTypes spine
               (min 2 distinct types) is derived from all branches. *@
            <section class="card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["Branches"] <span class="text-danger">*</span></h6>
                        <button type="button" id="btnTplAddBranch" class="btn btn-sm btn-label-primary">
                            <i class="bx bx-plus me-1"></i>@Localizer["AddBranch"]
                        </button>
                    </div>
                    <div class="form-text mb-2">@Localizer["BranchesNote"]</div>
                    <div id="tplBranches" class="d-flex flex-column gap-3"></div>
                    <div id="tplBranchesEmpty" class="form-text">@Localizer["BranchesEmpty"]</div>
                    <div id="tplSequenceError" class="text-danger small mt-1 d-none"></div>
                    @* WP-CT-FE-5: off-spine summary (unresolved "out" types from the diagnostics) → opens the Non-conforming tab. *@
                    <div id="tplOffSpineSummary" class="mt-2 d-none"></div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            @* Type palette: each subject type with its node count, how many branches use it and a "not on spine"
               badge. Rows carry draggable-ready hooks (js-palette-type / js-palette-handle); drag itself is FE-4. *@
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-3">@Localizer["TypePalette"]</h6>
                    <ul id="tplTypePalette" class="list-unstyled d-flex flex-column gap-2 mb-0"></ul>
                    <div id="tplTypePaletteEmpty" class="form-text">@Localizer["NodePickerSubjectFirst"]</div>
                </div>
            </section>
            @* WP-CT-FE-5: Connections / Non-conforming / Versions. Filled by template-form.js from the BE-A diagnostics
               read, the BE-B resolutions write and the existing template list read. Tab buttons are type="button" so they
               never submit the form. *@
            <section class="card mb-4" id="tplSidePanel">
                <div class="card-header p-2 border-bottom">
                    <ul class="nav nav-pills nav-fill small flex-nowrap" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link active py-1 px-2" data-bs-toggle="tab" data-bs-target="#tplTabConnections" role="tab" aria-controls="tplTabConnections" aria-selected="true">@Localizer["TabConnections"]</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link py-1 px-2" id="tplTabNonConformingBtn" data-bs-toggle="tab" data-bs-target="#tplTabNonConforming" role="tab" aria-controls="tplTabNonConforming" aria-selected="false">
                                @Localizer["TabNonConforming"] <span id="tplNonConformingBadge" class="badge rounded-pill bg-danger ms-1 d-none">0</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button" class="nav-link py-1 px-2" data-bs-toggle="tab" data-bs-target="#tplTabVersions" role="tab" aria-controls="tplTabVersions" aria-selected="false">@Localizer["TabVersions"]</button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-3 tab-content">
                    <div class="tab-pane fade show active" id="tplTabConnections" role="tabpanel"><div id="tplConnections"></div></div>
                    <div class="tab-pane fade" id="tplTabNonConforming" role="tabpanel"><div id="tplNonConforming"></div></div>
                    <div class="tab-pane fade" id="tplTabVersions" role="tabpanel"><div id="tplVersions"></div></div>
                </div>
            </section>
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ReferenceSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label for="tplChainVersion" class="form-label fw-medium">@Localizer["ChainVersion"]</label>
                            <input type="text" id="tplChainVersion" class="form-control" maxlength="40" placeholder="v1" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="tplStatus" class="form-label fw-medium">@Localizer["Status"]</label>
                            <select id="tplStatus" class="form-select tpl-select2" data-placeholder="@Localizer["SelectOption"]"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="tplEffectiveFrom" class="form-label fw-medium">@Localizer["EffectiveFrom"] <span class="text-danger">*</span></label>
                            <input type="date" id="tplEffectiveFrom" class="form-control" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="tplEffectiveTo" class="form-label fw-medium">@Localizer["EffectiveTo"]</label>
                            <input type="date" id="tplEffectiveTo" class="form-control" />
                        </div>
                    </div>
                    @* WP-CT-FE-6: the primary publish path — opens the confirm dialog (hidden on a read-only template). *@
                    <button type="button" id="btnTplPublish" class="btn btn-label-primary w-100 mt-4">
                        <i class="bx bx-lock-alt me-1"></i>@Localizer["PublishDialogTitle"]
                    </button>
                </div>
            </section>
        </div>
    </div>
</form>

@* WP-CT-FE-6: publish confirm dialog. A client-side MIRROR of the WP-CT-BE-B publish guards (the service still enforces
   them): blocking checks disable the confirm button; unresolved non-conforming relationships only warn (D8). Confirm =
   status "published" + the existing save. *@
<div class="modal fade" id="tplPublishModal" tabindex="-1" aria-labelledby="tplPublishModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tplPublishModalTitle"><i class="bx bx-lock-alt me-1"></i>@Localizer["PublishDialogTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <div class="small text-muted mb-1">@Localizer["PublishFrozenSpine"]</div>
                <div id="tplPublishSpine" class="d-flex flex-wrap align-items-center gap-1 mb-3"></div>
                <div class="small mb-3">@Localizer["PublishEffect"]</div>
                <h6 class="small text-uppercase text-muted fw-semibold mb-2">@Localizer["PublishChecks"]</h6>
                <ul id="tplPublishChecks" class="list-unstyled mb-3"></ul>
                <div id="tplPublishWarn" class="alert alert-warning py-2 small mb-0 d-none" role="status"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="btnTplPublishConfirm"><i class="bx bx-lock-alt me-1"></i>@Localizer["PublishConfirm"]</button>
            </div>
        </div>
    </div>
</div>
