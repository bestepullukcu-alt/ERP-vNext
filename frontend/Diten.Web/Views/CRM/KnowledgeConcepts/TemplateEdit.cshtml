@using Diten.Web.Views.CRM.KnowledgeConcepts
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgeConceptsIndex> Localizer
@{
    ViewData["Title"] = Localizer["EditTemplate"].Value;
    Layout = "_LayoutTenantShell";
    var templateId = ViewData["TemplateId"]?.ToString();
}

<div class="d-flex align-items-center justify-content-between mb-3" data-template-id="@templateId" id="templateEditHeader">
    <div>
        <h5 class="mb-0 d-flex align-items-center gap-2">
            @Localizer["EditTemplate"]
            <span id="conceptTemplateRequiredTracker" class="d-flex align-items-center"></span>
        </h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/CRM/KnowledgeConcepts">@Localizer["ConceptsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary" id="tplEditCrumb">@Localizer["EditTemplate"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/CRM/KnowledgeConcepts" class="btn btn-label-secondary">@Localizer["Cancel"]</a>
        @* SCMM-10 (③): a published (frozen) template is read-only; "New version" clones it into a fresh draft. *@
        <button type="button" id="btnTplNewVersion" class="btn btn-label-primary d-none">
            <i class="bx bx-git-branch me-1"></i>@Localizer["NewVersion"]
        </button>
        <button type="submit" form="conceptTemplateForm" id="btnSaveConceptTemplate" class="btn btn-primary">@Localizer["Save"]</button>
    </div>
</div>

<partial name="~/Views/CRM/KnowledgeConcepts/_TemplateForm.cshtml" />

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
}

@section Scripts {
    <partial name="~/Views/CRM/KnowledgeConcepts/_TemplateFormL10n.cshtml" />
    <script src="~/assets/js/CRM/KnowledgeConcepts/template-form.js" asp-append-version="true"></script>
}
