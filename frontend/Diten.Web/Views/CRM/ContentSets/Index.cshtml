@using Diten.Web.Views.CRM.ContentSets
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ContentSetsIndex> Localizer
@{
    ViewData["Title"] = Localizer["SetsTitle"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["SetsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    <small class="text-muted"><i class="bx bx-info-circle me-1"></i>@Localizer["DraftNote"]</small>
</div>

@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/CRM/ContentSets/_Filter.cshtml" />
<partial name="~/Views/CRM/ContentSets/_DataTable.cshtml" />

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="setPreviewTitle">
    <div class="offcanvas-header p-4">
        <div class="min-w-0">
            <h5 id="setPreviewTitle" class="offcanvas-title mb-0 text-truncate">-</h5>
            <small id="setPreviewSubtitle" class="text-muted d-block text-truncate">-</small>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@Localizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body flex-grow-1 p-4 border-top">
        <dl class="row mb-0 small">
            <dt class="col-5 text-muted">@Localizer["Status"]</dt><dd class="col-7" id="pvStatus">-</dd>
            <dt class="col-5 text-muted">@Localizer["Template"]</dt><dd class="col-7" id="pvTemplate">-</dd>
            <dt class="col-5 text-muted">@Localizer["Components"]</dt><dd class="col-7" id="pvComponents">-</dd>
            <dt class="col-5 text-muted">@Localizer["Claims"]</dt><dd class="col-7" id="pvClaims">-</dd>
        </dl>
    </div>
    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@Localizer["Cancel"]</button>
        <a href="#" id="setPreviewEdit" class="btn btn-primary">@Localizer["OpenWorkspace"]</a>
    </div>
</div>

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/ContentSets/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/ContentSets/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/ContentSets/index.js" asp-append-version="true"></script>
}
