@using System.Text.Json
@using Diten.Web.Views.CRM.ContentSets
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ContentSetsIndex> Localizer
@{
    var keys = new[] {
        "SetsTitle", "ContentStudioTitle", "Template", "Components", "Claims",
        "AddComponent", "AddClaim", "Remove", "Position", "UpdatePosition", "Branch", "Step", "Min", "Max",
        "EmptyArrangement", "ErrorState", "Loading", "Cancel", "Yes", "No",
        "CloneSet", "CloneSetCodePrompt", "CloneSetNamePrompt", "RecordCloned", "ApplyEligibility",
        "EligibilityApplied", "ArchiveSet", "ArchiveSetConfirm", "RecordArchived",
        "Eligible", "Blocked", "Unresolved", "NotEvaluated", "EligibilitySummary",
        "ComponentPickerPlaceholder", "ClaimPickerPlaceholder", "NeedsAssessmentWarn",
        "StatusDraft", "StatusInactive", "StatusArchived", "NoComponents", "NoClaims", "AddedOn",
        // WP-SB-1R — set context header + the coded CRM failures (JS reads L["ContextError_" + code]).
        "Country", "Language", "Product", "Audience", "SaveContext", "ContextSaved",
        "ContextError_country_invalid", "ContextError_language_not_in_country", "ContextError_reference_set_unavailable",
        "ContextError_component_language_mismatch", "ContextError_context_locked", "ContextError_component_language_mixed" };
    var values = keys.ToDictionary(x => x, x => Localizer[x].Value);
}
<script id="workspace-l10n" type="application/json">@Html.Raw(JsonSerializer.Serialize(values))</script>
