@using System.Globalization
@using Diten.Web.Infrastructure
@using Diten.Web.Views.CRM.VisitEvidenceFlags
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitEvidenceFlagsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* W3E-FLAGS-STD — the L10n payload of the standard (index.l10n.js merges it into window.L10n): the toolbar / filter
   vocabulary of the shared layer + EVERY word the page script reads (VisitEvidenceFlagsIndex.ScriptKeys — one list, so the
   tests check exactly these in seven languages). A page word wins over a shared one with the same name. *@
@{
    var shared = new
    {
        Active = SharedLocalizer["Active"].Value,
        Passive = SharedLocalizer["Passive"].Value,
        Unknown = SharedLocalizer["Unknown"].Value,
        Actions = Localizer["ColActions"].Value,
        Edit = SharedLocalizer["EditRecord"].Value,
        ViewDetails = SharedLocalizer["ViewDetails"].Value,
        QuickView = Localizer["QuickView"].Value,
        AreYouSure = SharedLocalizer["AreYouSure"].Value,
        Cancel = SharedLocalizer["Cancel"].Value,
        Search = SharedLocalizer["Search"].Value,
        Export = SharedLocalizer["Export"].Value,
        Import = SharedLocalizer["Import"].Value,
        ComingSoon = SharedLocalizer["ComingSoon"].Value,
        Filter = SharedLocalizer["Filter"].Value,
        Apply = SharedLocalizer["Apply"].Value,
        Reset = SharedLocalizer["Reset"].Value,
        ShowAll = SharedLocalizer["ShowAll"].Value,
        SaveView = SharedLocalizer["SaveView"].Value,
        ColumnVisibility = SharedLocalizer["ColumnVisibility"].Value,
        Status = SharedLocalizer["Status"].Value,
        RecordSaved = SharedLocalizer["RecordSaved"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
        // E2-2 — the custom range SHOWS the culture's short date (flatpickr altFormat); it still sends yyyy-MM-dd
        DateFormat = DateFieldFormat.Flatpickr(CultureInfo.CurrentCulture)
    };
    var payload = new Dictionary<string, string>(StringComparer.Ordinal);
    foreach (var property in shared.GetType().GetProperties())
    {
        payload[property.Name] = (string)property.GetValue(shared)!;
    }

    foreach (var key in VisitEvidenceFlagsIndex.ScriptKeys)
    {
        payload[key] = Localizer[key].Value;
    }
}
<script id="visitevidenceflags-l10n" type="application/json">
    @Json.Serialize(payload)
</script>
