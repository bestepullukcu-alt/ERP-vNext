@using Diten.Web.Views.CRM.TerritoryManagement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TerritoryManagementResources> L
@inject IHtmlLocalizer<Diten.Web.SharedResource> Shared

@* The Status chip is populated at runtime from the distinct statuses returned by the grid — the
   territory lifecycle (draft / active / superseded / retired) is owned by the backend, so we never
   hardcode it here. *@
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Filter Chip: Status (Multi-select) *@
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@L["Status"]">
                        </select>
                    </div>

                    @* Filter Chip: Country Scope (Multi-select, populated from loaded rows) *@
                    <div class="filter-chip filter-country-scope">
                        <select id="filterCountryScope" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@L["CountryScope"]">
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @Shared["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @Shared["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
