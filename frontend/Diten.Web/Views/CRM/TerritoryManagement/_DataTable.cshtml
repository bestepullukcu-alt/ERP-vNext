@using Diten.Web.Views.CRM.TerritoryManagement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TerritoryManagementResources> L
@inject IHtmlLocalizer<Diten.Web.SharedResource> Shared

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-territorymodels" data-dt-standard="v2" class="datatables-territorymodels table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@L["ModelCode"]</th>
                    <th class="all">@L["Name"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["VersionNumber"]</th>
                    <th>@L["CountryScope"]</th>
                    <th>@L["BusinessUnitScope"]</th>
                    <th>@L["EffectiveFrom"]</th>
                    <th>@L["EffectiveTo"]</th>
                    <th class="cell-fit text-end pe-3 all">@L["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
