@model Diten.Web.Models.CRM.TerritoryModelDetailPageViewModel
@using Diten.Web.Views.CRM.TerritoryManagement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TerritoryManagementResources> L
@inject IHtmlLocalizer<Diten.Web.SharedResource> Shared
@{
    var m = Model.Model;
    var isDraft = string.Equals(m.Status, "draft", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = $"{L["AssignmentRules"].Value} — {m.Name}";
    Layout = "_LayoutTenantShell";
}

@* Header follows the MOD-0029 Master Register Details convention: title → breadcrumb → description. *@
<div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-3 gap-3">
    <div>
        <h5 class="mb-0 d-flex align-items-center gap-2">
            @L["AssignmentRules"]
            <span class="badge bg-label-secondary">@(m.StoredStatus.Length > 0 ? m.StoredStatus : m.Status)</span>
        </h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/CRM/TerritoryManagement">@L["TerritoryModels"]</a></li>
                <li class="breadcrumb-item"><a href="/CRM/TerritoryManagement/Models/@m.Id">@m.ModelCode — @m.Name</a></li>
                <li class="breadcrumb-item active text-primary">@L["AssignmentRules"]</li>
            </ol>
        </nav>
        <span class="text-muted small">@L["AssignmentRulesSubtitle"]</span>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-2">
        <div class="btn-group">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bx bx-navigation me-1"></i>@L["GoTo"]
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                @* Model-wide preview: the only scope in which conflicts can appear, since a conflict is two rules
                   claiming one account for different nodes. Per-rule preview lives in the grid's row actions. *@
                <li>
                    <a class="dropdown-item" href="/CRM/TerritoryManagement/Models/@m.Id/AssignmentRules/Preview">
                        <i class="bx bx-play-circle me-2"></i>@L["PreviewAllRules"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/CRM/TerritoryManagement/Models/@m.Id/AssignmentRules/History">
                        <i class="bx bx-history me-2"></i>@L["HistoryAllRules"]
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="/CRM/TerritoryManagement/Models/@m.Id/ResourceAssignments">
                        <i class="bx bx-group me-2"></i>@L["ResourceAssignments"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/CRM/TerritoryManagement/Models/@m.Id">
                        <i class="bx bx-sitemap me-2"></i>@L["TerritoryHierarchy"]
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="/CRM/TerritoryManagement">
                        <i class="bx bx-arrow-back me-2"></i>@L["BackToList"]
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible" role="alert">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<partial name="~/Views/CRM/TerritoryManagement/_AssignmentRules.cshtml" model="Model" />


<script id="territory-assignment-data" type="application/json">
    @Json.Serialize(new
    {
        modelId = m.Id,
        modelStatus = m.StoredStatus.Length > 0 ? m.StoredStatus : m.Status,
        canEditRules = Model.CanManageModel && isDraft,
        modelEffectiveFrom = m.EffectiveFrom.UtcDateTime.ToString("yyyy-MM-dd"),
        modelEffectiveTo = m.EffectiveTo?.UtcDateTime.ToString("yyyy-MM-dd"),
        labels = new
        {
            createRule = L["CreateRule"].Value,
            editRule = L["EditRule"].Value,
            deleteRule = L["DeleteRule"].Value,
            deleteRuleConfirm = L["DeleteRuleConfirm"].Value,
            noRules = L["NoRules"].Value,
            noMatches = L["NoMatches"].Value,
            noConflicts = L["NoConflicts"].Value,
            enabled = L["Enabled"].Value,
            disabled = L["Disabled"].Value,
            candidates = L["Candidates"].Value,
            conflicts = L["Conflicts"].Value,
            scannedAccounts = L["ScannedAccounts"].Value,
            evaluatedRules = L["EvaluatedRules"].Value,
            generatedAt = L["GeneratedAt"].Value,
            evaluatedAsOf = L["EvaluatedAsOf"].Value,
            noAssignmentsPersisted = L["NoAssignmentsPersisted"].Value,
            conflictWinner = L["ConflictWinner"].Value,
            conflictLoser = L["ConflictLoser"].Value,
            noConflict = L["NoConflict"].Value,
            missingNode = L["MissingNode"].Value,
            yes = L["Yes"].Value,
            edit = L["Edit"].Value,
            confirm = L["Confirm"].Value,
            cancel = L["Cancel"].Value,
            criteriaNotReady = L["CriteriaNotReady"].Value,
            previewThisRule = L["PreviewThisRule"].Value,
            historyThisRule = L["HistoryThisRule"].Value,
            ruleHasConflict = L["RuleHasConflict"].Value,
            previewScopeAll = L["PreviewScopeAll"].Value,
            previewScopeSingle = L["PreviewScopeSingle"].Value,
            singleRuleNoConflicts = L["SingleRuleNoConflicts"].Value,
            // DataTable v2 toolbar labels
            actions = L["Actions"].Value,
            filter = Shared["Filter"].Value,
            saveView = Shared["SaveView"].Value,
            recordSaved = Shared["RecordSaved"].Value,
            recordCreated = Shared["RecordCreated"].Value,
            recordUpdated = Shared["RecordUpdated"].Value,
            recordDeleted = Shared["RecordDeleted"].Value,
            gatewayError = Shared["GatewayError"].Value
        }
    })
</script>

@section Scripts {
    <script src="~/assets/js/CRM/TerritoryManagement/territory-filter-chips.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/TerritoryManagement/assignment-rules.js" asp-append-version="true"></script>
}
