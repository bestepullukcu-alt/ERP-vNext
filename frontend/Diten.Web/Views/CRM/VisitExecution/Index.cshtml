@model Diten.Web.Models.CRM.VisitExecutionIndexViewModel
@using Diten.Web.Views.CRM.VisitExecution
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitExecutionIndex> Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@*
    MOD-0155 FU02 — the Visit Report EXECUTION calendar (D-CALENDAR-UI = A, bespoke tenant-shell). NOT a Golden
    DataTable surface: it is a Day/Week execution calendar with inline mark-done + a report offcanvas. Every call is a
    same-origin proxy to the Gateway under /CRM/VisitExecution/api/*.
*@

<div class="mb-3">
    <h5 class="mb-0">@Localizer["PageTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div class="alert alert-info d-flex align-items-start gap-2" role="alert">
    <i class="bx bx-info-circle mt-1"></i>
    <div>@Localizer["ExecutionNotice"]</div>
</div>

<div id="ve-root"
     data-can-record="@Model.CanRecord.ToString().ToLowerInvariant()"
     data-can-amend="@Model.CanAmend.ToString().ToLowerInvariant()">

    @* ── toolbar: window + resource + view mode ─────────────────────────────────────────────── *@
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label">@Localizer["View"]</label>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-sm btn-outline-primary active" id="ve-view-day">@Localizer["Day"]</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="ve-view-week">@Localizer["Week"]</button>
                    </div>
                </div>
                <div class="col-auto">
                    <label class="form-label" for="ve-anchor">@Localizer["Date"]</label>
                    <input type="date" class="form-control form-control-sm" id="ve-anchor" />
                </div>
                <div class="col-auto">
                    <label class="form-label" for="ve-resource">@Localizer["Resource"]</label>
                    <input type="text" class="form-control form-control-sm" id="ve-resource"
                           placeholder="@Localizer["ResourcePlaceholder"]" />
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-sm btn-primary" id="ve-refresh">
                        <i class="bx bx-refresh"></i> @Localizer["Refresh"]
                    </button>
                </div>
                <div class="col text-end">
                    <span class="small text-muted" id="ve-window-label"></span>
                </div>
            </div>
        </div>
    </div>

    @* ── the calendar grid (day columns, each holding the window's visits) ─────────────────────── *@
    <div class="card">
        <div class="card-body p-2">
            <div id="ve-calendar" class="d-flex gap-2 overflow-auto"></div>
            <div id="ve-empty" class="text-muted small p-3 d-none">@Localizer["NoVisits"]</div>
        </div>
    </div>
</div>

@* ── Visit Report offcanvas (report a completed visit + view/amend an existing report) ─────────── *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="ve-report-offcanvas" aria-labelledby="ve-report-title" style="width: 480px;">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="ve-report-title">@Localizer["ReportTitle"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <input type="hidden" id="ve-report-planned-visit-id" />
        <input type="hidden" id="ve-report-id" />
        <input type="hidden" id="ve-report-version" />
        <input type="hidden" id="ve-report-state" />

        @* WP-E2E-FIX-1 (E9-B2) — "what do I present": product → stage → step titles, from the plan atom (read-only) *@
        <div class="mb-3">
            <label class="form-label">@Localizer["PlannedContent"]</label>
            <div class="border rounded bg-light p-2 small" id="ve-planned-content">@Localizer["NoPlannedContent"]</div>
        </div>

        @* WP-E2E-FIX-1 (E9-B3) — the presented stage is PICKED from the planned journey (default: the planned stage) *@
        <div class="mb-3" id="ve-actual-stage-block">
            <label class="form-label" for="ve-actual-stage">@Localizer["ActualStage"]</label>
            <select class="form-select form-select-sm" id="ve-actual-stage"></select>
            <div class="form-text" id="ve-actual-stage-hint"></div>
        </div>

        <div class="mb-2">
            <label class="form-label" for="ve-outcome-code">@Localizer["OutcomeCode"] <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm" id="ve-outcome-code" required
                   placeholder="@Localizer["OutcomeCodePlaceholder"]" />
            <div class="form-text">@Localizer["OutcomeCodeHint"]</div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="ve-feedback">@Localizer["DoctorFeedback"]</label>
            <textarea class="form-control form-control-sm" id="ve-feedback" rows="3"></textarea>
        </div>

        @* samples / materials given *@
        <div class="mb-2 d-flex justify-content-between align-items-center">
            <label class="form-label mb-0">@Localizer["Samples"]</label>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="ve-add-sample">
                <i class="bx bx-plus"></i> @Localizer["AddSample"]
            </button>
        </div>
        <div id="ve-samples" class="mb-3"></div>

        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="ve-follow-up" />
            <label class="form-check-label" for="ve-follow-up">@Localizer["FollowUpRequired"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label" for="ve-follow-up-notes">@Localizer["FollowUpNotes"]</label>
            <textarea class="form-control form-control-sm" id="ve-follow-up-notes" rows="2"></textarea>
        </div>

        @* amendment reason (shown only when the report is already finalised) *@
        <div class="mb-3 d-none" id="ve-amend-block">
            <label class="form-label" for="ve-amend-reason">@Localizer["AmendReason"]</label>
            <input type="text" class="form-control form-control-sm" id="ve-amend-reason" />
            <div class="form-text">@Localizer["AmendHint"]</div>
        </div>

        <div id="ve-report-status" class="small text-muted mb-2"></div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success" id="ve-submit-report" disabled="@(!Model.CanRecord)">
                <i class="bx bx-check"></i> @Localizer["Submit"]
            </button>
            <button type="button" class="btn btn-outline-warning d-none" id="ve-amend-report" disabled="@(!Model.CanAmend)">
                <i class="bx bx-edit"></i> @Localizer["Amend"]
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.VisitExecutionL10n = {
            markCompleted: @Json.Serialize(Localizer["MarkCompleted"].Value),
            markMissed: @Json.Serialize(Localizer["MarkMissed"].Value),
            markRescheduled: @Json.Serialize(Localizer["MarkRescheduled"].Value),
            report: @Json.Serialize(Localizer["Report"].Value),
            none: @Json.Serialize(Localizer["StateNone"].Value),
            draft: @Json.Serialize(Localizer["StateDraft"].Value),
            submitted: @Json.Serialize(Localizer["StateSubmitted"].Value),
            amended: @Json.Serialize(Localizer["StateAmended"].Value),
            outcomeRecorded: @Json.Serialize(Localizer["OutcomeRecorded"].Value),
            reportSubmitted: @Json.Serialize(Localizer["ReportSubmitted"].Value),
            reportAmended: @Json.Serialize(Localizer["ReportAmended"].Value),
            actionFailed: @Json.Serialize(Localizer["ActionFailed"].Value),
            reasonPrompt: @Json.Serialize(Localizer["ReasonPrompt"].Value),
            reschedulePrompt: @Json.Serialize(Localizer["ReschedulePrompt"].Value),
            noVisits: @Json.Serialize(Localizer["NoVisits"].Value),
            qty: @Json.Serialize(Localizer["Quantity"].Value),
            itemType: @Json.Serialize(Localizer["ItemType"].Value),
            remove: @Json.Serialize(Localizer["Remove"].Value),
            // WP-E2E-FIX-1
            noPlannedContent: @Json.Serialize(Localizer["NoPlannedContent"].Value),
            stageFallback: @Json.Serialize(Localizer["StageFallback"].Value),
            plannedStageSuffix: @Json.Serialize(Localizer["PlannedStageSuffix"].Value),
            stageNotPresented: @Json.Serialize(Localizer["StageNotPresented"].Value),
            stageMatchesPlan: @Json.Serialize(Localizer["StageMatchesPlan"].Value),
            stageDiffersFromPlan: @Json.Serialize(Localizer["StageDiffersFromPlan"].Value),
            notYetDue: @Json.Serialize(Localizer["NotYetDueHint"].Value),
            confirmCompleted: @Json.Serialize(Localizer["ConfirmCompleted"].Value),
            confirmCompletedButton: @Json.Serialize(Localizer["ConfirmCompletedButton"].Value),
            outcomes: {
                completed: @Json.Serialize(Localizer["OutcomeCompleted"].Value),
                missed: @Json.Serialize(Localizer["OutcomeMissed"].Value),
                rescheduled: @Json.Serialize(Localizer["OutcomeRescheduled"].Value)
            },
            // machine refusal code → message (unknown codes fall back to the server's text)
            errors: {
                visit_report_outcome_code_required: @Json.Serialize(Localizer["ErrOutcomeCodeRequired"].Value),
                visit_not_yet_due: @Json.Serialize(Localizer["ErrNotYetDue"].Value),
                visit_report_planned_visit_required: @Json.Serialize(Localizer["ErrPlannedVisitRequired"].Value),
                visit_report_planned_visit_not_found: @Json.Serialize(Localizer["ErrPlannedVisitNotFound"].Value),
                visit_report_outcome_required: @Json.Serialize(Localizer["ErrOutcomeRequired"].Value),
                visit_report_reason_code_required: @Json.Serialize(Localizer["ErrReasonCodeRequired"].Value),
                visit_report_reschedule_date_invalid: @Json.Serialize(Localizer["ErrRescheduleDateInvalid"].Value),
                visit_report_resource_required: @Json.Serialize(Localizer["ErrResourceRequired"].Value),
                visit_report_sample_invalid: @Json.Serialize(Localizer["ErrSampleInvalid"].Value),
                visit_report_content_actuals_invalid: @Json.Serialize(Localizer["ErrContentActualsInvalid"].Value),
                visit_report_free_text_too_long: @Json.Serialize(Localizer["ErrFreeTextTooLong"].Value),
                visit_report_not_found: @Json.Serialize(Localizer["ErrReportNotFound"].Value),
                visit_report_already_exists: @Json.Serialize(Localizer["ErrReportAlreadyExists"].Value),
                visit_report_not_completed: @Json.Serialize(Localizer["ErrNotCompleted"].Value),
                visit_report_edit_window_closed: @Json.Serialize(Localizer["ErrEditWindowClosed"].Value),
                visit_report_not_finalised: @Json.Serialize(Localizer["ErrNotFinalised"].Value),
                visit_report_amendment_reason_required: @Json.Serialize(Localizer["ErrAmendmentReasonRequired"].Value),
                visit_report_invalid_transition: @Json.Serialize(Localizer["ErrInvalidTransition"].Value),
                visit_report_concurrency_conflict: @Json.Serialize(Localizer["ErrConcurrencyConflict"].Value),
                unsupported_vocabulary_value: @Json.Serialize(Localizer["ErrUnsupportedValue"].Value)
            }
        };
    </script>
    <script src="~/assets/js/CRM/VisitExecution/visit-execution.js" asp-append-version="true"></script>
}
