@using Diten.Web.Views.CRM.Claims
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ClaimsIndex> Localizer
@{
    ViewData["Title"] = Localizer["TabCoverage"].Value;
    ViewData["ClaimsTab"] = "coverage";
    Layout = "_LayoutTenantShell";
    var canManage = ViewData["CanManageClaims"] is true;
}

@* WP-CL-FE-2 — claim × country coverage matrix (mockup scenario 2). The controller already refused the page with a plain
   403 without crm.claim.read (UAS-001). Columns follow COUNTRY_CODES (lookups/countries, ICU display names); cells come
   from api/v2/claims/coverage; closing / reopening a cell goes through the country-closures proxy (crm.claim.manage). *@
<div class="claims-v2-scope claims-coverage-scope">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-style1 mb-1 small">
                    <li class="breadcrumb-item text-muted">@Localizer["BreadcrumbCrm"]</li>
                    <li class="breadcrumb-item"><a href="/CRM/Claims">@Localizer["ClaimsTitle"]</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Localizer["TabCoverage"]</li>
                </ol>
            </nav>
            <h5 class="mb-0">@Localizer["ClaimsTitle"]</h5>
            <p class="mb-0 text-muted">@Localizer["CoverageDescription"]</p>
        </div>
        @if (canManage)
        {
            <div class="d-flex gap-2">
                <a href="/CRM/Claims/Create?kind=local" class="btn btn-label-primary"><i class="bx bx-map-pin me-1"></i>@Localizer["NewLocalClaim"]</a>
                <a href="/CRM/Claims/Create?kind=core" class="btn btn-primary"><i class="bx bx-globe me-1"></i>@Localizer["NewCoreClaim"]</a>
            </div>
        }
    </div>

    <partial name="~/Views/CRM/Claims/_ClaimsTabs.cshtml" />

    @if (!canManage)
    {
        <div class="alert alert-info d-flex align-items-center gap-2 py-2" role="status">
            <i class="bx bx-lock-alt"></i><span>@Localizer["ReadOnlyNote"]</span>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center gap-2" id="coverageFilters">
                <input type="search" id="covSearch" class="form-control form-control-sm cov-filter-search" placeholder="@Localizer["SearchPlaceholder"]" aria-label="@Localizer["Search"]" />
                <select id="covProduct" class="form-select form-select-sm cov-filter" aria-label="@Localizer["FilterProduct"]"></select>
                <select id="covKind" class="form-select form-select-sm cov-filter" aria-label="@Localizer["FilterKind"]"></select>
                <select id="covStatus" class="form-select form-select-sm cov-filter" aria-label="@Localizer["FilterStatus"]"></select>
                <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="covClear">@Localizer["ClearFilters"]</button>
            </div>
        </div>
    </div>

    <div id="coverageError" class="alert alert-danger d-none" role="alert"></div>

    <div id="coverageEmpty" class="card d-none">
        <div class="card-body text-center py-5">
            <i class="bx bx-grid-alt text-primary mb-3 claim-empty-icon" aria-hidden="true"></i>
            <h5 class="mb-2">@Localizer["CoverageEmptyTitle"]</h5>
            <p class="text-muted mb-4 mx-auto claim-empty-text">@Localizer["CoverageEmptyText"]</p>
            @if (canManage)
            {
                <a href="/CRM/Claims/Create?kind=core" class="btn btn-primary"><i class="bx bx-globe me-1"></i>@Localizer["NewCoreClaim"]</a>
            }
        </div>
    </div>

    <div id="coverageNoMatch" class="card d-none">
        <div class="card-body text-center py-4">
            <h6 class="mb-1">@Localizer["NoMatchTitle"]</h6>
            <p class="text-muted mb-3">@Localizer["NoMatchText"]</p>
            <button type="button" class="btn btn-sm btn-label-primary" id="covClearEmpty">@Localizer["ClearFilters"]</button>
        </div>
    </div>

    <div class="card" id="coverageCard">
        <div id="coverageLoading" class="p-4 text-muted">@Localizer["Loading"]</div>
        <div class="cov-matrix-wrap" id="coverageWrap" tabindex="0" aria-label="@Localizer["TabCoverage"]">
            <table class="table cov-matrix mb-0 d-none" id="coverageTable">
                <thead id="coverageHead"></thead>
                <tbody id="coverageBody"></tbody>
            </table>
        </div>
        <div class="card-footer border-top d-flex flex-wrap align-items-center gap-2 small" id="coverageLegend">
            <span class="text-muted me-1">@Localizer["LegendTitle"]:</span>
        </div>
    </div>

    @* Mark a cell as not to be opened — a single-choice reason (select2, required; tenant BRD set). *@
    <div class="modal fade" id="coverageCloseModal" tabindex="-1" aria-labelledby="coverageCloseTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="coverageCloseTitle">-</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Cancel"]"></button>
                </div>
                <div class="modal-body">
                    <div id="coverageCloseAlert" class="alert alert-danger d-none py-2" role="alert"></div>
                    <label for="coverageCloseReason" class="form-label fw-medium">@Localizer["CloseReasonLabel"] <span class="text-danger">*</span></label>
                    <select id="coverageCloseReason" class="form-select" data-placeholder="@Localizer["CloseReasonLabel"]"></select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="coverageCloseConfirm">@Localizer["CloseConfirm"]</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="coverageReopenModal" tabindex="-1" aria-labelledby="coverageReopenTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="coverageReopenTitle">-</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Cancel"]"></button>
                </div>
                <div class="modal-body">
                    <div id="coverageReopenAlert" class="alert alert-danger d-none py-2" role="alert"></div>
                    <label for="coverageReopenNote" class="form-label fw-medium">@Localizer["ReopenNoteLabel"]</label>
                    <textarea id="coverageReopenNote" class="form-control" rows="3" maxlength="500"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="coverageReopenConfirm">@Localizer["ActionReopen"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/css/claims-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/claims-coverage.css" asp-append-version="true" />
}

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/Claims/_IndexL10n.cshtml" />
    <script id="claim-page-flags" type="application/json">{"canManage":@(canManage ? "true" : "false")}</script>
    <script src="~/assets/js/CRM/Claims/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/Claims/coverage.js" asp-append-version="true"></script>
}
