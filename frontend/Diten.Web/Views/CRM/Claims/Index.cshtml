@using Diten.Web.Views.CRM.Claims
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ClaimsIndex> Localizer
@{
    ViewData["Title"] = Localizer["ClaimsTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = ViewData["CanManageClaims"] is true;
}

@* WP-CL-FE-1 — claims v2 list (mockup scenario 1 / 12 / 13). The controller already refused the page with a plain 403
   when crm.claim.read is missing (UAS-001: no skeleton, no redirect). Create / Edit stay the existing route-based pages
   until WP-CL-FE-3 rewrites them; there is NO approve action — approval runs only through the MOD-0023 round. *@
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-style1 mb-1 small">
                <li class="breadcrumb-item text-muted">@Localizer["BreadcrumbCrm"]</li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer["ClaimsTitle"]</li>
            </ol>
        </nav>
        <h5 class="mb-0">@Localizer["ClaimsTitle"]</h5>
        <p class="mb-0 text-muted">@Localizer["ListDescription"]</p>
        <small class="text-muted"><i class="bx bx-info-circle me-1"></i>@Localizer["ApprovalViaWorkflowNote"]</small>
    </div>
    @if (canManage)
    {
        <div class="d-flex gap-2" id="claimCreateActions">
            <a href="/CRM/Claims/Create?kind=local" class="btn btn-label-primary" id="btnNewLocalClaim">
                <i class="bx bx-map-pin me-1"></i>@Localizer["NewLocalClaim"]
            </a>
            <a href="/CRM/Claims/Create?kind=core" class="btn btn-primary" id="btnNewCoreClaim">
                <i class="bx bx-globe me-1"></i>@Localizer["NewCoreClaim"]
            </a>
        </div>
    }
</div>

@{ ViewData["ClaimsTab"] = "list"; }
<partial name="~/Views/CRM/Claims/_ClaimsTabs.cshtml" />

@if (!canManage)
{
    <div class="alert alert-info d-flex align-items-center gap-2 py-2" role="status" id="claimReadOnlyNote">
        <i class="bx bx-lock-alt"></i><span>@Localizer["ReadOnlyNote"]</span>
    </div>
}

@* Empty library (scenario 12) — shown instead of the table when the tenant has no claim at all. *@
<div id="claimEmptyLibrary" class="card d-none">
    <div class="card-body text-center py-5">
        <i class="bx bx-book-open text-primary mb-3 claim-empty-icon" aria-hidden="true"></i>
        <h5 class="mb-2">@Localizer["EmptyLibraryTitle"]</h5>
        <p class="text-muted mb-4 mx-auto claim-empty-text">@Localizer["EmptyLibraryText"]</p>
        @if (canManage)
        {
            <a href="/CRM/Claims/Create?kind=core" class="btn btn-primary"><i class="bx bx-globe me-1"></i>@Localizer["NewCoreClaim"]</a>
        }
    </div>
</div>

@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/CRM/Claims/_Filter.cshtml" />
<partial name="~/Views/CRM/Claims/_DataTable.cshtml" />

@* Quick view — the row click / "view" action opens it: the row's own data plus its country versions (one read). *@
<div class="offcanvas offcanvas-end claim-quick-view claims-v2-scope" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="claimPreviewTitle">
    <div class="offcanvas-header p-4">
        <div class="min-w-0">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span id="claimPreviewKind" class="badge rounded-pill bg-label-primary">-</span>
                <small id="claimPreviewCode" class="text-muted text-truncate">-</small>
            </div>
            <h5 id="claimPreviewTitle" class="offcanvas-title mb-0">-</h5>
            <small id="claimPreviewSubtitle" class="text-muted d-block">-</small>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@Localizer["QvClose"]"></button>
    </div>
    <div class="offcanvas-body flex-grow-1 p-4 border-top">
        <dl class="row mb-3 small">
            <dt class="col-5 text-muted">@Localizer["ColProduct"]</dt><dd class="col-7" id="pvProduct">-</dd>
            <dt class="col-5 text-muted">@Localizer["Status"]</dt><dd class="col-7" id="pvStatus">-</dd>
            <dt class="col-5 text-muted">@Localizer["QvResponsibleTeam"]</dt><dd class="col-7" id="pvTeam">-</dd>
            <dt class="col-12 text-muted mt-2" id="pvTextLabel">@Localizer["QvCoreText"]</dt><dd class="col-12" id="pvText">-</dd>
            <dt class="col-12 text-muted mt-2">@Localizer["Qualifiers"]</dt><dd class="col-12" id="pvQualifiers">-</dd>
        </dl>
        <div class="row g-2 mb-4 text-center">
            <div class="col-4"><div class="border rounded p-2"><div class="fw-semibold" id="pvEvidence">-</div><small class="text-muted">@Localizer["ColEvidence"]</small></div></div>
            <div class="col-4"><div class="border rounded p-2"><div class="fw-semibold" id="pvUsage">-</div><small class="text-muted">@Localizer["ColUsage"]</small></div></div>
            <div class="col-4"><div class="border rounded p-2"><div class="fw-semibold" id="pvAudience">-</div><small class="text-muted">@Localizer["QvAudienceCount"]</small></div></div>
        </div>
        <h6 class="mb-2">@Localizer["QvCountryVersions"]</h6>
        <div id="pvVersions" class="d-flex flex-column gap-2"></div>
    </div>
    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@Localizer["QvClose"]</button>
        <a href="#" id="claimPreviewOpen" class="btn btn-primary d-none">@Localizer["QvOpenDetails"]</a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/css/claims-index.css" asp-append-version="true" />
}

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/Claims/_IndexL10n.cshtml" />
    <script id="claim-page-flags" type="application/json">{"canManage":@(canManage ? "true" : "false")}</script>
    <script src="~/assets/js/CRM/Claims/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/Claims/index.js" asp-append-version="true"></script>
}
