@using Diten.Web.Views.CRM.Claims
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ClaimsForm> Localizer
@* WP-CL-FE-4 — the shared evidence modals (add: document -> reference + phrase marking; remove: reason). Used by the core
   claim form AND the country version form; driven by claim-evidence.js. Strings stay in the ClaimsForm resx family.
   Place inside a `.claims-form-scope` element (claims-form.css). *@
    @* Evidence modal (mockup scenario 5): step 1 choose a document, step 2 reference + mapping. *@
    <div class="modal fade" id="claimEvidenceModal" tabindex="-1" aria-labelledby="claimEvidenceModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="claimEvidenceModalTitle">@Localizer["AddEvidence"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["CancelAction"]"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-3 mb-3 small fw-medium">
                        <span class="ev-step active" data-step-label="1">@Localizer["EvStep1"]</span>
                        <span class="ev-step" data-step-label="2">@Localizer["EvStep2"]</span>
                    </div>
                    <div id="evAlert" class="alert alert-danger d-none py-2" role="alert"></div>

                    <div data-step="1">
                        <div class="row g-2 mb-3">
                            <div class="col-12 col-md-8">
                                <input type="search" id="evSearch" class="form-control" placeholder="@Localizer["EvSearchPlaceholder"]" />
                            </div>
                            <div class="col-12 col-md-4">
                                <select id="evKind" class="form-select">
                                    <option value="controlled">@Localizer["EvKindControlled"]</option>
                                    <option value="external">@Localizer["EvKindExternal"]</option>
                                </select>
                            </div>
                        </div>
                        <div id="evDocList" class="list-group ev-doc-list mb-3" role="listbox" aria-label="@Localizer["EvStep1"]"></div>
                        <a href="/DocumentManagementControlledDocuments/Create" target="_blank" rel="noopener" class="small">
                            <i class="bx bx-upload me-1"></i>@Localizer["EvUploadNew"]
                        </a>
                    </div>

                    <div data-step="2" class="d-none">
                        <div class="border rounded p-3 mb-3 ev-doc-summary">
                            <div class="fw-medium" id="evDocTitle">-</div>
                            <small class="text-muted d-block" id="evDocMeta">-</small>
                            <small class="text-primary fw-medium d-block mt-1" id="evDocPin">-</small>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label for="evType" class="form-label fw-medium">@Localizer["EvTypeLabel"] <span class="text-danger">*</span></label>
                                <select id="evType" class="form-select"></select>
                            </div>
                            <div class="col-4 col-md-2">
                                <label for="evSection" class="form-label fw-medium">@Localizer["EvSectionLabel"]</label>
                                <input type="text" id="evSection" class="form-control" maxlength="120" />
                            </div>
                            <div class="col-4 col-md-2">
                                <label for="evPage" class="form-label fw-medium">@Localizer["EvPageLabel"]</label>
                                <input type="text" id="evPage" class="form-control" maxlength="20" />
                            </div>
                            <div class="col-4 col-md-2">
                                <label for="evTable" class="form-label fw-medium">@Localizer["EvTableLabel"]</label>
                                <input type="text" id="evTable" class="form-control" maxlength="60" />
                            </div>
                            <div class="col-12">
                                <label for="evQuote" class="form-label fw-medium">@Localizer["EvQuoteLabel"] <span class="text-danger">*</span></label>
                                <textarea id="evQuote" class="form-control" rows="3" maxlength="1000"></textarea>
                            </div>
                            <div class="col-12">
                                <label for="evSpanSource" class="form-label fw-medium">@Localizer["EvSupportsLabel"] <span class="text-danger">*</span></label>
                                <div class="form-text mt-0 mb-2" id="evSpanHint">@Localizer["EvSupportsHint"]</div>
                                @* A readonly textarea: mouse AND keyboard (Shift + arrows) selection both work, and
                                   selectionStart / selectionEnd are the exact offsets into the claim text. *@
                                <textarea id="evSpanSource" class="form-control ev-span-source" rows="3" readonly aria-describedby="evSpanHint"></textarea>
                                <button type="button" class="btn btn-sm btn-label-primary mt-2" id="evAddSelection"><i class="bx bx-highlight me-1"></i>@Localizer["EvAddSelection"]</button>
                                <div id="evSpans" class="d-flex flex-wrap gap-2 mt-2" aria-live="polite"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <div>
                        <button type="button" class="btn btn-label-secondary d-none" id="evBack">@Localizer["EvBack"]</button>
                        <a href="#" target="_blank" rel="noopener" class="btn btn-label-secondary d-none" id="evPreview"><i class="bx bx-show me-1"></i>@Localizer["EvidencePreview"]</a>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@Localizer["CancelAction"]</button>
                        <button type="button" class="btn btn-primary" id="evNext" disabled>@Localizer["EvNext"]</button>
                        <button type="button" class="btn btn-primary d-none" id="evAdd">@Localizer["EvAdd"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Remove evidence (a reason is mandatory — MOD-0031 keeps the record with it). *@
    <div class="modal fade" id="claimEvidenceRemoveModal" tabindex="-1" aria-labelledby="claimEvidenceRemoveTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="claimEvidenceRemoveTitle">@Localizer["RemoveEvidenceTitle"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["CancelAction"]"></button>
                </div>
                <div class="modal-body">
                    <label for="evRemoveReason" class="form-label fw-medium">@Localizer["RemoveEvidenceReason"] <span class="text-danger">*</span></label>
                    <textarea id="evRemoveReason" class="form-control" rows="3" maxlength="500"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@Localizer["CancelAction"]</button>
                    <button type="button" class="btn btn-danger" id="evRemoveConfirm">@Localizer["RemoveEvidenceConfirm"]</button>
                </div>
            </div>
        </div>
    </div>
