@using Diten.Web.Views.CRM.LegalProfiles
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalProfilesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["LegalProfilesTitle"].Value;
    Layout = "_LayoutTenantShell";
    // UAS-001 — reached only with crm.country-legal-profile.read (the controller answers 403 otherwise). The action flags
    // say what this user may TRY; CRM's per-record flags (canEdit / canSubmit / canDecide) and its refusals decide.
    var id = ViewData["Id"]?.ToString();
}

@* WP-KP-5a-UI — /CRM/LegalProfiles/{id}: the MOD-0023 Regulatory task's deep link. details.js fills every value with
   textContent (legal texts are plain text, never HTML). The three section cards mirror _Form.cshtml one to one; the
   lifecycle cards (status line, decision panel, versions, decision record) are plain cards around them. *@
<div class="legal-profiles-details regulatory-details" id="regulatoryDetailsRoot"
     data-kind="country-legal-profile" data-endpoint="/CRM/LegalProfiles/api" data-resource="legal-profiles"
     data-details-url="/CRM/LegalProfiles/" data-edit-url="/CRM/LegalProfiles/Edit/" data-list-url="/CRM/LegalProfiles"
     data-id="@id" data-has-product="false"
     data-can-manage="@(ViewData["CanManage"] is true ? "true" : "false")"
     data-can-submit="@(ViewData["CanSubmit"] is true ? "true" : "false")">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h5 class="mb-0" id="rtTitle">@Localizer["LegalProfilesTitle"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/CRM/LegalProfiles">@Localizer["LegalProfilesTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary" id="rtCrumb"></li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2" id="rtActions"></div>
    </div>

    <div id="rtAlert" class="alert alert-danger d-none" role="alert"></div>

    <div class="card mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center gap-2" id="rtStatusLine" aria-label="@SharedLocalizer["Status"]"></div>
            <div class="small text-muted mt-2" id="rtSubmitted"></div>
        </div>
    </div>

    @* The decision panel: drawn only while CRM says this user holds the open Regulatory task (canDecide). *@
    <div class="card border-warning mb-4 d-none" id="rtDecisionPanel">
        <div class="card-body p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-3">@Localizer["DecisionPanelTitle"]</h6>
            <label for="rtDecisionComment" class="form-label fw-medium">@Localizer["DecisionComment"]</label>
            <textarea id="rtDecisionComment" class="form-control mb-1" rows="3" dir="auto"></textarea>
            <div class="form-text mb-3">@Localizer["DecisionCommentHint"]</div>
            <div class="invalid-feedback d-block mb-2" id="rtDecisionError"></div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-success" data-decision="approve"><i class="bx bx-check me-1"></i>@Localizer["Approve"]</button>
                <button type="button" class="btn btn-label-danger" data-decision="reject"><i class="bx bx-x me-1"></i>@Localizer["Reject"]</button>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionIdentity"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6"><div class="backbone-preview-label">@Localizer["Country"]</div><div class="backbone-preview-value" data-value="countryCode">-</div></div>
                        <div class="col-12 col-md-6"><div class="backbone-preview-label">@Localizer["Language"]</div><div class="backbone-preview-value" data-value="languageCode">-</div></div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionLegal"]</h6>
                    <div class="backbone-preview-label">@Localizer["LegalFooterText"]</div>
                    <div class="regulatory-preview mb-4" dir="auto" data-preview="legalFooterText"></div>
                    <div class="backbone-preview-label">@Localizer["MarketingAuthorizationHolder"]</div>
                    <div class="regulatory-preview mb-4" dir="auto" data-preview="marketingAuthorizationHolder"></div>
                    <div class="backbone-preview-label">@Localizer["AdverseEventReportingText"]</div>
                    <div class="regulatory-preview mb-4" dir="auto" data-preview="adverseEventReportingText"></div>
                    <div class="backbone-preview-label">@Localizer["PromotionalNotice"]</div>
                    <div class="regulatory-preview" dir="auto" data-preview="promotionalNotice"></div>
                </div>
            </section>

            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionPageApproval"]</h6>
                    <div class="backbone-preview-label">@Localizer["PageApprovalCodeFormat"]</div>
                    <div class="backbone-preview-value font-monospace" dir="ltr" data-value="pageApprovalCodeFormat">-</div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-3">@Localizer["VersionHistory"]</h6>
                    <ul class="list-unstyled mb-0" id="rtVersions"></ul>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-3">@Localizer["DecisionRecord"]</h6>
                    <ul class="list-unstyled mb-0" id="rtDecisions"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/css/regulatory-texts.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="~/Views/CRM/LegalProfiles/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/LegalProfiles/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/RegulatoryTexts/details.js" asp-append-version="true"></script>
}
