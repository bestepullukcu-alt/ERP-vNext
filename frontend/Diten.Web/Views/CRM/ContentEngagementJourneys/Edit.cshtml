@model Diten.Web.Models.CRM.ContentEngagementJourneyEditViewModel
@using Diten.Web.Views.CRM.ContentEngagementJourneys
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ContentEngagementJourneysIndex> Localizer
@{
    ViewData["Title"] = Localizer["EditJourney"].Value;
    Layout = "_LayoutTenantShell";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@Localizer["EditJourney"]</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/CRM/ContentEngagementJourneys">@Localizer["ContentEngagementJourneysTitle"]</a></li>
                <li class="breadcrumb-item"><a href="/CRM/ContentEngagementJourneys/Details/@Model.JourneyId">@Model.JourneyCode</a></li>
                <li class="breadcrumb-item active text-primary">@Localizer["EditJourney"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/CRM/ContentEngagementJourneys/Details/@Model.JourneyId" class="btn btn-label-secondary">@Localizer["Cancel"]</a>
        <button type="submit" form="contentEngagementJourneyForm" class="btn btn-primary">@Localizer["Save"]</button>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.JourneyId" method="post" id="contentEngagementJourneyForm" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <partial name="~/Views/CRM/ContentEngagementJourneys/_Form.cshtml" model="Model" />
</form>

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
}

@section Scripts {
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/CRM/ContentEngagementJourneys/form.js" asp-append-version="true"></script>
}
