@model Diten.Web.Models.CRM.ContentEngagementJourneyPageViewModel
@using Diten.Web.Views.CRM.ContentEngagementJourneys
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ContentEngagementJourneysIndex> Localizer
@{
    ViewData["Title"] = Localizer["JourneyDetail"].Value;
    Layout = "_LayoutTenantShell";
    var j = Model.Journey;
    string Show(object? value) =>
        value is null || (value is string s && string.IsNullOrWhiteSpace(s)) ? "-" : value.ToString()!;
    string ResolutionBadge(string status) => status switch
    {
        "unresolved" => "bg-label-danger",
        "resolved-latest" => "bg-label-info",
        _ => "bg-label-success"
    };
}

<div id="contentEngagementJourneyDetailsPage" class="content-engagement-journey-details"
     data-journey-id="@j.JourneyId" data-archived="@j.IsArchived.ToString().ToLowerInvariant()"
     data-published="@j.IsStageSetFrozen.ToString().ToLowerInvariant()">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@j.JourneyName</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/CRM/ContentEngagementJourneys">@Localizer["ContentEngagementJourneysTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@j.JourneyCode @@ @j.JourneyVersion</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="/CRM/ContentEngagementJourneys" class="btn btn-label-secondary">@Localizer["BackToList"]</a>
            @if (Model.CanManage && !j.IsArchived && !j.IsStageSetFrozen)
            {
                <a href="/CRM/ContentEngagementJourneys/Edit/@j.JourneyId" class="btn btn-primary">@Localizer["EditJourney"]</a>
            }
            @if (Model.CanPublish && !j.IsArchived && !j.IsStageSetFrozen)
            {
                <button type="button" id="publishJourney" class="btn btn-label-success">@Localizer["Publish"]</button>
            }
            @if (Model.CanManage && j.IsStageSetFrozen && !j.IsArchived)
            {
                <button type="button" id="newVersionJourney" class="btn btn-label-primary">@Localizer["NewVersion"]</button>
            }
            @if (Model.CanManage && !j.IsArchived)
            {
                <button type="button" id="archiveJourney" class="btn btn-label-warning" data-name="@j.JourneyName">@Localizer["ArchiveJourney"]</button>
            }
        </div>
    </div>

    @if (j.IsArchived)
    {
        <div class="alert alert-warning"><i class="bx bx-archive me-1"></i>@Localizer["ArchivedJourneyReadOnly"]</div>
    }
    else if (j.IsStageSetFrozen)
    {
        <div class="alert alert-info"><i class="bx bx-lock-alt me-1"></i>@Localizer["FrozenStagesHelp"]</div>
    }

    @if (j.HasUnresolvedStagePath)
    {
        <div class="alert alert-danger"><i class="bx bx-error-circle me-1"></i>@Localizer["UnresolvedPathHelp"]</div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IdentitySection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-purchase-tag-alt"></i><div>
                            <div class="backbone-preview-label">@Localizer["JourneyCode"]</div>
                            <div class="backbone-preview-value mt-1">@j.JourneyCode</div></div></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-git-branch"></i><div>
                            <div class="backbone-preview-label">@Localizer["JourneyVersion"]</div>
                            <div class="backbone-preview-value mt-1">@j.JourneyVersion</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-target-lock"></i><div>
                            <div class="backbone-preview-label">@Localizer["Objective"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@Show(j.Objective)</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-note"></i><div>
                            <div class="backbone-preview-label">@Localizer["Description"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@Show(j.Description)</div></div></div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ClassificationSection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-category"></i><div>
                            <div class="backbone-preview-label">@Localizer["SubjectId"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@Show(j.SubjectId)</div></div></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-sitemap"></i><div>
                            <div class="backbone-preview-label">@Localizer["TopicId"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@Show(j.TopicId)</div></div></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-user-detail"></i><div>
                            <div class="backbone-preview-label">@Localizer["AudienceProfileId"]</div>
                            <div class="backbone-preview-value mt-1 text-break">@Show(j.AudienceProfileId)</div></div></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field"><i class="bx bx-globe"></i><div>
                            <div class="backbone-preview-label">@Localizer["LanguageCode"]</div>
                            <div class="backbone-preview-value mt-1">@Show(j.LanguageCode)</div></div></div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["StagesSection"]</h6>
                <small class="text-muted d-block mb-3">@Localizer["DeclaredNotEvaluatedHelp"]</small>
                @if (j.Stages.Count == 0)
                {
                    <div class="text-muted">@Localizer["NoStages"]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead><tr>
                                <th>@Localizer["StageOrder"]</th>
                                <th>@Localizer["StageCode"]</th>
                                <th>@Localizer["StageName"]</th>
                                <th>@Localizer["RecommendedKnowledgePathId"]</th>
                                <th>@Localizer["IsRequired"]</th>
                                <th>@Localizer["Repeatable"]</th>
                                <th>@Localizer["AdvancementRule"]</th>
                                <th>@Localizer["PathResolution"]</th>
                                <th>@Localizer["BranchConditions"]</th>
                                <th>@Localizer["Status"]</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var s in j.Stages.OrderBy(x => x.IsArchived).ThenBy(x => x.StageOrder))
                                {
                                    <tr class="@(s.IsArchived ? "text-muted" : "")">
                                        <td>@s.StageOrder</td>
                                        <td>@s.StageCode</td>
                                        <td>
                                            @s.StageName
                                            @if (s.IsCrossSubjectStage) { <span class="badge bg-label-secondary ms-1">@Localizer["CrossSubject"]</span> }
                                            @if (s.IsCrossLanguageStage) { <span class="badge bg-label-secondary ms-1">@Localizer["CrossLanguage"]</span> }
                                            @if (s.PathUsageCountInJourney > 1) { <span class="badge bg-label-secondary ms-1">@Localizer["Repeated"]</span> }
                                        </td>
                                        <td>
                                            <div>@Show(s.ResolvedPathName ?? s.PathCode)</div>
                                            <small class="text-muted">@s.PathCode @(s.ResolvedPathVersion is null ? "" : "@ " + s.ResolvedPathVersion) @(s.ResolvedPathStepCount is null ? "" : $"· {s.ResolvedPathStepCount} {Localizer["StepCount"].Value}")</small>
                                        </td>
                                        <td>@(s.IsRequired ? Localizer["Yes"] : Localizer["No"])</td>
                                        <td>@(s.Repeatable ? Localizer["Yes"] : Localizer["No"])</td>
                                        <td>@Show(s.AdvancementRule)</td>
                                        <td><span class="badge @ResolutionBadge(s.PathResolutionStatus)">@s.PathResolutionStatus</span></td>
                                        <td>@(s.BranchConditions.Count > 0 ? s.BranchConditions.Count.ToString() : "—")</td>
                                        <td>@(s.IsArchived ? Localizer["Archived"] : Localizer["Active"])</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>

        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SchedulingSection"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-check-shield"></i><div>
                            <div class="backbone-preview-label">@Localizer["JourneyStatus"]</div>
                            <div class="mt-1"><span class="badge bg-label-primary">@j.JourneyStatus</span></div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-data"></i><div>
                            <div class="backbone-preview-label">@Localizer["Source"]</div>
                            <div class="backbone-preview-value mt-1">@Show(j.Source)</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-calendar-event"></i><div>
                            <div class="backbone-preview-label">@Localizer["EffectiveFrom"]</div>
                            <div class="backbone-preview-value mt-1">@j.EffectiveFrom.ToString("yyyy-MM-dd")</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-calendar-x"></i><div>
                            <div class="backbone-preview-label">@Localizer["EffectiveTo"]</div>
                            <div class="backbone-preview-value mt-1">@(j.EffectiveTo?.ToString("yyyy-MM-dd") ?? "-")</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-list-ol"></i><div>
                            <div class="backbone-preview-label">@Localizer["ActiveStageCount"]</div>
                            <div class="backbone-preview-value mt-1">@j.ActiveStageCount (@Localizer["RequiredStageCount"]: @j.RequiredStageCount)</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-repeat"></i><div>
                            <div class="backbone-preview-label">@Localizer["Repeatable"]</div>
                            <div class="backbone-preview-value mt-1">@j.RepeatableStageCount</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-time"></i><div>
                            <div class="backbone-preview-label">@Localizer["UpdatedAt"]</div>
                            <div class="backbone-preview-value mt-1">@(j.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div></div></div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field"><i class="bx bx-archive"></i><div>
                            <div class="backbone-preview-label">@Localizer["Archived"]</div>
                            <div class="mt-1">
                                @if (j.IsArchived) { <span class="badge bg-label-warning">@Localizer["Yes"]</span> }
                                else { <span class="badge bg-label-success">@Localizer["No"]</span> }
                            </div></div></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/CRM/ContentEngagementJourneys/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/ContentEngagementJourneys/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/ContentEngagementJourneys/details.js" asp-append-version="true"></script>
}
