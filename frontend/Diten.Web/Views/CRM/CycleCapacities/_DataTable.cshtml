@using Diten.Web.Views.CRM.CycleCapacities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CycleCapacitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* DATA MODE: client — index.js loads the whole (bounded) set once and DataTables pages, sorts and filters it in
   the browser; there is no serverSide paging. Declared on the <table> (data-dt-data-mode) per the golden template.
   There is no select-all checkbox and no bulk action bar here on purpose: this module has NO bulk delete and no delete
   at all (retiring a capacity is Archive), so a selection column would offer an action that does not exist.
   WP-CYC-UI-2 — the estimated-visit, average-FTE and status cells are filled LAZILY for the rows on screen only (one
   calculation read per visible row, cached), never for the whole set: the estimate reaches the working calendar. *@
<div class="card">
    @* WP-CYC-UI-FIX-1 — the shared, shaped placeholder (renders id="skeleton-loader" data-table-skeleton). It is
       visible from the first paint and hides the table beside it until dt-defaults.js REMOVES it on the first draw. *@
    <partial name="_TableSkeleton" />

    <div class="card-datatable table-responsive">
        <table id="dt-cycle-capacities" data-dt-standard="v2" data-dt-data-mode="client" class="datatables-cyclecapacities table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["ColPeriod"]</th>
                    <th>@Localizer["CalendarCountryCode"]</th>
                    <th class="text-end">@Localizer["ColEstimatedVisits"]</th>
                    <th>@Localizer["ColTypicalVisit"]</th>
                    <th class="text-end">@Localizer["ColAverageFte"]</th>
                    <th>@Localizer["ColProductLimits"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th>@Localizer["UpdatedAt"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
