@model Diten.Web.Models.CRM.CycleCapacityIndexViewModel
@using Diten.Web.Views.CRM.CycleCapacities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CycleCapacitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["CycleCapacitiesTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* ① Inline Filter partial *@
@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/CRM/CycleCapacities/_Filter.cshtml" />

@* Golden Compact: authoring happens on its own page, and the create affordance lives in the DataTable toolbar
   (the .add-new button) — exactly once. The permission gate is decided server-side and published to index.js below. *@
<div class="mb-3">
    <h5 class="mb-0">@Localizer["CycleCapacitiesTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* ② The permanent estimate notice. It is on the list as well as on the form and the detail page, because a reader who
     only ever sees this grid must still know these are planning estimates rather than quotas. *@
<div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
    <i class="bx bx-info-circle mt-1"></i>
    <div>
        <strong>@Localizer["EstimateNoticeTitle"]</strong>
        <div class="small">@Localizer["EstimateNoticeBody"]</div>
    </div>
</div>

@* ③ DataTable Card *@
@* Contract markers are rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-cycle-capacities" data-dt-standard="v2"> *@
<partial name="~/Views/CRM/CycleCapacities/_DataTable.cshtml" />

@* ④ WP-CYC-UI-FIX-1 — Quick View (golden #offcanvasDetailsPreview). Filled by index.js from the row ALREADY loaded and
   from the per-row estimate only if it was already read (no extra request); every value written as plain text. *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="capacityPreviewTitle"
     data-text-calculating="@Localizer["Calculating"].Value" data-text-not-calculable="@Localizer["StatusNotCalculable"].Value"
     data-text-legacy="@Localizer["LegacyBadge"].Value" data-text-minutes="@Localizer["UnitMinutesShort"].Value">
    <div class="offcanvas-header p-4">
        <div class="min-w-0">
            <h5 id="capacityPreviewTitle" class="offcanvas-title mb-0 text-truncate">-</h5>
            <small id="capacityPreviewSubtitle" class="text-muted d-block text-truncate">-</small>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Close"]"></button>
    </div>
    <div class="offcanvas-body flex-grow-1 p-4 border-top">
        <dl class="row mb-0 small">
            <dt class="col-5 text-muted">@Localizer["ColPeriod"]</dt><dd class="col-7" id="cvPeriod">-</dd>
            <dt class="col-5 text-muted">@Localizer["CalendarCountryCode"]</dt><dd class="col-7" id="cvCountry">-</dd>
            <dt class="col-5 text-muted">@Localizer["ColTypicalVisit"]</dt><dd class="col-7" id="cvTypicalVisit">-</dd>
            <dt class="col-5 text-muted">@Localizer["ColEstimatedVisits"]</dt><dd class="col-7" id="cvVisits">-</dd>
            <dt class="col-5 text-muted">@Localizer["ColAverageFte"]</dt><dd class="col-7" id="cvFte">-</dd>
            <dt class="col-5 text-muted">@Localizer["ColProductLimits"]</dt><dd class="col-7" id="cvLimits">-</dd>
        </dl>
    </div>
    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Close"]</button>
        <a href="#" id="capacityPreviewDetails" class="btn btn-primary">@Localizer["GoToDetails"]</a>
    </div>
</div>

<script id="cyclecapacity-page-flags" type="application/json">{"canManage": @(Model.CanManage ? "true" : "false")}</script>

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/CycleCapacities/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/CycleCapacities/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/CycleCapacities/index.js" asp-append-version="true"></script>
}
