@model Diten.Web.Models.CRM.CycleCapacityEditViewModel
@using Diten.Web.Models.CRM
@using Diten.Web.Views.CRM.CycleCapacities
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CycleCapacitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
    var action = isEdit ? "Edit" : "Create";
    // The pin is set once. On edit the period is shown, never offered — the API has no way to move it.
    var pinLocked = isEdit || (Model.CyclePeriodId is not null && Model.CyclePeriod is not null);
    // K-8: a country-scoped period NAMES the country, so the control is read-only and the server derives it again on
    // every write. On any other scope the author chooses one, because the calendar always needs a country.
    var countryLocked = Model.CalendarCountryIsDerived;
    // A closed period freezes its capacity: the WHOLE form is read-only and says why (no Save).
    var readOnly = !Model.IsEditable || Model.IsArchived;
    var limits = Model.Limits;
    var fromCyclePeriods = string.Equals(Model.ReturnTo, "cycleperiods", StringComparison.OrdinalIgnoreCase);
    var backUrl = fromCyclePeriods ? "/CRM/CyclePeriods" : "/CRM/CycleCapacities";
    var backLabel = fromCyclePeriods ? Localizer["CyclePeriodsBreadcrumb"].Value : Localizer["CycleCapacitiesTitle"].Value;
    var inv = CultureInfo.InvariantCulture;
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 row-gap-4">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@backUrl">@backLabel</a></li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="@backUrl" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        @if (!readOnly)
        {
            <button type="submit" form="cycleCapacityForm" class="btn btn-primary" id="btnSaveCapacity">
                <i class="bx bx-save me-1" aria-hidden="true"></i>@SharedLocalizer["Save"]
            </button>
        }
    </div>
</div>

<p class="text-muted small mb-3">@Localizer["FormLiveHint"]</p>

@* The estimate notice is PERMANENT (list, form, detail): a planning estimate must never read as a quota. *@
<div class="alert alert-warning d-flex align-items-start gap-2" role="note">
    <i class="bx bx-info-circle mt-1" aria-hidden="true"></i>
    <div>
        <strong>@Localizer["EstimateNoticeTitle"]</strong>
        <div class="small">@Localizer["EstimateNoticeBody"]</div>
    </div>
</div>

@if (readOnly)
{
    @* Closed period (or archived row): every input is disabled by the fieldset below, and the reason is stated. *@
    <div class="alert alert-secondary d-flex align-items-start gap-2" role="status" id="capacityReadOnlyNotice">
        <i class="bx bx-lock-alt mt-1" aria-hidden="true"></i>
        <div>
            <strong>@Localizer["ReadOnlyTitle"]</strong>
            <div class="small">@(Model.IsArchived ? Localizer["ReadOnlyArchivedBody"] : Localizer["ReadOnlyClosedBody"])</div>
        </div>
    </div>
}

@if (Model.IsLegacyModel)
{
    @* WP-CAP-MODEL — a row written before the typical-visit model. It keeps its old arithmetic until the triple is
       filled and saved; saving WITHOUT the triple keeps the old model (the CRM's behaviour). *@
    <div class="alert alert-info d-flex align-items-start gap-2" role="note" id="legacyModelBand">
        <i class="bx bx-history mt-1" aria-hidden="true"></i>
        <div>
            <strong>@Localizer["LegacyBandTitle"]</strong>
            <div class="small">@Localizer["LegacyBandBody"]</div>
            <div class="small text-muted mt-1">@Localizer["LegacyBandNumberMayChange"]</div>
        </div>
    </div>
}

<form id="cycleCapacityForm" asp-controller="CycleCapacities" asp-action="@action"
      asp-route-cycleCapacityId="@Model.CycleCapacityId" method="post" class="needs-validation" novalidate
      data-is-new="@(isEdit ? "false" : "true")" data-read-only="@(readOnly ? "true" : "false")">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CycleCapacityId" />
    <input type="hidden" asp-for="ExpectedVersion" />
    <input type="hidden" asp-for="CalendarCountryIsDerived" />
    <input type="hidden" asp-for="ReturnTo" />
    <input type="hidden" asp-for="VisitModel" />
    @* The legacy per-DAY report. A new or typical row carries 0 (the report is per visit); a legacy row keeps its stored
       value so a save that leaves the triple empty keeps the old model intact. *@
    <input type="hidden" asp-for="ReportDuration" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <fieldset class="border-0 p-0 m-0 min-w-0" disabled="@readOnly">
    <div class="row g-4">
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">

            <!-- 1 · Period and calendar -->
            <section class="card" aria-labelledby="secPeriod">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4" id="secPeriod">@Localizer["PinnedPeriodSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="CyclePeriodId" class="form-label fw-medium">
                                @Localizer["CyclePeriod"] <span class="text-danger">*</span>
                            </label>
                            @if (pinLocked)
                            {
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bx bx-lock-alt" aria-hidden="true"></i></span>
                                    <input type="text" class="form-control" readonly aria-readonly="true"
                                           value="@(Model.CyclePeriod is null ? Model.CyclePeriodId?.ToString() : $"{Model.CyclePeriod.CycleCode} · {Model.CyclePeriod.CycleName}")" />
                                </div>
                                <input type="hidden" asp-for="CyclePeriodId" />
                                <div class="form-text">@Localizer["PeriodLockedHint"]</div>
                            }
                            else
                            {
                                <select asp-for="CyclePeriodId" class="form-select" id="cyclePeriodSelect" required>
                                    <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                    @foreach (var option in Model.PeriodOptions)
                                    {
                                        <option value="@option.CyclePeriodId" data-hint="@option.Hint">@option.Label</option>
                                    }
                                </select>
                                <div class="form-text">@Localizer["PeriodPickHint"]</div>
                                @if (Model.PeriodOptions.Count == 0)
                                {
                                    <div class="form-text text-warning">@Localizer["NoPeriodsAvailable"]</div>
                                }
                            }
                            <span asp-validation-for="CyclePeriodId" class="text-danger small mt-1"></span>
                            @if (Model.CyclePeriod is { } period)
                            {
                                <div class="form-text">
                                    @Localizer["PeriodWindow"]:
                                    <span class="fw-medium">@period.StartDate.UtcDateTime.ToString("d", CultureInfo.CurrentCulture) – @period.EndDate.UtcDateTime.ToString("d", CultureInfo.CurrentCulture)</span>
                                </div>
                            }
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="CalendarCountryCode" class="form-label fw-medium">
                                @Localizer["CalendarCountryCode"] <span class="text-danger">*</span>
                            </label>
                            @if (countryLocked)
                            {
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bx bx-lock-alt" aria-hidden="true"></i></span>
                                    <input type="text" class="form-control" readonly aria-readonly="true" value="@Model.CalendarCountryCode" />
                                </div>
                                <input type="hidden" asp-for="CalendarCountryCode" />
                                <div class="form-text">@Localizer["CalendarCountryDerivedHint"]</div>
                            }
                            else
                            {
                                <select asp-for="CalendarCountryCode" class="form-select" required>
                                    <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                    @foreach (var option in Model.CountryOptions)
                                    {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </select>
                                @if (!Model.CountryReady)
                                {
                                    <div class="form-text text-warning">@Localizer["CalendarCountryNotReady"]</div>
                                }
                                else
                                {
                                    <div class="form-text">@Localizer["CalendarCountryHint"]</div>
                                }
                            }
                            <span asp-validation-for="CalendarCountryCode" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2 · Daily time -->
            <section class="card" aria-labelledby="secDaily">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-1" id="secDaily">@Localizer["DailyTimeSection"]</h6>
                    <p class="text-muted small mb-4">@Localizer["DailyTimeHint"]</p>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="DailyWorkMinutes" class="form-label fw-medium">
                                @Localizer["DailyWorkMinutes"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="DailyWorkMinutes" type="number" class="form-control js-live" inputmode="numeric"
                                   min="@limits.MinDailyWorkMinutes" max="@limits.MaxDailyWorkMinutes" required />
                            <div class="form-text" data-minutes-hint="DailyWorkMinutes">@Localizer["DailyWorkMinutesHint"]</div>
                            <span asp-validation-for="DailyWorkMinutes" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="TravelingTime" class="form-label fw-medium">
                                @Localizer["TravelingTime"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TravelingTime" type="number" class="form-control js-live" inputmode="numeric"
                                   min="0" max="@limits.MaxMinutesPerDay" required />
                            <div class="form-text">@Localizer["PerDayHint"]</div>
                            <span asp-validation-for="TravelingTime" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="QuizDuration" class="form-label fw-medium">
                                @Localizer["QuizDuration"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="QuizDuration" type="number" class="form-control js-live" inputmode="numeric"
                                   min="0" max="@limits.MaxMinutesPerDay" required />
                            <div class="form-text">@Localizer["PerDayHint"]</div>
                            <span asp-validation-for="QuizDuration" class="text-danger small mt-1"></span>
                        </div>
                        @if (Model.IsLegacyModel)
                        {
                            <div class="col-12">
                                <div class="form-text">
                                    <i class="bx bx-history" aria-hidden="true"></i>
                                    @Localizer["LegacyReportPerDay"]: <span class="fw-medium">@Model.ReportDuration</span> @Localizer["UnitMinutesShort"]
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <!-- 3 · Visit duration -->
            <section class="card" aria-labelledby="secVisit">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-1" id="secVisit">@Localizer["VisitDurationSection"]</h6>
                    <p class="text-muted small mb-4">@Localizer["VisitDurationHint"]</p>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="PromoProductTime" class="form-label fw-medium">
                                @Localizer["PromoProductTime"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="PromoProductTime" type="number" class="form-control js-live" inputmode="numeric"
                                   min="0" max="@limits.MaxMinutesPerVisit" required />
                            <div class="form-text">@Localizer["PerProductHint"]</div>
                            <span asp-validation-for="PromoProductTime" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="NonPromoProductTime" class="form-label fw-medium">
                                @Localizer["NonPromoProductTime"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NonPromoProductTime" type="number" class="form-control js-live" inputmode="numeric"
                                   min="0" max="@limits.MaxMinutesPerVisit" required />
                            <div class="form-text">@Localizer["PerProductHint"]</div>
                            <span asp-validation-for="NonPromoProductTime" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="ReportMinutesPerVisit" class="form-label fw-medium">@Localizer["ReportMinutesPerVisit"]</label>
                            <input asp-for="ReportMinutesPerVisit" type="number" class="form-control js-live js-typical" inputmode="numeric"
                                   min="0" max="@limits.MaxMinutesPerVisit" />
                            <div class="form-text">@Localizer["PerVisitHint"]</div>
                            <span asp-validation-for="ReportMinutesPerVisit" class="text-danger small mt-1"></span>
                        </div>
                    </div>

                    <div class="border rounded p-3 mt-4">
                        <div class="fw-medium mb-1">@Localizer["TypicalVisitTitle"]</div>
                        <p class="text-muted small mb-3">@Localizer["TypicalVisitHint"]</p>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="TypicalPromoCount" class="form-label fw-medium">@Localizer["TypicalPromoCount"]</label>
                                <input asp-for="TypicalPromoCount" type="number" class="form-control js-live js-typical" inputmode="numeric"
                                       min="0" max="@(Model.MaxPromoProducts ?? CycleCapacityFormLimits.MaxProductsPerVisit)" />
                                <div class="form-text">@Localizer["TypicalCountHint"]</div>
                                <span asp-validation-for="TypicalPromoCount" class="text-danger small mt-1"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="TypicalNonPromoCount" class="form-label fw-medium">@Localizer["TypicalNonPromoCount"]</label>
                                <input asp-for="TypicalNonPromoCount" type="number" class="form-control js-live js-typical" inputmode="numeric"
                                       min="0" max="@(Model.MaxNonPromoProducts ?? CycleCapacityFormLimits.MaxProductsPerVisit)" />
                                <div class="form-text">@Localizer["TypicalCountHint"]</div>
                                <span asp-validation-for="TypicalNonPromoCount" class="text-danger small mt-1"></span>
                            </div>
                        </div>
                        @* The formula hint: the INPUTS on the left, the CRM's typical-visit minutes on the right (filled
                           from the preview answer — the Web never adds them up itself). *@
                        <div class="small mt-3" id="typicalFormula" aria-live="polite">
                            <span class="text-muted">@Localizer["TypicalVisitMinutesLabel"]:</span>
                            <span class="fw-medium" data-formula-text>—</span>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-4">
                            <label asp-for="BetweenVisitTimeMinutes" class="form-label fw-medium">
                                @Localizer["BetweenVisitTimeMinutes"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="BetweenVisitTimeMinutes" type="number" class="form-control" inputmode="numeric"
                                   min="0" max="@limits.MaxBufferMinutes" required />
                            <span asp-validation-for="BetweenVisitTimeMinutes" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-8 d-flex align-items-end">
                            <div class="form-text"><i class="bx bx-info-circle" aria-hidden="true"></i> @Localizer["BufferInfo"]</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 4 · Products per visit -->
            <section class="card" aria-labelledby="secLimits">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-1" id="secLimits">@Localizer["ProductLimitsSection"]</h6>
                    <p class="text-muted small mb-4">@Localizer["ProductLimitsHint"]</p>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="MaxPromoProducts" class="form-label fw-medium">@Localizer["MaxPromoProducts"]</label>
                            <input asp-for="MaxPromoProducts" type="number" class="form-control js-live" inputmode="numeric"
                                   min="@CycleCapacityFormLimits.MinProductsPerVisit" max="@CycleCapacityFormLimits.MaxProductsPerVisit" step="1" />
                            <div class="form-text">@Localizer["MaxProductsHint"]</div>
                            <span asp-validation-for="MaxPromoProducts" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="MaxNonPromoProducts" class="form-label fw-medium">@Localizer["MaxNonPromoProducts"]</label>
                            <input asp-for="MaxNonPromoProducts" type="number" class="form-control js-live" inputmode="numeric"
                                   min="@CycleCapacityFormLimits.MinProductsPerVisit" max="@CycleCapacityFormLimits.MaxProductsPerVisit" step="1" />
                            <div class="form-text">@Localizer["MaxProductsHint"]</div>
                            <span asp-validation-for="MaxNonPromoProducts" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Notes -->
            <section class="card" aria-labelledby="secNotes">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4" id="secNotes">@Localizer["NotesSection"]</h6>
                    <label asp-for="Description" class="form-label fw-medium">@SharedLocalizer["Description"]</label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="1000"></textarea>
                    <span asp-validation-for="Description" class="text-danger small mt-1"></span>
                </div>
            </section>
        </div>

        <!-- Live summary (right) — every figure comes from the preview endpoint; nothing is computed here. -->
        <div class="col-12 col-lg-4">
            <aside class="card cycle-capacity-summary" id="capacitySummary" aria-labelledby="secSummary">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="text-uppercase text-heading fw-semibold mb-0" id="secSummary">@Localizer["LiveSummaryTitle"]</h6>
                        <span class="badge bg-label-secondary" data-summary="calendarBadge">—</span>
                    </div>
                    <div aria-live="polite" aria-busy="false" data-summary="live">
                        <div class="d-none text-muted small" data-summary-state="loading">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@Localizer["SummaryLoading"]
                        </div>
                        <div class="d-none" data-summary-state="error" role="alert">
                            <div class="text-danger small mb-2">@Localizer["SummaryError"]</div>
                            <button type="button" class="btn btn-sm btn-label-secondary" data-summary-retry>@Localizer["Retry"]</button>
                        </div>
                        <div class="d-none text-muted small" data-summary-state="idle">@Localizer["SummaryIdle"]</div>
                        <div class="d-none" data-summary-state="content">
                            <div class="mb-3">
                                <div class="display-6 fw-semibold text-heading" data-summary="visits">—</div>
                                <div class="text-muted small">@Localizer["VisitsPerRep"]</div>
                                <div class="small text-muted mt-1 d-none" data-summary="noNumber"></div>
                            </div>
                            <dl class="row small mb-3">
                                <dt class="col-7 fw-normal text-muted">@Localizer["WorkingDays"]</dt><dd class="col-5 text-end mb-1" data-summary="workingDays">—</dd>
                                <dt class="col-7 fw-normal text-muted">@Localizer["DeductedDays"]</dt><dd class="col-5 text-end mb-1" data-summary="deductedDays">—</dd>
                                <dt class="col-7 fw-normal text-muted">@Localizer["FieldDays"]</dt><dd class="col-5 text-end mb-1" data-summary="fieldDays">—</dd>
                                <dt class="col-7 fw-normal text-muted">@Localizer["RemainingMinutes"]</dt><dd class="col-5 text-end mb-1" data-summary="remainingMinutes">—</dd>
                                <dt class="col-7 fw-normal text-muted">@Localizer["DivideByTypicalVisit"]</dt><dd class="col-5 text-end mb-1" data-summary="typicalVisitMinutes">—</dd>
                                <dt class="col-7 fw-normal text-muted">@Localizer["TimesAverageFte"]</dt><dd class="col-5 text-end mb-1" data-summary="averageFte">—</dd>
                            </dl>
                            <div class="d-none" data-summary="blocks" role="alert">
                                <div class="fw-semibold text-danger small"><i class="bx bx-block" aria-hidden="true"></i> @Localizer["BlocksTitle"]</div>
                                <ul class="small text-danger ps-3 mb-2" data-summary="blockList"></ul>
                            </div>
                            <div class="d-none" data-summary="warnings">
                                <div class="fw-semibold text-warning small"><i class="bx bx-error" aria-hidden="true"></i> @Localizer["WarningsTitle"]</div>
                                <ul class="small ps-3 mb-2" data-summary="warningList"></ul>
                            </div>
                            <div class="d-none small text-success" data-summary="allOk"><i class="bx bx-check-circle" aria-hidden="true"></i> @Localizer["SummaryAllOk"]</div>
                        </div>
                    </div>
                    <p class="text-muted small mt-3 mb-0">@Localizer["TeamSupplyLater"]</p>
                </div>
            </aside>
        </div>
    </div>

    <!-- 5 · Monthly table (full width) -->
    <div class="row g-4 mt-0">
        <div class="col-12">
            <section class="card mb-4" aria-labelledby="secMonthly">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-1" id="secMonthly">@Localizer["MonthlyPlanSection"]</h6>
                    <p class="text-muted small mb-4">@Localizer["MonthlyDeductionsHint"]</p>

                    @if (Model.Months.Count == 0)
                    {
                        <div class="alert alert-secondary mb-0">@Localizer["MonthsPendingPeriod"]</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 dt-frozen-table" id="capacityMonthsTable">
                                <thead>
                                    <tr>
                                        <th scope="col" class="dt-frozen dt-frozen-1">@Localizer["Month"]</th>
                                        <th scope="col">@Localizer["MeetingDays"]</th>
                                        <th scope="col">@Localizer["TrainingDays"]</th>
                                        <th scope="col">@Localizer["VacationDays"]</th>
                                        <th scope="col">@Localizer["MicroTargetingDayCount"]</th>
                                        <th scope="col">@Localizer["MicroTargetingDuration"]</th>
                                        <th scope="col">@Localizer["Fte"]</th>
                                        <th scope="col" class="text-end">@Localizer["WorkingDays"]</th>
                                        <th scope="col" class="text-end">@Localizer["NonWorkingDays"]</th>
                                        <th scope="col" class="text-end dt-frozen dt-frozen-r4">@Localizer["DeductedDays"]</th>
                                        <th scope="col" class="text-end dt-frozen dt-frozen-r3">@Localizer["FieldDays"]</th>
                                        <th scope="col" class="text-end dt-frozen dt-frozen-r2">@Localizer["RemainingMinutes"]</th>
                                        <th scope="col" class="text-end dt-frozen dt-frozen-r1">@Localizer["TotalVisitNumber"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!readOnly)
                                    {
                                        @* "Apply to all months": these inputs carry NO name, so they are never posted; the button
                                           copies them into every month row (and marks an FTE written this way as authored). *@
                                        <tr class="cycle-capacity-bulk-row" data-bulk-row>
                                            <td class="dt-frozen dt-frozen-1">
                                                <button type="button" class="btn btn-sm btn-label-primary text-nowrap" id="applyToAllMonths">
                                                    <i class="bx bx-copy me-1" aria-hidden="true"></i>@Localizer["ApplyToAllMonths"]
                                                </button>
                                            </td>
                                            <td><input type="number" class="form-control form-control-sm js-bulk-input" data-prop="MeetingDays" min="0" max="@limits.MaxDeductionDays" aria-label="@Localizer["MeetingDays"] — @Localizer["ApplyToAllMonths"]" /></td>
                                            <td><input type="number" class="form-control form-control-sm js-bulk-input" data-prop="TrainingDays" min="0" max="@limits.MaxDeductionDays" aria-label="@Localizer["TrainingDays"] — @Localizer["ApplyToAllMonths"]" /></td>
                                            <td><input type="number" class="form-control form-control-sm js-bulk-input" data-prop="VacationDays" min="0" max="@limits.MaxDeductionDays" aria-label="@Localizer["VacationDays"] — @Localizer["ApplyToAllMonths"]" /></td>
                                            <td><input type="number" class="form-control form-control-sm js-bulk-input" data-prop="MicroTargetingDayCount" min="0" max="@limits.MaxDeductionDays" aria-label="@Localizer["MicroTargetingDayCount"] — @Localizer["ApplyToAllMonths"]" /></td>
                                            <td><input type="number" class="form-control form-control-sm js-bulk-input" data-prop="MicroTargetingDuration" min="0" max="@limits.MaxMinutesPerDay" aria-label="@Localizer["MicroTargetingDuration"] — @Localizer["ApplyToAllMonths"]" /></td>
                                            <td><input type="number" class="form-control form-control-sm js-bulk-input" data-prop="Fte" min="0" max="@CycleCapacityFormLimits.MaxFte.ToString(inv)" step="@CycleCapacityFormLimits.FteStep.ToString(inv)" aria-label="@Localizer["Fte"] — @Localizer["ApplyToAllMonths"]" /></td>
                                            <td colspan="2"></td>
                                            <td class="dt-frozen dt-frozen-r4"></td>
                                            <td class="dt-frozen dt-frozen-r3"></td>
                                            <td class="dt-frozen dt-frozen-r2"></td>
                                            <td class="dt-frozen dt-frozen-r1"></td>
                                        </tr>
                                    }
                                    @for (var i = 0; i < Model.Months.Count; i++)
                                    {
                                        var month = Model.Months[i];
                                        var monthKey = $"{month.Year}-{month.MonthNumber:00}";
                                        var authored = string.Equals(month.FteSource, "authored", StringComparison.OrdinalIgnoreCase) || month.FteTouched;
                                        <tr data-month-key="@monthKey">
                                            <td class="text-nowrap dt-frozen dt-frozen-1">
                                                <span class="fw-medium">@month.MonthLabel</span>
                                                <span class="badge bg-label-info ms-1 d-none" data-cell="partial" title="@Localizer["PartialMonthTitle"]">@Localizer["PartialMonth"]</span>
                                                <span class="badge bg-label-warning ms-1 d-none" data-cell="noFieldDays">@Localizer["MonthZeroedBadge"]</span>
                                                <input type="hidden" asp-for="Months[i].Year" />
                                                <input type="hidden" asp-for="Months[i].MonthNumber" />
                                                <input type="hidden" asp-for="Months[i].FteSource" />
                                                <input type="hidden" name="Months[@i].FteTouched" value="@(month.FteTouched ? "true" : "false")" data-fte-touched />
                                                <input type="hidden" name="Months[@i].FteText" value="@month.FteText" data-fte-text />
                                            </td>
                                            <td><input asp-for="Months[i].MeetingDays" type="number" class="form-control form-control-sm js-month-input" min="0" max="@limits.MaxDeductionDays" /></td>
                                            <td><input asp-for="Months[i].TrainingDays" type="number" class="form-control form-control-sm js-month-input" min="0" max="@limits.MaxDeductionDays" /></td>
                                            <td><input asp-for="Months[i].VacationDays" type="number" class="form-control form-control-sm js-month-input" min="0" max="@limits.MaxDeductionDays" /></td>
                                            <td><input asp-for="Months[i].MicroTargetingDayCount" type="number" class="form-control form-control-sm js-month-input" min="0" max="@limits.MaxDeductionDays" /></td>
                                            <td><input asp-for="Months[i].MicroTargetingDuration" type="number" class="form-control form-control-sm js-month-input" min="0" max="@limits.MaxMinutesPerDay" /></td>
                                            <td class="text-nowrap">
                                                @* K-5 — authorable, 0–1 step 0.05. The visible input has NO name: the value travels
                                                   in the invariant hidden twin above, and only when the author touched it. *@
                                                <div class="d-flex align-items-center gap-1">
                                                    <input type="number" class="form-control form-control-sm js-month-input js-fte-input" style="min-width:5rem"
                                                           min="0" max="@CycleCapacityFormLimits.MaxFte.ToString(inv)" step="@CycleCapacityFormLimits.FteStep.ToString(inv)"
                                                           value="@month.FteText" aria-label="@Localizer["Fte"] — @month.MonthLabel" />
                                                    <span class="badge @(authored ? "bg-label-primary" : "bg-label-secondary")" data-cell="fteSource"
                                                          data-authored-text="@Localizer["FteSourceAuthored"]">@(authored ? Localizer["FteSourceAuthored"] : Localizer["FteSourceDefault"])</span>
                                                </div>
                                            </td>
                                            <td class="text-end text-muted" data-cell="workingDays">—</td>
                                            <td class="text-end text-muted" data-cell="nonWorkingDays">—</td>
                                            <td class="text-end text-muted dt-frozen dt-frozen-r4" data-cell="deductedDays">—</td>
                                            <td class="text-end text-muted dt-frozen dt-frozen-r3" data-cell="fieldDays">—</td>
                                            <td class="text-end text-muted dt-frozen dt-frozen-r2" data-cell="remainingMinutes">—</td>
                                            <td class="text-end fw-medium dt-frozen dt-frozen-r1" data-cell="totalVisitNumber">—</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th class="dt-frozen dt-frozen-1">@Localizer["Total"]</th>
                                        <th colspan="8"></th>
                                        <th class="dt-frozen dt-frozen-r4"></th>
                                        <th class="dt-frozen dt-frozen-r3"></th>
                                        <th class="dt-frozen dt-frozen-r2"></th>
                                        <th class="text-end dt-frozen dt-frozen-r1" id="livePreviewTotal">—</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <p class="text-muted small mt-3 mb-0">@Localizer["EstimateSectionHint"]</p>
                    }
                </div>
            </section>
        </div>
    </div>
    </fieldset>
</form>
