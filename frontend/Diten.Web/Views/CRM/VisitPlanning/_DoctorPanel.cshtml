@using Diten.Web.Views.CRM.VisitPlanning
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitPlanningIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* WP-VP-4C (4) / 4D — the doctor panel (theme offcanvas, MK-1 drawer pattern). "Period view" (doctor-panel.js, every
   reader): target / done / remaining, the next visit's products, the product history over the period. "Products" (only a
   plan writer; doctor-panel.js hides it otherwise) is the product picker (K-7, S-1..S-4), driven by targets.js — single mode (one doctor: Done writes ONLY that doctor's products) or bulk mode (the selected doctors: the
   picked products are ADDED to what each already has). Suggested products (from the play — never named, K-3) are locked,
   role included (S-3). Rendered for every reader of the plan (the caller decides). *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="vp-doctor-panel" aria-labelledby="vp-dp-title" style="--bs-offcanvas-width:min(480px,100vw);">
    <div class="offcanvas-header border-bottom">
        <div style="min-width:0">
            <h5 class="offcanvas-title text-truncate" id="vp-dp-title">—</h5>
            <div class="text-muted small text-truncate" id="vp-dp-sub">—</div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>
    <div class="px-4 pt-3">
        <ul class="nav nav-pills d-inline-flex gap-2 flex-wrap" role="tablist">
            <li class="nav-item" role="presentation" id="vp-dp-tab-period-item">
                <button type="button" class="nav-link active small border shadow-none wc-tab-compact" id="vp-dp-tab-period-btn" data-bs-toggle="tab" data-bs-target="#vp-dp-tab-period" role="tab" aria-selected="true"><i class="bx bx-calendar me-1 wc-tab-icon"></i>@Localizer["DoctorPanelPeriod"]</button>
            </li>
            <li class="nav-item" role="presentation" id="vp-dp-tab-products-item">
                <button type="button" class="nav-link small border shadow-none wc-tab-compact" id="vp-dp-tab-products-btn" data-bs-toggle="tab" data-bs-target="#vp-dp-tab-products" role="tab" aria-selected="false" tabindex="-1"><i class="bx bx-package me-1 wc-tab-icon"></i>@Localizer["ColProducts"]</button>
            </li>
        </ul>
    </div>
    <div class="offcanvas-body tab-content p-0">
        <div class="tab-pane fade show active p-4" id="vp-dp-tab-period" role="tabpanel"><div class="text-muted small">—</div></div>
        <div class="tab-pane fade p-4" id="vp-dp-tab-products" role="tabpanel">
        <div class="d-flex flex-column gap-3">
            @* Notes: bulk mode / suggested lock / no products / portfolio undefined — targets.js shows the ones that apply. *@
            <div id="vp-dp-notes" class="d-flex flex-column gap-2"></div>

            @* Limit "N / max" per role (from the period capacity) and the visit time from the list (VisitMinutes). *@
            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap small">
                <span id="vp-dp-limit">—</span>
                <span class="text-muted" id="vp-dp-duration"></span>
            </div>
            <div id="vp-dp-warn" class="d-flex flex-column gap-2"></div>

            <div id="vp-dp-selected" class="d-flex flex-column gap-2"></div>

            <div class="border-top pt-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <input type="search" class="form-control form-control-sm" id="vp-dp-search" placeholder="@Localizer["ProductSearch"]" aria-label="@Localizer["ProductSearch"]">
                    <div class="form-check form-switch mb-0 text-nowrap">
                        <input class="form-check-input" type="checkbox" role="switch" id="vp-dp-all" checked disabled>
                        <label class="form-check-label small" for="vp-dp-all">@Localizer["AllProducts"]</label>
                    </div>
                </div>
                <div id="vp-dp-results" class="list-group list-group-flush small"></div>
            </div>
        </div>
        </div>
    </div>
    @* The footer belongs to the Products tab (doctor-panel.js hides it on the period view). *@
    <div class="offcanvas-footer border-top p-3 d-flex align-items-center justify-content-between gap-2 flex-wrap d-none" id="vp-dp-footer">
        <span class="text-muted small flex-grow-1" id="vp-dp-footnote" style="min-width:0">@Localizer["ProductsS1Note"]</span>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
            <button type="button" class="btn btn-primary" id="vp-dp-done">@Localizer["ProductsDone"]</button>
        </div>
    </div>
</div>
