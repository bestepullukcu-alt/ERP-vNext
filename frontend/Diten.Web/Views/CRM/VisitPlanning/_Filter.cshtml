@model Diten.Web.Models.CRM.VisitPlanningIndexViewModel
@using Diten.Web.Views.CRM.VisitPlanning
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitPlanningIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-end gap-3">

                    @* WP-VP-4J (4) — every filter carries a visible label; the status options are FIXED (every status: draft ·
                       approved (old plan) · archived — index.js), not derived from the loaded rows. *@
                    <div class="filter-chip filter-status d-flex flex-column">
                        <label class="form-label small mb-1" for="filterSessionStatus">@SharedLocalizer["Status"]</label>
                        <select id="filterSessionStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@SharedLocalizer["Status"]">
                        </select>
                    </div>

                    <div class="filter-chip filter-period d-flex flex-column">
                        <label class="form-label small mb-1" for="filterCyclePeriod">@Localizer["CyclePeriod"]</label>
                        <select id="filterCyclePeriod" class="form-select form-select-sm select2" data-placeholder="@Localizer["CyclePeriod"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    @* The rep filter is a read-all holder's only (a rep sees only their own plans, K-1). *@
                    @if (Model.CanReadAll)
                    {
                        <div class="filter-chip filter-rep d-flex flex-column">
                            <label class="form-label small mb-1" for="filterRep">@Localizer["Rep"]</label>
                            <input type="text" id="filterRep" class="form-control form-control-sm" placeholder="@Localizer["Rep"]" />
                        </div>
                    }

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
