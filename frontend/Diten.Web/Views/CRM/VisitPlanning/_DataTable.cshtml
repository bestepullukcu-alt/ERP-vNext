@using Diten.Web.Views.CRM.VisitPlanning
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitPlanningIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* No select-all checkbox and no bulk action bar: a draft plan is deleted one at a time from its row menu; there is no
   bulk-delete surface for planning sessions. *@
<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-visit-planning" data-dt-standard="v2" class="datatables-visitplanning table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["Plan"]</th>
                    <th>@Localizer["CyclePeriod"]</th>
                    <th>@Localizer["WeekLabel"]</th>
                    <th>@Localizer["Rep"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th>@Localizer["Targets"]</th>
                    <th>@Localizer["Updated"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
