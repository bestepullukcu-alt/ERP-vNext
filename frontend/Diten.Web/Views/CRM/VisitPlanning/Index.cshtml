@model Diten.Web.Models.CRM.VisitPlanningIndexViewModel
@using Diten.Web.Views.CRM.VisitPlanning
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitPlanningIndex> Localizer
@{
    ViewData["Title"] = Localizer["SessionsTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* ① Inline Filter partial *@
@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/CRM/VisitPlanning/_Filter.cshtml" />

@* Golden Compact: authoring happens on its own page; the create affordance lives once in the DataTable toolbar
   (the `.add-new` button), gated by the CanGenerate flag published to index.js below. *@
@* WP-VP-4B (brief §1, MK-5) — the rep's own plans; the "Team" view switch is visible but inactive until the manager view
   exists. Bands (index.js): no active period (new plan blocked), no territory (K-5), empty drafts + "delete empty drafts",
   a list that could not be read. *@
<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h5 class="mb-0">@Localizer["SessionsTitle"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>
    <div class="btn-group" role="group" aria-label="@Localizer["ViewSwitchLabel"]">
        <button type="button" class="btn btn-sm btn-primary active" id="vp-view-mine" aria-pressed="true">@Localizer["MyPlans"]</button>
        <span class="d-inline-block" tabindex="0" title="@Localizer["TeamViewSoon"]" data-bs-toggle="tooltip">
            <button type="button" class="btn btn-sm btn-label-secondary rounded-start-0" id="vp-view-team" disabled aria-disabled="true"><i class="bx bx-lock-alt me-1" aria-hidden="true"></i>@Localizer["TeamView"]</button>
        </span>
    </div>
</div>
<div id="vp-list-bands"></div>
@* WP-VP-4J (5) — the mockup band: "N empty drafts (0 targets) … one draft per period and week" + "Archive empty drafts"
   (ARCHIVE, never delete: the existing one-by-one archive path, requestedStatus = archived). *@
<div id="vp-empty-drafts" class="alert alert-warning py-2 small d-none" role="status">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span><i class="bx bx-info-circle me-1" aria-hidden="true"></i><span id="vp-empty-drafts-text"></span></span>
        @if (Model.CanGenerate)
        {
            <button type="button" class="btn btn-sm btn-outline-warning" id="vp-archive-empty-drafts">@Localizer["ArchiveEmptyDrafts"]</button>
        }
    </div>
</div>

@* ② WP-VP-4J (5) — "Action" = archive the SELECTED empty drafts: a row check box (an empty draft only) + the Action menu
   entry "Archive selected empty drafts (N)" (index.js). *@

@* ③ DataTable Card — contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-visit-planning" data-dt-standard="v2"> *@
<partial name="~/Views/CRM/VisitPlanning/_DataTable.cshtml" />

<script id="visitplanning-page-flags" type="application/json">{"canGenerate": @(Model.CanGenerate ? "true" : "false"), "canApply": @(Model.CanApply ? "true" : "false"), "canReadAll": @(Model.CanReadAll ? "true" : "false")}</script>

@if (Model.CanGenerate)
{
    <partial name="~/Views/CRM/VisitPlanning/_NewPlanDrawer.cshtml" />
}

@section Styles {
    @* WP-VP-4J — the Visit Planning page CSS (thin scrollbars), loaded on these pages only. *@
    <link rel="stylesheet" href="~/assets/css/visit-planning.css" asp-append-version="true" />
}

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/VisitPlanning/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/VisitPlanning/index.l10n.js" asp-append-version="true"></script>
    @* WP-VP-4H — the one date / number formatter, in the application's language (<html lang>). *@
    <script src="~/assets/js/CRM/VisitPlanning/format.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitPlanning/new-plan.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitPlanning/index.js" asp-append-version="true"></script>
}
