@model Diten.Web.Models.CRM.VisitPlanningSessionPageViewModel
@using Diten.Web.Views.CRM.VisitPlanning
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitPlanningIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Details"].Value;
    Layout = "_LayoutTenantShell";
}

@* Road-map Details. The plan summary is a tenant-style horizontal header card; Targets + Route are pill tabs. Section
   map stays [PlanSection, RouteSection] (the header card carries a visually-hidden PlanSection landmark heading; the Route
   pane carries the RouteSection heading; the Targets pane is a plain card) so parity with _Form.cshtml holds.
   Bodies are filled client-side by details.js from /api/sessions/{id} + /api/preview. *@
<div class="visit-planning-details"
     id="visit-planning-details"
     data-session-id="@Model.SessionId"
     data-can-generate="@Model.CanGenerate.ToString().ToLowerInvariant()"
     data-can-apply="@Model.CanApply.ToString().ToLowerInvariant()"
     data-read-only="@Model.IsReadOnly.ToString().ToLowerInvariant()">

    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@SharedLocalizer["Details"] · <span id="vp-plan-title-crumb">—</span></h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/CRM/VisitPlanning">@Localizer["SessionsTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="/CRM/VisitPlanning" class="btn btn-label-secondary">@SharedLocalizer["Back"]</a>
            @if (Model.CanGenerate)
            {
                <a href="/CRM/VisitPlanning/Edit/@Model.SessionId" class="btn btn-primary">@SharedLocalizer["Edit"]</a>
            }
            @* WP-VP-4B (MK-1) — "New plan" opens the right-hand drawer (new-plan.js), from the detail too. *@
            @if (Model.CanGenerate)
            {
                <button type="button" class="btn btn-label-primary" data-vp-new-plan><i class="bx bx-plus me-1" aria-hidden="true"></i>@Localizer["NewSession"]</button>
            }
        </div>
    </div>

    <div id="vp-detail-status" class="small text-muted mb-3"></div>

    @* WP-VP-FIX-1 (D2) — a committed / archived plan: one line says why nothing can be changed. *@
    @if (Model.IsReadOnly)
    {
        <div class="alert alert-info py-2 small mb-3" id="vp-readonly-notice" role="status"><i class="bx bx-lock-alt me-1"></i>@Localizer["ReadOnlyNotice"]</div>
    }
    @* WP-VP-FIX-1 (C3) — filled by details.js when the planner reports calendarStatus = unresolved. *@
    <div id="vp-calendar-warning"></div>
    @* WP-VP-4B — the selected week's band (header.js): approved = locked, past = read-only, legacy plan = whole period
       approved; a plan that cannot be read says so here. *@
    <div id="vp-week-band"></div>

    @* ── Plan summary — WCN-style SUMMARY card (icon/label/value grid). Absorbs the old Route card's range + working
       hours. PlanSection landmark kept for section-map parity. Hidden #vp-plan-title/#vp-plan-code kept so details.js
       (which sets them) stays no-op-safe; the visible title lives in the breadcrumb. ── *@
    <div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
    <div class="card wcn-detail-card p-4 h-100">
    <section class="wcn-detail-section wcn-sum">
        <h6 class="visually-hidden">@Localizer["PlanSection"]</h6>
        <span class="visually-hidden" id="vp-plan-title">—</span><span class="visually-hidden" id="vp-plan-code">—</span>
        <div class="wcn-sum-main">
            <h6 class="text-uppercase text-heading fw-semibold mb-3 d-flex align-items-center gap-2"><i class="bx bx-info-circle dt-card-icon" aria-hidden="true"></i>@Localizer["PlanSummaryLabel"]</h6>
            <div class="row g-4">
                <div class="col-12 col-md-6"><div class="backbone-preview-field"><i class="bx bx-calendar" aria-hidden="true"></i><div><div class="backbone-preview-label">@Localizer["CyclePeriod"]</div><div class="backbone-preview-value mt-1" id="vp-d-period" dir="auto">—</div></div></div></div>
                <div class="col-12 col-md-6"><div class="backbone-preview-field"><i class="bx bx-user" aria-hidden="true"></i><div><div class="backbone-preview-label">@Localizer["Rep"]</div><div class="backbone-preview-value mt-1" id="vp-d-rep" dir="auto">—</div></div></div></div>
                <div class="col-12 col-md-6"><div class="backbone-preview-field"><i class="bx bx-calendar-week" aria-hidden="true"></i><div><div class="backbone-preview-label">@Localizer["WeekLabel"]</div><div class="backbone-preview-value mt-1" id="vp-d-week">—</div></div></div></div>
                <div class="col-12 col-md-6"><div class="backbone-preview-field"><i class="bx bx-flag" aria-hidden="true"></i><div><div class="backbone-preview-label">@SharedLocalizer["Status"]</div><div class="backbone-preview-value mt-1"><span class="badge bg-label-secondary" id="vp-d-status-strip">—</span></div></div></div></div>
                <div class="col-12 col-md-6"><div class="backbone-preview-field"><i class="bx bx-map-alt" aria-hidden="true"></i><div><div class="backbone-preview-label">@Localizer["DateRangeLabel"]</div><div class="backbone-preview-value mt-1" id="vp-route-range">—</div></div></div></div>
                <div class="col-12 col-md-6"><div class="backbone-preview-field"><i class="bx bx-time-five" aria-hidden="true"></i><div><div class="backbone-preview-label">@Localizer["WorkingHours"]</div><div class="backbone-preview-value mt-1">09:00–18:00</div></div></div></div>
            </div>
        </div>
    </section>
    </div>
    </div>

    @* ── WP-VP-4B / 4D — the selected week's actions (brief §3, mockup "03 Plan detayı"): a status sentence, then only the
       actions the selected week offers (header.js → VisitPlanningPage.actionsFor). The week is chosen on the Weeks strip,
       with "Open next week" or on the Route's own week selector — there is no week dropdown here. Every write button stays
       behind its permission flag; the items start hidden until the week is known. ── *@
    <div class="col-12 col-lg-4">
    <div class="card wcn-detail-card p-4 h-100">
    <div class="wcn-detail-section wcn-acts">
        <div class="wcn-acts-main">
            <h6 class="text-uppercase text-heading fw-semibold mb-3 d-flex align-items-center gap-2"><i class="bx bx-bolt-circle dt-card-icon" aria-hidden="true"></i>@Localizer["ActionsAvailable"]</h6>
            <p class="small mb-3" id="vp-hdr-status-text" role="status">—</p>
            <ul class="wcn-actrail">
                @if (Model.CanApply)
                {
                    <li class="wcn-act wcn-act-primary d-none" data-vp-action-item>
                        <button type="button" class="wcn-act-btn wcn-act-fill wcn-act-fill-success" id="vp-apply" data-vp-action="approveWeek"><i class="bx bx-check-double" aria-hidden="true"></i><span>@Localizer["ApproveWeek"]</span></button>
                        <p class="wcn-act-outcome">@Localizer["ApproveWeekHint"]</p>
                    </li>
                }
                @if (Model.CanApply)
                {
                    <li class="wcn-act d-none" data-vp-action-item>
                        <button type="button" class="wcn-act-btn wcn-act-bare" id="vp-reopen" data-vp-action="reopenWeek"><i class="bx bx-lock-open-alt" aria-hidden="true"></i><span>@Localizer["ReopenWeek"]</span></button>
                    </li>
                }
                @* WP-VP-4D — an empty week: rebuild the preview for it (a read; nothing is written). *@
                @if (Model.CanGenerate)
                {
                    <li class="wcn-act wcn-act-primary d-none" data-vp-action-item>
                        <button type="button" class="wcn-act-btn wcn-act-fill wcn-act-fill-primary" id="vp-generate-week" data-vp-action="generateWeek"><i class="bx bx-refresh" aria-hidden="true"></i><span>@Localizer["GenerateWeek"]</span></button>
                    </li>
                }
                <li class="wcn-act d-none" data-vp-action-item>
                    <button type="button" class="wcn-act-btn wcn-act-bare" id="vp-next-week" data-vp-action="nextWeek"><i class="bx bx-right-arrow-alt" aria-hidden="true"></i><span>@Localizer["NextWeek"]</span></button>
                </li>
                <li class="wcn-acts-row">
                    <ul class="wcn-actrail-secondary">
                        @if (Model.CanGenerate)
                        {
                            <li class="wcn-act d-none" data-vp-action-item><button type="button" class="wcn-act-btn wcn-act-bare" id="vp-hdr-save-targets" data-vp-action="saveTargets"><i class="bx bx-save" aria-hidden="true"></i><span>@Localizer["SaveTargets"]</span></button></li>
                        }
                        @if (Model.CanGenerate)
                        {
                            <li class="wcn-act d-none" data-vp-action-item><button type="button" class="wcn-act-btn wcn-act-bare" id="vp-preview" data-vp-action="generateRoute"><i class="bx bx-play" aria-hidden="true"></i><span>@Localizer["RouteAction"]</span></button></li>
                        }
                        @* Re-plan belongs to legacy committed plans only, which open read-only — never offered by a week. *@
                        @if (Model.CanApply)
                        {
                            <li class="wcn-act d-none" data-vp-action-item><button type="button" class="wcn-act-btn wcn-act-bare" id="vp-replan" data-vp-action="replan"><i class="bx bx-refresh" aria-hidden="true"></i><span>@Localizer["Replan"]</span></button></li>
                        }
                    </ul>
                </li>
            </ul>
        </div>
    </div>
    </div>
    </div>
    </div>

    @* ── WP-VP-4B (C5) / 4D (mockup "03 Plan detayı") — capacity in ONE unit (hours), two cards: this week (its share of the
       period capacity vs what it plans) and the period (capacity vs what it plans), each with a bar and a note. Without a
       capacity both cards say so (mockup). ── *@
    <div class="row g-3 mb-2">
        <div class="col-12 col-md-6">
            <div class="card h-100"><div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-6"><small class="text-muted d-block">@Localizer["WeekCapacity"]</small><h5 class="mb-0" id="vp-cap-week">—</h5></div>
                    <div class="col-6"><small class="text-muted d-block">@Localizer["WeekPlanned"]</small><h5 class="mb-0" id="vp-cap-week-planned">—</h5></div>
                </div>
                <div class="progress mt-3" style="height:6px;"><div class="progress-bar" id="vp-cap-week-bar" role="progressbar" style="width:0%" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="@Localizer["WeekPlanned"]"></div></div>
                <div class="small text-muted mt-2" id="vp-cap-week-note"></div>
            </div></div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card h-100"><div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-6"><small class="text-muted d-block">@Localizer["PeriodCapacity"]</small><h5 class="mb-0" id="vp-cap-period">—</h5></div>
                    <div class="col-6"><small class="text-muted d-block">@Localizer["PeriodPlanned"]</small><h5 class="mb-0"><span id="vp-cap-period-planned">—</span> <small class="text-muted" id="vp-cap-period-pct"></small></h5></div>
                </div>
                <div class="progress mt-3" style="height:6px;"><div class="progress-bar" id="vp-cap-period-bar" role="progressbar" style="width:0%" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="@Localizer["PeriodPlanned"]"></div></div>
                <div class="small text-muted mt-2" id="vp-cap-period-note"></div>
            </div></div>
        </div>
    </div>
    <div class="small text-warning mb-4 d-none" id="vp-cap-note" role="status"></div>

    @* ── Targets / Route pill tabs (structure mirrors Platform/Tenants/Details.cshtml). ── *@
    <div class="card mb-4">
        <div class="card-header p-3">
            <div class="nav-align-top">
                <ul class="nav nav-pills d-inline-flex gap-2 flex-wrap" role="tablist">
                    <li class="nav-item mb-1 mb-sm-0" role="presentation">
                        <button type="button" class="nav-link active small border shadow-none wc-tab-compact" id="vp-tab-targets-btn" data-bs-toggle="tab" data-bs-target="#vp-tab-targets" role="tab" aria-controls="vp-tab-targets" aria-selected="true">
                            <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-user-pin me-1 wc-tab-icon"></i>@Localizer["TargetsSection"]</span>
                            <i class="bx bx-user-pin d-sm-none wc-tab-icon"></i>
                        </button>
                    </li>
                    @* WP-VP-4D — the Weeks tab (weeks.js): the period strip, the selected week day by day, moving visits between
                       days (day pins), the doctors of the week. *@
                    <li class="nav-item mb-1 mb-sm-0" role="presentation" id="vp-tab-weeks-item">
                        <button type="button" class="nav-link small border shadow-none wc-tab-compact" id="vp-tab-weeks-btn" data-bs-toggle="tab" data-bs-target="#vp-tab-weeks" role="tab" aria-controls="vp-tab-weeks" aria-selected="false" tabindex="-1">
                            <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-calendar-week me-1 wc-tab-icon"></i>@Localizer["WeeksSection"]</span>
                            <i class="bx bx-calendar-week d-sm-none wc-tab-icon"></i>
                        </button>
                    </li>
                    <li class="nav-item mb-1 mb-sm-0" role="presentation">
                        <button type="button" class="nav-link small border shadow-none wc-tab-compact" id="vp-tab-route-btn" data-bs-toggle="tab" data-bs-target="#vp-tab-route" role="tab" aria-controls="vp-tab-route" aria-selected="false" tabindex="-1">
                            <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-map-alt me-1 wc-tab-icon"></i>@Localizer["RouteSection"]</span>
                            <i class="bx bx-map-alt d-sm-none wc-tab-icon"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="tab-content p-0">

        @* Tab 1 — Targets (WP-VP-4J, mockup v3 "04 Hedefler"): a head card (title, "week · N doctors, M pharmacies selected",
           the read-only badge) over three columns of cards — my accounts · the institution's doctors / linked pharmacies
           (a tab card + a content card with a PLAIN table, no DataTable) · the selection summary + the selected list. *@
        <div class="tab-pane fade show active vp-targets" id="vp-tab-targets" role="tabpanel" aria-labelledby="vp-tab-targets-btn">
            <div class="card px-4 py-3 mb-3 d-flex flex-row flex-wrap justify-content-between align-items-center gap-3" id="vp-targets-head">
                <div class="d-flex align-items-center gap-3" style="min-width:0">
                    <div class="vp-icon-tile" aria-hidden="true"><i class="bx bx-target-lock"></i></div>
                    <div style="min-width:0">
                        <div class="fw-semibold text-heading text-uppercase">@Localizer["TargetsSection"]</div>
                        <div class="small mt-1" id="vp-targets-subtitle">—</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    @* WP-VP-4C (5) / 4J — an approved / past week (or a read-only plan): the green "Read-only" badge + why. *@
                    <div id="vp-targets-locked" class="d-none align-items-center gap-2 flex-wrap" role="status">
                        <span class="badge bg-label-success d-inline-flex align-items-center gap-1 py-2 px-2"><i class="bx bx-lock-alt"></i>@Localizer["ReadOnlyBadge"]</span>
                        <span class="small text-muted" id="vp-targets-locked-text" style="max-width:380px">@Localizer["TargetsLockedBand"]</span>
                    </div>
                    @if (Model.CanGenerate)
                    {
                        <button type="button" class="btn btn-sm btn-success" id="vp-save-targets"><i class="bx bx-save me-1"></i>@Localizer["SaveTargets"]</button>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3 align-items-stretch vp-targets-row">
                @* ── LEFT — my accounts (WP-VP-4H / 4I account cards) ── *@
                <div class="card p-4 d-flex flex-column gap-2" id="vp-accounts-col" style="flex:1 1 280px;min-width:0">
                    @* WP-VP-4H (6) — "My accounts (territory)": the rep's territory accounts as the picker itself (details.js:
                       my-accounts, server search, 50 at a time while scrolling); the plan's accounts first. A click opens the
                       account's doctors. *@
                    <div class="d-flex align-items-center justify-content-between">
                        <label class="fw-medium text-heading mb-0" for="vp-acc-search">@Localizer["MyAccountsTitle"]</label>
                        <span class="badge bg-label-secondary" id="vp-accounts-count">—</span>
                    </div>
                    @* WP-VP-2 (B-2) — K-5: shown by details.js when the rep has no territory assignment. *@
                    <div id="vp-territory-banner" class="alert alert-warning py-2 small mb-0 d-none" role="status"><i class="bx bx-error me-1"></i>@Localizer["TerritoryUnassignedBanner"]</div>
                    <input type="search" class="form-control" id="vp-acc-search" placeholder="@Localizer["AccountSearch"]" aria-label="@Localizer["AccountSearch"]">
                    <div class="list-group list-group-flush border rounded overflow-auto" id="vp-acc-list" role="listbox" aria-label="@Localizer["MyAccountsTitle"]"></div>
                    <div class="form-text mt-0">@Localizer["AccountsHint"]</div>
                    @if (Model.CanGenerate)
                    {
                        <div id="vp-add-account-wrap">
                            @* WP-VP-4C (1) / 4I (6) — the white, dashed "+ Add out-of-territory": a dialog with the whole-tenant search
                               (WP-VP-2 B-2 flow kept); an account added there carries the out-of-territory badge. *@
                            <button type="button" class="btn btn-sm w-100 bg-white text-heading d-flex align-items-center justify-content-center gap-1 vp-out-territory-btn" style="border:1px dashed #b4bdc6" id="vp-out-territory-open" data-bs-toggle="modal" data-bs-target="#vp-out-territory-modal"><i class="bx bx-plus"></i>@Localizer["AddOutOfTerritoryShort"]</button>
                        </div>
                    }
                </div>

                @* ── MIDDLE — the picked institution: a tab card + a content card ── *@
                <div class="d-none flex-column gap-3" id="vp-contacts-panel" style="flex:2.4 1 560px;min-width:0">
                    <div class="card px-3 py-2">
                        <div class="d-flex gap-2 flex-wrap" role="tablist" id="vp-subtabs">
                            <button type="button" class="btn vp-midtab active" id="vp-subtab-doctors-btn" data-bs-toggle="tab" data-bs-target="#vp-subtab-doctors" role="tab" aria-selected="true"><i class="bx bx-user"></i>@Localizer["ContactsPanel"]<span class="vp-midtab-count" id="vp-doctors-count">0</span></button>
                            <button type="button" class="btn vp-midtab" id="vp-subtab-pharm-btn" data-bs-toggle="tab" data-bs-target="#vp-subtab-pharm" role="tab" aria-selected="false" tabindex="-1"><i class="bx bx-plus-medical"></i>@Localizer["LinkedPharmacies"]<span class="vp-midtab-count" id="vp-pharm-count">0</span></button>
                        </div>
                    </div>
                    <div class="card p-4 d-flex flex-column gap-3 vp-fill-card">
                        @* The institution: the building tile, its name, the city · doctors · linked pharmacies pills. *@
                        <div class="d-flex gap-3 align-items-center pb-3 border-bottom flex-wrap">
                            <div class="vp-icon-tile vp-icon-tile-lg" aria-hidden="true"><i class="bx bx-buildings"></i></div>
                            <div class="d-flex flex-column gap-1" style="min-width:0;flex:1 1 240px">
                                <div class="fs-5 fw-medium text-heading" id="vp-contacts-for" dir="auto">—</div>
                                <div class="d-flex gap-2 flex-wrap small" id="vp-contacts-meta"></div>
                            </div>
                        </div>

                        <div class="tab-content p-0">
                            <div class="tab-pane fade show active" id="vp-subtab-doctors" role="tabpanel" aria-labelledby="vp-subtab-doctors-btn">
                                <div class="d-flex flex-column gap-3">
                                    @* WP-VP-4C (2) / 4J — the counted quick filters as pills (the server's quick=due|never|all). *@
                                    <div class="d-flex gap-2 flex-wrap" role="group" id="vp-quick-filters" aria-label="@Localizer["QuickFiltersLabel"]">
                                        <button type="button" class="btn vp-pill vp-quick active" data-quick="due" aria-pressed="true">@Localizer["QuickFilterDue"] <span class="vp-quick-count" data-quick="due"></span></button>
                                        <button type="button" class="btn vp-pill vp-quick" data-quick="never" aria-pressed="false">@Localizer["QuickFilterNever"] <span class="vp-quick-count" data-quick="never"></span></button>
                                        <button type="button" class="btn vp-pill vp-quick" data-quick="all" aria-pressed="false">@Localizer["QuickFilterAll"] <span class="vp-quick-count" data-quick="all"></span></button>
                                    </div>
                                    @* Search · specialty (counted multi-select) · select all (N) · apply products (N). *@
                                    <div class="d-flex gap-2 flex-wrap align-items-center">
                                        <input type="search" class="form-control" id="vp-doctor-search" placeholder="@Localizer["SearchDoctor"]" aria-label="@Localizer["SearchDoctor"]" style="flex:1 1 200px;width:auto">
                                        <div id="vp-specialty-pills"></div>
                                        @if (Model.CanGenerate)
                                        {
                                            <button type="button" class="btn btn-label-secondary" id="vp-select-all-doctors"><i class="bx bx-check-double me-1"></i>@Localizer["SelectAllDoctors"] <span id="vp-select-all-count"></span></button>
                                        }
                                        @* WP-VP-4C (4) — bulk product apply: the picker in bulk mode for the selected doctors (targets.js). *@
                                        @if (Model.CanGenerate)
                                        {
                                            <button type="button" class="btn btn-outline-primary" id="vp-bulk-products" disabled><i class="bx bx-package me-1"></i><span id="vp-bulk-products-label">@Localizer["BulkApplyProducts", 0]</span></button>
                                            @* WP-VP-4L (4) — the ticked plan doctors without a visit this week get an extra visit (a draft / empty
                                               week only; details.js shows it once the server knows extra visits). *@
                                            <button type="button" class="btn btn-outline-warning d-none" id="vp-week-extra-bulk" disabled><i class="bx bx-calendar-plus me-1"></i><span id="vp-week-extra-bulk-label"></span></button>
                                        }
                                    </div>
                                    @* WP-VP-4J — the institution's active doctors in a PLAIN table (no DataTable, no paging): it scrolls inside
                                       the card; a narrow screen scrolls it sideways. details.js draws the rows. *@
                                    <div class="vp-doc-scroll border rounded">
                                        <table id="dt-vp-contacts" class="table mb-0 vp-doc-table">
                                            <thead><tr>
                                                <th><span class="visually-hidden">@Localizer["ColSelected"]</span></th>
                                                <th>@Localizer["ColContact"]</th>
                                                <th>@Localizer["ColSpecialty"]</th>
                                                <th>@Localizer["ColProducts"]</th>
                                                <th>@Localizer["ColFrequency"]</th>
                                                <th>@Localizer["ColDoneRemaining"]</th>
                                                <th>@Localizer["ColLastVisit"]</th>
                                                <th>@Localizer["ColStatus"]</th>
                                            </tr></thead>
                                            <tbody id="vp-doc-tbody"></tbody>
                                        </table>
                                        <div class="text-center small py-4" id="vp-contacts-hint">@Localizer["PickAccountForContacts"]</div>
                                    </div>
                                    @* WP-VP-4C (4) — what the product chips mean: colour = role, icon = where the product came from. *@
                                    <div class="d-flex align-items-center gap-3 flex-wrap small text-muted" id="vp-products-legend">
                                        <span><span class="badge rounded-pill bg-label-primary">A</span> @Localizer["LegendPromo"]</span>
                                        <span><span class="badge rounded-pill bg-transparent border text-body">B</span> @Localizer["LegendNonPromo"]</span>
                                        <span><i class="bx bx-bulb"></i> @Localizer["LegendPlay"]</span>
                                        <span><i class="bx bx-history"></i> @Localizer["LegendLastVisit"]</span>
                                        <span><i class="bx bx-user-check"></i> @Localizer["LegendRepPick"]</span>
                                        <span><i class="bx bx-error text-warning"></i> @Localizer["NoApprovedContent"]</span>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="vp-subtab-pharm" role="tabpanel" aria-labelledby="vp-subtab-pharm-btn">
                                <div id="vp-pharmacies"></div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── RIGHT — the selection summary (lavender) + the selected list ── *@
                <div class="d-flex flex-column gap-3" style="flex:1 1 280px;min-width:0">
                    <div class="card vp-summary-card p-4">
                        <div class="text-uppercase small vp-summary-label mb-3">@Localizer["SelectionSummary"]</div>
                        <div class="row g-2 text-center">
                            <div class="col-4"><div class="fs-3 fw-medium" id="vp-sum-doctors">0</div><small class="vp-summary-label">@Localizer["StatDoctors"]</small></div>
                            <div class="col-4"><div class="fs-3 fw-medium" id="vp-sum-pharm">0</div><small class="vp-summary-label">@Localizer["StatPharmacies"]</small></div>
                            <div class="col-4"><div class="fs-3 fw-medium" id="vp-sum-accounts">0</div><small class="vp-summary-label">@Localizer["StatAccounts"]</small></div>
                        </div>
                        @* WP-VP-4C (3) — this week's estimated time (by products) + its share of the week, the product distribution
                           and the doctors without a product — from the plan's preview (targets.js). *@
                        <div id="vp-sum-extra" class="small mt-3 pt-3 vp-summary-rule"></div>
                    </div>
                    <div class="card p-4">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-semibold text-heading text-uppercase">@Localizer["SelectedLabel"]</span>
                            @if (Model.CanGenerate)
                            {
                                <button type="button" class="btn btn-sm btn-text-secondary p-0" id="vp-clear-selection">@Localizer["ClearSelection"]</button>
                            }
                        </div>
                        <div id="vp-selection-chips" class="d-flex flex-column gap-2 overflow-auto" style="max-height:470px"><div class="text-muted small">—</div></div>
                    </div>
                </div>
            </div>
            <div class="form-text mt-2" id="vp-targets-status"></div>

            @* WP-VP-4C (4) — the rules box: how a visit's product list fills (source order) and the mixed order. *@
            <div class="card p-3 mt-3" id="vp-product-rules">
                <button type="button" class="btn btn-sm btn-text-secondary p-0 fw-medium align-self-start" data-bs-toggle="collapse" data-bs-target="#vp-product-rules-body" aria-expanded="false" aria-controls="vp-product-rules-body"><i class="bx bx-info-circle me-1"></i>@Localizer["RulesTitle"]</button>
                <div class="collapse" id="vp-product-rules-body">
                    <ul class="small text-muted mb-0 mt-2 ps-3">
                        <li>@Localizer["RuleSourceOrder"]</li>
                        <li>@Localizer["RuleMixedOrder"]</li>
                        <li>@Localizer["RuleOverflow"]</li>
                        <li>@Localizer["RuleUnknownFrequency"]</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="vp-tab-weeks" role="tabpanel" aria-labelledby="vp-tab-weeks-btn">
            <div class="card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <div class="text-uppercase text-heading fw-semibold">@Localizer["PeriodWeeksTitle"]</div>
                        <div class="text-muted small" id="vp-wk-summary">—</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-text-secondary" data-bs-toggle="collapse" data-bs-target="#vp-wk-rules" aria-expanded="false" aria-controls="vp-wk-rules"><i class="bx bx-info-circle me-1"></i>@Localizer["AutoDraftRulesTitle"]</button>
                </div>
                <div class="collapse mb-3" id="vp-wk-rules">
                    <ul class="small text-muted mb-0 ps-3">
                        <li>@Localizer["AutoDraftRuleApprove"]</li>
                        <li>@Localizer["AutoDraftRuleEven"]</li>
                        <li>@Localizer["AutoDraftRuleDays"]</li>
                        <li>@Localizer["RuleSourceOrder"]</li>
                        <li>@Localizer["RuleMixedOrder"]</li>
                        <li>@Localizer["RuleUnknownFrequency"]</li>
                    </ul>
                </div>
                <div class="d-flex gap-2 overflow-auto pb-2" id="vp-wk-strip" role="listbox" aria-label="@Localizer["PeriodWeeksTitle"]"></div>
            </div>
            @* WP-VP-4H (2) — the week (left, mockup flex 1 1 520px) and its doctors (right, 1 1 420px) side by side; stacked on
               a narrow screen; mirrored in RTL by the flex direction. *@
            <div class="d-flex flex-wrap gap-3 align-items-start mb-4">
                <div class="card p-4 d-flex flex-column gap-4" id="vp-wk-detail" aria-live="polite" style="flex:1 1 520px;min-width:0"><div class="text-muted small">@SharedLocalizer["Loading"]</div></div>
                <div class="card p-4 d-flex flex-column gap-2" id="vp-wk-doctors" style="flex:1 1 420px;min-width:0"></div>
            </div>
        </div>

        @* Tab 2 — Route: the road-map view (RouteSection heading kept for section-map parity). *@
        <div class="tab-pane fade" id="vp-tab-route" role="tabpanel" aria-labelledby="vp-tab-route-btn">
            @* Card-less: the route content stands on its own; the RouteSection h6 stays (visually-hidden) as the section-map landmark. *@
            <section>
                <h6 class="visually-hidden">@Localizer["RouteSection"]</h6>

                @* Day chips (left) + route controls & view toggles (right) share one card header. Reset-optimal + the
                   (hidden) week select sit in the control row; the old standalone strip + empty territory gap were
                   removed so this card follows the tabs card at the same rhythm as the tenant detail. *@
                <div class="card mb-4">
                    <div class="card-header p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="nav-align-top">
                            <ul class="nav nav-pills d-inline-flex gap-2 flex-wrap" id="vp-day-tabs" role="tablist"></ul>
                        </div>
                        @* Route controls + a filter button (WorkCenterNext style) that opens/closes the view-toggle panel. *@
                        <div class="d-flex align-items-center gap-2 flex-wrap" id="vp-route-toggles">
                            <button type="button" id="vp-reset-optimal" class="btn btn-sm btn-label-secondary d-none"><i class="bx bx-reset me-1"></i>@Localizer["ResetOptimal"]</button>
                            <select id="vp-week" class="form-select form-select-sm w-auto d-none" aria-label="@Localizer["WeekLabel"]"></select>
                            <button type="button" class="btn btn-icon btn-label-secondary" id="vp-view-filter-btn" data-bs-toggle="collapse" data-bs-target="#vp-view-filters" aria-controls="vp-view-filters" aria-expanded="false" title="@Localizer["ViewOptions"]" aria-label="@Localizer["ViewOptions"]"><i class="icon-base bx bx-filter-alt icon-sm"></i></button>
                        </div>
                    </div>
                    @* Collapsible view-toggle panel — opened by the filter button. Map / Visit # / Drive times switches. *@
                    <div class="collapse" id="vp-view-filters">
                        <div class="card-body pt-0 pb-3 border-top">
                            <div class="d-flex align-items-center gap-4 flex-wrap pt-3">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" id="vp-toggle-map" checked>
                                    <label class="form-check-label small" for="vp-toggle-map">@Localizer["ToggleMap"]</label>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" id="vp-toggle-visitnums" checked>
                                    <label class="form-check-label small" for="vp-toggle-visitnums">@Localizer["ToggleVisitNumbers"]</label>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" id="vp-toggle-drivetimes" checked>
                                    <label class="form-check-label small" for="vp-toggle-drivetimes">@Localizer["ToggleDriveTimes"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Out-of-territory warnings — filled by renderDay when a stop is outside coverage (empty otherwise). *@
                <div id="vp-territory-warnings"></div>

                @* Two columns: the day plan (summary + timeline) on the left, the SVG route map on the right. *@
                <div id="vp-route-view" class="row g-3">
                    <div id="vp-route-main" class="col-12 col-lg-8">
                        @* Per-day summary report (visits / stops / field time / free time) — populated by renderDay. *@
                        <div id="vp-day-summary" class="mb-3"></div>
                        <div id="vp-route-warnings"></div>
                        @* WP-VP-4F — pinned visits that did not fit their day ("N visits did not fit → {day}"), from weeks.js. *@
                        <div id="vp-route-pin-overflow"></div>
                        <div id="vp-visit-cards" class="d-flex flex-column gap-2">
                            <div class="vp-empty d-flex flex-column align-items-center justify-content-center text-center">
                                <svg width="96" height="84" viewBox="0 0 96 84" fill="none" aria-hidden="true">
                                    <rect x="20" y="12" width="56" height="44" rx="8" fill="rgba(var(--bs-primary-rgb),.08)"></rect>
                                    <path d="M30 52 L46 24 L60 52" stroke="rgba(var(--bs-primary-rgb),.35)" stroke-width="2" fill="none"></path>
                                    <circle cx="34" cy="42" r="3.5" fill="var(--bs-primary)"></circle>
                                    <circle cx="48" cy="32" r="3.5" fill="var(--bs-primary)"></circle>
                                    <circle cx="62" cy="40" r="3.5" fill="var(--bs-primary)"></circle>
                                </svg>
                                <h5 class="mb-1 mt-3">@Localizer["NoPlanTitle"]</h5>
                                <div class="text-muted small" style="max-width:340px;">@Localizer["NoPlanDesc"]</div>
                            </div>
                        </div>
                    </div>
                    <div id="vp-map-col" class="col-12 col-lg-4">
                        <div id="vp-map-panel"></div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    @* WP-VP-4B (MK-4) — reopen an approved week: a reason of at least 10 characters; it goes into the week's history. *@
    @if (Model.CanApply)
    {
        <div class="modal fade" id="vp-reopen-modal" tabindex="-1" aria-labelledby="vp-reopen-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="vp-reopen-title">@Localizer["ReopenWeek"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Cancel"]"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small mb-3">@Localizer["ReopenBody"]</p>
                        <label class="form-label fw-medium" for="vp-reopen-reason">@Localizer["ReopenReasonLabel"] <span class="text-danger">*</span></label>
                        <textarea id="vp-reopen-reason" class="form-control" rows="3" maxlength="500"></textarea>
                        <div class="d-flex justify-content-between form-text"><span>@Localizer["ReopenReasonHint"]</span><span id="vp-reopen-count">0 / 10</span></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                        <button type="button" class="btn btn-primary" id="vp-reopen-confirm" disabled>@Localizer["ReopenConfirm"]</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* WP-VP-4C (1) — "Add out-of-territory": the whole-tenant account search in a dialog (WP-VP-2 B-2 flow kept); an
       account added here is badged out-of-territory. *@
    @if (Model.CanGenerate)
    {
        <div class="modal fade" id="vp-out-territory-modal" tabindex="-1" aria-labelledby="vp-out-territory-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="vp-out-territory-title">@Localizer["AddOutOfTerritory"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Cancel"]"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning py-2 small mb-3" role="note"><i class="bx bx-error me-1"></i>@Localizer["OutOfTerritoryDialogHint"]</div>
                        <select id="vp-add-account-out" class="form-select form-select-sm select2" data-placeholder="@Localizer["AddOutOfTerritory"]"><option value=""></option></select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.CanGenerate)
{
    <partial name="~/Views/CRM/VisitPlanning/_NewPlanDrawer.cshtml" />
}
@* WP-VP-4D — the doctor panel serves every reader (its "Period view" tab); its "Products" tab is offered only to a
   plan writer (doctor-panel.js / targets.js check the generate flag). *@
<partial name="~/Views/CRM/VisitPlanning/_DoctorPanel.cshtml" />
@* WP-VP-4D (Ek — move between days) — "Move to day…": the keyboard way of the drag on a day row, and the question a
   dragged doctor asks ("all of this institution's visits, or only this doctor?"). Writes the week's day pins through the
   existing session update. *@
@if (Model.CanGenerate)
{
    <div class="modal fade" id="vp-move-modal" tabindex="-1" aria-labelledby="vp-move-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="vp-move-title">@Localizer["MoveToDay"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Cancel"]"></button>
                </div>
                <div class="modal-body">
                    <p class="fw-medium mb-2" id="vp-move-who">—</p>
                    <div class="mb-3" id="vp-move-day-wrap">
                        <label class="form-label small" for="vp-move-day">@Localizer["MoveDayLabel"]</label>
                        <select class="form-select form-select-sm" id="vp-move-day"></select>
                    </div>
                    <p class="small mb-0 d-none" id="vp-move-question"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                    <button type="button" class="btn btn-label-primary d-none" id="vp-move-one">@Localizer["MoveOnlyThis"]</button>
                    <button type="button" class="btn btn-primary" id="vp-move-all">@Localizer["MoveConfirm"]</button>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    @* Leaflet (vendored) — the Route tab's real map (OSM tiles), same stack as the Account/Contact location pickers. *@
    <link rel="stylesheet" href="~/assets/vendor/libs/leaflet/leaflet.css" />
    @* WP-VP-4J — the Visit Planning page CSS (mockup v3 look + thin scrollbars), loaded on these pages only. *@
    <link rel="stylesheet" href="~/assets/css/visit-planning.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="~/Views/CRM/VisitPlanning/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/VisitPlanning/index.l10n.js" asp-append-version="true"></script>
    @* WP-VP-4H — the one date / number formatter, in the application's language (<html lang>). *@
    <script src="~/assets/js/CRM/VisitPlanning/format.js" asp-append-version="true"></script>
    @* SortableJS (not globally loaded on the tenant shell) — drives the drag-reorder of doctor visits inside a route block. *@
    <script src="~/assets/vendor/libs/sortablejs/sortable.js" asp-append-version="true"></script>
    <script src="~/assets/vendor/libs/leaflet/leaflet.js" asp-append-version="true"></script>
    @* WP-VP-4B — page skeleton first (shared state + events), then Targets + Route (details.js), then the header. *@
    <script src="~/assets/js/CRM/VisitPlanning/page.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitPlanning/details.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitPlanning/header.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitPlanning/new-plan.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitPlanning/targets.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitPlanning/weeks.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitPlanning/doctor-panel.js" asp-append-version="true"></script>
}
