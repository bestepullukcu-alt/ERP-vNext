@model Diten.Web.Models.CRM.SegmentPageViewModel
@using Diten.Web.Views.CRM.Segments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SegmentsIndex> Localizer
@{
    var segment = Model.Segment;
    ViewData["Title"] = segment.SegmentName;
    Layout = "_LayoutTenantShell";

    var isStatic = segment.SegmentType == "static";
    var isDynamic = segment.SegmentType == "dynamic";
    var isHybrid = segment.SegmentType == "hybrid";
    var frozen = segment.IsCriteriaFrozen;
    var statusClass = segment.SegmentStatus == "active" ? "success" : segment.SegmentStatus == "archived" ? "secondary" : "primary";

    // The stored rule, exactly as the runtime persists it — served for the "Show stored JSON" toggle, never fabricated.
    var criteriaJson = System.Text.Json.JsonSerializer.Serialize(
        segment.Criteria, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

    // WP-SEG-DETAILS3: the same stored criteria, camelCase, in the exact node shape the SEG-C /preview endpoint accepts.
    // details.js posts this for a DRAFT segment, where /resolve refuses with "segment_not_active"; an active segment
    // keeps /resolve. This is the machine body (criteriaJson above stays the human-readable toggle text) — both are
    // serialized from the one segment.Criteria, so nothing is fabricated.
    var previewCriteriaJson = System.Text.Json.JsonSerializer.Serialize(
        segment.Criteria, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

@* .segment-details-scope keeps the ported segd-* palette + Inter font off the app shell (WP §5).
   data-segment-type drives which membership blocks details.js shows: static hides the resolve preview, dynamic hides
   the manual table, hybrid shows both — the same rule the runtime already enforces. *@
<div class="segments-details segment-details-scope" data-segment-type="@segment.SegmentType">

    @* ---------------------------------------------------------------- page header *@
    <div class="d-flex flex-wrap gap-3 align-items-start justify-content-between mb-3">
        <div class="min-w-0">
            <div class="segd-crumb">
                <a href="/CRM/Segments">@Localizer["SegmentsTitle"]</a>
                <span class="segd-crumb-sep">/</span>
                <span class="segd-mono">@segment.SegmentCode</span>
            </div>
            <div class="segd-titlerow">
                <h5 class="segd-title">@segment.SegmentName</h5>
                <span class="badge bg-label-@statusClass">@segment.SegmentStatus</span>
                <span class="badge bg-label-primary">v@(segment.SegmentVersion)</span>
            </div>
            <div class="segd-headerline">
                @(isStatic ? Localizer["ReadsStatic"] : isHybrid ? Localizer["ReadsHybrid"] : Localizer["ReadsDynamic"])
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/CRM/Segments" class="btn btn-label-secondary">@Localizer["BackToList"]</a>
            @if (Model.CanActivate && !segment.IsArchived && segment.SegmentStatus == "draft")
            {
                <button type="button" class="btn btn-label-success js-activate-segment" data-id="@segment.SegmentId">@Localizer["ActivateSegment"]</button>
            }
            @if (Model.CanManage && !segment.IsArchived)
            {
                <button type="button" class="btn btn-label-warning js-new-version" data-id="@segment.SegmentId">@Localizer["NewVersion"]</button>
                @if (!segment.IsCriteriaFrozen)
                {
                    <a href="/CRM/Segments/Edit/@segment.SegmentId" class="btn btn-primary">@Localizer["EditSegment"]</a>
                }
            }
        </div>
    </div>

    @* ---------------------------------------------------------------- stats — only the numbers the segment actually has.
       There is no stored member count and no consumer reverse-lookup, so "Members" is filled by the on-demand resolve
       (details.js) and stays "—" until then; a fabricated "Used by" tile is deliberately NOT rendered (WP). *@
    @* Stat tiles — Tenant/VisitPlanning-Details stat-card markup (icon avatar + label + value), app-native and theme-aware. *@
    <div class="segd-stats mb-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-primary"><i class="bx bx-group"></i></span></div>
                <div><small class="text-muted d-block">@Localizer["MatchedCount"]</small><h5 class="mb-0" id="statMembersValue">—</h5></div>
            </div>
        </div>
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-info"><i class="bx bx-flag"></i></span></div>
                <div><small class="text-muted d-block">@Localizer["SegmentStatus"]</small><h5 class="mb-0">@segment.SegmentStatus</h5></div>
            </div>
        </div>
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-secondary"><i class="bx bx-git-branch"></i></span></div>
                <div><small class="text-muted d-block">@Localizer["SegmentVersion"]</small><h5 class="mb-0">v@(segment.SegmentVersion) <small class="text-muted fw-normal">@(frozen ? Localizer["Frozen"] : Localizer["Editable"])</small></h5></div>
            </div>
        </div>
    </div>

    @if (segment.Superseded)
    {
        <div class="alert alert-secondary" role="alert">
            <i class="bx bx-history me-1"></i>@Localizer["SupersededHelp"]
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-8">

            @* ------------------------------------------------ what this segment answers (reads-as + identity) *@
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2">
                        <i class="bx bx-help-circle dt-card-icon"></i>@Localizer["WhatAnswersSection"]
                    </h6>
                    <div class="segd-reads-as">
                        <div class="segd-reads-as-label">@Localizer["ReadsAs"]</div>
                        <div class="segd-reads-as-text">
                            @(isStatic ? Localizer["ReadsStatic"] : isHybrid ? Localizer["ReadsHybrid"] : Localizer["ReadsDynamic"])
                        </div>
                    </div>
                    <div class="segd-idgrid">
                        <div>
                            <div class="segd-id-label">@Localizer["SegmentCode"]</div>
                            <div class="segd-id-value segd-mono">@segment.SegmentCode</div>
                        </div>
                        <div>
                            <div class="segd-id-label">@Localizer["SubjectType"]</div>
                            <div class="segd-id-value">@segment.SubjectType</div>
                        </div>
                        <div>
                            <div class="segd-id-label">@Localizer["Description"]</div>
                            <div class="segd-id-value">@(string.IsNullOrWhiteSpace(segment.Description) ? "—" : segment.Description)</div>
                        </div>
                        <div>
                            <div class="segd-id-label">@Localizer["Notes"]</div>
                            <div class="segd-id-value">@(string.IsNullOrWhiteSpace(segment.Notes) ? "—" : segment.Notes)</div>
                        </div>
                    </div>
                </div>
            </section>

            @* ------------------------------------------------ membership rule (criteria tree + stored JSON) *@
            <section class="card mb-4">
                <div class="card-body p-4">
                    <div class="segd-crit-head">
                        <h6 class="text-uppercase text-heading fw-semibold mb-0 d-flex align-items-center gap-2">
                            <i class="bx bx-filter-alt dt-card-icon"></i>@Localizer["CriteriaSection"]
                        </h6>
                        <span class="segd-crit-controls">
                            <span class="badge bg-label-@(frozen ? "warning" : "success")">@(frozen ? Localizer["Frozen"] : Localizer["Editable"])</span>
                            @if (segment.Criteria.Count > 0)
                            {
                                <button type="button" id="btnToggleJson" class="segd-ghost-btn"
                                        data-show-label="@Localizer["ShowStoredRule"]" data-hide-label="@Localizer["HideStoredRule"]">@Localizer["ShowStoredRule"]</button>
                            }
                        </span>
                    </div>
                    <div class="segd-crit-intro">@Localizer["CriteriaHelp"]</div>

                    @if (segment.Criteria.Count == 0)
                    {
                        <div class="segd-empty">
                            <div class="segd-empty-title">@Localizer["NoCriteria"]</div>
                            <div class="segd-empty-help">@Localizer["ReadsStatic"]</div>
                        </div>
                    }
                    else
                    {
                        var byParent = segment.Criteria
                            .GroupBy(n => n.ParentNodeId ?? Guid.Empty)
                            .ToDictionary(g => g.Key, g => g.OrderBy(n => n.SortOrder).ToList());

                        @* Real nesting, ported to the mockup's rail language: a group is a bordered block carrying its
                           operator, a predicate is a light card with mono attribute/operator/value tags. Read-only. *@
                        void RenderNodes(Guid parentKey, bool topLevel)
                        {
                            if (!byParent.TryGetValue(parentKey, out var children)) { return; }
                            var index = 0;
                            foreach (var node in children)
                            {
                                if (node.NodeKind == "group")
                                {
                                    if (topLevel && index > 0)
                                    {
                                        <div class="segd-joiner">
                                            <span class="segd-joiner-line segd-joiner-line-short"></span>
                                            <span class="segd-joiner-pill">@Localizer["AndAlso"]</span>
                                            <span class="segd-joiner-line"></span>
                                        </div>
                                    }
                                    <div class="segd-group @(topLevel ? "" : "segd-group-nested")">
                                        <div class="segd-group-head">
                                            <span class="segd-group-tag">@Localizer["GroupNode"]</span>
                                            <span class="segd-group-op">@node.GroupOperator</span>
                                            @if (node.Negate)
                                            {
                                                <span class="segd-group-not">NOT</span>
                                            }
                                        </div>
                                        <div class="segd-group-body">
                                            @{ RenderNodes(node.NodeId, false); }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="segd-pred">
                                        <span class="segd-pred-human">@(string.IsNullOrWhiteSpace(node.Label) ? node.AttributeCode : node.Label)</span>
                                        <span class="segd-pred-badges">
                                            <span class="segd-tag segd-tag-attr segd-mono">@node.AttributeCode</span>
                                            <span class="segd-tag segd-tag-op segd-mono">@node.Operator</span>
                                            @if (node.Values.Count > 0)
                                            {
                                                @* A bare 36-char UUID is machine provenance, not a readable value: the human line
                                                   (node.Label) already names it, so its badge is suppressed. Reference-set / enum
                                                   values (e.g. "Cardiology") are not GUID-shaped and stay visible. *@
                                                foreach (var value in node.Values)
                                                {
                                                    if (!(value?.Length == 36 && Guid.TryParse(value, out _)))
                                                    {
                                                        <span class="segd-tag segd-tag-val segd-mono">@value</span>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <span class="segd-tag segd-tag-val segd-mono">@Localizer["NoValueNeeded"]</span>
                                            }
                                            @if (node.Negate)
                                            {
                                                <span class="segd-tag segd-tag-not segd-mono">NOT</span>
                                            }
                                        </span>
                                    </div>
                                }
                                index++;
                            }
                        }

                        <div class="segd-blocks">
                            @{ RenderNodes(Guid.Empty, true); }
                        </div>
                        <pre id="storedJson" class="segd-json-pre segd-mono segd-hidden">@criteriaJson</pre>
                    }
                </div>
            </section>

            @* ------------------------------------------------ resolve preview (SAVED /resolve, persists nothing) *@
            @if (Model.CanResolve)
            {
                <section class="card mb-4" id="resolveSection">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2">
                            <i class="bx bx-user-check dt-card-icon"></i>@Localizer["ResolvePreviewSection"]
                        </h6>
                        @* data-segment-status routes details.js: active -> /resolve (verdict/excluded); draft -> /preview
                           (SEG-C, no active state) using the subject/match-mode/criteria below. *@
                        <div id="resolvePreview" data-segment-id="@segment.SegmentId" data-endpoint="/CRM/Segments/api"
                             data-segment-status="@segment.SegmentStatus" data-subject-type="@segment.SubjectType" data-match-mode="@segment.MatchMode">
                            <script type="application/json" id="segmentPreviewCriteria">@Html.Raw(previewCriteriaJson)</script>
                            <div class="segd-resolve-head">
                                <span class="segd-resolve-headtext">
                                    <span class="segd-resolve-desc">@Localizer["ResolvePreviewHelp"]</span>
                                </span>
                                <button type="button" id="btnResolve" class="segd-btn"><i class="bx bx-refresh me-1"></i>@Localizer["RunResolve"]</button>
                            </div>

                            <div id="resolveIdle" class="segd-empty">
                                <div class="segd-empty-title">@Localizer["ResolveIdleTitle"]</div>
                                <div class="segd-empty-help">@Localizer["ResolveIdleHelp"]</div>
                            </div>

                            <div id="resolveRunning" class="segd-running segd-hidden">
                                <span class="segd-spinner"></span>
                                <span class="segd-running-text">@Localizer["ResolveRunning"]</span>
                            </div>

                            <div id="resolveResult" class="segd-hidden">
                                <div id="resolveSummary" class="segd-summary"></div>
                                <div class="segd-table">
                                    <div class="segd-thead">
                                        <span class="segd-col-person">@Localizer["SubjectDisplayName"]</span>
                                        <span class="segd-col-secondary">@Localizer["SecondaryLabel"]</span>
                                        <span class="segd-col-verdict">@Localizer["Verdict"]</span>
                                        <span class="segd-col-source">@Localizer["MembershipSource"]</span>
                                        <span class="segd-col-reasons">@Localizer["ReasonCodes"]</span>
                                    </div>
                                    <div id="resolveMembersBody"></div>
                                    <div class="segd-tfoot">
                                        <span>@Localizer["MembershipNeverStoredHelp"]</span>
                                    </div>
                                </div>

                                <div id="resolveExcluded" class="segd-excluded segd-hidden">
                                    <div class="segd-excluded-head">
                                        <span class="segd-excluded-title">@Localizer["DroppedCandidates"]</span>
                                        <span class="segd-excluded-intro">@Localizer["DroppedCandidatesIntro"]</span>
                                    </div>
                                    <div id="resolveExcludedBody"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            }

            @* ------------------------------------------------ hand-written membership (manual rows) *@
            <section class="card mb-4" id="manualMembersBlock">
                <div class="card-body p-4">
                    <div class="segd-resolve-head">
                        <div class="segd-resolve-headtext">
                            <h6 class="text-uppercase text-heading fw-semibold mb-2 d-flex align-items-center gap-2">
                                <i class="bx bx-list-plus dt-card-icon"></i>@Localizer["MembersSection"]
                            </h6>
                            <span class="segd-resolve-desc">@Localizer["MembersHelp"]</span>
                        </div>
                        <div class="segd-summary mb-0">
                            <span class="segd-chip-stat segd-chip-included"><span class="segd-chip-value" id="manualKeptIn">0</span><span class="segd-chip-label">@Localizer["KeptIn"]</span></span>
                            <span class="segd-chip-stat segd-chip-dropped"><span class="segd-chip-value" id="manualKeptOut">0</span><span class="segd-chip-label">@Localizer["KeptOut"]</span></span>
                        </div>
                    </div>
                    <div id="detailsMemberList" data-segment-id="@segment.SegmentId" data-endpoint="/CRM/Segments/api">
                        <div class="segd-table">
                            <div class="segd-thead">
                                <span class="segd-col-person">@Localizer["SubjectDisplayName"]</span>
                                <span class="segd-col-secondary">@Localizer["SecondaryLabel"]</span>
                                <span class="segd-col-mode">@Localizer["MembershipMode"]</span>
                                <span class="segd-col-reason">@Localizer["SelectionReason"]</span>
                                <span class="segd-col-from">@Localizer["EffectiveFrom"]</span>
                            </div>
                            <div id="detailsMemberBody"></div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <div class="segd-rail">

                @* ------------------------------------------ lifecycle timeline (from real lifecycle data only) *@
                <section class="card mb-4">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2">
                            <i class="bx bx-time-five dt-card-icon"></i>@Localizer["LifecycleSection"]
                        </h6>
                        <div class="segd-timeline">
                            <div class="segd-tl-item">
                                <span class="segd-tl-marker">
                                    <span class="segd-tl-dot"></span>
                                    <span class="segd-tl-line"></span>
                                </span>
                                <span class="segd-tl-body">
                                    <span class="segd-tl-title">@Localizer["TimelineCreated"]</span>
                                    <span class="segd-tl-detail">@segment.CreatedAt.ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrWhiteSpace(segment.CreatedBy) ? "" : " · " + segment.CreatedBy)</span>
                                </span>
                            </div>
                            <div class="segd-tl-item">
                                <span class="segd-tl-marker">
                                    <span class="segd-tl-dot @(segment.ActivatedAt.HasValue ? "segd-tl-dot-active" : "segd-tl-dot-pending")"></span>
                                    <span class="segd-tl-line"></span>
                                </span>
                                <span class="segd-tl-body">
                                    <span class="segd-tl-title @(segment.ActivatedAt.HasValue ? "segd-tl-title-active" : "segd-tl-title-pending")">@(segment.ActivatedAt.HasValue ? Localizer["ActivatedAt"] : Localizer["TimelineNotActivated"])</span>
                                    <span class="segd-tl-detail">
                                        @if (segment.ActivatedAt.HasValue)
                                        {
                                            @(segment.ActivatedAt.Value.ToString("yyyy-MM-dd HH:mm"))@(string.IsNullOrWhiteSpace(segment.ActivatedBy) ? "" : " · " + segment.ActivatedBy)
                                        }
                                        else
                                        {
                                            @Localizer["FrozenCriteriaHelp"]
                                        }
                                    </span>
                                </span>
                            </div>
                            @if (segment.UpdatedAt.HasValue)
                            {
                                <div class="segd-tl-item">
                                    <span class="segd-tl-marker">
                                        <span class="segd-tl-dot"></span>
                                        <span class="segd-tl-line"></span>
                                    </span>
                                    <span class="segd-tl-body">
                                        <span class="segd-tl-title">@Localizer["UpdatedAt"]</span>
                                        <span class="segd-tl-detail">@segment.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrWhiteSpace(segment.UpdatedBy) ? "" : " · " + segment.UpdatedBy)</span>
                                    </span>
                                </div>
                            }
                            <div class="segd-tl-item">
                                <span class="segd-tl-marker">
                                    <span class="segd-tl-dot"></span>
                                    @if (segment.Superseded)
                                    {
                                        <span class="segd-tl-line"></span>
                                    }
                                </span>
                                <span class="segd-tl-body">
                                    <span class="segd-tl-title">@Localizer["TimelineUsable"]</span>
                                    <span class="segd-tl-detail">@segment.EffectiveFrom.ToString("yyyy-MM-dd") → @(segment.EffectiveTo?.ToString("yyyy-MM-dd") ?? Localizer["NoEndDate"].Value)</span>
                                </span>
                            </div>
                            @if (segment.Superseded)
                            {
                                <div class="segd-tl-item">
                                    <span class="segd-tl-marker">
                                        <span class="segd-tl-dot"></span>
                                    </span>
                                    <span class="segd-tl-body">
                                        <span class="segd-tl-title">@Localizer["TimelineSupersedes"]</span>
                                        <span class="segd-tl-detail">@Localizer["SupersededHelp"]</span>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                @* ------------------------------------------ classification *@
                <section class="card mb-4">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2">
                            <i class="bx bx-category dt-card-icon"></i>@Localizer["ClassificationSection"]
                        </h6>
                        <div class="segd-class-list">
                            <div class="segd-class-row">
                                <span class="segd-class-label">@Localizer["SegmentType"]</span>
                                <span class="badge bg-label-primary">@segment.SegmentType</span>
                            </div>
                            <div class="segd-class-row">
                                <span class="segd-class-label">@Localizer["SubjectType"]</span>
                                <span class="segd-class-value">@segment.SubjectType</span>
                            </div>
                            <div class="segd-class-row">
                                <span class="segd-class-label">@Localizer["MatchMode"]</span>
                                <span class="segd-class-value">@(isStatic ? "—" : segment.MatchMode)</span>
                            </div>
                            <div class="segd-class-row">
                                <span class="segd-class-label">@Localizer["BusinessUnitId"]</span>
                                <span class="segd-class-value">@(string.IsNullOrWhiteSpace(segment.BusinessUnitId) ? "—" : segment.BusinessUnitId)</span>
                            </div>
                        </div>
                        <div class="segd-class-note">@Localizer["ClassificationNote"]</div>
                    </div>
                </section>

                @* ------------------------------------------ consumers (reverse-lookup placeholder)
                   No backend surface returns who uses this segment as their audience yet, so this card is a static
                   empty-state ONLY: it never shows a fabricated count. It fills in once that data exists (WP §7). *@
                <section class="card mb-4">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2">
                            <i class="bx bx-target-lock dt-card-icon"></i>@Localizer["ConsumersSection"]
                        </h6>
                        <div class="segd-empty">
                            <div class="segd-empty-title">@Localizer["ConsumersNoneYet"]</div>
                            <div class="segd-empty-help">@Localizer["ConsumersNote"]</div>
                        </div>
                    </div>
                </section>

                @* ------------------------------------------ how this is stored (single app card, no card-in-card) *@
                <div class="card shadow-none bg-label-primary mb-4">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@(isStatic ? Localizer["StoredNoteTitleStatic"] : Localizer["StoredNoteTitleDynamic"])</h5>
                        <p class="card-text mb-0">@(isStatic ? Localizer["StoredNoteBodyStatic"] : Localizer["StoredNoteBodyDynamic"])</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/Segments/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/Segments/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/Segments/details.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/segment-details.css" asp-append-version="true" />
}
