@model Diten.Web.Models.CRM.SegmentEditViewModel
@using Diten.Web.Views.CRM.Segments
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Text.Json
@inject IHtmlLocalizer<SegmentsIndex> Localizer
@{
    var jsonOpts = new JsonSerializerOptions(JsonSerializerDefaults.Web);

    // Business-language labels for the contract-driven vocabularies. The lists themselves stay contract-driven
    // (Model.SubjectTypes / Model.SegmentTypes); this only translates a code to a phrase, falling back to the raw
    // code for a vocabulary value we have no phrase for, so a new contract value is never silently dropped.
    Func<string, string> subjectPill = st => st switch
    {
        "contact" => Localizer["SubjectPillContact"].Value,
        "account" => Localizer["SubjectPillAccount"].Value,
        _ => st
    };
    Func<string, string> membershipTitle = t => t switch
    {
        "dynamic" => Localizer["MembershipRuleTitle"].Value,
        "static" => Localizer["MembershipListTitle"].Value,
        "hybrid" => Localizer["MembershipHybridTitle"].Value,
        _ => t
    };
    Func<string, string> membershipHelp = t => t switch
    {
        "dynamic" => Localizer["MembershipRuleHelp"].Value,
        "static" => Localizer["MembershipListHelp"].Value,
        "hybrid" => Localizer["MembershipHybridHelp"].Value,
        _ => Localizer["SegmentTypeHelp"].Value
    };
}

@* WP-SEG-A3 — the whole Create/Edit form is wrapped in `.segment-create-scope`. segment-create.css (oklch + Inter,
   distilled from the mockup) is linked ONLY here and every rule it carries is nested under that wrapper, so the palette
   and font never touch the app shell (sidebar / topbar) or any other page. Behaviour is unchanged: the same hidden
   fields, ids and data attributes below are what form.js binds to — only the look is ported to the mockup. *@
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="~/assets/css/segment-create.css" asp-append-version="true" />

<div class="segment-create-scope">

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
@if (!string.IsNullOrWhiteSpace(Model.ContractError))
{
    <div class="alert alert-danger" role="alert">@Localizer[Model.ContractError]</div>
}

<div class="seg-layout">
    <div class="seg-main">

        @* SECTION 1 — identity, the subject it groups and how membership is decided. The subject pill and the
           membership radio-cards feed the same hidden contract fields the classification card used to carry.
           Description / Notes / Business unit / Status keep round-tripping as hidden fields (the mockup shows none of
           them), so no value is ever lost while the visible form matches the mockup one-to-one. *@
        <section class="card mb-4">
            <div class="card-body p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2"><i class="bx bx-info-circle dt-card-icon" aria-hidden="true"></i>@Localizer["Section1Title"]</h6>
            <p class="card-section-desc mb-4">@Localizer["Section1Help"]</p>

            <div class="seg-grid">
                <div>
                    <label asp-for="SegmentName" class="seg-label">@Localizer["SegmentName"] <span class="seg-req">*</span></label>
                    <input asp-for="SegmentName" class="seg-input" maxlength="200" required />
                    <span asp-validation-for="SegmentName" class="text-danger small mt-1 d-block"></span>
                </div>
                <div>
                    <label asp-for="SegmentCode" class="seg-label">@Localizer["SegmentCode"] <span class="seg-req">*</span></label>
                    <input asp-for="SegmentCode" class="seg-input" readonly="@(Model.SegmentId.HasValue)" maxlength="64" required />
                    <span asp-validation-for="SegmentCode" class="text-danger small mt-1 d-block"></span>
                    <div class="seg-help">@Localizer["SegmentCodeHelp"]</div>
                </div>
            </div>

            @* Subject = a pill toggle. Immutable after create: on edit the pills are disabled and the value is carried by
               a hidden field so it is posted back rather than silently lost. The stored value is unchanged. *@
            <label class="seg-label seg-label-spaced">@Localizer["SubjectSectionLabel"] <span class="seg-req">*</span></label>
            <div class="seg-pill-row">
                @foreach (var st in Model.SubjectTypes)
                {
                    <input type="radio" class="btn-check" name="SubjectType" id="subject-@st" value="@st" autocomplete="off"
                           checked="@(Model.SubjectType == st)" disabled="@(Model.SegmentId.HasValue)" />
                    <label class="seg-pill" for="subject-@st">@subjectPill(st)</label>
                }
            </div>
            @if (Model.SegmentId.HasValue)
            {
                @* Immutable after create, so it is posted back as a hidden field (disabled pills do not post). *@
                <input type="hidden" asp-for="SubjectType" />
            }
            <div class="seg-help">@Localizer["SubjectTypeHelp"]</div>

            @* Membership = radio-cards. The chosen card IS the segment type (dynamic / static / hybrid), which decides
               which of the sections below apply — form.js mirrors the runtime's own rules. *@
            <label class="seg-label seg-label-spaced">@Localizer["MembershipSectionLabel"] <span class="seg-req">*</span></label>
            <div class="seg-cardgrid">
                @foreach (var t in Model.SegmentTypes)
                {
                    <label class="seg-radio-card" for="segtype-@t">
                        <input class="seg-radio-input" type="radio" name="SegmentType" id="segtype-@t" value="@t" checked="@(Model.SegmentType == t)" />
                        <span class="seg-radio-title"><span class="seg-radio-mark"></span>@membershipTitle(t)</span>
                        <span class="seg-radio-help">@membershipHelp(t)</span>
                    </label>
                }
            </div>

            @* Hidden round-trip fields the mockup does not surface — no data is lost. *@
            <input type="hidden" asp-for="Description" />
            <input type="hidden" asp-for="Notes" />
            <input type="hidden" asp-for="BusinessUnitId" />
            @* Match mode is DERIVED, not chosen: the blocks carry EVERY/ANY and always combine with AND ALSO, so the
               root match mode is fixed to "all". It is posted as a hidden field, so the payload is unchanged. *@
            <input type="hidden" asp-for="MatchMode" id="MatchMode" value="all" />
            </div>
        </section>

        @* SECTION 2 — the criteria block editor (D2 embedded). Hidden for a `static` segment (its membership IS the
           manual list) — form.js toggles it by segment type. Conditions inside a block combine with EVERY/ANY and the
           blocks always combine with AND ALSO. The block model maps to the exact stored tree the runtime persists
           (MatchMode=all + one group per block + predicates inside), so the posted payload is byte-identical. *@
        <section class="card mb-4" id="criteriaSection">
            <div class="card-body p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2"><i class="bx bx-filter-alt dt-card-icon" aria-hidden="true"></i>@Localizer["Section2Title"]</h6>
            <p class="card-section-desc mb-4">@Localizer["Section2Help"]</p>

            @if (Model.IsCriteriaFrozen)
            {
                <div class="seg-frozen" role="alert">
                    <span><i class="bx bx-lock-alt me-1"></i>@Localizer["FrozenCriteriaHelp"]</span>
                    @if (Model.SegmentId.HasValue)
                    {
                        <button type="button" class="seg-frozen-btn" id="btnNewVersionFromForm" data-id="@Model.SegmentId">@Localizer["NewVersion"]</button>
                    }
                </div>
            }

            @* Continuous read-back: the rule stated as a plain sentence, rebuilt on every edit. *@
            <div id="criteriaReadback" class="seg-reads-as d-none">
                <div class="seg-reads-as-label">@Localizer["ReadsAs"]</div>
                <div id="criteriaReadbackText" class="seg-reads-as-text"></div>
            </div>

            <div id="criteriaEditor"
                 data-segment-id="@Model.SegmentId"
                 data-endpoint="/CRM/Segments/api"
                 data-frozen="@(Model.IsCriteriaFrozen ? "true" : "false")"
                 data-subject-type="@Model.SubjectType"
                 data-can-pick-products="@(Model.CanPickGlobalProducts ? "true" : "false")"
                 data-max-nodes="@Model.MaxCriteriaNodes"
                 data-max-depth="@Model.MaxCriteriaDepth"
                 data-max-children="@Model.MaxChildrenPerGroup">

                @* Empty state: a headline + one-click starting points. form.js only offers a template whose attributes
                   apply to the chosen subject type; the values are still picked from the catalog by the author. *@
                <div id="criteriaEmpty" class="seg-empty d-none">
                    <div class="seg-empty-title">@Localizer["NoCriteria"]</div>
                    <div class="seg-empty-help">@Localizer["EmptyRuleHelp"]</div>
                    <div id="criteriaTemplates" class="seg-recipe-row"></div>
                </div>

                <div id="criteriaList" class="seg-blocks"></div>

                @if (!Model.IsCriteriaFrozen)
                {
                    <button type="button" id="btnAddBlock" class="seg-add-block">@Localizer["AddBlockLong"]</button>
                }
            </div>

            <div class="seg-criteria-foot">
                <span class="seg-foot-note">@Localizer["MatchModeDerivedHelp"]</span>
                <details id="storedRule" class="d-none">
                    <summary class="seg-details-summary">@Localizer["ShowStoredRule"]</summary>
                    <pre id="storedRuleJson" class="seg-json-pre mb-0"></pre>
                </details>
            </div>

            @* The tree is posted as JSON: the runtime assigns the real NodeIds and remaps the parents. *@
            <input type="hidden" asp-for="CriteriaJson" id="CriteriaJson" />
            </div>
        </section>

        @* SECTION 3 — exceptions (always-include / never-include) and the validity window. The manual sub-editor is
           embedded here; only include/exclude ever live there. It is hidden for a `dynamic` segment (which refuses
           manual rows outright) — form.js toggles ONLY the manual block, so the validity window below always shows.
           For a `static` segment this IS the membership list. *@
        <section class="card mb-4">
            <div class="card-body p-4">
            <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2"><i class="bx bx-calendar-event dt-card-icon" aria-hidden="true"></i>@Localizer["Section3Title"]</h6>
            <p class="card-section-desc mb-4">@Localizer["Section3Help"]</p>

            <div id="manualMembershipSection">
                <div class="seg-subhead">
                    <h6 class="seg-subhead-title">@Localizer["MembersSection"]</h6>
                    @if (Model.SegmentId.HasValue)
                    {
                        <button type="button" id="btnAddMember" class="seg-btn-primary"><i class="bx bx-plus me-1"></i>@Localizer["AddMember"]</button>
                    }
                </div>

                @if (!Model.SegmentId.HasValue)
                {
                    <div class="seg-inline-note"><i class="bx bx-info-circle me-1"></i>@Localizer["SaveBeforeMembers"]</div>
                }
                else
                {
                    <div id="memberEditor" data-segment-id="@Model.SegmentId" data-endpoint="/CRM/Segments/api" data-segment-type="@Model.SegmentType">
                        <div class="seg-help mb-2">@Localizer["MembersHelp"]</div>
                        <div id="memberList" class="seg-members"></div>
                        <div id="memberEmpty" class="seg-help d-none">@Localizer["NoMembers"]</div>
                    </div>
                }
            </div>

            @* Validity window (usable from / until) + read-only status. Always visible, whatever the membership. Status
               is not authored here (separate endpoint), so it round-trips as a hidden field. *@
            <div class="seg-validity">
                <div>
                    <label asp-for="EffectiveFrom" class="seg-label">@Localizer["EffectiveFrom"] <span class="seg-req">*</span></label>
                    <input asp-for="EffectiveFrom" type="text" class="seg-input flatpickr-date" value="@(Model.EffectiveFrom?.ToString("yyyy-MM-dd"))" placeholder="YYYY-MM-DD" autocomplete="off" required />
                    <span asp-validation-for="EffectiveFrom" class="text-danger small mt-1 d-block"></span>
                </div>
                <div>
                    <label asp-for="EffectiveTo" class="seg-label">@Localizer["EffectiveTo"]</label>
                    <input asp-for="EffectiveTo" type="text" class="seg-input flatpickr-date" value="@(Model.EffectiveTo?.ToString("yyyy-MM-dd"))" placeholder="YYYY-MM-DD" autocomplete="off" />
                </div>
            </div>
            <input type="hidden" asp-for="SegmentStatus" />
            </div>
        </section>
    </div>

    @* RIGHT RAIL (sticky). The live reach report (SEG-C): a debounced POST to /preview answers "who would this rule
       reach right now?" — the total, a per-condition funnel, a bounded member sample and an activation checklist. It is
       a REPORT: it persists nothing, and membership is never stored. The whole rail is one #reachSection so a static
       segment (no rule) hides it in one move. *@
    <div class="seg-rail" id="reachSection">
        <div id="reachRail" data-endpoint="/CRM/Segments/api" class="seg-rail-inner">

            <section class="card mb-4">
                <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2"><i class="bx bx-bar-chart-alt-2 dt-card-icon" aria-hidden="true"></i>@Localizer["ReachSection"]</h6>
                <div id="reachIdle" class="seg-reach-idle">@Localizer["ReachIdleHelp"]</div>
                <div id="reachContent" class="d-none">
                    <div class="seg-reach-big-row">
                        <span id="reachTotal" class="seg-reach-big">0</span>
                        <span class="seg-reach-unit">@Localizer["ReachTotalLabel"]</span>
                    </div>
                    <div id="reachCap" class="seg-reach-note d-none"></div>
                    <div id="reachFunnel" class="seg-funnel"></div>
                </div>
                <div id="reachError" class="seg-reach-error d-none"></div>
                <button type="button" id="btnPreviewSample" class="seg-preview-btn">@Localizer["PreviewSample50"]</button>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2"><i class="bx bx-user dt-card-icon" aria-hidden="true"></i>@Localizer["ReachSampleLabel"]</h6>
                <div id="reachSample" class="seg-samples"></div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2"><i class="bx bx-data dt-card-icon" aria-hidden="true"></i>@Localizer["HowStoredTitle"]</h6>
                <div class="seg-stored-body">@Localizer["MembershipNeverStoredHelp"]</div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4 d-flex align-items-center gap-2"><i class="bx bx-check-circle dt-card-icon" aria-hidden="true"></i>@Localizer["ActivationChecklist"]</h6>
                <ul class="seg-checklist" id="reachChecklistItems"></ul>
                <div class="seg-checklist-note">@Localizer["ChecklistFreezeNote"]</div>
                </div>
            </section>
        </div>
    </div>
</div>

@* Editor bootstrap. Attribute, operator and parameter lists come from the attribute-catalog endpoint at runtime -
   there is no hardcoded attribute or operator list anywhere in this page or in form.js. *@
<script id="segmentFormBootstrap" type="application/json">@Html.Raw(JsonSerializer.Serialize(new {
    segmentId = Model.SegmentId,
    subjectType = Model.SubjectType,
    segmentType = Model.SegmentType,
    isCriteriaFrozen = Model.IsCriteriaFrozen,
    canPickGlobalProducts = Model.CanPickGlobalProducts,
    availablePickers = Model.AvailablePickers,
    maxCriteriaNodes = Model.MaxCriteriaNodes,
    maxCriteriaDepth = Model.MaxCriteriaDepth,
    maxChildrenPerGroup = Model.MaxChildrenPerGroup,
    maxCandidateSet = Model.MaxCandidateSet
}, jsonOpts))</script>

@* Manual membership sub-editor. Include / exclude are the only two modes there are. *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="memberCanvas" aria-labelledby="memberCanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="memberCanvasLabel">@Localizer["AddMember"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@Localizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body">
        <div id="memberCanvasError" class="alert alert-danger d-none" role="alert"></div>
        <input type="hidden" id="memberEditId" />
        <div class="row g-3">
            @* Pick the subject from the existing Account / Contact list instead of pasting a GUID. The picker is a
               convenience only: it fills the id field below, which stays the authoritative input and can still be
               typed by hand. The runtime keeps storing the id exactly as given (D-TC). *@
            <div class="col-12" id="memberPickerBlock">
                <label class="form-label fw-medium" for="memberSubjectPicker" id="memberPickerLabel"></label>
                <select id="memberSubjectPicker" class="form-select"></select>
                <small class="text-muted" id="memberPickerHint"></small>
            </div>
            <div class="col-12">
                <label class="form-label fw-medium" for="memberSubjectId">@Localizer["SubjectId"] <span class="text-danger">*</span></label>
                <input type="text" id="memberSubjectId" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
                <small class="text-muted">@Localizer["SubjectIdHelp"]</small>
            </div>
            <div class="col-12">
                <label class="form-label fw-medium" for="memberDisplayName">@Localizer["SubjectDisplayName"]</label>
                <input type="text" id="memberDisplayName" class="form-control" maxlength="200" />
                <small class="text-muted">@Localizer["SubjectDisplayNameHelp"]</small>
            </div>
            <div class="col-12">
                <label class="form-label fw-medium" for="memberMode">@Localizer["MembershipMode"] <span class="text-danger">*</span></label>
                <select id="memberMode" class="form-select"></select>
            </div>
            <div class="col-12">
                <label class="form-label fw-medium" for="memberReason">@Localizer["SelectionReason"] <span class="text-danger">*</span></label>
                <textarea id="memberReason" class="form-control" rows="2" maxlength="1000"></textarea>
                <small class="text-muted">@Localizer["SelectionReasonHelp"]</small>
            </div>
            <div class="col-6">
                <label class="form-label fw-medium" for="memberEffectiveFrom">@Localizer["EffectiveFrom"] <span class="text-danger">*</span></label>
                <input type="text" id="memberEffectiveFrom" class="form-control flatpickr-date" placeholder="YYYY-MM-DD" autocomplete="off" />
            </div>
            <div class="col-6">
                <label class="form-label fw-medium" for="memberEffectiveTo">@Localizer["EffectiveTo"]</label>
                <input type="text" id="memberEffectiveTo" class="form-control flatpickr-date" placeholder="YYYY-MM-DD" autocomplete="off" />
            </div>
            <div class="col-12">
                <label class="form-label fw-medium" for="memberNotes">@Localizer["Notes"]</label>
                <textarea id="memberNotes" class="form-control" rows="2" maxlength="2000"></textarea>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="button" id="memberSaveBtn" class="btn btn-primary"><i class="bx bx-check me-1"></i>@Localizer["Save"]</button>
            <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@Localizer["Cancel"]</button>
        </div>
    </div>
</div>

</div>
