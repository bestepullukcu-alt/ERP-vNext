@using Diten.Web.Views.CRM.Segments
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SegmentsIndex> Localizer

<div class="card">
    <div id="segmentContractError" class="alert alert-danger rounded-0 d-none mb-0" role="alert"></div>
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
    </div>
    <div class="card-datatable table-responsive">
        <table id="dt-segments" data-dt-standard="v2" class="datatables-segments table border-top w-100">
            <thead><tr>
                <th></th>
                <th>@Localizer["SegmentCode"]</th>
                <th class="all">@Localizer["SegmentName"]</th>
                <th>@Localizer["SegmentType"]</th>
                <th>@Localizer["SubjectType"]</th>
                <th>@Localizer["SegmentStatus"]</th>
                <th>@Localizer["SegmentVersion"]</th>
                <th>@Localizer["MatchMode"]</th>
                <th>@Localizer["PredicateCount"]</th>
                <th>@Localizer["CriteriaState"]</th>
                <th>@Localizer["BusinessUnitId"]</th>
                <th>@Localizer["EffectiveFrom"]</th>
                <th>@Localizer["EffectiveTo"]</th>
                <th>@Localizer["Archived"]</th>
                <th>@Localizer["UpdatedAt"]</th>
                <th class="all text-end">@Localizer["Actions"]</th>
            </tr></thead>
        </table>
    </div>
</div>
