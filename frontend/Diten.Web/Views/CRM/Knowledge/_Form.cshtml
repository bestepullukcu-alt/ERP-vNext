@model Diten.Web.Models.CRM.KnowledgeContentEditViewModel
@using Diten.Web.Views.CRM.Knowledge
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Text.Json
@inject IHtmlLocalizer<KnowledgeIndex> Localizer
@{
    // Convenience source-system suggestions for the external-reference picker (Select2 is in tags mode — any custom value
    // is still allowed). Not a canonical vocabulary.
    var sourceSystemSuggestions = new[]
    {
        "Veeva CRM", "Salesforce", "Microsoft Dynamics", "SAP", "Oracle", "IQVIA OneKey",
        "Reltio MDM", "Informatica MDM", "Legacy CRM", "Excel/CSV Import", "Data Warehouse", "Manual Entry"
    };
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
@if (!string.IsNullOrWhiteSpace(Model.ContractError))
{
    <div class="alert alert-danger" role="alert">@Localizer[Model.ContractError]</div>
}

<div class="row g-4">
    <!-- Main Column (Left) -->
    <div class="col-12 col-lg-8">

        <section class="card mb-4">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SummarySection"]</h6>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="ContentCode" class="form-label fw-medium">@Localizer["ContentCode"] <span class="text-danger">*</span></label>
                        <input asp-for="ContentCode" class="form-control" readonly="@(Model.ContentId.HasValue)" maxlength="64" required />
                        <span asp-validation-for="ContentCode" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-8">
                        <label asp-for="ContentTitle" class="form-label fw-medium">@Localizer["ContentTitle"] <span class="text-danger">*</span></label>
                        <input asp-for="ContentTitle" class="form-control" maxlength="200" required />
                        <span asp-validation-for="ContentTitle" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="ContentType" class="form-label fw-medium">@Localizer["ContentType"] <span class="text-danger">*</span></label>
                        <select asp-for="ContentType" class="select2 form-select" required>
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var x in Model.ContentTypes) { <option value="@x">@x</option> }
                        </select>
                        <span asp-validation-for="ContentType" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="ContentStatus" class="form-label fw-medium">@Localizer["ContentStatus"] <span class="text-danger">*</span></label>
                        <select asp-for="ContentStatus" class="select2 form-select" required>
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var x in Model.ContentStatuses) { <option value="@x">@x</option> }
                        </select>
                        <span asp-validation-for="ContentStatus" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Source" class="form-label fw-medium">@Localizer["Source"] <span class="text-danger">*</span></label>
                        <select asp-for="Source" class="select2 form-select" required>
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var x in Model.ContentSources) { <option value="@x">@x</option> }
                        </select>
                        <span asp-validation-for="Source" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="LanguageCode" class="form-label fw-medium">@Localizer["LanguageCode"] <span class="text-danger">*</span></label>
                        @{
                            var languageValues = new List<string>(Model.LanguageOptions);
                            if (!string.IsNullOrWhiteSpace(Model.LanguageCode) && !languageValues.Contains(Model.LanguageCode))
                            {
                                languageValues.Insert(0, Model.LanguageCode);
                            }
                        }
                        <select asp-for="LanguageCode" class="select2 form-select" required>
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var c in languageValues) { <option value="@c">@c</option> }
                        </select>
                        <span asp-validation-for="LanguageCode" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ContentVersion" class="form-label fw-medium">@Localizer["ContentVersion"] <span class="text-danger">*</span></label>
                        <input asp-for="ContentVersion" class="form-control" maxlength="40" required />
                        <span asp-validation-for="ContentVersion" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Summary" class="form-label fw-medium">@Localizer["Summary"]</label>
                        <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ClassificationSection"]</h6>
                <div class="row g-3">
                    @{
                        var subjectValue = Model.SubjectId?.ToString() ?? string.Empty;
                        var topicValue = Model.TopicId?.ToString() ?? string.Empty;
                        var archivedTag = Localizer["Archived"].Value;
                        var topicJson = System.Text.Json.JsonSerializer.Serialize(
                            Model.TopicOptions,
                            new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
                    }
                    <div class="col-12 col-md-6">
                        <label asp-for="SubjectId" class="form-label fw-medium">@Localizer["SubjectId"] <span class="text-danger">*</span></label>
                        <select asp-for="SubjectId" class="select2 form-select" required>
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var o in Model.SubjectOptions)
                            {
                                <option value="@o.Value">@o.Label@(o.IsInactive ? $" ({archivedTag})" : "")</option>
                            }
                        </select>
                        <span asp-validation-for="SubjectId" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="TopicId" class="form-label fw-medium">@Localizer["TopicId"]</label>
                        <select asp-for="TopicId" class="select2 form-select" data-topic-cascade data-archived-label="@archivedTag" data-placeholder="@Localizer["SelectOption"].Value">
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var o in Model.TopicOptions.Where(o => o.Group == subjectValue || o.Value == topicValue))
                            {
                                <option value="@o.Value" data-subject="@o.Group">@o.Label@(o.IsInactive ? $" ({archivedTag})" : "")</option>
                            }
                        </select>
                        <script type="application/json" id="knowledgeTopicOptions">@Html.Raw(topicJson)</script>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="AudienceProfileId" class="form-label fw-medium">@Localizer["AudienceProfileId"]</label>
                        <select asp-for="AudienceProfileId" class="select2 form-select">
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var o in Model.AudienceProfileOptions) { <option value="@o.Value">@o.Label@(o.IsInactive ? $" ({archivedTag})" : "")</option> }
                        </select>
                    </div>
                    @*
                        AC-UI-3 — the concept selector is live (MOD-0162-FU03 opened the runtime this field always
                        pointed at). It is a Subject → ConceptType → ConceptNode chain: ConceptType only narrows the
                        node list and is NEVER submitted, so the FU02 form contract is unchanged — the single persisted
                        value is still KnowledgeContent.ConceptNodeId. Archived nodes are not offered; a previously
                        saved one is preserved by EnsureSelectedAsync and tagged, so saving an untouched record cannot
                        silently clear the reference (the backend V17 check is a dirty-check on this same value).
                    *@
                    @{
                        var conceptTypeValue = Model.ConceptNodeOptions
                            .FirstOrDefault(o => o.Value == (Model.ConceptNodeId?.ToString() ?? string.Empty))?.Group ?? string.Empty;
                        var conceptNodeValue = Model.ConceptNodeId?.ToString() ?? string.Empty;
                        var conceptTypeJson = System.Text.Json.JsonSerializer.Serialize(
                            Model.ConceptTypeOptions,
                            new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
                        var conceptNodeJson = System.Text.Json.JsonSerializer.Serialize(
                            Model.ConceptNodeOptions,
                            new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
                    }
                    <div class="col-12 col-md-6">
                        <label for="ConceptTypeIdFilter" class="form-label fw-medium">@Localizer["ConceptTypeId"]</label>
                        @* No name attribute on purpose: this control narrows the node list and must never be posted. *@
                        <select id="ConceptTypeIdFilter" class="select2 form-select"
                                data-concept-type-cascade data-archived-label="@archivedTag" data-placeholder="@Localizer["SelectOption"].Value">
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var o in Model.ConceptTypeOptions.Where(o => o.Group == subjectValue || o.Value == conceptTypeValue))
                            {
                                <option value="@o.Value" data-subject="@o.Group" selected="@(o.Value == conceptTypeValue)">@o.Label@(o.IsInactive ? $" ({archivedTag})" : "")</option>
                            }
                        </select>
                        <small class="text-muted">@Localizer["ConceptNodeSubjectNote"]</small>
                        <script type="application/json" id="knowledgeConceptTypeOptions">@Html.Raw(conceptTypeJson)</script>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ConceptNodeId" class="form-label fw-medium">@Localizer["ConceptNodeId"]</label>
                        <select asp-for="ConceptNodeId" class="select2 form-select"
                                data-concept-node-cascade data-archived-label="@archivedTag" data-placeholder="@Localizer["SelectOption"].Value">
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var o in Model.ConceptNodeOptions.Where(o => o.Group == conceptTypeValue || o.Value == conceptNodeValue))
                            {
                                <option value="@o.Value" data-concept-type="@o.Group">@o.Label@(o.IsInactive ? $" ({archivedTag})" : "")</option>
                            }
                        </select>
                        <span asp-validation-for="ConceptNodeId" class="text-danger small mt-1"></span>
                        <script type="application/json" id="knowledgeConceptNodeOptions">@Html.Raw(conceptNodeJson)</script>
                    </div>
                </div>
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ContentPointersSection"]</h6>

                <div class="btn-group flex-wrap mb-3" role="group" aria-label="content-source">
                    <input type="radio" class="btn-check content-source-radio" name="contentSourceType" id="cs-document" value="document" autocomplete="off">
                    <label class="btn btn-outline-primary btn-sm" for="cs-document">@Localizer["FileRef"]</label>
                    <input type="radio" class="btn-check content-source-radio" name="contentSourceType" id="cs-url" value="url" autocomplete="off">
                    <label class="btn btn-outline-primary btn-sm" for="cs-url">@Localizer["Url"]</label>
                    <input type="radio" class="btn-check content-source-radio" name="contentSourceType" id="cs-body" value="body" autocomplete="off">
                    <label class="btn btn-outline-primary btn-sm" for="cs-body">@Localizer["ContentBodyRef"]</label>
                    <input type="radio" class="btn-check content-source-radio" name="contentSourceType" id="cs-asset" value="asset" autocomplete="off">
                    <label class="btn btn-outline-primary btn-sm" for="cs-asset">@Localizer["ContentAssetRef"]</label>
                </div>

                <div class="content-pointer-field" data-source="document">
                    <label asp-for="FileRef" class="form-label fw-medium">@Localizer["FileRef"]</label>
                    <div class="d-flex gap-2 align-items-start">
                        <select asp-for="FileRef" id="FileRef" class="select2 form-select flex-grow-1" data-document-picker data-placeholder="@Localizer["SelectOption"].Value">
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var o in Model.DocumentOptions)
                            {
                                <option value="@o.Value">@o.Label@(o.IsInactive ? $" ({archivedTag})" : "")</option>
                            }
                        </select>
                        <a href="/DocumentManagementControlledDocuments" target="_blank" rel="noopener" class="btn btn-label-secondary btn-sm text-nowrap" title="@Localizer["AddReference"]">
                            <i class="bx bx-plus"></i> @Localizer["AddReference"]
                        </a>
                    </div>
                    <small class="text-muted">@Localizer["ContentPointerHelp"]</small>
                </div>

                <div class="content-pointer-field" data-source="url">
                    <label asp-for="Url" class="form-label fw-medium">@Localizer["Url"]</label>
                    <input asp-for="Url" class="form-control" placeholder="https://..." />
                </div>

                <div class="content-pointer-field" data-source="body">
                    <label asp-for="ContentBodyRef" class="form-label fw-medium">@Localizer["ContentBodyRef"]</label>
                    <input asp-for="ContentBodyRef" class="form-control" />
                </div>

                <div class="content-pointer-field" data-source="asset">
                    <label asp-for="ContentAssetRef" class="form-label fw-medium">@Localizer["ContentAssetRef"]</label>
                    <input asp-for="ContentAssetRef" class="form-control" />
                </div>
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ExternalReferencesSection"]</h6>
                <div class="card-datatable table-responsive">
                    <table id="dt-external-refs" data-dt-standard="v2" class="datatables-external-refs table border-top w-100">
                        <thead><tr>
                            <th>@Localizer["SourceSystem"]</th>
                            <th class="all">@Localizer["ExternalId"]</th>
                            <th>@Localizer["ExternalCode"]</th>
                            <th>@Localizer["ExternalName"]</th>
                            <th>@Localizer["Primary"]</th>
                            <th class="all text-end">@Localizer["Actions"]</th>
                        </tr></thead>
                    </table>
                </div>
                @* Serialized hidden inputs for model binding — rendered by form.js. *@
                <div id="externalReferencesHost" class="d-none"></div>
            </div>
        </section>
    </div>

    <!-- Sidebar Column (Right) -->
    <div class="col-12 col-lg-4">

        <section class="card mb-4">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ReferencesSection"]</h6>
                <div class="row g-3">
                    @* Brand is intentionally not surfaced in this UI. The stored KnowledgeContent.BrandId is preserved via a
                       hidden field so editing a record never wipes a previously set brand. *@
                    <input type="hidden" asp-for="BrandId" />
                    <div class="col-12">
                        <label asp-for="ProductId" class="form-label fw-medium">@Localizer["ProductId"]</label>
                        <select asp-for="ProductId" class="select2 form-select">
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var o in Model.ProductOptions) { <option value="@o.Value">@o.Label@(o.IsInactive ? $" ({archivedTag})" : "")</option> }
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="CampaignId" class="form-label fw-medium">@Localizer["CampaignId"]</label>
                        <select asp-for="CampaignId" class="select2 form-select">
                            <option value="">@Localizer["SelectOption"]</option>
                            @foreach (var o in Model.CampaignOptions) { <option value="@o.Value">@o.Label@(o.IsInactive ? $" ({archivedTag})" : "")</option> }
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="SegmentId" class="form-label fw-medium">@Localizer["SegmentId"]</label>
                        <select class="select2 form-select" disabled>
                            <option value="">@Localizer["SelectOption"]</option>
                            @if (Model.SegmentId.HasValue) { <option value="@Model.SegmentId" selected>@Model.SegmentId</option> }
                        </select>
                        <input type="hidden" asp-for="SegmentId" />
                    </div>
                </div>
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["EffectiveSection"]</h6>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="EffectiveFrom" class="form-label fw-medium">@Localizer["EffectiveFrom"] <span class="text-danger">*</span></label>
                        <input asp-for="EffectiveFrom" type="text" class="form-control flatpickr-date" value="@(Model.EffectiveFrom?.ToString("yyyy-MM-dd"))" placeholder="YYYY-MM-DD" autocomplete="off" required />
                        <span asp-validation-for="EffectiveFrom" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="EffectiveTo" class="form-label fw-medium">@Localizer["EffectiveTo"]</label>
                        <input asp-for="EffectiveTo" type="text" class="form-control flatpickr-date" value="@(Model.EffectiveTo?.ToString("yyyy-MM-dd"))" placeholder="YYYY-MM-DD" autocomplete="off" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Tags" class="form-label fw-medium">@Localizer["Tags"]</label>
                        <input asp-for="Tags" class="form-control" placeholder="@Localizer["TagsHelp"]" />
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@* Existing references seed (edit) — read by form.js to hydrate the external-references table. *@
<script id="externalRefSeed" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.ExternalReferences, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>

@* Golden Slim add canvas for one external reference. Its inputs are UNNAMED so they never post; form.js reads them,
   appends a table row + hidden named inputs into #externalReferencesHost, then closes the canvas. *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="externalRefCanvas" aria-labelledby="externalRefCanvasLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="externalRefCanvasLabel">@Localizer["AddReference"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@Localizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body">
        <div class="mb-3">
            <label class="form-label fw-medium" for="erSourceSystem">@Localizer["SourceSystem"] <span class="text-danger">*</span></label>
            <select id="erSourceSystem" class="form-select" data-placeholder="@Localizer["SourceSystem"].Value">
                <option></option>
                @foreach (var s in sourceSystemSuggestions) { <option value="@s">@s</option> }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-medium" for="erExternalId">@Localizer["ExternalId"] <span class="text-danger">*</span></label>
            <input id="erExternalId" class="form-control" maxlength="240" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-medium" for="erExternalCode">@Localizer["ExternalCode"]</label>
            <input id="erExternalCode" class="form-control" maxlength="240" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-medium" for="erExternalName">@Localizer["ExternalName"]</label>
            <input id="erExternalName" class="form-control" maxlength="400" />
        </div>
        <div class="form-check form-switch mb-4">
            <input id="erIsPrimary" class="form-check-input" type="checkbox" role="switch" />
            <label class="form-check-label ms-2" for="erIsPrimary">@Localizer["Primary"]</label>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="erSaveBtn" class="btn btn-primary"><i class="bx bx-plus me-1"></i>@Localizer["AddReference"]</button>
            <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@Localizer["Cancel"]</button>
        </div>
    </div>
</div>
