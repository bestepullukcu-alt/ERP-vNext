@model Diten.Web.Models.CRM.KnowledgeContentPageViewModel
@using Diten.Web.Views.CRM.Knowledge
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<KnowledgeIndex> Localizer
@{
    ViewData["Title"] = Localizer["ContentDetail"].Value;
    Layout = "_LayoutTenantShell";
    var c = Model.Content;
    string Show(object? value) =>
        value is null || (value is string s && string.IsNullOrWhiteSpace(s)) ? "-" : value.ToString()!;
}

<div id="knowledgeDetailsPage" class="knowledge-details" data-content-id="@c.ContentId" data-archived="@c.IsArchived.ToString().ToLowerInvariant()">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@c.ContentTitle</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/CRM/Knowledge">@Localizer["KnowledgeTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@c.ContentCode</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/CRM/Knowledge" class="btn btn-label-secondary">@Localizer["BackToList"]</a>
            @if (Model.CanManage && !c.IsArchived)
            {
                <a href="/CRM/Knowledge/Edit/@c.ContentId" class="btn btn-primary">@Localizer["EditContent"]</a>
                <button type="button" id="archiveContent" class="btn btn-label-warning" data-name="@c.ContentTitle">@Localizer["ArchiveContent"]</button>
            }
        </div>
    </div>

    @if (c.IsArchived)
    {
        <div class="alert alert-warning"><i class="bx bx-archive me-1"></i>@Localizer["ArchivedContentReadOnly"]</div>
    }

    <div class="row g-4">
        <!-- Main Column (Left) -->
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SummarySection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-purchase-tag-alt"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ContentCode"]</div>
                                <div class="backbone-preview-value mt-1">@c.ContentCode</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-category-alt"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ContentType"]</div>
                                <div class="backbone-preview-value mt-1">@Show(c.ContentType)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-check-shield"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ContentStatus"]</div>
                                <div class="mt-1"><span class="badge bg-label-primary">@c.ContentStatus</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-data"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Source"]</div>
                                <div class="backbone-preview-value mt-1">@Show(c.Source)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-globe"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["LanguageCode"]</div>
                                <div class="backbone-preview-value mt-1">@Show(c.LanguageCode)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-git-branch"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ContentVersion"]</div>
                                <div class="backbone-preview-value mt-1">@Show(c.ContentVersion)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-note"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Summary"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.Summary)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ClassificationSection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-category"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["SubjectId"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.SubjectId)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-sitemap"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["TopicId"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.TopicId)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-user-detail"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["AudienceProfileId"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.AudienceProfileId)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-network-chart"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ConceptNodeId"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.ConceptNodeId)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ContentPointersSection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-link"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Url"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.Url)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-file"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["FileRef"]</div>
                                @if (Model.DocumentRef is { } docRef)
                                {
                                    <div class="backbone-preview-value mt-1 text-break">@docRef.Title</div>
                                    <div class="mt-2 d-flex align-items-center flex-wrap gap-2">
                                        @if (docRef.HasFile)
                                        {
                                            <a href="/CRM/Knowledge/document-preview/@docRef.DocumentId" target="_blank" rel="noopener" class="btn btn-sm btn-label-primary">
                                                <i class="bx bx-show me-1"></i>@Localizer["QuickView"]
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(docRef.FileName))
                                        {
                                            <small class="text-muted">@docRef.FileName</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="backbone-preview-value mt-1 text-break">@Show(c.FileRef)</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-detail"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ContentBodyRef"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.ContentBodyRef)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-image"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ContentAssetRef"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.ContentAssetRef)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12"><small class="text-muted">@Localizer["ContentPointerHelp"]</small></div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ExternalReferencesSection"]</h6>
                @if (c.ExternalReferences.Count == 0)
                {
                    <div class="text-muted">@Localizer["NoExternalReferences"]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr>
                                <th>@Localizer["SourceSystem"]</th>
                                <th>@Localizer["ExternalId"]</th>
                                <th>@Localizer["ExternalCode"]</th>
                                <th>@Localizer["ExternalName"]</th>
                                <th>@Localizer["Primary"]</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var x in c.ExternalReferences)
                                {
                                    <tr>
                                        <td>@x.SourceSystem</td>
                                        <td>@x.ExternalId</td>
                                        <td>@Show(x.ExternalCode)</td>
                                        <td>@Show(x.ExternalName)</td>
                                        <td>@(x.IsPrimary ? Localizer["Yes"] : Localizer["No"])</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>

        <!-- Sidebar Column (Right) -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ReferencesSection"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-purchase-tag"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["BrandId"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.BrandId)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-package"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ProductId"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.ProductId)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-bullhorn"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["CampaignId"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.CampaignId)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-pie-chart-alt-2"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["SegmentId"]</div>
                                <div class="backbone-preview-value mt-1 text-break">@Show(c.SegmentId)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12"><small class="text-muted">@Localizer["ReferenceIdsOnlyHelp"]</small></div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["EffectiveSection"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar-event"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["EffectiveFrom"]</div>
                                <div class="backbone-preview-value mt-1">@c.EffectiveFrom.ToString("yyyy-MM-dd")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar-x"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["EffectiveTo"]</div>
                                <div class="backbone-preview-value mt-1">@(c.EffectiveTo?.ToString("yyyy-MM-dd") ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-tag"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Tags"]</div>
                                <div class="backbone-preview-value mt-1">@(c.Tags.Count > 0 ? string.Join(", ", c.Tags) : "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-time"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["UpdatedAt"]</div>
                                <div class="backbone-preview-value mt-1">@(c.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-archive"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Archived"]</div>
                                <div class="mt-1">
                                    @if (c.IsArchived)
                                    {
                                        <span class="badge bg-label-warning">@Localizer["Yes"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-success">@Localizer["No"]</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/CRM/Knowledge/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/Knowledge/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/Knowledge/details.js" asp-append-version="true"></script>
}
