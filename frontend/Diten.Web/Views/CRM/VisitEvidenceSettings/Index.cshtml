@model Diten.Web.Models.CRM.VisitEvidenceSettingsIndexViewModel
@using Diten.Web.Views.CRM.VisitEvidenceSettings
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitEvidenceSettingsIndex> Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutTenantShell";
    // K-TABS — the shared tab card; the exceptions tab only with an exception read key. Its corner count (in review + active
    // today) is the list read's, so the page script writes it (the same .wcn-tab-count badge the card draws for a Count).
    var tabs = new List<Diten.Web.Models.Tabs.TabCardItem>
    {
        new() { Key = "settings", Id = "ve-tab-settings", Icon = "bx-layer", Text = Localizer["TabSettings"].Value, Active = true, Controls = "ve-pane-settings" }
    };
    if (Model.CanReadExceptions)
    {
        tabs.Add(new() { Key = "exceptions", Id = "ve-tab-exceptions", Icon = "bx-time-five", Text = Localizer["TabExceptions"].Value, Controls = "ve-pane-exceptions" });
    }
    var tabCard = new Diten.Web.Models.Tabs.TabCardViewModel { AriaLabel = Localizer["PageTitle"].Value, Tabs = tabs };
    // W3E-E4R2-FIX-d (U-7, K-TABS) — the settings tab's inner panes (form · history · reps) on the SAME shared tab card,
    // a second card inside the outer tab's content (the former hand-made ve-pane-tab strip is gone).
    var paneCard = new Diten.Web.Models.Tabs.TabCardViewModel
    {
        AriaLabel = Localizer["TenantDefault"].Value,
        Tabs =
        [
            new() { Key = "form", Id = "ve-ptab-form", Icon = "bx-slider-alt", Text = Localizer["PaneForm"].Value, Active = true, Controls = "ve-pane-form" },
            new() { Key = "history", Id = "ve-ptab-history", Icon = "bx-history", Text = Localizer["PaneHistory"].Value, Controls = "ve-pane-history" },
            new() { Key = "reps", Id = "ve-ptab-reps", Icon = "bx-group", Text = Localizer["PaneReps"].Value, Controls = "ve-pane-reps" }
        ]
    };
}

@*
    WP-VW-W3 (W3-WEB-d) — the visit evidence settings (mockup "W3 Yazim Ekranlari", screens C1–C4): the tenant's "Start the
    visit" rules (form + preview + save confirm), a rep's effective rules, the change history and the time-boxed
    exceptions approved in the Work Center. WP-VW-W3L (W3-WEB-e): the scope tree holds the tenant default and its legal
    entity / business unit layers (add, remove, field-level inheritance, the source of every effective value). Every call is a
    same-origin proxy under /CRM/VisitEvidenceSettings/api/*. UAS-001: without a policy read key NOTHING but the notice.
    W3E-E4R2-FIX-b (K-STD, K-TABS): the Golden Compact header (no page breadcrumb — the layout's own one stands), the two tabs
    on the shared tab card, and the exceptions on the Golden Compact DataTable (client mode, the standard filter, quick view,
    Save View, CSV / Excel); "New exception" is that list's standard add-new action (only with the manage key).
*@
@if (!Model.CanRead)
{
    <partial name="_AccessDenied" model="@Localizer["PageTitle"].Value" />
    return;
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["PageTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<partial name="~/Views/Shared/Components/Tabs/_TabCard.cshtml" model="tabCard" />

<div id="ve-root" class="ve-page tab-content p-0"
     data-api-base="/CRM/VisitEvidenceSettings/api"
     data-can-manage-policy="@Model.CanManagePolicy.ToString().ToLowerInvariant()"
     data-can-read-exceptions="@Model.CanReadExceptions.ToString().ToLowerInvariant()"
     data-can-manage-exceptions="@Model.CanManageExceptions.ToString().ToLowerInvariant()"
     data-can-read-qr-codes="@Model.CanReadQrCodes.ToString().ToLowerInvariant()"
     data-qr-codes-url="/CRM/VisitQrCodes"
     data-me="@Model.Me">

    @* ── the settings tab ── *@
    <div class="tab-pane fade show active" id="ve-pane-settings" role="tabpanel" aria-labelledby="ve-tab-settings">
    <div class="ve-col ve-gap">
    <div class="ve-alert ve-alert-danger d-none" id="ve-save-error" role="alert">
        <span><i class="bx bx-error-circle"></i> <span id="ve-save-error-text"></span></span>
        <button type="button" class="ve-link" id="ve-save-retry">@Localizer["Retry"]</button>
    </div>
    @if (!Model.CanManagePolicy)
    {
        <div class="ve-alert ve-alert-info" id="ve-readonly"><i class="bx bx-lock-alt"></i> @Localizer["ReadOnly"]</div>
    }
    <div class="ve-alert ve-alert-danger d-none" id="ve-load-error" role="alert"></div>

    <section class="ve-settings">
        <aside class="ve-side">
            <div class="ve-card">
                <div class="ve-card-head ve-col"><span class="ve-card-title">@Localizer["ScopesTitle"]</span><span class="ve-sub">@Localizer["ScopesNote"]</span></div>
                <div class="ve-tree">
                    <button type="button" class="ve-node active" id="ve-node-tenant">
                        <span class="ve-node-icon"><i class="bx bx-buildings"></i></span>
                        <span class="ve-node-body">
                            <span class="ve-node-name">@Localizer["TenantDefault"] <i class="bx bx-lock-alt ve-mu" title="@Localizer["Locked"]"></i></span>
                            <span class="ve-node-meta" id="ve-node-meta"></span>
                            <span class="ve-node-last" id="ve-node-last"></span>
                        </span>
                    </button>
                    @* WP-VW-W3L (W3-WEB-e, C1) — the tenant's legal entity and business unit layers (the script draws them from
                       GET scopes) and, with the manage key, "Add legal entity" / "Add business unit" *@
                    <div class="ve-col ve-gap-xs" id="ve-tree-layers"></div>
                </div>
            </div>
            <div class="ve-card ve-pad ve-col">
                <span class="ve-card-title ve-row"><i class="bx bx-user-check ve-ic"></i> @Localizer["LookTitle"]</span>
                <input type="search" class="ve-input" id="ve-look-search" placeholder="@Localizer["LookSearch"]" aria-label="@Localizer["LookSearch"]" autocomplete="off" />
                <select class="ve-input" id="ve-look" aria-label="@Localizer["LookTitle"]"></select>
            </div>
        </aside>

        <div class="ve-main">
            @* C1 — a rep's effective rules *@
            <div class="ve-card d-none" id="ve-effective">
                <div class="ve-card-head">
                    <div class="ve-row"><span class="ve-avatar" id="ve-eff-initials"></span><div class="ve-col"><span class="ve-sub">@Localizer["EffectiveTitle"]</span><span class="ve-name" id="ve-eff-name"></span></div></div>
                    <button type="button" class="ve-x" id="ve-eff-close" aria-label="@Localizer["CloseButton"]"><i class="bx bx-x"></i></button>
                </div>
                @* WP-VW-W3L — the rep's chain (legal entity › business unit) and why a layer was skipped *@
                <div class="ve-col ve-gap-xs ve-m d-none" id="ve-eff-chain-box"><span class="ve-row ve-wrap" id="ve-eff-chain"></span><span class="ve-col ve-gap-xs" id="ve-eff-notes"></span></div>
                <div class="ve-alert ve-alert-warning ve-m d-none" id="ve-eff-exception"></div>
                <div class="ve-table-wrap">
                    <table class="ve-table">
                        <thead><tr><th>@Localizer["ColField"]</th><th>@Localizer["ColValue"]</th><th>@Localizer["ColSource"]</th></tr></thead>
                        <tbody id="ve-eff-rows"></tbody>
                    </table>
                </div>
                <div class="ve-foot-note"><span>@Localizer["Priority"]</span> <span class="ve-pill ve-tone-warning">@Localizer["SourceException"]</span> <i class="bx bx-chevron-right ve-flip" aria-hidden="true"></i> <span class="ve-pill ve-tone-primary">@Localizer["TypeBusinessUnit"]</span> <i class="bx bx-chevron-right ve-flip" aria-hidden="true"></i> <span class="ve-pill ve-tone-info">@Localizer["TypeLegalEntity"]</span> <i class="bx bx-chevron-right ve-flip" aria-hidden="true"></i> <span class="ve-pill ve-tone-secondary">@Localizer["SourceTenant"]</span></div>
            </div>

            @* C2 — the selected scope (the tenant, a legal entity or a business unit — WP-VW-W3L): its header, the form / history panes *@
            <div id="ve-scope">
                <div class="ve-card">
                    <div class="ve-card-head">
                        <div class="ve-row">
                            <span class="ve-scope-icon" id="ve-scope-icon"><i class="bx bx-buildings"></i></span>
                            <div class="ve-col"><span class="ve-row ve-wrap"><span class="ve-name" id="ve-scope-name">@Localizer["TenantDefault"]</span><span class="ve-pill ve-tone-secondary" id="ve-scope-type">@Localizer["TypeTenant"]</span></span><span class="ve-sub" id="ve-scope-meta"></span></div>
                        </div>
                        @* a layer only, with the manage key: archived, never deleted; its reps fall back at once (the confirm below) *@
                        <button type="button" class="ve-btn ve-btn-od ve-btn-sm d-none" id="ve-scope-remove"><i class="bx bx-trash"></i> @Localizer["ScopeRemove"]</button>
                    </div>
                </div>

                @* K-TABS — the inner panes on the shared tab card (diten-tabs.js; the page listens to diten:tab-change) *@
                <partial name="~/Views/Shared/Components/Tabs/_TabCard.cshtml" model="paneCard" />

                <div class="tab-content p-0" id="ve-scope-panes">
                <div class="tab-pane fade show active" id="ve-pane-form" role="tabpanel" aria-labelledby="ve-ptab-form">
                @* WP-VW-W3L (C2) — a layer's form: the faded fields come from above *@
                <div class="ve-alert ve-alert-info mb-3 d-none" id="ve-inherit-note"><i class="bx bx-git-merge"></i> <span id="ve-inherit-text"></span></div>
                <div class="ve-form-grid">
                    <div class="ve-col ve-gap">
                        <div id="ve-groups" class="ve-col ve-gap"></div>
                        @* WP-VW-W3E (W3E-WEB-b, E1) — "Additional evidence" (QR code, device verification) in place of the former "coming soon" card *@
                        <div id="ve-extra"></div>
                    </div>
                    <div class="ve-col ve-gap ve-sticky">
                        <div class="ve-card">
                            <div class="ve-card-head"><span class="ve-card-title ve-row"><i class="bx bx-show ve-ic"></i> @Localizer["PreviewTitle"]</span></div>
                            <div class="ve-pad ve-col ve-gap-s">
                                <div class="ve-pv">
                                    <div class="ve-pv-head"><div><div class="ve-pv-title">@Localizer["PvStartTitle"]</div><div class="ve-sub">@Localizer["PvSample"]</div></div><span class="ve-x ve-x-sm" aria-hidden="true"><i class="bx bx-x"></i></span></div>
                                    <div class="ve-pv-grid">
                                        <div class="ve-col ve-gap-xs"><span class="ve-pv-cap">@Localizer["PvPhoto"] <span class="ve-mu" id="ve-pv-photo"></span></span><div class="ve-pv-shot"><i class="bx bx-camera"></i></div></div>
                                        <div class="ve-col ve-gap-xs"><span class="ve-pv-cap">@Localizer["PvLocation"]</span><div class="ve-pv-loc"><span class="ve-pill" id="ve-pv-loc-chip"></span><span class="ve-sub" id="ve-pv-loc-text"></span></div></div>
                                    </div>
                                    @* W3E-FIX (G-5) — the institution QR code on the start window (required / optional; none when off) *@
                                    <div class="ve-pv-sign ve-pv-qr d-none" id="ve-pv-qr"><i class="bx bx-qr-scan"></i> <span class="ve-grow">@Localizer["PvQr"]</span><span class="ve-pill" id="ve-pv-qr-mode"></span></div>
                                    <div class="ve-pv-sign ve-pv-device d-none" id="ve-pv-device"><i class="bx bx-mobile-alt"></i> <span>@Localizer["PvDeviceWeb"]</span></div>
                                    <div class="ve-pv-sign d-none" id="ve-pv-sign"><i class="bx bx-pen"></i> @Localizer["PvSign"]</div>
                                    <div class="ve-pv-foot"><span class="ve-btn ve-btn-p ve-btn-sm" id="ve-pv-start"><i class="bx bx-play"></i> @Localizer["PvStart"]</span></div>
                                </div>
                                <ul class="ve-pv-lines" id="ve-pv-lines"></ul>
                            </div>
                        </div>
                        <div class="ve-card ve-pad ve-col ve-gap-s">
                            <div class="ve-row"><span class="ve-avatar ve-avatar-sm" id="ve-last-initials"></span><div class="ve-col"><span class="ve-sub">@Localizer["LastChange"]</span><span class="ve-strong" id="ve-last-by"></span></div></div>
                            <div class="ve-unsaved d-none" id="ve-unsaved"><i class="bx bx-edit-alt"></i> @Localizer["Unsaved"]</div>
                            <div class="ve-hint d-none" id="ve-layer-empty"><i class="bx bx-info-circle"></i> <span id="ve-layer-empty-text"></span></div>
                            @* read-only: the bar stays hidden (the script shows it only with crm.visit-evidence-policy.manage) *@
                            <div class="ve-row ve-end d-none" id="ve-save-bar">
                                <button type="button" class="ve-btn ve-btn-s" id="ve-revert" disabled>@Localizer["CancelButton"]</button>
                                <button type="button" class="ve-btn ve-btn-p" id="ve-save" data-dt-primary="enter" disabled>@Localizer["SaveButton"]</button>
                            </div>
                        </div>
                    </div>
                </div>
                </div>

                @* C3 — the change history (append-only): the Golden Compact DataTable, server mode (W3E-E4R2-FIX-d) *@
                <div class="tab-pane fade" id="ve-pane-history" role="tabpanel" aria-labelledby="ve-ptab-history">
                    <div class="ve-pane-note"><span class="ve-card-title">@Localizer["HistoryTitle"]</span><span class="ve-sub ve-row"><i class="bx bx-lock-alt"></i> @Localizer["AuditReadOnly"]</span></div>
                    @* WP-VW-W3L — the scope filter (follows the selected scope; "every scope" reads the whole history) *@
                    <div class="ve-history-filter mb-3">
                        <label class="form-label fw-medium" for="ve-history-scope">@Localizer["HistScopeFilter"]</label>
                        <div class="diten-field">
                            <i class="bx bx-layer diten-field-icon" aria-hidden="true"></i>
                            <select class="form-select" id="ve-history-scope"></select>
                        </div>
                    </div>
                    <partial name="~/Views/CRM/VisitEvidenceSettings/_HistoryTable.cshtml" />
                </div>

                @* WP-VW-W3E (W3E-WEB-b, E3) — the reps and their effective location / photo / QR / device values: the Golden
                   Compact DataTable, server mode (the CRM's paged roster with its total — W3E-E4R2-FIX-d) *@
                <div class="tab-pane fade" id="ve-pane-reps" role="tabpanel" aria-labelledby="ve-ptab-reps">
                    <div class="ve-pane-note"><span class="ve-card-title">@Localizer["RepsTitle"]</span><span class="ve-sub">@Localizer["RepsNote"]</span></div>
                    <partial name="~/Views/CRM/VisitEvidenceSettings/_RepsTable.cshtml" />
                </div>
                </div>
            </div>
        </div>
    </section>
    </div>
    </div>

    @* ── C4 — the time-boxed exceptions: the Golden Compact list (client mode) ── *@
    @if (Model.CanReadExceptions)
    {
        <div class="tab-pane fade" id="ve-pane-exceptions" role="tabpanel" aria-labelledby="ve-tab-exceptions">
            <div class="ve-alert ve-alert-info mb-3"><i class="bx bx-info-circle"></i> @Localizer["ExceptionsInfo"]</div>

            @* ① Inline Filter partial *@
            @* Contract marker: <partial name="_Filter" /> *@
            <partial name="~/Views/CRM/VisitEvidenceSettings/_Filter.cshtml" />

            @* ③ DataTable Card *@
            @* Contract markers are rendered by _DataTable.cshtml: the shared <partial name="_TableSkeleton" /> (which carries id="skeleton-loader"), <table id="dt-visitevidenceexceptions" data-dt-standard="v2"> *@
            <partial name="~/Views/CRM/VisitEvidenceSettings/_DataTable.cshtml" />
        </div>
    }
</div>

@* ── the save confirm (fark satırları, "N temsilciye uygulanır") ── *@
<div class="modal fade ve-modal" id="ve-save-modal" tabindex="-1" aria-labelledby="ve-save-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="ve-dlg">
                <div class="ve-row ve-top"><span class="ve-dlg-icon"><i class="bx bx-error"></i></span><div class="ve-col"><h5 class="ve-dlg-title" id="ve-save-title">@Localizer["SaveTitle"]</h5><span class="ve-sub" id="ve-save-text"></span></div></div>
                <div class="ve-diff" id="ve-save-diff"></div>
                <div class="ve-row ve-end">
                    <button type="button" class="ve-btn ve-btn-s" data-bs-dismiss="modal">@Localizer["CancelButton"]</button>
                    <button type="button" class="ve-btn ve-btn-p" id="ve-save-confirm" data-dt-primary="chord">@Localizer["SaveConfirm"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── WP-VW-W3L (C2) — "Remove the scope": not irreversible (the layer is archived, the history keeps it) but at once in
   effect for every rep of the scope, so Ctrl / ⌘ + Enter only (UXH-001 §3: chord) ── *@
<div class="modal fade ve-modal" id="ve-rm-modal" tabindex="-1" aria-labelledby="ve-rm-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="ve-dlg">
                <div class="ve-row ve-top"><span class="ve-dlg-icon ve-dlg-icon-danger"><i class="bx bx-trash"></i></span><div class="ve-col"><h5 class="ve-dlg-title" id="ve-rm-title">@Localizer["RemoveTitle"]</h5><span class="ve-sub" id="ve-rm-text"></span></div></div>
                <div class="ve-alert ve-alert-danger d-none" id="ve-rm-error" role="alert"></div>
                <div class="ve-row ve-end">
                    <button type="button" class="ve-btn ve-btn-s" data-bs-dismiss="modal">@Localizer["CancelButton"]</button>
                    <button type="button" class="ve-btn ve-btn-d" id="ve-rm-confirm" data-dt-primary="chord">@Localizer["ScopeRemove"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── WP-VW-W3L (C1) — "Add legal entity" / "Add business unit": the pick only opens an empty scope on the page (nothing is
   written until its first save), so Enter (UXH-001 §3) ── *@
<div class="modal fade ve-modal" id="ve-add-modal" tabindex="-1" aria-labelledby="ve-add-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="ve-dlg">
                <div class="ve-row ve-top"><span class="ve-dlg-icon ve-dlg-icon-primary"><i class="bx bx-plus"></i></span><div class="ve-col"><h5 class="ve-dlg-title" id="ve-add-title"></h5><span class="ve-sub">@Localizer["AddDescription"]</span></div></div>
                <div>
                    <label class="form-label fw-medium" for="ve-add-pick" id="ve-add-label"></label>
                    <div class="diten-field">
                        <i class="bx bx-search diten-field-icon" aria-hidden="true"></i>
                        <select class="form-select" id="ve-add-pick"></select>
                    </div>
                    <span class="ve-sub d-none" id="ve-add-none"></span>
                </div>
                <div class="ve-row ve-end">
                    <button type="button" class="ve-btn ve-btn-s" data-bs-dismiss="modal">@Localizer["CancelButton"]</button>
                    <button type="button" class="ve-btn ve-btn-p" id="ve-add-confirm" data-dt-primary="enter" disabled>@Localizer["AddConfirm"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── the new exception drawer ── *@
<div class="offcanvas offcanvas-end ve-drawer" tabindex="-1" id="ve-new-drawer" aria-labelledby="ve-new-title">
    <div class="ve-drawer-head"><h5 class="ve-dlg-title" id="ve-new-title">@Localizer["XNewTitle"]</h5><button type="button" class="ve-x" data-bs-dismiss="offcanvas" aria-label="@Localizer["CloseButton"]"><i class="bx bx-x"></i></button></div>
    <div class="offcanvas-body ve-col ve-gap">
        <div class="ve-field">
            <label class="ve-label" for="ve-nx-rep">@Localizer["XRep"] <span class="ve-req">*</span></label>
            <input type="search" class="ve-input" id="ve-nx-rep-search" placeholder="@Localizer["LookSearch"]" aria-label="@Localizer["LookSearch"]" autocomplete="off" />
            <select class="ve-input" id="ve-nx-rep"></select>
            <span class="ve-err d-none" id="ve-nx-err-rep"></span>
        </div>
        <div class="ve-field">
            <span class="ve-label">@Localizer["XRules"] <span class="ve-req">*</span></span>
            <div class="ve-col ve-gap-xs" id="ve-nx-rules"></div>
            <span class="ve-err d-none" id="ve-nx-err-rules"></span>
            <span class="ve-hint"><i class="bx bx-info-circle"></i> @Localizer["XRulesHint"]</span>
        </div>
        <div class="ve-two">
            <div class="ve-field"><label class="ve-label" for="ve-nx-from">@Localizer["XFrom"] <span class="ve-req">*</span></label><input type="date" class="ve-input" id="ve-nx-from" /><span class="ve-err d-none" id="ve-nx-err-from"></span></div>
            <div class="ve-field"><label class="ve-label" for="ve-nx-to">@Localizer["XTo"] <span class="ve-req">*</span></label><input type="date" class="ve-input" id="ve-nx-to" /><span class="ve-err d-none" id="ve-nx-err-to"></span></div>
        </div>
        <span class="ve-sub" id="ve-nx-days"></span>
        <div class="ve-field">
            <div class="ve-row ve-between"><label class="ve-label" for="ve-nx-why">@Localizer["XReason"] <span class="ve-req">*</span></label><span class="ve-sub" id="ve-nx-why-count"></span></div>
            <textarea class="ve-input ve-textarea" id="ve-nx-why" rows="4" placeholder="@Localizer["XReasonPlaceholder"]"></textarea>
            <span class="ve-err d-none" id="ve-nx-err-why"></span>
        </div>
        <div class="ve-alert ve-alert-warning"><i class="bx bx-user-x"></i> @Localizer["XSodNew"]</div>
        <div class="ve-alert ve-alert-danger d-none" id="ve-nx-error" role="alert"></div>
    </div>
    <div class="ve-drawer-foot">
        <button type="button" class="ve-btn ve-btn-s" data-bs-dismiss="offcanvas">@Localizer["CloseButton"]</button>
        <button type="button" class="ve-btn ve-btn-p" id="ve-nx-submit" data-dt-primary="chord"><i class="bx bx-send"></i> @Localizer["XSubmit"]</button>
    </div>
</div>

@* ④ Quick view — the standard offcanvas: the exception's detail (the timeline) and its Workflow actions (submit / withdraw /
   approve / return / cancel / end early by the CRM abilities and SoD), read once per open *@
<div class="offcanvas offcanvas-end ve-drawer" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="oc-title">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center">
            <div class="avatar avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                <i class="bx bx-time-five fs-4"></i>
            </div>
            <div>
                <h5 id="oc-title" class="offcanvas-title mb-0">@Localizer["XDetailTitle"]</h5>
                <small id="oc-subtitle" class="text-muted d-block">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@Localizer["CloseButton"]"></button>
    </div>
    <div class="offcanvas-body ve-col ve-gap" id="oc-details-list"></div>
    <div class="offcanvas-footer border-top ve-drawer-foot" id="oc-actions"></div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/js/CRM/VisitEvidenceSettings/visit-evidence-settings.css" asp-append-version="true" />
}

@section Scripts {
