@model Diten.Web.Models.CRM.VisitNotificationsViewModel
@using Diten.Web.Views.CRM.VisitNotifications
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitNotificationsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutTenantShell";
    Context.Items["NavActivePath"] = "/CRM/VisitNotifications";
    var tabCard = new Diten.Web.Models.Tabs.TabCardViewModel
    {
        AriaLabel = Localizer["PageTitle"].Value,
        Tabs =
        [
            new Diten.Web.Models.Tabs.TabCardItem { Key = "list", Id = "vn-tab-list", Icon = "bx-envelope", Text = Localizer["TabList"].Value, Active = true, Controls = "vn-pane-list" },
            new Diten.Web.Models.Tabs.TabCardItem { Key = "settings", Id = "vn-tab-settings", Icon = "bx-cog", Text = Localizer["TabSettings"].Value, Controls = "vn-pane-settings" }
        ]
    };
}

@*
    WP-VW-W5 · W5-WEB — the sent visit e-mails (mockup 06-epostalar) on the Golden Compact LIST STANDARD: the inline filter
    (period on the visit day · event · status · rep) → the list header → the server-mode table (the CRM pages the e-mails,
    newest first) → the quick view = the e-mail preview (06: To / Cc / Date, the band, the rows, the KVKK footer). The
    recipients are ROLES and the rep's name, never an address. The second tab (the shared K-TABS card) is the notification
    settings card — rendered ONLY for crm.visit-notifications.settings.manage (no tab, no card, no script otherwise).
    UAS-001: without a read key NOTHING but the notice.
*@
@if (!Model.CanRead)
{
    <partial name="_AccessDenied" model="@Localizer["PageTitle"].Value" />
    return;
}

@* ① Inline Filter partial *@
@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/CRM/VisitNotifications/_Filter.cshtml" model="Model" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["PageTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="vn-root" class="d-none"
     data-can-manage="@Model.CanManageSettings.ToString().ToLowerInvariant()"></div>

@if (Model.CanManageSettings)
{
    @* K-TABS — the shared tab card; the selected tab is not part of Save View *@
    <partial name="~/Views/Shared/Components/Tabs/_TabCard.cshtml" model="tabCard" />
}

<div class="tab-content p-0 vn-tab-content">
    <div class="tab-pane fade show active" id="vn-pane-list" role="tabpanel" aria-labelledby="vn-tab-list">
        @* Contract markers are rendered by _DataTable.cshtml: the shared <partial name="_TableSkeleton" /> (which carries id="skeleton-loader"), <table id="dt-visitnotifications" data-dt-standard="v2"> *@
        <partial name="~/Views/CRM/VisitNotifications/_DataTable.cshtml" />
    </div>

    @if (Model.CanManageSettings)
    {
        <div class="tab-pane fade" id="vn-pane-settings" role="tabpanel" aria-labelledby="vn-tab-settings">
            <partial name="~/Views/CRM/VisitNotifications/_SettingsCard.cshtml" />
        </div>
    }
</div>

@* ④ Quick view — the standard offcanvas: the e-mail preview, read once per open *@
<div class="offcanvas offcanvas-end vn-drawer" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="oc-title">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center">
            <div class="avatar avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                <i class="bx bx-envelope fs-4"></i>
            </div>
            <div>
                <h5 id="oc-title" class="offcanvas-title mb-0">@Localizer["DrawerTitle"]</h5>
                <small id="oc-subtitle" class="text-muted d-block">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@Localizer["CloseButton"]"></button>
    </div>
    <div class="offcanvas-body flex-grow-1 p-0">
        <div class="d-flex flex-column" id="oc-details-list"></div>
    </div>
    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary flex-grow-1" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <a id="oc-btn-edit" href="#" class="btn btn-primary flex-grow-1 d-none"></a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/js/CRM/VisitNotifications/visit-notifications.css" asp-append-version="true" />
}

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/VisitNotifications/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/VisitNotifications/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitPlanning/format.js" asp-append-version="true"></script>
    <script src="~/assets/js/shared/diten-datefield.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitNotifications/notifications-core.js" asp-append-version="true"></script>
    @if (Model.CanManageSettings)
    {
        <script src="~/assets/js/diten-tabs.js" asp-append-version="true"></script>
        <script src="~/assets/js/CRM/VisitNotifications/settings.js" asp-append-version="true"></script>
    }
    <script src="~/assets/js/CRM/VisitNotifications/index.js" asp-append-version="true"></script>
}
