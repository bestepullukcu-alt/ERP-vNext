@using Diten.Web.Views.CRM.StrategyTemplates
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<StrategyTemplatesIndex> Localizer

<div class="card">
    <div id="strategyTemplateContractError" class="alert alert-danger rounded-0 d-none mb-0" role="alert"></div>
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
    </div>
    <div class="card-datatable table-responsive">
        <table id="dt-strategy-templates" data-dt-standard="v2" class="datatables-strategy-templates table border-top w-100">
            <thead><tr>
                <th></th>
                <th>@Localizer["TemplateCode"]</th>
                <th class="all">@Localizer["TemplateName"]</th>
                <th>@Localizer["SubjectType"]</th>
                <th>@Localizer["TemplateStatus"]</th>
                <th>@Localizer["TemplateVersion"]</th>
                <th>@Localizer["SegmentBindingCount"]</th>
                <th>@Localizer["FrequencyIntentMode"]</th>
                <th>@Localizer["ProductLineCount"]</th>
                <th>@Localizer["ContentBindingCount"]</th>
                <th>@Localizer["BindingState"]</th>
                <th>@Localizer["BusinessUnitId"]</th>
                <th>@Localizer["EffectiveFrom"]</th>
                <th>@Localizer["EffectiveTo"]</th>
                <th>@Localizer["Archived"]</th>
                <th>@Localizer["UpdatedAt"]</th>
                <th class="all text-end">@Localizer["Actions"]</th>
            </tr></thead>
        </table>
    </div>
</div>
