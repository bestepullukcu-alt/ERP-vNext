@model Diten.Web.Models.CRM.StrategyTemplateEditViewModel
@using Diten.Web.Views.CRM.StrategyTemplates
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Text.Json
@inject IHtmlLocalizer<StrategyTemplatesIndex> Localizer
@{
    var jsonOpts = new JsonSerializerOptions(JsonSerializerDefaults.Web);

    // WP-ST-EDIT-D — Kimlik başlığı badge'leri DISPLAY-only: durum ve sürüm doğrudan Model'den okunur,
    // form alanı değildir. Durum etiketi mevcut yaşam-döngüsü L10n anahtarları ile eşlenir (yeni anahtar yok).
    var identityStatusKey = (Model.TemplateStatus ?? "draft").ToLowerInvariant();
    var identityStatusLabel = identityStatusKey switch
    {
        "active" => Localizer["Active"],
        "inactive" => Localizer["Passive"],
        "archived" => Localizer["Archived"],
        _ => Localizer["LifecycleDraftTab"]
    };
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
@if (!string.IsNullOrWhiteSpace(Model.ContractError))
{
    <div class="alert alert-danger" role="alert">@Localizer[Model.ContractError]</div>
}

<div class="row g-4">
    <div class="col-12">

        @* WP-ST-EDIT-C — SubjectType is DERIVED, not chosen: a hidden field the segment binding builder fills from the
           first bound segment on create, and that keeps its immutable value on edit. The backend still requires it and
           still enforces one homogeneous type. TemplateStatus is DISPLAY-only (shown as tabs in the right panel) and is
           posted back unchanged so the update flow is untouched. Both cards that used to render these controls were
           removed; the Geçerlilik dates moved to the right panel's YAŞAM DÖNGÜSÜ card. *@
        <input type="hidden" asp-for="SubjectType" />
        <input type="hidden" asp-for="TemplateStatus" />

        <section class="card mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["IdentitySection"]</h6>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-label-secondary">@identityStatusLabel</span>
                        <span class="badge bg-label-secondary">v@(Model.TemplateVersion)</span>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="TemplateCode" class="form-label fw-medium">@Localizer["TemplateCode"] <span class="text-danger">*</span></label>
                        <input asp-for="TemplateCode" class="form-control" readonly="@(Model.TemplateId.HasValue)" maxlength="64" required />
                        <span asp-validation-for="TemplateCode" class="text-danger small mt-1"></span>
                        <small class="text-muted">@Localizer["TemplateCodeHelp"]</small>
                    </div>
                    <div class="col-12 col-md-8">
                        <label asp-for="TemplateName" class="form-label fw-medium">@Localizer["TemplateName"] <span class="text-danger">*</span></label>
                        <input asp-for="TemplateName" class="form-control" maxlength="200" required />
                        <span asp-validation-for="TemplateName" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-medium">@Localizer["Description"]</label>
                        <textarea asp-for="Description" class="form-control" rows="3" maxlength="2000" placeholder="@Localizer["DescriptionPlaceholder"]"></textarea>
                    </div>
                    @* WP-ST-EDIT-D — Notlar alanı Kimlik kartından kaldırıldı; ancak değer edit'te kaybolmasın diye
                       hidden olarak POST edilir (TemplateStatus deseniyle aynı). Notes VM property'si korunur. *@
                    <input type="hidden" asp-for="Notes" />
                </div>
            </div>
        </section>

        @*
            KAPSAM — NEREDE (WP-ST-EDIT-A). A mirror of the Campaign scope section: the play's address level plus the
            cascading reference (Country → Legal entity → Business unit / Territory). Unlike a cycle period's scope this
            one is EDITABLE — a play's address is an attribute, not its identity. Exactly ONE reference is posted
            (single-reference); the JS clears the others and the runtime refuses a second one regardless. The
            scope-options feed is loaded client-side from the same-origin proxy, exactly as the Campaign form does.
        *@
        <section class="card mb-4">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ScopeSection"]</h6>
                <div class="row g-3" id="strategyTemplateScopeSection"
                     data-scope-options-url="/CRM/StrategyTemplates/api/scope-options">
                    @* WP-ST-EDIT-E — the scope LEVEL is chosen with a segmented button group, not a dropdown. The value
                       still posts through a hidden #scopeType input (asp-for="ScopeType"), so the backend, the cascade
                       and the single-reference invariant are unchanged; form.js builds the buttons and drives that
                       hidden input on click. *@
                    <div class="col-12">
                        <label asp-for="ScopeType" class="form-label fw-medium">
                            @Localizer["ScopeType"] <span class="text-danger">*</span>
                        </label>
                        <input type="hidden" asp-for="ScopeType" id="scopeType" data-selected="@Model.ScopeType" />
                        <div class="st-scope-types" id="scopeTypeButtons" role="group"
                             aria-label="@Localizer["ScopeType"]"></div>
                        <div class="form-text">@Localizer["ScopeEditableHint"]</div>
                    </div>

                    @* Exactly ONE reference block is visible at a time — the address is discriminated, never combined. *@
                    <div class="col-12 col-md-4 d-none" data-scope-block="country">
                        <label asp-for="CountryScope" class="form-label fw-medium">@Localizer["CountryScope"]</label>
                        <select asp-for="CountryScope" id="countryScope" class="form-select"
                                data-selected="@Model.CountryScope"></select>
                        <div class="form-text d-none" data-scope-note="country"></div>
                    </div>

                    <div class="col-12 col-md-4 d-none" data-scope-block="legal-entity">
                        <label asp-for="LegalEntityId" class="form-label fw-medium">@Localizer["LegalEntity"]</label>
                        <select asp-for="LegalEntityId" id="legalEntityId" class="form-select"
                                data-selected="@(Model.LegalEntityId?.ToString())"></select>
                        <div class="form-text d-none" data-scope-note="legal-entity"></div>
                    </div>

                    @* Business unit is a country-first cascade: the country filter narrows the list to the units the
                       tenant's territory plans actually cover. The filter is NOT the play's scope and is never posted. *@
                    <div class="col-12 col-md-4 d-none" data-scope-block="business-unit">
                        <label asp-for="BusinessUnitCountryFilter" class="form-label fw-medium">
                            @Localizer["BusinessUnitCountryFilter"]
                        </label>
                        <select asp-for="BusinessUnitCountryFilter" id="buFilterCountry" class="form-select mb-3"
                                data-selected="@Model.BusinessUnitCountryFilter"></select>

                        <label asp-for="BusinessUnitId" class="form-label fw-medium">@Localizer["BusinessUnit"]</label>
                        <select asp-for="BusinessUnitId" id="businessUnitId" class="form-select"
                                data-selected="@Model.BusinessUnitId"></select>
                        <div class="form-text d-none" data-scope-note="business-unit"></div>
                    </div>

                    <div class="col-12">
                        @* WP-ST-EDIT-E — ÇÖZÜMLENEN KAPSAM: an always-visible bordered box (bg-body). form.js paints the
                           mono label + the resolved value (danger "henüz çözümlenmedi" when empty, breadcrumb when set). *@
                        <div class="st-resolved-scope" id="resolvedScope"></div>
                        <div class="form-text">@Localizer["ScopeHelp"]</div>
                    </div>
                </div>
            </div>
        </section>

        @if (Model.AreBindingsFrozen)
        {
            <div class="alert alert-warning" role="alert">
                <i class="bx bx-lock-alt me-1"></i>@Localizer["FrozenBindingsHelp"]
                @if (Model.TemplateId.HasValue)
                {
                    <button type="button" class="btn btn-sm btn-label-warning ms-2" id="btnNewVersionFromForm" data-id="@Model.TemplateId">@Localizer["NewVersion"]</button>
                }
            </div>
        }

        @* BINDING 1 — "who". Embedded repeater; a play with no segment is not authorable. *@
        <section class="card mb-4" id="segmentBindingSection">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["SegmentSection"] <span class="text-danger">*</span></h6>
                    <button type="button" id="btnAddSegmentBinding" class="btn btn-sm btn-primary"><i class="bx bx-plus me-1"></i>@Localizer["AddSegmentBinding"]</button>
                </div>
                <small class="text-muted d-block mb-3">@Localizer["SegmentBindingHelp"]</small>
                <div id="segmentBindingList" class="d-flex flex-column gap-2"></div>
                <div id="segmentBindingEmpty" class="text-muted d-none">@Localizer["NoSegmentBindings"]</div>
                <input type="hidden" asp-for="SegmentBindingsJson" id="SegmentBindingsJson" />
            </div>
        </section>

        @* BINDING 2 — "how often". Three shapes, none of which writes a MOD-0165 policy. *@
        <section class="card mb-4" id="frequencySection">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-3">@Localizer["FrequencySection"]</h6>
                <small class="text-muted d-block mb-3">@Localizer["FrequencyIntentHelp"]</small>
                @* WP-ST-EDIT-B — frequency is a POINTER only: the real cadence lives in the Visit Frequency Policies
                   module (MOD-0165). This info-box states that and links out; the frequency FIELD logic is unchanged. *@
                <div class="st-freq-info" role="note">
                    <span class="st-freq-info-dot" aria-hidden="true"></span>
                    <div class="st-freq-info-body">
                        <span class="st-freq-info-strong">@Localizer["FreqInfoStrong"]</span><span class="st-freq-info-text">@Localizer["FreqInfoBody"]</span>
                        <a href="/CRM/VisitFrequencyPolicies" class="st-freq-info-link" target="_blank" rel="noopener">@Localizer["FreqInfoLink"]</a>
                    </div>
                </div>
                <div class="row g-3" id="frequencyEditor">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-medium" for="frequencyMode">@Localizer["FrequencyIntentMode"] <span class="text-danger">*</span></label>
                        <select id="frequencyMode" class="form-select"></select>
                    </div>
                    <div class="col-12 col-md-8 d-none" id="frequencyPolicyBlock">
                        <label class="form-label fw-medium" for="frequencyPolicyId">@Localizer["FrequencyPolicy"] <span class="text-danger">*</span></label>
                        <select id="frequencyPolicyId" class="form-select"></select>
                    </div>
                    <div class="col-12 col-md-4 d-none frequency-declared">
                        <label class="form-label fw-medium" for="frequencyType">@Localizer["FrequencyType"] <span class="text-danger">*</span></label>
                        <select id="frequencyType" class="form-select"></select>
                    </div>
                    <div class="col-6 col-md-2 d-none frequency-declared">
                        <label class="form-label fw-medium" for="requiredVisitCount">@Localizer["RequiredVisitCount"] <span class="text-danger">*</span></label>
                        <input type="number" id="requiredVisitCount" class="form-control" min="1" max="365" />
                    </div>
                    <div class="col-6 col-md-3 d-none frequency-declared">
                        <label class="form-label fw-medium" for="periodType">@Localizer["PeriodType"] <span class="text-danger">*</span></label>
                        <select id="periodType" class="form-select"></select>
                    </div>
                    <div class="col-12 d-none frequency-declared">
                        <div class="alert alert-secondary mb-0 py-2 small">
                            <i class="bx bx-info-circle me-1"></i>@Localizer["DeclaredIntentNotBindingHelp"]
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-medium" for="intentNote">@Localizer["IntentNote"]</label>
                        <textarea id="intentNote" class="form-control" rows="2" maxlength="1000"></textarea>
                    </div>
                </div>
                <input type="hidden" asp-for="FrequencyIntentJson" id="FrequencyIntentJson" />
            </div>
        </section>

        @* BINDING 3 — "what". Product lines with the SKU split; the live total is a display only, the runtime decides. *@
        <section class="card mb-4" id="productSection">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["ProductSection"]</h6>
                    <button type="button" id="btnAddProductLine" class="btn btn-sm btn-primary"><i class="bx bx-plus me-1"></i>@Localizer["AddProductLine"]</button>
                </div>
                <small class="text-muted d-block mb-2">@Localizer["TotalMustBe100"]</small>
                <div class="alert alert-secondary py-2 small" role="alert">
                    <i class="bx bx-info-circle me-1"></i>@Localizer["ContainmentNotVerifiedHelp"]
                </div>
                <div id="productLineList" class="d-flex flex-column gap-3"></div>
                <div id="productLineEmpty" class="text-muted d-none">@Localizer["NoProductLines"]</div>
                <input type="hidden" asp-for="ProductLinesJson" id="ProductLinesJson" />
            </div>
        </section>

        @* BINDING 4 — "which story". Typed and published-only. *@
        <section class="card mb-4" id="contentSection">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["ContentSection"]</h6>
                    <button type="button" id="btnAddContentBinding" class="btn btn-sm btn-primary"><i class="bx bx-plus me-1"></i>@Localizer["AddContentBinding"]</button>
                </div>
                <small class="text-muted d-block mb-3">@Localizer["ContentPublishedOnlyHelp"]</small>
                <div id="contentBindingList" class="d-flex flex-column gap-2"></div>
                <div id="contentBindingEmpty" class="text-muted d-none">@Localizer["NoContentBindings"]</div>
                <input type="hidden" asp-for="ContentBindingsJson" id="ContentBindingsJson" />
            </div>
        </section>
    </div>
</div>

@* Editor bootstrap. Every vocabulary, limit and picker availability comes from the contract endpoint at runtime -
   there is no hardcoded status, mode or frequency list anywhere in this page or in form.js. *@
<script id="strategyTemplateFormBootstrap" type="application/json">@Html.Raw(JsonSerializer.Serialize(new {
    templateId = Model.TemplateId,
    subjectType = Model.SubjectType,
    areBindingsFrozen = Model.AreBindingsFrozen,
    endpoint = "/CRM/StrategyTemplates/api",
    bindingRoles = Model.BindingRoles,
    frequencyIntentModes = Model.FrequencyIntentModes,
    frequencyTypes = Model.FrequencyTypes,
    frequencyPeriodTypes = Model.FrequencyPeriodTypes,
    skuAllocationModes = Model.SkuAllocationModes,
    contentRefTypes = Model.ContentRefTypes,
    maxSegmentBindings = Model.MaxSegmentBindings,
    maxProductLines = Model.MaxProductLines,
    maxSkuAllocationsPerLine = Model.MaxSkuAllocationsPerLine,
    maxContentBindings = Model.MaxContentBindings,
    requiredAllocationTotal = Model.RequiredAllocationTotal,
    availablePickers = Model.AvailablePickers,
    canPickGlobalProducts = Model.CanPickGlobalProducts,
    canPickGskus = Model.CanPickGskus
}, jsonOpts))</script>
