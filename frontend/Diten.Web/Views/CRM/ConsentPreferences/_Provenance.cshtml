@using Diten.Web.Views.CRM.ConsentPreferences
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ConsentPreferencesIndex> Localizer

@* ReasonCodes / matched-id / evaluator provenance. Populated by evaluate.js from the FU02 evaluation result.
   Matched ids are shown as provenance only — never as a stored/granted consent. *@
<div class="row g-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-header"><h6 class="mb-0">@Localizer["ReasonCodes"]</h6></div><div class="card-body">
        <div id="evalReasonCodes" class="d-flex flex-wrap gap-1"></div>
        <p id="evalSelectionReason" class="text-muted small mt-2 mb-0"></p>
    </div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-header"><h6 class="mb-0">@Localizer["ProvenanceSection"]</h6></div><div class="card-body"><dl class="row mb-0 small">
        <dt class="col-sm-5">@Localizer["MatchedConsentId"]</dt><dd class="col-sm-7 text-break" id="evalMatchedConsentId">—</dd>
        <dt class="col-sm-5">@Localizer["MatchedPreferenceIds"]</dt><dd class="col-sm-7 text-break" id="evalMatchedPreferenceIds">—</dd>
        <dt class="col-sm-5">@Localizer["EvaluatorVersion"]</dt><dd class="col-sm-7" id="evalEvaluatorVersion">—</dd>
        <dt class="col-sm-5">@Localizer["EvaluatedAt"]</dt><dd class="col-sm-7" id="evalEvaluatedAt">—</dd>
    </dl></div></div></div>
    <div class="col-12"><div class="card"><div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">@Localizer["DiagnosticsSection"]</h6>
        <button type="button" id="btnToggleDiagnostics" class="btn btn-sm btn-label-secondary" data-bs-toggle="collapse" data-bs-target="#evalDiagnostics">@Localizer["ToggleDiagnostics"]</button>
    </div><div class="collapse" id="evalDiagnostics"><div class="card-body">
        <h6 class="small text-uppercase text-muted">@Localizer["CandidateConsents"]</h6>
        <div class="table-responsive mb-3"><table class="table table-sm"><thead><tr><th>@Localizer["ConsentId"]</th><th>@Localizer["ConsentStatus"]</th><th>@Localizer["Selected"]</th><th>@Localizer["Reason"]</th></tr></thead><tbody id="evalCandidateConsents"></tbody></table></div>
        <h6 class="small text-uppercase text-muted">@Localizer["CandidatePreferences"]</h6>
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>@Localizer["PreferenceId"]</th><th>@Localizer["PreferenceType"]</th><th>@Localizer["Restrictive"]</th><th>@Localizer["Reason"]</th></tr></thead><tbody id="evalCandidatePreferences"></tbody></table></div>
    </div></div></div></div>
</div>
