@model Diten.Web.Models.CRM.PreferenceEditViewModel
@using Diten.Web.Views.CRM.ConsentPreferences
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ConsentPreferencesIndex> Localizer
@{
    ViewData["Title"] = Localizer["CreatePreference"].Value;
    Layout = "_LayoutTenantShell";
    ViewData["FormMode"] = "create";
}

<partial name="~/Views/CRM/ConsentPreferences/Preferences/_Form.cshtml" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/CRM/ConsentPreferences/preference-form.js" asp-append-version="true"></script>
}
