@using Diten.Web.Views.CRM.ConsentPreferences
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ConsentPreferencesIndex> Localizer

<div class="card">
    <div id="consentContractError" class="alert alert-danger rounded-0 d-none mb-0" role="alert"></div>
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
    </div>
    <div class="card-datatable table-responsive">
        <table id="dt-consents" data-dt-standard="v2" class="datatables-consents table border-top w-100">
            <thead><tr>
                <th></th>
                <th>@Localizer["SubjectType"]</th>
                <th class="all">@Localizer["SubjectId"]</th>
                <th>@Localizer["Channel"]</th>
                <th>@Localizer["Purpose"]</th>
                <th>@Localizer["ScopeType"]</th>
                <th>@Localizer["ScopeId"]</th>
                <th>@Localizer["LegalBasis"]</th>
                <th>@Localizer["ConsentStatus"]</th>
                <th>@Localizer["Source"]</th>
                <th>@Localizer["EffectiveFrom"]</th>
                <th>@Localizer["EffectiveTo"]</th>
                <th>@Localizer["Archived"]</th>
                <th>@Localizer["UpdatedAt"]</th>
                <th class="all text-end">@Localizer["Actions"]</th>
            </tr></thead>
        </table>
    </div>
</div>
