@using Diten.Web.Views.CRM.ConsentPreferences
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ConsentPreferencesIndex> Localizer

@* Golden Slim inline filter. index.js relocates this host into the DataTable toolbar and Select2-enhances the chips. *@
<div id="consentFilterHost" class="dt-filter-host">
    <div class="collapse" id="consentFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="consentFilterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip">
                        <select id="filterConsentSubjectType" class="form-select form-select-sm select2" data-placeholder="@Localizer["SubjectType"]"></select>
                    </div>
                    <div class="filter-chip">
                        @* Dependent subject picker (like Create): contact/account searchable by name, others accept a GUID. *@
                        <select id="filterConsentSubjectId" class="form-select form-select-sm subject-picker"
                                data-picker-url="/CRM/ConsentPreferences/api/subjects"
                                data-placeholder="@Localizer["SubjectId"]"></select>
                    </div>
                    <div class="filter-chip">
                        <select id="filterConsentChannel" class="form-select form-select-sm select2" data-placeholder="@Localizer["Channel"]"></select>
                    </div>
                    <div class="filter-chip">
                        <select id="filterConsentPurpose" class="form-select form-select-sm select2" data-placeholder="@Localizer["Purpose"]"></select>
                    </div>
                    <div class="filter-chip">
                        <select id="filterConsentStatus" class="form-select form-select-sm select2" data-placeholder="@Localizer["ConsentStatus"]"></select>
                    </div>
                    <div class="form-check form-switch">
                        <input id="filterConsentIncludeArchived" class="form-check-input" type="checkbox" checked />
                        <label class="form-check-label" for="filterConsentIncludeArchived">@Localizer["IncludeArchived"]</label>
                    </div>
                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnConsentFilterApply">@Localizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnConsentFilterReset">@Localizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
