        {
            ["draft"] = Localizer["Status_draft"].Value,
            ["active"] = Localizer["Status_active"].Value,
            ["inactive"] = Localizer["Status_inactive"].Value,
            ["archived"] = Localizer["Status_archived"].Value
        }
    };
    var resolveVerdictLabels = new Dictionary<string, string>();
    foreach (var v in verdictCodes) { resolveVerdictLabels[v] = Localizer[$"Verdict_{v}"].Value; }
    resolveL10n["verdictLabels"] = resolveVerdictLabels;
    var resolveReasonLabels = new Dictionary<string, string>();
    foreach (var r in reasonCodes) { resolveReasonLabels[r] = Localizer[$"Reason_{r}"].Value; }
    resolveL10n["reasonLabels"] = resolveReasonLabels;
    var resolveBandLabels = new Dictionary<string, string>();
    foreach (var b in bandCodes) { resolveBandLabels[b] = Localizer[$"Band_{b}"].Value; }
    resolveL10n["bandLabels"] = resolveBandLabels;
    // WP-FREQ-DET-H maps — period ("ay"), cadence ("ayda"), friendly target-type, source labels (closed sets; the
    // codes still come from the FU03 contract at runtime, resolve.js labels each through these maps with a fallback).
    var resolvePeriodLabels = new Dictionary<string, string>();
    foreach (var p in periodCodes) { resolvePeriodLabels[p] = Localizer[$"Period_{p}"].Value; }
    resolveL10n["periodLabels"] = resolvePeriodLabels;
    var resolveCadenceLabels = new Dictionary<string, string>();
    foreach (var p in periodCodes) { resolveCadenceLabels[p] = Localizer[$"ResolveCadence_{p}"].Value; }
    resolveL10n["cadenceLabels"] = resolveCadenceLabels;
    var resolveTargetTypeLabels = new Dictionary<string, string>();
    foreach (var tt in targetTypeCodes) { resolveTargetTypeLabels[tt] = Localizer[$"TargetType_{tt}"].Value; }
    resolveL10n["targetTypeLabels"] = resolveTargetTypeLabels;
    var resolveSourceLabels = new Dictionary<string, string>();
    foreach (var sc in sourceCodes) { resolveSourceLabels[sc] = Localizer[$"Source_{sc}"].Value; }
    resolveL10n["sourceLabels"] = resolveSourceLabels;
