        ["ResolveDo_na_1d"] = Localizer["ResolveDo_na_1d"].Value,
        ["SpecNarrowest"] = Localizer["SpecNarrowest"].Value,
        ["SpecBroadest"] = Localizer["SpecBroadest"].Value,
        // WP-FREQ-DET-I — explanatory candidate "why" sentences + the segment "all targets" friendly label. Keyed here so
        // resolve.js renders full sentences (not the short reason codes) in 7 languages; each still has a JS fallback.
        ["ResolveWhyNotEffective"] = Localizer["ResolveWhyNotEffective"].Value,
        ["ResolveWhySpecificityLost"] = Localizer["ResolveWhySpecificityLost"].Value,
        ["ResolveWhyBroader"] = Localizer["ResolveWhyBroader"].Value,
        ["ResolveWhyLastResort"] = Localizer["ResolveWhyLastResort"].Value,
        ["ResolveWhySelSpecificity"] = Localizer["ResolveWhySelSpecificity"].Value,
        ["ResolveWhySelPriority"] = Localizer["ResolveWhySelPriority"].Value,
        ["ResolveWhyContextMissing"] = Localizer["ResolveWhyContextMissing"].Value,
        ["ResolveCandSegmentAll"] = Localizer["ResolveCandSegmentAll"].Value,
