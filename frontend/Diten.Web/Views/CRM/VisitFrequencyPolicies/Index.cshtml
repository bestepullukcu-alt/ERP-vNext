<div class="mb-3">
    <h5 class="mb-0">@Localizer["PoliciesTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    <small class="text-muted"><i class="bx bx-info-circle me-1"></i>@Localizer["ArchiveVsDeleteNote"]</small>
</div>

@* Tabbed console: the policy list + (permission-gated) the read-only resolve/çözümleme panel (FREQ-C).
   WP-FREQ-DET-J — the tab strip is wrapped in the WorkCenter tab-card surface (card + card-body p-3 + wcn-tabcard;
   pills use wcn-tabs + bordered compact wc-tab-compact). CSS is global (backbone-custom.css); the Bootstrap
   data-bs-toggle="tab" switch, tab ids (#tab-policies/#tab-resolve), canResolve gate and content are unchanged. *@
<section class="card mb-3 wcn-tabcard">
    <div class="card-body p-3 d-flex align-items-center gap-3 flex-wrap">
        <ul class="nav nav-pills gap-2 flex-wrap mb-0 wcn-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link border shadow-none wc-tab-compact d-inline-flex align-items-center active" data-bs-toggle="tab" data-bs-target="#tab-policies" role="tab">
                    <i class="bx bx-list-ul wc-tab-icon me-md-1"></i>@Localizer["PoliciesTab"]
                </button>
            </li>
            @if (canResolve)
            {
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link border shadow-none wc-tab-compact d-inline-flex align-items-center" data-bs-toggle="tab" data-bs-target="#tab-resolve" role="tab">
                        <i class="bx bx-target-lock wc-tab-icon me-md-1"></i>@Localizer["ResolveTab"]
                    </button>
                </li>
            }
        </ul>
    </div>
</section>

<div class="tab-content p-0">
    <div class="tab-pane fade show active" id="tab-policies" role="tabpanel">
        @* Contract marker: <partial name="_Filter" /> *@
        <partial name="~/Views/CRM/VisitFrequencyPolicies/_Filter.cshtml" />
        <partial name="~/Views/CRM/VisitFrequencyPolicies/_DataTable.cshtml" />
    </div>

    @if (canResolve)
    {
        @* FREQ-C — the read-only resolve/çözümleme panel (contract marker id="tab-resolve" preserved). *@
        <div class="tab-pane fade" id="tab-resolve" role="tabpanel">
            <partial name="~/Views/CRM/VisitFrequencyPolicies/_Resolve.cshtml" />
        </div>
    }
</div>

@* WP-FREQ-DET-B — the details quick-view offcanvas (_DetailsQuickView) is retired; row "Details" now opens the separate
   /Details/{id} page. The editor is also a separate page (/Create, /Edit/{id}). *@

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/VisitFrequencyPolicies/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/VisitFrequencyPolicies/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/VisitFrequencyPolicies/index.js" asp-append-version="true"></script>

    @if (canResolve)
    {
        @* Shared L10n bridge (resolve panel), code-keyed. Rendered here (moved from the retired _DetailsQuickView) so
           resolve.js reads it as it loads — resolve.js + _Resolve.cshtml are unchanged. *@
        <script id="vfp-dr-l10n" type="application/json">@Html.Raw(Json.Serialize(resolveL10n))</script>
        <link rel="stylesheet" href="~/assets/css/visit-frequency-details.css" asp-append-version="true" />
        <script src="~/assets/js/CRM/VisitFrequencyPolicies/resolve.js" asp-append-version="true"></script>
    }
}
