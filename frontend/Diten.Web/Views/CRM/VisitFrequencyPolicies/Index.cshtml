@using Diten.Web.Security
@using Diten.Web.Views.CRM.VisitFrequencyPolicies
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitFrequencyPoliciesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["PoliciesTitle"].Value;
    Layout = "_LayoutTenantShell";
    // Çözümleme (resolve) tab is permission-gated (UAS-001): only drawn for a user granted resolve (canonical or the
    // documented territory.read fallback). Its panel content is FREQ-C.
    var canResolve = PermissionClaims.HasPermission(User, "crm.visit-frequency-policy.resolve")
        || PermissionClaims.HasPermission(User, "crm.territory.read");

