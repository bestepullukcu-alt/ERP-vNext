        ["ResolveScenario_segment"] = Localizer["ResolveScenario_segment"].Value,
        ["ResolveScenario_campaign-target"] = Localizer["ResolveScenario_campaign-target"].Value,
        ["ResolveScenario_territory-node"] = Localizer["ResolveScenario_territory-node"].Value,
        ["ResolveScenario_concept-node"] = Localizer["ResolveScenario_concept-node"].Value,
        ["ResolveScenario_audience-profile"] = Localizer["ResolveScenario_audience-profile"].Value,
        ["ResolveRecordLabel"] = Localizer["ResolveRecordLabel"].Value,
        ["ResolveChange"] = Localizer["ResolveChange"].Value,
        ["ResolveCyclePeriod"] = Localizer["ResolveCyclePeriod"].Value,
        ["ResolveDateLabel"] = Localizer["ResolveDateLabel"].Value,
        ["ResolveShowFrequency"] = Localizer["ResolveShowFrequency"].Value,
        ["ResolveRuleSimpleTitle"] = Localizer["ResolveRuleSimpleTitle"].Value,
