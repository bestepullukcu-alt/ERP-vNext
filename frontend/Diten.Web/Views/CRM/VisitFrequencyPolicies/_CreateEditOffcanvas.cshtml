@using Diten.Web.Views.CRM.VisitFrequencyPolicies
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitFrequencyPoliciesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* WP-FREQ-A placeholder — the create/edit editor (fields, contract-driven vocabulary selects, validation, save) is
   authored in FREQ-B. The shell + contract marker id="offcanvasCreateEdit" exist now so the list's "New Policy" and
   row "Edit" actions can open it. *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCreateEdit" aria-labelledby="offcanvasCreateEditLabel">
    <div class="offcanvas-header p-4">
        <h5 id="offcanvasCreateEditLabel" class="offcanvas-title">@Localizer["NewPolicy"]</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body border-top p-4">
        <div class="text-center text-muted py-5">
            <i class="bx bx-edit-alt display-6 d-block mb-2"></i>
            <p class="mb-0">@Localizer["EditorPlaceholder"]</p>
        </div>
    </div>
    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
    </div>
</div>
