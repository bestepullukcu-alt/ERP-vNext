@using Diten.Web.Views.CRM.VisitFrequencyPolicies
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<VisitFrequencyPoliciesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* Golden Compact inline filter host — filter chips are populated from the FU03 contract vocabulary (no hardcoded list). *@
<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Filter Chip: Status (Multi-select) — options from contract *@
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@SharedLocalizer["Status"]">
                        </select>
                    </div>

                    @* Filter Chip: Target Type (Multi-select) — options from contract *@
                    <div class="filter-chip filter-target-type">
                        <select id="filterTargetType" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Target"]">
                        </select>
                    </div>

                    @* Filter Chip: Source (Single Select) — options from contract *@
                    <div class="filter-chip filter-source">
                        <select id="filterSource" class="form-select form-select-sm select2" data-placeholder="@Localizer["Source"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
