@model Diten.Web.Models.CRM.ContactEditViewModel
@using Diten.Web.Views.CRM.Contacts
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ContactIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
    var action = isEdit ? "Edit" : "Create";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/CRM/Contacts">@Localizer["ContactTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/CRM/Contacts" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="contactForm" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ReferenceDependencyMessage))
{
    @* Controlled dependency: a required MOD-0048 set is unavailable. Selects stay empty — no local fallback. *@
    <div class="alert alert-warning" role="alert">@Model.ReferenceDependencyMessage</div>
}

@* MOD-0150 PII/KVKK notice — Contact identity/communication fields are personal data. Dismissible + remembered. *@
<div class="alert alert-info alert-dismissible d-flex align-items-start gap-2" role="alert" data-dismiss-key="crm-contact-pii-notice">
    <i class="icon-base ti tabler-shield-lock mt-1"></i>
    <div class="pe-4">@Localizer["PiiKvkkNotice"]</div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@SharedLocalizer["Close"]"></button>
</div>

<form id="contactForm" asp-controller="Contacts" asp-action="@action" asp-route-id="@Model.Id" method="post"
      class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Main Column (Left) -->
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IdentitySection"]</h6>

                    @* MOD-0150 avatar — client-side resized (256px) into a base64 data-URI hidden field. Personal data:
                       stored on the contact but EXCLUDED from list/export/audit. Image files only; no server upload endpoint. *@
                    <input type="hidden" asp-for="PhotoDataUri" id="ContactPhotoDataUri" />
                    <div class="d-flex align-items-center gap-3 mb-4" id="contactPhotoWidget">
                        <img id="contactPhotoPreview"
                             src="@(string.IsNullOrWhiteSpace(Model.PhotoDataUri) ? "" : Model.PhotoDataUri)"
                             alt="@Localizer["Photo"]"
                             class="rounded-circle border @(string.IsNullOrWhiteSpace(Model.PhotoDataUri) ? "d-none" : "")"
                             style="width:88px;height:88px;object-fit:cover;" />
                        <div id="contactPhotoPlaceholder"
                             class="rounded-circle border d-flex align-items-center justify-content-center text-muted @(string.IsNullOrWhiteSpace(Model.PhotoDataUri) ? "" : "d-none")"
                             style="width:88px;height:88px;">
                            <i class="icon-base ti tabler-user" style="font-size:2rem;"></i>
                        </div>
                        <div>
                            <label class="form-label fw-medium d-block mb-1">@Localizer["Photo"]</label>
                            <div class="d-flex gap-2">
                                <label class="btn btn-sm btn-outline-primary mb-0">
                                    <i class="icon-base ti tabler-upload me-1"></i>@Localizer["PhotoUpload"]
                                    <input type="file" id="contactPhotoInput" accept="image/*" hidden />
                                </label>
                                <button type="button" id="contactPhotoRemove"
                                        class="btn btn-sm btn-outline-secondary @(string.IsNullOrWhiteSpace(Model.PhotoDataUri) ? "d-none" : "")">
                                    <i class="icon-base ti tabler-trash me-1"></i>@SharedLocalizer["Delete"]
                                </button>
                            </div>
                            <div class="form-text">@Localizer["PhotoHelp"]</div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="FirstName" class="form-label fw-medium">@Localizer["FirstName"] <span class="text-danger">*</span></label>
                            <input asp-for="FirstName" class="form-control" maxlength="120" placeholder="@Localizer["FirstNamePlaceholder"]" required />
                            <span asp-validation-for="FirstName" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="LastName" class="form-label fw-medium">@Localizer["LastName"]</label>
                            <input asp-for="LastName" class="form-control" maxlength="120" placeholder="@Localizer["LastNamePlaceholder"]" />
                        </div>
                        <div class="col-12">
                            <label asp-for="DisplayName" class="form-label fw-medium">@Localizer["DisplayName"]</label>
                            <input asp-for="DisplayName" class="form-control" maxlength="200" placeholder="@Localizer["DisplayNamePlaceholder"]" />
                            <div class="form-text">@Localizer["DisplayNameHelp"]</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="ContactType" class="form-label fw-medium">@Localizer["ContactType"] <span class="text-danger">*</span></label>
                            <select asp-for="ContactType" class="select2 form-select"
                                    asp-items="@(new SelectList(Model.ContactTypeOptions, nameof(Diten.Web.Models.CRM.ReferenceOptionViewModel.Value), nameof(Diten.Web.Models.CRM.ReferenceOptionViewModel.Text)))" required>
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                            </select>
                            <span asp-validation-for="ContactType" class="text-danger small mt-1"></span>
                        </div>
                        @* Gender — MOD-0048 single select (optional; fallback-option keeps a stored value not in the list). *@
                        <div class="col-12 col-md-6">
                            <label asp-for="Gender" class="form-label fw-medium">@Localizer["Gender"]</label>
                            <select asp-for="Gender" class="select2 form-select" data-placeholder="@SharedLocalizer["SelectPlaceholder"]">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var o in Model.GenderOptions)
                                {
                                    <option value="@o.Value" selected="@(string.Equals(o.Value, Model.Gender, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Gender) && !Model.GenderOptions.Any(o => string.Equals(o.Value, Model.Gender, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@Model.Gender" selected="selected">@Model.Gender</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["LocationSection"]</h6>
                    @if (Model.CountryOptions.Count == 0)
                    {
                        <div class="form-text mb-3">@Localizer["LocationIncompleteHelp"]</div>
                    }

                    @* Inline map picker (Leaflet + OpenStreetMap), mirroring MOD-0149 Account. Click/drag the marker or
                       search a place to fill the address + country/city/district. Contact stores no coordinates (person,
                       not a physical workplace) — the map only assists filling the location fields. *@
                    <div class="mb-3">
                        <div class="input-group mb-2">
                            <span class="input-group-text"><i class="bx bx-search"></i></span>
                            <input type="text" id="contactMapSearch" class="form-control"
                                   placeholder="@Localizer["MapSearchPlaceholder"]" autocomplete="off" />
                            <button type="button" class="btn btn-outline-primary" id="btnContactMapSearch">@SharedLocalizer["Search"]</button>
                            <button type="button" class="btn btn-outline-secondary" id="btnContactUseMyLocation">
                                <i class="bx bx-current-location me-1"></i>@Localizer["UseMyLocation"]
                            </button>
                        </div>
                        <div id="contactMap" class="rounded border" style="height: 320px; width: 100%;"></div>
                        <div class="form-text">@Localizer["MapHelp"]</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="CountryRef" class="form-label fw-medium">@Localizer["Country"]</label>
                            <select asp-for="CountryRef" class="select2 form-select" data-placeholder="@SharedLocalizer["SelectPlaceholder"]">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var o in Model.CountryOptions)
                                {
                                    <option value="@o.Value" selected="@(string.Equals(o.Value, Model.CountryRef, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CountryRef) && !Model.CountryOptions.Any(o => string.Equals(o.Value, Model.CountryRef, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@Model.CountryRef" selected="selected">@Model.CountryRef</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="CityRef" class="form-label fw-medium">@Localizer["City"]</label>
                            <select asp-for="CityRef" class="select2 form-select" data-placeholder="@SharedLocalizer["SelectPlaceholder"]">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var o in Model.CityOptions)
                                {
                                    <option value="@o.Value" selected="@(string.Equals(o.Value, Model.CityRef, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CityRef) && !Model.CityOptions.Any(o => string.Equals(o.Value, Model.CityRef, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@Model.CityRef" selected="selected">@Model.CityRef</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="DistrictRef" class="form-label fw-medium">@Localizer["District"]</label>
                            <select asp-for="DistrictRef" class="select2 form-select" data-placeholder="@SharedLocalizer["SelectPlaceholder"]">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var o in Model.DistrictOptions)
                                {
                                    <option value="@o.Value" selected="@(string.Equals(o.Value, Model.DistrictRef, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.DistrictRef) && !Model.DistrictOptions.Any(o => string.Equals(o.Value, Model.DistrictRef, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@Model.DistrictRef" selected="selected">@Model.DistrictRef</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="AddressLine" class="form-label fw-medium">@Localizer["AddressLine"]</label>
                            <textarea asp-for="AddressLine" class="form-control" rows="2" maxlength="256" placeholder="@Localizer["AddressLinePlaceholder"]"></textarea>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="PostalCode" class="form-label fw-medium">@Localizer["PostalCode"]</label>
                            <input asp-for="PostalCode" class="form-control" maxlength="16" />
                        </div>
                        @* Preferred language — MOD-0048 single select (fallback-option keeps a stored value not in the list). *@
                        <div class="col-12 col-md-6">
                            <label asp-for="PreferredLanguage" class="form-label fw-medium">@Localizer["PreferredLanguage"]</label>
                            <select asp-for="PreferredLanguage" class="select2 form-select" data-placeholder="@SharedLocalizer["SelectPlaceholder"]">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var o in Model.PreferredLanguageOptions)
                                {
                                    <option value="@o.Value" selected="@(string.Equals(o.Value, Model.PreferredLanguage, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.PreferredLanguage) && !Model.PreferredLanguageOptions.Any(o => string.Equals(o.Value, Model.PreferredLanguage, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@Model.PreferredLanguage" selected="selected">@Model.PreferredLanguage</option>
                                }
                            </select>
                            <span asp-validation-for="PreferredLanguage" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["NotesSection"]</h6>
                    @* MOD-0150 Notes safety notice — no patient/health/sensitive data in free text. Dismissible + remembered. *@
                    <div class="alert alert-warning alert-dismissible d-flex align-items-start gap-2" role="alert" data-dismiss-key="crm-contact-notes-notice">
                        <i class="icon-base ti tabler-alert-triangle mt-1"></i>
                        <div class="pe-4">@Localizer["NotesSafetyNotice"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@SharedLocalizer["Close"]"></button>
                    </div>
                    <label asp-for="Notes" class="form-label fw-medium">@SharedLocalizer["Description"]</label>
                    <textarea asp-for="Notes" class="form-control" rows="6" maxlength="2000" placeholder="@SharedLocalizer["DescriptionPlaceholder"]"></textarea>
                </div>
            </section>
        </div>

        <!-- Sidebar Column (Right) -->
        <div class="col-12 col-lg-4">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["StatusSection"]</h6>
                    <label asp-for="Status" class="form-label fw-medium">@SharedLocalizer["Status"] <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="select2 form-select"
                            asp-items="@(new SelectList(Model.ContactStatusOptions, nameof(Diten.Web.Models.CRM.ReferenceOptionViewModel.Value), nameof(Diten.Web.Models.CRM.ReferenceOptionViewModel.Text)))" required>
                        <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small mt-1"></span>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ProfessionalSection"]</h6>
                    @* MOD-0048 optional reference sets (professional-title / medical-specialty / department-type). select2
                       single-select; a stored value that is not (yet) in the published list is preserved via a fallback
                       option. Empty when the operator has not published the set — no CRM local fallback. *@
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ProfessionalTitle" class="form-label fw-medium">@Localizer["ProfessionalTitle"]</label>
                            <select asp-for="ProfessionalTitle" class="select2 form-select" data-contact-professional="title"
                                    data-placeholder="@Localizer["ProfessionalTitlePlaceholder"]">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var o in Model.ProfessionalTitleOptions)
                                {
                                    <option value="@o.Value" selected="@(string.Equals(o.Value, Model.ProfessionalTitle, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ProfessionalTitle) && !Model.ProfessionalTitleOptions.Any(o => string.Equals(o.Value, Model.ProfessionalTitle, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@Model.ProfessionalTitle" selected="selected">@Model.ProfessionalTitle</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Specialty" class="form-label fw-medium">@Localizer["Specialty"]</label>
                            <select asp-for="Specialty" class="select2 form-select" data-contact-professional="specialty"
                                    data-placeholder="@Localizer["SpecialtyPlaceholder"]">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var o in Model.SpecialtyOptions)
                                {
                                    <option value="@o.Value" selected="@(string.Equals(o.Value, Model.Specialty, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Specialty) && !Model.SpecialtyOptions.Any(o => string.Equals(o.Value, Model.Specialty, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@Model.Specialty" selected="selected">@Model.Specialty</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Department" class="form-label fw-medium">@Localizer["Department"]</label>
                            <select asp-for="Department" class="select2 form-select" data-contact-professional="department"
                                    data-placeholder="@Localizer["DepartmentPlaceholder"]">
                                <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                                @foreach (var o in Model.DepartmentOptions)
                                {
                                    <option value="@o.Value" selected="@(string.Equals(o.Value, Model.Department, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Department) && !Model.DepartmentOptions.Any(o => string.Equals(o.Value, Model.Department, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@Model.Department" selected="selected">@Model.Department</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ContactSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Phone" class="form-label fw-medium">@Localizer["Phone"]</label>
                            @* Dial code (MOD-0048 single select, NOT disabled) + phone number, side by side. Fallback-option
                               preserves a stored dial code that is not (yet) in the published list. *@
                            <div class="row g-2">
                                <div class="col-4 col-lg-5">
                                    <select asp-for="PhoneCountryCode" class="select2 form-select" data-placeholder="@Localizer["PhoneCountryCode"]">
                                        <option value="">@Localizer["PhoneCountryCode"]</option>
                                        @foreach (var o in Model.PhoneCountryCodeOptions)
                                        {
                                            <option value="@o.Value" selected="@(string.Equals(o.Value, Model.PhoneCountryCode, StringComparison.OrdinalIgnoreCase))">@o.Text</option>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(Model.PhoneCountryCode) && !Model.PhoneCountryCodeOptions.Any(o => string.Equals(o.Value, Model.PhoneCountryCode, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <option value="@Model.PhoneCountryCode" selected="selected">@Model.PhoneCountryCode</option>
                                        }
                                    </select>
                                    <span asp-validation-for="PhoneCountryCode" class="text-danger small mt-1"></span>
                                </div>
                                <div class="col-8 col-lg-7">
                                    <input asp-for="Phone" class="form-control" maxlength="32" placeholder="@Localizer["PhonePlaceholder"]" inputmode="tel" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-medium">@Localizer["Email"]</label>
                            <input asp-for="Email" type="email" class="form-control" maxlength="256" placeholder="@Localizer["EmailPlaceholder"]" />
                            <span asp-validation-for="Email" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IntegrationSection"]</h6>
                    <label asp-for="ExternalReference" class="form-label fw-medium">@Localizer["ExternalReference"]</label>
                    <input asp-for="ExternalReference" class="form-control" maxlength="128" placeholder="@Localizer["ExternalReferencePlaceholder"]" />
                    <div class="form-text">@Localizer["ExternalReferenceHelp"]</div>
                </div>
            </section>
        </div>
    </div>
</form>
