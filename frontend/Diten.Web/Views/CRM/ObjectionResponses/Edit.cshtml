@model Diten.Web.Models.CRM.ObjectionResponsesPageViewModel
@using Diten.Web.Views.CRM.ObjectionResponses
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ObjectionResponsesIndex> Localizer
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = Localizer[isNew ? "NewTitle" : "EditTitle"].Value;
    Layout = "_LayoutTenantShell";
    Context.Items["NavActivePath"] = "/CRM/ObjectionResponses";
}

@*
    WP-VW-W3 (W3-WEB-c) — A2 · a new answer / a draft. Left: product, category (BRD), the doctor's question (≤ 500), the
    approved answer (≤ 4000), the supporting claims (ONLY the selected product's approved claims, at most 10). Right: the
    rep's remote preview + who / when. "Taslağı kaydet" saves a half-written draft (K-A3); "Onaya gönder" saves and submits
    (CRM checks completeness). There is NO one-click "Onayla" here (K-A2): the decision is the reviewer's, on the record
    page / the Work Center. UAS-001: read + manage, else only the access notice.
*@
@if (!Model.CanRead || !Model.CanManage)
{
    <partial name="_AccessDenied" model="@Localizer["PageTitle"].Value" />
    return;
}

<div id="orEditRoot"
     data-api-base="/CRM/ObjectionResponses/api"
     data-id="@(Model.Id?.ToString() ?? string.Empty)"
     data-product-id="@(Model.ProductId?.ToString() ?? string.Empty)"
     data-can-submit="@(Model.CanSubmit ? "true" : "false")"
     data-can-read-claims="@(Model.CanReadClaims ? "true" : "false")"
     data-can-read-products="@(Model.CanReadProducts ? "true" : "false")"
     data-me-name="@Model.MeName">

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/CRM/ObjectionResponses">@Localizer["PageTitle"]</a></li>
                    <li class="breadcrumb-item active" id="orCrumbProduct" aria-current="page"></li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0">@Localizer[isNew ? "NewTitle" : "EditTitle"]</h5>
                <span class="badge bg-label-secondary" id="orStatusBadge"></span>
            </div>
        </div>
    </div>

    <div id="orAlert" class="alert alert-danger d-none" role="alert"></div>

    <div class="row g-4">
        <div class="col-12 col-xl-7">
            <section class="card">
                <div class="card-header"><h6 class="mb-0">@Localizer["SectionContent"]</h6></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-uppercase small fw-semibold" for="orProduct">@Localizer["FieldProduct"] <span class="text-danger">*</span></label>
                            <select id="orProduct" class="form-select"></select>
                            <small class="text-danger d-none" id="orProductError"></small>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-uppercase small fw-semibold" for="orCategory">@Localizer["FieldCategory"] <span class="text-danger">*</span></label>
                            <select id="orCategory" class="form-select"></select>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <label class="form-label text-uppercase small fw-semibold" for="orQuestion">@Localizer["FieldQuestion"] <span class="text-danger">*</span></label>
                                <small class="text-muted" id="orQuestionCount"></small>
                            </div>
                            <textarea id="orQuestion" class="form-control" rows="2" maxlength="500" placeholder="@Localizer["QuestionPlaceholder"]"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <label class="form-label text-uppercase small fw-semibold" for="orAnswer">@Localizer["FieldAnswer"] <span class="text-danger">*</span></label>
                                <small class="text-muted" id="orAnswerCount"></small>
                            </div>
                            <textarea id="orAnswer" class="form-control" rows="5" maxlength="4000" placeholder="@Localizer["AnswerPlaceholder"]"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <span class="form-label text-uppercase small fw-semibold mb-0">@Localizer["FieldClaims"]</span>
                                <small class="text-muted" id="orClaimsCount"></small>
                            </div>
                            <small class="text-muted d-block mb-2"><i class="bx bx-info-circle me-1" aria-hidden="true"></i>@Localizer["ClaimsHint"]</small>
                            <div id="orClaims" class="d-grid gap-2" role="group" aria-label="@Localizer["FieldClaims"]"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex flex-wrap justify-content-end gap-2 border-top pt-3">
                    <a class="btn btn-label-secondary" id="orCancel" href="/CRM/ObjectionResponses">@Localizer["CancelButton"]</a>
                    <button type="button" class="btn btn-outline-primary" id="orSaveDraft"><i class="bx bx-save me-1" aria-hidden="true"></i>@Localizer["SaveDraft"]</button>
                    @if (Model.CanSubmit)
                    {
                        <button type="button" class="btn btn-primary" id="orSubmit"><i class="bx bx-send me-1" aria-hidden="true"></i>@Localizer["SubmitForApproval"]</button>
                    }
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-5">
            <partial name="~/Views/CRM/ObjectionResponses/_Preview.cshtml" />
            <section class="card mt-4">
                <div class="card-body small">
                    <div class="d-flex justify-content-between"><span class="text-muted">@Localizer["CreatedBy"]</span><span id="orMetaCreated">—</span></div>
                    <div class="d-flex justify-content-between mt-1"><span class="text-muted">@Localizer["LastSaved"]</span><span id="orMetaSaved">—</span></div>
                    <p class="text-muted mt-2 mb-0"><i class="bx bx-shield-quarter me-1" aria-hidden="true"></i>@Localizer["MetaNote"]</p>
                </div>
            </section>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/js/CRM/ObjectionResponses/objection-responses.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="~/Views/CRM/ObjectionResponses/_L10n.cshtml" />
    <script src="~/assets/js/CRM/ObjectionResponses/objection-core.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/ObjectionResponses/objection-common.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/ObjectionResponses/objection-edit.js" asp-append-version="true"></script>
}
