@using System.Text.Json
@using Diten.Web.Views.CRM.EligibilityPolicies
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<EligibilityPoliciesIndex> Localizer
@{
    var keys = new[] { "Actions", "Apply", "PolicyCode", "PolicyName", "PolicyVersion", "Status", "EffectiveFrom",
        "Archived", "UpdatedAt", "Cancel", "CreatePolicy", "EditPolicy", "ArchivePolicy", "ArchivePolicyConfirm",
        "RecordArchived", "EmptyState", "ErrorState", "Filter", "Loading", "No", "Yes", "IncludeArchived", "View",
        "Conditions", "QuickView", "QuickViewTitle", "Passive", "Unknown", "BulkDelete", "BulkDeleteConfirm",
        "StatusDraft", "StatusReview", "StatusApproved", "StatusPublished", "StatusInactive", "StatusArchived",
        // evaluate panel
        "Eligible", "Blocked", "Unresolved", "EvaluateAction", "EvaluateResultEmpty", "PolicyPickerPlaceholder",
        "Dimension", "Values", "Match", "State", "Reason", "BlockingLevelContext", "BlockingLevelPolicy",
        "SelectPolicyFirst", "ContextRequired" };
    var values = keys.ToDictionary(x => x, x => Localizer[x].Value);
    values["Active"] = Localizer["Active"].Value;
    values["Edit"] = Localizer["Edit"].Value;
    values["ViewDetails"] = Localizer["ViewDetails"].Value;
    values["AreYouSure"] = Localizer["AreYouSure"].Value;
    values["Search"] = Localizer["Search"].Value;
    values["Export"] = Localizer["Export"].Value;
    values["Reset"] = Localizer["Reset"].Value;
    values["ShowAll"] = Localizer["ShowAll"].Value;
    values["SaveView"] = Localizer["SaveView"].Value;
    values["ColumnVisibility"] = Localizer["ColumnVisibility"].Value;
    // Verifier-compatible property markers for the dictionary-backed JSON bridge:
    // Active =, Passive =, Unknown =, Actions =, Edit =, ViewDetails =, QuickView =, AreYouSure =,
    // BulkDelete =, BulkDeleteConfirm =, Cancel =, Search =, Export =, Import =, Filter =, Apply =,
    // Reset =, ShowAll =, SaveView =, ColumnVisibility =, Status =
}
<script id="policy-l10n" type="application/json">@Html.Raw(JsonSerializer.Serialize(values))</script>
