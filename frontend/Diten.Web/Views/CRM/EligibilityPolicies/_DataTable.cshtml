@using Diten.Web.Views.CRM.EligibilityPolicies
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<EligibilityPoliciesIndex> Localizer

<div class="card">
    <div id="policyError" class="alert alert-danger rounded-0 d-none mb-0" role="alert"></div>
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
    </div>
    <div class="card-datatable table-responsive">
        <table id="dt-eligibility-policies" data-dt-standard="v2" class="datatables-eligibility-policies table border-top w-100">
            <thead><tr>
                <th></th>
                <th>@Localizer["PolicyCode"]</th>
                <th class="all">@Localizer["PolicyName"]</th>
                <th>@Localizer["PolicyVersion"]</th>
                <th>@Localizer["Status"]</th>
                <th>@Localizer["EffectiveFrom"]</th>
                <th>@Localizer["Archived"]</th>
                <th>@Localizer["UpdatedAt"]</th>
                <th class="all text-end">@Localizer["Actions"]</th>
            </tr></thead>
        </table>
    </div>
</div>
