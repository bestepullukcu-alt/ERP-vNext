@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.Views.CRM.Accounts.AccountIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* Inline collapse filter bar for the Account 360 "Related Contacts" DataTable (v2 contract).
   Ids are section-scoped (…Contacts suffix) because the Details page carries two v2 tables; a shared host id would
   let one section's filter panel and toolbar badge drive the other. Chips are populated at runtime from the
   projection actually rendered for THIS account — MOD-0048 stays the source of truth for which codes may exist. *@
<div id="inlineFilterHostContacts" class="dt-inline-filter-host">
    <div class="collapse" id="inlineFilterCollapseContacts">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterFormContacts" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Filter Chip: Contact Role *@
                    <div class="filter-chip filter-role">
                        <select id="filterContactRole" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Role"]">
                        </select>
                    </div>

                    @* Filter Chip: Contact Type *@
                    <div class="filter-chip filter-contact-type">
                        <select id="filterContactType" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["ContactType"]">
                        </select>
                    </div>

                    @* Filter Chip: Link Status *@
                    <div class="filter-chip filter-status">
                        <select id="filterContactStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@SharedLocalizer["Status"]">
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnContactsFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnContactsFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
