@using Diten.Web.Views.CRM.Accounts
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AccountIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["AccountTitle"].Value;
    Layout = "_LayoutTenantShell";
    var bulkActionBar = new DataTableBulkActionBarViewModel
    {
        SelectedText = SharedLocalizer["SelectedCount"].Value,
        ClearSelectionText = SharedLocalizer["ClearSelection"].Value,
        Actions =
        [
            new DataTableActionItemViewModel
            {
                Key = "delete",
                Text = SharedLocalizer["BulkDelete"].Value,
                Icon = "bx bx-trash",
                ButtonClass = "btn btn-label-danger",
                ConfirmKey = "BulkDeleteConfirm",
                Endpoint = "/api/crm/accounts/bulk",
                Method = "DELETE"
            }
        ]
    };
}

@* ① Inline Filter partial *@
@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/CRM/Accounts/_Filter.cshtml" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["AccountTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* ② Bulk Action Bar *@
<partial name="~/Views/Shared/Components/DataTable/_BulkActionBar.cshtml" model="bulkActionBar" />

@* ③ DataTable Card *@
@* Contract markers are rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-accounts" data-dt-standard="v2"> *@
<partial name="~/Views/CRM/Accounts/_DataTable.cshtml" />


@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/Accounts/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/Accounts/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/Accounts/index.js" asp-append-version="true"></script>
}
