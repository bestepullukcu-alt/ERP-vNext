@model Diten.Web.Models.CRM.PlannedVisitIndexViewModel
@using Diten.Web.Views.CRM.PlannedVisits
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlannedVisitsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["PlannedVisitsTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* ① Inline Filter partial *@
@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/CRM/PlannedVisits/_Filter.cshtml" />

@* Golden Compact: authoring happens on its own page; the create affordance lives once in the DataTable toolbar
   (the `.add-new` button), gated by the same server-side permission published to index.js below. *@
<div class="mb-3">
    <h5 class="mb-0">@Localizer["PlannedVisitsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* ② BulkActionBar is intentionally absent: this module has NO delete and NO bulk delete (a plan is cancelled/archived). *@

@* ③ DataTable Card *@
@* Contract markers are rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-planned-visits" data-dt-standard="v2"> *@
<partial name="~/Views/CRM/PlannedVisits/_DataTable.cshtml" />

<script id="plannedvisit-page-flags" type="application/json">{"canManage": @(Model.CanManage ? "true" : "false"), "canConfirm": @(Model.CanConfirm ? "true" : "false")}</script>

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/CRM/PlannedVisits/_IndexL10n.cshtml" />
    <script src="~/assets/js/CRM/PlannedVisits/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/PlannedVisits/index.js" asp-append-version="true"></script>
}
