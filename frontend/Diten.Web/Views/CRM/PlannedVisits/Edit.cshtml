@model Diten.Web.Models.CRM.PlannedVisitEditViewModel
@using Diten.Web.Views.CRM.PlannedVisits
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlannedVisitsIndex> Localizer
@{
    ViewData["Title"] = Localizer["FormTitleEdit"].Value;
    Layout = "_LayoutTenantShell";
    ViewData["FormMode"] = "edit";
}

<partial name="~/Views/CRM/PlannedVisits/_Form.cshtml" model="Model" />

@section Scripts {
    <partial name="~/Views/CRM/PlannedVisits/_IndexL10n.cshtml" />
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/CRM/PlannedVisits/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/CRM/PlannedVisits/form.js" asp-append-version="true"></script>
}
