@using Diten.Web.Views.CRM.SafetyTexts
@using Diten.Web.Models.DataTable
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SafetyTextsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // SERVER data: the Web proxy pages, searches, sorts and filters the CRM rows (api/safety-texts) and answers
    // { items, total, filteredTotal }; the JS declares the same mode.
    // NO SELECTION COLUMN, deliberately: there is no bulk operation on a safety text (no bulk delete — it is archived).
    var listShell = new DataTableListShellViewModel
    {
        TableId = "dt-safetytexts",
        DataMode = "server",
        Slug = "safetytexts",
        HasSelection = false,
        Columns =
        [
            new DataTableColumnViewModel { Header = Localizer["Code"].Value, CssClass = "all" },
            new DataTableColumnViewModel { Header = Localizer["Product"].Value },
            new DataTableColumnViewModel { Header = Localizer["Country"].Value },
            new DataTableColumnViewModel { Header = Localizer["Language"].Value },
            new DataTableColumnViewModel { Header = Localizer["Version"].Value },
            new DataTableColumnViewModel { Header = SharedLocalizer["Status"].Value },
            new DataTableColumnViewModel { Header = Localizer["UpdatedAt"].Value }
        ],
        ActionsHeader = Localizer["Actions"].Value
    };
}

<partial name="~/Views/Shared/Components/DataTable/_ListShell.cshtml" model="listShell" />
