@using Diten.Web.Views.CRM.CyclePeriods
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CyclePeriodsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* DATA MODE: client — index.js loads the whole (bounded) set once and DataTables pages, sorts and filters it in
   the browser; there is no serverSide paging. Declared on the <table> (data-dt-data-mode) per the golden template.
   There is no select-all checkbox and no bulk action bar here on purpose: this module has NO bulk delete and no delete
   at all (ending a period is Close), so a selection column would offer an action that does not exist. *@
<div class="card">
    @* WP-CYC-UI-FIX-1 — the shared, shaped placeholder (renders id="skeleton-loader" data-table-skeleton). It is
       visible from the first paint and hides the table beside it until dt-defaults.js REMOVES it on the first draw. *@
    <partial name="_TableSkeleton" />

    <div class="card-datatable table-responsive">
        <table id="dt-cycle-periods" data-dt-standard="v2" data-dt-data-mode="client" class="datatables-cycleperiods table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["CycleCode"]</th>
                    <th class="all">@Localizer["CycleName"]</th>
                    <th>@Localizer["Year"]</th>
                    <th>@Localizer["SequenceInYear"]</th>
                    <th>@Localizer["StartDate"]</th>
                    <th>@Localizer["EndDate"]</th>
                    <th class="text-end">@Localizer["Days"]</th>
                    @* One Scope column: the level as a badge plus its reference, so a reader can see at a glance which
                       calendar a row belongs to. *@
                    <th>@Localizer["Scope"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    @* WP-CYC-UI-1 — the usage summary the list reads in one batch (null = unknown, shown as "—"). *@
                    <th>@Localizer["Capacity"]</th>
                    <th class="text-end">@Localizer["Campaigns"]</th>
                    <th class="text-end">@Localizer["PlannedVisits"]</th>
                    <th>@Localizer["UpdatedAt"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
