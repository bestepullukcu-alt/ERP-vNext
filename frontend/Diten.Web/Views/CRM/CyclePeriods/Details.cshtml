@model Diten.Web.Models.CRM.CyclePeriodEditViewModel
@using Diten.Web.Views.CRM.CyclePeriods
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CyclePeriodsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Details"].Value;
    // The SAME shape the grid and the "in force today" badge use ("Jan 01, 26"), and pinned to en-US for the same
    // reason: a window that reads one way on the list and another way here is a window nobody trusts. The request
    // culture must not reach this format - under tr-TR "MMM" would render "Oca" and the two screens would disagree.
    // The value is read as UtcDateTime for the same reason the grid formats in UTC: the window is a stored calendar
    // DAY, and rendering it through a server offset east of Greenwich would show the day before.
    const string DayFormat = "MMM dd, yy";
    var dayCulture = CultureInfo.GetCultureInfo("en-US");
    Layout = "_LayoutTenantShell";
    var canManage = ViewData["CanManage"] as bool? ?? false;
    var statusClass = Model.IsActive ? "bg-label-success" : Model.IsClosed ? "bg-label-secondary" : "bg-label-warning";
    var scopeRef = Model.ScopeType switch
    {
        "country" => Model.CountryScope,
        "legal-entity" => Model.LegalEntityId?.ToString(),
        "business-unit" => Model.BusinessUnitId,
        _ => null
    };
}

<div class="cycle-period-details">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h5 class="mb-0">@SharedLocalizer["Details"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/CRM/CyclePeriods">@Localizer["CyclePeriodsTitle"]</a>
                    </li>
                    <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/CRM/CyclePeriods" class="btn btn-label-secondary">@SharedLocalizer["Back"]</a>
            @* A closed period accepts no mutation at all, so no edit affordance is offered for one. *@
            @if (canManage && !Model.IsClosed)
            {
                <a href="/CRM/CyclePeriods/Edit/@Model.CyclePeriodId" class="btn btn-primary">@SharedLocalizer["Edit"]</a>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Column (Left) -->
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IdentitySection"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-purchase-tag-alt"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["CycleCode"]</div>
                                <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.CycleCode) ? "-" : Model.CycleCode)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-file"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["CycleName"]</div>
                                <div class="backbone-preview-value mt-1">@(string.IsNullOrWhiteSpace(Model.CycleName) ? "-" : Model.CycleName)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Year"]</div>
                                <div class="backbone-preview-value mt-1">@(Model.Year?.ToString() ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-sort-a-z"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["SequenceInYear"]</div>
                                <div class="backbone-preview-value mt-1">@(Model.SequenceInYear?.ToString() ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar-event"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["StartDate"]</div>
                                <div class="backbone-preview-value mt-1">@(Model.StartDate?.UtcDateTime.ToString(DayFormat, dayCulture) ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar-check"></i>
                            <div>
                                @* Inclusive: the last day named is part of the period. *@
                                <div class="backbone-preview-label">@Localizer["EndDate"]</div>
                                <div class="backbone-preview-value mt-1">@(Model.EndDate?.UtcDateTime.ToString(DayFormat, dayCulture) ?? "-")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-3">@SharedLocalizer["Description"]</h6>
                <div class="backbone-preview-description">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</div>
            </section>
        </div>

        <!-- Sidebar Column (Right) -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ScopeSection"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-target-lock"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ScopeType"]</div>
                                <div class="backbone-preview-value mt-1">
                                    <span class="badge bg-label-primary">@Localizer["ScopeType_" + Model.ScopeType]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-map-pin"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ScopeRef"]</div>
                                @* A business unit is shown with the country it was chosen under ("TR / alpha"). The
                                   country is CONTEXT, not identity — the scope reference is the unit alone. *@
                                <div class="backbone-preview-value mt-1">
                                    @if (string.IsNullOrWhiteSpace(scopeRef))
                                    {
                                        @Localizer["ScopeTenantWide"].Value
                                    }
                                    else if (!string.IsNullOrWhiteSpace(Model.BusinessUnitCountryContext))
                                    {
                                        <span class="text-muted" title="@Localizer["BusinessUnitCountryContext"]">@Model.BusinessUnitCountryContext</span>
                                        <span class="text-muted"> / </span>
                                        <span>@scopeRef</span>
                                    }
                                    else
                                    {
                                        @scopeRef
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.BusinessUnitSource))
                    {
                        <div class="col-12">
                            <div class="backbone-preview-field">
                                <i class="bx bx-shape-square"></i>
                                <div>
                                    @* Provenance only: it says how the code was chosen, never which scope the period is
                                       in. Two periods on the same code are the same scope whatever this says. *@
                                    <div class="backbone-preview-label">@Localizer["BusinessUnitSourceLabel"]</div>
                                    <div class="mt-1">
                                        <span class="badge bg-label-secondary">@Localizer["BusinessUnitSource_" + Model.BusinessUnitSource]</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["LifecycleSection"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-check-shield"></i>
                            <div>
                                <div class="backbone-preview-label">@SharedLocalizer["Status"]</div>
                                <div class="mt-1">
                                    <span class="badge @statusClass">@Localizer["CycleStatus_" + Model.CycleStatus]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-git-branch"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Version"]</div>
                                <div class="backbone-preview-value mt-1">@(Model.ExpectedVersion?.ToString() ?? "-")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
