@model Diten.Web.Models.CRM.CyclePeriodScopeOptionsViewModel
@using Diten.Web.Views.CRM.CyclePeriods
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CyclePeriodsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* WP-CYC-UI-1 (K-6) — "which period is in force for this unit on this day?". It asks the runtime's resolve-active,
   which considers ACTIVE periods only and walks business unit › legal entity › country › tenant. The three answers
   are told apart: resolved (a period), none (an answer, not an error) and ambiguous (a data problem — never resolved
   to a period of the screen's choosing). The unit lists are the same governed sources the panel uses. *@
<div id="finderCard" class="card mb-3 d-none">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-12 col-lg-4">
                <h6 class="mb-1">@Localizer["FinderTitle"]</h6>
                <p class="text-muted small mb-3">@Localizer["FinderHint"]</p>
                <form id="finderForm" class="d-flex flex-column gap-3" data-no-tracker>
                    <div>
                        <label for="finderLevel" class="form-label">@Localizer["FinderUnit"]</label>
                        <select id="finderLevel" class="form-select">
                            <option value="tenant">@Localizer["ScopeType_tenant"]</option>
                            <option value="country">@Localizer["ScopeType_country"]</option>
                            <option value="legal-entity">@Localizer["ScopeType_legal-entity"]</option>
                            <option value="business-unit">@Localizer["ScopeType_business-unit"]</option>
                        </select>
                    </div>
                    <div class="finder-ref d-none" data-finder-ref="country">
                        <label for="finderCountry" class="form-label">@Localizer["CountryScope"]</label>
                        <select id="finderCountry" class="form-select">
                            <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                            @foreach (var option in Model.Countries)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                    <div class="finder-ref d-none" data-finder-ref="legal-entity">
                        <label for="finderLegalEntity" class="form-label">@Localizer["LegalEntity"]</label>
                        <select id="finderLegalEntity" class="form-select">
                            <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                            @foreach (var option in Model.LegalEntities)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                    <div class="finder-ref d-none" data-finder-ref="business-unit">
                        <label for="finderBusinessUnit" class="form-label">@Localizer["BusinessUnitId"]</label>
                        <select id="finderBusinessUnit" class="form-select">
                            <option value="">@SharedLocalizer["SelectPlaceholder"]</option>
                            @foreach (var option in Model.BusinessUnits)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="finderDate" class="form-label">@Localizer["FinderDate"]</label>
                        <input id="finderDate" type="date" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary align-self-start">
                        <i class="icon-base bx bx-search me-1"></i>@Localizer["FinderSubmit"]
                    </button>
                </form>
            </div>
            <div class="col-12 col-lg-8">
                <div id="finderResult" aria-live="polite">
                    <p class="text-muted mb-0">@Localizer["FinderIdle"]</p>
                </div>
            </div>
        </div>
    </div>
</div>
