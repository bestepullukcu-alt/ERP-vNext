@using Diten.Web.Views.Meetings
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MeetingsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.Views.Meetings.MinutesEditor.MinutesEditorIndex> EditorLocalizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = EditorLocalizer["MinutesTitle"].Value;
    Layout = "_LayoutTenantShell";
    var meetingId = ViewData["MeetingId"] as string ?? string.Empty;
}

@* MOD-0357 S6 (pack §5 "2a. TAB ≠ PAGE") — its OWN page, never a Details tab: a published minutes version is a
   record with its own lifecycle (draft/publish/correct) and its own permission pair (MinutesWrite/MinutesPublish),
   distinct from the meeting's own Update permission. Read-gated like Details: a caller who can see the meeting
   can see its minutes, whether or not they may write them (K-series "salt okuma Read ile görüntülenir"). *@
@if (!Perms.Has("platform.meetings.read"))
{
    <partial name="_AccessDenied" model="@EditorLocalizer["MinutesTitle"].Value" />
    return;
}

<div class="meetings-minutes-editor" id="minutesEditorRoot"
     data-meeting-id="@meetingId"
     data-can-write="@(Perms.Has("platform.meetings.minutes-write") ? "true" : "false")"
     data-can-publish="@(Perms.Has("platform.meetings.minutes-publish") ? "true" : "false")">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h5 class="mb-0">@EditorLocalizer["MinutesTitle"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/Meetings">@Localizer["MeetingsTitle"]</a></li>
                    <li class="breadcrumb-item"><a href="/Meetings/@meetingId">@SharedLocalizer["Details"]</a></li>
                    <li class="breadcrumb-item active text-primary">@EditorLocalizer["MinutesTitle"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2" id="minutesActionBar">
            <a href="/Meetings/@meetingId" class="btn btn-label-secondary">@SharedLocalizer["Back"]</a>
            <button type="button" class="btn btn-label-secondary d-none" id="btnSaveDraft">@EditorLocalizer["SaveDraft"]</button>
            <button type="button" class="btn btn-primary d-none" id="btnPublish">@EditorLocalizer["Publish"]</button>
            <button type="button" class="btn btn-label-warning d-none" id="btnCorrect">@EditorLocalizer["PublishCorrection"]</button>
        </div>
    </div>

    <div id="minutesNotFound" class="alert alert-warning d-none" role="alert">@Localizer["ErrorMeetingNotFound"]</div>

    <div id="minutesEditorBody" class="d-none">
        <div class="d-flex align-items-center gap-2 mb-4">
            <span class="fw-semibold">@EditorLocalizer["MeetingTitleLabel"]:</span>
            <span id="mMeetingTitle">-</span>
            <span class="badge ms-2" id="mStatusBadge">-</span>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-8 d-flex flex-column gap-4">
                <partial name="~/Views/Meetings/MinutesEditor/_Decisions.cshtml" />
            </div>
            <div class="col-12 col-lg-4 d-flex flex-column gap-4">
                <partial name="~/Views/Meetings/MinutesEditor/_Attendance.cshtml" />

                <section class="card p-4">
                    <h6 class="card-section-title mb-3"><i class="bx bx-history"></i>@EditorLocalizer["HistorySection"]</h6>
                    <ul class="list-group" id="versionHistoryList"></ul>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* The GENERAL Meetings payload — the reason-code bridge (MEETING_MINUTES_*, MEETING_DECISION_NOT_FOUND,
       MEETING_ATTENDEE_NOT_FOUND, …) and MeetingsApi both need window.MeetingsL10n regardless of which screen
       calls them (same posture MeetingTypes/Index.cshtml already takes). *@
    <partial name="~/Views/Meetings/_IndexL10n.cshtml" />
    <script src="~/assets/js/Meetings/index.l10n.js" asp-append-version="true"></script>
    @* This screen's OWN labels (window.MinutesEditorL10n). *@
    <partial name="~/Views/Meetings/MinutesEditor/_IndexL10n.cshtml" />
    <script src="~/assets/js/Meetings/minutes-editor.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/shared/premium-modal.js" asp-append-version="true"></script>
    <script src="~/assets/js/Meetings/api.js" asp-append-version="true"></script>
    @* MOD-0357 S4/S6 — the bridge's assignee picker reaches MOD-0024 through its own client, same as Details. *@
    <script src="~/assets/js/Tasks/api.js" asp-append-version="true"></script>
    <script src="~/assets/js/shared/diten-dialog.js" asp-append-version="true"></script>
    <script src="~/assets/js/shared/diten-related-records.js" asp-append-version="true"></script>
    @* MOD-0357 S6 — the "create task from decision" affordance opens the SAME dialog S4's agenda-item tasks do. *@
    <script src="~/assets/js/Meetings/task-from-meeting-dialog.js" asp-append-version="true"></script>
    <script src="~/assets/js/Meetings/minutes-editor.js" asp-append-version="true"></script>
}
