@using Diten.Web.Views.Meetings
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MeetingsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Filter Chip: Segment (upcoming/past) *@
                    <div class="filter-chip filter-segment">
                        <select id="filterSegment" class="form-select form-select-sm select2" data-placeholder="@Localizer["Segment"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="upcoming">@Localizer["SegmentUpcoming"]</option>
                            <option value="past">@Localizer["SegmentPast"]</option>
                        </select>
                    </div>

                    @* Filter Chip: Meeting type (Multi-select, populated from the type lookup) *@
                    <div class="filter-chip filter-meeting-type">
                        <select id="filterMeetingType" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["MeetingType"]">
                        </select>
                    </div>

                    @* Filter Chip: Organizer (Multi-select, populated from the rows already on screen) *@
                    <div class="filter-chip filter-organizer">
                        <select id="filterOrganizer" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Organizer"]">
                        </select>
                    </div>

                    @* Filter Chip: I am an attendee *@
                    <div class="filter-chip filter-i-am-attendee form-check form-switch d-flex align-items-center">
                        <input type="checkbox" class="form-check-input" id="filterIAmAttendee" role="switch">
                        <label class="form-check-label ms-2" for="filterIAmAttendee">@Localizer["IAmAttendeeFilter"]</label>
                    </div>

                    @* Filter Chip: Has linked tasks *@
                    <div class="filter-chip filter-has-linked-tasks form-check form-switch d-flex align-items-center">
                        <input type="checkbox" class="form-check-input" id="filterHasLinkedTasks" role="switch">
                        <label class="form-check-label ms-2" for="filterHasLinkedTasks">@Localizer["HasLinkedTasksFilter"]</label>
                    </div>

                    @* Filter Chip: Date range *@
                    <div class="filter-chip filter-date-from">
                        <input type="date" id="filterFromDate" class="form-control form-control-sm" placeholder="@Localizer["FromDate"]" />
                    </div>
                    <div class="filter-chip filter-date-to">
                        <input type="date" id="filterToDate" class="form-control form-control-sm" placeholder="@Localizer["ToDate"]" />
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
