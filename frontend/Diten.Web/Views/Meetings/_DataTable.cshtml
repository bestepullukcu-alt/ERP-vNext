@using Diten.Web.Views.Meetings
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MeetingsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-meetings" data-dt-standard="v2" class="datatables-meetings table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["Title"]</th>
                    <th>@Localizer["MeetingType"]</th>
                    <th>@Localizer["StartAt"]</th>
                    <th>@Localizer["EndAt"]</th>
                    <th>@Localizer["Organizer"]</th>
                    <th>@Localizer["IAmAttendee"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th>@Localizer["HasLinkedTasks"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
