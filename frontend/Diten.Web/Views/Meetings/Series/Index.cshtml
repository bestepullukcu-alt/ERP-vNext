@using Diten.Web.Views.Meetings.Series
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MeetingSeriesIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["MeetingSeriesTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* UAS-001 — nothing below this block is drawn for a user who cannot manage meeting series, mirroring
   Views/Meetings/MeetingTypes/Index.cshtml's own gate exactly (S8). *@
@if (!Perms.Has("platform.meetings.series-manage"))
{
    <partial name="_AccessDenied" model="@Localizer["MeetingSeriesTitle"].Value" />
    return;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@Localizer["MeetingSeriesTitle"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>
</div>

@* Contract markers are rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-meeting-series" data-dt-standard="v2"> *@
<partial name="~/Views/Meetings/Series/_DataTable.cshtml" />

@section Scripts {
    @* The GENERAL Meetings payload (window.MeetingsL10n) is loaded too — Meetings/api.js's reason-code bridge
       (MEETING_SERIES_* included) reads it regardless of which screen calls the API. *@
    <partial name="~/Views/Meetings/_IndexL10n.cshtml" />
    <script src="~/assets/js/Meetings/index.l10n.js" asp-append-version="true"></script>
    @* Contract marker: <partial name="_IndexL10n" /> — this screen's OWN labels (window.MeetingSeriesL10n). *@
    <partial name="~/Views/Meetings/Series/_IndexL10n.cshtml" />
    <script src="~/assets/js/Meetings/series/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Meetings/api.js" asp-append-version="true"></script>
    <script src="~/assets/js/Meetings/series/index.js" asp-append-version="true"></script>
}
