@using Diten.Web.Views.Meetings.Series
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MeetingSeriesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject IHtmlLocalizer<Diten.Web.Views.Meetings.MeetingsIndex> MeetingsLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Meetings/Series">@Localizer["MeetingSeriesTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/Meetings/Series" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="meetingSeriesForm" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

<form id="meetingSeriesForm" class="needs-validation" novalidate data-form-mode="@(isEdit ? "edit" : "create")">
    <input type="hidden" id="meetingSeriesId" value="@(ViewData["MeetingSeriesId"] as string ?? string.Empty)" />
    <input type="hidden" id="meetingSeriesExpectedVersion" value="" />

    <div id="formValidationSummary" class="alert alert-danger d-none" role="alert"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-id-card"></i>@Localizer["IdentitySection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="fieldName" class="form-label fw-medium">@SharedLocalizer["Name"] <span class="text-danger">*</span></label>
                            <div class="diten-field">
                                <i class="bx bx-text diten-field-icon" aria-hidden="true"></i>
                                <input type="text" id="fieldName" class="form-control" maxlength="200" required />
                            </div>
                            <span class="text-danger small mt-1 d-none" id="fieldNameError"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="fieldMeetingTypeId" class="form-label fw-medium">@MeetingsLocalizer["MeetingType"] <span class="text-danger">*</span></label>
                            <div class="diten-field">
                                <i class="bx bx-purchase-tag diten-field-icon" aria-hidden="true"></i>
                                <select id="fieldMeetingTypeId" class="select2 form-select" required></select>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="fieldLocation" class="form-label fw-medium">@MeetingsLocalizer["Location"]</label>
                            <div class="diten-field">
                                <i class="bx bx-map diten-field-icon" aria-hidden="true"></i>
                                <input type="text" id="fieldLocation" class="form-control" placeholder="@MeetingsLocalizer["LocationPlaceholder"]" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-calendar-event"></i>@Localizer["ScheduleSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label for="fieldFrequency" class="form-label fw-medium">@Localizer["Frequency"] <span class="text-danger">*</span></label>
                            <select id="fieldFrequency" class="form-select">
                                <option value="0">@Localizer["FrequencyWeekly"]</option>
                                <option value="1">@Localizer["FrequencyMonthly"]</option>
                                <option value="2">@Localizer["FrequencyQuarterly"]</option>
                                <option value="3">@Localizer["FrequencyYearly"]</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="fieldInterval" class="form-label fw-medium">@Localizer["Interval"]</label>
                            <input type="number" id="fieldInterval" class="form-control" min="1" value="1" />
                            <div class="form-text">@Localizer["IntervalHint"]</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="fieldDurationMinutes" class="form-label fw-medium">@Localizer["DurationMinutes"]</label>
                            <input type="number" id="fieldDurationMinutes" class="form-control" min="1" value="60" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="fieldStartsAt" class="form-label fw-medium">@MeetingsLocalizer["StartAt"] <span class="text-danger">*</span></label>
                            <input type="text" id="fieldStartsAt" class="form-control wcn-date-input" autocomplete="off" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="fieldEndsAt" class="form-label fw-medium">@MeetingsLocalizer["EndAt"]</label>
                            <input type="text" id="fieldEndsAt" class="form-control wcn-date-input" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="fieldLeadTimeDays" class="form-label fw-medium">@Localizer["LeadTimeDays"]</label>
                            <input type="number" id="fieldLeadTimeDays" class="form-control" min="1" max="90" value="14" />
                            <div class="form-text">@Localizer["LeadTimeDaysHint"]</div>
                        </div>
                        <div class="col-12 col-md-6 d-flex align-items-end">
                            <div>
                                <div class="backbone-preview-label">@Localizer["LastGeneratedAt"]</div>
                                <div class="backbone-preview-value" id="fieldLastGeneratedAt">@Localizer["LastGeneratedAtNever"]</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-group"></i>@Localizer["ParticipantsSection"]</h6>
                    <div class="mb-3">
                        <label for="fieldOrganizerUserId" class="form-label fw-medium">@MeetingsLocalizer["Organizer"] <span class="text-danger">*</span></label>
                        <select id="fieldOrganizerUserId" class="select2 form-select" data-placeholder="@MeetingsLocalizer["AttendeesPlaceholder"]"></select>
                    </div>
                    <div class="mb-0">
                        <label for="fieldAttendeeUserIds" class="form-label fw-medium">@MeetingsLocalizer["Attendees"]</label>
                        <select id="fieldAttendeeUserIds" class="select2 form-select" multiple data-placeholder="@MeetingsLocalizer["AttendeesPlaceholder"]"></select>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-toggle-left"></i>@Localizer["FlagsSection"]</h6>

                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" id="fieldChainAsFollowUp" role="switch" checked />
                        <label class="form-check-label" for="fieldChainAsFollowUp">@Localizer["ChainAsFollowUp"]</label>
                        <div class="form-text">@Localizer["ChainAsFollowUpHint"]</div>
                    </div>

                    <div class="form-check form-switch mb-0">
                        <input type="checkbox" class="form-check-input" id="fieldIsActive" role="switch" checked />
                        <label class="form-check-label" for="fieldIsActive">@Localizer["IsActive"]</label>
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>
