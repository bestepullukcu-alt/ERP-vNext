@using Diten.Web.Views.Meetings.Series
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MeetingSeriesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@inject IHtmlLocalizer<Diten.Web.Views.Meetings.MeetingsIndex> MeetingsLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-meeting-series" data-dt-standard="v2" class="datatables-meeting-series table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@SharedLocalizer["Name"]</th>
                    <th>@MeetingsLocalizer["MeetingType"]</th>
                    <th>@Localizer["Frequency"]</th>
                    <th>@Localizer["IsActive"]</th>
                    <th>@Localizer["LastGeneratedAt"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
