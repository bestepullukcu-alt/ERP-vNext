@using Diten.Web.Views.Meetings.MeetingTypes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MeetingTypesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Meetings/MeetingTypes">@Localizer["MeetingTypesTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/Meetings/MeetingTypes" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="meetingTypeForm" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

<form id="meetingTypeForm" class="needs-validation" novalidate data-form-mode="@(isEdit ? "edit" : "create")">
    <input type="hidden" id="meetingTypeId" value="@(ViewData["MeetingTypeId"] as string ?? string.Empty)" />
    <input type="hidden" id="meetingTypeExpectedVersion" value="" />

    <div id="formValidationSummary" class="alert alert-danger d-none" role="alert"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-id-card"></i>@Localizer["IdentitySection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="fieldName" class="form-label fw-medium">@Localizer["Name"] <span class="text-danger">*</span></label>
                            <div class="diten-field">
                                <i class="bx bx-text diten-field-icon" aria-hidden="true"></i>
                                <input type="text" id="fieldName" class="form-control" maxlength="200" required />
                            </div>
                            <span class="text-danger small mt-1 d-none" id="fieldNameError"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="fieldDefaultActionTaskTypeId" class="form-label fw-medium">@Localizer["DefaultActionTaskType"]</label>
                            <div class="diten-field">
                                <i class="bx bx-task diten-field-icon" aria-hidden="true"></i>
                                <select id="fieldDefaultActionTaskTypeId" class="select2 form-select">
                                    <option value="">@SharedLocalizer["ShowAll"]</option>
                                </select>
                            </div>
                            <div class="form-text">@Localizer["DefaultActionTaskTypeHint"]</div>
                        </div>
                    </div>
                </div>
            </section>

            @*
                ── AGENDA TEMPLATE — a repeatable list of plain lines (≤ 20 × ≤ 200 chars, pack §"MeetingType").
                Pattern borrowed from Views/Tasks/TaskTypes/_ClosureOutcomeRow.cshtml (one row declared once, a
                <template> the Add button clones), adapted to this module's own fetch/JSON architecture: there is
                no server model binding here, so the row lives as a plain <template> instead of a Razor partial
                bound by index, and JS reads the current rows straight from the DOM on submit.
            *@
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-2"><i class="bx bx-list-ol"></i>@Localizer["AgendaTemplate"]</h6>
                    <p class="form-text mb-3">@Localizer["AgendaTemplateHint"]</p>

                    <div data-agenda-template-list></div>

                    <p class="text-muted mb-3 d-none" data-agenda-template-empty>@Localizer["AgendaTemplateEmpty"]</p>

                    <button type="button" class="btn btn-label-primary" data-agenda-template-add>
                        <i class="bx bx-plus me-1"></i>@Localizer["AgendaTemplateAdd"]
                    </button>

                    <template data-agenda-template-row-template>
                        <div class="row g-2 align-items-center mb-2" data-agenda-template-row>
                            <div class="col-auto d-flex flex-column">
                                <button type="button" class="btn btn-sm btn-text-secondary p-0" data-agenda-template-up aria-label="@Localizer["AgendaTemplateMoveUp"]">
                                    <i class="bx bx-chevron-up"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-text-secondary p-0" data-agenda-template-down aria-label="@Localizer["AgendaTemplateMoveDown"]">
                                    <i class="bx bx-chevron-down"></i>
                                </button>
                            </div>
                            <div class="col">
                                <input type="text" class="form-control" maxlength="200" data-agenda-template-text
                                       placeholder="@Localizer["AgendaTemplateLinePlaceholder"]" />
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-label-danger" data-agenda-template-remove aria-label="@Localizer["AgendaTemplateRemove"]">
                                    <i class="bx bx-trash"></i>
                                </button>
                            </div>
                        </div>
                    </template>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="card-section-title mb-4"><i class="bx bx-toggle-left"></i>@Localizer["FlagsSection"]</h6>

                    @* K8 — all three default OFF; never inferred from the type's name or domain. *@
                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" id="fieldIsQualityRecord" role="switch" />
                        <label class="form-check-label" for="fieldIsQualityRecord">@Localizer["IsQualityRecord"]</label>
                        <div class="form-text">@Localizer["IsQualityRecordHint"]</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" id="fieldRequiresESignature" role="switch" />
                        <label class="form-check-label" for="fieldRequiresESignature">@Localizer["RequiresESignature"]</label>
                        <div class="form-text">@Localizer["RequiresESignatureHint"]</div>
                    </div>

                    <div class="form-check form-switch mb-0">
                        <input type="checkbox" class="form-check-input" id="fieldAttendanceMandatory" role="switch" />
                        <label class="form-check-label" for="fieldAttendanceMandatory">@Localizer["AttendanceMandatory"]</label>
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>
