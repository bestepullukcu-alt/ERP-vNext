@using Diten.Web.Views.Meetings.MeetingTypes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MeetingTypesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Filter Chip: Quality record (tri-state) *@
                    <div class="filter-chip filter-quality-record">
                        <select id="filterIsQualityRecord" class="form-select form-select-sm select2" data-placeholder="@Localizer["IsQualityRecord"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="true">@Localizer["Yes"]</option>
                            <option value="false">@Localizer["No"]</option>
                        </select>
                    </div>

                    @* Filter Chip: Requires e-signature (tri-state) *@
                    <div class="filter-chip filter-requires-esignature">
                        <select id="filterRequiresESignature" class="form-select form-select-sm select2" data-placeholder="@Localizer["RequiresESignature"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="true">@Localizer["Yes"]</option>
                            <option value="false">@Localizer["No"]</option>
                        </select>
                    </div>

                    @* Filter Chip: Attendance mandatory (tri-state) *@
                    <div class="filter-chip filter-attendance-mandatory">
                        <select id="filterAttendanceMandatory" class="form-select form-select-sm select2" data-placeholder="@Localizer["AttendanceMandatory"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="true">@Localizer["Yes"]</option>
                            <option value="false">@Localizer["No"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
