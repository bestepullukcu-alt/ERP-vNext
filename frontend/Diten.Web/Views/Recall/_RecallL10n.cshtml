@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.Views.Recall.Recall> Localizer
@*
    The pages' vocabulary (pack §11.6): exactly Diten.Web.Views.Recall.Recall.Keys, key → value in the reader's language. The scripts
    read the same dotted names (window.RecallL10n); a missing one is reported by recall.l10n.js, never replaced by hardcoded text.
*@
@if (Context.Items["RecallL10nRendered"] is not true)
{
    Context.Items["RecallL10nRendered"] = true;
    <script id="recall-l10n" type="application/json">@Json.Serialize(Diten.Web.Views.Recall.Recall.Keys.ToDictionary(k => k, k => Localizer[k].Value))</script>
    <script src="~/assets/js/Recall/recall.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Recall/recall-ui.js" asp-append-version="true"></script>
}
