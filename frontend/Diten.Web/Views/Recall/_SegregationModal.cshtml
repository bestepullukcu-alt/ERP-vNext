@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Diten.Web.Views.Recall.Recall> Localizer
@*
    MOD-0177 R7a — "Fiziksel ayırmayı teyit et" (RECALL_SEGREGATION_CONFIRM, recall.segregations.confirm): a record that the held line is physically
    set apart (mockup L:268). No movement — moving the stock is the user's own location transfer.
*@
<div class="modal fade" id="rc-seg-modal" tabindex="-1" aria-labelledby="rc-seg-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="rc-seg-form" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="rc-seg-title">@Localizer["Recall.Seg.Title"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Recall.Common.Cancel"]"></button>
            </div>
            <div class="modal-body">
                <p class="small mb-3" id="rc-seg-line"></p>
                <div class="mb-3">
                    <label class="form-label" for="rc-seg-qty">@Localizer["Recall.Seg.Quantity"] <span class="text-muted" id="rc-seg-unit"></span></label>
                    <input type="number" class="form-control" id="rc-seg-qty" min="0" step="any" required />
                </div>
                <div>
                    <label class="form-label" for="rc-seg-note">@Localizer["Recall.Seg.Note"]</label>
                    <textarea class="form-control" id="rc-seg-note" rows="2" maxlength="1000"></textarea>
                </div>
                <p class="small text-muted mt-3 mb-0">@Localizer["Recall.Seg.Hint"]</p>
                <div class="alert alert-danger small d-none mt-3 mb-0" id="rc-seg-error" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@Localizer["Recall.Common.Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Localizer["Recall.Stock.Segregate"]</button>
            </div>
        </form>
    </div>
</div>
