<div class="card mb-4">
    <div class="card-header p-3 border-0">
        <h6 class="mb-0 fw-semibold">Metadata Summary</h6>
    </div>
    <div class="card-body p-3 pt-0">
        <div class="small mb-2">
            <span class="text-muted d-block">Source Reference</span>
            <a href="#" class="fw-semibold d-none" id="taskSourceRefLink"></a>
            <span class="fw-semibold" id="taskSourceRefValue">-</span>
            <div class="text-muted small text-truncate" id="taskSourceTitleValue"></div>
        </div>
        <div class="small mb-2">
            <span class="text-muted d-block">Source Relation Type</span>
            <span id="taskSourceRelationValue">-</span>
        </div>

        <div class="small mb-2">
            <span class="text-muted d-block">Reviewer</span>
            <span id="taskReviewerValue">-</span>
        </div>

        <div class="small mb-2">
            <span class="text-muted d-block">Assignment Context</span>
            <span id="taskReassignmentValue">-</span>
        </div>

        <div class="small mb-2">
            <span class="text-muted d-block">Planned At</span>
            <span id="taskPlannedAtValue">-</span>
        </div>

        <div class="small mb-2">
            <span class="text-muted d-block">Dependency State</span>
            <span class="badge bg-label-secondary" id="taskDependenciesStateBadge">-</span>
        </div>

        <div class="small">
            <span class="text-muted d-block mb-1">Tags</span>
            <div class="d-flex flex-wrap gap-1" id="taskTagsList">
                <span class="text-muted">-</span>
            </div>
        </div>
    </div>
</div>
