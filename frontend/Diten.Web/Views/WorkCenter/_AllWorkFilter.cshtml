@using Diten.Web.Views.WorkCenter
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WorkCenterIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* WorkCenter All Work — Inline Collapsible Filter Panel *@
<div id="allWorkFilterHost">
    <div class="collapse" id="allWorkFilterCollapse">
        <div class="px-0 pb-3 pt-0">
            <form class="m-0" id="allWorkFilterForm">
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip">
                        <select id="allWorkFilterStatus" class="form-select form-select-sm wc-filter-select">
                            <option value="">@Localizer["FilterStatus"]</option>
                            <option value="Backlog">Backlog</option>
                            <option value="InProgress">In Progress</option>
                            <option value="InReview">In Review</option>
                            <option value="Done">Done</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnAllWorkFilterApply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnAllWorkFilterReset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
