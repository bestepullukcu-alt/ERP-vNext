@using Diten.Web.Views.WorkCenter
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WorkCenterIndex> Localizer
@{
    ViewData["Title"] = Localizer["TaskDetailTitle"].Value;
    Layout = "_LayoutBackbone";
    var taskId = ViewBag.TaskId as string ?? string.Empty;
    var returnUrl = ViewBag.ReturnUrl as string ?? "/WorkCenter";
}

<div id="taskDetailPage"
     data-task-id="@taskId"
     data-return-url="@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(returnUrl))">

    <partial name="TaskHeader" />
    <partial name="TaskStepBar" />

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <partial name="TaskDescription" />
            <partial name="TaskSubtasks" />
            <partial name="TaskActivity" />
        </div>
        <div class="col-12 col-lg-4">
            <partial name="TaskActionsPanel" />
            <partial name="TaskTimeEntry" />
            <partial name="TaskMetadataSummary" />
            <partial name="TaskDependencies" />
            <partial name="TaskSecondaryMeta" />
        </div>
    </div>
</div>

@section Scripts {
<script id="task-detail-l10n" type="application/json">
    @Json.Serialize(new
    {
        TaskDetailTitle  = Localizer["TaskDetailTitle"].Value,
        Back             = Localizer["Back"].Value,
        Description      = Localizer["Description"].Value,
        Subtasks         = Localizer["Subtasks"].Value,
        Activity         = Localizer["Activity"].Value,
        WriteComment     = Localizer["WriteComment"].Value,
        Send             = Localizer["Send"].Value,
        Actions          = Localizer["Actions"].Value,
        TimeEntry        = Localizer["TimeEntry"].Value,
        TimeNote         = Localizer["TimeNote"].Value,
        Log              = Localizer["Log"].Value,
        StartTimer       = Localizer["StartTimer"].Value,
        StopTimer        = Localizer["StopTimer"].Value,
        NoTimeLogged     = Localizer["NoTimeLogged"].Value,
        Dependencies     = Localizer["Dependencies"].Value,
        BlockedBy        = Localizer["BlockedBy"].Value,
        Blocks           = Localizer["Blocks"].Value,
        RejectionNote    = Localizer["RejectionNote"].Value,
        RejectionNotePlaceholder = Localizer["RejectionNotePlaceholder"].Value,
        ConfirmReject    = Localizer["ConfirmReject"].Value,
        Accept           = Localizer["Accept"].Value,
        Reject           = Localizer["Reject"].Value,
        RequestInfo      = Localizer["RequestInfo"].Value,
        Reassign         = Localizer["Reassign"].Value,
        Plan             = Localizer["Plan"].Value,
        StartWork        = Localizer["StartWork"].Value,
        LogTime          = Localizer["LogTime"].Value,
        Complete         = Localizer["Complete"].Value,
        Block            = Localizer["Block"].Value,
        Unblock          = Localizer["Unblock"].Value,
        Approve          = Localizer["Approve"].Value,
        RejectReview     = Localizer["RejectReview"].Value,
        TimeEntryRequired = Localizer["TimeEntryRequired"].Value,
        CommentAdded     = Localizer["CommentAdded"].Value,
        TimeLogged       = Localizer["TimeLogged"].Value,
        ActionAcceptSuccess   = Localizer["ActionAcceptSuccess"].Value,
        ActionRejectSuccess   = Localizer["ActionRejectSuccess"].Value,
        ActionReassignSuccess = Localizer["ActionReassignSuccess"].Value,
        Project               = "Project",
        Source                = "Source",
        Tags                  = "Tags",
        Reviewer              = "Reviewer",
        Watchers              = "Watchers",
        Attachments           = "Attachments",
        PlannedAt             = "Planned At",
        MetadataSummary       = "Metadata Summary",
        SecondaryInfo         = "Secondary Details",
        Market                = "Market",
        Domain                = "Domain",
        ExternalParty         = "External Party",
        Estimation            = "Estimation",
        DependencyState       = "Dependency State",
        NoTags                = "No tags",
        NoWatchers            = "No watchers",
        NoAttachments         = "No attachments",
        NoDependencies        = "No dependencies",
        NoBlockers            = "No blockers",
        NoDependentTasks      = "No dependent tasks",
        DependencyStateFilled = "Has dependencies",
        PlannedDateUnknown    = "Not planned",
        CreatedBy             = "Created By",
        SourceReference       = "Source Reference",
        AssignmentContext     = "Assignment Context",
        ReassignedFrom        = "Reassigned from",
        InitialAssignment     = "Initial assignment",
        TotalLoggedTime       = "Total Logged Time",
        EstimatedTime         = "Estimated Time",
        Comparison            = "Comparison",
        RemainingTime         = "Remaining Time",
        Overrun               = "Overrun",
        OnTrack               = "On Track",
        DueSoon               = "Due Soon",
        Overdue               = "Overdue",
        DueInDays             = "due in",
        DaysAgo               = "days ago",
        BlockedByDependency   = "Blocked",
        HasBlockers           = "Has blockers",
        BlockedStatusMismatch = "Dependency blockers exist",
        ChecklistCompleted    = "completed",
        NoEstimate            = "No estimate",
        SourceRelationType    = "Source Relation Type",
        UnderEstimateBy       = "Under estimate by",
        OnEstimate            = "On estimate"
    })
</script>
<script src="~/assets/js/WorkCenter/task-detail.js" asp-append-version="true"></script>
}
