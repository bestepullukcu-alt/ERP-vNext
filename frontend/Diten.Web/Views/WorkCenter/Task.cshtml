@using Diten.Web.Views.WorkCenter
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WorkCenterIndex> Localizer
@{
    ViewData["Title"] = Localizer["TaskDetailTitle"].Value;
    Layout = "_LayoutBackbone";

    var taskId = ViewBag.TaskId as string ?? string.Empty;
    var returnUrl = ViewBag.ReturnUrl as string ?? "/WorkCenter";
    var actingAs = Context.Request.Query["as"].ToString();
}

<div id="taskDetailPageV2"
     class="task-v2-page"
     data-task-id="@taskId"
     data-return-url="@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(returnUrl))"
     data-acting-as="@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(actingAs))">
    <div class="task-v2-loading py-5 text-center">
        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
        <p class="mt-3 mb-0 text-muted">Loading task detail...</p>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/WorkCenter/task-detail.js" asp-append-version="true"></script>
}
