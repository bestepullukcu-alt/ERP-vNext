@using Diten.Web.Views.WorkCenter
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WorkCenterIndex> Localizer

<div class="card mb-4" id="taskTimeEntryCard">
    <div class="card-header p-3 border-0 d-flex align-items-center justify-content-between task-collapse-trigger"
         data-bs-toggle="collapse"
         data-bs-target="#taskTimeEntryCollapse"
         aria-expanded="true"
         aria-controls="taskTimeEntryCollapse">
        <h6 class="mb-0 fw-semibold d-flex align-items-center gap-2">
            @Localizer["TimeEntry"]
            <span class="badge bg-label-secondary" id="taskTotalTime">0h 0m</span>
        </h6>
        <i class="bx bx-chevron-down icon-base text-muted task-collapse-chevron task-collapse-chevron--open"></i>
    </div>
    <div class="collapse show" id="taskTimeEntryCollapse">
        <div class="card-body p-3 pt-0">
            <div id="taskTimeStateMessage" class="small text-muted mb-2 d-none"></div>
            <div class="task-time-grid mb-3">
                <div class="task-time-units d-flex align-items-center gap-2">
                    <input type="number"
                           id="taskTimeHours"
                           class="form-control form-control-sm text-center task-time-unit-input"
                           min="0" max="23"
                           placeholder="h" />
                    <span class="text-muted small">h</span>
                    <input type="number"
                           id="taskTimeMinutes"
                           class="form-control form-control-sm text-center task-time-unit-input"
                           min="0" max="59"
                           placeholder="m" />
                    <span class="text-muted small">m</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input type="text"
                           id="taskTimeNote"
                           class="form-control form-control-sm flex-grow-1"
                           placeholder="@Localizer["TimeNote"]" />
                    <button type="button"
                            class="btn btn-sm btn-label-primary flex-shrink-0"
                            id="taskTimeLogBtn">
                        @Localizer["Log"]
                    </button>
                </div>
            </div>

            <div class="task-timer-row d-flex align-items-center gap-2 mb-3">
                <button type="button"
                        class="btn btn-sm btn-icon btn-label-secondary"
                        id="taskTimerToggle"
                        title="@Localizer["StartTimer"]">
                    <i class="bx bx-play icon-base" id="taskTimerIcon"></i>
                </button>
                <span class="text-muted small" id="taskTimerDisplay">0:00:00</span>
            </div>

            <div class="small border rounded p-2 mb-3 bg-light" id="taskTimeSummary">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Total Logged Time</span>
                    <span class="fw-semibold" id="taskLoggedSummary">0h 0m</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Estimated Time</span>
                    <span class="fw-semibold" id="taskEstimatedSummary">-</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Comparison</span>
                    <span class="fw-semibold" id="taskVarianceSummary">-</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Remaining Time</span>
                    <span class="fw-semibold" id="taskRemainingSummary">-</span>
                </div>
            </div>

            <ul class="list-unstyled mb-0" id="taskTimeLogList">
                <li class="text-muted small">@Localizer["NoTimeLogged"]</li>
            </ul>
        </div>
    </div>
</div>
