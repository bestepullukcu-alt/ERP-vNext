@using Diten.Web.Views.WorkCenter
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WorkCenterIndex> Localizer

<div class="tab-pane fade show active" id="workcenter-inbox-pane" role="tabpanel" aria-labelledby="workcenter-inbox-tab">
    <div class="card mb-4">
        <div class="card-body px-4 py-3 d-flex flex-row align-items-center justify-content-between gap-3">
            <div class="d-none d-lg-inline-flex align-items-center gap-2 lh-1">
                <i class="icon-base bx bx-envelope-open text-primary icon-md d-flex align-items-center justify-content-center"></i>
                <h6 class="mb-0 lh-1">@Localizer["InboxInfoTitle"]</h6>
            </div>
            <div class="d-flex align-items-center gap-2 flex-grow-1 flex-lg-grow-0">
                <input type="search" id="inboxSearchInput"
                       class="form-control form-control-sm wc-inbox-search flex-grow-1"
                       placeholder="@Localizer["SearchPlaceholder"]"
                       autocomplete="off" />
                <button type="button" id="inboxFilterBtn"
                        class="btn btn-sm btn-icon btn-label-secondary position-relative flex-shrink-0"
                        aria-label="@Localizer["Filter"]"
                        title="@Localizer["Filter"]"
                        data-bs-toggle="collapse"
                        data-bs-target="#inboxFilterCollapse"
                        aria-expanded="false"
                        aria-controls="inboxFilterCollapse">
                    <i class="bx bx-filter-alt icon-base"></i>
                </button>
            </div>
        </div>
        <partial name="_InboxFilter" />
    </div>

    <partial name="InboxList" view-data='new ViewDataDictionary(ViewData)
    {
        ["ListId"] = "inbox",
        ["EmptyTitle"] = Localizer["InboxEmptyTitle"].Value,
        ["EmptyDescription"] = Localizer["InboxEmptyDescription"].Value
    }' />
    <div class="d-flex justify-content-center mt-3">
        <button type="button" id="inboxLoadMoreBtn" class="btn btn-sm btn-label-secondary d-none">
            @Localizer["LoadMore"]
        </button>
    </div>
</div>
