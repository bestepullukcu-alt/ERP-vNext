@model Diten.Web.Models.DataKnowledge.MetricDefinitionsOwnership.MetricDefinitionsOwnershipEditViewModel
@using Diten.Web.Views.DataKnowledge.MetricDefinitionsOwnership
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MetricDefinitionsOwnershipIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var title = Localizer["FormTitleCreate"].Value;
    // Readiness states offered in the form: Draft, Ready, Deferred, Blocked, NotRequired.
    // Archived is excluded (it is controlled by the delete operation server-side).
    var states = new (int Value, string Label)[]
    {
        (0, Localizer["StateDraft"].Value),
        (1, Localizer["StateReady"].Value),
        (2, Localizer["StateDeferred"].Value),
        (3, Localizer["StateBlocked"].Value),
        (4, Localizer["StateNotRequired"].Value)
    };
    Func<string, int, IHtmlContent> stateSelect = (name, selected) =>
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<select id=\"{name}\" name=\"{name}\" class=\"select2 form-select\">");
        foreach (var s in states)
        {
            var sel = s.Value == selected ? " selected" : string.Empty;
            sb.Append($"<option value=\"{s.Value}\"{sel}>{System.Net.WebUtility.HtmlEncode(s.Label)}</option>");
        }
        sb.Append("</select>");
        return Html.Raw(sb.ToString());
    };
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/DataKnowledge/MetricDefinitionsOwnership">@Localizer["MetricDefinitionsOwnershipTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/DataKnowledge/MetricDefinitionsOwnership" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="metricDefinitionsOwnershipForm" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

<form id="metricDefinitionsOwnershipForm" asp-controller="MetricDefinitionsOwnership" asp-action="Create" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Main Column -->
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["IdentitySection"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Code" class="form-label fw-medium">@Localizer["Code"] <span class="text-danger">*</span></label>
                        <input asp-for="Code" class="form-control" maxlength="64" placeholder="@Localizer["CodePlaceholder"]" required />
                        <span asp-validation-for="Code" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="SourceContractVersion" class="form-label fw-medium">@Localizer["SourceContractVersion"] <span class="text-danger">*</span></label>
                        <input asp-for="SourceContractVersion" class="form-control" maxlength="32" placeholder="1.0.0" required />
                        <span asp-validation-for="SourceContractVersion" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="DisplayName" class="form-label fw-medium">@Localizer["DisplayName"] <span class="text-danger">*</span></label>
                        <input asp-for="DisplayName" class="form-control" maxlength="128" placeholder="@Localizer["DisplayNamePlaceholder"]" required />
                        <span asp-validation-for="DisplayName" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="MetricDefinitionsOwnershipReadinessVersion" class="form-label fw-medium">@Localizer["MetricDefinitionsOwnershipReadinessVersion"]</label>
                        <input asp-for="MetricDefinitionsOwnershipReadinessVersion" type="number" min="1" class="form-control" />
                        <span asp-validation-for="MetricDefinitionsOwnershipReadinessVersion" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="MetricDefinitionsOwnershipReadinessState" class="form-label fw-medium">@Localizer["MetricDefinitionsOwnershipReadinessState"]</label>
                        @stateSelect("MetricDefinitionsOwnershipReadinessState", Model.MetricDefinitionsOwnershipReadinessState)
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["WorkflowSection"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12 col-md-6">
                        <label for="DefinitionCatalogBoundaryState" class="form-label fw-medium">@Localizer["DefinitionCatalogBoundaryState"]</label>
                        @stateSelect("DefinitionCatalogBoundaryState", Model.DefinitionCatalogBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="OwnershipAssignmentIntakeBoundaryState" class="form-label fw-medium">@Localizer["OwnershipAssignmentIntakeBoundaryState"]</label>
                        @stateSelect("OwnershipAssignmentIntakeBoundaryState", Model.OwnershipAssignmentIntakeBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="StewardshipScopeBoundaryState" class="form-label fw-medium">@Localizer["StewardshipScopeBoundaryState"]</label>
                        @stateSelect("StewardshipScopeBoundaryState", Model.StewardshipScopeBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="ApprovalControlBoundaryState" class="form-label fw-medium">@Localizer["ApprovalControlBoundaryState"]</label>
                        @stateSelect("ApprovalControlBoundaryState", Model.ApprovalControlBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="DefinitionReviewBoundaryState" class="form-label fw-medium">@Localizer["DefinitionReviewBoundaryState"]</label>
                        @stateSelect("DefinitionReviewBoundaryState", Model.DefinitionReviewBoundaryState)
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="AutomatedDecisionBoundaryState" class="form-label fw-medium">@Localizer["AutomatedDecisionBoundaryState"]</label>
                        @stateSelect("AutomatedDecisionBoundaryState", Model.AutomatedDecisionBoundaryState)
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["DeferralSection"]</h5></div>
                <div class="card-body">
                    <label asp-for="DeferredReason" class="form-label fw-medium">@Localizer["DeferredReason"]</label>
                    <textarea asp-for="DeferredReason" class="form-control" rows="3" maxlength="512"></textarea>
                </div>
            </section>
        </div>

        <!-- Sidebar Column -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["DependencySection"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label for="MetricSemanticRegistrySourceDependencyState" class="form-label fw-medium">@Localizer["MetricSemanticRegistrySourceDependencyState"]</label>
                        @stateSelect("MetricSemanticRegistrySourceDependencyState", Model.MetricSemanticRegistrySourceDependencyState)
                    </div>
                    <div class="col-12">
                        <label for="KpiCatalogSourceDependencyState" class="form-label fw-medium">@Localizer["KpiCatalogSourceDependencyState"]</label>
                        @stateSelect("KpiCatalogSourceDependencyState", Model.KpiCatalogSourceDependencyState)
                    </div>
                    <div class="col-12">
                        <label for="DataContractRegistryDependencyState" class="form-label fw-medium">@Localizer["DataContractRegistryDependencyState"]</label>
                        @stateSelect("DataContractRegistryDependencyState", Model.DataContractRegistryDependencyState)
                    </div>
                    <div class="col-12">
                        <label for="NotificationDependencyState" class="form-label fw-medium">@Localizer["NotificationDependencyState"]</label>
                        @stateSelect("NotificationDependencyState", Model.NotificationDependencyState)
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["GovernanceSection"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label for="StewardshipPreconditionState" class="form-label fw-medium">@Localizer["StewardshipPreconditionState"]</label>
                        @stateSelect("StewardshipPreconditionState", Model.StewardshipPreconditionState)
                    </div>
                    <div class="col-12">
                        <label for="DataMinimizationState" class="form-label fw-medium">@Localizer["DataMinimizationState"]</label>
                        @stateSelect("DataMinimizationState", Model.DataMinimizationState)
                    </div>
                    <div class="col-12">
                        <label for="RetentionPolicyState" class="form-label fw-medium">@Localizer["RetentionPolicyState"]</label>
                        @stateSelect("RetentionPolicyState", Model.RetentionPolicyState)
                    </div>
                    <div class="col-12">
                        <label for="ApprovalPolicyState" class="form-label fw-medium">@Localizer["ApprovalPolicyState"]</label>
                        @stateSelect("ApprovalPolicyState", Model.ApprovalPolicyState)
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>
