@using Diten.Web.Views.DataKnowledge.MetricSemanticRegistry
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<MetricSemanticRegistryIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["MetricSemanticRegistryTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("dki.metric-semantic-registry.manage");
    var canEvaluate = Perms.Has("dki.metric-semantic-registry.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["MetricSemanticRegistryTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="metric-semantic-registry-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-metric-semantic-registry" data-dt-standard="v2"> *@
    <partial name="~/Views/DataKnowledge/MetricSemanticRegistry/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/DataKnowledge/MetricSemanticRegistry/_IndexL10n.cshtml" />
    <script src="~/assets/js/DataKnowledge/MetricSemanticRegistry/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/DataKnowledge/MetricSemanticRegistry/index.js" asp-append-version="true"></script>
}
