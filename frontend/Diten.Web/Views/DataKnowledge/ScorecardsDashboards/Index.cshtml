@using Diten.Web.Views.DataKnowledge.ScorecardsDashboards
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ScorecardsDashboardsIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["ScorecardsDashboardsTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("dki.scorecards-dashboards.manage");
    var canEvaluate = Perms.Has("dki.scorecards-dashboards.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["ScorecardsDashboardsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="scorecards-dashboards-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-scorecards-dashboards" data-dt-standard="v2"> *@
    <partial name="~/Views/DataKnowledge/ScorecardsDashboards/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/DataKnowledge/ScorecardsDashboards/_IndexL10n.cshtml" />
    <script src="~/assets/js/DataKnowledge/ScorecardsDashboards/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/DataKnowledge/ScorecardsDashboards/index.js" asp-append-version="true"></script>
}
