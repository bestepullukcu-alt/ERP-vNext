@using Diten.Web.Views.DataKnowledge.BaselineExperimentMeasurement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BaselineExperimentMeasurementIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["BaselineExperimentMeasurementTitle"].Value;
    Layout = "_LayoutTenantShell";
    var canManage = Perms.Has("dki.baseline-experiment-measurement.manage");
    var canEvaluate = Perms.Has("dki.baseline-experiment-measurement.evaluate");
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["BaselineExperimentMeasurementTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div id="baseline-experiment-measurement-shell"
     data-can-manage="@canManage.ToString().ToLowerInvariant()"
     data-can-evaluate="@canEvaluate.ToString().ToLowerInvariant()">
    @* Contract markers rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-baseline-experiment-measurement" data-dt-standard="v2"> *@
    <partial name="~/Views/DataKnowledge/BaselineExperimentMeasurement/_DataTable.cshtml" />
</div>

@section Scripts {
    <partial name="~/Views/DataKnowledge/BaselineExperimentMeasurement/_IndexL10n.cshtml" />
    <script src="~/assets/js/DataKnowledge/BaselineExperimentMeasurement/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/DataKnowledge/BaselineExperimentMeasurement/index.js" asp-append-version="true"></script>
}
