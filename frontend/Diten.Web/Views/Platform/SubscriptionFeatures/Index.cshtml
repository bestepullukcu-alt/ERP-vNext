@using Diten.Web.Views.Platform.SubscriptionFeatures
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SubscriptionFeaturesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["SubscriptionFeaturesTitle"].Value;
    Layout = "_LayoutPlatformAdmin";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0">@Localizer["SubscriptionFeaturesTitle"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>
</div>

<div id="sf-error" class="alert alert-danger d-none" role="alert"></div>

@* ── Tab navigation (Tenant Details pattern) ───────────────────────────── *@
<div class="card mb-4">
    <div class="card-header p-3">
        <div class="nav-align-top">
            <ul class="nav nav-pills d-inline-flex gap-2 flex-wrap" role="tablist">
                <li class="nav-item mb-1 mb-sm-0" role="presentation">
                    <button type="button" class="nav-link active small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabCategories" role="tab" aria-selected="true">
                        <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-category me-1 wc-tab-icon"></i>@Localizer["CategoriesTab"]</span>
                        <i class="bx bx-category d-sm-none wc-tab-icon"></i>
                    </button>
                </li>
                <li class="nav-item mb-1 mb-sm-0" role="presentation">
                    <button type="button" class="nav-link small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabFeatures" role="tab" aria-selected="false">
                        <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-package me-1 wc-tab-icon"></i>@Localizer["FeaturesTab"]</span>
                        <i class="bx bx-package d-sm-none wc-tab-icon"></i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="tab-content p-0">
    @* ── Categories tab (golden DataTable) ────────────────────────────── *@
    <div class="tab-pane fade show active" id="tabCategories" role="tabpanel">
        <partial name="~/Views/Platform/SubscriptionFeatures/_CategoriesTab.cshtml" />
    </div>

    @* ── Features tab (golden DataTable) ──────────────────────────────── *@
    <div class="tab-pane fade" id="tabFeatures" role="tabpanel">
        <partial name="~/Views/Platform/SubscriptionFeatures/_FeaturesTab.cshtml" />
    </div>
</div>

<partial name="~/Views/Platform/SubscriptionFeatures/_CategoryOffcanvas.cshtml" />

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/SubscriptionFeatures/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/SubscriptionFeatures/index.js" asp-append-version="true"></script>
}
