@using Diten.Web.Views.Platform.SubscriptionFeatures
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SubscriptionFeaturesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCategoryCreateEdit" aria-labelledby="offcanvasCategoryLabel">
    <div class="offcanvas-header p-4">
        <h5 id="offcanvasCategoryLabel" class="offcanvas-title">@Localizer["CreateCategory"]</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body border-top p-4">
        <div id="sf-category-alert" class="alert alert-danger d-none" role="alert"></div>

        <form id="sf-category-form" class="pt-0" novalidate>
            <input type="hidden" id="sf-category-id" />
            <input type="hidden" id="sf-category-row-version" />

            <div class="row g-4">
                <div class="col-12">
                    <label class="form-label fw-medium" for="sf-category-code">@Localizer["CategoryCode"] <span class="text-danger">*</span></label>
                    <input id="sf-category-code" class="form-control" maxlength="80" required autocomplete="off" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-medium" for="sf-category-name">@Localizer["DisplayName"] <span class="text-danger">*</span></label>
                    <input id="sf-category-name" class="form-control" maxlength="200" required autocomplete="off" />
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-medium" for="sf-category-description">@Localizer["Description"]</label>
                    <textarea id="sf-category-description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label fw-medium" for="sf-category-sort">@Localizer["SortOrder"]</label>
                    <input id="sf-category-sort" class="form-control" type="number" min="0" step="1" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-medium" for="sf-category-status">@SharedLocalizer["Status"] <span class="text-danger">*</span></label>
                    <select id="sf-category-status" class="form-select" required>
                        <option value="Active">@SharedLocalizer["Active"]</option>
                        <option value="Inactive">@SharedLocalizer["Passive"]</option>
                    </select>
                </div>
            </div>
        </form>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" class="btn btn-primary" id="sf-save-category">@SharedLocalizer["Save"]</button>
    </div>
</div>
