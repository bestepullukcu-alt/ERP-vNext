@using Diten.Web.Views.Platform.SubscriptionFeatures
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SubscriptionFeaturesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="modal fade" id="sf-category-editor" tabindex="-1" aria-labelledby="sf-category-editor-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="sf-category-editor-title" class="modal-title">@Localizer["CreateCategory"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <form id="sf-category-form" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="sf-category-code">@Localizer["CategoryCode"] <span class="text-danger">*</span></label>
                        <input id="sf-category-code" class="form-control" required autocomplete="off" />
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sf-category-name">@Localizer["DisplayName"] <span class="text-danger">*</span></label>
                        <input id="sf-category-name" class="form-control" required autocomplete="off" />
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sf-category-description">@Localizer["Description"]</label>
                        <textarea id="sf-category-description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="sf-category-sort">@Localizer["SortOrder"]</label>
                            <input id="sf-category-sort" class="form-control" type="number" min="0" step="1" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="sf-category-status">@Localizer["Status"] <span class="text-danger">*</span></label>
                            <select id="sf-category-status" class="form-select" required>
                                <option value="Active">@SharedLocalizer["Active"]</option>
                                <option value="Inactive">@SharedLocalizer["Passive"]</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="sf-save-category">@SharedLocalizer["Save"]</button>
            </div>
        </div>
    </div>
</div>
