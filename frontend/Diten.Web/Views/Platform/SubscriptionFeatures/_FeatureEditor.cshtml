@using Diten.Web.Views.Platform.SubscriptionFeatures
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SubscriptionFeaturesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="sf-feature-editor" aria-labelledby="sf-feature-editor-title">
    <div class="offcanvas-header border-bottom">
        <h5 id="sf-feature-editor-title" class="offcanvas-title">@Localizer["CreateFeature"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Close"]"></button>
    </div>
    <div class="offcanvas-body">
        <form id="sf-feature-form" novalidate>
            <input type="hidden" id="sf-feature-id" />
            <input type="hidden" id="sf-row-version" />

            <div class="mb-3">
                <label class="form-label" for="sf-feature-code">@Localizer["FeatureCode"] <span class="text-danger">*</span></label>
                <input id="sf-feature-code" class="form-control" required autocomplete="off" />
                <div class="invalid-feedback"></div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="sf-feature-slug">@Localizer["FeatureSlug"] <span class="text-danger">*</span></label>
                <input id="sf-feature-slug" class="form-control" required autocomplete="off" />
                <div class="invalid-feedback"></div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="sf-display-name">@Localizer["DisplayName"] <span class="text-danger">*</span></label>
                <input id="sf-display-name" class="form-control" required autocomplete="off" />
                <div class="invalid-feedback"></div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="sf-description">@Localizer["Description"]</label>
                <textarea id="sf-description" class="form-control" rows="3"></textarea>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="sf-editor-status">@Localizer["Status"] <span class="text-danger">*</span></label>
                    <select id="sf-editor-status" class="form-select" required>
                        <option value="Draft">@Localizer["Draft"]</option>
                        <option value="Active">@SharedLocalizer["Active"]</option>
                        <option value="Inactive">@SharedLocalizer["Passive"]</option>
                        <option value="Deprecated">@Localizer["Deprecated"]</option>
                    </select>
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="sf-editor-category">@Localizer["Category"]</label>
                    <select id="sf-editor-category" class="form-select"></select>
                    <div class="invalid-feedback"></div>
                </div>
            </div>

            <div class="row g-3 mt-0">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="sf-sort-order">@Localizer["SortOrder"]</label>
                    <input id="sf-sort-order" class="form-control" type="number" min="0" step="1" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="sf-flag-key">@Localizer["OptionalFeatureFlagKey"]</label>
                    <input id="sf-flag-key" class="form-control" autocomplete="off" />
                </div>
            </div>

            <div class="form-check form-switch my-4">
                <input id="sf-core-feature" class="form-check-input" type="checkbox" />
                <label class="form-check-label" for="sf-core-feature">@Localizer["IsCoreFeature"]</label>
            </div>

            <div class="border-top pt-4 mt-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="mb-0">@Localizer["AvailableInPlans"]</h6>
                    <span class="small text-muted" id="sf-plan-mapping-state"></span>
                </div>
                <div id="sf-plan-mappings" class="d-grid gap-3"></div>
            </div>
        </form>
    </div>
    <div class="offcanvas-footer border-top p-3 d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" class="btn btn-primary" id="sf-save-feature">@SharedLocalizer["Save"]</button>
    </div>
</div>
