@using Diten.Web.Views.Platform.DomainManagement
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<DomainManagementIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["DomainManagementTitle"].Value;
    Layout = "_LayoutPlatformAdmin";
}

<partial name="_Filter" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["DomainManagementTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<partial name="_DataTable.cshtml" />

@* Slim pattern: create/edit happen in an in-page offcanvas (no route navigation). *@
<partial name="_CreateEditOffcanvas" />

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/DomainManagement/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/DomainManagement/index.js" asp-append-version="true"></script>
}
