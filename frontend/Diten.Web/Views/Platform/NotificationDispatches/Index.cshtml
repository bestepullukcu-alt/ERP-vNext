@using Diten.Web.Views.Platform.NotificationDispatches
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<NotificationDispatchesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["NotificationDispatchesTitle"].Value;
    Layout = "_LayoutPlatformAdmin";
}

@* ① Inline Filter partial *@
@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/Platform/NotificationDispatches/_Filter.cshtml" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["NotificationDispatchesTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* ② DataTable Card — read-only monitoring subset (no BulkActionBar, no create/edit). *@
@* Contract markers are rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-notificationdispatches" data-dt-standard="v2"> *@
<partial name="~/Views/Platform/NotificationDispatches/_DataTable.cshtml" />

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/Platform/NotificationDispatches/_IndexL10n.cshtml" />
    <script src="~/assets/js/Platform/NotificationDispatches/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/NotificationDispatches/index.js" asp-append-version="true"></script>
}
