@using Diten.Web.Views.Platform.NotificationDispatches
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<NotificationDispatchesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["DetailsTitle"].Value;
    Layout = "_LayoutPlatformAdmin";
    var dispatchId = ViewData["DispatchId"]?.ToString() ?? string.Empty;
    var targetTenantId = ViewData["TargetTenantId"]?.ToString() ?? string.Empty;
}

<div class="notification-dispatch-details" data-dispatch-id="@dispatchId" data-target-tenant-id="@targetTenantId" id="dispatchDetailsRoot">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4">
        <div class="d-flex flex-column justify-content-center">
            <h5 class="mb-0" id="detailsTitle">@Localizer["DetailsTitle"]</h5>
            <nav aria-label="breadcrumb" class="text-muted">
                <ol class="breadcrumb mb-0 py-0">
                    <li class="breadcrumb-item"><a href="/Platform/NotificationDispatches">@Localizer["NotificationDispatchesTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@Localizer["DetailsTitle"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-3">
            <a href="/Platform/NotificationDispatches" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
            @* Cancel action is rendered by details.js ONLY for a cancellable (Queued) dispatch (no-shell rule). *@
            <button type="button" id="btnCancelDispatch" class="btn btn-label-danger d-none">@Localizer["Cancel"]</button>
        </div>
    </div>

    <div class="alert alert-danger d-none" id="detailsError"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["MetadataSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6"><span class="text-muted small d-block">@Localizer["TemplateKey"]</span><span class="fw-medium" id="d-templateKey">-</span></div>
                        <div class="col-6 col-md-3"><span class="text-muted small d-block">@Localizer["Channel"]</span><span id="d-channel">-</span></div>
                        <div class="col-6 col-md-3"><span class="text-muted small d-block">@Localizer["Locale"]</span><span id="d-locale">-</span></div>
                        <div class="col-6 col-md-3"><span class="text-muted small d-block">@Localizer["Provider"]</span><span id="d-provider">-</span></div>
                        <div class="col-6 col-md-9"><span class="text-muted small d-block">@Localizer["ProviderMessageId"]</span><span id="d-providerMessageId">-</span></div>
                        <div class="col-12"><span class="text-muted small d-block">@Localizer["Subject"]</span><span class="fw-medium" id="d-subject">-</span></div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["VariablesSection"]</h6>
                    <pre class="mb-0 p-3 rounded bg-body-tertiary text-break" id="d-variables" style="max-height: 260px; overflow: auto; white-space: pre-wrap;">-</pre>
                </div>
            </section>

            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["PreviewSection"]</h6>
                    <div class="alert alert-secondary d-none mb-3" id="d-noPreview">@Localizer["NoPreview"]</div>
                    @* Safe, backend-truncated preview only — rendered inside a sandboxed iframe (no scripts, no same-origin). *@
                    <iframe id="d-previewFrame" title="@Localizer["PreviewSection"]" sandbox="" class="w-100 border rounded d-none" style="min-height: 220px;"></iframe>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["DeliverySection"]</h6>
                    <div class="row g-3">
                        <div class="col-6"><span class="text-muted small d-block">@SharedLocalizer["Status"]</span><span class="badge bg-label-primary" id="d-status">-</span></div>
                        <div class="col-6"><span class="text-muted small d-block">@Localizer["RetryCount"]</span><span id="d-retryCount">-</span></div>
                        <div class="col-6"><span class="text-muted small d-block">@Localizer["QueuedAt"]</span><span id="d-queuedAt">-</span></div>
                        <div class="col-6"><span class="text-muted small d-block">@Localizer["SentAt"]</span><span id="d-sentAt">-</span></div>
                        <div class="col-6"><span class="text-muted small d-block">@Localizer["FailedAt"]</span><span id="d-failedAt">-</span></div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["RecipientsSection"]</h6>
                    @* Only recipient COUNTS are shown — never the recipient addresses, and never Bcc content. *@
                    <div class="row g-3">
                        <div class="col-4"><span class="text-muted small d-block">@Localizer["ToCount"]</span><span class="fw-medium" id="d-toCount">-</span></div>
                        <div class="col-4"><span class="text-muted small d-block">@Localizer["CcCount"]</span><span id="d-ccCount">-</span></div>
                        <div class="col-4"><span class="text-muted small d-block">@Localizer["BccCount"]</span><span id="d-bccCount">-</span></div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ErrorSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12"><span class="text-muted small d-block">@Localizer["ErrorCode"]</span><span id="d-errorCode">-</span></div>
                        <div class="col-12"><span class="text-muted small d-block">@Localizer["ErrorMessage"]</span><span class="text-break" id="d-errorMessage">-</span></div>
                        <div class="col-12"><span class="text-muted small d-block">@Localizer["CorrelationId"]</span><span class="text-break font-monospace small" id="d-correlationId">-</span></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Platform/NotificationDispatches/_IndexL10n.cshtml" />
    <script src="~/assets/js/Platform/NotificationDispatches/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/NotificationDispatches/details.js" asp-append-version="true"></script>
}
