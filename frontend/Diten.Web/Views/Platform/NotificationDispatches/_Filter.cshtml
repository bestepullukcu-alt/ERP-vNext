@using Diten.Web.Views.Platform.NotificationDispatches
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<NotificationDispatchesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost" class="px-3">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Target tenant is required: the dispatch list is tenant-scoped server-side. *@
                    <div class="filter-chip filter-tenant">
                        <select id="filterTenant" class="form-select form-select-sm select2" data-placeholder="@Localizer["SelectTenant"]">
                            <option value=""></option>
                        </select>
                    </div>

                    @* Dispatch status is a fixed domain state-machine enum (Queued/Sent/Failed/Cancelled),
                       localized server-side here — not reference/lookup data. Mirrors the NotificationSettings
                       Active/Passive precedent; no hardcoded fallback list lives in JS. *@
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" data-placeholder="@SharedLocalizer["Status"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="Queued">@Localizer["StatusQueued"]</option>
                            <option value="Sent">@Localizer["StatusSent"]</option>
                            <option value="Failed">@Localizer["StatusFailed"]</option>
                            <option value="Cancelled">@Localizer["StatusCancelled"]</option>
                        </select>
                    </div>

                    <div class="filter-chip filter-template-key">
                        <input type="text" id="filterTemplateKey" class="form-control form-control-sm"
                               placeholder="@Localizer["TemplateKeyPlaceholder"]" autocomplete="off" />
                    </div>

                    <div class="filter-chip filter-date-from">
                        <input type="date" id="filterDateFrom" class="form-control form-control-sm" aria-label="@Localizer["DateFrom"]" />
                    </div>

                    <div class="filter-chip filter-date-to">
                        <input type="date" id="filterDateTo" class="form-control form-control-sm" aria-label="@Localizer["DateTo"]" />
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
