@using Diten.Web.Views.Platform.NotificationDispatches
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<NotificationDispatchesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        @* Read-only monitoring subset: no checkbox column and no bulk action bar by design
           (Create/Edit/_Form are intentionally NOT generated — no-shell rule). *@
        <table id="dt-notificationdispatches" data-dt-standard="v2" class="datatables-notificationdispatches table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["QueuedAt"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th>@Localizer["TemplateKey"]</th>
                    <th>@Localizer["Channel"]</th>
                    <th>@Localizer["Provider"]</th>
                    <th>@Localizer["Recipients"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
