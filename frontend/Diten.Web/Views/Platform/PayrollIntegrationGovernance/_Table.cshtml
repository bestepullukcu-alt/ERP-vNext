@using Diten.Web.Views.Platform.PayrollIntegrationGovernance
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PayrollIntegrationGovernanceIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-platform-payroll-integration-governance" data-dt-standard="v2" class="datatables-platform-payroll-integration-governance table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["RunCode"]</th>
                    <th>@Localizer["RunType"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["ContractVersion"]</th>
                    <th>@Localizer["StartedAt"]</th>
                    <th>@Localizer["CompletedAt"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
