@using Diten.Web.Views.Platform.SelfAccess
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SelfAccessIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "_LayoutPlatformAdmin";
}

<div class="mb-3">
    <h5 class="mb-0">@Localizer["Title"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div class="alert alert-info d-flex align-items-start mb-4" role="note">
    <i class="bx bx-info-circle me-2 mt-1"></i>
    <div>@Localizer["TwoObservationNotice"]</div>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <form id="saForm" class="row g-3 align-items-end" novalidate data-no-tracker>
            <div class="col-12 col-lg-3">
                <label for="saModuleCode" class="form-label fw-medium">@Localizer["ModuleCode"] <span class="text-danger">*</span></label>
                <select id="saModuleCode" class="form-select sa-select2" data-placeholder="@Localizer["ModuleCodePlaceholder"]" required>
                    <option value=""></option>
                </select>
            </div>
            <div class="col-12 col-lg-4">
                <label for="saPermissionKey" class="form-label fw-medium">@Localizer["PermissionKey"] <span class="text-danger">*</span></label>
                <select id="saPermissionKey" class="form-select sa-select2" data-placeholder="@Localizer["PermissionKeyPlaceholder"]" required disabled>
                    <option value=""></option>
                </select>
            </div>
            <div class="col-12 col-lg-3">
                <label for="saFeatureCode" class="form-label fw-medium">@Localizer["FeatureCode"]</label>
                <input type="text" id="saFeatureCode" class="form-control" />
            </div>
            <div class="col-12 col-lg-2">
                <button type="submit" id="btnExplain" class="btn btn-primary w-100">
                    <i class="bx bx-shield-quarter me-1"></i>@Localizer["Explain"]
                </button>
            </div>
        </form>
    </div>
</div>

<div id="saAlert" class="alert alert-danger d-none" role="alert"></div>

<div id="saEmpty" class="card mb-4">
    <div class="card-body text-center text-muted py-6">@Localizer["EnterKeyPrompt"]</div>
</div>

<div id="saResult" class="d-none">
    <div class="row g-4">
        @* Observation 1 — Permission gate *@
        <div class="col-12 col-lg-6">
            <section class="card h-100">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4"><i class="bx bx-lock-alt me-2"></i>@Localizer["PermissionObservation"]</h6>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between"><span class="text-muted">@Localizer["RequiredPermission"]</span><code id="sa-perm-required">-</code></div>
                        <div class="d-flex justify-content-between align-items-center"><span class="text-muted">@Localizer["PermissionSatisfied"]</span><span id="sa-perm-satisfied" class="badge bg-label-secondary">-</span></div>
                        <div class="d-flex justify-content-between align-items-center"><span class="text-muted">@Localizer["PermissionMatch"]</span><span id="sa-perm-match" class="badge bg-label-primary">-</span></div>
                        <div class="d-flex justify-content-between align-items-center"><span class="text-muted">@Localizer["MatchedViaLegacyAlias"]</span><span id="sa-perm-alias" class="badge bg-label-secondary">-</span></div>
                    </div>
                </div>
            </section>
        </div>

        @* Observation 2 — Data scope (descriptive) *@
        <div class="col-12 col-lg-6">
            <section class="card h-100">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4"><i class="bx bx-data me-2"></i>@Localizer["ScopeObservation"]</h6>
                    <div class="d-flex flex-column gap-3">
                        <div id="sa-scope-unavailable" class="alert alert-warning d-none mb-0" role="status">@Localizer["ScopeUnavailable"]</div>
                        <div><span class="text-muted d-block mb-1">@Localizer["ScopeKinds"]</span><div id="sa-scope-kinds" class="d-flex flex-wrap gap-1">-</div></div>
                        <div><span class="text-muted d-block mb-1">@Localizer["ScopeCounts"]</span><div id="sa-scope-counts" class="d-flex flex-wrap gap-1">-</div></div>
                        <div><span class="text-muted d-block mb-1">@Localizer["ScopeNotes"]</span><ul id="sa-scope-notes" class="mb-0 ps-3 small text-muted"></ul></div>
                    </div>
                </div>
            </section>
        </div>

        @* Meta / freshness *@
        <div class="col-12">
            <section class="card">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4"><i class="bx bx-info-circle me-2"></i>@Localizer["Context"]</h6>
                    <div class="row g-3 small">
                        <div class="col-6 col-lg-3"><span class="text-muted d-block">@Localizer["Mode"]</span><span id="sa-mode">-</span></div>
                        <div class="col-6 col-lg-3"><span class="text-muted d-block">@Localizer["ActorType"]</span><span id="sa-actor">-</span></div>
                        <div class="col-6 col-lg-3"><span class="text-muted d-block">@Localizer["TenantId"]</span><code id="sa-tenant">-</code></div>
                        <div class="col-6 col-lg-3"><span class="text-muted d-block">@Localizer["TokenExpiresAt"]</span><span id="sa-token-exp">-</span></div>
                        <div class="col-12"><span class="text-muted d-block mb-1">@Localizer["FreshnessNotes"]</span><ul id="sa-freshness" class="mb-0 ps-3 small text-muted"></ul></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Platform/SelfAccess/_IndexL10n.cshtml" />
    <script src="~/assets/js/Platform/SelfAccess/self-access-view.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/SelfAccess/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/SelfAccess/index.js" asp-append-version="true"></script>
}
