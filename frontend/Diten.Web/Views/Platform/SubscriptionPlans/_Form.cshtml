@model Diten.Web.Controllers.Platform.SubscriptionPlansController.SubscriptionPlanEditViewModel
@using Diten.Web.Views.Platform.SubscriptionPlans
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IHtmlLocalizer<SubscriptionPlansIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = Model.Id.HasValue && Model.Id != Guid.Empty;
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
    var action = isEdit ? "Edit" : "Create";
    var currencyOptions = ViewData["CurrencyOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-controller="SubscriptionPlans" asp-action="Index">@Localizer["SubscriptionPlansTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="SubscriptionPlans" asp-action="Index" class="btn btn-label-secondary">
            @SharedLocalizer["Cancel"]
        </a>
        <button type="submit" form="subscriptionPlanForm" class="btn btn-primary">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>

<form id="subscriptionPlanForm" asp-controller="SubscriptionPlans" asp-action="@action" asp-route-id="@Model.Id" method="post"
    class="needs-validation" novalidate data-plan-id="@Model.Id" data-plan-active="@Model.IsActive.ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IncludedFeaturesText" />
    <input type="hidden" asp-for="EntitlementMappingsJson" id="sp-entitlement-mappings-json" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Main Column (Left) -->
        <div class="col-12 col-lg-8">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IdentitySection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Code" class="form-label fw-medium">@Localizer["Code"] <span class="text-danger">*</span></label>
                            <input asp-for="Code" class="form-control" maxlength="64" placeholder="@Localizer["CodePlaceholder"]" required />
                            <span asp-validation-for="Code" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Name" class="form-label fw-medium">@Localizer["Name"] <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" maxlength="200" placeholder="@Localizer["NamePlaceholder"]" required />
                            <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-medium">@Localizer["Description"]</label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="@SharedLocalizer["DescriptionPlaceholder"]"></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["EntitlementsSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <div id="sp-entitlements-error" class="alert alert-warning d-none" role="alert"></div>
                            <div class="d-flex flex-column flex-xl-row align-items-xl-center gap-3 mb-3">
                                <div class="flex-grow-1">
                                    <label for="sp-feature-search" class="form-label fw-medium">@Localizer["IncludedFeatures"]</label>
                                    <input id="sp-feature-search" class="form-control" autocomplete="off" placeholder="@Localizer["FeatureSearchPlaceholder"]" />
                                </div>
                                <div class="sp-entitlement-filter">
                                    <label for="sp-feature-category" class="form-label fw-medium">@Localizer["Category"]</label>
                                    <select id="sp-feature-category" class="select2 form-select">
                                        <option value="">@Localizer["AllCategories"]</option>
                                    </select>
                                </div>
                                <div class="sp-entitlement-filter">
                                    <label for="sp-feature-availability" class="form-label fw-medium">@Localizer["Availability"]</label>
                                    <select id="sp-feature-availability" class="select2 form-select">
                                        <option value="">@Localizer["AllFeatures"]</option>
                                        <option value="Included">@Localizer["Included"]</option>
                                        <option value="AddOn">@Localizer["AddOn"]</option>
                                        <option value="Preview">@Localizer["Preview"]</option>
                                        <option value="NotAvailable">@Localizer["NotAvailable"]</option>
                                    </select>
                                </div>
                            </div>
                            <div id="sp-entitlements-loading" class="d-flex align-items-center gap-2 text-muted">
                                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                <span>@SharedLocalizer["Loading"]</span>
                            </div>
                            <div id="sp-entitlements-empty" class="sp-emptybox text-center text-muted d-none">
                                <i class="bx bx-package"></i>
                                <div class="small">@Localizer["NoFeaturesAvailable"]</div>
                            </div>
                            <div id="sp-entitlements-list"></div>
                        </div>
                        <div class="col-12">
                            <input type="hidden" asp-for="IncludedModuleKeysText" id="sp-included-module-keys" />
                            <label for="subscription-plan-module-select" class="form-label fw-medium">@Localizer["Modules"]</label>
                            <div id="sp-modules-loading" class="d-flex align-items-center gap-2 text-muted">
                                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                <span>@SharedLocalizer["Loading"]</span>
                            </div>
                            <div id="sp-modules-empty" class="sp-emptybox text-center text-muted d-none">
                                <i class="bx bx-cube"></i>
                                <div class="small">@Localizer["NoModulesAvailable"]</div>
                            </div>
                            <select id="subscription-plan-module-select"
                                    class="select2 form-select"
                                    multiple
                                    data-placeholder="@Localizer["SelectModulesPlaceholder"]">
                            </select>
                            <div class="form-text mt-1">@Localizer["ModulesHelp"]</div>
                            <span asp-validation-for="IncludedModuleKeysText" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["QuotasSection"]</h6>
                    <div class="row g-3">
                        <input type="hidden" asp-for="DefaultQuotasJson" id="sp-default-quotas-json" />
                        <div class="col-12 col-md-6">
                            <label asp-for="UsersMax" class="form-label fw-medium">@Localizer["UsersMax"]</label>
                            <input asp-for="UsersMax" class="form-control sp-quota-input" type="number" min="0" step="1" placeholder="0" data-quota-key="users.max" />
                            <div class="form-text mt-1">users.max</div>
                            <span asp-validation-for="UsersMax" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="StorageGbMax" class="form-label fw-medium">@Localizer["StorageGbMax"]</label>
                            <input asp-for="StorageGbMax" class="form-control sp-quota-input" type="number" min="0" step="0.01" placeholder="0" data-quota-key="storage.gb.max" />
                            <div class="form-text mt-1">storage.gb.max</div>
                            <span asp-validation-for="StorageGbMax" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="ApiCallsPerMonth" class="form-label fw-medium">@Localizer["ApiCallsPerMonth"]</label>
                            <input asp-for="ApiCallsPerMonth" class="form-control sp-quota-input" type="number" min="0" step="1" placeholder="0" data-quota-key="api.calls.per.month" />
                            <div class="form-text mt-1">api.calls.per.month</div>
                            <span asp-validation-for="ApiCallsPerMonth" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="ModulesMax" class="form-label fw-medium">@Localizer["ModulesMax"]</label>
                            <input asp-for="ModulesMax" class="form-control sp-quota-input" type="number" min="0" step="1" placeholder="0" data-quota-key="modules.max" />
                            <div class="form-text mt-1">modules.max</div>
                            <span asp-validation-for="ModulesMax" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-text">@Localizer["DefaultQuotasHelp"]</div>
                            <span asp-validation-for="DefaultQuotasJson" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Sidebar Column (Right) -->
        <div class="col-12 col-lg-4">
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["PricingSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="PriceMonthly" class="form-label fw-medium">@Localizer["PriceMonthly"]</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PriceMonthly" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="PriceMonthly" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="PriceYearly" class="form-label fw-medium">@Localizer["PriceYearly"]</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PriceYearly" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="PriceYearly" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Currency" class="form-label fw-medium">@Localizer["Currency"]</label>
                            <select asp-for="Currency" asp-items="currencyOptions" class="select2 form-select">
                                <option value="">@Localizer["CurrencyPlaceholder"]</option>
                            </select>
                            <span asp-validation-for="Currency" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="SortOrder" class="form-label fw-medium">@Localizer["SortOrder"]</label>
                            <input asp-for="SortOrder" class="form-control" type="number" min="0" placeholder="0" />
                            <span asp-validation-for="SortOrder" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["StatusAndRulesSection"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="setting-switch-row">
                                <div class="setting-switch-row__text">
                                    <label asp-for="IsActive" class="form-label fw-medium mb-0">@Localizer["IsActive"]</label>
                                    <div class="text-muted small">@Localizer["IsActiveHelp"]</div>
                                </div>
                                <div class="form-check form-switch setting-switch-row__control">
                                    <input asp-for="IsActive" class="form-check-input" role="switch" value="true" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="setting-switch-row">
                                <div class="setting-switch-row__text">
                                    <label asp-for="IsDefault" class="form-label fw-medium mb-0">@Localizer["IsDefault"]</label>
                                    <div class="text-muted small">@Localizer["IsDefaultHelp"]</div>
                                </div>
                                <div class="form-check form-switch setting-switch-row__control">
                                    <input asp-for="IsDefault" class="form-check-input" role="switch" value="true" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="setting-switch-row">
                                <div class="setting-switch-row__text">
                                    <label asp-for="IsTrialPlan" class="form-label fw-medium mb-0">@Localizer["IsTrialPlan"]</label>
                                    <div class="text-muted small">@Localizer["IsTrialPlanHelp"]</div>
                                </div>
                                <div class="form-check form-switch setting-switch-row__control">
                                    <input id="is-trial-plan" asp-for="IsTrialPlan" class="form-check-input" role="switch" value="true" />
                                </div>
                            </div>
                        </div>
                        <div id="trial-duration-wrapper" class="col-12 d-none">
                            <label asp-for="TrialDurationDays" class="form-label fw-medium">@Localizer["TrialDurationDays"]</label>
                            <input id="trial-duration-days" asp-for="TrialDurationDays" class="form-control" type="number" min="1" />
                            <span asp-validation-for="TrialDurationDays" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>
