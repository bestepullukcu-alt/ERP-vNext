@using Diten.Web.Views.Platform.SubscriptionPlans
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SubscriptionPlansIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["SubscriptionPlansTitle"].Value;
    Layout = "_LayoutPlatformAdmin";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0">@Localizer["SubscriptionPlansTitle"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-4">
        <a class="btn btn-primary" asp-controller="SubscriptionPlans" asp-action="Create">
            <i class="bx bx-plus me-1"></i>@Localizer["CreatePlan"]
        </a>
    </div>
</div>

<div id="sp-error" class="alert alert-danger d-none" role="alert"></div>

<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-primary"><i class="bx bx-package"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["TotalPlans"]</small>
                    <h5 id="kpi-total" class="mb-0">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-success"><i class="bx bx-check-circle"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["ActivePlans"]</small>
                    <h5 id="kpi-active" class="mb-0">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-info"><i class="bx bx-time-five"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["TrialPlans"]</small>
                    <h5 id="kpi-trial" class="mb-0">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-warning"><i class="bx bx-dollar-circle"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["PaidPlans"]</small>
                    <h5 id="kpi-paid" class="mb-0">0</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="sp-loading" class="row g-4" role="status" aria-busy="true">
    <span class="visually-hidden">@SharedLocalizer["Loading"]</span>
    @for (var i = 0; i < 3; i++)
    {
        <div class="col-12 col-md-6 col-xl-4" aria-hidden="true">
            <div class="card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-6">
                        <div class="flex-grow-1">
                            <span class="shimmer d-block mb-2" style="height: 22px; width: 55%;"></span>
                            <span class="shimmer d-block" style="height: 12px; width: 35%;"></span>
                        </div>
                        <span class="shimmer flex-shrink-0" style="height: 24px; width: 24px; border-radius: 6px;"></span>
                    </div>
                    <span class="shimmer d-block mb-6" style="height: 12px; width: 90%;"></span>
                    <span class="shimmer d-block mb-2" style="height: 34px; width: 45%;"></span>
                    <span class="shimmer d-block mb-6" style="height: 12px; width: 30%;"></span>
                    <div class="border-top pt-6">
                        <span class="shimmer d-block mb-3" style="height: 10px; width: 25%;"></span>
                        <span class="shimmer d-block mb-2" style="height: 12px; width: 80%;"></span>
                        <span class="shimmer d-block mb-2" style="height: 12px; width: 70%;"></span>
                        <span class="shimmer d-block" style="height: 12px; width: 75%;"></span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div id="sp-empty" class="card d-none">
    <div class="card-body text-center text-muted">
        @Localizer["EmptyState"]
    </div>
</div>

<div id="sp-grid" class="row g-4"></div>

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/SubscriptionPlans/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/SubscriptionPlans/index.js" asp-append-version="true"></script>
}
