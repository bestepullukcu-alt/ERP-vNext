@using Diten.Web.Views.Platform.OrganizationDirectory
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<OrganizationDirectoryIndex> Localizer

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <span class="text-muted">@Localizer["OrganizationUnits"]</span>
                        <h5 class="mb-0" data-directory-count="orgUnits">0</h5>
                    </div>
                    <span class="badge bg-label-primary rounded p-2"><i class="bx bx-building icon-md"></i></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <span class="text-muted">@Localizer["Positions"]</span>
                        <h5 class="mb-0" data-directory-count="positions">0</h5>
                    </div>
                    <span class="badge bg-label-info rounded p-2"><i class="bx bx-briefcase icon-md"></i></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <span class="text-muted">@Localizer["PositionAssignments"]</span>
                        <h5 class="mb-0" data-directory-count="assignments">0</h5>
                    </div>
                    <span class="badge bg-label-success rounded p-2"><i class="bx bx-id-card icon-md"></i></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <span class="text-muted">@Localizer["DirectoryMode"]</span>
                        <h5 class="mb-0">@Localizer["ReadOnly"]</h5>
                    </div>
                    <span class="badge bg-label-secondary rounded p-2"><i class="bx bx-lock-alt icon-md"></i></span>
                </div>
            </div>
        </div>
    </div>
</div>
