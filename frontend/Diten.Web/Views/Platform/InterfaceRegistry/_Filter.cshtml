@using Diten.Web.Views.Platform.InterfaceRegistry
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<InterfaceRegistryIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="irFilterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip">
                        <input type="text" id="filterInterfaceCode" class="form-control form-control-sm" placeholder="@Localizer["InterfaceCode"]">
                    </div>
                    
                    <div class="filter-chip">
                        <select id="filterStatus" class="form-select form-select-sm select2" data-placeholder="@SharedLocalizer["Status"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="Active">@Localizer["Active"]</option>
                            <option value="Confirmed">@Localizer["Confirmed"]</option>
                            <option value="PendingReview">@Localizer["PendingReview"]</option>
                            <option value="Rejected">@Localizer["Rejected"]</option>
                            <option value="Deprecated">@Localizer["Deprecated"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" id="btnFilterApply" class="btn btn-sm btn-primary">@SharedLocalizer["Apply"]</button>
                        <button type="reset" id="btnFilterReset" class="btn btn-sm btn-label-danger">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
