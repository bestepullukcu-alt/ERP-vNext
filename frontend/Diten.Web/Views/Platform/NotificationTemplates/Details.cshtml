@using Diten.Web.Views.Platform.NotificationTemplates
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<NotificationTemplatesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["DetailsTitle"].Value;
    Layout = "_LayoutPlatformAdmin";
    var templateId = ViewData["TemplateId"]?.ToString() ?? string.Empty;
    var scopeTenantId = ViewData["ScopeTenantId"]?.ToString() ?? string.Empty;
}

<div class="notification-templates-details" data-template-id="@templateId" data-scope-tenant-id="@scopeTenantId" id="templateDetailsRoot">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4">
        <div class="d-flex flex-column justify-content-center">
            <h5 class="mb-0" id="detailsTitle">@Localizer["DetailsTitle"]</h5>
            <nav aria-label="breadcrumb" class="text-muted">
                <ol class="breadcrumb mb-0 py-0">
                    <li class="breadcrumb-item"><a href="/Platform/NotificationTemplates">@Localizer["NotificationTemplatesTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@Localizer["DetailsTitle"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-3">
            <a href="/Platform/NotificationTemplates" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
            <a href="#" id="btnEditTemplate" class="btn btn-label-primary d-none">@SharedLocalizer["EditRecord"]</a>
            <button type="button" id="btnArchiveTemplate" class="btn btn-label-danger d-none">@Localizer["Archive"]</button>
        </div>
    </div>

    <div class="alert alert-danger d-none" id="detailsError"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["IdentitySection"]</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6"><span class="text-muted small d-block">@Localizer["TemplateKey"]</span><span class="fw-medium" id="d-templateKey">-</span></div>
                        <div class="col-6 col-md-3"><span class="text-muted small d-block">@Localizer["Locale"]</span><span id="d-locale">-</span></div>
                        <div class="col-6 col-md-3"><span class="text-muted small d-block">@Localizer["Channel"]</span><span id="d-channel">-</span></div>
                        <div class="col-6 col-md-3"><span class="text-muted small d-block">@SharedLocalizer["Status"]</span><span class="badge bg-label-primary" id="d-status">-</span></div>
                        <div class="col-6 col-md-3"><span class="text-muted small d-block">@Localizer["SemanticVersion"]</span><span id="d-semanticVersion">-</span></div>
                        <div class="col-6 col-md-3"><span class="text-muted small d-block">@Localizer["ScopeColumn"]</span><span id="d-scope">-</span></div>
                        <div class="col-6 col-md-3"><span class="text-muted small d-block">@Localizer["UpdatedAt"]</span><span id="d-updatedAt">-</span></div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ContentSection"]</h6>
                    <div class="mb-3">
                        <span class="text-muted small d-block">@Localizer["SubjectTemplate"]</span>
                        <span class="fw-medium" id="d-subjectTemplate">-</span>
                    </div>
                    <div class="mb-3">
                        <span class="text-muted small d-block">@Localizer["BodyHtmlTemplate"]</span>
                        <pre class="border rounded p-3 small mb-0 font-monospace" id="d-bodyHtmlTemplate" style="max-height: 260px; overflow: auto;">-</pre>
                    </div>
                    <div>
                        <span class="text-muted small d-block">@Localizer["BodyTextTemplate"]</span>
                        <pre class="border rounded p-3 small mb-0 font-monospace" id="d-bodyTextTemplate" style="max-height: 160px; overflow: auto;">-</pre>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["VariablesSection"]</h6>
                    <div id="d-variables" class="d-flex flex-column gap-2"></div>
                    <div class="text-muted small d-none" id="d-variablesEmpty">@Localizer["NoVariables"]</div>
                </div>
            </section>

            <section class="card backbone-preview-section mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["PreviewSection"]</h6>
                        <button type="button" class="btn btn-sm btn-label-info" id="btnRenderPreview">
                            <i class="icon-base bx bx-show icon-sm"></i> @Localizer["RenderPreview"]
                        </button>
                    </div>
                    <div id="previewSampleInputs" class="d-flex flex-column gap-2 mb-3"></div>
                    <div class="alert alert-danger d-none" id="previewError"></div>
                    <div class="d-none" id="previewResult">
                        <div class="mb-2">
                            <span class="fw-medium">@Localizer["PreviewSubject"]:</span>
                            <span id="previewSubject"></span>
                        </div>
                        <iframe id="previewFrame" sandbox="" class="w-100 border rounded" style="min-height: 240px; background: #fff;"></iframe>
                        <pre id="previewText" class="mt-2 mb-0 small text-muted d-none"></pre>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Platform/NotificationTemplates/_IndexL10n.cshtml" />
    <script src="~/assets/js/Platform/NotificationTemplates/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/NotificationTemplates/details.js" asp-append-version="true"></script>
}
