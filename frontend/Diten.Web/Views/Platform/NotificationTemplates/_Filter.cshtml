@using Diten.Web.Views.Platform.NotificationTemplates
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<NotificationTemplatesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Filter Chip: Scope (Platform Defaults / Tenant Overrides) *@
                    <div class="filter-chip filter-scope">
                        <select id="filterScope" class="form-select form-select-sm select2" data-placeholder="@Localizer["Scope"]">
                            <option value="platform" selected>@Localizer["ScopePlatformDefaults"]</option>
                            <option value="tenant">@Localizer["ScopeTenantOverrides"]</option>
                        </select>
                    </div>

                    @* Filter Chip: Target Tenant (only meaningful for tenant scope; options come from the tenants proxy) *@
                    <div class="filter-chip filter-tenant d-none" id="filterTenantChip">
                        <select id="filterTenant" class="form-select form-select-sm select2" data-placeholder="@Localizer["TargetTenant"]">
                        </select>
                    </div>

                    @* Filter Chip: Status (lookup: notification-template-statuses) *@
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" data-placeholder="@SharedLocalizer["Status"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    @* Filter Chip: Locale (lookup: locales) *@
                    <div class="filter-chip filter-locale">
                        <select id="filterLocale" class="form-select form-select-sm select2" data-placeholder="@Localizer["Locale"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    @* Filter Chip: Channel (lookup: notification-channels) *@
                    <div class="filter-chip filter-channel">
                        <select id="filterChannel" class="form-select form-select-sm select2" data-placeholder="@Localizer["Channel"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
