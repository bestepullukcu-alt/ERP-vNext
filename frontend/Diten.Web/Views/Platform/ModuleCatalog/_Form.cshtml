@model Diten.Web.Models.ModuleCatalog.ModuleCatalogEditViewModel
@using Diten.Web.Views.Platform.ModuleCatalog
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ModuleCatalogIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var isEdit = string.Equals(ViewData["FormMode"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
    var action = isEdit ? "Edit" : "Create";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
        <div>
            <h5 class="mb-0">@title</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/Platform/ModuleCatalog">@Localizer["ModuleCatalogTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@title</li>
                </ol>
            </nav>
        </div>
        <div id="moduleCatalogRequiredTrackerHost"></div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/Platform/ModuleCatalog" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" id="btnSaveModule" form="moduleCatalogForm" class="btn btn-primary" disabled>@SharedLocalizer["Save"]</button>
    </div>
</div>

<form id="moduleCatalogForm"
      asp-controller="ModuleCatalog"
      asp-action="@action"
      asp-route-id="@Model.Id"
      method="post"
      class="needs-validation"
      data-required-tracker-target="#moduleCatalogRequiredTrackerHost"
      data-required-tracker-wrapper-class="d-flex align-items-center"
      data-required-tracker-badge-class="badge bg-label-danger px-2 py-1 d-inline-flex align-items-center"
      novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
            <section class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["IdentitySection"]</h5>
                </div>
                <div class="card-body row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="ModuleCode" class="form-label fw-medium">@Localizer["ModuleCode"] <span class="text-danger">*</span></label>
                        <input asp-for="ModuleCode"
                               class="form-control"
                               minlength="2"
                               maxlength="80"
                               pattern="^[A-Z0-9]+(-[A-Z0-9]+)*$"
                               placeholder="e.g. PROJECT-MANAGEMENT"
                               required
                               readonly="@isEdit"
                               data-is-edit="@isEdit.ToString().ToLowerInvariant()" />
                        <div id="moduleCodePreview" class="form-text mt-1 text-muted d-none">
                            @Localizer["FinalCodePreview"]: <span class="fw-bold text-primary"></span>
                        </div>
                        <div class="invalid-feedback">@Localizer["InvalidModuleCode"]</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ModuleVersion" class="form-label fw-medium">@Localizer["Version"] <span class="text-danger">*</span></label>
                        <input asp-for="ModuleVersion" class="form-control" placeholder="e.g. 1.0.0" pattern="^\d+\.\d+\.\d+$" required />
                        <div class="invalid-feedback">@Localizer["InvalidVersionFormat"]</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ModuleName" class="form-label fw-medium">@Localizer["ModuleName"] <span class="text-danger">*</span></label>
                        <input asp-for="ModuleName" class="form-control" maxlength="200" required />
                        <div class="invalid-feedback">@Localizer["RequiredField"]</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="DisplayName" class="form-label fw-medium">@Localizer["DisplayName"] <span class="text-danger">*</span></label>
                        <input asp-for="DisplayName" class="form-control" maxlength="200" required />
                        <div class="invalid-feedback">@Localizer["RequiredField"]</div>
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@SharedLocalizer["Description"]</h5>
                </div>
                <div class="card-body">
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-medium">@SharedLocalizer["Description"]</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <section class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["ClassificationSection"]</h5>
                </div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label asp-for="Domain" class="form-label fw-medium">@Localizer["Domain"] <span class="text-danger">*</span></label>
                        <select asp-for="Domain"
                                class="select2 form-select"
                                required
                                data-lookup-url="/Platform/ModuleCatalog/api/lookups/module-catalog/domains"
                                data-selected-value="@Model.Domain">
                            <option value="">@SharedLocalizer["Select"]</option>
                        </select>
                        <div class="invalid-feedback">@Localizer["RequiredField"]</div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Service" class="form-label fw-medium">@Localizer["Service"] <span class="text-danger">*</span></label>
                        <select asp-for="Service"
                                class="select2 form-select"
                                required
                                data-lookup-url="/Platform/ModuleCatalog/api/lookups/module-catalog/services"
                                data-selected-value="@Model.Service">
                            <option value="">@SharedLocalizer["Select"]</option>
                        </select>
                        <div class="invalid-feedback">@Localizer["RequiredField"]</div>
                    </div>
                    <div class="col-12">
                        <label asp-for="SortOrder" class="form-label fw-medium">@Localizer["SortOrder"]</label>
                        <input asp-for="SortOrder" type="number" min="0" class="form-control" value="@(Model.SortOrder ?? 0)" />
                        <span asp-validation-for="SortOrder" class="text-danger small"></span>
                    </div>
                </div>
            </section>

            <section class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@SharedLocalizer["Status"]</h5>
                </div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label asp-for="Status" class="form-label fw-medium">@SharedLocalizer["Status"] <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="select2 form-select" required>
                            <option value="Draft">@Localizer["StatusDraft"]</option>
                            <option value="Active">@Localizer["StatusActive"]</option>
                            <option value="Inactive">@Localizer["StatusInactive"]</option>
                            <option value="Deprecated">@Localizer["StatusDeprecated"]</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch" data-bs-toggle="tooltip" data-bs-placement="top" title="@Localizer["HelpTextCoreModule"]">
                            <input type="hidden" name="IsCoreModule" value="false" />
                            <input asp-for="IsCoreModule" class="form-check-input" role="switch" value="true" />
                            <label asp-for="IsCoreModule" class="form-check-label">@Localizer["Core"]</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch" data-bs-toggle="tooltip" data-bs-placement="top" title="@Localizer["HelpTextTenantAssignable"]">
                            <input type="hidden" name="IsTenantAssignable" value="false" />
                            <input asp-for="IsTenantAssignable" class="form-check-input" role="switch" value="true" />
                            <label asp-for="IsTenantAssignable" class="form-check-label">@Localizer["Assignable"]</label>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>
