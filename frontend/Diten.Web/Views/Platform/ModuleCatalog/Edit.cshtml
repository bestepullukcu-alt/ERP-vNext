    ViewData["FormMode"] = "edit";
    Layout = "_LayoutPlatformAdmin";
}

<partial name="~/Views/Platform/ModuleCatalog/_Form.cshtml" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/Platform/ModuleCatalog/module-catalog-form.js" asp-append-version="true"></script>
}
