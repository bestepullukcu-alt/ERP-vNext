@using Diten.Web.Views.Platform.ModuleCatalog
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ModuleCatalogIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutBackbone";
}

<partial name="_Filter" />

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3">
    <div>
        <h5 class="mb-0">@Localizer["PageTitle"]</h5>
        <p class="mb-0 text-muted">@Localizer["RegistrySubtitle"]</p>
    </div>
    <div class="btn-group">
        <button type="button" class="btn btn-label-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="icon-base bx bx-dots-horizontal-rounded icon-sm me-1"></i>@Localizer["MoreActions"]
        </button>
        <div class="dropdown-menu dropdown-menu-end m-0">
            <a href="javascript:void(0);" class="dropdown-item" data-catalog-action="create-domain">
                <i class="icon-base bx bx-layer-plus icon-sm me-2"></i>@Localizer["CreateDomain"]
            </a>
            <a href="javascript:void(0);" class="dropdown-item" data-catalog-action="create-suite">
                <i class="icon-base bx bx-category-alt icon-sm me-2"></i>@Localizer["CreateSuite"]
            </a>
            <a href="javascript:void(0);" class="dropdown-item" data-catalog-action="create-capability">
                <i class="icon-base bx bx-network-chart icon-sm me-2"></i>@Localizer["CreateCapabilityGroup"]
            </a>
            <div class="dropdown-divider"></div>
            <a href="javascript:void(0);" class="dropdown-item" data-catalog-action="import">
                <i class="icon-base bx bx-import icon-sm me-2"></i>@Localizer["ImportCatalog"]
            </a>
            <a href="javascript:void(0);" class="dropdown-item" data-catalog-action="refresh">
                <i class="icon-base bx bx-refresh icon-sm me-2"></i>@Localizer["Refresh"]
            </a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["TotalDomains"]</small>
                <h5 id="kpi-domains" class="mb-0">0</h5>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["TotalSuites"]</small>
                <h5 id="kpi-suites" class="mb-0">0</h5>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["TotalCapabilityGroups"]</small>
                <h5 id="kpi-capabilities" class="mb-0">0</h5>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["TotalModules"]</small>
                <h5 id="kpi-modules" class="mb-0">0</h5>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["TenantAssignable"]</small>
                <h5 id="kpi-assignable" class="mb-0">0</h5>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["DeprecatedOrRetired"]</small>
                <h5 id="kpi-lifecycle" class="mb-0">0</h5>
            </div>
        </div>
    </div>
</div>

<div id="bulkActionBar" class="card mb-4 d-none">
    <div class="card-body d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bx bx-check-circle text-primary icon-md"></i>
            <span id="bulkSelectedCount" class="fw-medium text-heading">0</span>
            <span class="text-muted" id="bulkSelectedLabel">@SharedLocalizer["SelectedCount"]</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="btnClearSelection" class="btn btn-label-secondary">
                @SharedLocalizer["ClearSelection"]
            </button>
        </div>
    </div>
</div>

<div id="catalogStateHost" class="mb-3"></div>

<div class="row g-4 align-items-start">
    <div class="col-12 col-xl-3">
        <div class="card module-hierarchy-card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="mb-0">@Localizer["HierarchySummary"]</h6>
                    <small class="text-muted">@Localizer["HierarchySubtitle"]</small>
                </div>
                <span class="badge bg-label-primary" id="hierarchy-domain-count">0</span>
            </div>
            <div class="card-body pt-0">
                <div id="hierarchyState" class="mb-3"></div>
                <div id="hierarchyTree" class="module-hierarchy-tree"></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-9">
        <div class="card">
            <div id="skeleton-loader" class="p-4" style="display: none;">
                <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
                <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
                <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
                <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
                <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
            </div>

            <div class="card-datatable table-responsive">
                <table id="dt-module-catalog" data-dt-standard="v2" class="datatables-module-catalog table border-top">
                    <thead>
                        <tr>
                            <th></th>
                            <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                            <th>@Localizer["ModuleName"]</th>
                            <th>@Localizer["Domain"]</th>
                            <th>@Localizer["Suite"]</th>
                            <th>@Localizer["CapabilityGroup"]</th>
                            <th>@SharedLocalizer["Status"]</th>
                            <th>@Localizer["IsPlatformCore"]</th>
                            <th>@Localizer["IsTenantAssignable"]</th>
                            <th>@Localizer["SupportModel"]</th>
                            <th>@Localizer["PagesCount"]</th>
                            <th class="cell-fit text-end">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDetailsPreview" aria-labelledby="offcanvasDetailsPreviewLabel" style="width: 760px;">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center">
            <div class="avatar avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                <i class="bx bx-network-chart fs-4"></i>
            </div>
            <div>
                <h5 id="oc-title" class="offcanvas-title mb-0">-</h5>
                <small id="oc-subtitle" class="text-muted">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-0">
        <div class="p-4">
            <div class="bg-label-secondary rounded p-3 mb-4 d-flex align-items-center justify-content-between gap-3">
                <div>
                    <span class="d-block text-muted small fw-medium mb-1">@SharedLocalizer["Status"]</span>
                    <span id="oc-status" class="badge bg-label-secondary">-</span>
                </div>
                <div class="text-end">
                    <span class="d-block text-muted small fw-medium mb-1">@Localizer["PagesCount"]</span>
                    <span id="oc-pages-count" class="badge bg-label-primary">0</span>
                </div>
            </div>

            <ul class="nav nav-tabs nav-fill mb-4" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="module-overview-tab" data-bs-toggle="tab" data-bs-target="#module-overview-pane" type="button" role="tab" aria-controls="module-overview-pane" aria-selected="true">
                        <i class="icon-base bx bx-info-circle icon-sm me-1"></i>@Localizer["Overview"]
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="module-pages-tab" data-bs-toggle="tab" data-bs-target="#module-pages-pane" type="button" role="tab" aria-controls="module-pages-pane" aria-selected="false">
                        <i class="icon-base bx bx-file icon-sm me-1"></i>@Localizer["PageDefinitions"]
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="module-governance-tab" data-bs-toggle="tab" data-bs-target="#module-governance-pane" type="button" role="tab" aria-controls="module-governance-pane" aria-selected="false">
                        <i class="icon-base bx bx-shield-quarter icon-sm me-1"></i>@Localizer["GovernanceMetadata"]
                    </button>
                </li>
            </ul>

            <div class="tab-content p-0">
                <div class="tab-pane fade show active" id="module-overview-pane" role="tabpanel" aria-labelledby="module-overview-tab">
                    <h6 class="text-uppercase text-muted fw-bold mb-3">@Localizer["GeneralInformation"]</h6>
                    <dl class="row mb-4" id="oc-details-list"></dl>
                </div>
                <div class="tab-pane fade" id="module-pages-pane" role="tabpanel" aria-labelledby="module-pages-tab">
                    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                        <h6 class="text-uppercase text-muted fw-bold mb-0">@Localizer["PageDefinitions"]</h6>
                        <button type="button" class="btn btn-sm btn-label-primary" id="btnCreateModulePage">
                            <i class="icon-base bx bx-plus icon-sm me-1"></i>@Localizer["CreatePage"]
                        </button>
                    </div>
                    <div id="modulePagesState" class="mb-3"></div>
                    <div class="table-responsive mb-4">
                        <table class="table table-sm align-middle" id="modulePagesTable">
                            <thead>
                                <tr>
                                    <th>@Localizer["PageCode"]</th>
                                    <th>@Localizer["PageName"]</th>
                                    <th>@Localizer["PageType"]</th>
                                    <th>@Localizer["RoutePath"]</th>
                                    <th>@Localizer["RequiredPermissionKey"]</th>
                                    <th>@Localizer["NavigationCandidate"]</th>
                                    <th>@Localizer["IsActive"]</th>
                                    <th class="text-end">@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="module-governance-pane" role="tabpanel" aria-labelledby="module-governance-tab">
                    <div class="alert alert-primary mb-3">
                        <div class="fw-medium mb-1">@Localizer["BoundaryOwnershipTitle"]</div>
                        <div>@Localizer["BoundaryOwnershipText"]</div>
                    </div>
                    <div class="list-group list-group-flush border rounded">
                        <div class="list-group-item d-flex align-items-start gap-3">
                            <i class="icon-base bx bx-building-house text-muted mt-1"></i>
                            <div>
                                <div class="fw-medium">@Localizer["TenantAssignmentBoundaryTitle"]</div>
                                <small class="text-muted">@Localizer["TenantAssignmentBoundaryText"]</small>
                            </div>
                        </div>
                        <div class="list-group-item d-flex align-items-start gap-3">
                            <i class="icon-base bx bx-menu text-muted mt-1"></i>
                            <div>
                                <div class="fw-medium">@Localizer["NavigationBoundaryTitle"]</div>
                                <small class="text-muted">@Localizer["NavigationBoundaryText"]</small>
                            </div>
                        </div>
                        <div class="list-group-item d-flex align-items-start gap-3">
                            <i class="icon-base bx bx-key text-muted mt-1"></i>
                            <div>
                                <div class="fw-medium">@Localizer["PermissionBoundaryTitle"]</div>
                                <small class="text-muted">@Localizer["PermissionBoundaryText"]</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary flex-grow-1" data-bs-dismiss="offcanvas">
            @SharedLocalizer["Cancel"]
        </button>
        <button type="button" id="oc-btn-edit" class="btn btn-primary flex-grow-1" disabled title="@Localizer["EditLater"]">
            @Localizer["EditMetadata"]
        </button>
    </div>
</div>

<div class="modal fade" id="catalogEditorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="catalogEditorTitle">-</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <div id="catalogEditorAlert"></div>
                <form id="catalogEditorForm" novalidate></form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="button" id="btnCatalogEditorSave" class="btn btn-primary">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="catalogEditorSaving" aria-hidden="true"></span>
                    @Localizer["SaveChanges"]
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="importCatalogModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["ImportCatalog"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">@Localizer["ImportHelp"]</p>
                <textarea id="importPayload" class="form-control font-monospace" rows="12" placeholder="@Localizer["ImportPlaceholder"]"></textarea>
                <div id="importResultHost" class="mt-4"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="button" id="btnImportSubmit" class="btn btn-primary">@Localizer["ImportCatalog"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/ModuleCatalog/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ModuleCatalog/index.js" asp-append-version="true"></script>
}
