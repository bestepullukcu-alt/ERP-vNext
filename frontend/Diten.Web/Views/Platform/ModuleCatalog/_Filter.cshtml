@using Diten.Web.Views.Platform.ModuleCatalog
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ModuleCatalogIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-domain">
                        <select id="filterDomain" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Domain"]">
                        </select>
                    </div>

                    <div class="filter-chip filter-service">
                        <select id="filterService" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Service"]">
                        </select>
                    </div>

                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@SharedLocalizer["Status"]">
                            <option value="Draft">@Localizer["StatusDraft"]</option>
                            <option value="Active">@Localizer["StatusActive"]</option>
                            <option value="Inactive">@Localizer["StatusInactive"]</option>
                            <option value="Deprecated">@Localizer["StatusDeprecated"]</option>
                        </select>
                    </div>

                    <div class="filter-chip filter-assignable">
                        <select id="filterAssignable" class="form-select form-select-sm select2" data-placeholder="@Localizer["Assignable"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="true">@Localizer["Yes"]</option>
                            <option value="false">@Localizer["No"]</option>
                        </select>
                    </div>

                    <div class="filter-chip filter-core">
                        <select id="filterCore" class="form-select form-select-sm select2" data-placeholder="@Localizer["Core"]">
                            <option value="">@SharedLocalizer["ShowAll"]</option>
                            <option value="true">@Localizer["Yes"]</option>
                            <option value="false">@Localizer["No"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" id="btnFilterApply" class="btn btn-sm btn-primary">@SharedLocalizer["Apply"]</button>
                        <button type="reset" id="btnFilterReset" class="btn btn-sm btn-label-danger">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
