@using Diten.Web.Views.Platform.NotificationEvents
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<NotificationEventsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        @* Read-only catalog subset: no checkbox column and no bulk action bar. Events are manifest-driven — no
           Create/Edit/_Form is generated (deliberate read-only decision). *@
        <table id="dt-notificationevents" data-dt-standard="v2" class="datatables-notificationevents table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["EventCode"]</th>
                    <th>@Localizer["OwnerModule"]</th>
                    <th>@Localizer["Channel"]</th>
                    <th>@Localizer["DefaultTemplateKey"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th>@Localizer["TenantOverride"]</th>
                    <th>@Localizer["UsageType"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
