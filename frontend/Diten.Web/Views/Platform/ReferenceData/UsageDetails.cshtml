@using Diten.Web.Views.Platform.ReferenceData
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReferenceDataIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["UsageTitle"].Value;
    Layout = "_LayoutTenantShell";
    var setCode = ViewData["SetCode"]?.ToString() ?? string.Empty;
    var usageId = ViewData["UsageRegistrationId"]?.ToString() ?? string.Empty;
    var canRegister = ((bool?)ViewData["RdCanRegisterUsage"] ?? false);
}

<div id="rd-usage-details" data-set-code="@setCode" data-usage-id="@usageId">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h5 class="mb-0" id="ucd-title">@Localizer["UsageTitle"] <span class="text-muted fw-normal">— @setCode</span></h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/Platform/ReferenceData">@Localizer["PageTitle"]</a></li>
                    <li class="breadcrumb-item"><a href="/Platform/ReferenceData/Usage/@setCode">@Localizer["UsageTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@SharedLocalizer["Details"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Platform/ReferenceData/Usage/@setCode" class="btn btn-label-secondary">@Localizer["BackToSets"]</a>
            @if (canRegister)
            {
                <a href="/Platform/ReferenceData/Usage/@setCode/Edit/@usageId" class="btn btn-primary">@SharedLocalizer["EditRecord"]</a>
            }
        </div>
    </div>

    <div id="rd-usage-details-status" class="alert d-none mb-3" role="alert"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <section class="card backbone-preview-section mb-4">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["UsageSectionConsumer"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-md-6"><div class="text-muted small">@Localizer["UsageConsumerModuleLabel"]</div><div class="fw-medium" id="ucd-module">-</div></div>
                    <div class="col-md-6"><div class="text-muted small">@Localizer["UsageConsumerNameLabel"]</div><div class="fw-medium" id="ucd-name">-</div></div>
                    <div class="col-12"><div class="text-muted small">@Localizer["UsageConsumerEndpointLabel"]</div><div class="fw-medium" id="ucd-endpoint">-</div></div>
                    <div class="col-md-6"><div class="text-muted small">@Localizer["UsageScopeTypeLabel"]</div><div class="fw-medium" id="ucd-scope-type">-</div></div>
                    <div class="col-md-6"><div class="text-muted small">@Localizer["UsageScopeKeyLabel"]</div><div class="fw-medium" id="ucd-scope-key">-</div></div>
                </div>
            </section>
        </div>
        <div class="col-12 col-lg-5">
            <section class="card backbone-preview-section mb-4">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["UsageSectionResolution"]</h5></div>
                <div class="card-body row g-3">
                    <div class="col-md-6"><div class="text-muted small">@Localizer["UsageResolutionLabel"]</div><div class="fw-medium" id="ucd-resolution">-</div></div>
                    <div class="col-md-6"><div class="text-muted small">@Localizer["UsageCriticalityLabel"]</div><div id="ucd-criticality">-</div></div>
                    <div class="col-md-6"><div class="text-muted small">@Localizer["UsageVersionPinLabel"]</div><div class="fw-medium" id="ucd-version-pin">-</div></div>
                    <div class="col-md-6"><div class="text-muted small">@Localizer["UsageAsOfLabel"]</div><div class="fw-medium" id="ucd-asof">-</div></div>
                    <div class="col-12"><div class="text-muted small">@Localizer["UsageLastResolvedColumn"]</div><div class="fw-medium" id="ucd-last-resolved">-</div></div>
                    <div class="col-12"><div class="text-muted small">@Localizer["UsageNotesLabel"]</div><div class="fw-medium" id="ucd-notes">-</div></div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Platform/ReferenceData/_UsageIndexL10n.cshtml" />
    <script src="~/assets/js/Platform/ReferenceData/usage.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/reference-data.api.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/usage.details.js" asp-append-version="true"></script>
}
