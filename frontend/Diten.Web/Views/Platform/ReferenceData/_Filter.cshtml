@using Diten.Web.Views.Platform.ReferenceData
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReferenceDataIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" autocomplete="off" data-testid="rd-filter-form" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@SharedLocalizer["Status"]" data-testid="rd-filter-status">
                            <option value="Draft">Draft</option>
                            <option value="Active">Active</option>
                            <option value="Retired">Retired</option>
                        </select>
                    </div>

                    <div class="filter-chip filter-scope-type">
                        <select id="filterScopeType" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["ScopeType"]" data-testid="rd-filter-scope">
                            <option value="Global">Global</option>
                            <option value="Tenant">Tenant</option>
                            <option value="Company">Company</option>
                            <option value="Region">Region</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply" data-testid="rd-filter-apply">@SharedLocalizer["Apply"]</button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset" data-testid="rd-filter-reset">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
