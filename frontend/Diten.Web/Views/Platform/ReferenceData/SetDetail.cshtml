@using Diten.Web.Views.Platform.ReferenceData
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReferenceDataIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["SetDetailTitle"].Value;
    Layout = "_LayoutTenantShell";
    var setId = ViewData["SetId"]?.ToString() ?? string.Empty;
    string AccessFlag(string key) => ((bool?)ViewData[key] ?? false).ToString().ToLowerInvariant();
}
<div id="rd-set-detail-page" class="business-reference-data-set-details" data-set-id="@setId" data-testid="rd-set-detail-page" data-rd-permissions="true"
     data-can-update-set="@AccessFlag("RdCanUpdateSet")"
     data-can-create-version="@AccessFlag("RdCanCreateVersion")"
     data-can-update-version="@AccessFlag("RdCanUpdateVersion")"
     data-can-import-preview="@AccessFlag("RdCanImportPreview")"
     data-can-import-commit="@AccessFlag("RdCanImportCommit")"
     data-can-validate-version="@AccessFlag("RdCanValidateVersion")"
     data-can-submit-version="@AccessFlag("RdCanSubmitVersion")"
     data-can-approve-version="@AccessFlag("RdCanApproveVersion")"
     data-can-publish-version="@AccessFlag("RdCanPublishVersion")">

    <div class="d-flex align-items-start justify-content-between mb-3 gap-3 flex-wrap">
        <div>
            <h5 class="mb-0">@Localizer["SetDetailTitle"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/Platform/ReferenceData">@Localizer["PageTitle"]</a>
                    </li>
                    <li class="breadcrumb-item active text-primary">@Localizer["SetDetailTitle"]</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
            <a href="/Platform/ReferenceData" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
            <div class="d-inline-flex align-items-center gap-2 d-none" id="rd-set-actions" data-rd-hydration-region="actions">
                <button class="btn btn-primary" id="rd-btn-create-version" data-testid="rd-btn-create-version">
                    <i class="bx bx-plus me-1"></i>@Localizer["CreateDraft"]
                </button>
                <div class="dropdown">
                    <button type="button"
                            class="btn btn-label-secondary dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            title="@Localizer["Actions"]"
                            aria-label="@Localizer["Actions"]">
                        <i class="bx bx-cog me-1"></i>@Localizer["Actions"]
                    </button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <button type="button" class="dropdown-item" id="rd-btn-open-draft" disabled>
                            <i class="bx bx-edit-alt me-2"></i>@Localizer["OpenDraft"]
                        </button>
                        <button type="button" class="dropdown-item" id="rd-btn-open-published" disabled>
                            <i class="bx bx-show me-2"></i>@Localizer["OpenPublished"]
                        </button>
                        <button type="button" class="dropdown-item" id="rd-btn-create-from-published" disabled>
                            <i class="bx bx-copy-alt me-2"></i>@Localizer["CreateDraftFromPublished"]
                        </button>
                        <div class="dropdown-divider"></div>
                        <button type="button" class="dropdown-item" id="rd-btn-start-draft-wizard">
                            <i class="bx bx-slider-alt me-2"></i>@Localizer["OpenDraftWizard"]
                        </button>
                        <button type="button" class="dropdown-item" id="rd-btn-import-to-draft">
                            <i class="bx bx-import me-2"></i>@Localizer["ImportToDraft"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="rd-set-alert" class="alert alert-warning d-none" role="alert"></div>
    <div id="rd-published-first-guidance" class="alert alert-info d-none" role="alert" data-testid="rd-published-first-guidance">
        <div class="fw-semibold">@Localizer["PublishedFirstGuidanceTitle"]</div>
        <div class="small">@Localizer["PublishedFirstGuidanceDescription"]</div>
    </div>

    <div class="row g-4 d-none" id="rd-set-hydrated-content" data-rd-hydration-region="content">
        <div class="col-12 col-lg-6 d-flex">
            <section class="card backbone-preview-section p-4 w-100">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">
                    <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["SetIdentitySection"]</h6>
                    <button class="btn btn-sm btn-label-primary" id="rd-btn-save-set">
                        <i class="bx bx-save me-1"></i>@SharedLocalizer["Save"]
                    </button>
                </div>
                <form id="rd-set-form" class="row g-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-medium" for="rd-set-code">@Localizer["SetCode"]</label>
                        <input id="rd-set-code" class="form-control" disabled />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-medium" for="rd-set-scope">@Localizer["ScopeType"]</label>
                        <input id="rd-set-scope" class="form-control" disabled />
                    </div>
                    <div class="col-12 col-md-8">
                        <label class="form-label fw-medium" for="rd-set-name">@Localizer["SetName"] <span class="text-danger">*</span></label>
                        <input id="rd-set-name" class="form-control" maxlength="256" required />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-medium" for="rd-set-status">@SharedLocalizer["Status"]</label>
                        <select id="rd-set-status" class="form-select">
                            <option value="Draft">@Localizer["StatusDraft"]</option>
                            <option value="Active">@SharedLocalizer["Active"]</option>
                            <option value="Retired">@Localizer["StatusRetired"]</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-medium" for="rd-set-description">@Localizer["Description"]</label>
                        <textarea id="rd-set-description" class="form-control" rows="4"></textarea>
                    </div>
                </form>
            </section>
        </div>

        <div class="col-12 col-lg-6 d-flex">
            <section class="card backbone-preview-section p-4 w-100">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Governance"]</h6>
                <div class="row g-4">
                    <div class="col-12 col-sm-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-edit"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["DraftVersion"]</div>
                                <div class="backbone-preview-value mt-1" id="rd-active-draft">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-check-shield"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["PublishedVersion"]</div>
                                <div class="backbone-preview-value mt-1" id="rd-published-version">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-git-branch"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["RowVersion"]</div>
                                <div class="backbone-preview-value mt-1" id="rd-set-row-version">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar-event"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Updated"]</div>
                                <div class="backbone-preview-value mt-1" id="rd-set-updated">-</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button class="btn btn-sm btn-label-secondary" id="rd-btn-validate-draft" disabled>
                        <i class="bx bx-check-circle me-1"></i>@Localizer["ValidateDraft"]
                    </button>
                    <button class="btn btn-sm btn-label-primary" id="rd-btn-submit-draft" disabled>
                        <i class="bx bx-send me-1"></i>@Localizer["SubmitForApproval"]
                    </button>
                    <button class="btn btn-sm btn-primary" id="rd-btn-publish-draft" disabled>
                        <i class="bx bx-shield-quarter me-1"></i>@Localizer["PublishReadiness"]
                    </button>
                </div>
                <div id="rd-draft-validation" class="alert alert-info d-none mt-3 mb-0"></div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/ReferenceData/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/reference-data.api.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/reference-data.permissions.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/set-detail.js" asp-append-version="true"></script>
}
