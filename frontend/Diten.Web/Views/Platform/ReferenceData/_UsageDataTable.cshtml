@using Diten.Web.Views.Platform.ReferenceData
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReferenceDataIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-usage" data-dt-standard="v2" class="datatables-usage table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th>@Localizer["UsageConsumerModuleLabel"]</th>
                    <th class="all">@Localizer["UsageConsumerNameLabel"]</th>
                    <th>@Localizer["UsageResolutionLabel"]</th>
                    <th>@Localizer["UsageScopeColumn"]</th>
                    <th>@Localizer["UsageCriticalityLabel"]</th>
                    <th>@Localizer["UsageLastResolvedColumn"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
