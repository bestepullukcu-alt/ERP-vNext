@using Diten.Web.Views.Platform.ReferenceData
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReferenceDataIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Filter Chip: Resolution Mode (Multi-select) *@
                    <div class="filter-chip filter-resolution">
                        <select id="filterResolution" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["UsageResolutionLabel"]">
                            <option value="latest">@Localizer["UsageResolutionLatest"]</option>
                            <option value="pinned">@Localizer["UsageResolutionPinned"]</option>
                            <option value="as-of">@Localizer["UsageResolutionAsOf"]</option>
                        </select>
                    </div>

                    @* Filter Chip: Criticality (Multi-select) *@
                    <div class="filter-chip filter-criticality">
                        <select id="filterCriticality" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["UsageCriticalityLabel"]">
                            <option value="critical">@Localizer["UsageCriticalityCritical"]</option>
                            <option value="high">@Localizer["UsageCriticalityHigh"]</option>
                            <option value="medium">@Localizer["UsageCriticalityMedium"]</option>
                            <option value="low">@Localizer["UsageCriticalityLow"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
