@using Diten.Web.Views.Platform.ReferenceData
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReferenceDataIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["PublishReviewTitle"].Value;
    Layout = "_LayoutTenantShell";
    var versionId = ViewData["VersionId"]?.ToString() ?? string.Empty;
    string AccessFlag(string key) => ((bool?)ViewData[key] ?? false).ToString().ToLowerInvariant();
}
<div id="rd-publish-review-page" data-version-id="@versionId" data-testid="rd-publish-review-page" data-rd-permissions="true"
     data-rd-evidence-enabled="false"
     data-can-validate-version="@AccessFlag("RdCanValidateVersion")"
     data-can-submit-version="@AccessFlag("RdCanSubmitVersion")"
     data-can-approve-version="@AccessFlag("RdCanApproveVersion")"
     data-can-publish-version="@AccessFlag("RdCanPublishVersion")"
     data-can-publish-override="@AccessFlag("RdCanPublishOverride")">

    <div class="d-flex align-items-center justify-content-between mb-3 gap-3 flex-wrap">
        <div>
            <h5 class="mb-0">@Localizer["PublishReviewTitle"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/Platform/ReferenceData">@Localizer["PageTitle"]</a>
                    </li>
                    <li class="breadcrumb-item active text-primary">@Localizer["PublishReviewTitle"]</li>
                </ol>
            </nav>
        </div>
    </div>

    <div id="rd-review-alert" class="alert alert-info d-none mb-3"></div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-5 g-4 mb-4">
        <div class="col">
            <div class="card h-100">
                <div class="card-body p-3">
                    <small class="text-muted d-block">@Localizer["UsageImpactTotal"]</small>
                    <h5 id="rd-impact-total" class="mb-0">0</h5>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body p-3">
                    <small class="text-muted d-block">@Localizer["UsageImpactCritical"]</small>
                    <h5 id="rd-impact-critical" class="mb-0 text-danger">0</h5>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body p-3">
                    <small class="text-muted d-block">@Localizer["UsageCriticalityHigh"]</small>
                    <h5 id="rd-impact-high" class="mb-0 text-warning">0</h5>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body p-3">
                    <small class="text-muted d-block">@Localizer["UsageCriticalityMedium"]</small>
                    <h5 id="rd-impact-medium" class="mb-0 text-info">0</h5>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body p-3">
                    <small class="text-muted d-block">@Localizer["UsageCriticalityLow"]</small>
                    <h5 id="rd-impact-low" class="mb-0 text-secondary">0</h5>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left column: Lifecycle Summary + Dependencies + Version History -->
        <div class="col-12 col-xl-8">
            <div class="row g-4">
                <div class="col-12">
                    <section class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">@Localizer["LifecycleSummary"]</h5>
                        </div>
                        <div class="card-body">
                            <div id="rd-review-badges" class="mb-3">-</div>
                            <dl class="row mb-0 small">
                                <dt class="col-6">@Localizer["Version"]</dt>
                                <dd class="col-6 mb-1" id="rd-review-version">-</dd>
                                <dt class="col-6">@Localizer["SetLabel"]</dt>
                                <dd class="col-6 mb-1" id="rd-review-set">-</dd>
                                <dt class="col-6">@Localizer["SubmittedLabel"]</dt>
                                <dd class="col-6 mb-1" id="rd-review-submitted">-</dd>
                                <dt class="col-6">@Localizer["PublishedLabel"]</dt>
                                <dd class="col-6 mb-1" id="rd-review-published">-</dd>
                                <dt class="col-6">@Localizer["EvidenceLabel"]</dt>
                                <dd class="col-6 mb-0" id="rd-review-evidence-current">-</dd>
                            </dl>
                        </div>
                    </section>
                </div>
                <div class="col-12">
                    <section class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">@Localizer["UsageTitle"]</h5>
                        </div>
                        <div class="card-datatable table-responsive">
                            <table class="table border-top mb-0">
                                <thead>
                                    <tr>
                                        <th>@Localizer["UsageConsumerModuleLabel"]</th>
                                        <th>@Localizer["UsageConsumerNameLabel"]</th>
                                        <th>@Localizer["UsageCriticalityLabel"]</th>
                                    </tr>
                                </thead>
                                <tbody id="rd-dependencies-body"></tbody>
                            </table>
                        </div>
                    </section>
                </div>
                <div class="col-12">
                    <section class="card">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <h5 class="card-title mb-0">@Localizer["VersionHistory"]</h5>
                            <button type="button" class="btn btn-icon btn-label-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#rd-history-collapse" aria-expanded="true" aria-controls="rd-history-collapse">
                                <i class="icon-base bx bx-chevron-up"></i>
                            </button>
                        </div>
                        <div id="rd-history-collapse" class="collapse show">
                            <div class="card-body pb-0">
                                <div id="rd-history-timeline" class="ms-1 py-3"></div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>

        <!-- Right column: Governance Actions (sticky) + Dependency Impact -->
        <div class="col-12 col-xl-4">
            <div class="rd-publish-review-sticky">
                <section class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">@Localizer["GovernanceActions"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label fw-medium" for="rd-review-evidence-link">@Localizer["CanonicalEvidenceLink"]</label>
                                <select id="rd-review-evidence-link" class="select2 form-select"></select>
                                <div id="rd-review-evidence-status" class="form-text">-</div>
                                <input id="rd-review-evidence-ref" class="form-control mt-2" maxlength="256" placeholder="@Localizer["EvidenceRefPlaceholder"]" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-medium d-block">@Localizer["ApprovalDecision"]</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="rd-review-decision" id="rd-review-decision-approve" value="approve" checked />
                                        <label class="form-check-label" for="rd-review-decision-approve">@SharedLocalizer["Approve"]</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="rd-review-decision" id="rd-review-decision-reject" value="reject" />
                                        <label class="form-check-label" for="rd-review-decision-reject">@Localizer["RejectDecision"]</label>
                                    </div>
                                </div>
                                <input id="rd-review-rejection-reason" class="form-control mt-2" maxlength="500" placeholder="@Localizer["RejectionReasonPlaceholder"]" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-medium" for="rd-review-publish-mode">@Localizer["PublishMode"]</label>
                                <select id="rd-review-publish-mode" class="select2 form-select">
                                    <option value="Immediate">@Localizer["PublishModeImmediate"]</option>
                                    <option value="FutureDated">@Localizer["PublishModeFutureDated"]</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-medium" for="rd-review-publish-at">@Localizer["PublishAtUtc"]</label>
                                <input id="rd-review-publish-at" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input id="rd-review-override" class="form-check-input" type="checkbox" role="switch" />
                                    <label class="form-check-label ms-2" for="rd-review-override">@Localizer["PublishOverride"]</label>
                                </div>
                                <input id="rd-review-override-reason" class="form-control mt-2" maxlength="500" placeholder="@Localizer["OverrideReasonPlaceholder"]" />
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="d-grid gap-2">
                            <button class="btn btn-sm btn-label-secondary" id="rd-review-validate">
                                <i class="bx bx-check-circle me-1"></i>@Localizer["Validate"]
                            </button>
                            <button class="btn btn-sm btn-label-primary" id="rd-review-submit">
                                <i class="bx bx-send me-1"></i>@Localizer["SubmitForApproval"]
                            </button>
                            <button class="btn btn-sm btn-label-info" id="rd-review-approve">
                                <i class="bx bx-check-double me-1"></i>@SharedLocalizer["Approve"]
                            </button>
                            <button class="btn btn-sm btn-primary" id="rd-review-publish">
                                <i class="bx bx-shield-quarter me-1"></i><span id="rd-review-publish-label">@Localizer["Publish"]</span>
                            </button>
                        </div>
                        <div id="rd-governance-hint" class="form-text text-center mt-2 d-none"></div>
                    </div>
                </section>

                <div id="rd-readiness-alert" class="alert alert-primary mb-4" role="alert">
                    <h5 class="alert-heading d-flex align-items-center gap-2 mb-2">
                        <span class="alert-icon rounded-circle"><i id="rd-readiness-icon" class="icon-base bx bx-info-circle"></i></span>@Localizer["PublishReadinessTitle"]
                    </h5>
                    <hr>
                    <div id="rd-validation-summary" data-testid="rd-validation-summary">-</div>
                    <h6 class="text-uppercase fw-semibold small mb-2">@Localizer["ChecksTitle"]</h6>
                    <ul class="list-group list-group-flush" id="rd-readiness-checks"></ul>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/ReferenceData/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/reference-data.api.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/reference-data.permissions.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/publish-review.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (!window.jQuery || !jQuery.fn || !jQuery.fn.select2) return;
            jQuery('#rd-publish-review-page .select2').each(function () {
                var $el = jQuery(this);
                $el.wrap('<div class="position-relative"></div>').select2({
                    dropdownParent: $el.parent(),
                    minimumResultsForSearch: 10
                });
            });
        });
    </script>
}
