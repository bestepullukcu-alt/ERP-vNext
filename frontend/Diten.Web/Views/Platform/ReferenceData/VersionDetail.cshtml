@using Diten.Web.Views.Platform.ReferenceData
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReferenceDataIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["VersionDetailTitle"].Value;
    Layout = "_LayoutTenantShell";
    var versionId = ViewData["VersionId"]?.ToString() ?? string.Empty;
    string AccessFlag(string key) => ((bool?)ViewData[key] ?? false).ToString().ToLowerInvariant();
}
<div id="rd-version-page" data-version-id="@versionId" data-testid="rd-version-page" data-rd-permissions="true"
     data-can-update-version="@AccessFlag("RdCanUpdateVersion")"
     data-can-validate-version="@AccessFlag("RdCanValidateVersion")"
     data-can-submit-version="@AccessFlag("RdCanSubmitVersion")"
     data-can-approve-version="@AccessFlag("RdCanApproveVersion")"
     data-can-publish-version="@AccessFlag("RdCanPublishVersion")">
    <div class="mb-3 d-flex justify-content-between align-items-start gap-2 flex-wrap">
        <div><h5 class="mb-0">@Localizer["VersionDetailTitle"]</h5><p class="mb-0 text-muted">@Localizer["VersionDetailDescription"]</p></div>
        <div class="d-flex gap-2">
            <button class="btn btn-label-secondary btn-sm" id="rd-btn-retry-load">@SharedLocalizer["Refresh"]</button>
            <button class="btn btn-label-secondary btn-sm" id="rd-btn-open-set" disabled>@Localizer["Open"]</button>
            <button class="btn btn-label-secondary btn-sm" id="rd-btn-add-value">@Localizer["AddValue"]</button>
            <button class="btn btn-label-primary btn-sm" id="rd-btn-save-values">@SharedLocalizer["Save"]</button>
            <button class="btn btn-label-secondary btn-sm" id="rd-btn-validate">@Localizer["Validate"]</button>
            <button class="btn btn-label-primary btn-sm" id="rd-btn-submit">Submit for Approval</button>
            <button class="btn btn-primary btn-sm" id="rd-btn-publish">Review Publish Readiness</button>
        </div>
    </div>
    <div id="rd-inline-alert" class="alert alert-danger d-none" role="alert" data-testid="rd-inline-alert"></div>
    <div id="rd-empty-draft-state" class="alert alert-info d-none" role="alert" data-testid="rd-empty-draft-state">
        <div class="fw-semibold mb-1">No values in this draft yet.</div>
        <div class="mb-2">Add a value, or open the published version while you prepare this draft.</div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-label-primary" id="rd-btn-open-published-fallback" type="button">Open Published Version</button>
            <button class="btn btn-sm btn-primary" id="rd-btn-seed-draft-from-published" type="button">Seed Draft from Published</button>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3" id="rd-version-badges" data-testid="rd-version-badges"></div>
            <div id="rd-validation-blockers" class="alert alert-warning mt-3 d-none mb-0"></div>
        </div>
    </div>
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">@Localizer["ValueGridTitle"]</span>
            <span id="rd-version-mode" class="badge bg-label-secondary">@SharedLocalizer["Loading"]</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0" id="rd-values-table" data-testid="rd-values-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;"></th>
                            <th>@Localizer["SetCode"]</th>
                            <th>@Localizer["SetName"]</th>
                            <th>@Localizer["Description"]</th>
                            <th style="width: 120px;">@SharedLocalizer["Status"]</th>
                            <th style="width: 120px;">@Localizer["SortOrder"]</th>
                            <th>@Localizer["AttributesTitle"]</th>
                            <th class="text-end" style="width: 90px;">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="rd-values-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card mt-3">
        <div class="card-header py-2">
            <button class="btn btn-sm btn-label-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#rd-json-debug" aria-expanded="false" aria-controls="rd-json-debug">@Localizer["TechnicalJsonView"]</button>
        </div>
        <div id="rd-json-debug" class="collapse">
            <div class="card-body">
                <pre id="rd-version-json" class="mb-0" data-testid="rd-version-json">{}</pre>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/ReferenceData/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/reference-data.api.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/reference-data.permissions.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/version-detail.js" asp-append-version="true"></script>
}
