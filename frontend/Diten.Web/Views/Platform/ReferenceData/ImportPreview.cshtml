@using Diten.Web.Views.Platform.ReferenceData
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<ReferenceDataIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["ImportTitle"].Value;
    Layout = "_LayoutTenantShell";
    string AccessFlag(string key) => ((bool?)ViewData[key] ?? false).ToString().ToLowerInvariant();
}
<div id="rd-import-page" data-testid="rd-import-page" data-rd-permissions="true"
     data-can-import-preview="@AccessFlag("RdCanImportPreview")"
     data-can-import-commit="@AccessFlag("RdCanImportCommit")">
    <div class="mb-3"><h5 class="mb-0">@Localizer["ImportTitle"]</h5><p class="mb-0 text-muted">@Localizer["ImportDescription"]</p></div>

    <div id="rd-import-status" class="alert alert-info d-none mb-3"></div>
    <div id="rd-import-empty" class="alert alert-info d-none mb-3"></div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Import Format Guidance</div>
        <div class="card-body">
            <ul class="mb-0">
                <li><code>value_code</code> and <code>display_name</code> are required.</li>
                <li><code>parent_value_code</code> supports hierarchy assignment in draft.</li>
                <li><code>attributes</code> (json) can be provided for value-level metadata.</li>
                <li>Commit is blocked when preview has blocking issues.</li>
            </ul>
        </div>
    </div>

    <div class="card mb-3"><div class="card-body">
        <form id="rd-import-form" class="row g-3" data-testid="rd-import-form">
            <div class="col-md-4"><label class="form-label">Set</label><select id="rd-import-set-code" class="form-select"></select></div>
            <div class="col-md-4"><label class="form-label">Target Draft Version</label><select id="rd-import-version-id" class="form-select" required></select></div>
            <div class="col-md-3"><label class="form-label">Format</label><select id="rd-import-format" class="form-select"><option value="json">json</option><option value="csv">csv</option></select></div>
            <div class="col-md-5"><label class="form-label">@Localizer["SelectFile"]</label><input id="rd-import-file" type="file" class="form-control" required /></div>
            <div class="col-12 d-flex justify-content-end"><button class="btn btn-primary" type="submit">@Localizer["ImportPreview"]</button></div>
        </form>
    </div></div>

    <div class="card mb-3"><div class="card-body d-flex align-items-center justify-content-between">
        <div><div class="text-muted small">Preview Id</div><div id="rd-import-preview-id" data-testid="rd-import-preview-id">-</div></div>
        <div class="d-flex gap-2">
            <button class="btn btn-label-secondary" id="rd-import-export-errors" disabled data-testid="rd-import-export-errors">Export Errors</button>
            <button class="btn btn-success" id="rd-import-commit" disabled data-testid="rd-import-commit">@Localizer["CommitImport"]</button>
        </div>
    </div></div>

    <div class="card"><div class="table-responsive">
        <table class="table mb-0" data-testid="rd-import-preview-table"><thead><tr><th>Row</th><th>Value</th><th>Operation</th><th>Valid</th><th>Issues</th></tr></thead><tbody id="rd-import-preview-body"></tbody></table>
    </div></div>
    <div class="card mt-3"><div class="card-body"><pre id="rd-import-result" class="mb-0" data-testid="rd-import-result">{}</pre></div></div>
</div>
@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/ReferenceData/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/reference-data.api.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/reference-data.permissions.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/ReferenceData/import-preview.js" asp-append-version="true"></script>
}
