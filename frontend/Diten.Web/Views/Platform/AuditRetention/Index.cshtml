@using Diten.Web.Views.Platform.AuditRetention
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AuditRetentionIndex> Localizer
@{
    ViewData["Title"] = Localizer["AuditRetention.Title"].Value;
    Layout = "_LayoutPlatformAdmin";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-3 row-gap-3">
    <div>
        <h5 class="mb-0">@Localizer["AuditRetention.Title"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>
</div>

<div id="audit-retention-permission" class="alert alert-warning d-none" role="alert">@Localizer["AuditRetention.Unauthorized"]</div>
<div id="audit-retention-error" class="alert alert-danger d-none" role="alert"></div>

<partial name="~/Views/Platform/AuditRetention/_DataTable.cshtml" />
<partial name="~/Views/Platform/AuditRetention/_Form.cshtml" />

@section Scripts {
    <partial name="~/Views/Platform/AuditRetention/_IndexL10n.cshtml" />
    <script src="~/assets/js/Platform/AuditRetention/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/AuditRetention/index.js" asp-append-version="true"></script>
}
