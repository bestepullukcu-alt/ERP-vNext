@using Diten.Web.Views.Platform.AuditRetention
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AuditRetentionIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="p-4" style="display: none;">
        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>
    <div class="card-datatable table-responsive">
        <table id="dt-audit-retention" data-dt-standard="v2" class="datatables-audit-retention table border-top align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["AuditRetention.PolicyId"]</th>
                    <th>@Localizer["AuditRetention.Category"]</th>
                    <th>@Localizer["AuditRetention.PlanTier"]</th>
                    <th class="text-end">@Localizer["AuditRetention.DefaultRetention"]</th>
                    <th class="text-end">@Localizer["AuditRetention.MaxRetention"]</th>
                    <th class="text-end">@Localizer["AuditRetention.HotStorage"]</th>
                    <th>@Localizer["AuditRetention.TenantOverride"]</th>
                    <th>@Localizer["AuditRetention.PolicyStatus"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["AuditRetention.Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
