@using Diten.Web.Views.Platform.HrisSources
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<HrisSourcesIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-platform-hris-sources" data-dt-standard="v2" class="datatables-platform-hris-sources table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["DisplayName"]</th>
                    <th>@Localizer["ProviderKind"]</th>
                    <th>@Localizer["LifecycleState"]</th>
                    <th>@Localizer["SyncMode"]</th>
                    <th>@Localizer["LastValidatedAt"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
