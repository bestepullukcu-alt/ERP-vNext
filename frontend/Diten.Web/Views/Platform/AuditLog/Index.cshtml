@using Diten.Web.Views.Platform.AuditLog
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AuditLogIndex> Localizer
@{
    ViewData["Title"] = Localizer["AuditLog.Title"].Value;
    Layout = "_LayoutPlatformAdmin";
}

<partial name="~/Views/Platform/AuditLog/_Filter.cshtml" />

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-3 row-gap-3">
    <div>
        <h5 class="mb-0">@Localizer["AuditLog.Title"]</h5>
        <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
    </div>
</div>

<div id="audit-log-permission" class="alert alert-warning d-none" role="alert">@Localizer["AuditLog.Unauthorized"]</div>
<div id="audit-log-error" class="alert alert-danger d-none" role="alert"></div>
<div id="audit-log-empty" class="alert alert-secondary d-none" role="status">@Localizer["AuditLog.Empty"]</div>

<div id="audit-redaction-result" class="alert alert-info d-none" role="status"></div>

<partial name="~/Views/Platform/AuditLog/_DataTable.cshtml" />
<partial name="~/Views/Platform/AuditLog/_DetailsModal.cshtml" />
<partial name="~/Views/Platform/AuditLog/_RedactionTemplate.cshtml" />

@section Scripts {
    <partial name="~/Views/Platform/AuditLog/_IndexL10n.cshtml" />
    <script src="~/assets/js/Platform/AuditLog/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/AuditLog/index.js" asp-append-version="true"></script>
}
