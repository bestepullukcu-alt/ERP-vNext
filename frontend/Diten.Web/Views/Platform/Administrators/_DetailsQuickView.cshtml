@using Diten.Web.Views.Platform.Administrators
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AdministratorsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end backbone-preview-offcanvas" tabindex="-1" id="offcanvasDetailsPreview"
    aria-labelledby="offcanvasDetailsPreviewLabel">
    <div class="offcanvas-header py-6">
        <div class="d-flex align-items-center min-w-0">
            <div class="backbone-preview-avatar d-flex align-items-center justify-content-center me-3 flex-shrink-0">
                <i class="bx bx-user-check fs-4"></i>
            </div>
            <div class="min-w-0">
                <h5 id="oc-title" class="offcanvas-title mb-1 text-truncate">-</h5>
                <small id="oc-subtitle" class="text-muted d-block text-truncate">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"
            aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-0 border-top">
        <div class="p-4 d-flex flex-column gap-4">
            <section class="card backbone-preview-section backbone-preview-status px-4 py-3 d-flex flex-row align-items-center justify-content-between">
                <span class="fw-semibold text-heading">@SharedLocalizer["Status"]</span>
                <span id="oc-status" class="badge bg-label-secondary">-</span>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["GeneralInformation"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-envelope"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Email"]</div>
                                <div id="oc-email" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-user"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["UserName"]</div>
                                <div id="oc-username" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-id-card"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["ActorType"]</div>
                                <div id="oc-actor-type" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-shield-quarter"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["Roles"]</div>
                                <div id="oc-roles" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-envelope-open"></i>
                            <div>
                                <div class="backbone-preview-label">@Localizer["InvitationStatus"]</div>
                                <div id="oc-invitation-status" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ScopeAndAudit"]</h6>
                <div class="row g-4">
                    <div class="col-12 js-partner-scope d-none">
                        <div class="backbone-preview-label">@Localizer["PartnerId"]</div>
                        <div id="oc-partner-id" class="backbone-preview-value mt-1">-</div>
                    </div>
                    <div class="col-12 js-partner-scope d-none">
                        <div class="backbone-preview-label">@Localizer["AllowedTenantIds"]</div>
                        <div id="oc-tenant-scope" class="backbone-preview-description mt-1">-</div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-label">@Localizer["AuditPreview"]</div>
                        <div id="oc-audit" class="backbone-preview-description mt-1">-</div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2 bg-white">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" id="oc-btn-edit" class="btn btn-primary" data-bs-dismiss="offcanvas">
            @SharedLocalizer["EditRecord"]
        </button>
    </div>
</div>
