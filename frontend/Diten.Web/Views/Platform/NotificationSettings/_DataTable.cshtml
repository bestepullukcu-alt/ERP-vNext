@using Diten.Web.Views.Platform.NotificationSettings
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<NotificationSettingsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        @* Tenant messaging settings are deleted one tenant at a time (no bulk endpoint), so there is no
           checkbox column or bulk action bar by design (no-shell rule). *@
        <table id="dt-notificationsettings" data-dt-standard="v2" class="datatables-notificationsettings table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="all">@Localizer["TargetTenant"]</th>
                    <th>@Localizer["Provider"]</th>
                    <th>@Localizer["SenderEmail"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th>@Localizer["FallbackPolicy"]</th>
                    <th>@Localizer["UpdatedAt"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
