@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Text.Json
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Details"].Value;
    Layout = "_LayoutPlatformAdmin";
    var tenantId = ViewData["TenantId"]?.ToString() ?? string.Empty;
    var currentActorJson = JsonSerializer.Serialize(new
    {
        id = ViewData["CurrentActorId"]?.ToString() ?? string.Empty,
        display = ViewData["CurrentActorDisplay"]?.ToString() ?? string.Empty
    });
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4" data-tenant-id="@tenantId" id="tenantDetailsRoot">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0" id="detailsTitle">@Localizer["Details"]</h5>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item position-relative"><a asp-controller="Tenants" asp-action="Index" class="stretched-link">@Localizer["TenantsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@Localizer["Details"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-3">
        <a href="/Platform/Tenants/Edit/@tenantId" class="btn btn-label-primary">@SharedLocalizer["EditRecord"]</a>
        <button type="button" id="btnSuspendTenant" class="btn btn-label-warning d-none">@Localizer["Suspend"]</button>
        <button type="button" id="btnReactivateTenant" class="btn btn-label-success d-none">@Localizer["Reactivate"]</button>
        <a asp-controller="Tenants" asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-4 order-1 order-xl-1">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar avatar-lg bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3" id="tenantLogoAvatar">
                        <i class="bx bx-buildings fs-3"></i>
                    </div>
                    <div>
                        <h5 id="detailDisplayName" class="mb-0">-</h5>
                        <small id="detailCodeSlug" class="text-muted">-</small>
                    </div>
                </div>
                <div class="border rounded p-3 mb-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="tenantLogoInput">Tenant Logo</label>
                            <input type="file" id="tenantLogoInput" class="form-control" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                            <div class="form-text">PNG, JPG, WEBP or SVG. Max 1 MB.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="tenantFaviconInput">Fav Icon</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar avatar-sm bg-label-secondary rounded d-flex align-items-center justify-content-center" id="tenantFaviconPreview">
                                    <i class="bx bx-image"></i>
                                </div>
                                <input type="file" id="tenantFaviconInput" class="form-control" accept="image/png,image/x-icon,image/vnd.microsoft.icon,image/svg+xml" />
                            </div>
                            <div class="form-text">PNG, ICO or SVG. Max 256 KB.</div>
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-2">
                            <button type="button" id="btnSaveBranding" class="btn btn-primary btn-sm">
                                <i class="bx bx-upload me-1"></i> Upload
                            </button>
                            <button type="button" id="btnClearBranding" class="btn btn-label-secondary btn-sm">
                                <i class="bx bx-reset me-1"></i> Clear
                            </button>
                        </div>
                    </div>
                </div>
                <dl class="row mb-0">
                    <dt class="col-5 mb-2">@SharedLocalizer["Status"]</dt>
                    <dd class="col-7 mb-2"><span id="detailStatus" class="badge bg-label-secondary">-</span></dd>
                    <dt class="col-5 mb-2">@Localizer["Provisioning"]</dt>
                    <dd id="detailProvisioning" class="col-7 mb-2">-</dd>
                    <dt class="col-5 mb-2">@Localizer["Domain"]</dt>
                    <dd id="detailDomain" class="col-7 mb-2 text-break">-</dd>
                    <dt class="col-5 mb-2">@Localizer["TenantType"]</dt>
                    <dd id="detailTenantType" class="col-7 mb-2">-</dd>
                    <dt class="col-5 mb-2">@Localizer["SubscriptionPlan"]</dt>
                    <dd id="detailPlan" class="col-7 mb-2">-</dd>
                    <dt class="col-5 mb-2">@Localizer["SubscriptionStatus"]</dt>
                    <dd class="col-7 mb-2"><span id="detailSubscriptionStatus" class="badge bg-label-secondary">-</span></dd>
                    <dt class="col-5 mb-2">@Localizer["Country"]</dt>
                    <dd id="detailCountry" class="col-7 mb-2">-</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8 order-2 order-xl-2">
        <div class="nav-align-top">
                <ul class="nav nav-pills flex-column flex-md-row mb-4 flex-wrap row-gap-2" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabOverview" type="button" role="tab">
                            <i class="icon-base bx bx-buildings icon-sm me-1_5"></i>@Localizer["Overview"]
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAccess" type="button" role="tab">
                            <i class="icon-base bx bx-lock-alt icon-sm me-1_5"></i>Access
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabCommercial" type="button" role="tab">
                            <i class="icon-base bx bx-detail icon-sm me-1_5"></i>Commercial
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabSystemMonitoring" type="button" role="tab">
                            <i class="icon-base bx bx-pulse icon-sm me-1_5"></i>System Monitoring
                        </button>
                    </li>
                </ul>
        </div>
        <div class="tab-content p-0">
                    <div class="tab-pane fade show active" id="tabOverview">
                        <div class="row g-4">
                            <div class="col-12 col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <h6 class="mb-0">Basic Information</h6>
                                    </div>
                                    <div class="card-body">
                                        <dl class="row mb-0" id="basicInformationList"></dl>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <h6 class="mb-0">Contact Information</h6>
                                    </div>
                                    <div class="card-body">
                                        <dl class="row mb-0" id="contactInformationList"></dl>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <h6 class="mb-0">Enabled Modules</h6>
                                    </div>
                                    <div class="card-body">
                                        <div id="overviewEnabledModules" class="list-group list-group-flush"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="card h-100">
                                    <div class="card-header d-flex align-items-center justify-content-between gap-3">
                                        <h6 class="mb-0">Recent Activity</h6>
                                        <button type="button" id="btnViewAllRecentActivity" class="btn btn-link btn-sm px-0 d-none" aria-expanded="false">
                                            View all <i class="icon-base bx bx-arrow-to-right"></i>
                                        </button>
                                    </div>
                                    <div class="card-body">
                                        <div id="overviewRecentActivity" class="list-group list-group-flush"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tabAccess">
                        <div class="nav-align-top">
                            <ul class="nav nav-tabs mb-4" role="tablist">
                                <li class="nav-item">
                                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabAdminUsers" type="button" role="tab">
                                        Admin Users
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabLoginSecurity" type="button" role="tab">
                                        Login &amp; Security
                                    </button>
                                </li>
                            </ul>
                        </div>
                        <div class="tab-content p-0">
                            <div class="tab-pane fade show active" id="tabAdminUsers" role="tabpanel">
                                <div class="card">
                                    <div class="card-header d-flex align-items-center justify-content-between gap-3">
                                        <h6 class="mb-0">Admin Users</h6>
                                        <button type="button" id="btnAddAdminUser" class="btn btn-primary btn-sm">
                                            <i class="icon-base bx bx-plus me-1"></i>Add Admin
                                        </button>
                                    </div>
                                    <div class="card-body">
                                        <div id="usersSummary" class="row g-3 mb-4"></div>
                                        <div class="table-responsive">
                                            <table id="dtTenantAdminUsers" data-dt-standard="v2" class="table border-top w-100">
                                                <thead>
                                                    <tr>
                                                        <th>Name</th>
                                                        <th>Email</th>
                                                        <th>Status</th>
                                                        <th class="text-end">Actions</th>
                                                    </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="tabLoginSecurity" role="tabpanel">
                                <form id="tenantLoginSecurityForm" novalidate>
                                    <div class="d-flex justify-content-end mb-3">
                                        <button type="submit" id="btnSaveLoginSecurity" class="btn btn-primary btn-sm">
                                            <i class="icon-base bx bx-save me-1"></i>@SharedLocalizer["Save"]
                                        </button>
                                    </div>
                                    <div class="alert alert-danger d-none" id="loginSecurityErrorSummary"></div>
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <h6 class="mb-0">@Localizer["AuthenticationSettings"]</h6>
                                        </div>
                                        <div class="card-body row g-3">
                                            <div class="col-12 col-md-6">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="detailEmailLoginEnabled" name="emailLoginEnabled">
                                                    <label class="form-check-label" for="detailEmailLoginEnabled">@Localizer["EmailLoginEnabled"]</label>
                                                </div>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="detailPhoneLoginEnabled" name="phoneLoginEnabled">
                                                    <label class="form-check-label" for="detailPhoneLoginEnabled">@Localizer["PhoneLoginEnabled"]</label>
                                                </div>
                                                <div class="form-text">@Localizer["PhoneLoginFutureSupport"]</div>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="detailTwoFactorEnabled" name="twoFactorEnabled">
                                                    <label class="form-check-label" for="detailTwoFactorEnabled">@Localizer["TwoFactorEnabled"]</label>
                                                </div>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="detailMfaRequired" name="mfaRequired">
                                                    <label class="form-check-label" for="detailMfaRequired">@Localizer["MfaRequired"]</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card mb-4">
                                        <div class="card-header">
                                            <h6 class="mb-0">@Localizer["PasswordPolicy"]</h6>
                                        </div>
                                        <div class="card-body row g-3">
                                            <div class="col-12 col-md-6">
                                                <label class="form-label" for="detailPasswordMinLength">@Localizer["PasswordMinLength"] <span class="text-danger">*</span></label>
                                                <input type="number" id="detailPasswordMinLength" name="passwordMinLength" class="form-control" min="8" max="128" required>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label class="form-label" for="detailPasswordExpirationDays">@Localizer["PasswordExpirationDays"]</label>
                                                <input type="number" id="detailPasswordExpirationDays" name="passwordExpirationDays" class="form-control" min="1" max="3650">
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="detailPasswordRequireUppercase" name="passwordRequireUppercase">
                                                    <label class="form-check-label" for="detailPasswordRequireUppercase">@Localizer["RequireUppercase"]</label>
                                                </div>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="detailPasswordRequireSpecialChar" name="passwordRequireSpecialChar">
                                                    <label class="form-check-label" for="detailPasswordRequireSpecialChar">@Localizer["RequireSpecialChar"]</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card">
                                        <div class="card-header">
                                            <h6 class="mb-0">@Localizer["SessionSettings"]</h6>
                                        </div>
                                        <div class="card-body row g-3">
                                            <div class="col-12 col-md-6 col-lg-3">
                                                <label class="form-label" for="detailSessionTimeoutMinutes">@Localizer["SessionTimeoutMinutes"] <span class="text-danger">*</span></label>
                                                <input type="number" id="detailSessionTimeoutMinutes" name="sessionTimeoutMinutes" class="form-control" min="5" max="1440" required>
                                            </div>
                                            <div class="col-12 col-md-6 col-lg-3">
                                                <label class="form-label" for="detailMaxFailedLoginAttempts">@Localizer["MaxFailedLoginAttempts"] <span class="text-danger">*</span></label>
                                                <input type="number" id="detailMaxFailedLoginAttempts" name="maxFailedLoginAttempts" class="form-control" min="1" max="20" required>
                                            </div>
                                            <div class="col-12 col-md-6 col-lg-3">
                                                <label class="form-label" for="detailLockoutDurationMinutes">@Localizer["LockoutDurationMinutes"] <span class="text-danger">*</span></label>
                                                <input type="number" id="detailLockoutDurationMinutes" name="lockoutDurationMinutes" class="form-control" min="1" max="1440" required>
                                            </div>
                                            <div class="col-12 col-md-6 col-lg-3">
                                                <label class="form-label" for="detailRefreshTokenLifetimeDays">@Localizer["RefreshTokenLifetimeDays"] <span class="text-danger">*</span></label>
                                                <input type="number" id="detailRefreshTokenLifetimeDays" name="refreshTokenLifetimeDays" class="form-control" min="1" max="365" required>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tabCommercial"><div id="modulesSummary"></div></div>
                    <div class="tab-pane fade" id="tabSystemMonitoring">
                        <div class="row g-4">
                            <div class="col-12">
                                <h6 class="text-uppercase text-muted">@Localizer["Settings"]</h6>
                                <div class="row mb-4" id="settingsSummary"></div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <h6 class="text-uppercase text-muted">@Localizer["ProvisioningSteps"]</h6>
                                <div id="provisioningSteps" class="list-group list-group-flush"></div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <h6 class="text-uppercase text-muted">@Localizer["ActivityTimeline"]</h6>
                                <div id="activityTimeline" class="list-group list-group-flush"></div>
                            </div>
                        </div>
                    </div>
        </div>
    </div>
</div>

<div class="modal fade" id="adminUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="adminUserForm" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="adminUserModalTitle">Add Admin User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="adminUserId" />
                <div class="mb-3">
                    <label class="form-label" for="adminUserName">Name</label>
                    <input type="text" id="adminUserName" class="form-control" maxlength="160" required />
                    <div class="invalid-feedback">Name is required.</div>
                </div>
                <div class="mb-0">
                    <label class="form-label" for="adminUserEmail">Email</label>
                    <input type="email" id="adminUserEmail" class="form-control" maxlength="254" required />
                    <div class="invalid-feedback">Valid email is required.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary" id="btnSaveAdminUser">
                    <i class="icon-base bx bx-save me-1"></i>@SharedLocalizer["Save"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_IndexL10n" />
    <script>
        window.TenantCurrentActor = @Html.Raw(currentActorJson);
    </script>
    <script src="~/assets/js/Platform/Tenants/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/Tenants/details.js" asp-append-version="true"></script>
}
