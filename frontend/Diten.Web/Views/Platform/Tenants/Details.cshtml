@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Text.Json
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Details"].Value;
    Layout = "_LayoutPlatformAdmin";
    var tenantId = ViewData["TenantId"]?.ToString() ?? string.Empty;
    var currentActorJson = JsonSerializer.Serialize(new
    {
        id = ViewData["CurrentActorId"]?.ToString() ?? string.Empty,
        display = ViewData["CurrentActorDisplay"]?.ToString() ?? string.Empty
    });
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4" data-tenant-id="@tenantId" id="tenantDetailsRoot">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0" id="detailsTitle">@Localizer["Details"]</h5>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item position-relative"><a asp-controller="Tenants" asp-action="Index" class="stretched-link">@Localizer["TenantsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@Localizer["Details"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-3">
        <a href="/Platform/Tenants/Edit/@tenantId" class="btn btn-label-primary">@SharedLocalizer["EditRecord"]</a>
        <button type="button" id="btnSuspendTenant" class="btn btn-label-warning d-none">@Localizer["Suspend"]</button>
        <button type="button" id="btnReactivateTenant" class="btn btn-label-success d-none">@Localizer["Reactivate"]</button>
        <a asp-controller="Tenants" asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-4 d-flex flex-column flex-xl-row align-items-start align-items-xl-center justify-content-between gap-4">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar tenant-header-logo bg-primary-subtle text-primary rounded d-flex align-items-center justify-content-center" id="tenantLogoAvatar">
                <i class="bx bx-buildings fs-3"></i>
            </div>
            <div>
                <h5 class="mb-1" id="detailDisplayName">-</h5>
                <small id="detailCodeSlug" class="text-muted font-monospace fs-tiny d-block mb-1">-</small>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-label-info" id="detailProvisioning">-</span>
                    <span id="detailTenantType"></span>
                    <span class="badge bg-label-secondary" id="detailStatus">-</span>
                </div>
            </div>
        </div>
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-2 gap-md-4">
            <div>
                <small class="text-muted text-uppercase d-block mb-1">@Localizer["Domain"]</small>
                <span class="fw-medium text-break" id="detailDomain">-</span>
            </div>
            <div class="border-start d-none d-md-block align-self-stretch"></div>
            <div>
                <small class="text-muted text-uppercase d-block mb-1">@Localizer["Plan"]</small>
                <span class="fw-medium" id="detailPlan">-</span>
            </div>
            <div class="border-start d-none d-md-block align-self-stretch"></div>
            <div>
                <small class="text-muted text-uppercase d-block mb-1">@Localizer["Country"]</small>
                <span class="fw-medium" id="detailCountry">-</span>
            </div>
            <div class="border-start d-none d-md-block align-self-stretch"></div>
            <div>
                <small class="text-muted text-uppercase d-block mb-1">@Localizer["CreatedBy"]</small>
                <span class="fw-medium" id="detailCreatedBy">-</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header p-3">
        <div class="nav-align-top">
            <ul class="nav nav-pills d-inline-flex gap-2 flex-wrap" role="tablist">
                <li class="nav-item mb-1 mb-sm-0" role="presentation">
                    <button type="button" class="nav-link active small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabOverview" role="tab" aria-selected="true">
                        <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-buildings me-1 wc-tab-icon"></i>@Localizer["Overview"]</span>
                        <i class="bx bx-buildings d-sm-none wc-tab-icon"></i>
                    </button>
                </li>
                <li class="nav-item mb-1 mb-sm-0" role="presentation">
                    <button type="button" class="nav-link small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabAccess" role="tab" aria-selected="false">
                        <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-lock-alt me-1 wc-tab-icon"></i>Access</span>
                        <i class="bx bx-lock-alt d-sm-none wc-tab-icon"></i>
                    </button>
                </li>
                <li class="nav-item mb-1 mb-sm-0" role="presentation">
                    <button type="button" class="nav-link small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabCommercial" role="tab" aria-selected="false">
                        <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-detail me-1 wc-tab-icon"></i>Commercial</span>
                        <i class="bx bx-detail d-sm-none wc-tab-icon"></i>
                    </button>
                </li>
                <li class="nav-item mb-1 mb-sm-0" role="presentation">
                    <button type="button" class="nav-link small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabSystemMonitoring" role="tab" aria-selected="false">
                        <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-pulse me-1 wc-tab-icon"></i>System Monitoring</span>
                        <i class="bx bx-pulse d-sm-none wc-tab-icon"></i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>
        <div class="tab-content p-0">
                    <div class="tab-pane fade show active" id="tabOverview">
                        <div class="row g-4">
                            <div class="col-12 col-md-8 d-flex flex-column gap-4">
                                <section class="card backbone-preview-section p-4">
                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">Basic Information</h6>
                                    <div class="row g-4" id="basicInformationList"></div>
                                </section>
                                <section class="card backbone-preview-section p-4">
                                    <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                                        <h6 class="text-uppercase text-heading fw-semibold mb-0">Recent Activity</h6>
                                        <button type="button" id="btnViewAllRecentActivity" class="btn btn-link btn-sm px-0 d-none" aria-expanded="false">
                                            View all <i class="icon-base bx bx-arrow-to-right"></i>
                                        </button>
                                    </div>
                                    <div id="overviewRecentActivity" class="list-group list-group-flush"></div>
                                </section>
                            </div>
                            <div class="col-12 col-md-4 d-flex flex-column gap-4">
                                <section class="card backbone-preview-section p-4">
                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Branding"]</h6>
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label" for="tenantLogoInput">Tenant Logo</label>
                                            <input type="file" id="tenantLogoInput" class="form-control" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                                            <div class="form-text">PNG, JPG, WEBP or SVG. Max 1 MB.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label" for="tenantFaviconInput">Fav Icon</label>
                                            <div class="d-flex align-items-center gap-3">
                                                <input type="file" id="tenantFaviconInput" class="form-control" accept="image/png,image/x-icon,image/vnd.microsoft.icon,image/svg+xml" />
                                                <div class="avatar bg-label-secondary rounded d-flex align-items-center justify-content-center flex-shrink-0" id="tenantFaviconPreview">
                                                    <i class="bx bx-image"></i>
                                                </div>
                                            </div>
                                            <div class="form-text">PNG, ICO or SVG. Max 256 KB.</div>
                                        </div>
                                        <div class="col-12 d-flex flex-wrap gap-2">
                                            <button type="button" id="btnSaveBranding" class="btn btn-primary btn-sm">
                                                <i class="bx bx-upload me-1"></i> Upload
                                            </button>
                                            <button type="button" id="btnClearBranding" class="btn btn-label-secondary btn-sm">
                                                <i class="bx bx-reset me-1"></i> Clear
                                            </button>
                                        </div>
                                    </div>
                                </section>
                                <section class="card backbone-preview-section p-4">
                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">Contact Information</h6>
                                    <div class="row g-4" id="contactInformationList"></div>
                                </section>
                                <section class="card backbone-preview-section p-4">
                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">Enabled Modules</h6>
                                    <div id="overviewEnabledModules" class="list-group"></div>
                                </section>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tabAccess">
                        <div class="card mb-4">
                            <div class="card-header p-3">
                                <div class="nav-align-top">
                                    <ul class="nav nav-pills d-inline-flex gap-2 flex-wrap" role="tablist">
                                        <li class="nav-item mb-1 mb-sm-0" role="presentation">
                                            <button type="button" class="nav-link active small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabAdminUsers" role="tab" aria-selected="true">
                                                <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-user me-1 wc-tab-icon"></i>Admin Users</span>
                                                <i class="bx bx-user d-sm-none wc-tab-icon"></i>
                                            </button>
                                        </li>
                                        <li class="nav-item mb-1 mb-sm-0" role="presentation">
                                            <button type="button" class="nav-link small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabLoginSecurity" role="tab" aria-selected="false">
                                                <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-lock-alt me-1 wc-tab-icon"></i>Login &amp; Security</span>
                                                <i class="bx bx-lock-alt d-sm-none wc-tab-icon"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="tab-content p-0">
                            <div class="tab-pane fade show active" id="tabAdminUsers" role="tabpanel">
                                <div id="usersSummary" class="row g-4 mb-4"></div>
                                <div id="tenantNoAdminWarning" class="alert alert-warning d-none mb-4" role="alert">
                                    <i class="icon-base bx bx-error-circle me-1"></i><span>@Localizer["NoUsableAdminWarning"]</span>
                                </div>
                                <div class="card">
                                    <div id="adminUsersSkeleton" class="p-4" role="status" aria-busy="true">
                                        <span class="visually-hidden">@SharedLocalizer["Loading"]</span>
                                        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
                                        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
                                        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
                                        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
                                        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
                                    </div>
                                    <div class="card-datatable table-responsive d-none">
                                        <table id="dtTenantAdminUsers" data-dt-standard="v2" class="table border-top w-100">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Email</th>
                                                    <th>Status</th>
                                                    <th class="cell-fit text-end">Actions</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="tabLoginSecurity" role="tabpanel">
                                <form id="tenantLoginSecurityForm" novalidate>
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 row-gap-3">
                                        <div>
                                            <h5 class="mb-0">@Localizer["LoginSecurityTitle"]</h5>
                                            <p class="mb-0 text-muted">@Localizer["LoginSecurityPageDescription"]</p>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="submit" id="btnSaveLoginSecurity" class="btn btn-primary">@SharedLocalizer["Save"]</button>
                                        </div>
                                    </div>
                                    <div class="alert alert-danger d-none" id="loginSecurityErrorSummary"></div>
                                    <div class="row g-4">
                                        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
                                            <div class="card">
                                                <div class="card-body p-4">
                                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["AuthenticationSettings"]</h6>
                                                    <div class="row g-3">
                                                        <div class="col-12">
                                                            <div class="setting-switch-row">
                                                                <div class="setting-switch-row__text d-flex align-items-start gap-3">
                                                                    <div class="avatar avatar-sm flex-shrink-0"><span class="avatar-initial rounded bg-label-primary"><i class="bx bx-shield-quarter"></i></span></div>
                                                                    <div>
                                                                        <label class="form-label fw-medium mb-0" for="detailEmailLoginEnabled">@Localizer["EmailLoginEnabled"]</label>
                                                                        <div class="text-muted small">@Localizer["EmailLoginHelp"]</div>
                                                                    </div>
                                                                </div>
                                                                <div class="form-check form-switch setting-switch-row__control">
                                                                    <input class="form-check-input" type="checkbox" role="switch" id="detailEmailLoginEnabled" name="emailLoginEnabled">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="setting-switch-row">
                                                                <div class="setting-switch-row__text d-flex align-items-start gap-3">
                                                                    <div class="avatar avatar-sm flex-shrink-0"><span class="avatar-initial rounded bg-label-secondary"><i class="bx bx-mobile-alt"></i></span></div>
                                                                    <div>
                                                                        <label class="form-label fw-medium mb-0" for="detailPhoneLoginEnabled">@Localizer["PhoneLoginEnabled"]</label>
                                                                        <div class="text-muted small">@Localizer["PhoneLoginHelp"]</div>
                                                                    </div>
                                                                </div>
                                                                <div class="form-check form-switch setting-switch-row__control">
                                                                    <input class="form-check-input" type="checkbox" role="switch" id="detailPhoneLoginEnabled" name="phoneLoginEnabled">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="setting-switch-row">
                                                                <div class="setting-switch-row__text d-flex align-items-start gap-3">
                                                                    <div class="avatar avatar-sm flex-shrink-0"><span class="avatar-initial rounded bg-label-secondary"><i class="bx bx-lock-alt"></i></span></div>
                                                                    <div>
                                                                        <label class="form-label fw-medium mb-0" for="detailTwoFactorEnabled">@Localizer["TwoFactorEnabled"]</label>
                                                                        <div class="text-muted small">@Localizer["TwoFactorHelp"]</div>
                                                                    </div>
                                                                </div>
                                                                <div class="form-check form-switch setting-switch-row__control">
                                                                    <input class="form-check-input" type="checkbox" role="switch" id="detailTwoFactorEnabled" name="twoFactorEnabled">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="setting-switch-row">
                                                                <div class="setting-switch-row__text d-flex align-items-start gap-3">
                                                                    <div class="avatar avatar-sm flex-shrink-0"><span class="avatar-initial rounded bg-label-warning"><i class="bx bx-error"></i></span></div>
                                                                    <div>
                                                                        <label class="form-label fw-medium mb-0" for="detailMfaRequired">@Localizer["MfaRequired"]</label>
                                                                        <div class="text-muted small">@Localizer["MfaRequiredHelp"]</div>
                                                                    </div>
                                                                </div>
                                                                <div class="form-check form-switch setting-switch-row__control">
                                                                    <input class="form-check-input" type="checkbox" role="switch" id="detailMfaRequired" name="mfaRequired">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card">
                                                <div class="card-body p-4">
                                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SessionSettings"]</h6>
                                                    <div class="row g-4">
                                                        <div class="col-12 col-md-6">
                                                            <label class="form-label fw-medium" for="detailSessionTimeoutMinutes">@Localizer["SessionTimeoutMinutes"] <span class="text-danger">*</span></label>
                                                            <div class="input-group">
                                                                <input type="number" id="detailSessionTimeoutMinutes" name="sessionTimeoutMinutes" class="form-control" min="5" max="1440" required>
                                                                <span class="input-group-text">@Localizer["UnitMin"]</span>
                                                            </div>
                                                            <div class="form-text">@Localizer["SessionTimeoutHelp"]</div>
                                                        </div>
                                                        <div class="col-12 col-md-6">
                                                            <label class="form-label fw-medium" for="detailMaxFailedLoginAttempts">@Localizer["MaxFailedLoginAttempts"] <span class="text-danger">*</span></label>
                                                            <input type="number" id="detailMaxFailedLoginAttempts" name="maxFailedLoginAttempts" class="form-control" min="1" max="20" required>
                                                            <div class="form-text">@Localizer["MaxFailedLoginAttemptsHelp"]</div>
                                                        </div>
                                                        <div class="col-12 col-md-6">
                                                            <label class="form-label fw-medium" for="detailLockoutDurationMinutes">@Localizer["LockoutDurationMinutes"] <span class="text-danger">*</span></label>
                                                            <div class="input-group">
                                                                <input type="number" id="detailLockoutDurationMinutes" name="lockoutDurationMinutes" class="form-control" min="1" max="1440" required>
                                                                <span class="input-group-text">@Localizer["UnitMin"]</span>
                                                            </div>
                                                            <div class="form-text">@Localizer["LockoutDurationHelp"]</div>
                                                        </div>
                                                        <div class="col-12 col-md-6">
                                                            <label class="form-label fw-medium" for="detailRefreshTokenLifetimeDays">@Localizer["RefreshTokenLifetimeDays"] <span class="text-danger">*</span></label>
                                                            <div class="input-group">
                                                                <input type="number" id="detailRefreshTokenLifetimeDays" name="refreshTokenLifetimeDays" class="form-control" min="1" max="365" required>
                                                                <span class="input-group-text">@Localizer["UnitDays"]</span>
                                                            </div>
                                                            <div class="form-text">@Localizer["RefreshTokenLifetimeHelp"]</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
                                            <div class="card">
                                                <div class="card-body p-4">
                                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["PasswordPolicy"]</h6>
                                                    <div class="row g-4">
                                                        <div class="col-12">
                                                            <label class="form-label fw-medium" for="detailPasswordMinLength">@Localizer["PasswordMinLength"] <span class="text-danger">*</span></label>
                                                            <input type="number" id="detailPasswordMinLength" name="passwordMinLength" class="form-control" min="8" max="128" required>
                                                            <div class="form-text">@Localizer["PasswordMinLengthHelp"]</div>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label fw-medium" for="detailPasswordExpirationDays">@Localizer["PasswordExpirationDays"]</label>
                                                            <div class="input-group">
                                                                <input type="number" id="detailPasswordExpirationDays" name="passwordExpirationDays" class="form-control" min="1" max="3650">
                                                                <span class="input-group-text">@Localizer["UnitDays"]</span>
                                                            </div>
                                                            <div class="form-text">@Localizer["PasswordExpirationHelp"]</div>
                                                        </div>
                                                        <div class="col-12">
                                                            <hr class="mt-0 mb-3">
                                                            <div class="small text-muted">@Localizer["ComplexityRequirements"]</div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="setting-switch-row">
                                                                <div class="setting-switch-row__text">
                                                                    <label class="form-label fw-medium mb-0" for="detailPasswordRequireUppercase">@Localizer["RequireUppercase"]</label>
                                                                    <div class="text-muted small">@Localizer["RequireUppercaseHelp"]</div>
                                                                </div>
                                                                <div class="form-check form-switch setting-switch-row__control">
                                                                    <input class="form-check-input" type="checkbox" role="switch" id="detailPasswordRequireUppercase" name="passwordRequireUppercase">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="setting-switch-row">
                                                                <div class="setting-switch-row__text">
                                                                    <label class="form-label fw-medium mb-0" for="detailPasswordRequireSpecialChar">@Localizer["RequireSpecialChar"]</label>
                                                                    <div class="text-muted small">@Localizer["RequireSpecialCharHelp"]</div>
                                                                </div>
                                                                <div class="form-check form-switch setting-switch-row__control">
                                                                    <input class="form-check-input" type="checkbox" role="switch" id="detailPasswordRequireSpecialChar" name="passwordRequireSpecialChar">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="small fw-medium">@Localizer["PolicyStrength"]</span>
                                                                <span class="small fw-medium" id="passwordPolicyStrengthLabel">—</span>
                                                            </div>
                                                            <div class="progress">
                                                                <div class="progress-bar" id="passwordPolicyStrengthBar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="alert alert-primary d-flex align-items-start gap-2 mb-0 py-3 px-3" role="alert">
                                                <i class="bx bx-info-circle mt-1"></i>
                                                <div>
                                                    <h6 class="alert-heading fw-semibold mb-0">@Localizer["SettingsScopeTitle"]</h6>
                                                    <p class="mb-0 small">@Localizer["SettingsScopeDescription"]</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tabCommercial">
                        <partial name="Commercial/_PlanSubscriptionTab" />
                    </div>
                    <div class="tab-pane fade" id="tabSystemMonitoring">
                        <div class="row g-4">
                            <div class="col-12">
                                <section class="card backbone-preview-section p-4">
                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["Settings"]</h6>
                                    <div class="row g-4" id="settingsSummary"></div>
                                </section>
                            </div>
                            <div class="col-12 col-lg-6">
                                <section class="card backbone-preview-section p-4">
                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ProvisioningSteps"]</h6>
                                    <div id="provisioningSteps" class="list-group"></div>
                                </section>
                            </div>
                            <div class="col-12 col-lg-6">
                                <section class="card backbone-preview-section p-4">
                                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["ActivityTimeline"]</h6>
                                    <div id="activityTimeline" class="list-group"></div>
                                </section>
                            </div>
                        </div>
                    </div>
        </div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="subscriptionActionOffcanvas" aria-labelledby="subscriptionActionTitle">
    <div class="offcanvas-header p-4">
        <h5 id="subscriptionActionTitle" class="offcanvas-title">@Localizer["AssignPlan"]</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body border-top p-4">
        <form id="subscriptionActionForm" class="pt-0" novalidate data-no-tracker>
            <input type="hidden" id="subscriptionActionType" />
            <div id="subscriptionPlanFields" class="row g-4">
                <div class="col-12">
                    <label class="form-label fw-medium" for="subscriptionPlanSelect">@Localizer["Plan"] <span class="text-danger">*</span></label>
                    <select class="form-select select2-offcanvas" id="subscriptionPlanSelect" required></select>
                    <div class="invalid-feedback">@Localizer["PlanRequired"]</div>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="subscriptionIsTrial">
                        <label class="form-check-label" for="subscriptionIsTrial">@Localizer["StartTrial"]</label>
                    </div>
                </div>
                <div class="col-12" id="subscriptionTrialEndWrap">
                    <label class="form-label fw-medium" for="subscriptionTrialEnd">@Localizer["TrialEndDate"] <span class="text-danger d-none" id="subscriptionTrialEndRequiredMark">*</span></label>
                    <input type="text" class="form-control flatpickr-date" id="subscriptionTrialEnd" placeholder="YYYY-MM-DD" autocomplete="off">
                    <div class="invalid-feedback">@Localizer["TrialEndDateRequired"]</div>
                </div>
                <div class="col-12" id="subscriptionPeriodEndWrap">
                    <label class="form-label fw-medium" for="subscriptionPeriodEnd">@Localizer["CurrentPeriodEnd"] <span class="text-danger" id="subscriptionPeriodEndRequiredMark">*</span></label>
                    <input type="text" class="form-control flatpickr-date" id="subscriptionPeriodEnd" placeholder="YYYY-MM-DD" autocomplete="off">
                    <div class="invalid-feedback">@Localizer["CurrentPeriodEndRequired"]</div>
                </div>
            </div>
            <div id="subscriptionReasonField" class="d-none">
                <label class="form-label fw-medium" for="subscriptionReason">@Localizer["Reason"] <span class="text-danger">*</span></label>
                <textarea class="form-control" id="subscriptionReason" rows="3" maxlength="500"></textarea>
                <div class="invalid-feedback">@Localizer["ReasonRequired"]</div>
                <div class="form-check mt-3 d-none" id="subscriptionCancelAtPeriodEndWrap">
                    <input class="form-check-input" type="checkbox" id="subscriptionCancelAtPeriodEnd">
                    <label class="form-check-label" for="subscriptionCancelAtPeriodEnd">@Localizer["CancelAtPeriodEnd"]</label>
                </div>
            </div>
            <div id="subscriptionPeriodField" class="d-none">
                <label class="form-label fw-medium" for="subscriptionActionPeriodEnd">@Localizer["CurrentPeriodEnd"] <span class="text-danger">*</span></label>
                <input type="text" class="form-control flatpickr-date" id="subscriptionActionPeriodEnd" placeholder="YYYY-MM-DD" autocomplete="off">
                <div class="invalid-feedback">@Localizer["CurrentPeriodEndRequired"]</div>
            </div>
        </form>
    </div>
    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="submit" form="subscriptionActionForm" class="btn btn-primary" id="btnSubmitSubscriptionAction">@SharedLocalizer["Save"]</button>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="adminUserOffcanvas" aria-labelledby="adminUserModalTitle">
    <div class="offcanvas-header p-4">
        <h5 id="adminUserModalTitle" class="offcanvas-title">Add Admin User</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>
    <div class="offcanvas-body border-top p-4">
        <form id="adminUserForm" class="pt-0" novalidate>
            <input type="hidden" id="adminUserId" />
            <div class="row g-4">
                <div class="col-12">
                    <label class="form-label fw-medium" for="adminUserName">Name <span class="text-danger">*</span></label>
                    <input type="text" id="adminUserName" class="form-control" maxlength="160" required />
                    <div class="invalid-feedback">Name is required.</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-medium" for="adminUserEmail">Email <span class="text-danger">*</span></label>
                    <input type="email" id="adminUserEmail" class="form-control" maxlength="254" required />
                    <div class="invalid-feedback">Valid email is required.</div>
                </div>
            </div>
        </form>
    </div>
    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
        <button type="button" id="btnSaveAdminUser" class="btn btn-primary">@SharedLocalizer["Save"]</button>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
}

@section Scripts {
    <partial name="_IndexL10n" />
    <script>
        window.TenantCurrentActor = @Html.Raw(currentActorJson);
    </script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="~/assets/js/Platform/Tenants/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/Tenants/details.js" asp-append-version="true"></script>
}
