@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["Details"].Value;
    Layout = "_LayoutBackbone";
    var tenantId = ViewData["TenantId"]?.ToString() ?? string.Empty;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4" data-tenant-id="@tenantId" id="tenantDetailsRoot">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0" id="detailsTitle">@Localizer["Details"]</h5>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item position-relative"><a asp-controller="Tenants" asp-action="Index" class="stretched-link">@Localizer["TenantsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@Localizer["Details"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-3">
        <a href="/Platform/TenantSecurity?tenantId=@tenantId" class="btn btn-label-primary">@Localizer["ManageLoginSecurity"]</a>
        <button type="button" id="btnSuspendTenant" class="btn btn-label-warning">@Localizer["Suspend"]</button>
        <button type="button" id="btnReactivateTenant" class="btn btn-label-success">@Localizer["Reactivate"]</button>
        <a asp-controller="Tenants" asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <div class="avatar avatar-lg bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                        <i class="bx bx-buildings fs-3"></i>
                    </div>
                    <div>
                        <h5 id="detailDisplayName" class="mb-0">-</h5>
                        <small id="detailCodeSlug" class="text-muted">-</small>
                    </div>
                </div>
                <dl class="row mb-0">
                    <dt class="col-5 mb-2">@SharedLocalizer["Status"]</dt>
                    <dd class="col-7 mb-2"><span id="detailStatus" class="badge bg-label-secondary">-</span></dd>
                    <dt class="col-5 mb-2">@Localizer["Provisioning"]</dt>
                    <dd id="detailProvisioning" class="col-7 mb-2">-</dd>
                    <dt class="col-5 mb-2">@Localizer["Domain"]</dt>
                    <dd id="detailDomain" class="col-7 mb-2 text-break">-</dd>
                    <dt class="col-5 mb-2">@Localizer["TenantType"]</dt>
                    <dd id="detailTenantType" class="col-7 mb-2">-</dd>
                    <dt class="col-5 mb-2">@Localizer["Country"]</dt>
                    <dd id="detailCountry" class="col-7 mb-2">-</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-header border-bottom">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabOverview" type="button">@Localizer["Overview"]</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabProvisioning" type="button">@Localizer["Provisioning"]</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabModules" type="button">@Localizer["Modules"]</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabUsers" type="button">@Localizer["Users"]</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabSettings" type="button">@Localizer["Settings"]</button></li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content p-0">
                    <div class="tab-pane fade show active" id="tabOverview">
                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <h6 class="text-uppercase text-muted">@Localizer["LegalAndContact"]</h6>
                                <dl class="row mb-0" id="legalContactList"></dl>
                            </div>
                            <div class="col-12 col-md-6">
                                <h6 class="text-uppercase text-muted">@Localizer["LocaleDefaults"]</h6>
                                <dl class="row mb-0" id="localeDefaultsList"></dl>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tabProvisioning">
                        <div class="row g-4">
                            <div class="col-12 col-lg-6">
                                <h6 class="text-uppercase text-muted">@Localizer["ProvisioningSteps"]</h6>
                                <div id="provisioningSteps" class="list-group list-group-flush"></div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <h6 class="text-uppercase text-muted">@Localizer["ActivityTimeline"]</h6>
                                <div id="activityTimeline" class="list-group list-group-flush"></div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tabModules"><div id="modulesSummary"></div></div>
                    <div class="tab-pane fade" id="tabUsers"><div id="usersSummary"></div></div>
                    <div class="tab-pane fade" id="tabSettings"><div id="settingsSummary"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/Tenants/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/Tenants/details.js" asp-append-version="true"></script>
}
