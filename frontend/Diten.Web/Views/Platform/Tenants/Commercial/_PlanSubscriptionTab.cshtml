@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card mb-4">
    <div class="card-header p-3">
        <div class="nav-align-top">
            <ul class="nav nav-pills d-inline-flex gap-2 flex-wrap" role="tablist">
                <li class="nav-item mb-1 mb-sm-0" role="presentation">
                    <button type="button" class="nav-link active small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabPlanSubscription" role="tab" aria-selected="true">
                        <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-credit-card me-1 wc-tab-icon"></i>@Localizer["PlanSubscription"]</span>
                        <i class="bx bx-credit-card d-sm-none wc-tab-icon"></i>
                    </button>
                </li>
                <li class="nav-item mb-1 mb-sm-0" role="presentation">
                    <button type="button" class="nav-link small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabModuleEntitlements" role="tab" aria-selected="false">
                        <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-grid-alt me-1 wc-tab-icon"></i>@Localizer["ModuleEntitlements"]</span>
                        <i class="bx bx-grid-alt d-sm-none wc-tab-icon"></i>
                    </button>
                </li>
                <li class="nav-item mb-1 mb-sm-0" role="presentation">
                    <button type="button" class="nav-link small border shadow-none wc-tab-compact" data-bs-toggle="tab" data-bs-target="#tabTenantQuotaGovernance" role="tab" aria-selected="false">
                        <span class="d-none d-sm-inline-flex align-items-center"><i class="bx bx-bar-chart-alt-2 me-1 wc-tab-icon"></i>@Localizer["tenant.commercial.quota.title"]</span>
                        <i class="bx bx-bar-chart-alt-2 d-sm-none wc-tab-icon"></i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="tab-content p-0">
    <div class="tab-pane fade show active" id="tabPlanSubscription" role="tabpanel">
        <div class="row g-4">
            <div class="col-12">
                <div id="commercialSubscriptionError" class="alert alert-danger d-none"></div>
                <div id="commercialSubscriptionLoading" class="card" role="status" aria-busy="true">
                    <div class="p-4">
                        <span class="visually-hidden">@SharedLocalizer["Loading"]</span>
                        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
                        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
                        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
                        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
                        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
                    </div>
                </div>
            </div>

            <div class="col-12 d-none" id="commercialSubscriptionEmpty">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="icon-base bx bx-credit-card fs-1 text-muted mb-3"></i>
                        <h6 class="mb-2">@Localizer["NoActiveSubscriptionFound"]</h6>
                        <p class="text-muted mb-4">@Localizer["NoActiveSubscriptionDescription"]</p>
                        <button type="button" id="btnAssignSubscriptionEmpty" class="btn btn-primary">
                            <i class="icon-base bx bx-plus me-1"></i>@Localizer["AssignPlan"]
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-12 d-none" id="commercialSubscriptionContent">
                <div class="card mb-4">
                    <div class="card-body p-4 pb-0 d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <h6 class="text-uppercase text-heading fw-semibold mb-1">@Localizer["CurrentSubscription"]</h6>
                            <p class="text-muted mb-0">@Localizer["CurrentSubscriptionSubtitle"]</p>
                        </div>
                        <button type="button" id="btnReactivateSubscription"
                            class="btn btn-label-success btn-sm d-none">@Localizer["Reactivate"]</button>
                    </div>
                    <div id="inlineFilterHost">
                        <div class="collapse" id="inlineFilterCollapse">
                            <div class="pt-0 pb-3">
                                <form class="m-0" id="filterForm" data-no-tracker>
                                    <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                                        <div class="filter-chip filter-status">
                                            <select id="subscriptionFilterStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["SubscriptionStatus"]">
                                                <option value="PendingProvisioning">@Localizer["SubscriptionStatusPendingProvisioning"]</option>
                                                <option value="Trialing">@Localizer["SubscriptionStatusTrialing"]</option>
                                                <option value="Active">@Localizer["SubscriptionStatusActive"]</option>
                                                <option value="PastDue">@Localizer["SubscriptionStatusPastDue"]</option>
                                                <option value="Cancelled">@Localizer["SubscriptionStatusCancelled"]</option>
                                                <option value="Expired">@Localizer["SubscriptionStatusExpired"]</option>
                                                <option value="Suspended">@Localizer["SubscriptionStatusSuspended"]</option>
                                                <option value="TrialExpired">@Localizer["SubscriptionStatusTrialExpired"]</option>
                                            </select>
                                        </div>
                                        <div class="filter-chip filter-cancel-at-period-end">
                                            <select id="subscriptionFilterCancelAtPeriodEnd" class="form-select form-select-sm select2" data-placeholder="@Localizer["CancelAtPeriodEnd"]">
                                                <option value="">@SharedLocalizer["ShowAll"]</option>
                                                <option value="true">@Localizer["Yes"]</option>
                                                <option value="false">@Localizer["No"]</option>
                                            </select>
                                        </div>
                                        <div class="ms-auto d-flex gap-3">
                                            <button type="button" class="btn btn-sm btn-primary" id="btnSubscriptionFilterApply">
                                                @SharedLocalizer["Apply"]
                                            </button>
                                            <button type="reset" class="btn btn-sm btn-label-danger" id="btnSubscriptionFilterReset">
                                                @SharedLocalizer["Reset"]
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="card-datatable table-responsive">
                        <table id="dtCurrentSubscription" data-dt-standard="v2" class="datatables-subscription table border-top w-100">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>@Localizer["Plan"]</th>
                                    <th>@Localizer["SubscriptionStatus"]</th>
                                    <th>@Localizer["CancelAtPeriodEnd"]</th>
                                    <th>@Localizer["TrialStartDate"]</th>
                                    <th>@Localizer["TrialEndDate"]</th>
                                    <th>@Localizer["CurrentPeriodStart"]</th>
                                    <th>@Localizer["CurrentPeriodEnd"]</th>
                                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>

                <div class="card subscription-history-card">
                    <div class="card-body p-4 d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <h6 class="text-uppercase text-heading fw-semibold mb-1">@Localizer["SubscriptionHistory"]</h6>
                            <p class="text-muted mb-0">@Localizer["SubscriptionHistorySubtitle"]</p>
                        </div>
                        <button type="button" id="btnToggleSubscriptionHistory" class="btn btn-icon btn-label-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#subscriptionHistoryCollapse" aria-expanded="true" aria-controls="subscriptionHistoryCollapse">
                            <i class="icon-base bx bx-chevron-up"></i>
                        </button>
                    </div>
                    <div id="subscriptionHistoryCollapse" class="collapse show">
                        <div class="card-body pt-0 pb-0">
                            <div id="commercialSubscriptionHistoryTimeline" class="ms-1 py-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="tabModuleEntitlements" role="tabpanel">
        <partial name="Commercial/_ModuleEntitlementsTab" />
    </div>
    <div class="tab-pane fade" id="tabTenantQuotaGovernance" role="tabpanel">
        <partial name="Commercial/_TenantQuotaGovernanceTab" />
    </div>
</div>
