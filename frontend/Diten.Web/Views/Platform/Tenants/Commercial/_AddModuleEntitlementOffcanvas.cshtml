@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasModuleEntitlement" aria-labelledby="offcanvasModuleEntitlementLabel" style="width: 480px;">
    <div class="offcanvas-header border-bottom">
        <div>
            <h5 id="offcanvasModuleEntitlementLabel" class="offcanvas-title mb-0">@Localizer["AddModuleEntitlement"]</h5>
            <small class="text-muted">@Localizer["ModuleEntitlementFormDescription"]</small>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>
    <form id="moduleEntitlementForm" class="offcanvas-body" novalidate>
        <input type="hidden" id="moduleEntitlementId">
        <input type="hidden" id="moduleEntitlementRowVersion">
        <div class="mb-3">
            <label class="form-label" for="moduleEntitlementModule">@Localizer["Module"] <span class="text-danger">*</span></label>
            <select id="moduleEntitlementModule" class="form-select" required></select>
            <div class="invalid-feedback">@Localizer["ModuleRequired"]</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="moduleEntitlementSource">@Localizer["Source"] <span class="text-danger">*</span></label>
            <select id="moduleEntitlementSource" class="form-select" required>
                <option value="Addon">@Localizer["SourceAddon"]</option>
                <option value="ManualOverride">@Localizer["SourceManualOverride"]</option>
                <option value="Trial">@Localizer["SourceTrial"]</option>
                <option value="System">@Localizer["SourceSystem"]</option>
            </select>
        </div>
        <div class="mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="moduleEntitlementEnabled" checked>
                <label class="form-check-label" for="moduleEntitlementEnabled">@Localizer["Enabled"] <span class="text-danger">*</span></label>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="moduleEntitlementExpiry">@Localizer["ExpiryDate"]</label>
            <input type="date" class="form-control" id="moduleEntitlementExpiry">
        </div>
        <div class="mb-4">
            <label class="form-label" for="moduleEntitlementReason">@Localizer["Reason"]</label>
            <textarea class="form-control" id="moduleEntitlementReason" rows="3" maxlength="500"></textarea>
            <div class="invalid-feedback">@Localizer["ReasonRequired"]</div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-label-secondary flex-fill" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
            <button type="submit" class="btn btn-primary flex-fill" id="btnSaveModuleEntitlement">
                <i class="icon-base bx bx-save me-1"></i>@SharedLocalizer["Save"]
            </button>
        </div>
    </form>
</div>
