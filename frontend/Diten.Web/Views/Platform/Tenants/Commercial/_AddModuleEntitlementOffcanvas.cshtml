@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasModuleEntitlement" aria-labelledby="offcanvasModuleEntitlementLabel">
    <div class="offcanvas-header p-4">
        <h5 id="offcanvasModuleEntitlementLabel" class="offcanvas-title">@Localizer["AddModuleEntitlement"]</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body border-top p-4">
        @* Server-side validation errors (from gateway) *@
        <div id="moduleEntitlementFormAlert" class="alert alert-danger d-none" role="alert"></div>

        <form id="moduleEntitlementForm" class="pt-0" novalidate>
            <input type="hidden" id="moduleEntitlementId" />
            <input type="hidden" id="moduleEntitlementRowVersion" />

            <div class="row g-4">
                <div class="col-12">
                    <label for="moduleEntitlementModule" class="form-label fw-medium">
                        @Localizer["Module"] <span class="text-danger">*</span>
                    </label>
                    <select id="moduleEntitlementModule" name="Module" class="form-select select2-offcanvas" data-placeholder="@SharedLocalizer["SelectPlaceholder"]" required></select>
                    <div class="invalid-feedback">@Localizer["ModuleRequired"]</div>
                </div>

                <div class="col-12">
                    <label for="moduleEntitlementSource" class="form-label fw-medium">
                        @Localizer["Source"] <span class="text-danger">*</span>
                    </label>
                    <select id="moduleEntitlementSource" name="Source" class="form-select select2-offcanvas" required>
                        <option value="Addon">@Localizer["SourceAddon"]</option>
                        <option value="ManualOverride">@Localizer["SourceManualOverride"]</option>
                        <option value="Trial">@Localizer["SourceTrial"]</option>
                        <option value="System">@Localizer["SourceSystem"]</option>
                    </select>
                </div>

                <div class="col-12">
                    <label for="moduleEntitlementExpiry" class="form-label fw-medium">@Localizer["ExpiryDate"]</label>
                    <input type="text" id="moduleEntitlementExpiry" name="ExpiryDate" class="form-control flatpickr-date" placeholder="YYYY-MM-DD" autocomplete="off" />
                </div>

                <div class="col-12">
                    <label for="moduleEntitlementReason" class="form-label fw-medium">@Localizer["Reason"]</label>
                    <textarea id="moduleEntitlementReason" name="Reason" class="form-control" rows="4" maxlength="500"></textarea>
                    <div class="invalid-feedback">@Localizer["ReasonRequired"]</div>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input type="checkbox" id="moduleEntitlementEnabled" name="Enabled" class="form-check-input" role="switch" checked />
                        <label for="moduleEntitlementEnabled" class="form-check-label ms-2">@Localizer["Enabled"]</label>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">
            @SharedLocalizer["Cancel"]
        </button>
        <button type="button" id="btnSaveModuleEntitlement" class="btn btn-primary">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>
