@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div class="card-body p-4 pb-0">
        <h6 class="text-uppercase text-heading fw-semibold mb-1">@Localizer["ModuleEntitlements"]</h6>
        <p class="text-muted mb-0">@Localizer["ModuleEntitlementsDescription"]</p>
    </div>
    <div id="moduleEntitlementFilterHost" class="dt-filter-host">
        <div class="collapse" id="moduleEntitlementFilterCollapse">
            <div class="pt-0 pb-3 px-3">
                <form class="m-0" id="moduleEntitlementFilterForm" data-no-tracker>
                    <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">
                        <div class="filter-chip filter-source">
                            <select id="moduleEntitlementFilterSource" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Source"]">
                                <option value="Plan">@Localizer["SourcePlan"]</option>
                                <option value="ManualOverride">@Localizer["SourceManualOverride"]</option>
                                <option value="Addon">@Localizer["SourceAddon"]</option>
                                <option value="Trial">@Localizer["SourceTrial"]</option>
                                <option value="System">@Localizer["SourceSystem"]</option>
                            </select>
                        </div>
                        <div class="filter-chip filter-effective-access">
                            <select id="moduleEntitlementFilterAccess" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["EffectiveAccess"]">
                                <option value="Active">@Localizer["AccessActive"]</option>
                                <option value="NoAccess">@Localizer["AccessNoAccess"]</option>
                                <option value="Expired">@Localizer["AccessExpired"]</option>
                                <option value="BlockedByOverride">@Localizer["AccessBlockedByOverride"]</option>
                                <option value="EnabledByOverride">@Localizer["AccessEnabledByOverride"]</option>
                                <option value="SystemLocked">@Localizer["AccessSystemLocked"]</option>
                            </select>
                        </div>
                        <div class="ms-auto d-flex gap-3">
                            <button type="button" class="btn btn-sm btn-primary" id="btnModuleEntitlementFilterApply">
                                @SharedLocalizer["Apply"]
                            </button>
                            <button type="reset" class="btn btn-sm btn-label-danger" id="btnModuleEntitlementFilterReset">
                                @SharedLocalizer["Reset"]
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div id="moduleEntitlementSkeleton" class="px-4 pb-4 pt-2" role="status" aria-busy="true">
        <span class="visually-hidden">@SharedLocalizer["Loading"]</span>
        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>
    <div class="card-datatable table-responsive d-none">
        <table id="dtModuleEntitlements" data-dt-standard="v2" class="datatables-module-entitlements table border-top w-100">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["ModuleCode"]</th>
                    <th>@Localizer["ModuleName"]</th>
                    <th>@Localizer["Source"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th>@Localizer["Enabled"]</th>
                    <th>@Localizer["ExpiryDate"]</th>
                    <th>@Localizer["EffectiveAccess"]</th>
                    <th>@Localizer["Reason"]</th>
                    <th>@Localizer["LastUpdated"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<partial name="Commercial/_AddModuleEntitlementOffcanvas" />
