@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["CreateTenant"].Value;

    Layout = "_LayoutBackbone";
}

<div
    class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 row-gap-4">
    <div class="d-flex flex-column justify-content-center">
        <h5 class="mb-0">@Localizer["CreateTenant"]</h5>
        <nav aria-label="breadcrumb" class="text-muted">
            <ol class="breadcrumb mb-0 py-0">
                <li class="breadcrumb-item position-relative"><a asp-controller="Tenants" asp-action="Index"
                        class="stretched-link">@Localizer["TenantsTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@Localizer["CreateTenant"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-content-center flex-wrap gap-4">
        <a asp-controller="Tenants" asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
        <button type="submit" form="formTenantCreate" class="btn btn-primary">@Localizer["CreateTenant"]</button>
    </div>
</div>

<div class="alert alert-danger d-none" id="formErrorSummary"></div>

<form id="formTenantCreate" novalidate>
    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">@Localizer["RegistryInformation"]</h6>
                </div>
                <div class="card-body row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="tenantName">@Localizer["TenantName"] <span
                                class="text-danger">*</span></label>
                        <input type="text" id="tenantName" name="name" class="form-control" required maxlength="120"
                            placeholder="Acme Global" />
                        <div class="invalid-feedback" data-valmsg-for="Name"></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="tenantSlug">@Localizer["Slug"]</label>
                        <input type="text" id="tenantSlug" name="slug" class="form-control" maxlength="80"
                            placeholder="acme-global" />
                        <div class="invalid-feedback" data-valmsg-for="Slug"></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="tenantDomain">@Localizer["InputDomain"] <span
                                class="text-danger">*</span></label>
                        <input type="text" id="tenantDomain" name="domain" class="form-control" required maxlength="255"
                            placeholder="acme.com" />
                        <div class="invalid-feedback" data-valmsg-for="Domain"></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="tenantDisplayName">@Localizer["DisplayName"]</label>
                        <input type="text" id="tenantDisplayName" name="displayName" class="form-control"
                            maxlength="200" placeholder="Acme Global HQ" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="tenantType">@Localizer["TenantType"]</label>
                        <select id="tenantType" name="tenantType" class="form-select">
                            <option value="">@Localizer["UseDefaultTrial"]</option>
                            <option value="1">@Localizer["TenantTypeInternal"]</option>
                            <option value="2">@Localizer["TenantTypeTrial"]</option>
                            <option value="3">@Localizer["TenantTypePaid"]</option>
                            <option value="4">@Localizer["TenantTypePartner"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="tenantIndustry">@Localizer["Industry"]</label>
                        <input type="text" id="tenantIndustry" name="industry" class="form-control" maxlength="100"
                            placeholder="Software" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">@Localizer["LegalAndContact"]</h6>
                </div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label class="form-label" for="tenantLegalName">@Localizer["LegalName"]</label>
                        <input type="text" id="tenantLegalName" name="legalName" class="form-control" maxlength="200"
                            placeholder="Acme Global Technologies Ltd." />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="tenantTaxNumber">@Localizer["TaxNumber"]</label>
                        <input type="text" id="tenantTaxNumber" name="taxNumber" class="form-control numeric-only"
                            maxlength="50" placeholder="1234567890" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="tenantCountry">@Localizer["Country"]</label>
                        <select id="tenantCountry" name="country" class="form-select">
                            <option value="">— Ülke seçin —</option>
                        </select>
                        <div class="invalid-feedback" data-valmsg-for="Country"></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="contactPerson">@Localizer["ContactPerson"]</label>
                        <input type="text" id="contactPerson" name="contactPerson" class="form-control" maxlength="120"
                            placeholder="Ahmet Yilmaz" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="contactEmail">@Localizer["ContactEmail"]</label>
                        <input type="email" id="contactEmail" name="contactEmail" class="form-control" maxlength="255"
                            placeholder="ahmet@acme.com" />
                        <div class="invalid-feedback" data-valmsg-for="ContactEmail"></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="contactPhone">@Localizer["ContactPhone"]</label>
                        <input type="tel" id="contactPhone" name="contactPhone" class="form-control phone-mask"
                            maxlength="30" placeholder="+905551112233" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">@Localizer["LocaleDefaults"]</h6>
                </div>
                <div class="card-body row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="defaultTimezone">@Localizer["DefaultTimezone"]</label>
                        <select id="defaultTimezone" name="defaultTimezone" class="form-select">
                            <option value="">— Saat dilimi seçin —</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="defaultLanguage">@Localizer["DefaultLanguage"]</label>
                        <select id="defaultLanguage" name="defaultLanguage" class="form-select">
                            <option value="">@Localizer["UseDefault"]</option>
                            <option value="en">English</option>
                            <option value="fr">Français</option>
                            <option value="es">Español</option>
                            <option value="zh">中文</option>
                            <option value="ar">العربية</option>
                            <option value="ru">Русский</option>
                            <option value="tr">Türkçe</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="defaultCurrency">@Localizer["DefaultCurrency"]</label>
                        <select id="defaultCurrency" name="defaultCurrency" class="form-select">
                            <option value="">— Para birimi seçin —</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">@Localizer["InitialAdmin"]</h6>
                </div>
                <div class="card-body row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="adminFirstName">@Localizer["FirstName"]</label>
                        <input type="text" id="adminFirstName" name="initialAdmin.firstName" class="form-control"
                            maxlength="80" placeholder="Ahmet" />
                        <div class="invalid-feedback" data-valmsg-for="InitialAdmin.FirstName"></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="adminLastName">@Localizer["LastName"]</label>
                        <input type="text" id="adminLastName" name="initialAdmin.lastName" class="form-control"
                            maxlength="80" placeholder="Yilmaz" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="adminEmail">@Localizer["AdminEmail"]</label>
                        <input type="email" id="adminEmail" name="initialAdmin.email" class="form-control"
                            maxlength="255" placeholder="admin@acme.com" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="adminPhone">@Localizer["AdminPhone"]</label>
                        <input type="tel" id="adminPhone" name="initialAdmin.phone" class="form-control phone-mask"
                            maxlength="30" placeholder="+905551112233" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="mfaRequired"
                                name="initialAdmin.mfaRequired" checked>
                            <label class="form-check-label" for="mfaRequired">@Localizer["MfaRequired"]</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="emailVerificationRequired"
                                name="initialAdmin.emailVerificationRequired" checked>
                            <label class="form-check-label"
                                for="emailVerificationRequired">@Localizer["EmailVerificationRequired"]</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="sendInvitationEmail"
                                name="initialAdmin.sendInvitationEmail" checked>
                            <label class="form-check-label"
                                for="sendInvitationEmail">@Localizer["SendInvitationEmail"]</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/Tenants/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/Tenants/create.js" asp-append-version="true"></script>
}
