@{
    ViewData["Title"] = "Tenant Registry";
    ViewData["PlatformTenantNav"] = "tenant-management";
    Layout = "_LayoutTenantConsole";
}

<div class="row g-4 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <span class="badge bg-label-primary mb-2">Registry</span>
                <h5 class="mb-1">Tenant Registry</h5>
                <p class="text-muted mb-0">Platform seviyesinde tenant kimliği ve yaşam döngüsü yönetimi.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-8">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-lg-3">
                        <small class="text-muted d-block">Total Tenants</small>
                        <h5 id="kpi-total" class="mb-0">0</h5>
                    </div>
                    <div class="col-6 col-lg-3">
                        <small class="text-muted d-block">Active</small>
                        <h5 id="kpi-active" class="mb-0 text-success">0</h5>
                    </div>
                    <div class="col-6 col-lg-3">
                        <small class="text-muted d-block">Provisioning</small>
                        <h5 id="kpi-provisioning" class="mb-0 text-info">0</h5>
                    </div>
                    <div class="col-6 col-lg-3">
                        <small class="text-muted d-block">Suspended</small>
                        <h5 id="kpi-suspended" class="mb-0 text-warning">0</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div id="skeleton-loader" class="p-4" style="display:none;">
        <div class="shimmer skeleton-row" style="width: 100%; height: 32px; margin-bottom: 2rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px; margin-bottom: 1rem;"></div>
        <div class="shimmer skeleton-row" style="width: 100%; height: 24px;"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-tenants" data-dt-standard="v2" class="datatables-tenants table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th class="cell-fit"><input type="checkbox" class="dt-checkboxes-select-all form-check-input"></th>
                    <th>Tenant Identity</th>
                    <th>Code / Slug</th>
                    <th>Display Name</th>
                    <th>Status</th>
                    <th>Region</th>
                    <th>Environment</th>
                    <th>Creation Metadata</th>
                    <th class="cell-fit text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasTenantDetails" aria-labelledby="offcanvasTenantDetailsLabel" style="width: 520px;">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center">
            <div class="avatar avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                <i class="bx bx-buildings fs-4"></i>
            </div>
            <div>
                <h5 id="oc-tenant-title" class="offcanvas-title mb-0">-</h5>
                <small id="oc-tenant-subtitle" class="text-muted">Tenant Registry</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body p-0">
        <div class="p-4">
            <div class="bg-label-secondary rounded p-3 mb-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="d-block text-muted small fw-medium mb-1">Status</span>
                    <span id="oc-tenant-status" class="badge bg-label-secondary">-</span>
                </div>
                <div class="text-end">
                    <span class="d-block text-muted small fw-medium mb-1">Environment</span>
                    <span id="oc-tenant-environment" class="badge bg-label-dark">-</span>
                </div>
            </div>

            <h6 class="text-uppercase text-muted fw-bold mb-3">Registry Snapshot</h6>
            <dl class="row mb-4">
                <dt class="col-5 fw-medium text-heading mb-2">Tenant Id</dt>
                <dd id="oc-tenant-id" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2">Code</dt>
                <dd id="oc-tenant-code" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2">Slug</dt>
                <dd id="oc-tenant-slug" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2">Display Name</dt>
                <dd id="oc-tenant-display-name" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2">Domain</dt>
                <dd id="oc-tenant-domain" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2">Region</dt>
                <dd id="oc-tenant-region" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2">Tier</dt>
                <dd id="oc-tenant-tier" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2">Created</dt>
                <dd id="oc-tenant-created" class="col-7 mb-2">-</dd>
                <dt class="col-5 fw-medium text-heading mb-2">Created By</dt>
                <dd id="oc-tenant-created-by" class="col-7 mb-2">-</dd>
            </dl>
        </div>
    </div>

    <div class="offcanvas-footer border-top p-4 d-flex justify-content-between">
        <button type="button" class="btn btn-label-secondary w-50 me-2" data-bs-dismiss="offcanvas">Close</button>
        <button type="button" class="btn btn-primary w-50" disabled>Edit (Phase 2)</button>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddTenant" aria-labelledby="offcanvasAddTenantLabel" style="width: 520px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">Register New Tenant</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form id="formAddTenant" class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Tenant Name</label>
                <input type="text" name="name" id="tenantName" class="form-control" placeholder="Acme Corporation" required />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Subdomain (Optional)</label>
                <input type="text" name="subdomain" id="tenantSubdomain" class="form-control" placeholder="acme" />
            </div>
            <div class="col-12">
                <label class="form-label">Display Name (Optional)</label>
                <input type="text" name="displayName" class="form-control" placeholder="Acme Corporation" />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Primary Domain</label>
                <input type="text" name="domain" class="form-control" placeholder="acme.diten.tech" required />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Tier</label>
                <select name="tier" class="form-select">
                    <option value="Standard">Standard</option>
                    <option value="Enterprise">Enterprise</option>
                    <option value="Premium">Premium</option>
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Region</label>
                <select name="region" class="form-select">
                    <option value="US">US</option>
                    <option value="EU">EU</option>
                    <option value="APAC">APAC</option>
                    <option value="SA">SA</option>
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Environment</label>
                <select name="environment" class="form-select">
                    <option value="Production">Production</option>
                    <option value="Staging">Staging</option>
                    <option value="Development">Development</option>
                </select>
            </div>
            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-primary w-100">Create Tenant Registry Record</button>
                <button type="button" class="btn btn-label-secondary w-100 mt-2" data-bs-dismiss="offcanvas">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/Platform/Tenants/index.js" asp-append-version="true"></script>
}
