@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["TenantsTitle"].Value;
    Layout = "_LayoutPlatformAdmin";
}

<partial name="_Filter" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["TenantsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-5 g-4 mb-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-primary"><i class="bx bx-buildings"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["TotalTenants"]</small>
                    <h5 id="kpi-total" class="mb-0">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-success"><i class="bx bx-check-circle"></i></span></div>
                <div>
                    <small class="text-muted">@SharedLocalizer["Active"]</small>
                    <h5 id="kpi-active" class="mb-0">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-info"><i class="bx bx-time-five"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["TenantTypeTrial"]</small>
                    <h5 id="kpi-trial" class="mb-0">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-warning"><i class="bx bx-pause-circle"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["StatusSuspended"]</small>
                    <h5 id="kpi-suspended" class="mb-0">0</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="avatar"><span class="avatar-initial rounded bg-label-danger"><i class="bx bx-error-circle"></i></span></div>
                <div>
                    <small class="text-muted">@Localizer["OverQuota"]</small>
                    <h5 id="kpi-over-quota" class="mb-0">0</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Platform/Tenants/_DataTable.cshtml" />

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/Tenants/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/Tenants/index.js" asp-append-version="true"></script>
}
