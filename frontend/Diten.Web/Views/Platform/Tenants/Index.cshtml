@using Diten.Web.Views.Platform.Tenants
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TenantsIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["TenantsTitle"].Value;
    Layout = "_LayoutPlatformAdmin";
}

<partial name="_Filter" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["TenantsTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-5 g-4 mb-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["TotalTenants"]</small>
                <h5 id="kpi-total" class="mb-0">0</h5>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@SharedLocalizer["Active"]</small>
                <h5 id="kpi-active" class="mb-0 text-success">0</h5>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["TenantTypeTrial"]</small>
                <h5 id="kpi-trial" class="mb-0 text-info">0</h5>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["StatusSuspended"]</small>
                <h5 id="kpi-suspended" class="mb-0 text-warning">0</h5>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted d-block">@Localizer["OverQuota"]</small>
                <h5 id="kpi-over-quota" class="mb-0 text-danger">0</h5>
            </div>
        </div>
    </div>
</div>

<div id="bulkActionBar" class="card mb-4 d-none">
    <div class="card-body d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bx bx-check-circle text-primary icon-md"></i>
            <span id="bulkSelectedCount" class="fw-medium text-heading">0</span>
            <span class="text-muted" id="bulkSelectedLabel">@SharedLocalizer["SelectedCount"]</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-label-danger" data-bulk-action="delete">
                @SharedLocalizer["BulkDelete"]
            </button>
            <button type="button" id="btnClearSelection" class="btn btn-label-secondary">
                @SharedLocalizer["ClearSelection"]
            </button>
        </div>
    </div>
</div>

<partial name="~/Views/Platform/Tenants/_DataTable.cshtml" />

@section Scripts {
    <partial name="_IndexL10n" />
    <script src="~/assets/js/Platform/Tenants/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/Tenants/index.js" asp-append-version="true"></script>
}
