@using Diten.Web.Views.Platform.PayrollSources
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PayrollSourcesIndex> Localizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-platform-payroll-sources" data-dt-standard="v2" class="datatables-platform-payroll-sources table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["DisplayName"]</th>
                    <th>@Localizer["ProviderFamily"]</th>
                    <th>@Localizer["LifecycleState"]</th>
                    <th>@Localizer["SupportOwner"]</th>
                    <th>@Localizer["ContractVersion"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
