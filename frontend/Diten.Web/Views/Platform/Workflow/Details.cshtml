@using Diten.Web.Views.Platform.Workflow
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WorkflowIndex> Localizer
@{
    ViewData["Title"] = Localizer["TabDefinitions"].Value;
    var definitionId = ViewData["DefinitionId"]?.ToString() ?? string.Empty;
    // Tenant-scoped screen — render under the tenant shell (see Index.cshtml note).
    Layout = "_LayoutTenantShell";
}

@* MOD-0023 Batch 08 — Workflow definition detail. Metadata + Versions / Instances / SLA tabs.
   Version DefinitionJson is read-only (immutable published artifacts). *@

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="mb-0"><span id="wf-meta-code">—</span></h4>
        <p class="mb-0 text-muted"><span id="wf-meta-name"></span></p>
    </div>
    <a href="/Platform/Workflow" class="btn btn-label-secondary btn-sm"><i class="icon-base bx bx-arrow-back me-1"></i>@Localizer["BackToList"]</a>
</div>

<div class="card mb-4">
    <div class="card-header"><h6 class="mb-0">@Localizer["Metadata"]</h6></div>
    <div class="card-body" id="wf-meta"><div class="alert alert-info mb-0">@Localizer["Loading"]</div></div>
</div>

<div class="nav-align-top">
    <ul class="nav nav-pills nav-fill mb-4 flex-column flex-sm-row" role="tablist">
        <li class="nav-item mb-1 mb-sm-0" role="presentation">
            <button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#wf-pane-versions" data-wf-tab="versions" role="tab">
                <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-history icon-sm me-1_5"></i>@Localizer["TabVersions"]</span>
                <i class="icon-base bx bx-history icon-sm d-sm-none"></i>
            </button>
        </li>
        <li class="nav-item mb-1 mb-sm-0" role="presentation">
            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#wf-pane-instances" data-wf-tab="instances" role="tab">
                <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-play-circle icon-sm me-1_5"></i>@Localizer["TabInstances"]</span>
                <i class="icon-base bx bx-play-circle icon-sm d-sm-none"></i>
            </button>
        </li>
        <li class="nav-item mb-1 mb-sm-0" role="presentation">
            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#wf-pane-sla" data-wf-tab="sla" role="tab">
                <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-time-five icon-sm me-1_5"></i>@Localizer["TabSlaRules"]</span>
                <i class="icon-base bx bx-time-five icon-sm d-sm-none"></i>
            </button>
        </li>
        <li class="nav-item mb-1 mb-sm-0" role="presentation">
            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#wf-pane-designer" data-wf-tab="designer" role="tab">
                <span class="d-none d-sm-inline-flex align-items-center"><i class="icon-base bx bx-edit icon-sm me-1_5"></i>@Localizer["Designer"]</span>
                <i class="icon-base bx bx-edit icon-sm d-sm-none"></i>
            </button>
        </li>
    </ul>
    <div class="tab-content">
        @* Versions *@
        <div class="tab-pane fade show active" id="wf-pane-versions" role="tabpanel">
            <div class="d-flex justify-content-end mb-3"><button type="button" id="wf-ver-refresh" class="btn btn-label-secondary btn-sm"><i class="icon-base bx bx-refresh me-1"></i>@Localizer["Refresh"]</button></div>
            <div id="wf-ver-loading" class="alert alert-info">@Localizer["Loading"]</div>
            <div id="wf-ver-error" class="alert alert-danger d-none">@Localizer["ErrorState"]</div>
            <div id="wf-ver-empty" class="alert alert-warning d-none">@Localizer["EmptyState"]</div>
            <div id="wf-ver-table" class="card d-none">
                <div class="table-responsive"><table class="table table-hover mb-0">
                    <thead><tr><th>@Localizer["VersionNumber"]</th><th>@Localizer["Status"]</th><th class="text-center">@Localizer["Immutable"]</th><th>@Localizer["PublishedAt"]</th><th>@Localizer["PublishedBy"]</th><th class="text-end">@Localizer["Actions"]</th></tr></thead>
                    <tbody id="wf-ver-rows"></tbody>
                </table></div>
            </div>
        </div>
        @* Instances *@
        <div class="tab-pane fade" id="wf-pane-instances" role="tabpanel">
            <div class="d-flex justify-content-end mb-3"><button type="button" id="wf-inst-refresh" class="btn btn-label-secondary btn-sm"><i class="icon-base bx bx-refresh me-1"></i>@Localizer["Refresh"]</button></div>
            <div id="wf-inst-loading" class="alert alert-info">@Localizer["Loading"]</div>
            <div id="wf-inst-error" class="alert alert-danger d-none">@Localizer["ErrorState"]</div>
            <div id="wf-inst-empty" class="alert alert-warning d-none">@Localizer["EmptyState"]</div>
            <div id="wf-inst-table" class="card d-none">
                <div class="table-responsive"><table class="table table-hover mb-0">
                    <thead><tr><th>@Localizer["InstanceId"]</th><th>@Localizer["ObjectRef"]</th><th>@Localizer["Status"]</th><th>@Localizer["StageStep"]</th><th>@Localizer["StartedAt"]</th><th>@Localizer["DueAt"]</th><th>@Localizer["CompletedAt"]</th></tr></thead>
                    <tbody id="wf-inst-rows"></tbody>
                </table></div>
            </div>
        </div>
        @* SLA *@
        <div class="tab-pane fade" id="wf-pane-sla" role="tabpanel">
            <div class="d-flex justify-content-end mb-3"><button type="button" id="wf-sla-refresh" class="btn btn-label-secondary btn-sm"><i class="icon-base bx bx-refresh me-1"></i>@Localizer["Refresh"]</button></div>
            <div id="wf-sla-loading" class="alert alert-info">@Localizer["Loading"]</div>
            <div id="wf-sla-error" class="alert alert-danger d-none">@Localizer["ErrorState"]</div>
            <div id="wf-sla-empty" class="alert alert-warning d-none">@Localizer["EmptyState"]</div>
            <div id="wf-sla-table" class="card d-none">
                <div class="table-responsive"><table class="table table-hover mb-0">
                    <thead><tr><th>@Localizer["StageStep"]</th><th class="text-center">@Localizer["DueInMinutes"]</th><th class="text-center">@Localizer["EscalateAfterMinutes"]</th><th class="text-center">@Localizer["TimeoutAfterMinutes"]</th><th>@Localizer["EscalationPrincipalIds"]</th><th>@Localizer["IsActive"]</th></tr></thead>
                    <tbody id="wf-sla-rows"></tbody>
                </table></div>
            </div>
        </div>
        @* Designer Lite / Step Builder — authors a stable DefinitionJson without BPMN/drag-drop. *@
        <div class="tab-pane fade" id="wf-pane-designer" role="tabpanel">
            <div class="mb-3">
                <h6 class="mb-1">@Localizer["DesignerLite"]</h6>
                <p class="mb-0 text-muted small">@Localizer["DesignerIntro"]</p>
            </div>
            <div id="wf-dz-error" class="alert alert-danger d-none"></div>
            <div class="row g-4">
                <div class="col-lg-6">
                    <form id="wf-dz-form" class="row g-3" novalidate>
                        <div class="col-12"><h6 class="mb-0 text-muted text-uppercase small">@Localizer["WorkflowMetadata"]</h6></div>
                        <div class="col-md-6"><label class="form-label" for="wf-dz-schema">@Localizer["SchemaVersion"]</label><input id="wf-dz-schema" class="form-control" value="workflow_schema_v1" /></div>
                        <div class="col-md-6"><label class="form-label" for="wf-dz-expression">@Localizer["ExpressionVersion"]</label><input id="wf-dz-expression" class="form-control" value="workflow_expr_v1" /></div>

                        <div class="col-12 mt-3"><h6 class="mb-0 text-muted text-uppercase small">@Localizer["StageStep"]</h6></div>
                        <div class="col-md-6"><label class="form-label" for="wf-dz-stagecode">@Localizer["StageCode"] <span class="text-danger">*</span></label><input id="wf-dz-stagecode" class="form-control" value="stage-1" /></div>
                        <div class="col-md-6"><label class="form-label" for="wf-dz-stagename">@Localizer["StageName"] <span class="text-danger">*</span></label><input id="wf-dz-stagename" class="form-control" value="Initial Approval" /></div>
                        <div class="col-md-4"><label class="form-label" for="wf-dz-stepcode">@Localizer["StepCode"] <span class="text-danger">*</span></label><input id="wf-dz-stepcode" class="form-control" value="step-1" /></div>
                        <div class="col-md-5"><label class="form-label" for="wf-dz-stepname">@Localizer["StepName"] <span class="text-danger">*</span></label><input id="wf-dz-stepname" class="form-control" placeholder="Manager Approval" /></div>
                        <div class="col-md-3"><label class="form-label" for="wf-dz-steptype">@Localizer["StepType"]</label><select id="wf-dz-steptype" class="form-select"><option value="approval" selected>approval</option></select></div>

                        <div class="col-12 mt-3"><h6 class="mb-0 text-muted text-uppercase small">@Localizer["Assignment"]</h6></div>
                        <div class="col-md-5"><label class="form-label" for="wf-dz-approvalmode">@Localizer["ApprovalMode"]</label><select id="wf-dz-approvalmode" class="form-select"><option value="candidate_principals" selected>candidate_principals</option></select></div>
                        <div class="col-md-7"><label class="form-label" for="wf-dz-candidates">@Localizer["CandidatePrincipalIds"] <span class="text-danger">*</span></label><input id="wf-dz-candidates" class="form-control" placeholder="manager-1, manager-2" /><div class="form-text">@Localizer["CandidatePrincipalIdsHint"]</div></div>

                        <div class="col-12 mt-3"><h6 class="mb-0 text-muted text-uppercase small">@Localizer["Requirements"]</h6></div>
                        <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" id="wf-dz-commentrequired" /><label class="form-check-label" for="wf-dz-commentrequired">@Localizer["CommentRequired"]</label></div></div>
                        <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" id="wf-dz-evidencerequired" /><label class="form-check-label" for="wf-dz-evidencerequired">@Localizer["EvidenceRequired"]</label></div></div>

                        <div class="col-12 mt-3"><h6 class="mb-0 text-muted text-uppercase small">@Localizer["SlaSettings"]</h6></div>
                        <div class="col-md-4"><label class="form-label" for="wf-dz-due">@Localizer["DueInMinutes"]</label><input id="wf-dz-due" type="number" min="1" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label" for="wf-dz-escalate">@Localizer["EscalateAfterMinutes"]</label><input id="wf-dz-escalate" type="number" min="1" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label" for="wf-dz-timeout">@Localizer["TimeoutAfterMinutes"]</label><input id="wf-dz-timeout" type="number" min="1" class="form-control" /></div>
                        <div class="col-12"><label class="form-label" for="wf-dz-escprincipals">@Localizer["EscalationPrincipalIds"]</label><input id="wf-dz-escprincipals" class="form-control" placeholder="platform-admin-1" /></div>

                        <div class="col-12 mt-3"><h6 class="mb-0 text-muted text-uppercase small">@Localizer["AdvancedOptions"]</h6></div>
                        <div class="col-md-6"><label class="form-label" for="wf-dz-objecttype">@Localizer["RequestedObjectType"]</label><input id="wf-dz-objecttype" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label" for="wf-dz-description">@Localizer["Description"]</label><input id="wf-dz-description" class="form-control" /></div>
                    </form>
                </div>
                <div class="col-lg-6">
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" id="wf-dz-generate" class="btn btn-primary btn-sm"><i class="icon-base bx bx-cog me-1"></i>@Localizer["GenerateDefinitionJson"]</button>
                        <button type="button" id="wf-dz-copy" class="btn btn-label-secondary btn-sm"><i class="icon-base bx bx-copy me-1"></i>@Localizer["CopyJson"]</button>
                        <button type="button" id="wf-dz-usepublish" class="btn btn-label-primary btn-sm"><i class="icon-base bx bx-cloud-upload me-1"></i>@Localizer["UseInPublish"]</button>
                        <button type="button" id="wf-dz-reset" class="btn btn-label-secondary btn-sm"><i class="icon-base bx bx-reset me-1"></i>@Localizer["ResetDesigner"]</button>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="wf-dz-manual" />
                        <label class="form-check-label" for="wf-dz-manual">@Localizer["ManualJsonEdit"]</label>
                        <div class="form-text">@Localizer["ManualJsonHint"]</div>
                    </div>
                    <label class="form-label" for="wf-dz-preview">@Localizer["DefinitionJsonPreview"]</label>
                    <textarea id="wf-dz-preview" class="form-control font-monospace" rows="20" spellcheck="false" readonly></textarea>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="wf-ver-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">@Localizer["ViewDefinitionJson"]</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button></div>
        <div class="modal-body">
            <div id="wf-ver-meta" class="mb-2 small"></div>
            <pre class="border rounded bg-lighter p-3 mb-0" style="max-height:60vh;overflow:auto;"><code id="wf-ver-json"></code></pre>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button></div>
    </div></div>
</div>

@* Publish modal — fed by the Designer ("Use in Publish") or used directly. Reuses POST /publish. *@
<div class="modal fade" id="wf-publish-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">@Localizer["PublishDefinition"] <span id="wf-publish-title-code" class="text-muted"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button></div>
        <div class="modal-body">
            <input type="hidden" id="wf-publish-definitionid" />
            <div id="wf-publish-error" class="alert alert-danger d-none"></div>
            <div id="wf-publish-result" class="d-none mb-3"></div>
            <form id="wf-publish-form" class="row g-3" novalidate>
                <div class="col-12"><label class="form-label" for="wf-publish-json">@Localizer["DefinitionJson"] <span class="text-danger">*</span></label><textarea id="wf-publish-json" class="form-control font-monospace" rows="8" spellcheck="false" placeholder='{ "stages": [] }'></textarea></div>
                <div class="col-md-4"><label class="form-label" for="wf-publish-schema">@Localizer["SchemaVersion"] <span class="text-danger">*</span></label><input id="wf-publish-schema" class="form-control" placeholder="1.0" /></div>
                <div class="col-md-4"><label class="form-label" for="wf-publish-expression">@Localizer["ExpressionVersion"] <span class="text-danger">*</span></label><input id="wf-publish-expression" class="form-control" placeholder="1.0" /></div>
                <div class="col-md-4"><label class="form-label" for="wf-publish-expected">@Localizer["ExpectedTemplateVersion"]</label><input id="wf-publish-expected" type="number" min="0" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label" for="wf-publish-rowversion">@Localizer["ExpectedRowVersion"]</label><input id="wf-publish-rowversion" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label" for="wf-publish-reason">@Localizer["PublishReason"]</label><input id="wf-publish-reason" class="form-control" /></div>
            </form>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button><button type="button" id="wf-publish-submit" class="btn btn-primary">@Localizer["Publish"]</button></div>
    </div></div>
</div>

@section Scripts {
    <partial name="_WorkflowL10n" />
    <script>window.WorkflowDefinitionId = '@Html.Raw(definitionId)';</script>
    <script src="~/assets/js/Platform/Workflow/workflow.api.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/Workflow/details.js" asp-append-version="true"></script>
}
