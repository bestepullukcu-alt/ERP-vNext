@using Diten.Web.Views.Platform.Workflow
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WorkflowIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end backbone-preview-offcanvas" tabindex="-1" id="wf-details-offcanvas"
     aria-labelledby="wf-details-offcanvas-label">
    <div class="offcanvas-header p-4">
        <div class="d-flex align-items-center min-w-0">
            <div class="backbone-preview-avatar d-flex align-items-center justify-content-center me-3 flex-shrink-0">
                <i class="bx bx-git-branch fs-4"></i>
            </div>
            <div class="min-w-0">
                <h5 id="wf-details-title" class="offcanvas-title mb-0 text-truncate">-</h5>
                <small id="wf-details-subtitle" class="text-muted d-block text-truncate">-</small>
            </div>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"
                aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body flex-grow-1 p-4 border-top">
        <div id="wf-details-loading" class="alert alert-info mb-0">@Localizer["Loading"]</div>
        <div id="wf-details-error" class="alert alert-danger d-none mb-0" role="alert"></div>

        <div id="wf-details-content" class="d-none">
            <section class="card backbone-preview-section p-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-3 backbone-preview-section-title">@Localizer["Metadata"]</h6>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-code-alt"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["TemplateCode"]</div>
                                <div id="wf-details-code" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-file"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["Name"]</div>
                                <div id="wf-details-name" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-check-shield"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@SharedLocalizer["Status"]</div>
                                <div class="mt-1"><span id="wf-details-status" class="badge bg-label-secondary">-</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-cloud-upload"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["ActivePublishedVersionId"]</div>
                                <div id="wf-details-active-version" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-history"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["CurrentVersionId"]</div>
                                <div id="wf-details-current-version" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="backbone-preview-field">
                            <i class="bx bx-calendar"></i>
                            <div class="min-w-0 flex-grow-1">
                                <div class="backbone-preview-label">@Localizer["CreatedAt"]</div>
                                <div id="wf-details-created-at" class="backbone-preview-value mt-1">-</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card backbone-preview-section p-4 mt-4">
                <h6 class="text-uppercase text-heading fw-semibold mb-3 backbone-preview-section-title">@Localizer["Description"]</h6>
                <div id="wf-details-description" class="backbone-preview-description">-</div>
            </section>
        </div>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-end gap-2 bg-white">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">@SharedLocalizer["Cancel"]</button>
    </div>
</div>
