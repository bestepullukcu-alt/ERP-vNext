@using Diten.Web.Views.Platform.Account
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<AccountIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["SettingsTitle"].Value;
    Layout = "_LayoutPlatformAdmin";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@Localizer["SettingsTitle"]</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/Platform/Account/Profile">@Localizer["ProfileTitle"]</a>
                </li>
                <li class="breadcrumb-item active text-primary">@Localizer["SettingsTitle"]</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/Platform/Account/Profile" class="btn btn-label-secondary">
            @SharedLocalizer["Cancel"]
        </a>
        <button type="submit" form="platform-account-settings-form" class="btn btn-primary" id="account-save-button">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>

<div class="card" data-platform-account-page="settings">
    <div class="card-header">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h5 class="card-title mb-1">@Localizer["AccountTitle"]</h5>
                <p class="mb-0 text-muted">@Localizer["AccountDescription"]</p>
            </div>
            <div class="avatar">
                <span class="avatar-initial rounded-circle bg-label-primary fw-semibold" data-account-avatar-lg>--</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <form id="platform-account-settings-form" class="needs-validation" novalidate>
            <input type="hidden" id="account-version" name="version" value="0" />
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <label class="form-label fw-medium" for="account-display-name">@Localizer["DisplayName"] <span class="text-danger">*</span></label>
                    <input class="form-control" id="account-display-name" name="displayName" type="text" required minlength="2" maxlength="200" autocomplete="name" />
                </div>
                <div class="col-12 col-lg-6">
                    <label class="form-label fw-medium" for="account-email">@Localizer["Email"]</label>
                    <input class="form-control" id="account-email" type="email" disabled />
                </div>
                <div class="col-12 col-lg-6">
                    <label class="form-label fw-medium" for="account-username">@Localizer["UserName"]</label>
                    <input class="form-control" id="account-username" type="text" disabled />
                </div>
                <div class="col-12 col-lg-6">
                    <label class="form-label fw-medium" for="account-status">@Localizer["Status"]</label>
                    <input class="form-control" id="account-status" type="text" disabled />
                </div>
                <div class="col-12 col-lg-6">
                    <label class="form-label fw-medium" for="account-actor-type">@Localizer["ActorType"]</label>
                    <input class="form-control" id="account-actor-type" type="text" disabled />
                </div>
                <div class="col-12 col-lg-6">
                    <label class="form-label fw-medium" for="account-roles">@Localizer["Roles"]</label>
                    <input class="form-control" id="account-roles" type="text" disabled />
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Platform/Account/_AccountL10n.cshtml" />
    <script src="~/assets/js/Platform/Account/account.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Platform/Account/settings.js" asp-append-version="true"></script>
}
