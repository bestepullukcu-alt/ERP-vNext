        OpenEnded = Localizer["OpenEnded"].Value,
        AssignmentTarget = Localizer["AssignmentTarget"].Value,
        AssignmentPerson = Localizer["AssignmentPerson"].Value,
        AssignmentPool = Localizer["AssignmentPool"].Value,
