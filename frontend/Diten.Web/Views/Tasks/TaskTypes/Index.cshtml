@using Diten.Web.Views.Tasks.TaskTypes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TaskTypesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["TaskTypesTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* ① Inline Filter partial *@
@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/Tasks/TaskTypes/_Filter.cshtml" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["TaskTypesTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* ⚠ NO BULK ACTION BAR — a task type is retired, never deleted, so there is nothing to select rows for.
   The sibling's bar was removed rather than left pointing at a route that does not exist. *@

@* ③ DataTable Card *@
@* Contract markers are rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-tasktypes" data-dt-standard="v2"> *@
<partial name="~/Views/Tasks/TaskTypes/_DataTable.cshtml" />


@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/Tasks/TaskTypes/_IndexL10n.cshtml" />
    <script src="~/assets/js/Tasks/TaskTypes/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Tasks/TaskTypes/index.js" asp-append-version="true"></script>
}
