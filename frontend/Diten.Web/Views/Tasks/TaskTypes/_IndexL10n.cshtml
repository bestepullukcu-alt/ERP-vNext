@using Diten.Web.Views.Tasks.TaskTypes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TaskTypesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<script id="tasktypes-l10n" type="application/json">
