@model Diten.Web.Models.TaskTypes.TaskTypeEditViewModel
@using Diten.Web.Views.Tasks.TaskTypes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TaskTypesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@* ⚠ THE SYSTEM OUTCOME LABELS COME FROM THE WORKCENTERNEXT RESX, NOT THIS ONE.
   `WorkAggregation_ClosureOutcome_*` already exists there in all seven languages — the projection emits those
   keys and the Task Center resolves them. Copying the five entries into TaskTypesIndex would put the SAME
   sentence in two files, and the day one is corrected the two screens would disagree about what an outcome is
   called. So the second localizer is injected instead. *@
@inject IHtmlLocalizer<Diten.Web.Views.WorkCenterNext.WorkCenterNextIndex> OutcomeLocalizer
@{
    ViewData["Title"] = Model.Name;
    Layout = "_LayoutTenantShell";
}

@* The golden compact detail pattern: breadcrumb, Back/Edit, one preview field per fact. *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@Model.Name</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="TaskTypes" asp-action="Index">@Localizer["TaskTypesTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@Model.Code</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="TaskTypes" asp-action="Index" class="btn btn-label-secondary">@SharedLocalizer["Back"]</a>
        <a asp-controller="TaskTypes" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@SharedLocalizer["Edit"]</a>
    </div>
</div>

<section class="card">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-12 col-md-6 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-hash"></i> @Localizer["Code"]</span>
                <span class="backbone-preview-value">@Model.Code</span>
            </div>
            <div class="col-12 col-md-6 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-label"></i> @Localizer["Name"]</span>
                <span class="backbone-preview-value">@Model.Name</span>
            </div>
            <div class="col-12 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-text"></i> @Localizer["Description"]</span>
                <span class="backbone-preview-value">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</span>
            </div>
            <div class="col-12 col-md-6 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-shield-quarter"></i> @Localizer["RecordClass"]</span>
                <span class="backbone-preview-value">@Localizer["RecordClass" + Model.RecordClass]</span>
            </div>
            <div class="col-12 col-md-6 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-category"></i> @Localizer["GqmsDomain"]</span>
                @* Empty is a real answer — work outside every quality domain — so it reads as the sentence for
                   that, not as a blank the reader has to interpret. *@
                <span class="backbone-preview-value">
                    @(string.IsNullOrWhiteSpace(Model.GqmsDomain) ? Localizer["GqmsDomainNone"].Value : Model.GqmsDomain)
                </span>
            </div>
            <div class="col-12 col-md-6 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-sitemap"></i> @Localizer["FunctionCode"]</span>
                <span class="backbone-preview-value">@(string.IsNullOrWhiteSpace(Model.FunctionCode) ? "-" : $"{Model.FunctionCode} · {Localizer["FunctionCode" + Model.FunctionCode].Value}")</span>
            </div>
            <div class="col-12 col-md-6 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-error-circle"></i> @Localizer["QualityEvent"]</span>
                <span class="backbone-preview-value">@(Model.IsQualityEvent ? Localizer["QualityEventYes"].Value : Localizer["QualityEventNo"].Value)</span>
            </div>
            <div class="col-12 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-file"></i> @Localizer["GroupDocuments"]</span>
                <span class="backbone-preview-value">
                    @if (Model.GroupDocuments is { Count: > 0 })
                    {
                        @string.Join(" · ", Model.GroupDocuments)
                    }
                    else
                    {
                        @* DCP-005 §11 records this as a KNOWN consequence: 9 of the 31 seed types have governing
                           SOPs with UIDs allocated but no row in the master register, so they legitimately have
                           nothing to show. The empty state says "none recorded", not "none exists". *@
                        <span class="text-muted">@Localizer["GroupDocumentsEmpty"]</span>
                    }
                </span>
            </div>
            <div class="col-12 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-flag"></i> @Localizer["ClosureOutcomesSection"]</span>
                <span class="backbone-preview-value">
                    @if (Model.ClosureOutcomes is { Count: > 0 })
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var outcome in Model.ClosureOutcomes.OrderBy(o => o.SortOrder).ThenBy(o => o.Code, StringComparer.OrdinalIgnoreCase))
                            {
                                @* SYSTEM outcomes read through the resx (seven languages); a TENANT outcome
                                   prints the words its author typed, in the language they typed them in. The
                                   CODE follows in muted text — it is the identity stored on every task closed
                                   this way, so somebody reading a raw export needs to be able to find it. *@
                                var label = string.IsNullOrWhiteSpace(outcome.LabelResourceKey)
                                    ? (outcome.LabelText ?? outcome.Code)
                                    : OutcomeLocalizer[outcome.LabelResourceKey].Value;
                                <li class="mb-1">
                                    <span class="badge @(outcome.Disposition == "Cancelled" ? "bg-label-secondary" : "bg-label-success")">
                                        @(outcome.Disposition == "Cancelled"
                                            ? Localizer["ClosureDispositionCancelled"].Value
                                            : Localizer["ClosureDispositionCompleted"].Value)
                                    </span>
                                    <span class="ms-2">@label</span>
                                    <span class="text-muted small ms-2">@outcome.Code</span>
                                    @if (outcome.RequiresReason)
                                    {
                                        @* ⭐ Shown per row, because that is where the rule lives. *@
                                        <span class="badge bg-label-warning ms-2">@Localizer["ClosureOutcomeRequiresReason"]</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        @* An empty dictionary is a CONFIGURATION, not a gap: this type asks nothing when a task
                           closes, which is how every unconfigured type behaves. The sentence says so. *@
                        <span class="text-muted">@Localizer["ClosureOutcomesEmpty"]</span>
                    }
                </span>
            </div>
            <div class="col-12 col-md-6 backbone-preview-field">
                <span class="backbone-preview-label"><i class="bx bx-toggle-left"></i> @SharedLocalizer["Status"]</span>
                <span class="backbone-preview-value">
                    <span class="badge @(Model.IsActive ? "bg-label-success" : "bg-label-secondary")">
                        @(Model.IsActive ? SharedLocalizer["Active"].Value : SharedLocalizer["Passive"].Value)
                    </span>
                </span>
            </div>
        </div>
    </div>
</section>
