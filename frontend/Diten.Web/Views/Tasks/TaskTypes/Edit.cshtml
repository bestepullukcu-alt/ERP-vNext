@model Diten.Web.Models.TaskTypes.TaskTypeEditViewModel
@using Diten.Web.Views.Tasks.TaskTypes
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TaskTypesIndex> Localizer
@{
    ViewData["Title"] = Localizer["FormTitleEdit"].Value;
    Layout = "_LayoutTenantShell";
    ViewData["FormMode"] = "edit";
}

<partial name="~/Views/Tasks/TaskTypes/_Form.cshtml" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* The closure outcome repeater. No vendor dependency — see the file for why jquery.repeater is not used. *@
    <script src="~/assets/js/Tasks/task-type-closure-outcomes.js" asp-append-version="true"></script>
}
