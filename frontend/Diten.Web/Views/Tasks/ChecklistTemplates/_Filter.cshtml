@using Diten.Web.Views.Tasks.ChecklistTemplates
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TaskChecklistTemplatesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    <div class="filter-chip filter-status">
                        <select id="filterStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@SharedLocalizer["Status"]">
                            <option value="Active">@SharedLocalizer["Active"]</option>
                            <option value="Passive">@SharedLocalizer["Passive"]</option>
                        </select>
                    </div>

                    @*
                        "Has a blocking step" is the question a QA reader actually arrives with — a checklist
                        whose every step is optional gates nothing, and that is invisible in a name. Built from
                        the ROWS this table already holds, like the sibling screen: a lookup endpoint would be a
                        second source that can disagree with what is on screen.
                    *@
                    <div class="filter-chip filter-gating">
                        <select id="filterGating" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Gating"]">
                            <option value="Blocking">@Localizer["GatingBlocking"]</option>
                            <option value="Advisory">@Localizer["GatingAdvisory"]</option>
                        </select>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" class="btn btn-sm btn-primary" id="btnFilterApply">
                            @SharedLocalizer["Apply"]
                        </button>
                        <button type="reset" class="btn btn-sm btn-label-danger" id="btnFilterReset">
                            @SharedLocalizer["Reset"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
