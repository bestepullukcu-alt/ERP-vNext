@using Diten.Web.Views.Tasks
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TasksIndex> Localizer
@{
    var mode = (ViewData["FormMode"] as string) ?? "create";
    var taskId = ViewData["TaskId"] as string ?? string.Empty;
    var isEdit = mode == "edit";
    var title = isEdit ? Localizer["FormTitleEdit"].Value : Localizer["FormTitleCreate"].Value;
}

@* MOD-0024 — the DETAILED form, shared by Create and Edit. Aligned to the Golden Reference Compact form
   (DevEnablement/GoldenReferenceCompact/_Form.cshtml): header row with breadcrumb and the actions top-right, then
   one <section class="card"> per logical group, select2 on every picker.
   The quick-create offcanvas hands its draft to this same form, so switching depth loses nothing.
   Field visibility is driven by data-task-field + the assignment target; all toggling is class-based (FG-003). *@

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@title</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Tasks">@Localizer["TasksTitle"]</a></li>
                <li class="breadcrumb-item active text-primary">@title</li>
            </ol>
        </nav>
    </div>
    @* The actions live HERE and nowhere else. The reference puts them beside the title, and a second copy at the
       bottom of a long form only asks the user which of the two buttons is the real one.
       The submit is bound to the form by id (reference pattern) — which is also what lets the shared
       required-field tracker find this form's submit and render its badge next to it. *@
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-label-secondary" href="/Tasks">@Localizer["ActionCancel"]</a>
        <button type="submit" form="taskForm" class="btn btn-primary" id="taskSubmit">
            @(isEdit ? Localizer["ActionSave"] : Localizer["ActionCreate"])
        </button>
    </div>
</div>

<form id="taskForm" data-task-mode="@mode" data-task-id="@taskId" novalidate>
    <div class="row g-4">
        <div class="col-12 col-lg-8">

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionBasics"]</h6>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-medium" for="taskTitle">
                                @Localizer["FieldTitle"] <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="taskTitle" name="title" maxlength="200"
                                   placeholder="@Localizer["FieldTitlePlaceholder"]" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium" for="taskPriority">@Localizer["FieldPriority"]</label>
                            <select class="select2 form-select" id="taskPriority" name="priority">
                                <option value="Low">@Localizer["PriorityLow"]</option>
                                <option value="Medium" selected>@Localizer["PriorityMedium"]</option>
                                <option value="High">@Localizer["PriorityHigh"]</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium" for="taskDescription">@Localizer["FieldDescription"]</label>
                            <textarea class="form-control" id="taskDescription" name="description" rows="3"
                                      maxlength="4000"></textarea>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionAssignment"]</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="taskAssignmentTarget">
                                @Localizer["FieldAssignmentTarget"] <span class="text-danger">*</span>
                            </label>
                            <select class="select2 form-select" id="taskAssignmentTarget" name="assignmentTarget">
                                <option value="SelfAssigned" selected>@Localizer["TargetSelf"]</option>
                                <option value="Person">@Localizer["TargetPerson"]</option>
                                <option value="PositionPool">@Localizer["TargetPool"]</option>
                            </select>
                        </div>

                        @* Shown only for the Person target — a pool task has no assignee until it is claimed.
                           A picker, not a text box: each option reads "Name — Position — Unit", and a user GUID is
                           never shown or typed (pack §12 K6.4). *@
                        <div class="col-md-6 d-none" data-task-field="assignee">
                            <label class="form-label fw-medium" for="taskAssignee">
                                @Localizer["FieldAssignee"] <span class="text-danger">*</span>
                            </label>
                            <select class="select2 form-select" id="taskAssignee" name="assigneeUserId"></select>
                            <div class="form-text">@Localizer["AssigneeHint"]</div>
                        </div>

                        @* Shown only for the Pool target. Each option carries its unit so work cannot be pooled to
                           the wrong facility. *@
                        <div class="col-md-6 d-none" data-task-field="poolPosition">
                            <label class="form-label fw-medium" for="taskPoolPosition">
                                @Localizer["FieldPoolPosition"] <span class="text-danger">*</span>
                            </label>
                            <select class="select2 form-select" id="taskPoolPosition" name="poolPositionId"></select>
                            <div class="form-text">@Localizer["PoolPositionHint"]</div>
                        </div>

                        <div class="col-md-6 d-none" data-task-field="organizationUnit">
                            <label class="form-label fw-medium" for="taskOrganizationUnit">@Localizer["FieldOrganizationUnit"]</label>
                            <input type="text" class="form-control" id="taskOrganizationUnit" name="organizationUnitId"
                                   autocomplete="off" />
                        </div>

                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionPlanning"]</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="taskDueAt">
                                @Localizer["FieldDueAt"] <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control flatpickr-date" id="taskDueAt" name="dueAt" placeholder="YYYY-MM-DD" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="taskStartAt">@Localizer["FieldStartAt"]</label>
                            <input type="text" class="form-control flatpickr-date" id="taskStartAt" name="startAt" placeholder="YYYY-MM-DD" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="taskPlannedDate">@Localizer["FieldPlannedDate"]</label>
                            <input type="text" class="form-control flatpickr-date" id="taskPlannedDate" name="plannedDate" placeholder="YYYY-MM-DD" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="taskEstimateHours">@Localizer["FieldEstimateHours"]</label>
                            <input type="number" min="0" step="0.25" class="form-control" id="taskEstimateHours"
                                   name="estimateHours" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium" for="taskTags">@Localizer["FieldTags"]</label>
                            <input type="text" class="form-control" id="taskTags" name="tags" autocomplete="off" />
                        </div>

                        @* Effort actuals are execution-only: a new task is always zero, so the field is read-only
                           here. *@
                        <div class="col-md-6 d-none" data-task-field="spentHours">
                            <label class="form-label fw-medium" for="taskSpentHours">@Localizer["FieldSpentHours"]</label>
                            <input type="text" class="form-control" id="taskSpentHours" readonly disabled />
                            <div class="form-text">@Localizer["SpentHoursReadOnlyHint"]</div>
                        </div>
                        <div class="col-md-6 d-none" data-task-field="remainingHours">
                            <label class="form-label fw-medium" for="taskRemainingHours">@Localizer["FieldRemainingHours"]</label>
                            <input type="text" class="form-control" id="taskRemainingHours" readonly disabled />
                        </div>
                    </div>
                </div>
            </section>

            @* Configurable fields get a card of their own because their CONTENT is tenant-owned: the count, the
               labels and the sections all change per tenant, so mixing them into a fixed card would make that
               card's shape unpredictable. Hidden until at least one definition renders. *@
            <section class="card mb-4 d-none" id="taskCustomFields" data-task-field="customFields">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionCustomFields"]</h6>
                    <div class="row g-3" id="taskCustomFieldsRow"></div>
                </div>
            </section>
        </div>

        @* Governance is FIVE decisions, and they were one card. Each is now its own card with an icon, a title
           and one sentence saying what happens if it is on — a heading alone ("Onay yöneticisi") tells the user
           the name of a field they are already looking at.
           Deliberately NOT here: the consultant watcher role (BL-053) and the approval-flow diagram. *@
        <div class="col-12 col-lg-4">

            @* Phase 3b: review is implemented, so the switch is live and the sentence says what it DOES rather
               than when it might arrive. *@
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold d-flex align-items-center gap-2 mb-1">
                        <i class="bx bx-search-alt text-primary"></i>@Localizer["CardReviewTitle"]
                    </h6>
                    <p class="text-muted small mb-3">@Localizer["ReviewRequiredHint"]</p>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="taskReviewRequired" name="reviewRequired" />
                        <label class="form-check-label" for="taskReviewRequired">@Localizer["FieldReviewRequired"]</label>
                    </div>

                    @* REVIEW TYPE — the place, not the feature. There is exactly ONE review type today ("quick":
                       the reviewer approves directly), and it was nameless; naming it is what makes the second one
                       legible when it arrives. The meeting option is DISABLED and says WHY (DEC-001: a dead
                       control with no explanation gets reported as a bug), and nothing about this choice reaches
                       the server — one value needs no field, and an unread property in the contract is a question
                       every future reader has to answer. *@
                    <div class="d-none mb-3" data-task-field="reviewer">
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="radio" name="reviewType" value="Quick"
                                   id="taskReviewTypeQuick" checked />
                            <label class="form-check-label" for="taskReviewTypeQuick">
                                @Localizer["ReviewTypeQuick"]
                                <span class="d-block text-muted small">@Localizer["ReviewTypeQuickHint"]</span>
                            </label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="reviewType" value="Meeting"
                                   id="taskReviewTypeMeeting" disabled
                                   aria-describedby="taskReviewTypeMeetingReason" />
                            <label class="form-check-label text-muted" for="taskReviewTypeMeeting">
                                @Localizer["ReviewTypeMeeting"]
                                <span class="d-block small">@Localizer["ReviewTypeMeetingHint"]</span>
                            </label>
                            <div class="form-text" id="taskReviewTypeMeetingReason">
                                @Localizer["ReviewTypeMeetingDisabledReason"]
                            </div>
                        </div>
                    </div>
                    @* The reviewer CANDIDATE is a PICKER now, not a text box: its value goes to a Guid parameter,
                       so a typed name produced a refusal and a typed GUID was the only thing that worked. Same
                       people lookup as the assignee — one vocabulary for "which person?".
                       Mandatory while the switch is on because MOD-0023 refuses to start a review with nobody to
                       route it to. Who may ACTUALLY review is still MOD-0023's decision. *@
                    <div class="d-none" data-task-field="reviewer">
                        <label class="form-label fw-medium" for="taskReviewer">
                            @Localizer["FieldReviewer"] <span class="text-danger">*</span>
                        </label>
                        <select class="select2 form-select" id="taskReviewer" name="reviewerCandidateUserId"></select>
                        <div class="form-text">@Localizer["ReviewerHint"]</div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold d-flex align-items-center gap-2 mb-1">
                        <i class="bx bx-user-check text-primary"></i>@Localizer["CardApprovalTitle"]
                    </h6>
                    <p class="text-muted small mb-3">@Localizer["CardApprovalDescription"]</p>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="taskApprovalRequired"
                               name="approvalRequired" />
                        <label class="form-check-label" for="taskApprovalRequired">
                            @Localizer["FieldApprovalRequired"]
                        </label>
                    </div>
                    <div class="d-none" data-task-field="approvalManager">
                        <label class="form-label fw-medium" for="taskApprovalManager">
                            @Localizer["FieldApprovalManager"] <span class="text-danger">*</span>
                        </label>
                        <select class="select2 form-select" id="taskApprovalManager"
                                name="approvalManagerUserId"></select>
                        <div class="form-text">@Localizer["ApprovalHint"]</div>
                    </div>
                </div>
            </section>

            @* Watchers moved out of the assignment card: watching is not an assignment, and it belongs beside the
               other decisions about who hears about this task. Multi-select, because the API takes a LIST of
               watcher rows — the old comma-separated text box was thrown away by the payload builder entirely. *@
            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold d-flex align-items-center gap-2 mb-1">
                        <i class="bx bx-show text-primary"></i>@Localizer["CardWatchersTitle"]
                    </h6>
                    <p class="text-muted small mb-3">@Localizer["WatchersHint"]</p>

                    <label class="form-label fw-medium" for="taskWatchers">@Localizer["FieldWatchers"]</label>
                    <select class="select2 form-select" id="taskWatchers" name="watchers" multiple></select>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold d-flex align-items-center gap-2 mb-1">
                        <i class="bx bx-envelope text-primary"></i>@Localizer["CardEmailTitle"]
                    </h6>
                    <p class="text-muted small mb-3">@Localizer["CardEmailDescription"]</p>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="taskEmailNotifications"
                               name="emailNotificationsEnabled" checked />
                        <label class="form-check-label" for="taskEmailNotifications">
                            @Localizer["FieldEmailNotifications"]
                        </label>
                    </div>

                    @* BL-065 — WHICH events, and HOW LONG BEFORE.
                       Only events something actually sends are listed. `duesoon` earns its place in this same
                       change: until now it was a code in the manifest with no sender anywhere, so offering it
                       would have been a checkbox promising an email nothing produces.
                       The whole block hides with the master switch — nobody should tune a channel that is off. *@
                    <div class="d-none" data-task-field="notificationPrefs">
                        <label class="form-label fw-medium">@Localizer["NotifyEventsLabel"]</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="taskNotifyAssigned"
                                   name="notifyOnEvents" value="platform.tasks.assigned" checked />
                            <label class="form-check-label" for="taskNotifyAssigned">@Localizer["NotifyEventAssigned"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="taskNotifyClaimed"
                                   name="notifyOnEvents" value="platform.tasks.claimed" checked />
                            <label class="form-check-label" for="taskNotifyClaimed">@Localizer["NotifyEventClaimed"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="taskNotifyDueSoon"
                                   name="notifyOnEvents" value="platform.tasks.duesoon" checked />
                            <label class="form-check-label" for="taskNotifyDueSoon">@Localizer["NotifyEventDueSoon"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="taskNotifyCompleted"
                                   name="notifyOnEvents" value="platform.tasks.completed" checked />
                            <label class="form-check-label" for="taskNotifyCompleted">@Localizer["NotifyEventCompleted"]</label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="taskNotifyApprovalRequested"
                                   name="notifyOnEvents" value="platform.tasks.approvalrequested" checked />
                            <label class="form-check-label" for="taskNotifyApprovalRequested">@Localizer["NotifyEventApprovalRequested"]</label>
                        </div>

                        @* The lead time only means something if the due-soon reminder is on, so it follows that
                           checkbox rather than sitting there doing nothing. Days, never a date (BL-030). *@
                        <div class="d-none" data-task-field="reminderLead">
                            <label class="form-label fw-medium" for="taskReminderLeadDays">@Localizer["ReminderLeadLabel"]</label>
                            <select class="select2 form-select" id="taskReminderLeadDays" name="reminderLeadDays">
                                <option value="">@Localizer["ReminderLeadNone"]</option>
                                <option value="0">@Localizer["ReminderLeadSameDay"]</option>
                                <option value="1">@Localizer["ReminderLead1"]</option>
                                <option value="3" selected>@Localizer["ReminderLead3"]</option>
                                <option value="7">@Localizer["ReminderLead7"]</option>
                                <option value="14">@Localizer["ReminderLead14"]</option>
                            </select>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold d-flex align-items-center gap-2 mb-1">
                        <i class="bx bx-transfer-alt text-primary"></i>@Localizer["CardDelegationTitle"]
                    </h6>
                    <p class="text-muted small mb-3">@Localizer["CardDelegationDescription"]</p>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="taskDelegationAllowed"
                               name="delegationAllowed" />
                        <label class="form-check-label" for="taskDelegationAllowed">
                            @Localizer["FieldDelegationAllowed"]
                        </label>
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>
