@using Diten.Web.Views.Tasks.Templates
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<TaskTemplatesIndex> Localizer
@{
    ViewData["Title"] = Localizer["TaskTemplatesTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/Tasks/Templates/_Filter.cshtml" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["TaskTemplatesTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@* Contract markers are rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-tasktemplates" data-dt-standard="v2"> *@
<partial name="~/Views/Tasks/Templates/_DataTable.cshtml" />

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/Tasks/Templates/_IndexL10n.cshtml" />
    <script src="~/assets/js/Tasks/Templates/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/Tasks/Templates/index.js" asp-append-version="true"></script>
}
