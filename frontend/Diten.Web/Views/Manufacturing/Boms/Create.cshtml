@model Diten.Web.Models.Manufacturing.Boms.BomEditViewModel
@using Diten.Web.Views.Manufacturing.Boms
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BomsIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["FormTitleCreate"].Value;
    Layout = "_LayoutTenantShell";
    ViewData["FormMode"] = "create";
}

@* UAS-001: no form skeleton for a user who may not create a BOM draft — one explanation, no redirect. *@
@if (!Perms.Has("manufacturing.bom.create"))
{
    <partial name="_AccessDenied" model="@Localizer["BomsTitle"].Value" />
    return;
}

<partial name="~/Views/Manufacturing/Boms/_Form.cshtml" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/Manufacturing/Boms/form.js" asp-append-version="true"></script>
}
