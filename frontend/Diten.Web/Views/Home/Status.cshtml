@model Diten.Web.Models.StatusPageViewModel
@{
    Layout = null; // self-contained: must render without the frozen _Layout shell (may be unauthenticated)
    ViewData["Title"] = $"{Model.Code} — {Model.Title}";
    // icon + accent per status code; falls back to a danger error glyph for anything else
    var (icon, accent) = Model.Code switch
    {
        401 => ("bx-log-in", "primary"),
        403 => ("bx-shield-x", "primary"),
        404 => ("bx-compass", "primary"),
        _ => ("bx-error-circle", "danger")
    };
    // 401/403 loop back to the same forbidden page if we send them "home"; the always-anonymous
    // login page is the reliable recovery. Other codes go to the real home.
    var isAuthError = Model.Code is 401 or 403;
    var homeHref = isAuthError ? "/account/login" : "/";
    var homeText = isAuthError ? "Giriş sayfasına dön" : "Ana sayfaya dön";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    @* Pick the saved or OS theme before paint so there is no light/dark flash. *@
    <script>
        (function () {
            try {
                var t = (window.localStorage && (localStorage.getItem('templateCustomizer-vertical-menu-template--Theme'))) || '';
                if (t !== 'light' && t !== 'dark') {
                    t = (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-bs-theme', 'light'); }
        })();
    </script>
    <link rel="stylesheet" href="~/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="~/assets/vendor/css/core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/vendor/css/theme-default.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/error-pages.css" asp-append-version="true" />
</head>
<body class="misc-page">
    <div class="misc-bg" aria-hidden="true"></div>
    <main class="misc-wrapper" role="alert">
        <span class="misc-icon-card">
            <i class="icon-base bx @icon text-@accent"></i>
        </span>
        <div class="misc-code-wrap">
            <span class="misc-code-ghost" aria-hidden="true">@Model.Code</span>
            <span class="misc-code">@Model.Code</span>
        </div>
        <h1 class="misc-title">@Model.Title</h1>
        <p class="misc-text">@Model.Message</p>
        <div class="misc-actions">
            <a class="btn btn-primary" href="@homeHref">
                <i class="icon-base bx @(isAuthError ? "bx-log-in" : "bx-home-alt") me-1"></i>@homeText
            </a>
            <button type="button" class="btn btn-outline-secondary" data-misc-reload>
                <i class="icon-base bx bx-refresh me-1"></i>Yenile
            </button>
        </div>
        @if (Model.ShowRequestId)
        {
            <div class="misc-req">
                <span class="misc-req-label">İstek No:</span>
                <code class="misc-req-id">@Model.RequestId</code>
                <button type="button" class="misc-req-copy" data-misc-copy="@Model.RequestId" title="Kopyala" aria-label="Kopyala">
                    <i class="icon-base bx bx-copy"></i>
                </button>
            </div>
        }
    </main>
    <footer class="misc-footer">
        © 2026 | <span class="fw-medium">Di10 ERP</span>
    </footer>
    <script src="~/js/error-pages.js" asp-append-version="true"></script>
</body>
</html>
