@using Diten.Web.Views.WorkingCalendar.Overrides
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<OverridesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="card">
    <div id="skeleton-loader" class="backbone-skeleton p-4">
        <div class="shimmer skeleton-row skeleton-row-lg"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row"></div>
        <div class="shimmer skeleton-row skeleton-row-last"></div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="dt-workingcalendaroverrides" data-dt-standard="v2" class="datatables-workingcalendaroverrides table border-top">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["CalendarCode"]</th>
                    <th class="all">@Localizer["CalendarName"]</th>
                    <th>@Localizer["CountryCode"]</th>
                    <th>@Localizer["CalendarYear"]</th>
                    <th>@Localizer["WeekendDays"]</th>
                    <th>@Localizer["DayCount"]</th>
                    <th>@SharedLocalizer["Status"]</th>
                    <th class="cell-fit text-end pe-3 all">@Localizer["Actions"]</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
