@using Diten.Web.Views.WorkingCalendar.Overrides
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<OverridesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["OverridesTitle"].Value;
    Layout = "_LayoutTenantShell";
}

@* ① Inline Filter partial *@
@* Contract marker: <partial name="_Filter" /> *@
<partial name="~/Views/WorkingCalendar/Overrides/_Filter.cshtml" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["OverridesTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

@*
    ② No bulk action bar.
    This module is CRUD-minus-delete: a calendar is archived, never deleted, and there is no bulk endpoint to
    point a bar at. Rendering a bulk bar wired to nothing would be worse than not having one, so the golden
    bulk-delete checks are expected N/A here.
*@

@* ③ DataTable Card *@
@* Contract markers are rendered by _DataTable.cshtml: id="skeleton-loader", <table id="dt-workingcalendaroverrides" data-dt-standard="v2"> *@
<partial name="~/Views/WorkingCalendar/Overrides/_DataTable.cshtml" />

@section Scripts {
    @* Contract marker: <partial name="_IndexL10n" /> *@
    <partial name="~/Views/WorkingCalendar/Overrides/_IndexL10n.cshtml" />
    <script src="~/assets/js/WorkingCalendar/Overrides/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/WorkingCalendar/Overrides/index.js" asp-append-version="true"></script>
}
