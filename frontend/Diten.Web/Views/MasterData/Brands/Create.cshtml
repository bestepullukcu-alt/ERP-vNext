@model Diten.Web.Models.MasterData.BrandEditViewModel
@using Diten.Web.Views.MasterData.Brands
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrandsIndex> Localizer
@{
    ViewData["Title"] = Localizer["CreateBrand"].Value;
    Layout = "_LayoutTenantShell";
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="mb-0">@Localizer["CreateBrand"]</h5>
        <small class="text-muted">@Localizer["RequiredFieldsHint"]</small>
    </div>
    <a href="/MasterData/Brands" class="btn btn-label-secondary">@Localizer["Cancel"]</a>
</div>
<form asp-action="Create" method="post" id="brandForm">
    @Html.AntiForgeryToken()
    <partial name="~/Views/MasterData/Brands/_Form.cshtml" model="Model" />
    <div class="d-flex justify-content-end gap-2 mt-3">
        <a href="/MasterData/Brands" class="btn btn-label-secondary">@Localizer["Cancel"]</a>
        <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
    </div>
</form>
@section Scripts {
    <partial name="~/Views/MasterData/Brands/_IndexL10n.cshtml" />
    <script src="~/assets/js/MasterData/Brands/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/MasterData/Brands/form.js" asp-append-version="true"></script>
}
