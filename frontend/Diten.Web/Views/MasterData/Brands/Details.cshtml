@model Diten.Web.Models.MasterData.BrandPageViewModel
@using System.Globalization
@using System.Text.Json
@using Diten.Web.Views.MasterData.Brands
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrandsIndex> Localizer
@inject Diten.Web.Services.IPermissionSnapshot Perms
@{
    ViewData["Title"] = Localizer["BrandDetail"].Value;
    Layout = "_LayoutTenantShell";
}

@* WP-MDM-BRAND-ACCEPT-01 FIX1 (item 5, UAS-001) — nothing of the brand is drawn without mdm.brands.read; the controller
   answers 403 with this surface. Snapshot OR the controller's own reader, so the page never refuses whom it admitted. *@
@if (!Perms.Has("mdm.brands.read") && !Diten.Web.Security.PermissionClaims.HasPermission(User, "mdm.brands.read"))
{
    <partial name="_AccessDenied" model="@Localizer["BrandsTitle"].Value" />
    return;
}

@{
    var b = Model.Brand;
    // FIX1 (item 13) — decided by the controller through PermissionClaims, the same gate the proxies use.
    var canUpdate = Model.CanUpdate;
    var canArchive = Model.CanArchive;
    var liveProducts = b.LiveProductCount ?? 0;
    string Show(object? value) => value?.ToString() is { Length: > 0 } text ? text : "—";
    // FIX1 (item 13) — dates and times in the interface language.
    string When(DateTimeOffset? value) => value?.ToString("g", CultureInfo.CurrentUICulture) ?? "—";
    string Day(DateTimeOffset? value) => value?.ToString("d", CultureInfo.CurrentUICulture) ?? "—";
}
<div id="brandDetailsPage" data-brand-id="@b.BrandId" data-archived="@b.IsArchived.ToString().ToLowerInvariant()">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h5 class="mb-0">@b.BrandName</h5>
            <small class="text-muted">@b.BrandCode · @Localizer["BrandDetail"]</small>
        </div>
        <div class="d-flex gap-2">
            <a href="/MasterData/Brands" class="btn btn-label-secondary">@Localizer["BackToList"]</a>
            @if (canUpdate) { <a href="/MasterData/Brands/@b.BrandId/Edit" class="btn btn-label-primary">@Localizer["EditBrand"]</a> }
            @if (canArchive) { <button type="button" id="archiveBrand" class="btn btn-label-warning">@Localizer["ArchiveBrand"]</button> }
        </div>
    </div>

    @* FIX1 (item 11) — the archive proxy validates this token. *@
    <form id="brandDetailToken" class="d-none" data-no-tracker>
        @Html.AntiForgeryToken()
    </form>

    @if (b.IsArchived)
    {
        <div class="alert alert-warning"><i class="bx bx-archive me-1"></i>@Localizer["ArchivedBrandReadOnly"]
            @* FIX1 (item 3) — an archived brand whose products are still in use says so. *@
            @if (liveProducts > 0)
            {
                <div class="mt-1">@Localizer["ArchivedBrandLiveProducts", liveProducts]</div>
            }
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-lg-6"><section class="card h-100">
            <div class="card-header"><h6 class="mb-0">@Localizer["SummarySection"]</h6></div>
            <div class="card-body"><dl class="row mb-0">
                <dt class="col-sm-5">@Localizer["BrandCode"]</dt><dd class="col-sm-7">@b.BrandCode</dd>
                <dt class="col-sm-5">@Localizer["BrandName"]</dt><dd class="col-sm-7">@b.BrandName</dd>
                <dt class="col-sm-5">@Localizer["BrandStatus"]</dt><dd class="col-sm-7"><span class="badge bg-label-primary">@Localizer[$"Status_{b.BrandStatus}"]</span></dd>
                <dt class="col-sm-5">@Localizer["EffectiveFrom"]</dt><dd class="col-sm-7">@Day(b.EffectiveFrom)</dd>
                <dt class="col-sm-5">@Localizer["EffectiveTo"]</dt><dd class="col-sm-7">@Day(b.EffectiveTo)</dd>
                <dt class="col-sm-5">@Localizer["LiveProductCount"]</dt><dd class="col-sm-7" id="brandLiveProducts">@liveProducts</dd>
                <dt class="col-sm-5">@Localizer["Description"]</dt><dd class="col-sm-7 text-break">@Show(b.Description)</dd>
            </dl></div>
        </section></div>

        <div class="col-lg-6"><section class="card h-100">
            <div class="card-header"><h6 class="mb-0">@Localizer["ReferencesSection"]</h6></div>
            <div class="card-body"><dl class="row mb-0">
                @* FIX1 (item 8) — references by name; one that cannot be resolved says so, never as its id. *@
                <dt class="col-sm-5">@Localizer["OwnerCompanyId"]</dt>
                <dd class="col-sm-7 text-break"><partial name="~/Views/MasterData/Brands/_Reference.cshtml" model="@(b.OwnerCompanyId is null ? null : Model.OwnerCompanyName ?? string.Empty)" /></dd>
                <dt class="col-sm-5">@Localizer["BusinessUnitId"]</dt>
                <dd class="col-sm-7 text-break"><partial name="~/Views/MasterData/Brands/_Reference.cshtml" model="@(b.BusinessUnitId is null ? null : string.Empty)" /></dd>
                <dt class="col-sm-5">@Localizer["TherapeuticAreaId"]</dt>
                <dd class="col-sm-7 text-break"><partial name="~/Views/MasterData/Brands/_Reference.cshtml" model="@(b.TherapeuticAreaId is null ? null : string.Empty)" /></dd>
            </dl>
            <small class="text-muted d-block mt-2">@Localizer["ReferenceIdsOnlyHelp"]</small>
            <small class="text-muted d-block" id="therapeuticAreaHelp">@Localizer["TherapeuticAreaHelp"]</small>
            </div>
        </section></div>

        <div class="col-lg-6"><section class="card h-100">
            <div class="card-header"><h6 class="mb-0">@Localizer["ExternalReferencesSection"]</h6></div>
            <div class="card-body">
                @if (b.ExternalReferences.Count == 0)
                {
                    <div class="text-muted">@Localizer["NoExternalReferences"]</div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-sm">
                        <thead><tr>
                            <th>@Localizer["SourceSystem"]</th><th>@Localizer["ExternalId"]</th>
                            <th>@Localizer["ExternalCode"]</th><th>@Localizer["ExternalName"]</th>
                            <th>@Localizer["ImportedAt"]</th><th>@Localizer["Primary"]</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var x in b.ExternalReferences)
                        {
                            <tr>
                                <td>@x.SourceSystem</td><td class="text-break">@x.ExternalId</td>
                                <td>@Show(x.ExternalCode)</td><td>@Show(x.ExternalName)</td>
                                <td>@When(x.ImportedAt)</td>
                                <td>@(x.IsPrimary ? Localizer["Yes"] : Localizer["No"])</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>
        </section></div>

        @* Audit is detail-only, so it is a plain card rather than a form-mirrored <section>. *@
        <div class="col-lg-6"><div class="card h-100">
            <div class="card-header"><h6 class="mb-0">@Localizer["AuditSection"]</h6></div>
            <div class="card-body"><dl class="row mb-0">
                @* FIX1 (item 8) — the people are user ids no lookup resolves here: they read "could not be resolved". *@
                <dt class="col-sm-5">@Localizer["CreatedAt"]</dt><dd class="col-sm-7">@When(b.CreatedAt)</dd>
                <dt class="col-sm-5">@Localizer["CreatedBy"]</dt><dd class="col-sm-7 text-break"><partial name="~/Views/MasterData/Brands/_Reference.cshtml" model="@(string.IsNullOrEmpty(b.CreatedBy) ? null : string.Empty)" /></dd>
                <dt class="col-sm-5">@Localizer["UpdatedAt"]</dt><dd class="col-sm-7">@When(b.UpdatedAt)</dd>
                <dt class="col-sm-5">@Localizer["UpdatedBy"]</dt><dd class="col-sm-7 text-break"><partial name="~/Views/MasterData/Brands/_Reference.cshtml" model="@(string.IsNullOrEmpty(b.UpdatedBy) ? null : string.Empty)" /></dd>
                <dt class="col-sm-5">@Localizer["Archived"]</dt><dd class="col-sm-7">@(b.IsArchived ? Localizer["Yes"] : Localizer["No"])</dd>
                <dt class="col-sm-5">@Localizer["ArchivedAt"]</dt><dd class="col-sm-7">@When(b.ArchivedAt)</dd>
                <dt class="col-sm-5">@Localizer["ArchivedBy"]</dt><dd class="col-sm-7 text-break"><partial name="~/Views/MasterData/Brands/_Reference.cshtml" model="@(string.IsNullOrEmpty(b.ArchivedBy) ? null : string.Empty)" /></dd>
            </dl></div>
        </div></div>
    </div>

    <div class="card">
        <div class="card-header">
            <h6 class="mb-0">@Localizer["ProductsTab"]</h6>
            <small class="text-muted">@Localizer["ArchiveNoCascadeHelp"]</small>
        </div>
        @if (Model.CanReadProducts)
        {
            <partial name="~/Views/MasterData/Brands/_ProductsDataTable.cshtml" />
        }
        else
        {
            @* Honest limitation instead of an empty table that would read as "no products". *@
            <div class="card-body text-muted">@Localizer["ProductsTabUnavailable"]</div>
        }
    </div>
</div>

@section Scripts {
    <partial name="~/Views/MasterData/Brands/_IndexL10n.cshtml" />
    <script>window.BrandPage = @Html.Raw(JsonSerializer.Serialize(new {
        brandId = b.BrandId,
        isArchived = b.IsArchived,
        canReadProducts = Model.CanReadProducts,
        canManage = Model.CanManage,
        canArchive = Model.CanArchive,
        liveProductCount = liveProducts
    }, new JsonSerializerOptions(JsonSerializerDefaults.Web)));</script>
    <script src="~/assets/js/MasterData/Brands/index.l10n.js" asp-append-version="true"></script>
    <script src="~/assets/js/MasterData/Brands/details.js" asp-append-version="true"></script>
}
