@using System.Globalization
@using System.Text.Json
@using Diten.Web.Views.MasterData.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // MOD-0220 finish — the reduced wizard renders every label server-side; the JS only needs a few runtime
    // strings + the request culture's date format (mapped from the .NET short-date pattern to flatpickr tokens),
    // so date pickers display in the user's locale format while the stored value stays ISO (Y-m-d).
    // WCN-FIX-04 — one conversion for every view (FlatpickrDateFormat: drops the bidi marks Arabic's pattern carries).

    var dateFormat = Diten.Web.Services.Localization.FlatpickrDateFormat.ForCurrentCulture();

    var payload = new
    {
        RequiredCounter = Localizer["RequiredCounter"].Value,
        RequiredField = Localizer["RequiredField"].Value,
        // WCN-FIX-04 — a typed date the shared guard refused: the save stops and says why (SharedResource, 7 languages).
        DateNotRecognized = SharedLocalizer["DateNotRecognized"].Value,
        DateFormat = dateFormat,
        RecordCreated = SharedLocalizer["RecordCreated"].Value,
        RecordUpdated = SharedLocalizer["RecordUpdated"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value
    };
}
<script id="legal-entities-wizard-l10n" type="application/json">
@Html.Raw(JsonSerializer.Serialize(payload))
</script>
