@using Diten.Web.Views.MasterData.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div id="inlineFilterHost">
    <div class="collapse" id="inlineFilterCollapse">
        <div class="pt-0 pb-3">
            <form class="m-0" id="filterForm" data-no-tracker>
                <div class="dt-filter-bar d-flex flex-wrap align-items-center gap-3">

                    @* Country (multi-select; options loaded from platform lookups) *@
                    <div class="filter-chip filter-country">
                        <select id="filterCountry" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["Country"]"></select>
                    </div>

                    @* Operational Status (multi-select) *@
                    <div class="filter-chip filter-operational-status">
                        <select id="filterOperationalStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["OperationalStatus"]">
                            <option value="DRAFT">@Localizer["StatusDraft"]</option>
                            <option value="INREVIEW">@Localizer["StatusInReview"]</option>
                            <option value="APPROVED">@Localizer["StatusApproved"]</option>
                            <option value="ACTIVE">@Localizer["StatusActive"]</option>
                            <option value="SUSPENDED">@Localizer["StatusSuspended"]</option>
                            <option value="ARCHIVED">@Localizer["StatusArchived"]</option>
                        </select>
                    </div>

                    @* Evidence Status (multi-select) *@
                    <div class="filter-chip filter-evidence-status">
                        <select id="filterEvidenceStatus" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["EvidenceStatus"]">
                            <option value="NOTSTARTED">@Localizer["EvidenceNotStarted"]</option>
                            <option value="COMPLETE">@Localizer["EvidenceComplete"]</option>
                            <option value="VERIFIED">@Localizer["EvidenceVerified"]</option>
                        </select>
                    </div>

                    @* Base Currency (multi-select; options loaded from platform lookups) *@
                    <div class="filter-chip filter-currency">
                        <select id="filterBaseCurrency" class="form-select form-select-sm select2" multiple="multiple" data-placeholder="@Localizer["BaseCurrency"]"></select>
                    </div>

                    @* Created From / To — Sneat (flatpickr) date pickers *@
                    <div class="filter-chip filter-created-from">
                        <input type="text" id="filterCreatedFrom" class="form-control form-control-sm flatpickr-date" autocomplete="off" title="@Localizer["CreatedFrom"]" placeholder="@Localizer["CreatedFrom"]" />
                    </div>
                    <div class="filter-chip filter-created-to">
                        <input type="text" id="filterCreatedTo" class="form-control form-control-sm flatpickr-date" autocomplete="off" title="@Localizer["CreatedTo"]" placeholder="@Localizer["CreatedTo"]" />
                    </div>

                    <div class="filter-chip filter-incomplete d-flex align-items-center">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="filterIncompleteOnly" />
                            <label class="form-check-label" for="filterIncompleteOnly">@Localizer["IncompleteOnly"]</label>
                        </div>
                    </div>

                    <div class="ms-auto d-flex gap-3">
                        <button type="button" id="btnFilterApply" class="btn btn-sm btn-primary">@SharedLocalizer["Apply"]</button>
                        <button type="reset" id="btnFilterReset" class="btn btn-sm btn-label-danger">@SharedLocalizer["Reset"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
