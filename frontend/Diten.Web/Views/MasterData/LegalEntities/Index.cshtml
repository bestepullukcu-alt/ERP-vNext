@using Diten.Web.Views.MasterData.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Localizer["LegalEntitiesTitle"].Value;
    Layout = "_LayoutTenantShell";
}

<partial name="_Filter" />

<div class="mb-3">
    <h5 class="mb-0">@Localizer["LegalEntitiesTitle"]</h5>
    <p class="mb-0 text-muted">@Localizer["PageDescription"]</p>
</div>

<partial name="_DataTable.cshtml" />

@* Görev 6 — Quick View offcanvas (read-only summary + lifecycle actions). Create/Edit live on the full-page wizard. *@
<partial name="_QuickViewOffcanvas" />

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="_IndexL10n" />
    <script src="~/assets/js/MasterData/LegalEntities/index.js" asp-append-version="true"></script>
}
