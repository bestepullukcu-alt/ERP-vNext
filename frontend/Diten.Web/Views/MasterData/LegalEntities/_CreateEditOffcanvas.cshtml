@using Diten.Web.Views.MasterData.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCreateEdit" aria-labelledby="offcanvasCreateEditLabel">
    <div class="offcanvas-header p-4">
        <h5 id="offcanvasCreateEditLabel" class="offcanvas-title">-</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body border-top p-4">
        @* Server-side validation errors (from gateway) *@
        <div id="formLegalEntityAlert" class="alert alert-danger d-none" role="alert"></div>

        <form id="formLegalEntity" class="pt-0" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-4">
                <div class="col-12">
                    <label for="legalEntityCode" class="form-label fw-medium">
                        @Localizer["Code"] <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="legalEntityCode" name="Code" class="form-control" maxlength="64"
                           placeholder="@Localizer["CodePlaceholder"]" required />
                    <div class="invalid-feedback">@Localizer["RequiredField"]</div>
                </div>

                <div class="col-12">
                    <label for="legalEntityLegalName" class="form-label fw-medium">
                        @Localizer["LegalName"] <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="legalEntityLegalName" name="LegalName" class="form-control" maxlength="256"
                           placeholder="@Localizer["LegalNamePlaceholder"]" required />
                    <div class="invalid-feedback">@Localizer["RequiredField"]</div>
                </div>

                <div class="col-12">
                    <label for="legalEntityDisplayName" class="form-label fw-medium">@Localizer["DisplayName"]</label>
                    <input type="text" id="legalEntityDisplayName" name="DisplayName" class="form-control" maxlength="256"
                           placeholder="@Localizer["DisplayNamePlaceholder"]" />
                </div>

                <div class="col-12">
                    <p class="text-muted small mb-0">@Localizer["CreateDraftHint"]</p>
                </div>
            </div>
        </form>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex justify-content-between gap-2">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">
            @SharedLocalizer["Cancel"]
        </button>
        <button type="button" id="btnSaveLegalEntity" class="btn btn-primary">
            @SharedLocalizer["Save"]
        </button>
    </div>
</div>
