@using Diten.Web.Views.MasterData.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer

@* Görev 6 — Quick View offcanvas. Summarizes key fields + status + completeness + lifecycle actions. *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasQuickView" aria-labelledby="offcanvasQuickViewLabel">
    <div class="offcanvas-header p-4">
        <h5 id="offcanvasQuickViewLabel" class="offcanvas-title">@Localizer["QuickView"]</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@SharedLocalizer["Cancel"]"></button>
    </div>

    <div class="offcanvas-body border-top p-4">
        <div id="quickViewLoading" class="text-center text-muted py-4">
            <div class="spinner-border spinner-border-sm" role="status"></div>
        </div>

        <div id="quickViewContent" class="d-none">
            <div class="mb-3">
                <h5 class="mb-1" id="qvLegalName">-</h5>
                <span class="fw-medium font-monospace text-primary" id="qvCode">-</span>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <span id="qvOperationalStatus"></span>
                <span id="qvStatutoryStatus"></span>
                <span id="qvEvidenceStatus"></span>
                <span id="qvReferenceable"></span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between">
                    <small class="text-muted">@Localizer["CompletenessScore"]</small>
                    <small class="fw-medium" id="qvCompletenessLabel">-</small>
                </div>
                <div class="progress mt-1" style="height: 6px;">
                    <div id="qvCompletenessBar" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                </div>
            </div>

            <dl class="row mb-0 small">
                <dt class="col-5 text-muted">@Localizer["DisplayName"]</dt><dd class="col-7" id="qvDisplayName">-</dd>
                <dt class="col-5 text-muted">@Localizer["LegalForm"]</dt><dd class="col-7" id="qvLegalForm">-</dd>
                <dt class="col-5 text-muted">@Localizer["OrgRole"]</dt><dd class="col-7" id="qvOrgRole">-</dd>
                <dt class="col-5 text-muted">@Localizer["Country"]</dt><dd class="col-7" id="qvCountry">-</dd>
                <dt class="col-5 text-muted">@Localizer["BaseCurrency"]</dt><dd class="col-7" id="qvBaseCurrency">-</dd>
                <dt class="col-5 text-muted">@Localizer["Parent"]</dt><dd class="col-7" id="qvParent">-</dd>
                <dt class="col-5 text-muted">@Localizer["RegistrationNumber"]</dt><dd class="col-7" id="qvRegistrationNumber">-</dd>
                <dt class="col-5 text-muted">@Localizer["TaxId"]</dt><dd class="col-7" id="qvTaxId">-</dd>
                <dt class="col-5 text-muted">@Localizer["OfficialEmail"]</dt><dd class="col-7" id="qvOfficialEmail">-</dd>
            </dl>
        </div>
    </div>

    <div class="offcanvas-footer backbone-offcanvas-actions border-top p-4 d-flex flex-wrap justify-content-between gap-2">
        <div class="d-flex gap-2 flex-wrap" id="qvLifecycleActions"></div>
        <a href="#" id="qvViewDetailsLink" class="btn btn-label-primary">
            <i class="bx bx-show me-1"></i>@Localizer["ViewDetails"]
        </a>
    </div>
</div>
