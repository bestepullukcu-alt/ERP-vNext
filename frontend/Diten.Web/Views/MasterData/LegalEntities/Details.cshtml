@using Diten.Web.Views.MasterData.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var legalEntityId = ViewData["LegalEntityId"]?.ToString() ?? string.Empty;
    ViewData["Title"] = Localizer["ViewDetails"].Value;
    Layout = "_LayoutTenantShell";
}

@* MOD-0220 — Legal Entity read-only Details. Mirrors the GoldenReferenceCompact Details reference: static title +
   breadcrumb, Back + Edit header buttons, and read-only `card backbone-preview-section` cards laid out as a
   col-lg-8 main column + col-lg-4 sidebar. Sections match the create wizard's Overview step. Values are fetched
   by id and populated client-side by details.js (No-ViewModel). *@
<div class="legal-entity-details" id="le-details-page" data-le-id="@legalEntityId">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@Localizer["ViewDetails"]</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/LegalEntities">@Localizer["LegalEntitiesTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary" id="leDetailBreadcrumb">@Localizer["ViewDetails"]</li>
                </ol>
            </nav>
        </div>
        @* Button order: Back → Actions ▼ → Edit *@
        <div class="d-flex align-items-center gap-2">
            <a href="/LegalEntities" class="btn btn-label-secondary">@SharedLocalizer["Back"]</a>
            @* Lifecycle actions (Activate / Suspend / Archive) live in this dropdown; JS fills the menu and reveals
               the wrapper only when the current status offers at least one action. *@
            <div class="dropdown d-none" id="leDetailActionWrap">
                <button type="button" class="btn btn-label-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bx bx-cog me-1"></i>@Localizer["Actions"]
                </button>
                <ul class="dropdown-menu dropdown-menu-end" id="leDetailLifecycleActions"></ul>
            </div>
            <a href="/LegalEntities/Wizard/@legalEntityId" class="btn btn-primary" id="leDetailEditBtn">@Localizer["Edit"]</a>
        </div>
    </div>

    <div id="le-details-alert" class="alert alert-danger d-none" role="alert"></div>

    <div id="le-details-loading" class="text-center text-muted py-5">
        <div class="spinner-border" role="status"></div>
    </div>

    <div id="le-details-content" class="d-none">
        <div class="row g-4">
            @* Main column (left) *@
            <div class="col-12 col-lg-8 d-flex flex-column gap-4">
                <section class="card backbone-preview-section p-4">
                    @* Section title on the left, status badges on the right — inside the Identity card. *@
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                        <h6 class="text-uppercase text-heading fw-semibold mb-0">@Localizer["SectionIdentity"]</h6>
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <span id="leDetailOperational"></span>
                            <span id="leDetailStatutory"></span>
                            <span id="leDetailReferenceable"></span>
                            <span id="leDetailLifecycle"></span>
                        </div>
                    </div>
                    <div class="row g-4" id="leSecIdentity"></div>
                </section>
                <section class="card backbone-preview-section p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionStatutory"]</h6>
                    <div class="row g-4" id="leSecStatutory"></div>
                </section>
                <section class="card backbone-preview-section p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionAddresses"]</h6>
                    <div class="row g-4" id="leSecAddresses"></div>
                </section>
            </div>

            @* Sidebar column (right) *@
            <div class="col-12 col-lg-4 d-flex flex-column gap-4">
                <section class="card backbone-preview-section p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionStructure"]</h6>
                    <div class="row g-4" id="leSecStructure"></div>
                </section>
                <section class="card backbone-preview-section p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionFinance"]</h6>
                    <div class="row g-4" id="leSecFinance"></div>
                </section>
                <section class="card backbone-preview-section p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionSystem"]</h6>
                    <div class="row g-4" id="leSecSystem"></div>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="_DetailsL10n" />
    <script src="~/assets/js/MasterData/LegalEntities/details.js" asp-append-version="true"></script>
}
