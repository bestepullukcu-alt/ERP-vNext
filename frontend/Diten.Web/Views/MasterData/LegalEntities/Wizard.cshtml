@using Diten.Web.Views.MasterData.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    var legalEntityId = ViewData["LegalEntityId"]?.ToString() ?? string.Empty;
    var isEdit = !string.IsNullOrEmpty(legalEntityId);
    ViewData["Title"] = isEdit ? Localizer["WizardEditTitle"].Value : Localizer["WizardCreateTitle"].Value;
    Layout = "_LayoutTenantShell";
    var pageTitle = isEdit ? Localizer["WizardEditTitle"].Value : Localizer["WizardCreateTitle"].Value;
}

@* MOD-0220 finish — Legal Entity create/edit. IDENTITY + CORE STATUTORY are required; Structure / Finance /
   Addresses are optional detail steps; the final step is a read-only Overview. Rendered as a left-hand step
   wizard (bs-stepper, vertical) — a step can only be reached once every step before it has passed validation
   (see wizard.js maxReachedStep gating). Step nav card + content card are two separate cards; the Prev/Next/
   Submit action bar sits BELOW the content card (not inside it). *@
<div id="le-wizard-page" data-le-id="@legalEntityId" data-le-mode="@(isEdit ? "edit" : "create")">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-0" id="le-wizard-title">@pageTitle</h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/LegalEntities">@Localizer["LegalEntitiesTitle"]</a></li>
                    <li class="breadcrumb-item active text-primary">@pageTitle</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @* Shared required-fields tracker (required-fields-tracker.js) renders the "Zorunlu: X / Y" shield badge
               into this host — same component the Golden Reference compact forms use. *@
            <span id="le-required-tracker-host" class="d-flex align-items-center"></span>
            <a href="/LegalEntities" class="btn btn-label-secondary">@SharedLocalizer["Cancel"]</a>
            @* Submit lives next to Cancel but stays disabled until the final Overview step (JS toggles it). *@
            <button type="button" class="btn btn-primary" id="le-submit" disabled>@(isEdit ? Localizer["SaveDraft"].Value : Localizer["Submit"].Value)</button>
        </div>
    </div>

    @if (!isEdit)
    {
        <div class="alert alert-info d-flex align-items-center" role="alert">
            <i class="bx bx-info-circle me-2"></i><span>@Localizer["CreateDraftHint"]</span>
        </div>
    }

    <div id="le-wizard-alert" class="alert alert-danger d-none" role="alert"></div>

    @Html.AntiForgeryToken()

    @* Two-card layout: step navigation (left) + step content (right). Both stay inside the .bs-stepper element
       so bs-stepper keeps finding .step + content panes; the theme's white .bs-stepper background is stripped in
       backbone-custom.css so the gutter shows the page body colour. *@
    <div id="le-wizard-stepper" class="bs-stepper vertical">
        <div class="row g-4">
        <div class="col-12 col-lg-4">
        <div class="card">
        <div class="card-body p-3">
        <div class="bs-stepper-header">
            <div class="step active" data-target="#le-step-1">
                <button type="button" class="step-trigger" aria-selected="true">
                    <span class="bs-stepper-circle">1</span>
                    <span class="bs-stepper-label">
                        <span class="bs-stepper-title">@Localizer["Step1Identity"]</span>
                        <span class="bs-stepper-subtitle">@Localizer["Step1IdentitySub"]</span>
                    </span>
                </button>
            </div>
            <div class="line"></div>
            <div class="step" data-target="#le-step-2">
                <button type="button" class="step-trigger" aria-selected="false">
                    <span class="bs-stepper-circle">2</span>
                    <span class="bs-stepper-label">
                        <span class="bs-stepper-title">@Localizer["Step2Statutory"]</span>
                        <span class="bs-stepper-subtitle">@Localizer["Step2StatutorySub"]</span>
                    </span>
                </button>
            </div>
            <div class="line"></div>
            <div class="step" data-target="#le-step-3">
                <button type="button" class="step-trigger" aria-selected="false">
                    <span class="bs-stepper-circle">3</span>
                    <span class="bs-stepper-label">
                        <span class="bs-stepper-title">@Localizer["Step3Structure"]</span>
                        <span class="bs-stepper-subtitle">@Localizer["Step3StructureSub"]</span>
                    </span>
                </button>
            </div>
            <div class="line"></div>
            <div class="step" data-target="#le-step-4">
                <button type="button" class="step-trigger" aria-selected="false">
                    <span class="bs-stepper-circle">4</span>
                    <span class="bs-stepper-label">
                        <span class="bs-stepper-title">@Localizer["Step4Finance"]</span>
                        <span class="bs-stepper-subtitle">@Localizer["Step4FinanceSub"]</span>
                    </span>
                </button>
            </div>
            <div class="line"></div>
            <div class="step" data-target="#le-step-5">
                <button type="button" class="step-trigger" aria-selected="false">
                    <span class="bs-stepper-circle">5</span>
                    <span class="bs-stepper-label">
                        <span class="bs-stepper-title">@Localizer["Step5Addresses"]</span>
                        <span class="bs-stepper-subtitle">@Localizer["Step5AddressesSub"]</span>
                    </span>
                </button>
            </div>
            <div class="line"></div>
            <div class="step" data-target="#le-step-6">
                <button type="button" class="step-trigger" aria-selected="false">
                    <span class="bs-stepper-circle">6</span>
                    <span class="bs-stepper-label">
                        <span class="bs-stepper-title">@Localizer["Step6Overview"]</span>
                        <span class="bs-stepper-subtitle">@Localizer["Step6OverviewSub"]</span>
                    </span>
                </button>
            </div>
        </div>
        </div>
        </div>
        </div>

        <div class="col-12 col-lg-8">
        <div class="card" id="le-content-card">
        <div class="bs-stepper-content p-0">
            @* The shared tracker renders its badge into #le-required-tracker-host (see header). It counts every
               field whose label carries a visible .text-danger asterisk across all panes (inactive bs-stepper
               panes are display:none via CSS, not .d-none, so the tracker still sees them). *@
            <form id="le-wizard-form" onsubmit="return false" novalidate
                  data-required-tracker-target="#le-required-tracker-host"
                  data-required-tracker-wrapper-class="d-flex align-items-center">
                @* ── Step 1: Identity ─────────────────────────────────────── *@
                <div id="le-step-1" class="content active dstepper-block">
                    <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-1">@Localizer["Step1Identity"]</h6>
                    <p class="text-muted small mb-4">@Localizer["Step1IdentityDesc"]</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leCode">@Localizer["Code"] <span class="text-danger">*</span></label>
                            <input type="text" id="leCode" class="form-control" maxlength="64" placeholder="@Localizer["CodePlaceholder"]" data-required required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leLegalName">@Localizer["LegalName"] <span class="text-danger">*</span></label>
                            <input type="text" id="leLegalName" class="form-control" maxlength="256" placeholder="@Localizer["LegalNamePlaceholder"]" data-required required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leDisplayName">@Localizer["DisplayName"]</label>
                            <input type="text" id="leDisplayName" class="form-control" maxlength="256" placeholder="@Localizer["DisplayNamePlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leLegalFormCode">@Localizer["LegalForm"] <span class="text-danger">*</span></label>
                            <select id="leLegalFormCode" class="form-select" data-required required data-lookup="legal-form"><option value="">@Localizer["SelectOption"]</option></select>
                        </div>
                    </div>
                    </div>
                </div>

                @* ── Step 2: Statutory / Advanced Details ───────────────────── *@
                <div id="le-step-2" class="content">
                    <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-1">@Localizer["SectionStatutoryAdvanced"]</h6>
                    <p class="text-muted small mb-4">@Localizer["StatutoryAdvancedDesc"]</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leRegistrationNumber">@Localizer["RegistrationNumber"]</label>
                            <input type="text" id="leRegistrationNumber" class="form-control" maxlength="128" placeholder="@Localizer["RegistrationNumberPlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leTaxId">@Localizer["TaxId"]</label>
                            <input type="text" id="leTaxId" class="form-control" maxlength="128" placeholder="@Localizer["TaxIdPlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leVatNumber">@Localizer["VatNumber"]</label>
                            <input type="text" id="leVatNumber" class="form-control" maxlength="64" placeholder="@Localizer["VatNumberPlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leCountryCode">@Localizer["Country"] <span class="text-danger">*</span></label>
                            <select id="leCountryCode" class="form-select" data-required required><option value="">@Localizer["SelectOption"]</option></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="lePlaceOfIncorporation">@Localizer["PlaceOfIncorporation"]</label>
                            <input type="text" id="lePlaceOfIncorporation" class="form-control" maxlength="256" placeholder="@Localizer["PlaceOfIncorporationPlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leStatutoryStatus">@Localizer["StatutoryStatus"]</label>
                            <select id="leStatutoryStatus" class="form-select">
                                <option value="Registered">@Localizer["StatusRegistered"]</option>
                                <option value="Pending">@Localizer["StatusPending"]</option>
                                <option value="Suspended">@Localizer["StatusSuspended"]</option>
                                <option value="Dissolved">@Localizer["StatusDissolved"]</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leIncorporationDate">@Localizer["IncorporationDate"]</label>
                            <input type="text" id="leIncorporationDate" class="form-control flatpickr-date" autocomplete="off" placeholder="@Localizer["DatePlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leDissolutionDate">@Localizer["DissolutionDate"]</label>
                            <input type="text" id="leDissolutionDate" class="form-control flatpickr-date" autocomplete="off" placeholder="@Localizer["DatePlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leBaseCurrencyCode">@Localizer["BaseCurrency"] <span class="text-danger">*</span></label>
                            <select id="leBaseCurrencyCode" class="form-select" data-required required><option value="">@Localizer["SelectOption"]</option></select>
                        </div>
                    </div>
                    </div>
                </div>

                @* ── Step 3: Structure (all optional; Parent conditional) ───── *@
                <div id="le-step-3" class="content">
                    <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-1">@Localizer["SectionStructure"]</h6>
                    <p class="text-muted small mb-4">@Localizer["Step3StructureDesc"]</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leOrganizationRoleCode">@Localizer["OrgRole"]</label>
                            <select id="leOrganizationRoleCode" class="form-select"><option value="">@Localizer["SelectOption"]</option></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leParentLegalEntityId">@Localizer["ParentLegalEntity"] <span class="text-danger d-none" id="le-parent-required-star">*</span></label>
                            <select id="leParentLegalEntityId" class="form-select"><option value="">@Localizer["NoParent"]</option></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leOwnershipPercent">@Localizer["OwnershipPercent"]</label>
                            <input type="number" id="leOwnershipPercent" class="form-control" min="0" max="100" step="0.01" placeholder="@Localizer["OwnershipPercentPlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leControlTypeCode">@Localizer["ControlType"]</label>
                            <select id="leControlTypeCode" class="form-select"><option value="">@Localizer["SelectOption"]</option></select>
                        </div>
                    </div>
                    </div>
                </div>

                @* ── Step 4: Finance (all optional) ──────────────────────────  *@
                <div id="le-step-4" class="content">
                    <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-1">@Localizer["SectionFinance"]</h6>
                    <p class="text-muted small mb-4">@Localizer["Step4FinanceDesc"]</p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-medium" for="leFiscalYearVariant">@Localizer["FiscalYearVariant"]</label>
                            <input type="text" id="leFiscalYearVariant" class="form-control" maxlength="64" placeholder="@Localizer["FiscalYearVariantPlaceholder"]" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium" for="leAccountingStandardCode">@Localizer["AccountingStandard"]</label>
                            <select id="leAccountingStandardCode" class="form-select"><option value="">@Localizer["SelectOption"]</option></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium" for="leTaxRegimeCode">@Localizer["TaxRegime"]</label>
                            <select id="leTaxRegimeCode" class="form-select"><option value="">@Localizer["SelectOption"]</option></select>
                        </div>
                    </div>
                    </div>
                </div>

                @* ── Step 5: Addresses & Contacts (all optional) ─────────────  *@
                <div id="le-step-5" class="content">
                    <div class="card-body p-4">
                    <h6 class="text-uppercase text-heading fw-semibold mb-1">@Localizer["SectionAddresses"]</h6>
                    <p class="text-muted small mb-4">@Localizer["Step5AddressesDesc"]</p>

                    <h6 class="fw-semibold mb-3">@Localizer["RegisteredAddress"]</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-medium" for="leRegAddrLine1">@Localizer["AddressFull"]</label>
                            <textarea id="leRegAddrLine1" data-addr="registered" data-addr-field="line1" class="form-control" rows="2" maxlength="512" placeholder="@Localizer["AddressFullPlaceholder"]"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leRegAddrCity">@Localizer["AddressCity"]</label>
                            <input type="text" id="leRegAddrCity" data-addr="registered" data-addr-field="city" class="form-control" maxlength="128" placeholder="@Localizer["AddressCityPlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leRegAddrState">@Localizer["AddressState"]</label>
                            <input type="text" id="leRegAddrState" data-addr="registered" data-addr-field="state" class="form-control" maxlength="128" placeholder="@Localizer["AddressStatePlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leRegAddrCountry">@Localizer["Country"]</label>
                            <input type="text" id="leRegAddrCountry" data-addr="registered" data-addr-field="country" class="form-control" maxlength="128" placeholder="@Localizer["AddressCountryPlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leRegAddrPostalCode">@Localizer["AddressPostalCode"]</label>
                            <input type="text" id="leRegAddrPostalCode" data-addr="registered" data-addr-field="postalCode" class="form-control" maxlength="32" placeholder="@Localizer["AddressPostalCodePlaceholder"]" />
                        </div>
                    </div>
                    <div class="form-text mt-1 mb-4">@Localizer["AddressJsonHelp"]</div>

                    <h6 class="fw-semibold mb-3">@Localizer["CorrespondenceAddress"]</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label fw-medium" for="leCorrAddrLine1">@Localizer["AddressFull"]</label>
                            <textarea id="leCorrAddrLine1" data-addr="correspondence" data-addr-field="line1" class="form-control" rows="2" maxlength="512" placeholder="@Localizer["AddressFullPlaceholder"]"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leCorrAddrCity">@Localizer["AddressCity"]</label>
                            <input type="text" id="leCorrAddrCity" data-addr="correspondence" data-addr-field="city" class="form-control" maxlength="128" placeholder="@Localizer["AddressCityPlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leCorrAddrState">@Localizer["AddressState"]</label>
                            <input type="text" id="leCorrAddrState" data-addr="correspondence" data-addr-field="state" class="form-control" maxlength="128" placeholder="@Localizer["AddressStatePlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leCorrAddrCountry">@Localizer["Country"]</label>
                            <input type="text" id="leCorrAddrCountry" data-addr="correspondence" data-addr-field="country" class="form-control" maxlength="128" placeholder="@Localizer["AddressCountryPlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="leCorrAddrPostalCode">@Localizer["AddressPostalCode"]</label>
                            <input type="text" id="leCorrAddrPostalCode" data-addr="correspondence" data-addr-field="postalCode" class="form-control" maxlength="32" placeholder="@Localizer["AddressPostalCodePlaceholder"]" />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-medium" for="leOfficialEmail">@Localizer["OfficialEmail"]</label>
                            <input type="email" id="leOfficialEmail" class="form-control" maxlength="256" placeholder="@Localizer["OfficialEmailPlaceholder"]" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium" for="leOfficialPhone">@Localizer["OfficialPhone"]</label>
                            <input type="text" id="leOfficialPhone" class="form-control" maxlength="64" placeholder="@Localizer["OfficialPhonePlaceholder"]" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium" for="leWebsite">@Localizer["Website"]</label>
                            <input type="text" id="leWebsite" class="form-control" maxlength="256" placeholder="@Localizer["WebsitePlaceholder"]" />
                        </div>
                    </div>
                    </div>
                </div>

                @* ── Step 6: Overview (read-only summary; each section is its OWN card, golden-compact Details
                       style). While this step is active, #le-content-card goes flush (transparent) via JS so these
                       section cards float on the page body — no card-in-card. ── *@
                <div id="le-step-6" class="content">
                    <div class="card-body p-0" id="le-overview">
                    <div class="row g-4">
                        @* Identity *@
                        <div class="col-12">
                            <section class="card backbone-preview-section p-4 h-100">
                                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionIdentity"]</h6>
                                <div class="row g-4">
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-purchase-tag-alt"></i><div><div class="backbone-preview-label">@Localizer["Code"]</div><div class="backbone-preview-value mt-1" data-ov="leCode">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-file"></i><div><div class="backbone-preview-label">@Localizer["LegalName"]</div><div class="backbone-preview-value mt-1" data-ov="leLegalName">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-rename"></i><div><div class="backbone-preview-label">@Localizer["DisplayName"]</div><div class="backbone-preview-value mt-1" data-ov="leDisplayName">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-buildings"></i><div><div class="backbone-preview-label">@Localizer["LegalForm"]</div><div class="backbone-preview-value mt-1" data-ov="leLegalFormCode">—</div></div></div></div>
                                </div>
                            </section>
                        </div>

                        @* Statutory & Tax *@
                        <div class="col-12">
                            <section class="card backbone-preview-section p-4 h-100">
                                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionStatutory"]</h6>
                                <div class="row g-4">
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-receipt"></i><div><div class="backbone-preview-label">@Localizer["RegistrationNumber"]</div><div class="backbone-preview-value mt-1" data-ov="leRegistrationNumber">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-id-card"></i><div><div class="backbone-preview-label">@Localizer["TaxId"]</div><div class="backbone-preview-value mt-1" data-ov="leTaxId">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-barcode"></i><div><div class="backbone-preview-label">@Localizer["VatNumber"]</div><div class="backbone-preview-value mt-1" data-ov="leVatNumber">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-map-pin"></i><div><div class="backbone-preview-label">@Localizer["Country"]</div><div class="backbone-preview-value mt-1" data-ov="leCountryCode">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-buildings"></i><div><div class="backbone-preview-label">@Localizer["PlaceOfIncorporation"]</div><div class="backbone-preview-value mt-1" data-ov="lePlaceOfIncorporation">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-check-shield"></i><div><div class="backbone-preview-label">@Localizer["StatutoryStatus"]</div><div class="backbone-preview-value mt-1" data-ov="leStatutoryStatus">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-calendar"></i><div><div class="backbone-preview-label">@Localizer["IncorporationDate"]</div><div class="backbone-preview-value mt-1" data-ov="leIncorporationDate">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-calendar-x"></i><div><div class="backbone-preview-label">@Localizer["DissolutionDate"]</div><div class="backbone-preview-value mt-1" data-ov="leDissolutionDate">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-dollar-circle"></i><div><div class="backbone-preview-label">@Localizer["BaseCurrency"]</div><div class="backbone-preview-value mt-1" data-ov="leBaseCurrencyCode">—</div></div></div></div>
                                </div>
                            </section>
                        </div>

                        @* Structure *@
                        <div class="col-12">
                            <section class="card backbone-preview-section p-4 h-100">
                                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionStructure"]</h6>
                                <div class="row g-4">
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-sitemap"></i><div><div class="backbone-preview-label">@Localizer["OrgRole"]</div><div class="backbone-preview-value mt-1" data-ov="leOrganizationRoleCode">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-network-chart"></i><div><div class="backbone-preview-label">@Localizer["ParentLegalEntity"]</div><div class="backbone-preview-value mt-1" data-ov="leParentLegalEntityId">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-pie-chart-alt-2"></i><div><div class="backbone-preview-label">@Localizer["OwnershipPercent"]</div><div class="backbone-preview-value mt-1" data-ov="leOwnershipPercent">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-slider"></i><div><div class="backbone-preview-label">@Localizer["ControlType"]</div><div class="backbone-preview-value mt-1" data-ov="leControlTypeCode">—</div></div></div></div>
                                </div>
                            </section>
                        </div>

                        @* Finance *@
                        <div class="col-12">
                            <section class="card backbone-preview-section p-4 h-100">
                                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionFinance"]</h6>
                                <div class="row g-4">
                                    <div class="col-md-4"><div class="backbone-preview-field"><i class="bx bx-calendar-check"></i><div><div class="backbone-preview-label">@Localizer["FiscalYearVariant"]</div><div class="backbone-preview-value mt-1" data-ov="leFiscalYearVariant">—</div></div></div></div>
                                    <div class="col-md-4"><div class="backbone-preview-field"><i class="bx bx-book"></i><div><div class="backbone-preview-label">@Localizer["AccountingStandard"]</div><div class="backbone-preview-value mt-1" data-ov="leAccountingStandardCode">—</div></div></div></div>
                                    <div class="col-md-4"><div class="backbone-preview-field"><i class="bx bx-landmark"></i><div><div class="backbone-preview-label">@Localizer["TaxRegime"]</div><div class="backbone-preview-value mt-1" data-ov="leTaxRegimeCode">—</div></div></div></div>
                                </div>
                            </section>
                        </div>

                        @* Addresses & Contacts *@
                        <div class="col-12">
                            <section class="card backbone-preview-section p-4 h-100">
                                <h6 class="text-uppercase text-heading fw-semibold mb-4">@Localizer["SectionAddresses"]</h6>
                                <div class="row g-4">
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-map"></i><div><div class="backbone-preview-label">@Localizer["RegisteredAddress"]</div><div class="backbone-preview-value mt-1" data-ov-addr="registered">—</div></div></div></div>
                                    <div class="col-md-6"><div class="backbone-preview-field"><i class="bx bx-envelope"></i><div><div class="backbone-preview-label">@Localizer["CorrespondenceAddress"]</div><div class="backbone-preview-value mt-1" data-ov-addr="correspondence">—</div></div></div></div>
                                    <div class="col-md-4"><div class="backbone-preview-field"><i class="bx bx-at"></i><div><div class="backbone-preview-label">@Localizer["OfficialEmail"]</div><div class="backbone-preview-value mt-1" data-ov="leOfficialEmail">—</div></div></div></div>
                                    <div class="col-md-4"><div class="backbone-preview-field"><i class="bx bx-phone"></i><div><div class="backbone-preview-label">@Localizer["OfficialPhone"]</div><div class="backbone-preview-value mt-1" data-ov="leOfficialPhone">—</div></div></div></div>
                                    <div class="col-md-4"><div class="backbone-preview-field"><i class="bx bx-globe"></i><div><div class="backbone-preview-label">@Localizer["Website"]</div><div class="backbone-preview-value mt-1" data-ov="leWebsite">—</div></div></div></div>
                                </div>
                            </section>
                        </div>
                    </div>
                    </div>
                </div>
            </form>
        </div>
        </div>

        @* Action bar — sits BELOW the content card (not inside it). JS toggles which buttons show per step. *@
        <div id="le-wizard-actions" class="d-flex align-items-center justify-content-between mt-3">
            <button type="button" class="btn btn-label-secondary" id="le-prev" style="display:none;">
                <i class="bx bx-chevron-left me-1"></i>@Localizer["PreviousStep"]
            </button>
            <span></span>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-primary" id="le-next">
                    <span class="align-middle me-1">@Localizer["NextStep"]</span><i class="bx bx-chevron-right"></i>
                </button>
            </div>
        </div>
        </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/bs-stepper/bs-stepper.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="~/Views/Shared/_PermissionBootstrap.cshtml" />
    <partial name="_WizardL10n" />
    <script src="~/assets/vendor/libs/bs-stepper/bs-stepper.js" asp-append-version="true"></script>
    <script src="~/assets/js/MasterData/LegalEntities/wizard.js" asp-append-version="true"></script>
}
