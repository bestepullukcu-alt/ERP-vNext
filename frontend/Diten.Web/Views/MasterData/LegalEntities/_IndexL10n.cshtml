@using System.Globalization
@using System.Text.Json
@using Diten.Web.Views.MasterData.LegalEntities
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<LegalEntitiesIndex> Localizer
@inject IHtmlLocalizer<Diten.Web.SharedResource> SharedLocalizer
@{
    // Map the request culture's .NET short-date pattern to flatpickr tokens so the filter date pickers display in
    // the user's locale format while the stored filter value stays ISO (Y-m-d).
    static string ToFlatpickr(string net) =>
        net.Replace("dd", "\x01").Replace("d", "\x02")
           .Replace("MM", "\x03").Replace("M", "\x04")
           .Replace("yyyy", "Y").Replace("yy", "y")
           .Replace("\x01", "d").Replace("\x02", "j").Replace("\x03", "m").Replace("\x04", "n");
    var payload = new
    {
        DateFormat = ToFlatpickr(CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern),
        SaveView = SharedLocalizer["SaveView"].Value,
        RecordSaved = SharedLocalizer["RecordSaved"].Value,
        LegalEntitiesTitle = Localizer["LegalEntitiesTitle"].Value,
        Actions = Localizer["Actions"].Value,
        AddNew = Localizer["AddNewLegalEntity"].Value,
        Code = Localizer["Code"].Value,
        LegalName = Localizer["LegalName"].Value,
        DisplayName = Localizer["DisplayName"].Value,
        LegalForm = Localizer["LegalForm"].Value,
        OrgRole = Localizer["OrgRole"].Value,
        Country = Localizer["Country"].Value,
        BaseCurrency = Localizer["BaseCurrency"].Value,
        Parent = Localizer["Parent"].Value,
        StatutoryStatus = Localizer["StatutoryStatus"].Value,
        OperationalStatus = Localizer["OperationalStatus"].Value,
        EvidenceStatus = Localizer["EvidenceStatus"].Value,
        CompletenessScore = Localizer["CompletenessScore"].Value,
        Referenceable = Localizer["Referenceable"].Value,
        RegistrationNumber = Localizer["RegistrationNumber"].Value,
        TaxId = Localizer["TaxId"].Value,
        OfficialEmail = Localizer["OfficialEmail"].Value,
        ViewDetails = Localizer["ViewDetails"].Value,
        Edit = Localizer["Edit"].Value,
        // Status labels (operational / lifecycle)
        StatusDraft = Localizer["StatusDraft"].Value,
        StatusInReview = Localizer["StatusInReview"].Value,
        StatusApproved = Localizer["StatusApproved"].Value,
        StatusActive = Localizer["StatusActive"].Value,
        StatusSuspended = Localizer["StatusSuspended"].Value,
        StatusArchived = Localizer["StatusArchived"].Value,
        // Statutory status
        StatusRegistered = Localizer["StatusRegistered"].Value,
        StatusPending = Localizer["StatusPending"].Value,
        StatusDissolved = Localizer["StatusDissolved"].Value,
        // Approval status
        StatusSubmitted = Localizer["StatusSubmitted"].Value,
        StatusRejected = Localizer["StatusRejected"].Value,
        // Evidence status
        EvidenceNotStarted = Localizer["EvidenceNotStarted"].Value,
        EvidenceComplete = Localizer["EvidenceComplete"].Value,
        EvidenceVerified = Localizer["EvidenceVerified"].Value,
        // Lifecycle actions
        Activate = Localizer["Activate"].Value,
        Suspend = Localizer["Suspend"].Value,
        Archive = Localizer["Archive"].Value,
        ActivateConfirm = Localizer["ActivateConfirm"].Value,
        SuspendConfirm = Localizer["SuspendConfirm"].Value,
        ArchiveConfirm = Localizer["ArchiveConfirm"].Value,
        RecordActivated = Localizer["RecordActivated"].Value,
        RecordSuspended = Localizer["RecordSuspended"].Value,
        RecordArchived = Localizer["RecordArchived"].Value,
        Yes = Localizer["Yes"].Value,
        No = Localizer["No"].Value,
        // Shared
        Delete = SharedLocalizer["Delete"].Value,
        AreYouSure = SharedLocalizer["AreYouSure"].Value,
        RecordDeleted = SharedLocalizer["RecordDeleted"].Value,
        ErrorOccurred = SharedLocalizer["ErrorOccurred"].Value,
        Cancel = SharedLocalizer["Cancel"].Value,
        Filter = SharedLocalizer["Filter"].Value,
        Apply = SharedLocalizer["Apply"].Value,
        Reset = SharedLocalizer["Reset"].Value,
        ShowAll = SharedLocalizer["ShowAll"].Value,
        Showing = SharedLocalizer["Showing"].Value
    };
}
<script id="legal-entities-l10n" type="application/json">
@Html.Raw(JsonSerializer.Serialize(payload))
</script>
