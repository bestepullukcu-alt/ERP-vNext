@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Delivery & Execution Management";
}

@await Html.PartialAsync("~/Views/EnterpriseStrategyBusinessPerformance/Components/_SubdomainShell.cshtml", Model)

<div class="alert alert-info">
    Initiatives and Projects are natively owned here. ES&amp;BP continues as the strategy alignment and reference layer for Goals, Objectives, and the Strategy Alignment Register.
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Delivery Workspace</strong>
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-primary" href="/management-governance/delivery-execution/initiatives">Open Initiatives</a>
                    <a class="btn btn-primary" href="/management-governance/delivery-execution/projects">Open Projects</a>
                    <a class="btn btn-outline-secondary" href="/management-governance/delivery-execution/programs">Programs</a>
                    <a class="btn btn-outline-secondary" href="/management-governance/delivery-execution/delivery-map">Delivery Map / Dependencies</a>
                    <a class="btn btn-outline-secondary" href="/management-governance/enterprise-strategy-business-performance/connections">Strategy Alignment Register</a>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <a class="card p-3 h-100 text-decoration-none" href="/management-governance/delivery-execution/initiatives">
                            <strong>Initiatives</strong>
                            <span class="text-muted small">Delivery-owned initiative CRUD and orchestration.</span>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a class="card p-3 h-100 text-decoration-none" href="/management-governance/delivery-execution/projects">
                            <strong>Projects</strong>
                            <span class="text-muted small">Delivery-owned project CRUD, lineage, and execution status.</span>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a class="card p-3 h-100 text-decoration-none" href="/management-governance/delivery-execution/programs">
                            <strong>Programs</strong>
                            <span class="text-muted small">Program shell retained in the target structure without overbuilding.</span>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a class="card p-3 h-100 text-decoration-none" href="/management-governance/delivery-execution/delivery-map">
                            <strong>Delivery Map / Dependencies</strong>
                            <span class="text-muted small">Dependency and blocker visibility shell under delivery ownership.</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h6 class="mb-2">Strategy Reference Layer</h6>
                <p class="text-muted mb-3">
                    Goal, Objective, and Strategy Alignment Register ownership remains in ES&amp;BP. Delivery pages consume that context without duplicating master ownership.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary btn-sm" href="/management-governance/enterprise-strategy-business-performance/goals">Goals</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/management-governance/enterprise-strategy-business-performance/objectives">Objectives</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/management-governance/enterprise-strategy-business-performance/connections">Strategy Alignment Register</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header"><strong>Execution Notes</strong></div>
            <div class="card-body">
                <div class="small text-muted mb-2">Programs and dependency mapping stay present in the subdomain structure but intentionally lightweight until deeper delivery logic is wired.</div>
                <div class="small text-muted">Existing initiative and project business logic is reused in place and re-homed through delivery-owned routes.</div>
            </div>
        </div>
    </div>
</div>
