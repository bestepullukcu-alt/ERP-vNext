@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = "Programs";
}

@await Html.PartialAsync("~/Views/EnterpriseStrategyBusinessPerformance/Components/_SubdomainShell.cshtml", Model)

<div class="card">
    <div class="card-body">
        <h5 class="mb-2">Programs</h5>
        <p class="text-muted mb-3">
            This shell reserves the native Delivery &amp; Execution Management location for program views without rebuilding unsupported behavior. Existing initiative and project logic remains fully available through the adjacent tabs.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary btn-sm" href="/management-governance/delivery-execution/initiatives">Open Initiatives</a>
            <a class="btn btn-primary btn-sm" href="/management-governance/delivery-execution/projects">Open Projects</a>
            <a class="btn btn-outline-secondary btn-sm" href="/management-governance/delivery-execution/delivery-map">Open Delivery Map / Dependencies</a>
        </div>
    </div>
</div>
