<div class="modal fade es-modal" id="projectTemplatePickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable project-template-picker-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Choose Project Template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="project-template-picker-context" class="project-template-picker-context mb-3">
                    <div class="project-template-picker-context-header">
                        <div>
                            <div class="project-template-picker-context-kicker">Delivery Anchor Context</div>
                            <h6 class="project-template-picker-context-title mb-1">Choose a template that fits the selected Parent Initiative.</h6>
                            <p class="project-template-picker-context-copy mb-0">Review the live initiative anchor and derived context below. Project Template compatibility is evaluated against the selected Parent Initiative type before you apply defaults.</p>
                        </div>
                        <div class="project-template-picker-context-badges">
                            <span class="badge bg-label-info">Parent-driven</span>
                            <span class="badge bg-label-primary">Type-matched templates</span>
                        </div>
                    </div>
                    <div class="project-template-picker-context-grid">
                        <div class="project-template-picker-context-item is-anchor">
                            <div class="project-template-picker-context-label">Parent Initiative</div>
                            <div id="project-template-picker-current-initiative" class="project-template-picker-context-value">Select Parent Initiative first</div>
                        </div>
                        <div class="project-template-picker-context-item">
                            <div class="project-template-picker-context-label">Parent Objective</div>
                            <div id="project-template-picker-current-objective" class="project-template-picker-context-value">-</div>
                        </div>
                        <div class="project-template-picker-context-item">
                            <div class="project-template-picker-context-label">Parent Goal</div>
                            <div id="project-template-picker-current-goal" class="project-template-picker-context-value">-</div>
                        </div>
                        <div class="project-template-picker-context-item">
                            <div class="project-template-picker-context-label">Parent Type</div>
                            <div id="project-template-picker-current-type" class="project-template-picker-context-value">-</div>
                        </div>
                        <div class="project-template-picker-context-item">
                            <div class="project-template-picker-context-label">Entity Scope</div>
                            <div id="project-template-picker-current-scope" class="project-template-picker-context-value">-</div>
                        </div>
                    </div>
                    <div id="project-template-picker-context-warning" class="alert alert-warning d-none mt-3 mb-0" role="alert"></div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-12 col-xl-6">
                        <input id="project-template-picker-search" class="form-control form-control-sm" placeholder="Search by name or description..." />
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <select id="project-template-picker-type" class="form-select form-select-sm">
                            <option value="">All types</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <select id="project-template-picker-entity-scope" class="form-select form-select-sm">
                            <option value="">All entity scopes</option>
                        </select>
                    </div>
                </div>
                <div id="project-template-picker-helper" class="project-inline-hint mb-2">Showing Project Templates compatible with the selected Parent Initiative.</div>
                <div class="table-responsive project-template-picker-table-wrap">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Template ID</th>
                                <th>Project Name</th>
                                <th>Description</th>
                                <th>Parent Type</th>
                                <th>Owner / PM</th>
                                <th>Sponsor</th>
                                <th>Entity Scope</th>
                                <th>Status</th>
                                <th>Lifecycle</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="project-template-picker-tbody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

