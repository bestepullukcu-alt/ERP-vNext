@model Diten.Web.Models.EnterpriseStrategy.EnterpriseStrategyPageViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Create Project";
    var prefillParentInitiativeId = ViewData["PrefillParentInitiativeId"]?.ToString() ?? string.Empty;
}
@await Html.PartialAsync("~/Views/EnterpriseStrategyBusinessPerformance/Components/_SubdomainShell.cshtml", Model)

<div id="project-create-workspace" class="goal-create-workspace" data-prefill-parent-initiative-id="@prefillParentInitiativeId">
    <div class="goal-workspace-shell project-workspace-shell">
        <div class="goal-workspace-header sticky-top">
            <div class="goal-workspace-title-wrap">
                <h5 class="goal-workspace-title mb-0">@ViewData["Title"]</h5>
                <p class="goal-workspace-subtitle mb-0">Create a governed Project under a Parent Initiative with locked lineage, compatible template defaults, delivery planning, and budget governance.</p>
            </div>
            <div class="goal-workspace-actions">
                <a href="/management-governance/delivery-execution/projects" class="btn btn-sm btn-outline-secondary">Cancel / Back</a>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="project-step-back">Back</button>
                <button type="button" class="btn btn-sm btn-outline-primary" id="project-step-next">Next</button>
                <button type="button" class="btn btn-sm btn-outline-light" id="project-save-draft">Save Draft</button>
                <button type="button" class="btn btn-sm btn-primary d-none" id="project-create-submit">Create Project</button>
                <button type="button" class="btn btn-sm btn-primary d-none" id="project-create-open">Create and Open Detail</button>
            </div>
        </div>

        <div class="goal-workspace-body">
            @{
                ViewData["Id"] = "project-form-error";
            }
            @await Html.PartialAsync("~/Views/EnterpriseStrategyBusinessPerformance/Components/Forms/_ValidationSummary.cshtml")

            <div id="project-wizard-error" class="d-none"></div>

            <div class="project-field-legend mb-3">
                <span class="badge bg-label-info">Inherited</span>
                <span>Locked to the selected Parent Initiative</span>
                <span class="badge bg-label-primary">Editable</span>
                <span>User-authored in the workspace</span>
                <span class="badge bg-label-warning">Template Default</span>
                <span>Suggested by a compatible Project Template only</span>
            </div>

            <div id="project-wizard-steps" class="project-wizard-nav mb-3" role="tablist" aria-label="Project Wizard Steps">
                <button type="button" class="btn project-step-btn active" data-step="1">1. Identity &amp; Strategy Anchor</button>
                <button type="button" class="btn project-step-btn" data-step="2">2. Ownership &amp; Operating Scope</button>
                <button type="button" class="btn project-step-btn" data-step="3">3. Delivery Planning</button>
                <button type="button" class="btn project-step-btn" data-step="4">4. Execution Controls &amp; Readiness</button>
                <button type="button" class="btn project-step-btn" data-step="5">5. Budgeting &amp; Financial Governance</button>
                <button type="button" class="btn project-step-btn" data-step="6">6. Review &amp; Create</button>
            </div>

            <section class="es-goal-section project-step-pane" data-step="1">
                @{
                    ViewData["Title"] = "Identity & Strategy Anchor";
                    ViewData["Subtitle"] = "Define the delivery identity and lock the Project to a parent Initiative before planning work begins.";
                }
                @await Html.PartialAsync("~/Views/EnterpriseStrategyBusinessPerformance/Components/Forms/_SectionHeader.cshtml")
                <div class="project-step-copy mb-3">
                    <span class="badge bg-label-info me-2">Anchor Rule</span>
                    Parent Initiative is the first control. Parent Objective, Parent Goal, Parent Type, and EntityScope are inherited from that Initiative, and compatible templates load only after the anchor is selected.
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label es-required" for="project-parent-initiative">Parent Initiative <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-parent-initiative" class="form-select select2" required>
                            <option value="">Select Parent Initiative</option>
                        </select>
                        <div class="project-inline-hint mt-1">Select the Parent Initiative first so this Project can inherit strategic lineage, operating scope, and compatible template context.</div>
                    </div>

                    <div class="col-12">
                        <div class="project-derived-context-card">
                            <div class="project-derived-context-header">
                                <div>
                                    <h6 class="project-derived-context-title mb-1">Derived Strategy Context</h6>
                                    <p class="project-inline-hint mb-0">This Project inherits lineage and governed context from the selected Parent Initiative.</p>
                                </div>
                                <span class="badge bg-label-info">Derived</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-xl-3">
                                    <label class="form-label" for="project-parent-objective">Derived Parent Objective <span class="badge bg-label-info ms-1">Inherited</span></label>
                                    <input id="project-parent-objective" class="form-control project-readonly-field" readonly />
                                </div>
                                <div class="col-12 col-md-6 col-xl-3">
                                    <label class="form-label" for="project-parent-goal">Derived Parent Goal <span class="badge bg-label-info ms-1">Inherited</span></label>
                                    <input id="project-parent-goal" class="form-control project-readonly-field" readonly />
                                </div>
                                <div class="col-12 col-md-6 col-xl-3">
                                    <label class="form-label" for="project-parent-type">Derived Parent Type <span class="badge bg-label-info ms-1">Inherited</span></label>
                                    <input id="project-parent-type" class="form-control project-readonly-field" readonly />
                                </div>
                                <div class="col-12 col-md-6 col-xl-3">
                                    <label class="form-label" for="project-entity-scope">Derived EntityScope <span class="badge bg-label-info ms-1">Inherited</span></label>
                                    <input id="project-entity-scope" class="form-control project-readonly-field" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="project-source-panel">
                            <div class="project-source-controls">
                                <div class="project-source-control project-source-control-select">
                                    <label class="form-label mb-1" for="project-creation-mode">Creation Mode</label>
                                    <select id="project-creation-mode" class="form-select" disabled>
                                        <option value="Blank">Blank</option>
                                        <option value="Template">From Project Template</option>
                                    </select>
                                </div>
                                <div class="project-source-control project-source-control-action">
                                    <label class="form-label d-block mb-1">&nbsp;</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary w-100" id="project-template-browse" disabled>Browse template...</button>
                                </div>
                                <div class="project-source-control project-source-control-action">
                                    <label class="form-label d-block mb-1">&nbsp;</label>
                                    <button type="button" class="btn btn-sm btn-outline-secondary w-100" id="project-template-clear" disabled>Clear template</button>
                                </div>
                            </div>
                            <div id="project-template-filter-note" class="project-inline-hint mt-2">Select Parent Initiative first.</div>
                            <div class="col-12 d-none mt-2" id="project-template-host">
                                <select id="project-template-select" class="form-select d-none">
                                    <option value="">Select compatible template</option>
                                </select>
                                <div class="project-inline-hint">Use Browse template to open the compatible Project Template picker.</div>
                            </div>
                            <div id="project-template-preview" class="project-template-preview d-none mt-3">
                                <div class="project-template-preview-header">
                                    <div>
                                        <div class="fw-semibold mb-1">Template Prefill Preview</div>
                                        <div class="project-inline-hint mb-0">Review the editable fields that will be defaulted before applying or reapplying this template.</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-warning" id="project-template-reapply" disabled>Reapply Template Defaults</button>
                                </div>
                                <ul id="project-template-prefill-list" class="mb-0"></ul>
                            </div>
                            <div id="project-source-summary" class="project-source-summary-card is-empty mt-3">
                                <div id="project-source-summary-name" class="project-source-summary-name">Blank Project create</div>
                                <div id="project-source-summary-note" class="project-source-summary-note">Blank starts without template defaults, but the Project still must remain anchored to a Parent Initiative.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label" for="project-id">Project Code / ID <span class="badge bg-label-secondary ms-1">System</span></label>
                        <input id="project-id" class="form-control project-readonly-field" readonly placeholder="Assigned on first save" />
                    </div>
                    <div class="col-12 col-xl-6">
                        <label class="form-label es-required" for="project-name">Project Name <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <input id="project-name" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label es-required" for="project-description">Project Description <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <textarea id="project-description" rows="4" class="form-control"></textarea>
                    </div>
                </div>
            </section>

            <section class="es-goal-section project-step-pane d-none" data-step="2">
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label es-required" for="project-owner-pm">Project Owner / PM <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-owner-pm" class="form-select select2"><option value="">Select owner / PM</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label es-required" for="project-executive-sponsor">Executive Sponsor <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-executive-sponsor" class="form-select select2"><option value="">Select executive sponsor</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="project-business-owner">Business Owner / Benefit Owner <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-business-owner" class="form-select select2"><option value="">Select business owner</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label es-required" for="project-delivery-company">Delivery Company <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-delivery-company" class="form-select select2"><option value="">Select delivery company</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="project-owning-function">Owning Function / Department <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <input id="project-owning-function" class="form-control" />
                    </div>
                    <div class="col-12 col-xl-6">
                        <label class="form-label" for="project-delivery-partner">Delivery Partner / Vendor <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <input id="project-delivery-partner" class="form-control" />
                    </div>
                    <div class="col-12 col-xl-6">
                        <label class="form-label es-required" for="project-scope-summary">Scope Summary <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <textarea id="project-scope-summary" rows="3" class="form-control"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="project-out-of-scope">Out-of-Scope Note <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <textarea id="project-out-of-scope" rows="3" class="form-control"></textarea>
                    </div>
                </div>
            </section>

            <section class="es-goal-section project-step-pane d-none" data-step="3">
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label es-required" for="project-status">Project Status <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-status" class="form-select">
                            <option value="Draft">Draft</option>
                            <option value="Planned">Planned</option>
                            <option value="Approved">Approved</option>
                            <option value="Active">Active</option>
                            <option value="On Hold">On Hold</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label es-required" for="project-phase">Stage / Phase <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-phase" class="form-select"><option value="">Select stage / phase</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label es-required" for="project-delivery-type">Delivery Type <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-delivery-type" class="form-select"><option value="">Select delivery type</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label es-required" for="project-delivery-methodology">Delivery Methodology <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-delivery-methodology" class="form-select"><option value="">Select methodology</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label es-required" for="project-priority">Priority <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-priority" class="form-select"><option value="">Select priority</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label" for="project-complexity">Complexity / Size <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-complexity" class="form-select"><option value="">Select complexity / size</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label es-required" for="project-start-date">Start Date <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <input id="project-start-date" type="date" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label es-required" for="project-end-date">End Date <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <input id="project-end-date" type="date" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="project-go-live">Go-Live / Target Milestone <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <input id="project-go-live" type="date" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="project-reporting-cadence">Reporting Cadence <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-reporting-cadence" class="form-select"><option value="">Select cadence</option></select>
                    </div>
                </div>
            </section>

            <section class="es-goal-section project-step-pane d-none" data-step="4">
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="project-success-metric">Success Metric <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <input id="project-success-metric" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="project-baseline">Baseline <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <input id="project-baseline" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="project-target">Target <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <input id="project-target" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label es-required" for="project-readiness-status">Readiness Status <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-readiness-status" class="form-select"><option value="">Select readiness</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label es-required" for="project-risk-rating">Risk Rating <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-risk-rating" class="form-select"><option value="">Select risk</option></select>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="project-health">Overall Health / RAG <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-health" class="form-select"><option value="">Select health</option></select>
                    </div>
                    <div class="col-12 col-xl-6">
                        <label class="form-label" for="project-compliance-impact">Compliance / Regulatory Impact <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <textarea id="project-compliance-impact" rows="3" class="form-control"></textarea>
                    </div>
                    <div class="col-12 col-xl-3">
                        <label class="form-label" for="project-dependency-flag">Dependency Flag <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-dependency-flag" class="form-select">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </div>
                    <div class="col-12 col-xl-3">
                        <label class="form-label" for="project-evidence-required">Evidence Required Flag <span class="badge bg-label-primary ms-1">Editable</span></label>
                        <select id="project-evidence-required" class="form-select">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </div>
                </div>
            </section>

            <section class="es-goal-section project-step-pane d-none" data-step="5">
                <div class="project-step-copy mb-3">
                    Budgeting is a first-class governance checkpoint for Project creation and for any status beyond Draft. Complete the required controls here before progressing a Project into Planned, Approved, Active, On Hold, or Closed.
                </div>
                <div id="project-budget-governance-banner" class="alert alert-info mb-3 d-none"></div>
                <div class="project-budget-step-shell">
                    <div class="project-budget-panel">
                        <h6 class="mb-1">Governance Decision</h6>
                        <p class="project-inline-hint mb-3">Decide whether this Project requires governed budget approval or a documented no-budget exception.</p>
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-xl-4">
                                <label class="form-label es-required" for="project-budget-required">Budget Required <span class="badge bg-label-primary ms-1">Editable</span></label>
                                <select id="project-budget-required" class="form-select">
                                    <option value="">Select</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-xl-4">
                                <label class="form-label" for="project-funding-company">Funding / Owning Company <span class="badge bg-label-primary ms-1">Editable</span></label>
                                <select id="project-funding-company" class="form-select select2"><option value="">Select funding / owning company</option></select>
                            </div>
                            <div class="col-12 col-xl-4">
                                <label class="form-label" for="project-financial-notes">Financial Notes <span class="badge bg-label-primary ms-1">Editable</span></label>
                                <textarea id="project-financial-notes" rows="3" class="form-control"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="project-budget-panel d-none" id="project-budget-required-yes-group">
                        <h6 class="mb-1">Required Financial Controls</h6>
                        <p class="project-inline-hint mb-3">Budget-governed Projects must capture the approved financial basis before leaving Draft.</p>
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label" for="project-budget-amount">Budget Amount <span class="badge bg-label-primary ms-1">Editable</span></label>
                                <input id="project-budget-amount" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label" for="project-currency">Currency <span class="badge bg-label-primary ms-1">Editable</span></label>
                                <select id="project-currency" class="form-select"><option value="">Select currency</option></select>
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label" for="project-budget-type">Budget Type <span class="badge bg-label-warning ms-1">Template Default</span></label>
                                <select id="project-budget-type" class="form-select">
                                    <option value="">Select budget type</option>
                                    <option value="CapEx">CapEx</option>
                                    <option value="OpEx">OpEx</option>
                                    <option value="Mixed">Mixed</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label" for="project-budget-basis">Budget Basis <span class="badge bg-label-warning ms-1">Template Default</span></label>
                                <select id="project-budget-basis" class="form-select">
                                    <option value="">Select basis</option>
                                    <option value="Estimate">Estimate</option>
                                    <option value="Requested">Requested</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Baseline">Baseline</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label" for="project-funding-source">Funding Source <span class="badge bg-label-warning ms-1">Template Default</span></label>
                                <input id="project-funding-source" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label" for="project-cost-center">Cost Center <span class="badge bg-label-warning ms-1">Template Default</span></label>
                                <input id="project-cost-center" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label" for="project-budget-owner">Budget Owner <span class="badge bg-label-primary ms-1">Editable</span></label>
                                <select id="project-budget-owner" class="form-select select2"><option value="">Select budget owner</option></select>
                            </div>
                            <div class="col-12 col-md-6 col-xl-3">
                                <label class="form-label" for="project-approval-route">Approval Route <span class="badge bg-label-warning ms-1">Template Default</span></label>
                                <input id="project-approval-route" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="project-budget-panel d-none" id="project-budget-required-no-group">
                        <h6 class="mb-1">No-Budget Exception</h6>
                        <p class="project-inline-hint mb-3">If budget is not required, document the governance reason before the Project can leave Draft.</p>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="project-no-budget-reason">No-Budget Reason <span class="badge bg-label-primary ms-1">Editable</span></label>
                                <textarea id="project-no-budget-reason" rows="3" class="form-control"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="es-goal-section project-step-pane d-none" data-step="6">
                <div class="row g-3">
                    <div class="col-12 col-xl-6">
                        <div class="project-review-card">
                            <h6>Identity Summary</h6>
                            <div id="project-review-identity"></div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-6">
                        <div class="project-review-card">
                            <h6>Parent Anchor Summary</h6>
                            <div id="project-review-anchor"></div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-6">
                        <div class="project-review-card">
                            <h6>Ownership Summary</h6>
                            <div id="project-review-ownership"></div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-6">
                        <div class="project-review-card">
                            <h6>Planning Summary</h6>
                            <div id="project-review-planning"></div>
                        </div>
