<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Diten.Platform.API</RootNamespace>
    <UserSecretsId>587d48b8-25d7-414f-a302-fe1078fb12ea</UserSecretsId>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diten.Platform.Application\Diten.Platform.Application.csproj" />
    <ProjectReference Include="..\Diten.Platform.Infrastructure\Diten.Platform.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Diten.Platform.Common\src\Diten.Platform.Common\Diten.Platform.Common.csproj" />
    <ProjectReference Include="..\..\..\Diten.Building.Blocks\src\Diten.BuildingBlocks.InterfaceRegistry.Abstractions\Diten.BuildingBlocks.InterfaceRegistry.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Diten.Building.Blocks\src\Diten.BuildingBlocks.ModuleRegistration.Abstractions\Diten.BuildingBlocks.ModuleRegistration.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Seed\business-reference-data\document-management-qms.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Seed\business-reference-data\legal-entity-reference.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- WP-PLT-WORKFLOW-TEMPLATES-01 — the approval-definition catalog the ensure-workflow-templates operator command reads. -->
    <Content Update="Seed\workflow-templates\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- WP-DM-1c: the GMG reference CSV is a runtime asset. A .csv is a default None item (not Content like the BRD
         .json files above), so it is copied via None Update (the Content Update mirror for a non-Content file type). -->
    <None Update="Seed\document-management\GMG_ERP_Document_Reference_List_2026-08-24.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- MOD-0033-FU02 §F.3 — the git-ignored Development local settings hold a private key / a client secret. The Web
         SDK treats every *.json beside the project as Content; this keeps the file out of build and publish output
         (and out of every project that references this one). It is read from the project directory only. -->
    <Content Remove="appsettings.Development.local.json" />
    <None Remove="appsettings.Development.local.json" />
  </ItemGroup>

</Project>
