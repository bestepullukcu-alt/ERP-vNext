{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "diten_personalization_dev"
  },
  "TenantManagement": {
    "DefaultRegion": "US",
    "DefaultEnvironment": "Development",
    "DefaultTier": "Standard",
    "DefaultLanguage": "en",
    "DefaultTimezone": "UTC",
    "DefaultCurrency": "USD",
    "AppUrlTemplate": "https://{tenant}.dev.diten.tech"
  },
  "TenantResolution": {
    "DevBypassEnabled": true,
    "DevBypassTenantId": "00000000-0000-0000-0000-000000000001"
  }
}
