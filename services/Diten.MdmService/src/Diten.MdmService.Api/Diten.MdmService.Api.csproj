<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Diten.MdmService.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Diten.Building.Blocks\Diten.BuildingBlocks.Security.Secrets\Diten.BuildingBlocks.Security.Secrets.csproj" />
    <ProjectReference Include="..\Diten.MdmService.Application\Diten.MdmService.Application.csproj" />
    <ProjectReference Include="..\Diten.MdmService.Infrastructure\Diten.MdmService.Infrastructure.csproj" />
    <ProjectReference Include="..\Diten.MdmService.Persistence\Diten.MdmService.Persistence.csproj" />
    <ProjectReference Include="..\..\..\Diten.Building.Blocks\src\Diten.BuildingBlocks.ModuleRegistration.Abstractions\Diten.BuildingBlocks.ModuleRegistration.Abstractions.csproj" />
    <!-- WP-MDM-BRAND-ACCEPT-01 FIX2 (item 1) — BL-452's shared list-export contract, for the brand register's server export. -->
    <ProjectReference Include="..\..\..\Diten.Building.Blocks\src\Diten.BuildingBlocks.ListExport\Diten.BuildingBlocks.ListExport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MOD-0033-FU02 §F.3 — the git-ignored Development local settings hold a private key / a client secret. The Web
         SDK treats every *.json beside the project as Content; this keeps the file out of build and publish output
         (and out of every project that references this one). It is read from the project directory only. -->
    <Content Remove="appsettings.Development.local.json" />
    <None Remove="appsettings.Development.local.json" />
  </ItemGroup>

</Project>
