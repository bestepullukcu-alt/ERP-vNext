<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <!-- Keep the IdentityModel runtime on one major version. BuildingBlocks.Security.Secrets brings
         Microsoft.IdentityModel.Tokens 8.16.0; JwtBearer otherwise resolves the JWT reader to 7.1.2. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Diten.Building.Blocks\Diten.BuildingBlocks.Security.Secrets\Diten.BuildingBlocks.Security.Secrets.csproj" />
    <ProjectReference Include="..\Diten.PpmService.Application\Diten.PpmService.Application.csproj" />
    <ProjectReference Include="..\Diten.PpmService.Infrastructure\Diten.PpmService.Infrastructure.csproj" />
    <ProjectReference Include="..\Diten.PpmService.Persistence\Diten.PpmService.Persistence.csproj" />
  </ItemGroup>
</Project>
