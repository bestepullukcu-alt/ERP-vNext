<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Diten.InventoryService.Api</RootNamespace>
        <!-- WP-0173-PM2: development secrets (Inventory:InternalServiceKeys) live in user secrets, written by
             scripts/new-inventory-internal-key.ps1 — never in appsettings. -->
        <UserSecretsId>7b6d7a06-3976-44cd-849b-3906d06d8854</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MediatR" Version="12.3.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Diten.InventoryService.Application\Diten.InventoryService.Application.csproj" />
        <ProjectReference Include="..\Diten.InventoryService.Infrastructure\Diten.InventoryService.Infrastructure.csproj" />
        <ProjectReference Include="..\Diten.InventoryService.Persistence\Diten.InventoryService.Persistence.csproj" />
        <ProjectReference
            Include="..\..\..\Diten.Building.Blocks\Diten.BuildingBlocks.Security.Secrets\Diten.BuildingBlocks.Security.Secrets.csproj" />
        <ProjectReference
            Include="..\..\..\Diten.Building.Blocks\src\Diten.BuildingBlocks.ModuleRegistration.Abstractions\Diten.BuildingBlocks.ModuleRegistration.Abstractions.csproj" />
    </ItemGroup>

</Project>
