{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5067"
      }
    }
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "diten_inventory_v1"
  },
  "JwtSettings": {
    "Secret": "",
    "PreviousSecrets": [],
    "Issuer": "diten-auth-service",
    "Audience": "diten-erp"
  },
  "Inventory": {
    "Policy": {
      "EnforceLocationLegalEntityMatch": true
    },
    "Upstream": {
      "ProductMasterBaseUrl": "http://localhost:5000/api/product-master/",
      "LocationMasterBaseUrl": "http://localhost:5000/api/locations/",
      "LegalEntityMasterBaseUrl": "http://localhost:5000/api/legal-entities/",
      "OrgUnitDirectoryBaseUrl": "http://localhost:5000/api/platform/organization-units/",
      "TimeoutSeconds": 5
    },
    "InternalServiceKeys": []
  }
}
