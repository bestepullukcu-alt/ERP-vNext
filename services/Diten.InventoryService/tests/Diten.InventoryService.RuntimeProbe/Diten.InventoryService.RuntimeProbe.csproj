<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WP-0173-S1 §R runtime E4 probe (not a unit test): drives the RUNNING service on :5066 against the Prism mocks,
    reads the persisted Mongo documents and writes JSON evidence. Orchestrated by tests/runtime-probe/run-runtime-probe.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="2.27.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

</Project>
