<Project Sdk="Microsoft.NET.Sdk">

  <!-- MOD-0033-FU02 §F.2 — the offline credential generator. No database, no network: it references the Auth
       Infrastructure project only for the PRODUCTION hasher (ServiceClientCredentialVerifier.Hash), so the hash an
       operator pastes into ServiceClientRegistry is produced by the same code that later verifies it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Diten.AuthService.ServiceClientCredentialGenerator</RootNamespace>
    <AssemblyName>Diten.AuthService.ServiceClientCredentialGenerator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Diten.AuthService.Domain\Diten.AuthService.Domain.csproj" />
    <ProjectReference Include="..\..\src\Diten.AuthService.Application\Diten.AuthService.Application.csproj" />
    <ProjectReference Include="..\..\src\Diten.AuthService.Infrastructure\Diten.AuthService.Infrastructure.csproj" />
  </ItemGroup>

</Project>
