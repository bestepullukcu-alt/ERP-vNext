{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "MongoDbSettings": {
        "ConnectionString": "mongodb://localhost:27017",
        "DatabaseName": "diten_auth_v3"
    },
    "Observability": {
        "ServiceName": "Diten.AuthService",
        "Seq": {
            "Enabled": false,
            "Url": "",
            "ApiKey": "",
            "SafeDisableWhenUrlMissing": false
        },
        "Tracing": {
            "Enabled": true,
            "OtlpExporterEnabled": false,
            "OtlpEndpoint": "",
            "DisabledReason": "OTLP exporter is disabled until collector infrastructure is configured."
        },
        "Metrics": {
            "Enabled": true,
            "Path": "/metrics"
        },
        "Health": {
            "Path": "/health",
            "LivePath": "/health/live",
            "ReadyPath": "/health/ready"
        },
        "Correlation": {
            "HeaderName": "X-Correlation-Id",
            "MaxLength": 128
        },
        "Redaction": {
            "RedactedText": "[REDACTED]"
        }
    },
    "JwtSettings": {
        "Secret": "",
        "PreviousSecrets": [],
        "Issuer": "diten-auth-service",
        "Audience": "diten-erp",
        "AccessTokenExpirationMinutes": 120,
        "RefreshTokenExpirationDays": 7
    },
    "InternalEventAuth": {
        "ApiKey": ""
    },
    "PlatformService": {
        "BaseUrl": "http://localhost:5057",
        "FrontendBaseUrl": "http://localhost:5001",
        "InternalApiKey": "",
        "TimeoutSeconds": 5
    },
    "Mfa": {
        "OtpLength": 6,
        "ExpiryMinutes": 5,
        "MaxAttempts": 5,
        "Enabled": false,
        "HashSecret": ""
    },
    "Smtp": {
        "Host": "",
        "Port": 587,
        "Username": "",
        "Password": "",
        "Enabled": false,
        "EnableSsl": true,
        "FromEmail": "no-reply@yourcompany.com",
        "FromName": "Diten ERP"
    }
}
