{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "TenantResolution": {
    "DevBypassEnabled": true,
    "DevBypassTenantId": "00000000-0000-0000-0000-000000000001"
  },
  "Observability": {
    "ServiceName": "Diten.AuthService",
    "Seq": {
      "Enabled": false,
      "Url": "http://localhost:5341",
      "ApiKey": "",
      "SafeDisableWhenUrlMissing": false
    },
    "Tracing": {
      "Enabled": true,
      "OtlpExporterEnabled": false,
      "OtlpEndpoint": "",
      "DisabledReason": "OTLP exporter is disabled in local development until an OTLP collector is running."
    },
    "Metrics": {
      "Enabled": true,
      "Path": "/metrics"
    },
    "Health": {
      "Path": "/health",
      "LivePath": "/health/live",
      "ReadyPath": "/health/ready"
    },
    "Correlation": {
      "HeaderName": "X-Correlation-Id",
      "MaxLength": 128
    },
    "Redaction": {
      "RedactedText": "[REDACTED]"
    }
  },
  "JwtSettings": {
    "Secret": "",
    "PreviousSecrets": [],
    "Issuer": "diten-auth-service",
    "Audience": "diten-erp"
  },
  "InternalEventAuth": {
    "ApiKey": ""
  },
  "Eventing": {
    "Transport": "RabbitMQ"
  },
  "PlatformService": {
    "BaseUrl": "http://localhost:5057",
    "FrontendBaseUrl": "http://localhost:5001",
    "InternalApiKey": "",
    "TimeoutSeconds": 5
  },
  "Mfa": {
    "OtpLength": 6,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "Enabled": false,
    "HashSecret": ""
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "devsmtp",
    "Password": "",
    "Enabled": true,
    "EnableSsl": false,
    "FromEmail": "no-reply@yourcompany.com",
    "FromName": "Diten ERP"
  }
}
