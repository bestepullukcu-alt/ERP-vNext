<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Diten.AuthService.AccountKindAcceptanceHost</RootNamespace>
    <!-- WP-INFRA-AUTH-ACCEPTANCE-HOST-01 — this assembly's simple name must match the
         [InternalsVisibleTo("Diten.AuthService.AccountKindAcceptanceHost")] attribute added to
         Testing/AccountKindAcceptance.cs in the Application.Tests project (R6): that is how this host reuses
         the fixture's seed/pre-flight/secret-generation logic without copying it or widening that logic's
         public surface. AssemblyName is left at its MSBuild default (the project file name) on purpose so the
         two stay in sync without a second place to edit. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- P1 (v1.2) — the login-settings stub binds a real in-process Kestrel to 127.0.0.1:0 and reads the actually
         bound port from IServerAddressesFeature after start, closing the old bind/close/rebind race. Needs the
         shared framework directly (Mvc.Testing pulls in TestHost, not Kestrel). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Measured (Stage 2 / C4): Microsoft.AspNetCore.Mvc.Testing embeds a WebApplicationFactoryContentRootAttribute
         at BUILD TIME, but ONLY into the assembly that directly carries this PackageReference — reflection reads
         [assembly: ...] attributes from a single assembly, never transitively through a ProjectReference chain.
         Without this package + the direct ProjectReference to Api below, THIS host's own assembly (the actual
         Assembly.GetEntryAssembly() once `dotnet <this>.dll` runs) has no content-root attribute for
         Diten.AuthService.Api, and WebApplicationFactory falls back to a directory-guessing heuristic that does
         not know about the repo's src/ convention and throws before AuthTestHost.StartAsync() (called from
         Testing/AccountKindAcceptance.cs, in the referenced Application.Tests assembly) ever reaches mongod.
         Version pinned to match Application.Tests.csproj's own reference. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pulls in EphemeralMongo.Core + the Application/Domain/Persistence/Infrastructure project references
         transitively — this host reuses that exact same closure (R6: no second DI composition, no extern alias,
         no copy of the seed). -->
    <ProjectReference Include="..\Diten.AuthService.Application.Tests\Diten.AuthService.Application.Tests.csproj" />
    <!-- Direct reference (not just transitive, via the ProjectReference above) so the content-root attribute
         above is generated against THIS project's own build, not only Application.Tests'. -->
    <ProjectReference Include="..\..\src\Diten.AuthService.Api\Diten.AuthService.Api.csproj" />
  </ItemGroup>

</Project>
