<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- MOD-0033-FU02 §F — its own project (not Diten.AuthService.Application.Tests) because the end-to-end proof
         needs the PRODUCTION code of three services in one process: Auth (registry + token endpoint), MDM (the
         token client) and Platform (the validation scheme). Keeping that reference set out of the large Auth test
         project leaves that project's dependency graph exactly as it was.
         EphemeralMongo.Core 1.1.3 for the same reason as there: every src project pins MongoDB.Driver 2.27.0. It
         starts a test-owned mongod on a random port and a temp data directory — never localhost:27017. -->
    <PackageReference Include="EphemeralMongo.Core" Version="1.1.3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Diten.AuthService.Api\Diten.AuthService.Api.csproj" />
    <ProjectReference Include="..\..\src\Diten.AuthService.Application\Diten.AuthService.Application.csproj" />
    <ProjectReference Include="..\..\src\Diten.AuthService.Domain\Diten.AuthService.Domain.csproj" />
    <ProjectReference Include="..\..\src\Diten.AuthService.Persistence\Diten.AuthService.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Diten.AuthService.Infrastructure\Diten.AuthService.Infrastructure.csproj" />
    <ProjectReference Include="..\..\tools\Diten.AuthService.ServiceClientCredentialGenerator\Diten.AuthService.ServiceClientCredentialGenerator.csproj" />
    <ProjectReference Include="..\..\tools\Diten.AuthService.DevTrustBootstrap\Diten.AuthService.DevTrustBootstrap.csproj" />
    <ProjectReference Include="..\..\..\Diten.Platform\src\Diten.Platform.API\Diten.Platform.API.csproj" Aliases="PlatformApi" />
    <ProjectReference Include="..\..\..\Diten.MdmService\src\Diten.MdmService.Infrastructure\Diten.MdmService.Infrastructure.csproj" Aliases="MdmInfrastructure" />
    <ProjectReference Include="..\..\..\Diten.MdmService\src\Diten.MdmService.Application\Diten.MdmService.Application.csproj" Aliases="MdmApplication" />
  </ItemGroup>
</Project>
