services/Diten.Platform/src/Diten.Platform.API/Seed/business-reference-data/mod-0290-gsku-reference.json text eol=lf
services/Diten.Platform/src/Diten.Platform.API/Seed/business-reference-data/mod-0290-market-reference.json text eol=lf
